{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fam",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-26",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/admin/*"]
  }
}
