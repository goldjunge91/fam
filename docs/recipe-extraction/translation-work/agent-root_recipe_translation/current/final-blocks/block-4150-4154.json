      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch 40 Minuten in einem Topf mit leicht köchelndem Salzwasser kochen, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fleisch herausnehmen, etwas abkühlen lassen und dann mit zwei Gabeln zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebel und Knoblauch 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerpflücktes Rindfleisch, rote und gelbe Paprika, Kreuzkümmel und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "3 Minuten garen und gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tomatensauce und Rinderbrühe hinzufügen und 10 Minuten köcheln lassen, bis die Paprika weich ist und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tortillas in einer Pfanne je Seite 30 Sekunden erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Tortillas mit der Ropa-Vieja-Mischung füllen und mit Limettenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
