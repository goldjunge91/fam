      "steps": [
        {
          "position": 0,
          "text": "Melt butter in a saucepan over mittlerer Erhitze und sauté minced shallots bis softened, about 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib halved morel mushrooms und Koche für 4 Minuten, stirring occasionally.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Deglaze Pfanne mit white wine, scraping up any browned bits von the bottom.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib broth und köcheln für 8 Minuten bis mushrooms are tender und flavors meld.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "rühre in mustard und heavy cream, simmering für 3-4 Minuten bis Sauce thickens slightly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Season mit lemon juice, Salz, und Pfeffer to taste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "rühre in frisch tarragon or parsley just before serving.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere Sauce over grilled steak, Hähnchen, or pasta.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
