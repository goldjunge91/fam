      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 400°F vor und lege eine runde Springform mit 9 inch Durchmesser mit Backpapier aus. Lass das Papier über den Rand hinausragen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Frischkäse bei Raumtemperatur und Schlagsahne etwa 2 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Zucker dazu und schlage alles zusammen. Rühre die Eier einzeln ein und schlage die Masse nach jedem Ei nur so lange, bis es gerade vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Vanilleextrakt und Salz vollständig ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in die vorbereitete Form und backe ihn 25-30 Minuten, bis die Ränder dunkelbraun sind und die Mitte beim Schütteln noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Kuchen aus dem Ofen und lasse ihn auf der Arbeitsfläche auf Raumtemperatur abkühlen. Stelle ihn anschließend mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löse den Kuchen aus der Springform und ziehe das Backpapier ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide ihn mit einem heißen Messer auf, das du zwischen den Schnitten abwischst. Serviere ihn kalt oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
