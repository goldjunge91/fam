          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Weißwein dazu und lasse die Flüssigkeit etwa 3 Minuten auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Fischbrühe dazu und bringe alles zum Kochen. Füge gewürfelte Kartoffeln hinzu und lasse sie 15 Minuten köcheln, bis sie fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide den Fisch in große Stücke, gib sie vorsichtig in den Topf und reduziere die Hitze auf ein sanftes Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche den Fisch 8-10 Minuten, bis er undurchsichtig und gar ist. Koche ihn nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz, Pfeffer und frischem Limettensaft ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schöpfe die Suppe in Schüsseln und garniere sie mit frischer Petersilie. Reiche knuspriges Brot dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
