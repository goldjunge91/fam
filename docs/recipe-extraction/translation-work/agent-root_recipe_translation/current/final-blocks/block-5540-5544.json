      "steps": [
        {
          "position": 0,
          "text": "Gib die Rinderschulter in einen großen Topf, bedecke sie mit Wasser und bringe es zum Kochen. Lasse das Fleisch 30 Minuten köcheln und gieße es dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Ancho-Chilis in einer trockenen Pfanne auf jeder Seite 30 Sekunden an und weiche sie anschließend 10 Minuten in heißem Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere weiche Ancho-Chilis, Chipotle-Chilis samt Sauce, Knoblauch, die Hälfte der Zwiebel, Essig, Kreuzkümmel und Oregano glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Chilimischung durch ein feines Sieb, um feste Stücke zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das angekochte Rindfleisch in einen sauberen Topf zurück und gieße die abgesiebte Chilisauce und Rinderbrühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Lorbeerblätter dazu und bringe alles zum Kochen. Reduziere die Hitze und lasse den Topf zugedeckt 2.5 Stunden köcheln, bis sich das Fleisch leicht zupfen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zupfe das Rindfleisch auseinander, gib es zurück in die Brühe und lasse es weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es in Schüsseln mit Kochsud und gewürfelter Zwiebel. Reiche frische Limettenspalten und warme Tortillas zum Dippen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
