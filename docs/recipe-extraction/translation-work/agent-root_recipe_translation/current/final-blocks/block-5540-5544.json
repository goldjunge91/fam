      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen. Blanchiere Rindfleischwürfel und Hähnchenschenkel 5 Minuten, gieße sie ab und spüle sie kalt ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Fleisch mit Rinderbrühe, halbierten Zwiebeln, Knoblauch, Paprikapulver und Lorbeerblättern zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe alles zum Kochen, schöpfe den Schaum ab, reduziere die Hitze und lasse den Topf zugedeckt 1 Stunde köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Chorizo auf und gib sie zusammen mit den abgetropften Kichererbsen dazu. Lasse alles weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Viertle die Kartoffeln, würfle den Kürbis und schneide den Kohl in Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Gemüse in den Topf und lasse alles 45 Minuten köcheln, bis Gemüse und Fleisch sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne die Lorbeerblätter und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere Fleisch, Kichererbsen, Gemüse und Brühe zu gleichen Teilen in tiefen Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
