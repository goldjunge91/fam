      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mochiko-Mehl, Weizenmehl, Zucker, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage das Ei in einer weiteren Schüssel auf und verrühre es mit der Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die flüssigen Zutaten zu den trockenen und rühre, bis ein weicher Teig entsteht. Rühre nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Teig in einen Spritzbeutel mit großer runder Tülle und erhitze Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spritze den Teig direkt ins heiße Öl und forme Ringe. Frittiere jeweils 3-4 Donuts, ohne den Topf zu überfüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Donuts pro Seite 1-1.5 Minuten hellgoldbraun. Nimm sie mit einer Schaumkelle heraus und lege sie auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende die noch warmen Donuts in einer Mischung aus Puderzucker und Zimt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm oder innerhalb weniger Stunden bei Raumtemperatur.",
          "timerMinutes": null,
