      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer breiten, flachen Paella-Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die trockenen Nudeln 2-3 Minuten unter ständigem Rühren im Öl, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch hinzu und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse Safran in 1/4 Tasse warmer Brühe 2 Minuten ziehen und gieße dann die Safranbrühe in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die übrige Brühe hinzu, rühre alles um und bette dann Garnelen und Tintenfisch in die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lasse es 12-15 Minuten köcheln, bis die Nudeln weich und die Flüssigkeit größtenteils aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Paprikapulver, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Presse frischen Zitronensaft darüber und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
