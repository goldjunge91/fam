          "images": []
        },
        {
          "position": 4,
          "text": "Bräune die Wurststücke in einer separaten Pfanne bei mittelhoher Hitze 8-10 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gegarte Wurst in den Bohnentopf und lasse alles weitere 5 Minuten zusammen köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
