      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und lege ein Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Wurzelenden und den größten Teil der grünen Spitzen von den Frühlingszwiebeln ab. Lasse etwa 3 Zoll weiße und hellgrüne Teile stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Zwiebeln in einer Lage auf das Backblech und röste sie 25-30 Minuten, bis sie verkohlt und zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle währenddessen Olivenöl, Essig, Salz, Pfeffer, gehackten Knoblauch und Paprikapulver zu einer Romesco-artigen Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Zwiebeln aus dem Ofen und lasse sie leicht abkühlen, bis du sie anfassen kannst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ziehe die verkohlten äußeren Schichten ab, sodass das zarte weiße Innere zum Vorschein kommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte die geschälten Zwiebeln auf einer Servierplatte an und beträufle sie mit der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm mit knusprigem Brot zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
