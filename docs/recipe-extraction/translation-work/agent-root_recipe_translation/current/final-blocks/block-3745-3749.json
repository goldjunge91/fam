      "steps": [
        {
          "position": 0,
          "text": "Tupfe Kaninchenstücke mit Küchenpapier trocken und würze sie großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Schmortopf und bräune die Kaninchenstücke von allen Seiten. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste gewürfelte Zwiebel und gehackten Knoblauch im selben Topf goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mahle Mandeln mit 3 Esslöffeln Wasser zu einer Paste und gib sie zusammen mit Thymian und Lorbeerblatt in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche den Topf mit Rotwein ab, löse die Röststoffe und gib dann Brühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kaninchen zurück in den Topf, bringe alles zum Köcheln, decke den Topf ab und gare es 45-50 Minuten, bis das Kaninchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hacke Zartbitterschokolade fein und rühre sie während der letzten 2 Minuten der Garzeit in den Eintopf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere das Gericht heiß mit knusprigem Brot oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
