      "steps": [
        {
          "position": 0,
          "text": "Maiskörner mit Milch im Mixer glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maispüree in einen Topf geben, Butter, Zucker und Salz hinzufügen und bei mittlerer Hitze erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "10-12 Minuten ständig rühren, bis die Masse dick und cremig wird, dann vom Herd nehmen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Getrocknete Maishülsen 10 Minuten in warmem Wasser einweichen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2-3 tbsp Maismasse in die Mitte jeder Maishülse geben, Seiten und Enden zu einem Päckchen falten und mit Küchengarn oder Maishülsenstreifen zubinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wasser in einem großen Topf zum Kochen bringen und die Pamonha-Päckchen vorsichtig hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20 Minuten köcheln lassen, herausnehmen und vor dem Auswickeln und Servieren leicht abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
