      "steps": [
        {
          "position": 0,
          "text": "Stockfisch 24 Stunden in kaltem Wasser einweichen, falls er verwendet wird; das Wasser mehrmals wechseln, dann abgießen und den Fisch zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Grüne Kochbananen schälen und würfeln, dann 10-12 Minuten in Salzwasser kochen, bis sie gerade weich sind; abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebeln sowie gehackten Knoblauch 3 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Tomaten hinzufügen und unter gelegentlichem Rühren 5 Minuten garen, bis sie zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerpflückten Fisch und gekochte Kochbananen vorsichtig in den Topf geben und behutsam vermengen, ohne die Kochbananenstücke zu zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "8-10 Minuten sanft köcheln lassen, mit Salz und Pfeffer würzen und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in einer flachen Schale oder auf einem Teller mit der Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
