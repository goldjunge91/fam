      ],
      "steps": [
        {
          "position": 0,
          "text": "Wasser mit Salz in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer separaten Pfanne Öl erhitzen und gehackten Knoblauch mit zerdrückten Chilischoten 1 Minute anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen in die Pfanne geben und 3-4 Minuten garen, bis sie rosa sind; vom Herd nehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während das Wasser sanft köchelt, Maniokmehl portionsweise langsam einrühren und ständig rühren, bis eine glatte Brühe entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Brühe 10-12 Minuten köcheln lassen und gelegentlich umrühren, bis sie dick und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Garnelen, Koriander und Limettensaft einrühren und abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schalen schöpfen und heiß servieren; traditionell trinkt man sie aus einem Kürbisbecher (Cuia) mit einem Holzlöffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
