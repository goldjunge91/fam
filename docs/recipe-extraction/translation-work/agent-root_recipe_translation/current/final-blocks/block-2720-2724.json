      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350°F vorheizen und eine runde oder quadratische Kuchenform von 9-inch einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maisgrieß, Mehl, Backpulver und Salz in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer anderen Schüssel Butter und Zucker mit einem elektrischen Mixer etwa 3 Minuten hell und luftig aufschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier einzeln einrühren und nach jeder Zugabe gut vermischen, dann Vanille einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abwechselnd die trockenen Zutaten und Milch zur Buttermischung geben, mit den trockenen Zutaten beginnen und enden; nur so lange rühren, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teig in die vorbereitete Form gießen und die Oberfläche glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "35-40 Minuten goldbraun backen, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "10 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen und vollständig auskühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
