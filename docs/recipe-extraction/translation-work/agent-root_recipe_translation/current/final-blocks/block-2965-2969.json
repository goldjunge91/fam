      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilischoten und röste sie 1 Minute in einer trockenen Pfanne, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilischoten in 1 cup heißem Wasser 10 Minuten ein. Püriere sie dann mit Knoblauch, Essig, Kreuzkümmel und Oregano glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe den Rinderbraten mit Salz und Pfeffer ein und brate ihn in einem großen Topf bei hoher Hitze 3 Minuten pro Seite an, bis er gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Chilimischung ab und gieße sie über das Rindfleisch. Gib Rinderbrühe, geviertelte Zwiebel und zusätzlichen Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und lasse das Fleisch bei niedriger Hitze 2.5 Stunden köcheln, bis es sehr zart ist und sich leicht zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Rindfleisch aus der Flüssigkeit, zerpflücke es mit zwei Gabeln, gib es zurück in den Topf und lasse es weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Maistortillas in einer Pfanne 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die warmen Tortillas mit zerpflücktem Barbacoa und serviere sie mit Zwiebel und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
