          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile Tortillachips auf einer großen ofenfesten Platte oder einem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belege die Chips mit gewürztem Rinderhackfleisch, Jalapeños und Cheddar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie bei 350°F 8-10 Minuten, bis der Käse vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Nachos aus dem Ofen und träufle saure Sahne und Salsa im Zickzack darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gewürfelte Tomaten, schwarze Oliven und Frühlingszwiebeln darauf und serviere sie sofort.",
