      "steps": [
        {
          "position": 0,
          "text": "Püriere Egusi-Samen mit 1 cup Wasser zu einer pastenartigen Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und bräune Hackfleisch mit gewürfelter Zwiebel 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tomatenmark dazu und gare es 2 Minuten. Füge dann Dosentomaten hinzu und gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Brühe dazu, gib zerdrückten Knoblauch und Scotch-Bonnet-Chili hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und rühre die Egusi-Paste langsam ein, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Suppe 15 Minuten köcheln, gib dann Spinat hinzu und gare ihn weitere 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Chiliflocken und serviere die Suppe heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
