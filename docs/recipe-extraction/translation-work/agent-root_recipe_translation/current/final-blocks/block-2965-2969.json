      "steps": [
        {
          "position": 0,
          "text": "Schäle Kochbananen und Maniok und schneide sie in Stücke. Entferne faserige Kerne aus dem Maniok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Wasser mit Salz in einem großen Topf auf und gib Kochbananen- und Maniokstücke hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche alles 20-25 Minuten, bis es sehr weich ist und sich leicht mit einer Gabel einstechen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße alles gut ab und hebe 1 cup Kochwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerstampfe die Zutaten mit einem Holzstößel oder Kartoffelstampfer sehr glatt und klebrig. Gib bei Bedarf nach und nach das aufgehobene Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Butter ein und stampfe weiter, bis das Fufu eine dicke, teigähnliche Konsistenz hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es warm mit Suppe oder Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
