      "steps": [
        {
          "position": 0,
          "text": "Holzspieße mindestens 30 Minuten in Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehacktes Zitronengras, Knoblauch, Schalotten, Fischsauce, Zucker, Limettensaft, Öl und schwarzen Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschnittenes Schweinefleisch zur Marinade geben und wenden. 15 Minuten marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Marinierte Schweinefleischscheiben auf Spieße stecken und das Fleisch dabei falten und schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grillpfanne oder Außengrill auf mittelhohe Hitze erhitzen und Spieße auf jeder Seite 3–4 Minuten grillen, bis die Ränder verkohlt und das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiß mit Reis, frischem Gemüse und zusätzlicher Dip-Sauce aus der aufbewahrten, mit Wasser vermischten Marinade servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
