          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ananasstücke und gehackte Tomaten dazugeben und erneut zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen und Okrascheiben dazugeben und 4–5 Minuten köcheln lassen, bis die Garnelen rosa und die Okra weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehackte Thai-Chilis einrühren und abschmecken. Nach Wunsch Fischsauce oder Tamarinde ergänzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Schalen schöpfen, mit frischem Koriander garnieren und heiß mit Reis servieren.",
