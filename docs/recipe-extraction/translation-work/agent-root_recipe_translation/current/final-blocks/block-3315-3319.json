      "steps": [
        {
          "position": 0,
          "text": "Fülle den Dämpftopf mit Wasser und bringe es zum Kochen. Stelle den Einsatz so ein, dass der Fisch das Wasser nicht berührt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Säubere den Fisch gründlich, tupfe ihn trocken und ritze die Haut auf beiden Seiten diagonal ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege den Fisch auf einen hitzebeständigen Teller und würze Bauchhöhle und Außenseite mit Salz und weißem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Bauchhöhle mit der Hälfte des Ingwers und der Hälfte der Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle den Teller in den Dämpfer, decke ihn ab und dämpfe den Fisch 12-15 Minuten, bis er gar ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle währenddessen Sojasauce, Sesamöl, Reisessig und Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Pflanzenöl in einer kleinen Pfanne, bis es raucht, und gieße es über den übrigen Ingwer und die Frühlingszwiebeln auf dem Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Sauce um den Fisch, garniere ihn mit Koriander und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
