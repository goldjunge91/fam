      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Ente innen und außen mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasauce, Honig, Fünf-Gewürze-Pulver, Ingwer, Knoblauch, Essig und Salz zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Marinade innen in die Bauchhöhle und unter die Haut der Ente und lasse sie 30 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor und lege die Ente mit 0.5 Tasse Wasser in einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate sie 20 Minuten bei 400°F, reduziere dann die Hitze auf 350°F und brate sie weitere 50-60 Minuten, bis die Haut mahagonibraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle die Ente während des Garens alle 15 Minuten mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie vor dem Tranchieren und Servieren mit Bratensauce 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
