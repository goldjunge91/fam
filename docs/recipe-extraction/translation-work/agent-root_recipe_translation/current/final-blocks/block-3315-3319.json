      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch quer zur Faser in dünne Scheiben und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Austernsauce, Sojasauce, Wasser und Speisestärke in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Rindfleisch portionsweise 2-3 Minuten unter Rühren an, bis es gebräunt ist, und nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Knoblauch und Ingwer in den Wok und brate sie 30 Sekunden unter Rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in den Wok und gieße die Saucenmischung dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge Rindfleisch und Sauce 1-2 Minuten, bis die Sauce eindickt und das Fleisch überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Sesamöl und Frühlingszwiebeln ein, schwenke alles noch einmal und serviere es mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
