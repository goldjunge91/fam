      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und in 0.25 Zoll dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln in dünne Ringe schneiden und Corned Beef in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einem großen Topf mit starkem Boden bei mittlerer Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hälfte der Kartoffeln in den Topf schichten, dann das gesamte Corned Beef und die geschnittenen Zwiebeln hinzufügen und mit den restlichen Kartoffeln belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Alles mit Rinderbrühe übergießen, Salz, Pfeffer und Thymianzweige hinzufügen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Topf mit einem Deckel abdecken und 30–35 Minuten kochen lassen, dabei gelegentlich umrühren, bis die Kartoffeln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Thymianzweige entfernen, nach Geschmack würzen und heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
