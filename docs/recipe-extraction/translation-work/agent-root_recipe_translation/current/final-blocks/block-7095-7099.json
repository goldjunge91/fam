      "steps": [
        {
          "position": 0,
          "text": "Kondensmilch, Butter und braunen Zucker in einem Topf mit dickem Boden vermischen und bei mittlerer Hitze ständig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühren Sie weiter, um ein Anbrennen zu verhindern, während die Mischung etwa 10–12 Minuten lang erhitzt und dicker wird, bis sie das Stadium einer weichen Kugel erreicht (240 °F auf einem Zuckerthermometer).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vom Herd nehmen und Vanilleextrakt und Salz einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lassen Sie die Mischung 2-3 Minuten lang abkühlen und schlagen Sie sie dann 5-7 Minuten lang kräftig mit einem Holzlöffel, bis sie körnig wird und eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Masse zügig auf ein gebuttertes Backblech gießen und zu einer 0.5 Zoll dicken Schicht verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei Raumtemperatur 30 Minuten vollständig abkühlen lassen, dann mit einem gebutterten Messer in 1 Zoll große Quadrate schneiden und luftdicht aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
