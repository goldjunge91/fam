          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig gleichmäßig in eine ungefettete 8 x 8 Zoll große Backform drücken und die Oberfläche mit den Händen glätten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
