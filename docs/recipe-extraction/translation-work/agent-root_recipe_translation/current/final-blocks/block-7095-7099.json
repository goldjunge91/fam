      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust in Streifen schneiden und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Cayennepfeffer, Paprika, Salz und schwarzen Pfeffer in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem tiefen Topf oder Schmortopf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hähnchenstreifen mit gewürztem Mehl bestreichen und 6-7 Minuten braten, bis sie goldbraun sind und die Innentemperatur 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen herausnehmen und auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gefrorene Pommes Frites nach Packungsanweisung knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Soße in einem Topf bei mittlerer Hitze erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Pommes auf einen Teller schichten und mit gebratenen Hähnchenstreifen, Käsebruch und heißer Soße belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort servieren, solange alles heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
