      "steps": [
        {
          "position": 0,
          "text": "Lege Schweinekopf und -füße mit geviertelten Zwiebeln, Lorbeerblättern, Thymian und Salz in einen großen Topf. Bedecke alles mit Wasser und bringe es zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lasse alles 3 Stunden köcheln, bis das Fleisch sehr zart ist und sich von den Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Seihe Kochflüssigkeit durch ein Käsetuch ab und bewahre 4 cups auf. Lasse das Fleisch abkühlen und zerpflücke es fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse Gelatine 5 Minuten in kaltem Wasser quellen, löse sie dann in warmer Brühe auf und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische zerpflücktes Fleisch mit Senf, fülle es in eine Terrinenform und gieße Gelatinemischung dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle die Form über Nacht kalt, bis die Masse fest geworden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stürze die Terrine und schneide sie dünn auf. Serviere sie mit knusprigem Brot und Cornichons.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
