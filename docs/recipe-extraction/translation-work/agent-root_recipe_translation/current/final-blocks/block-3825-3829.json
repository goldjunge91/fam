      "steps": [
        {
          "position": 0,
          "text": "Schneide Rindfleisch in 1.5-inch große Würfel und würze es großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem schweren Topf und bräune Rindfleisch portionsweise an. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geschnittene Zwiebeln in den Topf und gare sie 8 Minuten, bis sie karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Paprikapulver und gehackten Knoblauch ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Rindfleisch zurück in den Topf, füge Tomatenmark und Kümmelsamen hinzu und gieße dann Rinderbrühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse es 1.5 hours köcheln, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke das Gericht ab und serviere es auf gekochten Eiernudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
