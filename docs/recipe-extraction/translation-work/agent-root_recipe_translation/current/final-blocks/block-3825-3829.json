      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf, würze Hähnchenschenkel mit Salz und Pfeffer und bräune sie insgesamt 6 Minuten von beiden Seiten. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln und gehackten Knoblauch in den Topf und dünste sie 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Paprikapulver und Tomatenmark ein und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchen zurück in den Topf, füge Hühnerbrühe hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und lasse alles 40 Minuten köcheln, bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und rühre saure Sahne glatt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche Eiernudeln separat und serviere sie mit Hähnchen-Paprikasch darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
