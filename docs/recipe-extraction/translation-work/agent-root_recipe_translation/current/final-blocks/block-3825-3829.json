      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 475°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Zwiebeln dünn und hacke Speck fein. Dünste beides zusammen in Olivenöl 5 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile Pizzateig in 3 Portionen und ziehe jede auf dem vorbereiteten Blech dünn oval auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verstreiche Crème fraîche gleichmäßig auf jedem Teigoval und lasse einen kleinen Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jedes Oval mit der Speck-Zwiebel-Mischung und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Fladen 12-15 Minuten, bis die Ränder goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide sie in Streifen und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
