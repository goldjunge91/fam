      "steps": [
        {
          "position": 0,
          "text": "Schneide das Lammfleisch in 1.5-inch-Würfel und tupfe es mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und brate das Lamm portionsweise etwa 3 Minuten pro Seite an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Lamm heraus und stelle es beiseite. Brate dann gewürfelte Zwiebeln und gehackten Knoblauch etwa 4 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Ingwer, Zimt und Kreuzkümmel in den Topf und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Lamm zurück in den Topf und gieße Hühnerbrühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Köcheln, decke den Topf ab und gare das Gericht 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib getrocknete Aprikosen dazu und gare alles weitere 15 Minuten, bis das Lamm sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze nach Geschmack mit Salz und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
