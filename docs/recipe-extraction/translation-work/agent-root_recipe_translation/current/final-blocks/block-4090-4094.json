              "grams": 240,
              "quantity": 240,
              "unit": "g",
              "position": 7,
              "optional": false,
              "source_note": "1 EL"
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Zucker und Salz in einer Schüssel. Drücke eine Mulde hinein und gib Hefe und warmes Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre alles zu einem groben Teig und knete ihn 5 Minuten glatt. Lasse ihn 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig zu einem Rechteck von 12x6 Zoll aus. Schneide die kalte Butter in dünne Scheiben und verteile sie über 2/3 des Teigs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Falte den Teig wie einen Brief in drei Teile, drehe ihn um 90 Grad und rolle ihn erneut zu einem Rechteck von 12x6 aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wiederhole das Belegen mit Butter und Falten noch 5 Mal und lasse den Teig zwischen den Faltungen jeweils 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig zum Schluss 1/8 Zoll dick aus und schneide ihn in 3-Zoll-Quadrate. Rolle jede Ecke zur Mitte, sodass Hörnchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Hörnchen auf Backpapier, decke sie ab und lasse sie 1.5 Stunden gehen, bis sie doppelt so groß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verrühre Eigelb und Milch und bestreiche das Gebäck damit. Backe es bei 400°F (200°C) 15-18 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
