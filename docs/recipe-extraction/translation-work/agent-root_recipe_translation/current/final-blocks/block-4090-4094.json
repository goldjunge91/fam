      "steps": [
        {
          "position": 0,
          "text": "Schneide den Fisch in 1/2-Zoll große Würfel und gib sie in eine Glasschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Limettensaft darüber, bis der Fisch vollständig bedeckt ist. Stelle ihn 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Während der Fisch mariniert, würfle die Zwiebel fein und lege sie 5 Minuten in kaltes Wasser, damit sie milder wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle Tomate, Paprika und Jalapeño klein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Zwiebel abtropfen und gib sie nach der Marinierzeit zum Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Gemüse, Koriander, Olivenöl und Salz zum Fisch und hebe alles vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle das Ceviche vor dem Servieren in gekühlten Schalen oder Gläsern mindestens weitere 10 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
