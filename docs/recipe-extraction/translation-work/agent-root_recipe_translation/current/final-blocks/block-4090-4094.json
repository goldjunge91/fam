      "steps": [
        {
          "position": 0,
          "text": "Schäle die grünen Kochbananen: Schneide die Enden ab und ritze die Schale längs ein. Lege sie 5 Minuten in Salzwasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Kochbananen in 1-Zoll dicke Scheiben und tupfe sie vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere die Scheiben 3-4 Minuten pro Seite, bis sie leicht goldgelb sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe die Scheiben mit einer Schaumkelle heraus und drücke jede zwischen Frischhaltefolie mit einem schweren Teller oder Glas flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die flach gedrückten Patacones weitere 2-3 Minuten pro Seite, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und salze sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit Knoblauch-Limetten-Soße aus gehacktem Knoblauch, Limettensaft und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
