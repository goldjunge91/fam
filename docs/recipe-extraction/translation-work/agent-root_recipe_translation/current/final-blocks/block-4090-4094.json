          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Rotweinessig, Olivenöl, Chiliflocken, Salz, schwarzen Pfeffer und Oregano darunter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Soße mindestens 5 Minuten stehen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Probiere und passe die Würzung nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Soße in eine Schale und träufle nach Wunsch zusätzliches Olivenöl darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
