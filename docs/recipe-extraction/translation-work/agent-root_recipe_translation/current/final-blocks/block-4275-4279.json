      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel und Knoblauch bei mittelhoher bis hoher Hitze 8 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze mit Kreuzkümmel, Chilipulver, Salz und Pfeffer. Rühre Salsa unter und nimm die Pfanne vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Bohnenmus in einem kleinen Topf und erhitze die Tortillas in einer trockenen Pfanne, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege eine Tortilla flach hin und verteile eine Linie Bohnenmus mittig darauf. Lasse an beiden Enden 2 Zoll frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege die Bohnen mit der Hälfte des gegarten Reises, der Hälfte des gewürzten Rindfleischs und der Hälfte des Käses.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe die Seiten der Tortilla nach innen und rolle sie von unten fest auf, sodass die Füllung eingeschlossen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole dies mit der zweiten Tortilla und serviere sie mit saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
