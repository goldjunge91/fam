      "steps": [
        {
          "position": 0,
          "text": "Röste 3 ganze Poblano-Chilis über offener Flamme oder unter dem Backofengrill, bis sie rundum verkohlt sind. Lege sie dann 10 Minuten in einen Plastikbeutel, damit sie dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die verkohlte Haut unter fließendem Wasser ab und schneide vorsichtig einen Schlitz hinein, um die Kerne zu entfernen, ohne die Chili zu zerreißen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste die geschnittenen Poblanos und Zwiebel in Öl weich. Nimm die Pfanne vom Herd und rühre Sahne, Crema, Salz und Pfeffer für die Rajas-Sauce unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede ganze geröstete Chili mit Oaxaca-Käse und wende sie vorsichtig in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Eier schaumig und erhitze Öl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tauche jede gefüllte Chili in das verquirlte Ei und brate sie auf beiden Seiten insgesamt etwa 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Rajas-Sauce in eine Auflaufform und lege die frittierten Chilis darauf. Streue den restlichen Käse darüber und backe alles bei 350°F 10 Minuten, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
