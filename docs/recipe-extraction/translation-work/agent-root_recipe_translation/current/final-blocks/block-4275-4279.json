      "steps": [
        {
          "position": 0,
          "text": "Brate Schweine-, Rind- und Kalbfleisch in einem großen Topf bei mittelhoher bis hoher Hitze etwa 10 Minuten an und zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel und Knoblauch hinzu und gare sie etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gewürfelte Kartoffel, Rinderbrühe, Piment, Salz und Pfeffer ein. Lasse alles 20 Minuten köcheln, bis die Kartoffeln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor und lege einen Tortenboden in eine 9-inch Pieform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Fleischmischung in den Teigboden und verteile sie gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den zweiten Tortenboden darauf. Drücke die Ränder mit einer Gabel zusammen, schneide überschüssigen Teig ab und schneide Dampfschlitze hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche den Teig mit verquirltem Ei und backe die Tourtière 30-35 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
