      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Hefe, Salz und Zucker in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib warmes Wasser und Öl dazu und knete den Teig 10 Minuten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig ab und lasse ihn bei Zimmertemperatur 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 gleich große Portionen und rolle jede zu einem dünnen Rechteck aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche jedes Rechteck mit Sesamöl und streue gehackte Frühlingszwiebeln und Salz gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle jedes Rechteck fest zu einem langen Strang auf. Wickle ihn spiralförmig ein und stecke das Ende darunter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Spiralen auf Backpapier und lasse sie 30 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Dämpfe sie in einem Dämpfeinsatz 12-15 Minuten, bis sie gar sind, und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
