      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete rote Chilis 10 Minuten in warmem Wasser ein und püriere sie dann mit Knoblauch und Ingwer zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und bräune die Schweinefleischstücke von allen Seiten an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate im selben Topf Zwiebeln goldbraun an, gib dann die Chilipaste dazu und gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Schweinefleisch zurück in den Topf und rühre Kurkumapulver ein, bis das Fleisch damit überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tamarindenpaste, Essig, Salz und Wasser dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 40 Minuten köcheln, bis das Schweinefleisch sehr zart und die Soße eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und schmecke es bei Bedarf mit Salz oder Essig ab. Serviere es mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
