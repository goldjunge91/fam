      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Topf und lasse die Kreuzkümmelsamen etwa 30 Sekunden knistern, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln hinzu und brate sie etwa 3 Minuten, bis sie weich und glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Knoblauch, Kurkuma und gehackte grüne Chilis ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Tomaten dazu und gare sie etwa 5 Minuten, bis sie weich sind und zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch hinein und bringe alles unter vorsichtigem Rühren zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Krabbenfleisch und Salz dazu und lasse alles 10-12 Minuten köcheln, bis sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib frische Korianderblätter dazu und serviere die Suppe heiß in Schüsseln oder mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
