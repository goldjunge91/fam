      "steps": [
        {
          "position": 0,
          "text": "Eine gusseiserne Pfanne oder Grillpfanne ohne Öl bei mittelhoher bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Provolone-Scheiben direkt in die heiße Pfanne legen und 2-3 Minuten ohne Bewegung braten, bis die Unterseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Käsescheiben vorsichtig wenden und die andere Seite garen, bis der Käse geschmolzen und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf einen Teller geben, mit Olivenöl beträufeln und Oregano, Chiliflocken sowie Salz darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sofort servieren, solange der Käse noch warm und leicht geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
