      "steps": [
        {
          "position": 0,
          "text": "Holzkohlegrill vorbereiten oder Außengrill auf mittelhohe bis hohe Hitze vorheizen und die Kohlen auf eine Seite schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderrippchen trocken tupfen und beide Seiten großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rippchen mit der Knochenseite nach unten auf die kühlere Grillseite legen, weg von der direkten Flamme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "45-60 Minuten grillen und gelegentlich wenden, bis das Fleisch zart und außen mit einer Kruste angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Knoblauch zerdrücken und mit gehackter Petersilie sowie Zitronensaft zu Chimichurri-Sauce vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rippchen auf ein Schneidebrett legen, zwischen den Knochen schneiden und mit Chimichurri-Sauce dazu servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
