      "steps": [
        {
          "position": 0,
          "text": "Forme aus dem Putenhack 2 Frikadellen und würze sie mit Salz, Pfeffer und Knoblauch. Gare sie in 1 EL Olivenöl 5–6 Minuten pro Seite. Schneide sie in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Dijon-Senf, Honig, Apfelessig, das restliche Olivenöl und Salz. Das Dressing dient auch als Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entkerne den Apfel und schneide ihn in dünne Scheiben. Hacke die Walnüsse grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mische den Spinat mit dem Dressing. Belege ihn mit Pute, Apfel und Walnüssen.",
          "timerMinutes": null,
