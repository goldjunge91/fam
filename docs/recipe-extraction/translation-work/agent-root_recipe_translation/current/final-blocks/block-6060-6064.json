      "steps": [
        {
          "position": 0,
          "text": "Mariniere das Fleisch mit Joghurt, Salz und 1 Esslöffel Ingwer-Knoblauch-Paste 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einem Topf mit schwerem Boden. Gib dünne Zwiebelscheiben dazu und brate sie etwa 10 Minuten tief goldbraun. Nimm die Hälfte zum Garnieren heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die übrige Ingwer-Knoblauch-Paste zu den Zwiebeln im Topf und gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge das marinierte Fleisch hinzu und brate es bei hoher Hitze 5 Minuten unter häufigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Koriander, Kreuzkümmel, Chili, Kurkuma und Garam Masala mit 2 Esslöffeln Wasser zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Gewürzpaste zum Fleisch und gare sie 3 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Wasser dazu, bringe alles zum Kochen, reduziere die Hitze und lasse es zugedeckt 50-60 Minuten köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Weiche Safran in 0.25 Tasse warmem Wasser 10 Minuten ein und gib ihn dann zum Curry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rühre frische Sahne und die beiseitegestellten Röstzwiebeln ein und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere das Gericht heiß mit Reis oder Bajra-Roti.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
