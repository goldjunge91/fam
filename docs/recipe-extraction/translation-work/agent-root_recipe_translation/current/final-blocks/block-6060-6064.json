      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl mit Wasser und 2 tbsp Schmalz zu einem Teig. Knete ihn 5 Minuten und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische in einer separaten Schüssel die übrigen 2 tbsp Schmalz mit Mehl zu einer Schichtpaste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig dünn aus, verstreiche die Schmalz-Mehl-Paste darauf, rolle ihn zu einer langen Rolle und forme diese zu einer Spirale. Drücke sie zu einem 4 Zoll großen Kreis flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Krabbenfleisch, gewürfelten Schweinebauch, Frühlingszwiebeln, Sojasauce, Sesamöl, Ingwer, Salz und Pfeffer für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 tbsp Füllung in die Mitte jedes Teigkreises, klappe die Ränder über der Füllung zusammen und drücke sie vorsichtig flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Pastetchen in einer geölten Pfanne bei mittlerer Hitze auf jeder Seite 4-5 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß, solange die Hülle noch knusprig ist.",
          "timerMinutes": null,
