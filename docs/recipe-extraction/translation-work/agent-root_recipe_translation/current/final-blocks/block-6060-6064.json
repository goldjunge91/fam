        {
          "position": 0,
          "text": "Vermische Schweinehackfleisch, Sojasauce, Sesamöl, Ingwer, Knoblauch, Wasser und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe den gehackten Schnittlauch erst kurz vor dem Formen vorsichtig unter, damit die Füllung nicht zu feucht wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 1 tbsp Füllung in die Mitte jedes Teigblatts und klappe es halbmondförmig zusammen. Falte dabei eine Kante in Falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze und brate die Teigtaschen mit der flachen Seite nach unten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 1/4 Tasse Wasser in die Pfanne und decke sie sofort ab. Dämpfe die Teigtaschen 5-6 Minuten, bis das Wasser verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie heiß mit Sojasauce, schwarzem Essig und Chiliöl zum Dippen.",
          "timerMinutes": null,
