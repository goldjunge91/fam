      "steps": [
        {
          "position": 0,
          "text": "Schneide jede grüne Chili seitlich ein und entferne vorsichtig die Kerne, ohne den Stiel abzutrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Kartoffelpüree, Zwiebel, Ingwer-Knoblauch-Paste, Chaat Masala und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle jede Chili mit 1-2 Esslöffeln der Kartoffelmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Kichererbsenmehl mit Wasser zu einem dickflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende jede gefüllte Chili im Kichererbsenteig, bis sie gut bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib sie vorsichtig ins heiße Öl und frittiere sie 3-4 Minuten rundherum goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie heiß mit süß-scharfem Tamarindenchutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
