      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl mit kochendem Wasser und knete einen glatten Teig. Decke ihn ab und lasse ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Brühe mit Gelatine, bis sie sich aufgelöst hat. Vermische sie dann mit Schweinefleisch, Sojasauce, Sesamöl, Ingwer, Frühlingszwiebeln, Zucker und weißem Pfeffer. Stelle die Füllung kalt, bis sie geliert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 12 Stücke und rolle jedes zu einem dünnen Kreis von 3 Zoll aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 1 tbsp Füllung in die Mitte jedes Teigblatts. Falte die Ränder nach oben und drehe sie oben zu, um die Teigtasche zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Teigtaschen mit der Naht nach oben in einen mit Backpapier ausgelegten Dämpfeinsatz und dämpfe sie 8-10 Minuten, bis die Hülle durchscheinend ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie sofort mit schwarzem Essig und Chiliöl zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
