      "steps": [
        {
          "position": 0,
          "text": "Machen Sie Roti-Teig, indem Sie Mehl, Salz, 1 Esslöffel Öl und Wasser weich vermischen, dann 5 Minuten lang kneten und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen, Kartoffeln, Zwiebeln würfeln und Knoblauch und Ingwer zerkleinern, während der Teig ruht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Öl in einem großen Topf erhitzen und Zwiebeln, Knoblauch und Ingwer 2 Minuten lang anbraten, bis ein angenehmer Duft entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Currypulver hinzufügen und 1 Minute kochen lassen, dann gewürfeltes Hähnchen hinzufügen und 5 Minuten kochen lassen, bis es leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Kartoffeln, Salz nach Geschmack und 0.5 Tasse Wasser hinzufügen und dann 15–20 Minuten köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teilen Sie den Roti-Teig in 8 Kugeln und rollen Sie jede auf einer bemehlten Oberfläche flach zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitzen Sie eine gusseiserne Pfanne oder Grillplatte bei mittlerer bis hoher Hitze und braten Sie jedes Roti 1–2 Minuten pro Seite, bis hellbraune Flecken erscheinen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wickeln Sie die fertigen Rotis in ein sauberes Küchentuch, um sie warm zu halten, und servieren Sie sie dann gefüllt mit Hühnercurry und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
