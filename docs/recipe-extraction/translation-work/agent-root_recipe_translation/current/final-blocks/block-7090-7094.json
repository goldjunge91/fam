      "steps": [
        {
          "position": 0,
          "text": "Zwiebel fein in kleine Stücke würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pflanzenöl in einer Pfanne erhitzen und die gewürfelten Zwiebeln 3–4 Minuten darin anbraten, bis sie goldbraun und leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kochen oder braten Sie Hot Dogs, bis sie durchgewärmt und außen leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärmen Sie Hot-Dog-Brötchen leicht in derselben Pfanne oder demselben Toaster.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie den gekochten Hot Dog in das warme Brötchen und tragen Sie eine dünne Linie Senf in der Mitte auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit warmem Chili und Röstzwiebeln belegen, dann mit Paprika bestreuen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
