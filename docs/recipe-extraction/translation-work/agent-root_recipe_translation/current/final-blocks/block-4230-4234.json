      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittelhoher bis hoher Hitze erhitzen und Schweinefleischwürfel portionsweise etwa 3 Minuten pro Portion von allen Seiten anbräunen; herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf geschnittene Zwiebel und gehackten Knoblauch etwa 4 Minuten weich und glasig dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl über die Zwiebelmischung streuen und 1 Minute ständig rühren, um eine Mehlschwitze herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinefleisch zurück in den Topf geben, Rinderbrühe angießen und Essig sowie Kreuzkümmel hinzufügen; gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann Hitze reduzieren, abdecken und 30 Minuten köcheln lassen, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gewürfelte Kartoffeln hinzufügen und abgedeckt weitere 20 Minuten köcheln lassen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß servieren; die Sauce sollte cremig sein und die Zutaten überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
