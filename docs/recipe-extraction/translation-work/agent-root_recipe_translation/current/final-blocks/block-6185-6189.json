      "steps": [
        {
          "position": 0,
          "text": "Weiche Bambusspieße 30 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle und entdarme die Garnelen. Lass die Schwänze zum Festhalten dran.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Erdnussbutter, Kokosmilch, Knoblauch, Ingwer, Chilipulver, Limettensaft, Sojasauce und braunen Zucker zu einer glatten Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke 5-6 Garnelen auf jeden Spieß und bestreiche sie großzügig mit Erdnusssauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize Grill oder Grillpfanne auf mittlere bis hohe Hitze vor und grille die Spieße pro Seite 2-3 Minuten, bis die Garnelen rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie heiß mit der restlichen warmen Sauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
