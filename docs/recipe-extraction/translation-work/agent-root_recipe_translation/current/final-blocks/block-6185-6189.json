      "steps": [
        {
          "position": 0,
          "text": "Spüle den schwarzen Klebreis unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser zum Kochen, gib den schwarzen Reis dazu und lass ihn zugedeckt 25 Minuten köcheln, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Kokosmilch mit braunem Zucker und Salz, bis sich der Zucker aufgelöst hat. Rühre dann Pandanextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche den weißen Klebreis separat nach Packungsanleitung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den schwarzen Reis auf Schüsseln und gib den weißen Klebreis darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die warme Kokosmilchmischung darüber und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
