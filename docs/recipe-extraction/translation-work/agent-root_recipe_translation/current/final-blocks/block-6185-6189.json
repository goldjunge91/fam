      "steps": [
        {
          "position": 0,
          "text": "Spüle den Reis unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Topf und dünste Knoblauch und Ingwer 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Reis dazu und rühre 1 Minute um, damit er mit Öl überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe und Kurkuma hinein. Bringe alles zum Kochen und reduziere dann die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Suppe ohne Deckel 30 Minuten köcheln und rühre gelegentlich um, bis der Reis zu einem Brei zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und schwarzem Pfeffer, schöpfe den Brei in Schüsseln und garniere ihn mit Frühlingszwiebeln und gerösteten Schalotten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
