      "steps": [
        {
          "position": 0,
          "text": "Gib den Knafeh-Teig in eine Schüssel und zerteile ihn grob. Gieße geschmolzene Butter und gelbe Lebensmittelfarbe darüber und vermische alles mit den Händen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische in einer separaten Schüssel Milch, Frischkäse, Zucker und Maisstärke gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die Flüssigkeit und bringe sie zum Kochen. Sobald sie eindickt, schalte die Hitze aus und lasse sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Mozzarella dazu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Hälfte des Knafeh-Teigs als Boden in einer Form und drücke ihn vorsichtig gleichmäßig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Käsemischung darauf und streiche sie mit einem Löffel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bedecke alles mit der anderen Hälfte des Knafeh-Teigs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle die Form in den vorgeheizten Ofen und backe sie bei 200 degree etwa 20-25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Der Knafeh ist fertig, wenn die Oberfläche goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Bringe Wasser in einem Topf zum Kochen und löse den Zucker darin 4–5 Minuten auf. ODER koche den Sirup unter ständigem Rühren, bis er leicht eindickt. Gib Zitronensaft und Rosenwasser hinzu und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gieße den Sirup gleichmäßig über den Knafeh, sobald er aus dem Ofen kommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Der Knafeh ist servierfertig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
