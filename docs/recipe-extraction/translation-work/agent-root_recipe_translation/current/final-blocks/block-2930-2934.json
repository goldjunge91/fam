      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchenschenkel mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze und bräune das Hähnchen pro Seite 4 Minuten an. Nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebeln und gehackten Knoblauch in die Pfanne und gare sie 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Paprikapulver ein und gare es 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib geschnittene rote Paprika und Hühnerbrühe dazu und lege das Hähnchen zurück in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und lasse alles 25 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd und rühre vorsichtig saure Sahne ein, ohne die Sauce aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere Paprikasch zu gekochten Eiernudeln und nach Wunsch mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
