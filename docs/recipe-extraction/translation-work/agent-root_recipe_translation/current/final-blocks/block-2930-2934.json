      "steps": [
        {
          "position": 0,
          "text": "Röste Brotwürfel mit Butter in einer Pfanne etwa 5 Minuten goldbraun und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier mit Milch, Salz, Pfeffer und Muskatnuss in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe nach und nach Mehl unter die Eiermischung, bis ein weicher Teig entsteht. Hebe dann die gerösteten Brotwürfel unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Teig 10 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe einen großen Topf Salzwasser sprudelnd zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme den Teig mit angefeuchteten Händen zu ovalen Knödeln von etwa 3 inches Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Knödel vorsichtig ins kochende Wasser und lasse sie 10-12 Minuten köcheln, bis sie aufsteigen. Koche sie dann weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und serviere sie warm als Beilage zu Gulasch oder Stroganoff.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
