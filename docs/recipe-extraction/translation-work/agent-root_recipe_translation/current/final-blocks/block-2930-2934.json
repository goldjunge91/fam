      "steps": [
        {
          "position": 0,
          "text": "Reinige und blanchiere die Kutteln gründlich 5 Minuten in kochendem Wasser. Spüle sie dann ab und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Rinderbrühe in einem großen Topf, gib Kutteln und Lorbeerblätter hinzu und lasse alles 90 Minuten köcheln, bis die Kutteln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate in einer separaten Pfanne gewürfelte Zwiebeln, Karotten, Sellerie und Knoblauch etwa 5 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das angebratene Gemüse zu Kutteln und Brühe in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Paprikapulver und gewürfelte Kartoffeln ein und lasse alles 20 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 5 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe heiß in Schalen mit knusprigem Brot dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
