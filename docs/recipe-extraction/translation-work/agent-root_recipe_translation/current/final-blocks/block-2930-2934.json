      "steps": [
        {
          "position": 0,
          "text": "Würze den Rinderbraten von allen Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze und bräune den Braten pro Seite 4 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Braten heraus und brate gewürfelte Zwiebeln, Karotten, Pastinaken und Sellerie 5 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Braten zurück in den Topf und gib Rinderbrühe und Tomatenmark dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und lasse alles 60 Minuten köcheln, bis das Rindfleisch zart ist. Wende es nach der Hälfte der Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Braten heraus und lasse ihn 5 Minuten ruhen. Schneide ihn dann in 0.5-inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Seihe die Sauce durch ein Sieb und drücke das Gemüse aus, um die Flüssigkeit zu gewinnen. Gib die Sauce dann zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Koche Eiernudeln nach Packungsanweisung und serviere sie mit Bratenscheiben, Gemüse und Sauerrahmsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
