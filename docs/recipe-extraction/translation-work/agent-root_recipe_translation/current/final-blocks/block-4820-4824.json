      "steps": [
        {
          "position": 0,
          "text": "Koche 4 Eier 7 Minuten, bis sie weich gekocht sind. Schrecke sie in Eiswasser ab und pelle sie vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Schweinehackfleisch mit Salz, Pfeffer, Salbei und Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Fleischmischung in 4 Portionen und umhülle jedes Ei vollständig damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle drei Schüsseln bereit: eine mit Mehl, eine mit verquirltem Ei und eine mit Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende jedes umhüllte Ei zuerst in Mehl, dann im verquirlten Ei und zuletzt in den Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze das Öl in einem tiefen Topf oder einer Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere jedes schottische Ei vorsichtig 4-5 Minuten, bis es goldbraun ist. Dabei gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse die Eier auf Küchenpapier abtropfen und serviere sie warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
