        {
          "position": 1,
          "text": "Wende die Tofustücke gleichmäßig in Kartoffelstärke, bis sie vollständig bedeckt sind. Klopfe überschüssige Stärke ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl in einem tiefen Topf oder Wok auf 350°F. Frittiere die Tofuwürfel portionsweise 2-3 Minuten pro Seite, bis sie goldbraun und knusprig sind. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Dashi-Brühe, Sojasauce, Mirin und Zucker in einem kleinen Topf und bringe die Mischung zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die frittierten Tofuwürfel in eine Servierschüssel und übergieße sie mit der heißen Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere den Tofu mit geschnittenen Frühlingszwiebeln, geriebenem Ingwer und Bonitoflocken. Sofort heiß und knusprig servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
