      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine beschichtete Tamagoyaki-Pfanne oder eine kleine Pfanne bei mittlerer Hitze und öle sie leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle 2 Eier mit 1 EL Mirin und 1 EL Sojasauce, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße eine dünne Schicht der Eiermischung in die heiße Pfanne und lasse sie 30 Sekunden stocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle die gestockte Eierschicht zu dir hin auf, schiebe sie anschließend an den hinteren Pfannenrand und gieße weitere Eiermischung darunter. Wiederhole dies, bis die ganze Mischung verbraucht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Tamago-Rolle etwas abkühlen, wickle sie in Nori und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische den gekochten Sushi-Reis mit Reisessig, Zucker und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Forme den Reis zu kleinen ovalen Häufchen und belege jedes mit einer Tamago-Scheibe. Fixiere sie mit einem schmalen Streifen Nori.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Sushi sofort mit Sojasauce, Wasabi und eingelegtem Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
