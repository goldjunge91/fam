      "steps": [
        {
          "position": 0,
          "text": "Wenn du frische Weinblätter verwendest, blanchiere sie 30 Sekunden in kochendem Wasser und schrecke sie anschließend ab. Blätter aus dem Glas spülst du ab und tupfst sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 Esslöffel Olivenöl und dünste die gewürfelte Zwiebel und den Knoblauch etwa 3 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre das Hackfleisch ein und brate es etwa 5 Minuten, bis es gebräunt ist. Gieße überschüssiges Fett bei Bedarf ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd und mische Reis, Minze, Dill, Salz und Pfeffer unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ein Weinblatt mit der glänzenden Seite nach unten. Gib 2 Esslöffel Füllung nahe an den Stielansatz, klappe die Seiten über die Füllung und rolle das Blatt fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Röllchen mit der Naht nach unten dicht nebeneinander in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische die Brühe und das restliche Olivenöl mit dem Zitronensaft und gieße die Mischung über die gefüllten Weinblätter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke die Form fest mit Alufolie ab und backe alles bei 350°F 45-50 Minuten, bis der Reis gar und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die Weinblätter warm oder bei Zimmertemperatur, nach Wunsch mit Naturjoghurt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
