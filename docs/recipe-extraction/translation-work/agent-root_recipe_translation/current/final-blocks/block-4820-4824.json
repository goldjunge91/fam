      "steps": [
        {
          "position": 0,
          "text": "Erhitze die Brühe in einem separaten Topf und halte sie warm. Lasse die Safranfäden in 1/4 Tasse warmer Brühe ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Olivenöl in einer 14-Zoll-Paellapfanne bei mittlerer bis hoher Hitze. Brate den Tintenfisch 2-3 Minuten an, bis er Tinte abgibt und zu garen beginnt. Nimm ihn aus der Pfanne und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate in derselben Pfanne die gewürfelte Zwiebel und den Knoblauch 3 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis dazu und rühre 2 Minuten ständig, damit er leicht angeröstet wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Weißwein dazu und rühre, bis er größtenteils aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die warme Brühe nach und nach tasseweise dazu. Rühre gelegentlich und warte jeweils, bis der Reis die Flüssigkeit aufgenommen hat. Das dauert insgesamt etwa 15-20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Tintenfischtinte, gegarten Tintenfisch, Paprikapulver und den Safran samt Einweichflüssigkeit ein. Verteile die Muscheln obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Koche alles 5 Minuten, bis sich die Muscheln geöffnet haben, der Reis gar und die Flüssigkeit größtenteils aufgenommen ist. Wirf geschlossene Muscheln weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm die Pfanne vom Herd, decke sie mit Alufolie ab und lasse die Paella 5 Minuten ruhen. Serviere sie anschließend mit frischen Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
