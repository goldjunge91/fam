      "steps": [
        {
          "position": 0,
          "text": "Koche zuerst das Gemüse. Bringe einen großen Topf Salzwasser zum Kochen. Gare Karotten und Kartoffeln fünf Minuten vor, bis sie mit einer Gabel weich sind. Blanchiere dann Erbsen und Bohnen etwa eine Minute im selben Topf. Gieße das Gemüse ab und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem schweren Topf oder Schmortopf bei mittlerer Hitze. Gib das Gemüse dazu und erhitze es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Milch und Sahne dazu und bringe die Suppe zum Kochen. Reduziere die Hitze auf niedrig und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Dill und Schnittlauch dazu und lass die Suppe mindestens 10 Minuten köcheln. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
