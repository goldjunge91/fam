      "steps": [
        {
          "position": 0,
          "text": "Bringe die Brühe mit Ingwer und Knoblauch zum Köcheln und lasse sie 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm Ingwer und Knoblauch heraus. Rühre Misopaste, Sojasauce und Mirin ein, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe in einem zweiten Topf Wasser zum Kochen und gare frische Ramen-Nudeln nach Packungsanweisung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Nudeln ab und verteile sie auf zwei Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Pilze in einer separaten Pfanne etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe die heiße Misobrühe über die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege sie mit Pilzen, Mais, halbierten weich gekochten Eiern, Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren und heiß essen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
