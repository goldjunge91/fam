      "steps": [
        {
          "position": 0,
          "text": "Das Rocksteak dünn gegen die Faserrichtung in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sojasauce, Sesamöl, gehackten Ingwer, Knoblauch und Zucker in einer Schüssel verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Marinieren Sie das Steak in der Mischung mindestens 15 Minuten lang, während Sie die anderen Zutaten zubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitzen Sie eine gusseiserne Pfanne bei starker Hitze, bis sie sehr heiß ist, und kochen Sie dann das marinierte Steak portionsweise insgesamt 2–3 Minuten lang, wobei das Fleisch rare bis medium-rare bleiben soll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tortillas direkt über einer Gasflamme oder in einer trockenen Pfanne 15 Sekunden pro Seite erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stellen Sie Tacos mit warmen Tortillas, Steak, Koriander, Jalapeño-Scheiben und einer Prise Kimchi zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Limettensaft über die Tacos pressen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
