          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Olivenöl und Worcestershire-Sauce beträufeln und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kurz vor dem Verzehr vorsichtig mit einer Gabel vermischen und dabei das Eigelb einarbeiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
