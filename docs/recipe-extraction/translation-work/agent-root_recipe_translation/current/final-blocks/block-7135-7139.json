      "steps": [
        {
          "position": 0,
          "text": "Entfernen Sie die Hülle von der Chorizo und kochen Sie sie in einer großen Pfanne bei mittlerer Hitze, indem Sie sie in kleine Stücke brechen, bis sie gebräunt und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Poblano-Pfeffer über einer Gasflamme oder unter einem Grill rösten, bis er verkohlt ist, und dann zum Dämpfen 5 Minuten in eine Plastiktüte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Poblano aus der Tüte nehmen und die verkohlte Haut abziehen, dann die Kerne entfernen und fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduzieren Sie die Hitze der Pfanne auf einen niedrigen Wert und fügen Sie unter ständigem Rühren geschnittenen Käse hinzu, bis er vollständig geschmolzen und glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sahne einrühren, dann gerösteten Poblano, gehackten Jalapeño und gehackte Zwiebeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koriander unterheben und mit Salz abschmecken, dann in eine Servierschüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit warmen Tortillachips zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
