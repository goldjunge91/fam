      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust auf 3/4 Zoll Dicke klopfen und leicht mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Maisstärke, Paprika, Cayennepfeffer, Salz und schwarzen Pfeffer in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pflanzenöl in einer tiefen Pfanne oder einem Schmortopf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Hähnchen in der Mehlmischung wälzen, vollständig damit bestreichen und überschüssiges Mehl abschütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie das Hähnchen vorsichtig in heißes Öl und braten Sie es 6–8 Minuten lang, bis es goldbraun ist und die Innentemperatur 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lassen Sie das gebratene Hähnchen 1 Minute lang auf Papiertüchern abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brioche-Brötchen in einer trockenen Pfanne leicht rösten, dann mit Mayonnaise bestreichen und mit Hähnchen- und Dillgurkenscheiben belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
