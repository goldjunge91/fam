      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und gare gewürfelte Kartoffeln etwa 8 Minuten goldbraun. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Chorizo in derselben Pfanne etwa 5 Minuten und zerteile sie dabei. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und Jalapeño in die Pfanne und dünste sie 2 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle die Eier in einer Schüssel, gieße sie zu Chorizo und Gemüse in die Pfanne und rühre, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Tortilla mittig mit der Füllung und Käse, klappe die Seiten ein und rolle sie fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Burritos mit Salsa und zusätzlichem Käse als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
