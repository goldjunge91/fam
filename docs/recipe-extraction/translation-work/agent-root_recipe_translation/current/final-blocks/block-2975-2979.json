      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 9x13 Zoll große Auflaufform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Poblanos aus der Dose gut ab und schichte die Hälfte auf den Boden der Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue die Hälfte des Käses über die Poblanos.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte die übrigen Poblanos darauf und belege sie mit dem restlichen Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eier, Milch, Mehl und Salz glatt und gieße die Mischung über Paprika und Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Auflauf bei 350°F 35 Minuten, bis die Eiermasse fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme währenddessen Enchiladasauce mit gedünsteter Zwiebel und Knoblauch 5 Minuten in einem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Sauce in den letzten 5 Minuten der Backzeit über den Auflauf und serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
