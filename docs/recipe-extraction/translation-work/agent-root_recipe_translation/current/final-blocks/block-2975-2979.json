      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Schwarzaugenbohnen 5 Minuten in heißem Wasser ein und reibe sie dann mit den Händen, um die Schalen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Bohnen ab und püriere sie mit Zwiebel, Scotch Bonnet, Knoblauch, Salz und etwas Wasser luftig und schaumig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne bei mittlerer bis hoher Hitze auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib mit einem Löffel vorsichtig Teigbällchen ins heiße Öl und frittiere jeweils 4-5 Stück gleichzeitig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere sie 3-4 Minuten pro Seite, bis sie rundum goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß, idealerweise mit Pfeffersauce oder Tomatensauce als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
