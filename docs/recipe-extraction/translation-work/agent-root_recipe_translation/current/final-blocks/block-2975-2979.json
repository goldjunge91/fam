      "steps": [
        {
          "position": 0,
          "text": "Schlage Butter und Zucker cremig und luftig und rühre dann Eier und Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Backpulver, Salz und Muskatnuss in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe die trockenen Zutaten unter die Buttermischung, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig zwischen zwei Bögen Backpapier auf 0.25 Zoll Dicke aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide ihn mit einem Messer oder Teigrädchen in kleine Rechtecke oder Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere Chin-Chin-Stücke portionsweise 2-3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und vollständig abkühlen, bevor du sie luftdicht aufbewahrst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
