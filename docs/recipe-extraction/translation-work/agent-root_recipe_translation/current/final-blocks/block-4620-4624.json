      "steps": [
        {
          "position": 0,
          "text": "Mehl, Maisstärke und Salz in einer Schüssel vermengen, dann nach und nach Wasser einrühren, bis der Teig glatt und klümpchenfrei ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine 10-Zoll-Antihaftpfanne oder Crêpe-Pfanne bei mittlerer bis hoher Hitze erhitzen und leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1/2 Tasse Teig in die Mitte geben und die Pfanne sofort kippen und drehen, damit er sich zu einem dünnen, gleichmäßigen Kreis verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ein Ei auf den Crêpe schlagen und vorsichtig mit einem Pfannenwender verstreichen, dann Frühlingszwiebeln und knusprige Wonton-Streifen darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sojasauce und Sesamöl über den Belag träufeln, dann den Crêpe zur Hälfte zusammenklappen, sobald das Ei größtenteils gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 30 Sekunden goldbraun backen, dann auf einen Teller geben und mit dem restlichen Teig wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren und nach Wunsch mit weiterem Sesamöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
