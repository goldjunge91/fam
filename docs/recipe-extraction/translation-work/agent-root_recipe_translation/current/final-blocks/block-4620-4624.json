      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermengen, dann die kalte Butter mit einem Teigmischer oder einer Gabel einarbeiten, bis die Mischung groben Streuseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach jeweils 1 Esslöffel Eiswasser hinzufügen und vorsichtig rühren, bis der Teig gerade zusammenhält, dann 15 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backofen auf 400°F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig auf dem Backpapier zu einem 10-Zoll-Kreis ausrollen und dünn mit Dijon-Senf bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schinken, sautierten Spinat und die Hälfte des Gruyère-Käses auf dem Teig verteilen, dabei einen 2-Zoll-Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier mit 1 Esslöffel Wasser verquirlen und die Teigränder damit bestreichen, dann die Ränder über die Füllung nach oben klappen und mit der Eiermischung bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Restlichen Käse darüberstreuen und 20-25 Minuten backen, bis der Teig goldbraun und die Mitte warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Schneiden und Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
