      "steps": [
        {
          "position": 0,
          "text": "Würze das Ziegenfleisch großzügig von allen Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Schmortopf bei mittlerer bis hoher Hitze und brate das Fleisch insgesamt etwa 10 Minuten rundherum braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und brate geviertelte Zwiebeln und ganze Knoblauchzehen leicht braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Fleisch zurück in den Topf und füge Rosmarinzweige und Wacholderbeeren hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein dazu und lass ihn etwa 5 Minuten auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Rinderbrühe dazu und bringe alles zum Köcheln. Decke den Topf ab und schmore das Fleisch im Ofen bei 325°F 2.5 bis 3 Stunden, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Fleisch heraus und lege es auf ein Schneidebrett. Decke es locker mit Folie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Seihe die Garflüssigkeit ab, entferne die festen Bestandteile und schöpfe das Fett ab. Serviere die Sauce zum Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
