      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und lege Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage das Eiweiß schaumig und hebe dann vorsichtig den Puderzucker unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe Mandelmehl, Vanille, Salz und Zitronenschale unter, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze teelöffelgroße Portionen auf die vorbereiteten Backbleche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Kekse 20-25 Minuten, bis sie fest, innen aber noch weich und zäh sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass sie auf den Backblechen vollständig abkühlen, bevor du sie in einen luftdichten Behälter legst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
