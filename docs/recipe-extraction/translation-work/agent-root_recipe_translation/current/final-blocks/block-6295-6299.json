      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl, Wasser und Salz zu einem weichen Teig. Knete ihn 10 Minuten elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lass ihn 30 Minuten bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate währenddessen gewürfelte Zwiebel und Knoblauch an. Gib Schweinehackfleisch dazu und gare es braun. Würze mit Zimt und Safran.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ziehe den Teig zu sehr dünnen, fast durchsichtigen Blättern aus. Schichte sie mit der Fleischmischung dazwischen in eine gebutterte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle die Teigschichten beim Aufschichten mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Rinderbrühe um den geschichteten Teig herum, nicht darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Form zugedeckt bei 375°F 45 Minuten. Nimm dann den Deckel ab und backe sie weitere 15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue das Gericht mit geriebenem Pecorino Romano und lass es vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
