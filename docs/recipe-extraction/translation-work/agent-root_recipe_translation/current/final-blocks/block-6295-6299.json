      "steps": [
        {
          "position": 0,
          "text": "Vermenge Weizenmehl, Grieß, Wasser, Salz und Schmalz zu einem weichen Teig. Lass ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Käse in kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig zwischen Backpapier sehr dünn aus und schneide ihn in 4-inch-Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege einige Käsewürfel in die Mitte jedes Quadrats und klappe es zu einem fest verschlossenen Rechteck zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl auf 350°F und frittiere die Sebadas auf beiden Seiten etwa 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Honig in einem kleinen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle jede Sebada großzügig mit warmem Honig und bestäube sie mit Puderzucker. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
