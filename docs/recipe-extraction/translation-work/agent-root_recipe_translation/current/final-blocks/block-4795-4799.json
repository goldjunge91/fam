      "steps": [
        {
          "position": 0,
          "text": "Brate das Rinderhackfleisch in einer Pfanne bei mittlerer bis hoher Hitze etwa 5-7 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße überschüssiges Fett ab. Gib Taco-Gewürz und 1/4 cup Wasser dazu und rühre, bis das Fleisch gleichmäßig gewürzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass alles 2-3 Minuten köcheln, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die Taco-Schalen nach Packungsanleitung im Ofen oder in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle Zwiebel und Tomate und stelle alle Toppings zum einfachen Belegen in getrennten kleinen Schüsseln bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede warme Taco-Schale mit 2-3 tablespoons gewürztem Rinderhackfleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die Tacos mit Salat, Tomate, Käse und weiteren Toppings nach Wunsch. Serviere sie mit Salsa und saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
