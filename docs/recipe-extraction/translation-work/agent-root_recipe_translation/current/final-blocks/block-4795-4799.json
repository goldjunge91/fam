      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 9x13 große Auflaufform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel und gehacktem Knoblauch bei mittlerer Hitze 5-7 Minuten an. Gieße überschüssiges Fett ab und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Tortillas etwa 15 Sekunden pro Stück in einer trockenen Pfanne, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 1/2 cup Enchilada-Sauce auf den Boden der vorbereiteten Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle jede Tortilla mit 2-3 tablespoons Fleischmischung und 2 tablespoons Käse, rolle sie fest auf und lege sie mit der Naht nach unten in die Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die übrige Enchilada-Sauce über die aufgerollten Tortillas und streue den restlichen Käse gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe alles ohne Abdeckung 20-25 Minuten, bis die Sauce blubbert und der Käse goldbraun ist. Garniere die Enchiladas vor dem Servieren mit saurer Sahne und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
