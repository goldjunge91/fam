      "steps": [
        {
          "position": 0,
          "text": "Vermenge den gekochten Sushireis, solange er noch warm ist, mit Reisessig, Zucker und Salz. Lass ihn auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege ein Noriblatt mit der glänzenden Seite nach unten auf eine Bambusmatte zum Sushirollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile eine dünne Schicht abgekühlten Sushireis auf dem Noriblatt und lass am oberen Rand einen 1/2 inch breiten Streifen frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge den abgetropften Thunfisch mit Mayonnaise und lege die Mischung mit dünnen Gurkenstreifen in einer Linie in die Mitte des Reises.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle das Sushi mithilfe der Bambusmatte fest auf und befeuchte den freiliegenden Norirand mit Wasser, damit die Rolle geschlossen bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Rolle von der Matte und schneide sie mit einem scharfen, feuchten Messer in 6-8 Stücke. Führe das Messer dabei vorsichtig sägend.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Maki mit Sojasauce und Wasabi zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
