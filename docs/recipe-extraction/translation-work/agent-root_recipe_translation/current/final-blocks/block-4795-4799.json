      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl und Salz in einer Schüssel. Forme in der Mitte eine Mulde und gib die Eier hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Milch nach und nach dazu und rühre von der Mitte nach außen, bis der Teig glatt ist. Rühre 2 tablespoons geschmolzene Butter und Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass den Teig bei Zimmertemperatur 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine beschichtete 8-inch Pfanne bei mittlerer Hitze und fette sie leicht mit Butter ein. Gieße 1/4 cup Teig hinein und schwenke die Pfanne, damit er sich gleichmäßig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Crêpe 1-2 Minuten, bis die Unterseite hellgolden ist. Wende ihn und backe die andere Seite 15 Sekunden. Lege ihn dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wiederhole den Vorgang mit dem übrigen Teig und staple die fertigen Crêpes.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reibe die Orangenschale ab und gib sie mit der übrigen Butter, Zucker, Zitronensaft und nach Wunsch Brandy in einen Topf. Erwärme alles bei niedriger Hitze, bis die Butter geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Falte jeden Crêpe zu Vierteln und richte sie auf Tellern an. Gieße die warme Sauce darüber und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
