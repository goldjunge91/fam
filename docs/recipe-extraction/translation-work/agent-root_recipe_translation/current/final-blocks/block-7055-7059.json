      "steps": [
        {
          "position": 0,
          "text": "Ofen auf 425°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Speck in einer Pfanne knusprig braten, dann hacken und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne die gehackten Zwiebeln und Paprika in Butter etwa 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Austern schälen, in der unteren Schale belassen und auf einem Backblech anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belegen Sie jede Auster mit einer Portion der Pfeffer-Zwiebel-Mischung und zerbröckeltem Speck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streuen Sie Parmesankäse über jede Auster.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "10–12 Minuten backen, bis sich die Ränder der Austern leicht wellen und der Käse braun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
