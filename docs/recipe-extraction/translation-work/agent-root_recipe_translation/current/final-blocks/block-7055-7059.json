      "steps": [
        {
          "position": 0,
          "text": "Kalbsbries 2 Stunden in kaltem Wasser einweichen, dann 15 Minuten in kochendem Salzwasser blanchieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kalbsbries herausnehmen und abkühlen lassen, dann die Membranen abschneiden und in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Ei in einer flachen Schüssel verquirlen, Mehl in eine andere flache Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kalbsbriesstücke in Mehl wenden, dann in geschlagenes Ei tauchen und dann erneut in Mehl wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter in einer Pfanne bei mittlerer Hitze schmelzen und das panierte Kalbsbries von allen Seiten goldbraun braten, insgesamt etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Brotscheiben in derselben Pfanne leicht rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sandwiches mit Mayonnaise, Salat und den warmen Kalbsbries zusammenstellen und sofort mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
