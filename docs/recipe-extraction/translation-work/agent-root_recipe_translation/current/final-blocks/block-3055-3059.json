      "steps": [
        {
          "position": 0,
          "text": "Gib Lammfleisch mit 5 cups Wasser in einen großen Topf und bringe es zum Kochen. Schöpfe Schaum ab und reduziere die Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Zwiebel, Kartoffeln, Tomatenmark und Kurkuma dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Topf ab und lasse alles bei niedriger Hitze 60 Minuten köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib abgetropfte Kichererbsen und Kidneybohnen, Salz und schwarzen Pfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles zugedeckt weitere 25 Minuten köcheln, bis die Bohnen durchgewärmt sind und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht und passe die Würzung nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den dicken Eintopf in tiefen Schalen und zerdrücke ihn traditionell am Tisch mit Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
