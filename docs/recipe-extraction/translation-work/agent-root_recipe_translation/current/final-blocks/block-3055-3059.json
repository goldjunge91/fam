      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und bräune das Fleisch portionsweise goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln dazu und gare sie 5 Minuten weich und glasig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Lösche dann mit Brühe ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sauerkirschen, Salz, Pfeffer und Zimt dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf ab und lasse alles 40-45 Minuten köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht und passe die Würzung nach Bedarf mit mehr Salz oder Zimt an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es zu gedämpftem Basmatireis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
