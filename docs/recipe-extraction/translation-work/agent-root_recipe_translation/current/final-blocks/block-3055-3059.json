      "steps": [
        {
          "position": 0,
          "text": "Spüle rote Linsen unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und brate gewürfelte Zwiebel und gehackten Knoblauch etwa 5 Minuten weich und goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kurkuma dazu und gare es 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib abgespülte Linsen und 6 cups Gemüsebrühe dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf teilweise ab und lasse alles 25-30 Minuten köcheln. Rühre gelegentlich um, bis die Linsen zu einer dicken Suppe zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Salz, schwarzen Pfeffer und Limettensaft dazu (oder getrocknete Limette, die du mit einem Messer eingestochen hast).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Suppe weitere 5 Minuten ohne Deckel köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere die Suppe, passe die Würzung an und entferne bei Verwendung die getrocknete Limette. Garniere sie mit frischer Minze und einem Schuss Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
