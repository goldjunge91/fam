      "steps": [
        {
          "position": 0,
          "text": "Lasse Safranfäden 15 Minuten in heißem Wasser ziehen, bis das Wasser kräftig gefärbt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle den Reis gründlich ab und weiche ihn 20 Minuten ein. Gieße ihn dann vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe 4 cups Salzwasser zum Kochen, gib Reis dazu und gare ihn 8 Minuten, bis er teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den Reis ab und vermische die Hälfte davon mit Joghurt und 2 tablespoons Butter in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte die Joghurt-Reis-Mischung und weißen Reis in einen mit Butter ausgekleideten Topf und gieße Safranwasser darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die restliche Butter in kleinen Stücken darauf, decke den Topf mit Folie und Deckel ab und gare ihn bei mittlerer Hitze 25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht mit der goldbraunen, knusprigen Tahdig-Schicht vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
