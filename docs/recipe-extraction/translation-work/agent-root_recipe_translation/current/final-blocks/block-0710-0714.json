      "steps": [
        {
          "position": 0,
          "text": "Koche die Reisnudeln nach Packungsangabe. Gieße sie ab, spüle sie mit kaltem Wasser ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Garnelen leicht mit Salz und gare sie in einer heißen, trockenen Pfanne 1–2 Minuten pro Seite, bis sie rosa sind. Nimm sie heraus und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für das Dressing Limettensaft, Fischsauce, Honig, gehackten Knoblauch und Chiliflocken verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge die Nudeln mit dem Dressing, den in feine Streifen geschnittenen Karotten, der geschnittenen Gurke und dem fein geschnittenen Salat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile alles auf Schüsseln und gib Garnelen sowie reichlich frischen Koriander und Minze darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
