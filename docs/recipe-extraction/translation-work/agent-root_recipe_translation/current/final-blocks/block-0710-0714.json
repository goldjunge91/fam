      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis. Presse den Tofu trocken und schneide ihn in Rechtecke. Brate ihn in Öl bei mittelhoher Hitze etwa 4 Minuten pro Seite, bis beide Seiten goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Pilze in derselben Pfanne kurz mit Knoblauch und einem Schuss Sojasauce an, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass den Spinat mit Sesamöl kurz zusammenfallen. Schneide oder raspel die Karotten in feine Streifen und vermenge sie mit Reisessig und einer Prise Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate 1 Ei pro Schüssel mit der Sonnenseite nach oben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle Reis als Grundlage in die Schüsseln. Verteile Tofu, Spinat, Karotte und Pilze darum herum und setze das Ei in die Mitte. Gib einen großen Löffel Gochujang und Sesamsamen dazu. Vermenge vor dem Essen alles miteinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
