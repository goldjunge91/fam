      "steps": [
        {
          "position": 0,
          "text": "Vermische Graham-Cracker-Brösel mit geschmolzener Butter und drücke die Mischung fest in eine 9-Zoll-Kuchenform, sodass ein Boden entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe den Boden bei 350°F 8 Minuten, bis er leicht goldbraun ist. Nimm ihn heraus und lasse ihn etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eigelb, gezuckerte Kondensmilch, Zitronensaft und Zitronenschale in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Füllung in den vorbereiteten Boden und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Torte mindestens 4 Stunden kalt, bis sie fest ist. Für eine festere Konsistenz kannst du sie 2 Stunden einfrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere sie direkt vor dem Servieren mit Schlagsahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
