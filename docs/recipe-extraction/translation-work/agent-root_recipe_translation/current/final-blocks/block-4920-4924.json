          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und Ingwer dazu und rühre 30 Sekunden ständig, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen dazu und brate es etwa 5-7 Minuten goldbraun.",
