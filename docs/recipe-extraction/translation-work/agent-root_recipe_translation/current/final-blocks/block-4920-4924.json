      "steps": [
        {
          "position": 0,
          "text": "Fülle einen mittelgroßen Topf etwa 2 Zoll hoch mit Wasser und bringe es zum sanften Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Setze eine hitzebeständige Schüssel auf den Topf, ohne dass ihr Boden das Wasser berührt. So entsteht ein Wasserbad.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Eigelb und Zucker in der Schüssel und schlage die Mischung 3 Minuten ununterbrochen auf, bis sie hell ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre den Marsala nach und nach ein und schlage die Mischung weitere 5-7 Minuten, bis sie dick und schaumig ist und auf einem Thermometer 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Schüssel vom Herd und rühre Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Zabaione auf Dessertgläser und serviere sie sofort warm oder gekühlt mit mousseartiger Konsistenz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
