      "steps": [
        {
          "position": 0,
          "text": "Brate Currypaste und Knoblauch 2 Minuten in etwas Öl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Kokosmilch dazu und lass alles 3 Minuten köcheln. Füge Brühe, Hähnchen, Fischsauce und Zucker hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass alles 20 Minuten köcheln, bis das Hähnchen gar ist, und zerpflücke es in der Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Nudeln und verteile sie auf Schalen. Gieße Brühe und Hähnchen darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere eine kleine Handvoll Nudeln in Öl knusprig und gib sie auf jede Schale. Ergänze Limette und Koriander.",
