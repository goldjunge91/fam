    {
      "externalId": "waivy:mfr-sea2-char-kway-teow",
      "slug": "mfr-sea2-char-kway-teow",
      "title": "Char Kway Teow (gebratene flache Reisnudeln)",
      "instructions": "Malaysias und Singapurs beliebteste Nudeln: flache Reisnudeln, mit dunkler Sojasauce, Garnelen, Lap Cheong (chinesischer Wurst), Eiern und Mungobohnensprossen im sehr heißen Wok gebraten – rauchig, angeröstet und unwiderstehlich.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 8,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Dunkle Sojasauce sorgt für die typische Farbe – helle Sojasauce allein reicht nicht.",
        "Für Char Kway Teow brauchst du sehr hohe Hitze – verwende die stärkste Flamme.",
        "Tiefgekühlte flache Reisnudeln aus asiatischen Lebensmittelgeschäften funktionieren besser als getrocknete."
      ],
      "substitutions": [
        {
          "forIngredientId": "dark-soy",
          "swap": "Sojasauce, brauner Zucker und ein Tropfen Melasse"
        },
        {
          "forIngredientId": "oyster-sauce",
          "swap": "Hoisinsauce – dickflüssiger, aber sehr ähnliches Aroma"
        }
      ],
      "crispinessLevel": null,
