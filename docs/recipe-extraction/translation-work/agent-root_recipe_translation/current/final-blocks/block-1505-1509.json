    {
      "externalId": "waivy:mfr-sea2-pad-krapao-noodles",
      "slug": "mfr-sea2-pad-krapao-noodles",
      "title": "Thailändische Basilikum-Hähnchen-Nudelpfanne (Pad Krapao-Art)",
      "instructions": "Das thailändische Pfannengericht mit gehacktem Hähnchen und Thai-Basilikum, kräftig gewürzt mit Austernsauce und Fischsauce – hier mit Glasnudeln statt Reis als Nudelgericht aus einer Schale, inspiriert von Bangkoks beliebtestem Streetfood.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 10,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Frisches Thai-Basilikum ist wichtig – durch die Hitze fällt es zusammen und entfaltet sein anisartiges Aroma.",
        "Dieses vollständige Abendessen gehört zu den schnellsten Gerichten der asiatischen Küche und ist in insgesamt 20 Minuten fertig.",
        "Hähnchenhackfleisch ist günstiger und einfacher – du brauchst Hähnchenbrust nicht selbst zu zerkleinern."
      ],
      "substitutions": [
        {
          "forIngredientId": "basil-fresh",
          "swap": "Normaler italienischer Basilikum – anderes, aber ebenfalls gutes Aroma"
        },
        {
          "forIngredientId": "thai-chili",
          "swap": "Serrano-Chili oder 1 TL Chili-Knoblauch-Sauce"
        }
      ],
