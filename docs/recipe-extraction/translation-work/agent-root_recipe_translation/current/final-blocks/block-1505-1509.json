      "steps": [
        {
          "position": 0,
          "text": "Für schnell eingelegte Karotte: Schneide sie in feine Streifen, vermische sie mit Reisessig, Zucker und einer Prise Salz und lass sie 15 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mariniere das Hähnchen in Sojasauce, Fischsauce, Knoblauch und Limette. Brate es in einer heißen Pfanne an, bis es leicht angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche die Reisnudeln und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für die Sriracha-Mayonnaise: Verrühre Mayonnaise mit Sriracha nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte Nudeln, geschnittenes Hähnchen, eingelegte Karotte, Gurke, Koriander und Frühlingszwiebel in Bowls an. Beträufle alles mit Sriracha-Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
