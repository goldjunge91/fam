      "steps": [
        {
          "position": 0,
          "text": "Erhitze den Wok sehr stark. Koche flache Reisnudeln nach Packungsangabe und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Öl in den Wok und brate Knoblauch 10 Sekunden im Wok an. Füge Garnelen hinzu und brate sie auf jeder Seite 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Nudeln, Sojasauce, dunkle Sojasauce und Austernsauce dazu und schwenke alles rasch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe alles an den Rand und rühre die Eier in der Mitte des Woks. Vermische anschließend alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Mungobohnensprossen und Frühlingszwiebel dazu und schwenke den Wok. Beträufle das Gericht mit Sesamöl und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
