      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust in kleine Stücke würfeln und Knoblauch fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 EL Öl in einem Wok oder einer großen Pfanne bei starker Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das gewürfelte Hähnchen hinzufügen und 3–4 Minuten unter Rühren durchgaren. Dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das restliche Öl hinzufügen und die Eier im Wok zu Rührei braten, dabei in kleine Stücke zerteilen. Dann herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehackten Knoblauch und gewürfelte Chili in den Wok geben und 20 Sekunden unter Rühren braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekühlten Reis hinzufügen, Klumpen aufbrechen und 2 Minuten unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hähnchen und Ei zurück in den Wok geben. Erbsen, Karotten, Sojasauce und Austernsauce hinzufügen und alles vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "1 Minute unter Rühren braten, bis das Gemüse heiß ist. Mit geschnittenen Frühlingszwiebeln belegen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
