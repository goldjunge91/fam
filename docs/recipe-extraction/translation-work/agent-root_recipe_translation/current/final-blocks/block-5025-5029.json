          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bohnensprossen hinzufügen und 1 Minute erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Serviertellern anrichten und mit zerstoßenen Erdnüssen, Limettenspalten und frischen Kräutern belegen.",
