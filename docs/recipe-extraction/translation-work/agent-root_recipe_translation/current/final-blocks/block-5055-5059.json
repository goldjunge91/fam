      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Guajillo- und Ancho-Chilis 2 Minuten in einer trockenen Pfanne, bis sie duften. Weiche sie anschließend 15 Minuten in heißem Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere die eingeweichten Chilis mit Mandeln, Knoblauch, der Hälfte der Zwiebel, Sesamsamen und 1 Tasse Chili-Einweichwasser glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze einen Schmortopf bei mittelhoher Hitze und bräune die Rinderrippchen von allen Seiten an, insgesamt etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle die restliche Zwiebel und dünste sie zusammen mit den angebratenen Rippchen 3 Minuten im Topf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seihe die Chili-Mandel-Mischung in den Topf. Gib Sojasauce und die restliche Rinderbrühe dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf niedrige Stufe, decke den Topf ab und lasse das Gericht 90 Minuten köcheln, bis das Rindfleisch mit der Gabel zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die geschnittenen Kochbananen während der letzten 20 Minuten dazu und lasse alles weiterköcheln, bis die Kochbananen weich sind und die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
