      "steps": [
        {
          "position": 0,
          "text": "Vermische Masa Harina, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage weiches Schmalz cremig. Gib es abwechselnd mit warmer Hühnerbrühe zur Masa-Mischung und verrühre alles zu einem streichfähigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mische gezupftes Hähnchenfleisch mit Gochujang, gehacktem Kimchi und Sesamöl in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Maishüllen ab und verstreiche 2 Esslöffel Masa-Teig jeweils mittig auf einer Hülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1 Esslöffel Kimchi-Hähnchen-Füllung in die Mitte jeder Teigportion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage die Hüllen um die Füllung, sodass sie eingeschlossen ist. Stelle die Tamales mit der offenen Seite nach oben in einen Dämpfeinsatz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Dämpfe sie 45-50 Minuten, bis sich der Masa-Teig leicht von den Hüllen löst. Achte darauf, dass während des Garens immer genug Wasser im Topf ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
