      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel in einer Pfanne an. Rühre Pinienkerne, Piment, Salz und Pfeffer ein und lasse die Füllung vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Filoteigblätter in 3-inch breite Streifen und decke die übrigen Blätter mit einem feuchten Tuch ab, damit sie nicht austrocknen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 1 EL Füllung an eine Ecke jedes Streifens und falte diese Ecke zu einem Dreieck. Falte dann entlang des Streifens weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Sambousek-Dreiecke portionsweise 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege sie auf Küchenpapier, damit überschüssiges Öl abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm mit Joghurt- oder Tahinisauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
