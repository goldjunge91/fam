      "steps": [
        {
          "position": 0,
          "text": "Löse das Lipasepulver 30 Minuten vor der Käseherstellung in kühlem, nicht chloriertem Wasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Milch auf 90°F und gib Essig dazu. Füge dann die aufgelöste Lipase hinzu und rühre 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib verdünntes Lab (mit 0.25 cup kühlem Wasser vermischt) dazu und rühre 3 Minuten. Lasse alles dann 30 Minuten stehen, bis sich Käsebruch bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide den Käsebruch in erbsengroße Stücke und rühre 15 Minuten vorsichtig, während du ihn langsam auf 104°F erhitzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Käsebruch durch ein Käsetuch ab und presse ihn fest. Schneide ihn dann in Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze die abgetropfte Molke auf 190°F und gib den Käsebruch zurück hinein. Rühre 5 Minuten vorsichtig, bis er elastisch wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Käsebruch mit einer Schaumkelle heraus, drücke ihn flach, lasse ihn abkühlen, schneide ihn in Scheiben und brate ihn in der Pfanne goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
