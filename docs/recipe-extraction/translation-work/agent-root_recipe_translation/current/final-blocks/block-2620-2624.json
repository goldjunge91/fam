      "steps": [
        {
          "position": 0,
          "text": "Zerkleinere gewürfelte Zwiebel, Petersilie und Minze in einer Küchenmaschine fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Lammhackfleisch, Kräutermischung, Ei, Salz, Pfeffer und Sumach in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Masse in 8 gleich große Portionen und forme jede fest um einen flachen Metallspieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die Koobideh von allen Seiten mit Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille sie über Holzkohle oder in einer Grillpfanne bei mittelhoher Hitze 12-15 Minuten. Wende sie häufig, bis sie durchgegart sind und verkohlte Ränder haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie 2 Minuten ruhen und ziehe sie dann von den Spießen auf ein Schneidebrett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie auf warmem Pitabrot mit geschnittenen Zwiebeln, Tomaten und Joghurtsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
