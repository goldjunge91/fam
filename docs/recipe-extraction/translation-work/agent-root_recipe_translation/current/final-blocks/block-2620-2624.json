        },
        {
          "position": 1,
          "text": "Gieße den Joghurt in das ausgelegte Sieb und binde die Ecken des Tuchs zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hänge das Bündel über einer Schüssel 8 Stunden oder über Nacht in den Kühlschrank, bis die Molke abgetropft und das Labneh dick wie Frischkäse ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle das Labneh in eine Servierschüssel und würze es mit Salz.",
