      "steps": [
        {
          "position": 0,
          "text": "Bringe Milch und Brühe in einem schweren Topf bei mittlerer Hitze zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Polenta langsam unter ständigem Rühren mit dem Schneebesen in die Flüssigkeit, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf niedrig und rühre 15-20 Minuten häufig mit einem Holzlöffel, bis die Polenta sehr dick und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Butter, Fontina und Parmesan ein, bis alles vollständig geschmolzen und vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz, Pfeffer und Muskatnuss abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Polenta in eine gebutterte Servierschale oder einzelne Schüsseln und serviere sie heiß. Nach Wunsch mit zusätzlicher geschmolzener Butter und Käse beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
