          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße stückige Tomaten in die Pfanne und lasse sie unter gelegentlichem Rühren 10-12 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bewahre 1 cup Nudelwasser auf und gieße die Nudeln ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die abgetropften Nudeln in die Soße und füge nach Bedarf Nudelwasser hinzu, bis die gewünschte Konsistenz erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort servieren und mit frischer Petersilie sowie zusätzlichen Chiliflocken garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
