      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen. Gib Nudeln hinein und gare sie al dente.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze währenddessen Olivenöl in einer großen Pfanne bei mittlerer bis niedriger Hitze. Gib geschnittenen Knoblauch und Chiliflocken hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gare Knoblauch und Chiliflocken 2-3 Minuten, bis sie duften. Achte darauf, dass der Knoblauch nicht anbrennt.",
