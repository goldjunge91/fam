      "steps": [
        {
          "position": 0,
          "text": "Lege das Kalbfleisch zwischen Frischhaltefolie und klopfe es mit einem Fleischklopfer auf eine Dicke von quarter-inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege je ein Salbeiblatt und eine Scheibe Prosciutto auf jedes Kalbfleischstück und befestige sie mit einem Zahnstocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Saltimbocca im Mehl und klopfe überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl und Butter in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Saltimbocca portionsweise 2-3 Minuten pro Seite, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Wein in die Pfanne und lasse die Soße 3-4 Minuten köcheln und leicht einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und sofort mit der darübergeträufelten Pfannensoße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
