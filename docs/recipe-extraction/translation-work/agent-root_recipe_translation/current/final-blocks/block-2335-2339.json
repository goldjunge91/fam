      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Steinpilze in 1 cup heißem Wasser 15 Minuten ein und gieße sie dann ab. Bewahre die Flüssigkeit auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Brühe in einem Topf und halte sie während der gesamten Zubereitung leicht köchelnd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die Zwiebel und hacke den Knoblauch. Dünste beides in Olivenöl und 1 Esslöffel Butter in einer breiten Pfanne bei mittlerer Hitze 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis hinzu und rühre ihn 2 Minuten ständig, bis die Ränder glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wein ein und rühre, bis er aufgenommen ist. Füge dann die eingeweichten Steinpilze hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Brühe schöpflöffelweise hinzu und rühre häufig. Warte mit jeder weiteren Zugabe, bis die Flüssigkeit aufgenommen wurde (insgesamt etwa 18-20 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate frische Pilze separat in einer Pfanne mit Salz und Pfeffer an und gib sie in den letzten 3 Minuten der Garzeit zum Risotto.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenn der Reis cremig und zart ist, rühre restliche Butter und Parmesan ein. Abschmecken und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
