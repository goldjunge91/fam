      "steps": [
        {
          "position": 0,
          "text": "Flusskrebsfleisch, Mayonnaise, Ei, Frühlingszwiebeln, Paprika, Senf, Worcestershiresauce und Old Bay in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1/2 cup Panko-Semmelbrösel einrühren und vorsichtig unterheben, damit das Flusskrebsfleisch nicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung zu 8 Bratlingen formen und 10 Minuten im Kühlschrank kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Übrige 1/4 cup Panko auf einem Teller verteilen und beide Seiten jedes Küchleins damit bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer Pfanne bei mittlerer Hitze erhitzen und Küchlein 3-4 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einen mit Küchenpapier ausgelegten Teller legen und warm mit Remoulade oder Zitrone servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
