      "steps": [
        {
          "position": 0,
          "text": "Zwiebel, Sellerie und Paprika klein würfeln und Knoblauch hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen großen Topf bei mittlerer Hitze erwärmen und das gewürfelte Gemüse 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dosentomaten samt Saft und Hühnerbrühe angießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Salz, Cayennepfeffer und Thymian hinzufügen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ohne Deckel 15 Minuten köcheln lassen, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garnelen hinzufügen und unter gelegentlichem Rühren 4-5 Minuten garen, bis sie rosa und durch sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und vor dem Servieren auf Reis nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
