      "steps": [
        {
          "position": 0,
          "text": "Okra waschen und vollständig trocken tupfen, dann Stiele entfernen und in 1/2-inch-Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maisgrieß, Mehl, Salz, Cayennepfeffer und schwarzen Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Okra-Stücke in der Maisgrießmischung wenden, bis sie vollständig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer tiefen Pfanne oder einem Schmortopf auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Okra portionsweise 2-3 Minuten goldbraun und knusprig frittieren; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einer Schaumkelle herausnehmen und auf Küchenpapier abtropfen lassen, dann sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
