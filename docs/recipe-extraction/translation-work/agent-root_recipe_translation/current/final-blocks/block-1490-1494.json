      "steps": [
        {
          "position": 0,
          "text": "Bräune die Rindfleischstücke bei hoher Hitze in Öl an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare Zwiebel, Karotte und Sellerie im selben Topf 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch, Tomatenmark, Worcestershiresauce, Thymian und Lorbeerblatt dazu. Gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Rindfleisch zurück in den Topf und füge Brühe und Kartoffeln hinzu. Bring die Suppe zum Kochen und lass sie 45 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die tiefgekühlten Erbsen in den letzten 5 Minuten dazu. Würze gut und entferne das Lorbeerblatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
