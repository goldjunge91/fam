      "steps": [
        {
          "position": 0,
          "text": "Mariniere das Rinderhackfleisch in einer Schüssel mit 1 EL Sojasauce, 1 EL Sesamöl und 1 gehackten Knoblauchzehe 10 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blanchiere den gehackten Spinat 1 Min., gieße ihn ab und vermenge ihn mit dem restlichen gehackten Knoblauch, 0.5 EL Sesamöl und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 EL Pflanzenöl in einer Pfanne bei mittlerer bis hoher Hitze und brate die Pilze goldbraun. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate in derselben Pfanne die geriebene Karotte 2 Minuten und anschließend die Zucchini weitere 2 Minuten. Nimm beides heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate das marinierte Hackfleisch 4–5 Minuten und zerteile es dabei mit dem Kochlöffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Eier in einer separaten Pfanne mit noch flüssigem Eigelb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile den gekochten Reis auf zwei Schalen und richte Gemüse und Fleisch getrennt darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verrühre Gochujang mit 1 EL Sesamöl und 1 EL Wasser zu einer Sauce und träufle sie über den Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Setze je ein Spiegelei auf die Schalen und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
