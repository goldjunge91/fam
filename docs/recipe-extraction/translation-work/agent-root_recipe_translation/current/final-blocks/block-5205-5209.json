      "steps": [
        {
          "position": 0,
          "text": "Schmilz die Butter in einem großen Topf bei mittlerer Hitze und dünste die gewürfelte Zwiebel 3–4 Minuten an, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den gehackten Knoblauch dazu und brate ihn etwa 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Gemüsebrühe dazu, gib die gewürfelten Kartoffeln hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den gehackten Brokkoli dazu und lass alles bei mittlerer Hitze 12–15 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Schlagsahne und Thymian ein und erhitze die Suppe, ohne sie nochmals aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und rühre den geriebenen Cheddar nach und nach ein, bis er vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke die Suppe mit Salz und Pfeffer ab und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
