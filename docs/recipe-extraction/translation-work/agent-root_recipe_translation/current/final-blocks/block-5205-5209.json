      "steps": [
        {
          "position": 0,
          "text": "Koche den Naturreis nach Packungsanleitung und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze und brate das Rinderhackfleisch unter Zerteilen 5–7 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße überschüssiges Fett ab und würze das Fleisch mit Kreuzkümmel, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme schwarze Bohnen und Mais zusammen 3–4 Minuten in einem Topf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den gekochten Reis auf zwei Schalen und richte Salat, gewürztes Fleisch, Bohnen, Mais und Käse darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib jeweils einen Klecks saure Sahne und Salsa dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse frischen Limettensaft darüber und serviere die Bowls sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
