      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 EL Pflanzenöl in einer großen Pfanne oder einem Wok bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Garnelen hinein und brate sie unter Rühren 2–3 Minuten, bis sie rosa sind. Nimm sie anschließend heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl in dieselbe Pfanne, rühre die verquirlten Eier darin zu Rührei und nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den gehackten Knoblauch hinein und brate ihn unter Rühren etwa 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den gekühlten Reis dazu, lockere Klumpen auf und brate ihn unter Rühren 3–4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Garnelen und Eier zurück in die Pfanne und füge tiefgekühltes Gemüse, Sojasauce und Sesamöl hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge alles 2 Minuten und garniere das Gericht zum Schluss mit Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
