      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig mit Nierenfett zu: Vermische Mehl und Salz, reibe kaltes Nierenfett hinein und gib nach und nach Wasser dazu, bis ein Teig entsteht. Stelle ihn 20 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestäube Rindergulasch und gewürfelte Niere mit Mehl, das mit Salz und Pfeffer gewürzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle zwei Drittel des Teigs aus und kleide ein gebuttertes Puddingbecken damit aus. Lasse den Teig über den Rand hängen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle Rindfleisch, Niere, Zwiebel und Thymian hinein und gieße Rinderbrühe fast bis zum Rand dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den restlichen Teig als Deckel aus, lege ihn auf die Füllung und drücke die Ränder fest zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Pudding mit gebuttertem Backpapier und Folie ab und binde alles mit Küchengarn fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle das Puddingbecken in einen Topf mit siedendem Wasser, das bis zur halben Höhe des Beckens reicht, und dämpfe es 2.5-3 Stunden. Fülle bei Bedarf Wasser nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm das Becken vorsichtig aus dem Dampfgarer, lasse den Pudding 5 Minuten ruhen und stürze ihn dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere ihn heiß mit der kräftigen Sauce aus dem Inneren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
