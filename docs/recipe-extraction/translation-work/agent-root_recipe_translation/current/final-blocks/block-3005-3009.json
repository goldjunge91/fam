      "steps": [
        {
          "position": 0,
          "text": "Brate Speckscheiben in einer großen Pfanne bei mittelhoher Hitze knusprig an und lege sie zum Abtropfen auf Küchenpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße den Großteil des Speckfetts ab und lasse etwa 2 tbsp in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Laverbread aus der Dose mit Haferflocken, Salz, Pfeffer und Zitronensaft in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Laverbread-Mischung 8 Bratlinge und lege sie in die Pfanne mit Speckfett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Bratlinge bei mittlerer Hitze 3-4 Minuten pro Seite, bis die Ränder leicht knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Laverbread-Bratlinge heiß neben knusprigem Speck als traditionelles walisisches Frühstück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
