          "position": 1,
          "text": "Würfle Zwiebel, Paprika und Knoblauch und brate sie 3 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Scotch-Bonnet-Chili dazu und gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Reis ein und röste ihn unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Tomatensauce, gewürfelte Tomaten und Brühe dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze auf niedrig, decke die Pfanne ab und lasse den Reis ohne Rühren 25 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd, lasse alles zugedeckt 5 Minuten ruhen und lockere den Reis dann mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
