      "steps": [
        {
          "position": 0,
          "text": "Die Hähnchenbrust zwischen Frischhaltefolie auf eine Dicke von 1/4 Zoll flach klopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Semmelbrösel, 2 EL Parmesan und Salz in einer flachen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Ei in einer zweiten Schüssel verquirlen. Das Hähnchen zuerst in das Ei tauchen, dann in der Bröselmischung wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einer Pfanne bei mittelhoher Hitze erhitzen und das Hähnchen je Seite 6 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hitze auf mittlere Stufe reduzieren und Marinara-Sauce auf dem Hähnchen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mozzarella und den restlichen Parmesan daraufgeben. Die Pfanne abdecken und 3 Minuten garen, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Brotscheiben rösten und das panierte Hähnchen darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit zusätzlicher Marinara-Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
