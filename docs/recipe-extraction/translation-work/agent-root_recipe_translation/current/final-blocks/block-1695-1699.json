      "steps": [
        {
          "position": 0,
          "text": "Mahle die Mandeln in einer Mandelmühle oder Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mandeln und Puderzucker in einer großen Schüssel. Gib drei Eiweiße dazu und knete den Teig mit den Händen zu einer Kugel. Wickle ihn in Frischhaltefolie und stelle ihn mindestens eine Stunde, am besten bis zum nächsten Tag, kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fette die Kransekake-Formen gründlich ein und bestäube sie mit Grieß, Mehl oder Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 210°C (410°F) Ober-/Unterhitze vor. Teile den Teig in sechs Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib nach und nach das übrige Eiweiß zum Teig und knete, bis er sich zu fingerdicken Rollen formen lässt. Fülle die Formen damit und drücke die Enden zu Ringen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle die Formen auf ein Backblech und backe sie auf mittlerer Schiene etwa 10 – 12 Minuten, bis die Oberseiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
