          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauch, Ingwer und alle Gewürze hinzufügen und 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark hinzufügen und 3 Minuten garen. Abgespülte Linsen und 3 Tassen Wasser hinzugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "20 Minuten köcheln lassen, bis die Linsen weich und der Eintopf dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Zitronensaft abschließen und auf Reis oder mit Fladenbrot servieren.",
