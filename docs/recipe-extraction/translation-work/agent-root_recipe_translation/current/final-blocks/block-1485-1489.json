      "steps": [
        {
          "position": 0,
          "text": "Zwiebel und Paprika in Öl weich dünsten. Knoblauch, Kreuzkümmel, geräuchertes Paprika und Cayennepfeffer dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackte Tomaten hinzufügen und 10 Minuten köcheln lassen, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "6 Mulden formen und je ein Ei hineinschlagen. Zugedeckt bei niedriger Hitze 5–7 Minuten garen, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Petersilie und Zitronensaft abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Direkt aus der Pfanne mit warmem Brot zum Auftunken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
