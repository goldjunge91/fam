    {
      "externalId": "waivy:mfr-afr2-mafe",
      "slug": "mfr-afr2-mafe",
      "title": "Mafé (westafrikanischer Erdnusseintopf)",
      "instructions": "Ein herzhafter Erdnusseintopf aus Westafrika: Hähnchen schmort mit Tomaten, Süßkartoffeln, Kohl und wärmenden Gewürzen in einer cremigen Erdnusssauce. Mit Reis serviert wird daraus ein sättigendes Wohlfühlgericht.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 40,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Erdnussbutter kostet 20 Cent pro Esslöffel und macht die Sauce besonders reichhaltig.",
        "Süßkartoffel bindet die Sauce und ergänzt die Erdnüsse mit angenehmer Süße.",
        "Koche eine größere Menge vor: Mafé schmeckt am nächsten Tag noch besser."
      ],
      "substitutions": [
        {
          "forIngredientId": "peanut-butter",
          "swap": "Mandelmus oder Sonnenblumenkernmus als nussfreie Alternative"
        },
        {
          "forIngredientId": "chicken-thighs",
          "swap": "Lamm oder Rindfleisch, wie es in verschiedenen Regionen üblich ist"
        }
      ],
