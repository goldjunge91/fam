      "externalId": "waivy:mfr-afr2-misir-wot",
      "slug": "mfr-afr2-misir-wot",
      "title": "Misir Wot (äthiopischer roter Linseneintopf) als Bowl",
      "instructions": "Langsam gegarte rote Linsen in einer Berbere-Gewürzgrundlage mit Zwiebeln und Butterschmalz, kräftig ziegelrot, erdig und wärmend: eines der besonders sättigenden vegetarischen Gerichte Äthiopiens. Traditionell wird es auf luftigem Injera serviert, schmeckt aber auch hervorragend mit Reis oder Brot.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 40,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Langsam gebräunte Zwiebeln bilden die Grundlage von Wot; nimm dir dafür Zeit.",
        "Rote Linsen kosten 30 Cent pro Portion und sind besonders eiweißreich.",
        "Das Gericht schmeckt 3 Tage lang immer besser; bereite einen großen Topf zu."
      ],
      "substitutions": [
        {
          "forIngredientId": "smoked-paprika",
          "swap": "Berbere-Gewürzmischung, falls erhältlich, für ein komplexeres Aroma"
        },
        {
          "forIngredientId": "coriander-seed",
          "swap": "Gemahlener Koriander; nimm die halbe Menge"
        }
      ],
