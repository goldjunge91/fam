      "steps": [
        {
          "position": 0,
          "text": "Hähnchenschenkel mit Papiertüchern trocken tupfen und großzügig mit Salz und schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze schmelzen und die Hähnchenschenkel auf beiden Seiten anbraten, insgesamt etwa 8 Minuten, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie in derselben Pfanne die restlichen 2 Esslöffel Butter hinzu und braten Sie den gehackten Knoblauch bei mittlerer Hitze etwa 1 Minute lang an, bis er duftet. Achten Sie dabei darauf, ihn nicht zu verbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sahne und Milch unter Rühren dazugeben und die Hähnchenschenkel wieder in die Soße legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zugedeckt 20-25 Minuten köcheln lassen, bis das Hähnchen gar ist und die Soße leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehackten Koriander und Paprikapulver unterrühren und bei Bedarf mit zusätzlichem Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit der cremigen Knoblauchsauce servieren, die über das Huhn gelöffelt wird, traditionell begleitet von frischem Brot, um die Sauce aufzusaugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
