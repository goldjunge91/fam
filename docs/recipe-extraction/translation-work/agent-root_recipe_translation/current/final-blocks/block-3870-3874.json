      "steps": [
        {
          "position": 0,
          "text": "Zwiebel, Knoblauch, Petersilie und Koriander fein hacken und in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fügen Sie Rinderhackfleisch, Salz, Pfeffer und rote Pfefferflocken zur Kräutermischung hinzu und vermischen Sie es vorsichtig mit Ihren Händen, bis es sich gerade vermischt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie die Fleischmischung in 8 Portionen und formen Sie sie jeweils auf flache Metallspieße und drücken Sie sie fest zu einer langen ovalen Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heizen Sie einen Außengrill oder eine Grillpfanne auf mittlere bis hohe Hitze vor und ölen Sie die Oberfläche leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grillen Sie die Kebabs 6-7 Minuten pro Seite und wenden Sie sie dabei einmal, bis sie durchgegart und außen verkohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einen Teller geben und vor dem Servieren 3 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
