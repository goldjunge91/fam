      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Kidneybohnen über Nacht in Wasser einweichen, dann abtropfen lassen und gründlich abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und gewürfelte Zwiebeln und Knoblauch etwa 5 Minuten anbraten, bis sie weich und duftend sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark und Korianderpulver einrühren und 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abgetropfte Bohnen und Wasser hinzufügen, dann zum Kochen bringen und die Hitze auf einen niedrigen Wert reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zugedeckt 60-70 Minuten köcheln lassen, bis die Bohnen sehr zart sind, dabei gelegentlich umrühren und bei Bedarf Wasser hinzufügen, um den Brühenstand aufrechtzuerhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwa ein Drittel der Bohnen an der Topfwand zerdrücken, um den Eintopf zu verdicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gehackten Koriander, Salz und schwarzen Pfeffer unterrühren und dann warm in Schüsseln servieren, traditionell in Tontöpfen, falls verfügbar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
