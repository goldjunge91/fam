      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust in Salzwasser 20 Minuten kochen, bis sie vollständig gar ist, dann in mundgerechte Stücke schneiden und die Brühe aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch in einem großen Topf 2 Minuten anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gemahlene Walnüsse in den Topf geben und 2 Minuten unter ständigem Rühren rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fügen Sie der Walnussmischung 2 Tassen der beiseitegestellten Hühnerbrühe, weißen Essig, Paprika, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Soße 10 Minuten köcheln lassen und dabei gelegentlich umrühren, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehacktes Hähnchenfleisch zur Soße geben und 5 Minuten köcheln lassen, um die Aromen zu vereinen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und je nach Bedarf mit Salz, Pfeffer oder Essig nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm servieren, garniert mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
