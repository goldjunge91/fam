      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor. Besprühe eine Muffinform mit 12 Mulden großzügig mit Backtrennspray.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Paprika und Zwiebel fein. Zupfe oder hacke den Spinat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, Milch, Knoblauchpulver, italienische Kräuter, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile das gewürfelte Gemüse und den Spinat auf die 12 Mulden. Gieße die Eiermischung darüber, sodass jede Mulde etwa zu ¾ gefüllt ist. Streue Käse darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Muffins 18–22 Minuten, bis die Eier gestockt und die Oberseiten leicht goldbraun sind. Lass sie vor dem Aufbewahren abkühlen. Bis zu 5 Tage im Kühlschrank lagern; in der Mikrowelle 30 Sekunden aufwärmen.",
          "timerMinutes": null,
