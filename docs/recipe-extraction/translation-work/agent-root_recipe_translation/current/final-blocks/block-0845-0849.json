      "steps": [
        {
          "position": 0,
          "text": "Presse zwei Blöcke Tofu 10 Minuten zwischen Tüchern aus. Schneide ihn in ½-inch-Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge den Tofu mit Sesamöl, Knoblauchpulver und etwas Teriyaki-Sauce. Verteile ihn auf einem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib auf einen anderen Teil des Blechs Brokkoliröschen, die du mit Sesamöl und Salz vermengt hast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe alles bei 400°F 25–28 Minuten. Wende den Tofu nach der Hälfte der Zeit, bis er goldbraun und der Brokkoli karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche den Reis. Verteile ihn auf 4 Boxen. Träufle zusätzliche Teriyaki-Sauce über den Tofu und bestreue ihn mit Sesamsamen und Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
