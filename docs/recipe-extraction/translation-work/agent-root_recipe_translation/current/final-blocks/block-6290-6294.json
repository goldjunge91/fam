      "steps": [
        {
          "position": 0,
          "text": "Entferne die zähen violetten äußeren Schichten der Bananenblüten und löse die kleinen Blüten aus dem zarten hellen Inneren. Weiche sie anschließend 10 Minuten in Salzwasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass die Blüten abtropfen und schneide sie in mundgerechte Stücke. Entferne die zähen Stielteile.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Topf und brate Knoblauch, Ingwer und geschnittene Zwiebel 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Schweinehackfleisch dazu und gare es 5 Minuten unter Zerteilen mit einem Löffel, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge die vorbereiteten Bananenblüten hinzu und brate sie 3 Minuten unter Rühren. Gib dann Garnelen dazu und gare sie, bis sie rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kokosmilch dazu und bringe alles sanft zum Köcheln. Würze mit Fischsauce, Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass alles 15 Minuten köcheln und rühre gelegentlich um, bis die Bananenblüten weich sind und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
