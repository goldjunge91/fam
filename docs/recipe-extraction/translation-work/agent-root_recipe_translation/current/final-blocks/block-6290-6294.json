      "steps": [
        {
          "position": 0,
          "text": "Schneide den Tintenfisch in Ringe und tupfe alle Meeresfrüchte mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und brate gewürfelte Zwiebel und gehackten Knoblauch an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Tintenfisch dazu und gare ihn 5 Minuten, bis er weich zu werden beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein dazu und lass alles 3 Minuten köcheln, damit die Flüssigkeit etwas reduziert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomaten aus der Dose samt Saft und Safran dazu und lass alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Füge Fischfilets und Garnelen hinzu, bette sie in die Sauce und lass alles 8-10 Minuten köcheln, bis die Meeresfrüchte gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Meersalz und schmecke das Gericht ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere es mit frischer Petersilie und serviere es in Schalen mit knusprigem Brot, um die Sauce aufzutunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
