      "steps": [
        {
          "position": 0,
          "text": "Säubere und häute den Aal vorsichtig und schneide ihn dann in 2-inch-Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen schweren Pfanne und brate geschnittene Zwiebel und zerdrückten Knoblauch goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Aalstücke dazu und gare sie unter gelegentlichem Wenden 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Vernaccia-Wein dazu und lass alles 5 Minuten köcheln, damit die Flüssigkeit etwas reduziert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomaten aus der Dose samt Saft, Lorbeerblatt und Rosmarinzweig dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und lass alles 40-45 Minuten sanft köcheln, bis der Aal sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne Lorbeerblatt und Rosmarinzweig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere den Aal heiß mit Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
