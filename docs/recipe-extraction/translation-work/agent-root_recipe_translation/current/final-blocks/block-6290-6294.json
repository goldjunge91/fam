      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweinerippchen in einzelne Stücke und blanchiere sie 3 Minuten in kochendem Wasser, um Verunreinigungen zu entfernen. Gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und brate geschnittenen Ingwer und gehackten Knoblauch 2 Minuten an, bis sie duften und leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kurkuma dazu und rühre 30 Sekunden. Füge dann die blanchierten Rippchen hinzu und brate sie 3 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 4 cups frisches Wasser dazu und bringe alles zum Kochen. Schöpfe restlichen Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kandiszucker, Fischsauce und Pfefferkörner dazu. Reduziere die Hitze auf mittlere bis niedrige Stufe und lass alles ohne Deckel 45 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass das Gericht weiter köcheln, bis das Schweinefleisch zart und die Brühe auf eine kräftige bernsteinfarbene Farbe reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und serviere das Gericht heiß mit Reis. Schöpfe die aromatische Brühe über jede Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
