      "steps": [
        {
          "position": 0,
          "text": "Öffne die junge Kokosnuss vorsichtig und löse das zarte weiße Fruchtfleisch in mundgerechten Stücken heraus. Fange das Kokoswasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere rote Chilis, Schalotten, Knoblauch und Ingwer zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne und brate die Gewürzpaste 2 Minuten an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Kokosfleisch dazu, rühre gut um und gare es 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch und 1/2 Tasse aufgefangenes Kokoswasser dazu und füge Zitronengras und Salz hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles 15–20 Minuten köcheln und rühre gelegentlich um, bis die Sauce leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne das Zitronengras und schmecke ab. Passe die Salzmenge bei Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß als Beilage zu Reis oder anderen Padang-Gerichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
