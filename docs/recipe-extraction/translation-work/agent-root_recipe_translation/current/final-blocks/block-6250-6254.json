      "steps": [
        {
          "position": 0,
          "text": "Halbiere die Auberginen längs und schneide jede Hälfte anschließend in 2 Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Frittiere die Auberginenstücke portionsweise in Öl bei 350°F etwa 4 Minuten, bis sie weich und leicht goldbraun sind. Lasse sie abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere rote Chilis, Knoblauch und Schalotten mit 2 Esslöffeln Wasser zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze 2 Esslöffel frisches Öl in einem Wok und brate die Chilipaste 1.5 Minuten an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die frittierten Auberginen zur Chilipaste und wende sie vorsichtig 2 Minuten darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Salz, Palmzucker, Limettensaft und Wasser hinzu und lasse alles 5 Minuten köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß als Beilage zu Reis und anderen Speisen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
