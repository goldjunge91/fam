      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz mischen, dann die kalte Butter einarbeiten, bis die Mischung wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Langsam Wasser hinzufügen, bis sich ein Teig bildet; In Plastikfolie einwickeln und 30 Minuten im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In der Zwischenzeit Olivenöl erhitzen und das Hackfleisch mit gewürfelten Zwiebeln und Knoblauch anbraten, dabei das Fleisch beim Garen auseinanderbrechen, etwa 5–7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Füllung mit Kreuzkümmel, Salz und Pfeffer würzen und leicht abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf einer bemehlten Arbeitsfläche dünn ausrollen und in 3 Zoll große Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie einen Teelöffel Füllung auf jedes Quadrat, falten Sie es zu einem Dreieck und drücken Sie die Ränder mit einer Gabel fest, um sie zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und Pastelitos portionsweise 2-3 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Papiertüchern abtropfen lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
