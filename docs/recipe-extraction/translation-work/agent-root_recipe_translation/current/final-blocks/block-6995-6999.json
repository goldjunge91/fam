      "steps": [
        {
          "position": 0,
          "text": "Sauerteig, Wasser und Mehl in einer großen Schüssel vermischen, bis ein zottiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "30 Minuten ruhen lassen (Autolyse), dann Salz hinzufügen und 10 Minuten lang kneten, bis eine glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In eine geölte Schüssel geben, abdecken und 4–6 Stunden bei Zimmertemperatur gehen lassen, dabei jede Stunde falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig auf eine bemehlte Fläche geben und zu einer runden Kugel formen, dann auf Backpapier legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit einem Handtuch abdecken und 1-2 Stunden gehen lassen, bis der Teig aufgeht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heizen Sie den Ofen 450 Minuten lang mit einem Schmortopf im Inneren auf 30 °F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Oberseite des Teigs mit einem Messer einschneiden, vorsichtig in den heißen Schmortopf geben und zugedeckt 20 Minuten backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Deckel abnehmen und weitere 20–25 Minuten backen, bis es tief goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Vor dem Servieren mindestens 30 Minuten auf einem Kuchengitter abkühlen lassen; Bei Verwendung als Schüssel für Suppe oder Eintopf leicht aushöhlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
