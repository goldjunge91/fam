      "steps": [
        {
          "position": 0,
          "text": "Das Rinderhackfleisch in einer Pfanne mit gewürfelten Zwiebeln und gehacktem Knoblauch bei mittlerer bis hoher Hitze anbraten und beim Kochen etwa 5–7 Minuten lang zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Überschüssiges Fett abtropfen lassen, dann die schwarzen Bohnen (mit Flüssigkeit) hinzufügen und etwa 2 Minuten lang rühren, bis alles durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitzen Sie die Tortillas in einer trockenen Pfanne oder über einer Flamme, bis sie geschmeidig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Legen Sie eine Tortilla flach und geben Sie Reis in die Mitte. Geben Sie dann die Rindfleisch-Bohnen-Mischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Käse bestreuen, mit Salsa und Sauerrahm beträufeln und Koriander hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falten Sie die Seiten der Tortilla über die Füllung und rollen Sie sie dann von unten nach oben fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der Nahtseite nach unten in eine heiße Pfanne legen und auf jeder Seite 1–2 Minuten goldbraun rösten, oder in Folie einwickeln und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
