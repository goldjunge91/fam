      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf oder Schmortopf bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Schweinefleischwürfel von allen Seiten und nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste Zwiebel und Knoblauch im selben Topf etwa 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Schweinefleisch zurück in den Topf und füge Tomatensauce, Sojasauce und Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, decke den Topf ab und gare das Fleisch 30 Minuten, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kartoffeln und Karotten hinzu und lasse alles weitere 15-20 Minuten köcheln, bis das Gemüse weich zu werden beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Paprika hinzu und gare alles weitere 5 Minuten ohne Deckel, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze nach Geschmack mit Salz und schwarzem Pfeffer und serviere das Gericht mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
