      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 tablespoons Öl in einem großen Wok oder einer Pfanne bei starker Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden, bis er duftet. Gib dann gewürfeltes Schweinefleisch dazu und brate es etwa 4 Minuten unter Rühren, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Garnelen in den Wok und gare sie etwa 3 Minuten, bis sie rosa und eingerollt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe alle Zutaten an den Rand, gib das restliche Öl dazu und füge frische Nudeln hinzu. Lockere sie beim Garen 2 Minuten auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib geraspelten Kohl dazu und brate ihn weitere 2 Minuten mit den Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße beide Sojasaucen und Hühnerbrühe dazu und vermische alles, bis die Flüssigkeit größtenteils aufgenommen ist, etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und würze es bei Bedarf mit zusätzlicher Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es sofort in Schalen mit Limettenspalten als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
