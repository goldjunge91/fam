      "steps": [
        {
          "position": 0,
          "text": "Spüle Krabben gründlich ab und schneide jede mit Schale in Viertel oder Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste schwarze Pfefferkörner 1 Minute in einer trockenen Pfanne und zerstoße sie dann grob in einem Mörser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl und Butter in einem großen Wok oder einer Pfanne bei starker Hitze, bis alles sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Krabbenstücke dazu und brate sie 3 Minuten unter Rühren, bis sich die Schalen rot färben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackten Knoblauch und geschnittene Schalotten dazu und brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue zerstoßenen schwarzen Pfeffer über die Krabben und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Sojasauce, Austernsauce und Hühnerbrühe dazu, decke den Wok ab und gare alles bei starker Hitze 5-7 Minuten, bis die Krabben gar und die Sauce leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht, würze es nach Bedarf nach, bestreue es mit gehackten Frühlingszwiebeln und serviere es sofort mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
