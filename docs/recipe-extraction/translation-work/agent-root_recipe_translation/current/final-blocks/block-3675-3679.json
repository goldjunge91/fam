      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Bananenblätter kurz in heißem Wasser, damit sie weich werden, und stelle sie zum Abkühlen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische in einer Schüssel zerpflückten Fisch, gehackte Schalotten, Knoblauch und rote Chilischoten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Fischpaste, Ei, Speisestärke, Kokosmilch, Salz und weißen Pfeffer dazu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib je einen Löffel Fischmischung auf ein Bananenblatt und falte es um die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 400°F vor und lege die Otah-Päckchen auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie 15-20 Minuten, bis die Füllung gar und die Ränder der Bananenblätter leicht angekohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Alternativ kannst du die Päckchen 10-12 Minuten grillen und nach der Hälfte der Zeit wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie leicht abkühlen und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
