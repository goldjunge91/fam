      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer Pfanne und brate Tofuwürfel rundherum goldbraun. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Garnelen in derselben Pfanne etwa 3 Minuten, bis sie rosa und gar sind, und nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerstoße Erdnüsse, rote Chilischoten, Knoblauch, Palmzucker und Salz in einem Mörser oder einer kleinen Küchenmaschine zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Erdnusspaste in eine Schüssel und rühre Tamarindenpaste ein, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Tofu, Garnelen, Gurke, Ananas und Sojasprossen in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Erdnusssauce darüber und vermische alles vorsichtig, bis die Zutaten gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und gib für mehr Säure zusätzliche Tamarindenpaste oder für mehr Süße Palmzucker hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es sofort bei Raumtemperatur oder leicht gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
