      "steps": [
        {
          "position": 0,
          "text": "Püriere Schalotten, Knoblauch, Ingwer, rote Chilischoten und Zitronengras in einer Küchenmaschine oder einem Mixer zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher bis hoher Hitze und brate die Paste 2 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfeltes Rindfleisch dazu und brate es etwa 5 Minuten unter Rühren, bis es von allen Seiten gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Kokosmilch dazu und gib Kurkuma, Galgant und Salz hinzu. Rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf mittlere bis niedrige Stufe und lasse alles ohne Deckel 40-45 Minuten köcheln. Rühre gelegentlich um, bis das Rindfleisch zart und die Sauce reduziert und eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Rendang ist fertig, wenn sich Öl von der Kokoscreme absetzt und die Sauce das Fleisch überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und gib bei Bedarf mehr Salz dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
