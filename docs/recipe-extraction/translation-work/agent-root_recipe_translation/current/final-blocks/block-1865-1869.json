      "steps": [
        {
          "position": 0,
          "text": "Zutaten vermengen: Milch, Zucker und Natron in einem großen Topf mit schwerem Boden verrühren. Bei niedriger Hitze unter ständigem Rühren kochen, damit nichts anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eindicken: Unter häufigem Rühren weiterkochen, bis die Mischung dick und karamellfarben ist, etwa 1-2 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aromatisieren: Vanilleextrakt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abkühlen: Dulce de leche abkühlen lassen und in ein Glas füllen. Beim Abkühlen dickt sie weiter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ständig rühren und die Hitze niedrig halten, damit die Milch nicht anbrennt und am Topfboden festklebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ein Tropfen Vanilleextrakt zum Ende der Kochzeit verstärkt das Aroma.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
