          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib rote Bohnen, Mochi und Mais darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue alles mit Injeolmi-Pulver und träufle zusätzliche Kondensmilch darüber.",
