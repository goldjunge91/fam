      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 350°F vor und fette eine runde Kuchenform mit 8 inch Durchmesser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Butter und Zucker hell und luftig auf. Rühre die Eier einzeln unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre abwechselnd die Mehlmischung und Milch unter die Buttermasse. Beginne und ende mit Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 3-4 Portionen und färbe jede mit einer anderen Gelfarbe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die farbigen Teige löffelweise kreisförmig in die Form und schichte sie so. Backe den Kuchen 35-40 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse den Kuchen vollständig abkühlen und schneide ihn waagerecht in 2-3 Böden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schichte die Böden mit Frischkäse-Frosting dazwischen und bestreiche Oberseite und Seiten damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Dekoriere den Kuchen mit zu einem Horn aufgespritzter Schlagsahne, Streuseln und essbarem Glitzer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
