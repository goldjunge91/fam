          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kühle ein Metallbackblech mindestens 2 Stunden im Gefrierfach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Eismischung auf das vorgekühlte Blech und verstreiche sie gleichmäßig etwa 0.5 inch dick.",
