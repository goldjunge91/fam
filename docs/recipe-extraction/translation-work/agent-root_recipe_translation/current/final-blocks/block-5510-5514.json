          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre alles gründlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Mischung mindestens 2 Stunden oder bis zu 2 Wochen kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
