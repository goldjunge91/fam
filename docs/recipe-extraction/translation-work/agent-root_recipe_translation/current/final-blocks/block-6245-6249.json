      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl, Salz und Wasser in einer Schüssel zu einem klebrigen Teig. Lass ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch und Zwiebel fein. Brate Rinderhackfleisch mit Knoblauch und Zwiebel 6 Minuten in einer Pfanne an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Rindfleischfüllung mit weißem Pfeffer und Salz und lass sie auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 2 Portionen und ziehe eine davon auf einer flachen Fläche dünn und groß aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Hälfte der Füllung auf einer Teighälfte. Klappe die andere Hälfte darüber und drücke die Ränder fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer beschichteten Pfanne bei mittlerer Hitze und brate den Martabak pro Seite 4 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege ein Ei auf den gegarten Martabak, klappe ihn zusammen und gare ihn kurz weiter, bis das Ei gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide den Martabak in Quadrate und serviere ihn heiß mit süßer Sojasauce.",
