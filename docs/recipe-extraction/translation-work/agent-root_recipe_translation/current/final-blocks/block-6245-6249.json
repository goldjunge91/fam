      "steps": [
        {
          "position": 0,
          "text": "Hacke Knoblauch und Schalotten fein. Erhitze 1 Esslöffel Öl in einer Pfanne und brate beides 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehackfleisch dazu und brate es 5 Minuten unter Zerteilen mit einem Löffel, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge gewürfelte Karotten und gehackten Kohl hinzu und brate das Gemüse 5 Minuten, bis es weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze mit Sojasauce und Salz, gare alles weitere 2 Minuten und lass die Füllung etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffel Füllung auf jedes Lumpia-Teigblatt. Rolle es fest auf und verschließe den Rand mit angefeuchteten Fingerspitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere die Lumpia portionsweise pro Seite 3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie heiß mit süßer Chilisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
