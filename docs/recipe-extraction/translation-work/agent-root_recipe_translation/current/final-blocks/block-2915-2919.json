      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und bräune das Rinderhackfleisch etwa 5-7 Minuten. Zerteile es dabei mit einem Löffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße überschüssiges Fett ab und rühre Taco-Gewürz und ½ Tasse Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse das gewürzte Rindfleisch 5 Minuten köcheln, bis die Sauce leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die Taco-Schalen nach Packungsanleitung etwa 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle die Tomaten und hacke den Salat in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Taco-Schale mit Rindfleisch und belege sie mit Käse, Salat und Tomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Tacos mit saurer Sahne und Salsa als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
