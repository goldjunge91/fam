          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Tortillas in einer trockenen Pfanne oder über offener Flamme 20 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Rindfleisch-Gemüse-Mischung auf warmen Tortillas mit frischem Koriander und Limettenspalten.",
