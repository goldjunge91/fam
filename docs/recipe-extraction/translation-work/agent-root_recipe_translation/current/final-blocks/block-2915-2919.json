      "steps": [
        {
          "position": 0,
          "text": "Bräune das Rinderhackfleisch etwa 5-7 Minuten in einem großen Topf bei mittlerer bis hoher Hitze und zerteile es dabei. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch hinzu und gare alles etwa 3 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Chilipulver und Kreuzkümmel ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Dosentomaten, Kidneybohnen und Rinderbrühe in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln und reduziere die Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel 25-30 Minuten unter gelegentlichem Rühren köcheln, bis sich die Aromen verbunden haben und die Sauce leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz, Pfeffer und Chilisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Chili heiß in Schalen und gib nach Wunsch geriebenen Käse, saure Sahne oder gewürfelte Zwiebel darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
