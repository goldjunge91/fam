      "steps": [
        {
          "position": 0,
          "text": "Röste Poblano-Chilis über offener Flamme oder unter dem Grill, bis sie rundherum schwarz sind, etwa 5-7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die gerösteten Chilis 5 Minuten in einen Plastikbeutel, damit sie dampfen, und ziehe dann vorsichtig die verkohlte Haut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide jede Chili längs ein und entferne vorsichtig Samen und Stiel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede Chili mit 2 oz Käse und erhitze dann Öl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eier mit Salz und Pfeffer, wende jede gefüllte Chili leicht in Mehl und tauche sie dann in verquirltes Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Chilis im heißen Öl insgesamt etwa 3-4 Minuten goldbraun und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse Tomatensauce mit gehacktem Knoblauch, Zwiebel, Kreuzkümmel, Salz und Pfeffer 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße warme Tomatensauce auf einen Servierteller und lege die frittierten Chiles Rellenos darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
