      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in 1/4-inch dicke Scheiben und den Speck in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Speck in einer großen Pfanne bei mittlerer Hitze knusprig. Nimm ihn mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Kartoffelscheiben portionsweise in das Speckfett. Brate sie unter gelegentlichem Wenden 15-20 Minuten goldbraun und weich. Überfülle die Pfanne nicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Speck zurück in die Pfanne. Füge gehackten Knoblauch hinzu und brate ihn 1 Minute an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und vermische den Inhalt mit gehackter Petersilie und Trüffel oder zusätzlicher Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer und serviere die Kartoffeln sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
