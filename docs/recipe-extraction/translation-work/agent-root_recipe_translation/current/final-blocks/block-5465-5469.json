      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und fette eine 9x13 Auflaufform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die Kartoffeln und schneide sie in 1/8-inch dünne Scheiben. Schneide die Zwiebeln in dünne Halbringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schichte die Hälfte der Kartoffeln in die Form und würze sie mit Salz und Pfeffer. Gib die Zwiebeln und anschließend die übrigen Kartoffeln darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze die Brühe mit Thymian und Lorbeerblatt und gieße sie über die Kartoffeln, bis diese gerade bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile Butterflöckchen darauf. Decke die Form mit Folie ab und backe alles 35-40 Minuten, bis die Kartoffeln sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Folie und backe die Kartoffeln weitere 5-10 Minuten, bis die Oberfläche zu bräunen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Gericht 5 Minuten ruhen und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
