      "steps": [
        {
          "position": 0,
          "text": "Koche die gewürfelten Kartoffeln 15 Minuten in Salzwasser, bis sie weich sind. Gieße sie ab und zerdrücke sie mit 2 Esslöffeln Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste fein gehackte Pilze, Schalotten und Knoblauch in der übrigen Butter etwa 10 Minuten an, bis die Flüssigkeit verdampft ist. Rühre Petersilie ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse Kartoffelpüree und Pilzmischung auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Blätterteig aus und schneide ihn in 4 Rechtecke. Verteile die Pilz-Kartoffel-Mischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Ecken des Teigs nach oben und verschließe die Ränder mit Wasser. Bestreiche die Oberseite mit verquirltem Eigelb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Päckchen auf ein mit Backpapier ausgelegtes Blech und backe sie bei 400°F 20-25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
