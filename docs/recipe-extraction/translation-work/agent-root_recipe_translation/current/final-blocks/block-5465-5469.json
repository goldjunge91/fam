      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und backe die Kartoffeln 40 Minuten, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blanchiere den Brokkoli 3-4 Minuten in kochendem Salzwasser und lasse ihn gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbiere die gebackenen Kartoffeln längs und lockere das Innere mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belege jede Kartoffelhälfte mit Butter, Sauerrahm, Käse, Brokkoli und Speckstückchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schiebe die Kartoffeln weitere 5 Minuten in den Ofen, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere sie mit geschnittenen Frühlingszwiebeln und serviere sie heiß. Weitere Toppings kannst du separat dazustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
