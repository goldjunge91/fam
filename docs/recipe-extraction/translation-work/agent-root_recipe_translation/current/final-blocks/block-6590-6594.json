      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen, eine Mulde formen, Eier dazugeben und nach und nach Mehl einarbeiten, bis ein glatter Teig entsteht; 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Für die Füllung abgetropften Spinat, Ricotta, Parmesan, Muskatnuss, Pfeffer und sautierte Zwiebeln vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig zwischen zwei Stücken Backpapier dünn zu einem großen Rechteck ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Füllung gleichmäßig auf dem Teig verteilen und rundherum einen 1 Zoll breiten Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie den Teig fest zu einer Rolle und verschließen Sie die Naht mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wickeln Sie die Rolle in ein Käsetuch, binden Sie die Enden zusammen und legen Sie sie dann in einen Topf mit kochendem Salzwasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "30-35 Minuten köcheln lassen, bis die Rolle schwimmt und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Rolle herausnehmen und auswickeln. In 1 Zoll dicke Scheiben schneiden und in Butter anbraten, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß mit zerlassener Butter und geriebenem Käse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
