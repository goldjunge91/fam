      "steps": [
        {
          "position": 0,
          "text": "Speckstücke knusprig braten, dann herausnehmen. 1 Esslöffel Speckfett in der Pfanne zurücklassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln im Speckfett etwa 5 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brotwürfel in einer großen Schüssel mit Speck, gekochten Zwiebeln, Eiern, Milch, Petersilie, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lassen Sie die Mischung 15 Minuten ruhen, bis das Brot Flüssigkeit aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aus der Mischung 8 Knödel formen, etwa so groß wie Tennisbälle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rinderbrühe in einem großen Topf leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Knödel vorsichtig in die köchelnde Brühe geben und 15–20 Minuten kochen lassen, bis sie schwimmen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Knödel in Schüsseln mit heißer Brühe und knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
