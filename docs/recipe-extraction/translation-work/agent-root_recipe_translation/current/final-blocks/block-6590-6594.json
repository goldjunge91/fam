      "steps": [
        {
          "position": 0,
          "text": "Mehl, Milch, Eier, 1/2 Tasse geschmolzene Butter und Salz zu einem dünnen Teig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Ofen auf 375 °F vorheizen und eine 10 Zoll große gusseiserne Pfanne oder Backform mit zerlassener Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fleisch mit Zwiebeln und Knoblauch in einer separaten Pfanne bei mittlerer Hitze 5 Minuten anbraten, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Etwa 1/4 Tasse Teig in die heiße, gebutterte Pfanne geben und schwenken, bis der Boden dünn bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 Minuten kochen lassen, bis der Boden fest wird, dann eine dünne Schicht Fleischmischung darüber verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine weitere dünne Schicht Teig über das Fleisch gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederholen Sie die Schichtung von Teig und Fleisch 4-5 Mal, schließen Sie mit dem Teig ab und beträufeln Sie jede Schicht mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Pfanne in den Ofen stellen und 25–30 Minuten backen, bis sie goldbraun und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "5 Minuten abkühlen lassen, mit Joghurt belegen und in Spalten schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
