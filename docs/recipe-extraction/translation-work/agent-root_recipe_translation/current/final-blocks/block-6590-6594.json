      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen. Das Rindfleisch portionsweise jeweils etwa 3 Minuten anbraten, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln, Knoblauch, Karotten und Sellerie in den Topf geben und 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Rindfleisch wieder in den Topf und fügen Sie Rinderbrühe, Lorbeerblätter, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren, abdecken und 45 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln hinzufügen und zugedeckt weitere 25–30 Minuten köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lorbeerblätter entfernen, würzen und mit frischer Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schüsseln mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
