      "steps": [
        {
          "position": 0,
          "text": "Leber in quarter-inch-Stücke schneiden und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln dünn schneiden und in 3 Esslöffeln Butter bei mittlerer Hitze 15 Minuten braten. Häufig umrühren, bis sie goldbraun und karamellisiert sind, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Leberstücke in Mehl wenden und überschüssiges Mehl abschütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl und 2 Esslöffel Butter in einer großen Pfanne bei mittelhoher Hitze erhitzen. Leber 2 Minuten pro Seite braten, bis sie gebräunt, innen aber noch leicht rosa ist. Dann auf Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Essig und Brühe in dieselbe Pfanne gießen, gebräunte Reste vom Boden lösen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Karamellisierte Zwiebeln zurück in die Sauce geben und durchwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zwiebeln und Sauce über die Leber löffeln und mit frischer Petersilie bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
