      "steps": [
        {
          "position": 0,
          "text": "Hähnchenoberkeulen mit Salz und Pfeffer würzen, dann mit der Hautseite nach unten bei mittelhoher Hitze 6 Minuten in Butter bräunen. Wenden und weitere 4 Minuten bräunen, dann herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geschnittene Pilze und Perlzwiebeln im selben Topf 4 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl über das Gemüse streuen und 1 Minute rühren, sodass es überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Cidre und Brühe in den Topf gießen, gebräunte Stücke vom Boden lösen, dann Hähnchen zurückgeben und Thymianzweige hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und 25 Minuten köcheln lassen, bis das Hähnchen durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Äpfel schälen, entkernen und in Spalten schneiden. Zusammen mit Sahne in den Topf geben und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Thymianzweige entfernen und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hähnchen mit Sauce und Gemüse über Reis oder Kartoffeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
