      "steps": [
        {
          "position": 0,
          "text": "Hefe in warmem Wasser auflösen und 5 Minuten stehen lassen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermengen und in der Mitte eine Mulde formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hefemischung in die Mulde gießen und verrühren, bis ein dicker, klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit einem feuchten Tuch abdecken und 30 Minuten gehen lassen, bis der Teig leicht aufgegangen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einem tiefen Topf auf 350°F erhitzen und die Temperatur mit einem Thermometer überwachen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit zwei nassen Löffeln golfballgroße Teigportionen ins heiße Öl geben und etwa 1–2 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittierte Loukoumades auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Honig mit Zimt in einem kleinen Topf erwärmen, über warme Loukoumades träufeln und mit gehackten Nüssen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
