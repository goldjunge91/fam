      "steps": [
        {
          "position": 0,
          "text": "Zubereitung: Entferne prime rib from refrigerator 1 hour before kochening to bring to room temperature.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zubereitung: PreHitze oven to 450°F mit rack in niedriger third.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zubereitung: Pat meat dry and rub mit salt, pepper, garlic, and olive oil; place rosemary sprigs on top.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zubereitung: Sear in oven for 15 Minuten at 450°F bis browned.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zubereitung: Reduce Hitze to 325°F, hinzufügen broth to pan, and continue roasting 1-1.5 hours bis internal temperature reaches 130°F for mittel-rare.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zubereitung: Tent loosely mit foil if browning too quickly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rest meat 15 Minuten before slicing; internal temperature will rise 5 Grad while resting.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
