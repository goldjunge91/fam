      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen schweren Topf bei mittlerer bis hoher Hitze erhitzen. Schweinehackfleisch etwa 8 Minuten krümelig anbraten und herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf Zwiebel, Karotte und Sellerie fein gehackt als Soffritto 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch und Tomatenmark dazugeben und unter ständigem Rühren 2 Minuten anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Rotwein ablöschen, Bratrückstände lösen und 3 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das angebratene Fleisch zurück in den Topf geben, stückige Tomaten hinzufügen und alles leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei niedriger Hitze ohne Deckel 2-2.5 Stunden köcheln lassen und gelegentlich umrühren, bis die Sauce kräftig und dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Pappardelle nach Packungsanleitung kochen, abgießen und auf Servierschalen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Großzügig Wildschweinsauce darübergeben und mit geriebenem Parmesan bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
