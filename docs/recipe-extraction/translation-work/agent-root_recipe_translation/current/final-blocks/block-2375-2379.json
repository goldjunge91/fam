      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilis und röste sie 1 Minute in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die eingeweichten Chilis mit Knoblauch, Zwiebel, Kreuzkümmel, Oregano, Zimt und Essig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Chilimischung durch ein feines Sieb in einen Topf und gib Rinderbrühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Rindfleisch in große Stücke, gib es in die Brühe und bringe sie zum Kochen. Reduziere die Hitze, decke den Topf ab und lass alles 2.5 Stunden köcheln, bis das Fleisch leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerfasere das Fleisch mit zwei Gabeln, gib es zurück in den Topf und lass es weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Tortillas und tauche sie in die heiße Brühe. Fülle sie mit zerkleinertem Fleisch und gewürfelter Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
