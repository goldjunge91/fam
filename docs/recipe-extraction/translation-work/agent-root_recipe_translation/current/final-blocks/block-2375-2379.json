      "steps": [
        {
          "position": 0,
          "text": "Weiche Bambusspieße mindestens 30 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Hähnchenbrust in etwa 1/2 inch dicke und 4 inches lange Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke die Hähnchenstreifen auf Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die Spieße mit Öl und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille oder grille im Ofen die Spieße 6-8 Minuten. Wende sie nach der Hälfte der Zeit, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für die Erdnusssauce püriere Erdnussbutter, Kokosmilch, Sojasauce, Limettensaft, gehackten Knoblauch, braunen Zucker und Cayennepfeffer glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze die Sauce vorsichtig in einem kleinen Topf, aber lass sie nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Spieße heiß mit warmer Erdnusssauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
