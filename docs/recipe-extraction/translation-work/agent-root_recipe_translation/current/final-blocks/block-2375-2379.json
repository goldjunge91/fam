      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Knoblauch und Chilis in einem Mörser mit Stößel, bis sie leicht aufgebrochen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib grüne Bohnen und Tomaten dazu und zerdrücke sie leicht, damit Saft austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geraspelte grüne Papaya dazu und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Limettensaft und Fischsauce über den Salat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib braunen Zucker dazu und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte den Salat auf einem Teller an und bestreue ihn mit zerstoßenen Erdnüssen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib nach Wunsch getrocknete Garnelen dazu und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
