      "steps": [
        {
          "position": 0,
          "text": "Klopfe die Hähnchenbrüste zwischen Frischhaltefolie auf 1/4 Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schalen bereit: mit Mehl, verquirltem Ei und Panko, vermischt mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Hähnchenstück zuerst im Mehl und schüttle Überschuss ab, tauche es dann ins Ei und wende es anschließend in Panko.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F (oder bis ein Stück Brot in 30 Sekunden bräunt).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Hähnchenstücke je Seite 3-4 Minuten goldbraun, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege sie zum Abtropfen des überschüssigen Öls auf Küchenpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
