      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, 6 Esslöffel gewürfelte kalte Butter und Salz, bis eine krümelige Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 Eigelb und 3 Esslöffel Wasser hinzu und vermische alles, bis sich ein Teig bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kühle den Teig 20 Minuten und drücke ihn dann in Muffinformen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor und backe die Teigschalen 8 Minuten, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle 3 Eier, gezuckerte Kondensmilch, ungesüßte Kondensmilch, Zucker und Vanilleextrakt glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Cremefüllung bis zu drei Vierteln in die vorgebackenen Törtchenschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 350°F 15-18 Minuten, bis die Creme fest, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vollständig abkühlen, bevor du sie aus der Form nimmst und servierst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
