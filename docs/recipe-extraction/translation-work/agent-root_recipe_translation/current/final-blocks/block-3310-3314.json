      "steps": [
        {
          "position": 0,
          "text": "Gieße kochendes Wasser unter Rühren mit einem Löffel zum Mehl, bis ein grober Teig entsteht; knete ihn glatt und lasse ihn abgedeckt 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse Gelatine 5 Minuten in kalter Hühnerbrühe quellen und erhitze sie dann, bis sie sich auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die abgekühlte Gelatinemischung mit Schweinehackfleisch, Sojasauce, Sesamöl, Ingwer, Frühlingszwiebeln und Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 12 gleich große Stücke und rolle jedes auf einer bemehlten Fläche zu einem 3 Zoll großen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib etwa 1 Esslöffel Füllung in die Mitte jedes Teigblatts, ziehe die Ränder zu einem Säckchen hoch und drehe die Spitze zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Teigtaschen mit der gefalteten Seite nach oben in einen mit Backpapier ausgelegten Bambusdämpfer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Dämpfe sie über kochendem Wasser 8-10 Minuten, bis der Teig durchscheinend und die Füllung gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit schwarzem Essig und Chiliöl zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
