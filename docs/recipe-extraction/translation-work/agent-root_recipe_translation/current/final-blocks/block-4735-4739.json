          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere die Würstchen und schneide Paprika und Zwiebel in 1-Zoll breite Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge Würstchen, Paprika und Zwiebel mit Olivenöl, gehacktem Knoblauch, Basilikum, Oregano, Salz und Pfeffer.",
