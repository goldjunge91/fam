      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch in 1-Zoll Würfel und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasauce, Fischsauce, Limettensaft, gehackten Knoblauch und Zucker in einer kleinen Schüssel zur Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 Esslöffel Öl in einer großen Pfanne oder einem Wok bei hoher Hitze, bis es sehr heiß ist und leicht raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Rindfleischwürfel portionsweise insgesamt etwa 4-5 Minuten rundum an, sodass sie außen gebräunt, innen aber noch rare sind. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das restliche Öl in dieselbe Pfanne und brate geschnittene Schalotten und rote Zwiebel etwa 2 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in die Pfanne, gieße die Sauce darüber und schwenke die Pfanne 1-2 Minuten kräftig, damit alles überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit schwarzem Pfeffer und serviere sofort auf Salatblättern oder mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
