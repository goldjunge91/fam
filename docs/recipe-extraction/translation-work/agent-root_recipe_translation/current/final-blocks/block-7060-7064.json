      "steps": [
        {
          "position": 0,
          "text": "Steckrüben und Kartoffeln schälen und in 1 Zoll große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Steckrüben in einen Topf mit kaltem Salzwasser geben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nach 10 Minuten Kartoffelwürfel in denselben Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gemeinsam 15–20 Minuten kochen, bis beide Gemüsesorten sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einem Sieb gut abtropfen lassen, dabei etwas Kochwasser auffangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zurück in den Topf geben und mit Butter zerstampfen. Je nach Bedarf Kochwasser hinzufügen, um die gewünschte Konsistenz zu erreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Großzügig mit Salz, Pfeffer und Muskatnuss würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In eine Servierschüssel geben und mit einem Stück Butter belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
