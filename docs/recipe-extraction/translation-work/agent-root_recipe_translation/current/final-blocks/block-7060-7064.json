          "images": []
        },
        {
          "position": 1,
          "text": "Zucker, Kondensmilch und Butter in einem Topf mit dickem Boden bei mittlerer Hitze vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Unter ständigem Rühren erhitzen, bis die Mischung auf dem Zuckerthermometer 236 °F erreicht (Weichballenstadium), etwa 15–20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vom Herd nehmen und Salz und Vanilleextrakt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit einem Holzlöffel 2-3 Minuten lang kräftig schlagen, bis die Mischung eindickt und ihr glänzendes Aussehen verliert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In die vorbereitete Pfanne gießen und 20 Minuten bei Raumtemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Noch leicht warm in 16 Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In einem luftdichten Behälter zwischen Pergamentschichten aufbewahren.",
