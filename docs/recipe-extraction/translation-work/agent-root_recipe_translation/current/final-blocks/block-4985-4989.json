          "images": []
        },
        {
          "position": 2,
          "text": "Püriere in einer anderen Schüssel Eigelb, weichen Frischkäse, Vanille und Zucker glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe die Eiweißmasse vorsichtig in zwei Portionen unter die Eigelbmasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Setze sechs Häufchen auf das vorbereitete Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie 15-18 Minuten, bis sie leicht goldbraun und gestockt, aber noch weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
