      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und fette eine Kastenform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage weiche Butter und Zucker etwa 3 Minuten cremig und luftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Eier einzeln dazu und schlage die Masse nach jeder Zugabe gut auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge Mehl, Backpulver und Salz in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die Mehlmischung abwechselnd mit saurer Sahne unter die Buttermischung. Beginne und ende mit Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe Zitronensaft und Zitronenschale unter, bis alles gerade vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße den Teig in die Form und backe ihn 50-55 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Kuchen 15 Minuten in der Form abkühlen und stürze ihn dann auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Verrühre Puderzucker mit 2-3 tablespoons Zitronensaft zu einer Glasur und träufle sie über den abgekühlten Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
