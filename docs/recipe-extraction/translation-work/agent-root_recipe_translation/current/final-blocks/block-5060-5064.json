      "steps": [
        {
          "position": 0,
          "text": "Koche das Risotto, indem du die warme Dashi-Brühe nach und nach zum Reis gibst und häufig rührst. Das dauert etwa 18 Minuten, bis der Reis cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Takoyaki-Sauce unter das gekochte Risotto und lasse es auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Mozzarella in 12 kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme das Risotto zu 12 Kugeln und drücke je einen Oktopus- und Käsewürfel in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle drei Schüsseln bereit: eine mit Mehl, eine mit verquirlten Eiern und eine mit Panko-Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende jede Kugel zuerst in Mehl, dann im Ei und zuletzt in Panko.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere die Kugeln 2-3 Minuten pro Seite, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und bestreue sie noch heiß mit Bonitoflocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
