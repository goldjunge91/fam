      ],
      "steps": [
        {
          "position": 0,
          "text": "Spüle 1 cup Reis, bis das Wasser größtenteils klar abläuft, und gib ihn dann in den Topf des Reiskochers. Fülle Wasser bis zur Markierung '1 cup' ein und schöpfe dann etwa 1 EL Wasser ab, damit Platz für den Tomatensaft bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Sojasauce, Salz, Pfeffer und nach Wunsch geriebenen Knoblauch in das Wasser ein, bis alles gleichmäßig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entferne den Strunk der ganzen Tomate und setze sie mit der Strunkseite nach oben in die Mitte des Reises. Lege die Butter auf die Tomate, damit sie in die Reiskörner schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schließe den Deckel und starte einen normalen Zyklus für weißen Reis beziehungsweise den Kochzyklus. Öffne den Deckel während des Garens nicht, denn der Dampf gart die Tomate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn der Zyklus endet, lass den Reis 10 Minuten auf Warmhalten stehen. Öffne dann den Deckel und zerdrücke die weiche Tomate mit einem Löffel oder Reislöffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe Tomate, geschmolzene Butter und Sojasauce unter den Reis, bis jedes Korn glänzt und hellrot gefärbt ist. Probiere und gib bei Bedarf noch etwas Sojasauce dazu. Mit Frühlingszwiebel bestreuen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
