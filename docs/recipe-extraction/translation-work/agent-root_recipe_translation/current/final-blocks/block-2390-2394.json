      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in mundgerechte Stücke und die Zwiebel in dünne Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Dashi-Brühe, Sojasoße, Mirin und Zucker in einer Pfanne und bringe die Mischung zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hähnchen und Zwiebelscheiben in die köchelnde Brühe und gare sie 5 Minuten, bis das Hähnchen fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage 3 Eier in einer Schüssel auf und gieße sie langsam unter sanftem Rühren in die Pfanne, sodass Fäden entstehen und etwas Ei noch nicht ganz stockt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage das restliche Ei auf und gieße es ohne Rühren darüber, damit es eine Schicht bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne nach etwa 1-2 Minuten vom Herd, wenn die Eier gerade gestockt, aber noch leicht flüssig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile den Reis auf zwei Schüsseln und gib die Hähnchen-Ei-Mischung vorsichtig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und sofort servieren.",
          "timerMinutes": null,
