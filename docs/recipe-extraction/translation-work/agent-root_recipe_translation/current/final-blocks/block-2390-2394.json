      "steps": [
        {
          "position": 0,
          "text": "Schneide die Karotte in feine Stifte und die Zwiebel in dicke Spalten. Hacke den Chinakohl und schneide die Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Tofu in 1-inch große Würfel und halbiere die Pilze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasoße, Mirin, Zucker und Dashi-Brühe in einer Schüssel zur Sukiyaki-Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine große flache Pfanne oder einen Sukiyaki-Topf bei mittlerer bis hoher Hitze. Brate die Rindfleischscheiben kurz an, bis sie leicht gegart sind. Nimm sie heraus und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile das vorbereitete Gemüse und den Tofu in einzelnen Bereichen der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Sukiyaki-Brühe über alle Zutaten und lasse alles 8-10 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Rindfleischscheiben zurück in die Pfanne und lasse sie weitere 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schlage Eier in kleine Schüsseln und serviere sie als Dip für Fleisch und Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
