      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mehl, Eier und Wasser in einer Schüssel zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe den fein geschnittenen Kohl unter, bis er gleichmäßig mit Teig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne oder auf einer Grillplatte bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Hälfte des Teigs in die Pfanne und forme daraus einen dicken Pfannkuchen von etwa 8 inches Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege 2 Scheiben Schweinebauch auf den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Pfannkuchen 5-6 Minuten, bis die Unterseite goldbraun ist. Wende ihn vorsichtig und backe die andere Seite weitere 4-5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege ihn auf einen Teller und beträufle ihn kreuzweise mit Okonomiyaki-Soße und Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue Bonitoflocken und Aonori-Pulver darüber und serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Wiederhole den Vorgang mit dem restlichen Teig und Schweinebauch für den zweiten Okonomiyaki.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
