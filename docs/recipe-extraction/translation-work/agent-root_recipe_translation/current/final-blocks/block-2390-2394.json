      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenschenkel in 1.5-inch große Würfel und die Hähnchenleber in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Frühlingszwiebeln in 1.5-inch lange Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasoße, Mirin, Zucker, Sake, gehackten Knoblauch und Ingwer in einem kleinen Topf. Lasse die Mischung 3 Minuten köcheln, um eine Yakitori-Glasur herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke Hähnchenstücke und Frühlingszwiebeln abwechselnd auf zuvor in Wasser eingeweichte Holzspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine Grillpfanne oder den Außengrill auf mittlere bis hohe Hitze und gare die Spieße 8-10 Minuten. Dabei gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Spieße während der letzten 2 Minuten großzügig mit Yakitori-Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte die Spieße auf einem Teller an und träufle vor dem Servieren die restliche Glasur darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
