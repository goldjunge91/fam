      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Schweineschnitzel trocken und klopfe sie mit einem Fleischklopfer dünn und gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, eine mit verquirltem Ei und eine mit Panko-Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Schnitzel zuerst in Mehl, tauche es dann in Ei und drücke es anschließend in die Panko-Brösel, bis es vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere die Schnitzel 3-4 Minuten pro Seite goldbraun. Lasse sie auf Küchenpapier abtropfen und schneide sie in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Zwiebel und lasse sie in einer Soße aus Dashi, Sojasoße, Mirin und Zucker 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den Reis auf zwei Schüsseln und richte die Schweineschnitzelstreifen darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Zwiebelsauce über die Schnitzel und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
