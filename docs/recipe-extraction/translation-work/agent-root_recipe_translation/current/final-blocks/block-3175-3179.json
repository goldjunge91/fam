      "steps": [
        {
          "position": 0,
          "text": "Presse den Tofu zwischen Küchenpapier und schneide ihn in 3/4-inch große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf bei mittlerer Hitze und brate Currypaste und gehackten Knoblauch 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße eine Dose Kokosmilch langsam unter Rühren in den Topf, sodass eine glatte Paste entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Brokkoli, Paprika und Tofuwürfel dazu und rühre um, bis alles mit Currysauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles 8 Minuten köcheln, bis der Brokkoli bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die übrige Kokosmilch, Bambussprossen, Fischsauce und braunen Zucker dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 5 Minuten köcheln. Probiere das Curry und passe den Limettensaft nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre kurz vor dem Servieren frisches Basilikum ein und serviere das Curry zu Jasminreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
