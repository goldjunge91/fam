      "steps": [
        {
          "position": 0,
          "text": "Vermische Paprika, Knoblauchpulver, Zwiebelpulver, braunen Zucker, Kreuzkümmel und Salz zu einer Trockenwürzung. Reibe die Rinderbrust damit ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Rinderbrust in einem Schmortopf an. Gib BBQ-Sauce und 1/2 Tasse Wasser dazu. Decke den Topf ab und schmore alles bei 300°F 90 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass das Fleisch ruhen und schneide oder zerteile es anschließend. Für schnelle eingelegte Zwiebeln: Schneide sie dünn und vermische sie mit Essig, Honig und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte Reis und BBQ-Rinderbrust in einer Schale an und gib eingelegte Zwiebeln und Krautsalat darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
