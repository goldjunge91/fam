      "steps": [
        {
          "position": 0,
          "text": "Schweinehackfleisch, Garnelen, 1 Esslöffel Sojasauce, 1 Teelöffel Sesamöl, Frühlingszwiebeln und Ingwer zu einer Füllung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Je 1 Teelöffel Füllung in die Mitte eines Wonton-Teigblatts geben, Ränder mit Wasser befeuchten, zum Dreieck falten und dann die Ecken zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eiernudeln hinzufügen und nach Packungsanweisung kochen, bis sie gerade weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wontons separat in kochendem Wasser garen, bis sie aufsteigen; weitere 2-3 Minuten kochen, bis sie höher aufschwimmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Wontons in den Topf mit Brühe und Nudeln geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pak Choi in den Topf geben und 2 Minuten köcheln lassen, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit den restlichen 1 Esslöffel Sojasauce und 0.5 Teelöffel Sesamöl würzen, mit Koriander garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
