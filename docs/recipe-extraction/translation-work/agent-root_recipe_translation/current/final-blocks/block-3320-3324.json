      "steps": [
        {
          "position": 0,
          "text": "Basmatireis 30 Minuten in Wasser einweichen und dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem schweren Topf erhitzen und geschnittene Zwiebeln goldbraun braten; die Hälfte zum Garnieren beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen mit Joghurt, Ingwer-Knoblauch-Paste, Salz und der Hälfte der gebratenen Zwiebeln vermengen und 15 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser in einem großen Topf mit ganzen Gewürzen (Kardamom, Zimt, Lorbeerblätter) und Salz zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgetropften Reis ins kochende Wasser geben und garen, bis er zu 70% gekocht ist, dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mariniertes Hähnchen in den schweren Topf schichten und den teilweise gegarten Reis darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Topf mit Folie und Deckel abdecken und bei starker Hitze 2 Minuten garen, bis sich Dampf bildet; dann die Hitze reduzieren und 45 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hitze ausschalten und 5 Minuten ruhen lassen, ohne den Deckel zu öffnen; dann vorsichtig mit einer Gabel auflockern und mit den zurückbehaltenen gebratenen Zwiebeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
