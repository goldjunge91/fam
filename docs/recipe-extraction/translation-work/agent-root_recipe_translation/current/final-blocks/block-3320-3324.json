      "steps": [
        {
          "position": 0,
          "text": "Tintenfisch gründlich mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Maisstärke, Salz und weißen Pfeffer in einer flachen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tintenfischstücke in der Mehlmischung wenden, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl im Wok oder in einer tiefen Pfanne auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tintenfisch portionsweise 2-3 Minuten goldbraun und knusprig frittieren; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tintenfisch herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den größten Teil des Öls abgießen und 2 Esslöffels im Wok lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Knoblauch, Frühlingszwiebeln und Chilis 30 Sekunden pfannenrühren, dann mit dem frittierten Tintenfisch vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort mit Zitronenspalten und zusätzlichem Salz zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
