      "steps": [
        {
          "position": 0,
          "text": "Hummer samt Schale in Stücke schneiden und den Sandsack am Kopf entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fermentierte schwarze Bohnen abspülen und mit einer Gabel leicht zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl im Wok bei starker Hitze erhitzen und Hummerstücke 3-4 Minuten pfannenrühren, bis die Schale rötlich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hummer an den Rand schieben, Knoblauch, Ingwer und schwarze Bohnen hinzufügen und 30 Sekunden anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sojasauce, Austernsauce und Brühe angießen und den Hummer darin wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 8-10 Minuten garen, bis der Hummer durch und zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Maisstärkemischung einrühren und unter ständigem Rühren in den Wok gießen, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Frühlingszwiebeln garnieren und sofort auf gedämpftem Reis servieren.",
