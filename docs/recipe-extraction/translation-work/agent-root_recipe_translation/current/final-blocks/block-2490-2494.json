      "steps": [
        {
          "position": 0,
          "text": "Gib Schweinebauch in einen großen Topf und bedecke ihn mit 6 cups kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe das Wasser zum Kochen, gieße es ab und spüle das Schweinefleisch mit kaltem Wasser ab, um Schaum und Rückstände zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das gereinigte Fleisch mit frischem Wasser, Zwiebel, Knoblauch, einer Ingwerscheibe, Sojasauce, Reiswein und Salz zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze, decke den Topf ab und lass das Fleisch 60-90 Minuten köcheln, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stich mit einem Messer hinein. Wenn es vollständig gar ist, sollte das Messer leicht hineingleiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Fleisch aus der Brühe, lass es leicht abkühlen und schneide es dann in dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege Butterkopfsalat- oder Kohlblätter auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege geschnittenes Schweinefleisch und frische Knoblauchscheiben auf die Blätter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Fleisch mit Ssamjang-Sauce zum Einwickeln in Salatblätter und frisch Essen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
