      "steps": [
        {
          "position": 0,
          "text": "Schneide Zucchini und Zwiebel dünn und gib sie in ein Sieb. Bestreue sie mit Salz, damit sie 5 Minuten Wasser ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke das geschnittene Gemüse vorsichtig aus, um überschüssige Flüssigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, Mehl, Wasser, Salz und schwarzen Pfeffer in einer Schüssel zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das ausgedrückte Gemüse und gehackte Frühlingszwiebel zum Teig und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib löffelweise Teig ins heiße Öl und drücke ihn mit einem Pfannenwender vorsichtig zu dünnen Pfannkuchen flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate sie 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische Sojasauce, Reisessig und Sesamsamen in einer kleinen Schüssel zu einer Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die Pfannkuchen heiß mit Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
