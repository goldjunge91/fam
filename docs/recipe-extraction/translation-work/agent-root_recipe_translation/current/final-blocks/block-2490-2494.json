      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Wasser zum Kochen. Blanchiere Oktopusstücke 20-25 Minuten, bis sie zart sind, und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Gochujang, Sesamöl, Sojasauce, Zucker und gehackten Knoblauch in einer kleinen Schüssel zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 EL Sesamöl in einer großen Pfanne oder einem Wok bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geschnittene Zwiebel dazu und brate sie 2-3 Minuten unter Rühren weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib blanchierten Oktopus und Gochujang-Sauce dazu und wende alles gut, bis es überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1/4 cup Wasser dazu und brate alles unter Rühren 5-7 Minuten, während die Sauce eindickt und den Oktopus überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gehackte Frühlingszwiebel und schwarzen Pfeffer dazu und wende alles 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Richte das Gericht auf einer Servierplatte an und garniere großzügig mit Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
