      "steps": [
        {
          "position": 0,
          "text": "Bringe 4 cups Rinderbrühe oder Wasser in einem Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und geschnittene Reiskuchen dazu. Rühre vorsichtig um, damit nichts klebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass alles 5-7 Minuten köcheln, bis die Reiskuchen weich und leicht durchscheinend sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sojasauce und nach Wunsch gegartes Rindfleisch oder Schinken dazu und verrühre alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eier in einer kleinen Schüssel leicht mit einer Gabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die verquirlten Eier langsam unter vorsichtigem Rühren in die köchelnde Brühe, sodass dünne Eierfäden entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib geschnittene Frühlingszwiebel und Sesamöl dazu und gare alles 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer, fülle die Suppe in Schalen und garniere sie mit Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
