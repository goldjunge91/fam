      "steps": [
        {
          "position": 0,
          "text": "Schneide Zwiebel und Schalotten in dünne Scheiben. Lege sie in ein Eiswasserbad, während du die übrigen Zutaten vorbereitest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Kokosnuss und gib sie in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Reis zur Kokosnuss. Vermische beides mit den Händen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Mischung 2-inch große Reisbällchen-Kroketten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Speiseöl in einem Topf oder einer Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage zwei Eier in einer großen Schüssel auf. Tauche die Bällchen in die Eiermischung und gib sie anschließend in das heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Bällchen, bis sie dunkel bernsteinbraun sind. Sie sollen knusprig und goldbraun werden. Nimm sie heraus und lasse überschüssiges Öl auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenn die Reisbällchen abgekühlt sind, brich sie auseinander und gib sie in eine größere Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gieße Zwiebel und Schalotten ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Zerreiße die Schweinebratwurst in kleine Stücke. Du kannst auch ein Messer verwenden, traditionell wird sie jedoch zerrupft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib Zwiebel, Schalotten, saure Schweinewurst, eingelegten Knoblauch, Limettensaft, Fischsoße, Zucker, Koriander, scharfe Minze und normale Minze in die große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Mit Erdnüssen bestreuen. Mit Salat, getrocknetem Chili und anderem frischem Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Naem-Khao-Rezept aufbewahren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Naem Khao hält sich 4 days im Kühlschrank und kann anschließend gekühlt serviert werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
