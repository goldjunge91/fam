      "steps": [
        {
          "position": 0,
          "text": "Spüle die Quinoa ab und koche sie nach Packungsanleitung etwa 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die Süßkartoffel, würfle sie und vermenge sie mit 1 Esslöffel Olivenöl, Salz und Pfeffer. Röste die Würfel bei 400°F etwa 15 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Kichererbsen ab, spüle sie und vermenge sie mit 1 Esslöffel Olivenöl. Röste sie zusammen mit der Süßkartoffel bei 400°F 12 Minuten, bis sie knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Massiere den Grünkohl mit 1 Esslöffel Olivenöl und einer Prise Salz, bis er weicher wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Gurke klein und halbiere die Kirschtomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Zitronensaft, gehackten Knoblauch und das restliche Olivenöl mit Salz und Pfeffer zu einem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die gekochte Quinoa auf Schüsseln und richte Süßkartoffel, Kichererbsen, Grünkohl, Gurke und Tomaten darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Träufle das Dressing darüber und serviere die Bowls sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
