      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und gewürfelte Zwiebel sowie gehackten Knoblauch etwa 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffelwürfel in den Topf geben und 3 Minuten unter gelegentlichem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gemüse- oder Hühnerbrühe zugießen und aufkochen. Hitze reduzieren und 15 Minuten köcheln lassen, bis die Kartoffeln langsam weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kurkumapulver und gemahlenen Kreuzkümmel einrühren und abgetropften Hominy-Mais hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 10 Minuten köcheln lassen, bis die Kartoffeln vollständig weich sind und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken, heiß servieren und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
