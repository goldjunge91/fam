      "steps": [
        {
          "position": 0,
          "text": "Rote Kartoffeln schälen und in 0.5 Zoll große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasser in einem großen Topf zum Kochen bringen, Kartoffelwürfel hinzufügen und etwa 15 Minuten sehr weich kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln direkt im Topf glatt und cremig zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Maisstärke mit 0.5 Tasse kaltem Wasser glatt rühren und langsam in die Kartoffelmischung einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Milch, Zimtstange, Nelken, Zucker, Salz und Butter hinzufügen und bei mittlerer Hitze 5 Minuten unter ständigem Rühren kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 5 Minuten köcheln lassen, bis die Mischung dick und cremig ist. Häufig umrühren, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zimtstange entfernen und heiß in Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
