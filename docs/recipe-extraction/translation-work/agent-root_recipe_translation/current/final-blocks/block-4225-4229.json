      "steps": [
        {
          "position": 0,
          "text": "Rinderknochen in einen großen Topf geben, mit Wasser bedecken, sprudelnd aufkochen und abgießen. Knochen unter kaltem Wasser gut abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gereinigte Knochen mit frischem Wasser zurück in den Topf geben. Halbierte Zwiebel, ungeschälten Knoblauch, Karotten, Sellerie, Lorbeerblätter und Thymianzweige hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aufkochen, dann Hitze reduzieren und ohne Deckel 2 Stunden köcheln lassen. Dabei aufsteigende Trübstoffe abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe durch ein feinmaschiges Sieb in einen sauberen Topf abseihen und die festen Bestandteile entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgeseihte Brühe zurück auf den Herd stellen und weitere 30 Minuten köcheln lassen, um den Geschmack zu konzentrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken und heiß als klare Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
