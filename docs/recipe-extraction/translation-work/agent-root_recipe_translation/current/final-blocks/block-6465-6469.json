      "steps": [
        {
          "position": 0,
          "text": "Warme Milch, Hefe und 1 Teelöffel Zucker verrühren und 10 Minuten schaumig rühren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, restlichen Zucker und Salz in einer großen Schüssel vermischen, dann eine Mulde formen und die Hefemischung, 3 Eier und weiche Butter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "10 Minuten lang kneten, bis ein glatter, elastischer Teig entsteht, dann abdecken und 45 Minuten gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig halbieren und eine Hälfte in eine gefettete Backform von 9 × 13 Zoll drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 Eier mit Puddingpulver verquirlen und gleichmäßig über die Teigschicht gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drücken Sie den restlichen Teig in ein flaches Blech, legen Sie es über die Vanillesoße und verschließen Sie die Ränder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 30 Minuten gehen lassen, dann 1 Ei verquirlen und die Oberfläche bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 350 °F 35–40 Minuten goldbraun backen. Vollständig abkühlen lassen, mit Puderzucker bestäuben und in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
