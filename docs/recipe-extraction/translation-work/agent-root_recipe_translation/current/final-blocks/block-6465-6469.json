      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Rührschüssel vermischen und in der Mitte eine Mulde formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eier und Milch verquirlen und unter Rühren in die Mulde gießen, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 Esslöffel Butter im Teig schmelzen und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine beschichtete Crêpe-Pfanne oder Bratpfanne bei mittlerer bis hoher Hitze erhitzen und leicht mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "0.25 Tasse Teig in die Pfanne gießen und durch Schwenken gleichmäßig verteilen. Die Crêpe auf der ersten Seite etwa 1 Minute hellgolden backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Crêpe wenden, die gegarte Seite dünn mit Senf bestreichen und auf eine Hälfte eine Scheibe Schinken sowie 0.25 Tasse Käse legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Crêpe in zwei Hälften falten und weitere 30 Sekunden kochen lassen, bis der Käse zu schmelzen beginnt. Dann auf einen Teller gleiten lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
