      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Butter und Zucker schaumig rühren, bis die Masse leicht und locker ist (ca. 3 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eigelb und Vanilleextrakt unterrühren, bis alles vollständig eingearbeitet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl und Salz untermischen, bis ein Teig entsteht, ohne zu viel zu verarbeiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig zwischen zwei Lagen Backpapier 0.25 Zoll dick ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem Cutter oder Messer in Kreise oder Rechtecke schneiden und dann auf das vorbereitete Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Leicht mit verquirltem Ei bestreichen und 12-15 Minuten backen, bis die Ränder goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf dem Backblech 5 Minuten abkühlen lassen, bevor es auf ein Kuchengitter gelegt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
