      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie die Muscheln, indem Sie sie unter kaltem Wasser schrubben und alle Bärte mit einem Messer entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schalotten und Knoblauch fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einem großen Topf bei mittlerer Hitze erhitzen und Schalotten und Knoblauch 2 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Weißwein hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie die gereinigten Muscheln hinzu und decken Sie den Topf mit einem dicht schließenden Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Muscheln 7–10 Minuten dämpfen. Dabei den Topf gelegentlich schütteln, bis sich alle geöffnet haben. Geschlossene Muscheln entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Großteil der frischen Petersilie unterrühren, mit Salz und Pfeffer würzen und sofort in Schüsseln mit der Brühe und dem knusprigen Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
