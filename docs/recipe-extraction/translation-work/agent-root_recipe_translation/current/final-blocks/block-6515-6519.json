      "steps": [
        {
          "position": 0,
          "text": "Würze die Rindersteaks von beiden Seiten großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Butter in einer großen Pfanne bei starker Hitze und brate die Steaks pro Seite 4 Minuten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz die restliche Butter in derselben Pfanne und brate Zwiebel und Pilze etwa 8 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreue das Gemüse mit Mehl, rühre es unter und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Rinderbrühe dazu, löse die Bratrückstände vom Pfannenboden und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Steaks zurück in die Pfanne und lass sie 5 Minuten fertig garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Pfanne vom Herd, rühre saure Sahne glatt ein, würze mit Salz und Pfeffer und garniere mit Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht sofort mit Eiernudeln oder Kartoffelpüree.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
