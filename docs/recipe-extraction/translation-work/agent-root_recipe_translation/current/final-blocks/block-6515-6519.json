      "steps": [
        {
          "position": 0,
          "text": "Koche die Kutteln 30 Minuten in Salzwasser, um Geruch zu entfernen und sie weich zu machen. Gieße sie ab und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem großen Topf und brate die Zwiebel etwa 5 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge die Kuttelwürfel hinzu und bräune sie 5 Minuten leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Rinderbrühe dazu, gib Lorbeerblatt und Thymian hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lass die Kutteln 45 Minuten köcheln, bis sie zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre saure Sahne und Essig ein, würze mit Salz und Pfeffer und lass alles weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Entferne die Kräuter und serviere das Gericht heiß mit Polenta oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
