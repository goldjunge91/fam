      "steps": [
        {
          "position": 0,
          "text": "Klopfe die Hähnchenbrust gleichmäßig dünn, etwa 0.25 inch dick.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege je eine Scheibe Schinken und Käse auf jede Hähnchenbrust.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle die Hähnchenbrust fest auf und fixiere sie bei Bedarf mit Zahnstochern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, eine mit verquirlten Eiern und eine mit Semmelbröseln, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende jede Rolle erst in Mehl, dann in Ei und anschließend in Semmelbröseln. Drücke die Panade leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl und Butter in einer großen Pfanne bei mittlerer bis hoher Hitze, bis sie schimmern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate jedes Cordon Bleu pro Seite 8 Minuten goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass es auf Küchenpapier abtropfen und serviere es sofort mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
