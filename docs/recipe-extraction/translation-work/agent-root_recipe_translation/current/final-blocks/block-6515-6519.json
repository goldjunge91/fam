      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl und Salz in einer Schüssel und arbeite kalte Butter ein, bis die Mischung groben Streuseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre saure Sahne und Ei ein, bis sich der Teig verbindet. Wickle ihn in Folie und stelle ihn 20 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge Apfelscheiben mit Zucker und Zimt in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in zwei Portionen und rolle jede zwischen Backpapier etwa 0.125 inch dick aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege eine Teigplatte auf ein gefettetes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Apfelmischung gleichmäßig auf dem Teig und lass einen 1-inch-Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die zweite Teigplatte darüber, drücke die Ränder zusammen und bestreiche sie mit Wasser oder Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Kuchen bei 375°F 25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
