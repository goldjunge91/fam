          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und rühren Sie 20-25 Minuten lang weiter, bis die Masse dick und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pilze und Zwiebeln in 1 Esslöffel Butter in einer separaten Pfanne goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Käse, restliche Butter und Pilzmischung unter das Maismehl rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sauerrahm vorsichtig unterheben, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In eine Servierschüssel geben und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
