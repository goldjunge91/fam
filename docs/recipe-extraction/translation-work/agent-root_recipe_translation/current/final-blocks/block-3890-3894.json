      "steps": [
        {
          "position": 0,
          "text": "Mischen Sie warme Milch, Hefe und 1 Esslöffel Zucker; 5 Minuten ruhen lassen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer großen Schüssel Mehl, restlichen Zucker, Salz und geschmolzene Butter vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hefemischung und Eier zu den trockenen Zutaten geben und verrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "8 Minuten lang kneten, bis es glatt und elastisch ist, getrocknete Früchte unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in eine gefettete Schüssel geben, mit Frischhaltefolie abdecken und 45 Minuten gehen lassen, bis sich der Teig verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig in eine gefettete hohe zylindrische oder runde Form geben, abdecken und weitere 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 35-40 Minuten backen, bis es goldbraun ist und ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren leicht abkühlen lassen und mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
