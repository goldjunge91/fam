      "steps": [
        {
          "position": 0,
          "text": "Verquirle Kichererbsenmehl langsam mit Wasser, damit keine Klümpchen entstehen. Gib Salz hinzu und lasse die Mischung 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 3 Esslöffel Olivenöl in einem großen flachen Topf und gieße den Kichererbsenteig hinein. Rühre ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre bei mittlerer Hitze 15-20 Minuten weiter, bis die Masse eindickt und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den heißen Teig dünn auf ein geöltes Backblech und lasse ihn etwa 10 Minuten vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die abgekühlten Panelle in Rechtecke von etwa 3 Zoll mal 2 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne auf 350°F und frittiere die Panelle etwa 2 Minuten insgesamt, bis sie auf beiden Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen, lege die warmen Panelle in das Brot, beträufle sie mit Zitronensaft und garniere sie mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
