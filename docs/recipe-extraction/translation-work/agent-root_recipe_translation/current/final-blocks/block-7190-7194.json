          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "backen für 50-60 Minuten bis crust is golden und Füllung is gegart through.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
