      "steps": [
        {
          "position": 0,
          "text": "Das ganze Hähnchen mit 12 Tassen Wasser, gewürfelten Zwiebeln, Karotten und Sellerie in einen großen Topf geben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Schaum abschöpfen, dann die Hitze reduzieren und 60 Minuten köcheln lassen, bis das Hähnchen sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen und Gemüse herausnehmen; Brühe abseihen und zurück in den Topf geben, Feststoffe außer Karotten wegwerfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während die Brühe köchelt, verrühren Sie das Matzenmehl, die Eier, das Öl, das Salz und den Pfeffer, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lassen Sie die Matzenmischung 15 Minuten ruhen, bis sie eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringen Sie die Brühe wieder leicht zum Kochen und geben Sie esslöffelgroße Portionen der Matzenmischung in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Matzenbällchen 25–30 Minuten köcheln lassen, bis sie locker und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren Sie Matzenbällchen mit Brühe, zerkleinertem Hühnchen und gekochten Karotten, garniert mit frischem Dill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
