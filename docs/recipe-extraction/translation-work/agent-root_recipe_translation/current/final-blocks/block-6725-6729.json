      "steps": [
        {
          "position": 0,
          "text": "Mehl mit warmem Wasser mischen und kneten, bis ein glatter Teig entsteht, dann abdecken und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln in Öl anbraten, bis sie weich sind, dann Fleisch, gehackten Knoblauch und Ingwer hinzufügen und braten, bis sie braun sind; Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koriander einrühren und die Füllung 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teilen Sie den Teig in 20 Stücke und rollen Sie jedes Stück zu einem 3-Zoll-Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie 1 Esslöffel Füllung in die Mitte, falten und falten Sie dann die Ränder, um die Form eines Beutels zu erhalten, und drücken Sie den Deckel zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringen Sie 6 Tassen Wasser in einem Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Momos vorsichtig hinzufügen und vorsichtig umrühren; 8-10 Minuten kochen, bis sie schwimmen und 2 Minuten schwimmen bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln mit Brühe und wahlweise mit Sesamöl oder scharfer Soße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
