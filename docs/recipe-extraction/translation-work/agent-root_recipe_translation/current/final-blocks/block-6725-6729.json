      "steps": [
        {
          "position": 0,
          "text": "Garnelen fein hacken und mit gehacktem Schnittlauch, gehacktem Knoblauch, Sesamöl, Sojasauce und weißem Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geben Sie 1 Teelöffel Füllung in die Mitte jeder Wan-Tan-Hülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchten Sie die Kanten mit Wasser und falten Sie sie zu einem Dreieck. Bringen Sie dann die unteren Ecken zusammen und drücken Sie sie fest, um sie zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "8 Tassen Wasser in einem Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fügen Sie die Knödel vorsichtig portionsweise hinzu und rühren Sie um, um ein Anhaften zu verhindern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "4-5 Minuten kochen, bis die Knödel schwimmen und 1 Minute schwimmen bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Schaumlöffel mit der Brühe in Servierschüsseln füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einer Dip-Sauce aus Reisessig und Sojasauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
