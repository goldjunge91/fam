      "steps": [
        {
          "position": 0,
          "text": "Erhitzen Sie die Milch auf 110°F, lösen Sie dann die Hefe darin auf und lassen Sie sie 5 Minuten stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lassen Sie die Safranfäden 10 Minuten in der warmen Milch-Hefe-Mischung ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühren Sie Butter, Zucker und Salz ein und geben Sie nach und nach Mehl hinzu, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kneten Sie den Teig 8 Minuten lang, bis er glatt und elastisch ist, und heben Sie dann die Rosinen unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lassen Sie den Teig in einer geölten, mit einem Tuch abgedeckten Schüssel 1 Stunde gehen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teilen Sie den Teig in 12 Stücke, rollen Sie jedes zu einem Strang und legen Sie die Stränge auf einem Backblech zu einer S-Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lassen Sie die Teilchen 30 Minuten gehen, bestreichen Sie sie mit verquirltem Ei, bestreuen Sie sie mit Hagelzucker und backen Sie sie bei 375°F 12-15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
