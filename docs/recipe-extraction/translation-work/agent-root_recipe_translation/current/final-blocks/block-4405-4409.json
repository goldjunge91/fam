      "steps": [
        {
          "position": 0,
          "text": "Vermischen Sie Salz, Zucker, Pfefferkörner, Lorbeerblätter und Dill in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Legen Sie die Fischfilets mit der Hautseite nach unten in eine flache Glasschale und reiben Sie die Salzmischung gleichmäßig auf beide Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decken Sie die Schale mit Frischhaltefolie ab und stellen Sie sie 24-48 Stunden kalt, wobei Sie die Filets nach der Hälfte der Zeit wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nehmen Sie den Fisch aus der Salzlake, spülen Sie ihn kurz unter kaltem Wasser ab und tupfen Sie ihn mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneiden Sie den Fisch schräg in dünne Scheiben und richten Sie ihn mit Zitronenscheiben auf einer Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Servieren Sie ihn gekühlt mit dunklem Roggenbrot, Senf und eingelegten Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
