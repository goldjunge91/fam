          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Schlagen Sie Eier und Zucker hell und cremig auf und rühren Sie dann die geschmolzene Butter und Vanille unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermischen Sie in einer separaten Schüssel das Mehl mit Kardamom und heben Sie es dann unter die Eiermasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitzen Sie ein Krumkake-Eisen (Waffeleisen) bei mittlerer Hitze und fetten Sie es leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie 1 Esslöffel Teig auf das Eisen, schließen Sie es und backen Sie ihn 1-2 Minuten goldbraun, wobei Sie ihn nach der Hälfte der Zeit wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie das heiße Gebäck sofort um eine kegelförmige Form oder zu einem Zylinder, solange es noch warm und formbar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lassen Sie das Gebäck auf einem Kuchengitter abkühlen und wiederholen Sie den Vorgang mit dem restlichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermischen Sie die Schlagsahne mit dem Puderzucker und spritzen Sie sie kurz vor dem Servieren in jedes abgekühlte Gebäck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
