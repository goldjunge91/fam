      "steps": [
        {
          "position": 0,
          "text": "Heben Sie Schlagsahne und Vanille unter die gezuckerte Kondensmilch, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Legen Sie ein Backblech mit Backpapier aus und setzen Sie mit einem Eisportionierer 12 Häufchen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Frieren Sie die Häufchen mindestens 30 Minuten ein, bis sie fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmelzen Sie die Schokostückchen mit dem Kokosöl in einer mikrowellengeeigneten Schüssel in 30-Sekunden-Intervallen und rühren Sie zwischendurch um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmelzen Sie die Butter und vermischen Sie sie mit Graham-Cracker-Krümeln zu einer Hülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wälzen Sie jedes gefrorene Häufchen in der Krümelmischung und tauchen Sie es anschließend sofort in die geschmolzene Schokolade, wobei Sie es an einer Gabel festhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Legen Sie die Häufchen auf das Backpapier und frieren Sie sie vor dem Servieren 10 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
