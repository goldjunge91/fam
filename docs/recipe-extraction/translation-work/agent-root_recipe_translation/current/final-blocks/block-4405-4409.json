      "steps": [
        {
          "position": 0,
          "text": "Schälen und reiben Sie die Kartoffeln in eine Schüssel und drücken Sie anschließend mit einem sauberen Küchentuch überschüssige Flüssigkeit aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Braten Sie das Schweinehackfleisch mit der gewürfelten Zwiebel in einem großen Topf durch und würzen Sie es anschließend mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermischen Sie die geriebenen Kartoffeln in einer separaten Schüssel mit dem Mehl, sodass sie gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Formen Sie aus der Kartoffelmasse um kleine Portionen der gegarten Schweinefleischmasse herum 12-16 Bällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringen Sie die Rinderbrühe zum Kochen und geben Sie die Kartoffelbällchen vorsichtig hinein. Reduzieren Sie dann die Hitze und lassen Sie sie 15-20 Minuten köcheln, bis sie oben schwimmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Servieren Sie die Bällchen heiß in Schalen mit Brühe, Butter und Preiselbeermarmelade dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
