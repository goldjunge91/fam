      "steps": [
        {
          "position": 0,
          "text": "Bestreiche die Löffelbiskuits leicht mit Himbeermarmelade, die du mit 1 Esslöffel Wasser verdünnt hast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege eine runde 6-inch Form oder Schüssel mit Frischhaltefolie aus und stelle die Löffelbiskuits aufrecht an den Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Gelatine über Wasser und lass sie 2 Minuten quellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Sahne und Zucker, bis die Mischung dampft. Nimm sie vom Herd, gib Gelatine und Vanille dazu und rühre, bis sich alles aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kühle die Sahnemischung 20 Minuten, bis sie leicht andickt, und schlage sie dann zu weichen Spitzen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die Himbeeren unter die geschlagene Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Creme in die ausgelegte Form und klappe die Enden der Löffelbiskuits über die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle das Dessert mindestens 6 Stunden kalt. Stürze es dann aus der Form, entferne die Folie und serviere es gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
