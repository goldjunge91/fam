      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 250°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage das Eiweiß steif. Gib nach und nach Puderzucker und Maisstärke dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spritze zwei 4-inch große Baiserkreise auf das Backpapier und backe sie 1 Stunde, bis sie trocken und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage Sahne mit Kristallzucker und Vanille steif, bis weiche Spitzen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme die Himbeermarmelade leicht und hebe 1 cup frische Himbeeren unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege ein Baiser auf einen Teller und bestreiche es mit der Hälfte der Schlagsahne und anschließend der Hälfte der Himbeermischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das zweite Baiser darauf und verteile die übrige Sahne und die restlichen Himbeeren darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Dessert sofort oder stelle es bis zu 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
