      "steps": [
        {
          "position": 0,
          "text": "Erhitze Sahne, Milch und Zucker in einem Topf unter gelegentlichem Rühren, bis die Mischung dampft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Topf vom Herd und rühre Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Gelatine über Wasser und lass sie 2 Minuten quellen. Gib sie dann zur warmen Sahnemischung und rühre, bis sie sich aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung durch ein feines Sieb in 4 Förmchen oder Gläser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Panna Cotta mindestens 4 Stunden oder über Nacht kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge die Beeren mit Honig und lass sie 10 Minuten bei Zimmertemperatur ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fahre mit einem kleinen Messer am Rand der Förmchen entlang und stürze die Panna Cotta auf Teller oder serviere sie in Gläsern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere sie vor dem Servieren mit den honigglasierten Beeren und ihrem Saft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
