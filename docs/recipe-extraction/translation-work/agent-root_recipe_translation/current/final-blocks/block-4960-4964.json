      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass 0.5 cup Butter in einer runden 9-inch Kuchenform schmelzen. Gib braunen Zucker und 2 tablespoons Ananassaft dazu und rühre, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege Ananasscheiben in die Zuckermischung und setze jeweils eine Kirsche in die Mitte der Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Mehl, Backpulver und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage Kristallzucker und die übrige Butter cremig und rühre dann Eier und Vanille ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die Mehlmischung abwechselnd mit 0.5 cup des zurückbehaltenen Ananassafts unter den Teig. Beginne und ende mit der Mehlmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße den Teig vorsichtig über die Ananas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Kuchen 35-40 Minuten, bis ein Zahnstocher sauber herauskommt. Stürze ihn dann sofort auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
