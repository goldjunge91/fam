      "steps": [
        {
          "position": 0,
          "text": "Milch auf 110°F erwärmen und Hefe mit Zucker auflösen; 5 Minuten ruhen lassen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz mischen, dann Butter-Hefe-Mischung hinzufügen; glatt kneten, 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lassen Sie den Teig zugedeckt an einem warmen Ort 45 Minuten gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teilen Sie den Teig in 8 Stücke, rollen Sie jedes zu einem 24-Zoll-Strang und formen Sie es zu einer Brezel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einem großen Topf Wasser zum Kochen bringen und Backpulver darin auflösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kochen Sie jede Brezel 30 Sekunden pro Seite und legen Sie sie dann auf ein mit Backpapier ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die gekochten Brezeln mit Wasser bestreichen und großzügig mit grobem Salz bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 425°F 12-15 Minuten backen, bis die Brezel tief goldbraun ist, und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
