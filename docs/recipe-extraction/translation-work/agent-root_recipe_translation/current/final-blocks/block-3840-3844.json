      "steps": [
        {
          "position": 0,
          "text": "Schweinshaxen von allen Seiten großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitzen Sie einen großen Topf bei mittlerer bis hoher Hitze und braten Sie die Haxen pro Seite 4 Minuten an, bis sie braun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entfernen Sie die Haxen und legen Sie sie beiseite. Geben Sie dann gewürfelte Zwiebeln, Karotten und Sellerie in den Topf. 5 Minuten kochen, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fügen Sie gehackten Knoblauch hinzu und kochen Sie ihn 1 Minute lang, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wein angießen und gebräunte Stücke vom Boden abkratzen, dann 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Haxen wieder in den Topf geben, Brühe, Senf, Lorbeerblätter und Thymian hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und im Ofen 325°F 2 Stunden schmoren, bis das Fleisch sehr zart ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fett von der Oberfläche abschöpfen, Lorbeerblätter und Thymian entfernen, abschmecken und die Haxen mit einem Löffel Schmorflüssigkeit servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
