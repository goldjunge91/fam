      "steps": [
        {
          "position": 0,
          "text": "Milch auf 110°F erwärmen und Hefe darin auflösen; 5 Minuten ruhen lassen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker schaumig rühren, dann die Eier einzeln unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl und Salz mischen, dann abwechselnd mit der Hefemischung zur Buttermischung geben und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rosinen, Mandeln und Vanilleextrakt vorsichtig unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine Kugelhopf- oder Gugelhupfform mit Butter bestreichen und bemehlen, dann den Teig hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem feuchten Tuch abdecken und an einem warmen Ort 1 Stunde gehen lassen, bis sich der Teig verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 350°F 35-40 Minuten backen, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In der Form 10 Minuten abkühlen lassen, dann auf ein Kuchengitter stürzen und mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
