      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350°F vor und legen Sie Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "4 Eier mit 0.5 Tassen Zucker hell schlagen, 0.5 Tassen Mehl unterheben, dünn auf Backblechen verteilen und 8-10 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wiederholen Sie Schritt 2 mit den restlichen Eiern und Mehl, um 8-10 dünne Kuchenschichten zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 Tasse weiche Butter mit 1 Tasse Zucker schaumig schlagen, Kakaopulver und Vanille hinzufügen und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schokoladenbuttercreme auf die abgekühlten Kuchenschichten verteilen, stapeln und 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "0.5 Tassen Zucker in einem Topf bei mittlerer Hitze ohne Rühren erhitzen, bis sich goldener Karamell bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Karamell in einer dünnen Schicht über die oberste Schicht gießen und noch warm mit einem geölten Messer in Portionen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schlagsahne mit restlichem Zucker aufschlagen und vor dem Servieren als Garnitur um die Tortenränder spritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
