      "steps": [
        {
          "position": 0,
          "text": "Hefe mit warmer Milch vermischen und 5 Minuten stehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker schaumig rühren, dann die Eier-Hefe-Mischung hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl und Salz unterheben, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "10 Minuten lang kneten, dann 1.5 Stunden gehen lassen, bis sich der Teig verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rosinen, Mandeln und kandierte Zitrusschalen unter den Teig mischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Formen Sie den Teig zu einem Rechteck und legen Sie den Marzipanblock in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Teig über das Marzipan falten und zu einem großen ovalen Laib formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Backpapier legen und 1 Stunde gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bei 375 °F 50–60 Minuten backen, bis der Stollen goldbraun ist und beim Klopfen hohl klingt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
