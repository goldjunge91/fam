      "steps": [
        {
          "position": 0,
          "text": "Rinderzunge mit Zwiebeln, Karotten, Lorbeerblatt und Salz in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mit Wasser bedecken und zum Kochen bringen, dann die Hitze reduzieren und 2.5 Stunden köcheln lassen, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Zunge aus der Brühe nehmen, etwas abkühlen lassen und dann die Außenhaut mit einem Messer abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Zunge in 0.25 Zoll dicke Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Machen Sie Mehlschwitze, indem Sie Butter schmelzen und Mehl 2 Minuten lang einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rinderbrühe langsam einrühren, um Klumpen zu vermeiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kapern, Senf und Zitronensaft hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die in Scheiben geschnittene Zunge zur Soße geben und vor dem Servieren erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
