      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermischen, eine Mulde formen, warmes Wasser und 2 EL Olivenöl dazugeben und verrühren, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 8 Minuten kneten, bis er glatt ist. In 2 gleich große Stücke teilen und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das erste Teigstück auf Backpapier sehr dünn ausrollen und anschließend in eine geölte Backform von 9 × 13 Zoll legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stracchino-Käse auf dem Teig verteilen, Parmigiano darüber streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zweites Teigstück gleich dünn ausrollen und auf die Käseschicht legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit restlichem Olivenöl bestreichen, grobes Meersalz und Rosmarin darüber streuen und mit einer Gabel überall kleine Löcher hineinstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 425 °F 15–20 Minuten backen, bis die Focaccia goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
