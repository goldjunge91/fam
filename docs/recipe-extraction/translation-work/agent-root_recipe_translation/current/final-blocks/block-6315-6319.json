      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in dünne Stifte und grüne Bohnen in kurze Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen großen Topf mit Salzwasser zum Kochen bringen, Kartoffeln hinzufügen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grüne Bohnen in den Topf geben und weitere 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trenette-Nudeln in das kochende Wasser geben und nach Packungsanweisung al dente kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während die Nudeln kochen, bereiten Sie Pesto zu, indem Sie Basilikum, Knoblauch und Pinienkerne in einer Küchenmaschine zerkleinern, dann langsam Olivenöl hinzufügen und beide Käsesorten unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reservieren Sie 1 Tasse Nudelkochwasser, bevor Sie Nudeln und Gemüse abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiße Nudeln mit Pesto und Gemüse vermischen und nach und nach Nudelwasser hinzufügen, um die gewünschte Saucenkonsistenz zu erreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
