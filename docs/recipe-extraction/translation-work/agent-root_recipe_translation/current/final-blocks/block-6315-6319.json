      "steps": [
        {
          "position": 0,
          "text": "Nudelteig zubereiten: Mehl auf einer sauberen Oberfläche aufhäufen, in der Mitte eine Mulde formen, Eier hineinschlagen, eine Prise Salz hinzufügen und nach und nach Mehl unter die Eier mischen, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 10 Minuten kneten, bis er glatt und elastisch ist. In Frischhaltefolie wickeln und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spinat 2 Minuten in kochendem Salzwasser blanchieren, ausdrücken und fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spinat, Ricotta, Parmigiano, Pinienkerne, Muskatnuss und gehackten Knoblauch in einer Schüssel zu einer Füllung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig sehr dünn ausrollen und in 2 Zoll große Quadrate schneiden. Je 1 Teelöffel Füllung auf ein Quadrat geben, zu einem Dreieck falten und die Ecken zusammenführen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Walnüsse mit Butter und Sahne in einem Topf zu einer Soße vermischen und leicht erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pansotti in Salzwasser 3-4 Minuten kochen, bis sie schwimmen, vorsichtig abtropfen lassen und mit Walnusssauce vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
