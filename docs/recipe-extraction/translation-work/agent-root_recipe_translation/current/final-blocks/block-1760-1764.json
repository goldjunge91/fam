      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf. Schneide das Rindfleisch in 1 Zoll (2.5 cm) große Würfel und bräune sie im Öl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel und gib sie zum anbratenden Rindfleisch. Gib Brühe dazu und bringe alles zum Kochen. Reduziere die Hitze, decke den Topf ab und lass alles etwa 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle Steckrübe und Knollensellerie und schneide sie in 1 Zoll (2.5 cm) große Würfel. Gib sie in den Topf, decke ihn ab und lass alles weitere 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schäle und hacke das übrige Gemüse in 1 Zoll (2.5 cm) große Würfel und gib es in den Topf. Schneide den Lauch in Ringe. Decke den Topf ab und lass alles etwa 20 Minuten köcheln. Rühre so wenig wie möglich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garniere den Eintopf mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
