      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Rapsöl in einem großen Topf und gib die Zwiebeln hinein. Gare sie bei mittlerer Hitze, bis sie weich sind. Falls sie anzusetzen beginnen, gib einen Schuss Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Sellerie, Lauch, Kartoffel und ein Stück Butter dazu. Rühre um, bis die Butter geschmolzen ist, und decke den Topf ab. Lass das Gemüse 5 Minuten dünsten und nimm dann den Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Brühe dazu und füge grob geschnittene Brokkolistiele hinzu. Koche alles 10–15 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den restlichen Brokkoli dazu und gare ihn weitere 5 Minuten. Fülle alles vorsichtig in einen Mixer und püriere die Suppe glatt. Rühre Stilton ein und lass ein paar Stückchen übrig. Würze mit schwarzem Pfeffer und serviere die Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
