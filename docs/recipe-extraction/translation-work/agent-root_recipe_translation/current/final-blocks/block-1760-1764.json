      "steps": [
        {
          "position": 0,
          "text": "Presse Limettensaft über das Hähnchen und reibe es gut damit ein. Gieße überschüssigen Limettensaft ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Tomate, Frühlingszwiebel, Zwiebel, Knoblauch, Pfeffer, Thymian, Piment und Sojasauce mit den Hähnchenteilen in einer großen Schüssel. Decke sie ab und mariniere das Fleisch mindestens eine Stunde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Schmortopf oder großen Topf. Schüttle die Gewürze von jedem Hähnchenteil ab, wenn du es aus der Marinade nimmst. Bewahre die Marinade für die Sauce auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bräune das Hähnchen portionsweise in sehr heißem Öl leicht an. Lege die gebräunten Stücke auf einen Teller und brate die übrigen Stücke ebenso an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße überschüssiges Öl ab und gib das Hähnchen zurück in den Topf. Gieße die Marinade darüber und gib die Karotten dazu. Rühre um und gare alles bei mittlerer Hitze 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Mehl und Kokosmilch und rühre die Mischung unter den Eintopf. Reduziere die Hitze auf die niedrigste Stufe und gare alles weitere 20 Minuten oder bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
