      "steps": [
        {
          "position": 0,
          "text": "Klopfe das Hähnchen auf eine gleichmäßige Dicke. Wende es zuerst in verquirltem Ei und dann in Panko. Brate es in wenig Öl auf jeder Seite 4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass in einer zweiten Pfanne Brühe, Sojasauce, Mirin und Zucker köcheln. Gib die geschnittene Zwiebel dazu und gare sie 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide das Katsu in Streifen, lege es auf die Zwiebeln, gieße verquirltes Ei darüber, decke die Pfanne ab und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Katsu mit der Sauce auf Reisschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
