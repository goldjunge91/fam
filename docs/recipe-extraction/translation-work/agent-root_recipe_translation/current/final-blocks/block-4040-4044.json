      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und Hähnchen- und Lammstücke 5 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackte Zwiebeln hinzufügen und etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark, Kurkuma, Salz und Pfeffer einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gemüsebrühe zugießen und zum Kochen bringen. Karottenstücke und Zucchini hinzufügen und 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kichererbsen hinzufügen und weitere 10 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einem separaten Topf 3 Tassen Salzwasser zum Kochen bringen und Couscous in eine hitzebeständige Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kochendes Wasser über den Couscous gießen, mit Frischhaltefolie abdecken und 5 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Couscous mit einer Gabel auflockern und auf eine Servierplatte geben. Fleischragout und Gemüse darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
