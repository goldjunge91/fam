      "steps": [
        {
          "position": 0,
          "text": "Gemahlene Mandeln, Puderzucker, 2 Esslöffel geschmolzene Butter, Zimt, Orangenblütenwasser, Salz und 1 verquirltes Ei in einer Schüssel zu einer Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die restliche Butter in einer flachen Pfanne schmelzen und ein Filoteigblatt dünn damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Mandelmischung entlang der langen Kante verteilen und das Filoteigblatt fest zu einer Rolle aufwickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die gefüllte Filoteigrolle zu einer Spirale drehen und auf ein gebuttertes Backblech legen. Mit den übrigen Blättern wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die übrigen 2 Eier verquirlen und auf das Spiralgebäck streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 350 °F 35–40 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Honig und Wasser in einem Topf erwärmen und sofort nach dem Herausnehmen über das heiße Gebäck gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 15 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
