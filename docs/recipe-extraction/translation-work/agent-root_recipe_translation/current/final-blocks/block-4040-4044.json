      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf bei mittlerer Hitze erhitzen und Zwiebel, Knoblauch und grüne Chili 2 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Tomate hinzufügen und 3 Minuten kochen, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gari nach und nach in den Topf geben und dabei ständig rühren, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Langsam Wasser zugießen und dabei rühren, bis eine breiartige Konsistenz entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren und 10–15 Minuten häufig umrühren, damit das Gari vollständig gart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in Schalen als Frühstücksbrei servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
