      "steps": [
        {
          "position": 0,
          "text": "Koche die roten Linsen 12-15 Minuten in Wasser, bis sie sehr weich sind. Gieße überschüssiges Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die gekochten Linsen mit Bulgur, fein gehackten Zwiebeln, 4 Esslöffeln Olivenöl, Salz, Pfeffer und Cayennepfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete die Mischung 2-3 Minuten, bis sie wie ein Teig zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Befeuchte deine Hände und forme aus der Masse ovale oder spitz zulaufende Röllchen von etwa 3 inches Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze 2 cups Olivenöl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Kibbeh vorsichtig ins heiße Öl und frittiere sie 2-3 Minuten. Wende sie einmal, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Kibbeh warm und garniere sie mit frischen Minzblättern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
