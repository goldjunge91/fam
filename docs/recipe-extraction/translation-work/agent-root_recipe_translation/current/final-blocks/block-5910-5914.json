      "steps": [
        {
          "position": 0,
          "text": "Koche Toor Dal in 5 cups Wasser mit einer Prise Kurkuma. Nach 35-40 Minuten ist es weich; stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die Mehlsorten mit 3 Esslöffeln Ghee, Salz und Wasser zu einem festen Teig. Knete ihn gut durch und teile ihn in 3 Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe die Baati-Kugeln im vorgeheizten Ofen bei 400°F direkt auf dem Rost 20-25 Minuten, bis sie goldbraun und fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze währenddessen das restliche Ghee in einer Pfanne und brate die fein geschnittenen Zwiebeln dunkelgolden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und brate alles 1 Minute. Füge dann gehackte Tomaten und Gewürze hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Dal in die gewürzte Tomatenmischung, gib Jaggery dazu und lass alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Baati aus dem Ofen und wälze sie im gekochten Dal, bis sie rundum überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Baati sofort, mit zusätzlichem Ghee beträufelt und zusammen mit dem übrigen Dal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
