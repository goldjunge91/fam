      "steps": [
        {
          "position": 0,
          "text": "Weiche die gelben Schälerbsen 30 Minuten in Wasser ein, lass sie abtropfen und mahle sie grob zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Öl in einer Pfanne und gib die Kreuzkümmelsamen hinein. Lass sie 20 Sekunden rösten, bis sie brutzeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch, gewürfelte Zwiebel und gewürfelte grüne Chili dazu und brate alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die gemahlene Dhal-Paste ein und gare sie unter häufigem Rühren 5-7 Minuten trocken. Stelle sie zum Abkühlen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge Mehl, Backpulver und Salz in einer Schüssel. Gib ½ cup Wasser dazu und knete alles zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teile den Teig in 6 Portionen und rolle jede auf einer bemehlten Fläche zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die abgekühlte Dhal-Mischung auf einer Hälfte jedes Kreises. Klappe den Teig zusammen und drücke die Ränder vorsichtig fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze das restliche Öl in einer Pfanne und brate jedes Dhal Puri 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
