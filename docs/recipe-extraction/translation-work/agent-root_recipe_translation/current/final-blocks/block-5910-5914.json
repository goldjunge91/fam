      "steps": [
        {
          "position": 0,
          "text": "Spüle die Pinto-Bohnen aus der Dose gründlich unter kaltem Wasser ab und lass sie abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel fein und hacke die Knoblauchzehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittlerer Hitze und gib die gewürfelte Zwiebel hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Zwiebel 3-4 Minuten weich, gib dann den gehackten Knoblauch dazu und brate ihn 1 Minute mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die abgetropften Bohnen, Kreuzkümmel, Chilipulver und Salz in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerdrücke die Bohnen während des Garens 8-10 Minuten mit einem Kartoffelstampfer; lass einige Stücke ganz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Limettensaft und nach Belieben gewürfelte Jalapeño ein und schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gare alles weitere 2 Minuten, bis es vollständig erhitzt ist. Garniere das Gericht mit Koriander und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
