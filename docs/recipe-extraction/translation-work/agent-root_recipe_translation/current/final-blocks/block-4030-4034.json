          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer großen Schüssel vermengen, dann beim Kneten nach und nach Wasser hinzufügen, bis ein weicher, elastischer Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig 5-8 Minuten glatt kneten, abdecken und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 6 gleiche Portionen teilen und jede zu einem dünnen Kreis von etwa 8 inches Durchmesser ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jeden Kreis leicht mit Öl bestreichen, halbieren und erneut zu einem dünnen Viertelkreis oder Quadrat ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittelhoher Hitze sehr heiß werden lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ein Chapati auf die heiße Fläche legen und etwa 1-2 Minuten garen, bis sich Blasen bilden, dann wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Chapati vorsichtig mit einem Tuch andrücken, damit es aufgeht, und weitere 1-2 Minuten garen, bis es hellgolden ist und braune Stellen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit etwas Butter bestreichen und auf einen mit einem Tuch abgedeckten Teller legen, damit es warm bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit dem übrigen Teig wiederholen und sofort mit Eiern, Bohnen oder Avocado servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
