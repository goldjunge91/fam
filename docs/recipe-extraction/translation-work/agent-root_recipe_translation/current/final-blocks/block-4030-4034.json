      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen und den fertigen Tarteboden in eine 9-inch Tarteform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Milch in einem Topf bei mittlerer Hitze erhitzen, bis sie dampft, aber nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maisstärke, Zucker und Salz in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3 tbsp heiße Milch zur Maisstärkemischung geben und glatt rühren, dann die Mischung zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter und Vanilleextrakt einrühren und unter ständigem Rühren 2 Minuten kochen, bis die Masse eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und 5 Minuten abkühlen lassen, dann die Eier einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Creme in den Tarteboden gießen und mit Zimt bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "25-30 Minuten backen, bis die Creme gestockt, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Vor dem Schneiden vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
