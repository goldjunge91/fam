        {
          "position": 0,
          "text": "Öl in einem großen Topf bei mittelhoher Hitze erhitzen und Rinderhack krümelig anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel und gehackten Knoblauch hinzufügen und 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe angießen, zum Köcheln bringen und 15 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einem separaten Topf 4 cups Wasser mit Salz zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Maismehl langsam unter ständigem Rühren ins kochende Wasser geben, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren und 10-15 Minuten unter ständigem Rühren kochen, bis der Pap eindickt und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fleischeintopf auf einem Hügel Pap auf jedem Teller servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
