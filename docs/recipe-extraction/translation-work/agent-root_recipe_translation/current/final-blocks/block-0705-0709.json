      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 400 °F (200 °C) vor. Presse den Tofu 5 Minuten zwischen Papiertüchern trocken und schneide ihn dann in Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Miso, Sojasauce, Sesamöl, Honig und Knoblauch. Wende den Tofu in dieser Glasur und verteile ihn auf einem mit Backpapier belegten Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste den Tofu 20–25 Minuten, bis er karamellisiert und knusprig ist. Wende ihn nach der Hälfte der Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare währenddessen braunen Reis und dämpfe Brokkoli. Koche die Eier 6½ Minuten weich, kühle sie dann in Eiswasser ab und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte die Schüsseln an: Reis, Brokkoli, Tofu und halbiertes Ei. Träufle übrige Glasur darüber und streue Sesamsamen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
