          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Kartoffeln in heißem Öl 5 Minuten ungestört an, wende sie dann und gare sie insgesamt 10 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe die Kartoffeln an den Pfannenrand, gib die Wurst dazu und brate sie pro Seite 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zwiebel, Paprika und Knoblauch dazu und gare alles 5 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit geräuchertem Paprikapulver, Salz und Pfeffer. Gib zum Schluss Petersilie dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
