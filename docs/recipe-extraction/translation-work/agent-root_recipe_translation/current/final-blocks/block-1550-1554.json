      "steps": [
        {
          "position": 0,
          "text": "Tupfe den Lachs vollständig trocken und würze ihn großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze, bis es leicht schimmert. Lege den Lachs mit der Hautseite nach oben hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate ihn 4–5 Minuten, ohne ihn zu bewegen. Wende ihn und brate ihn weitere 3 Minuten. Nimm ihn auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittlere Stufe, gib Knoblauch und Chiliflocken dazu und gare alles 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Spinat portionsweise dazu und wende ihn 2–3 Minuten, bis er zusammenfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Presse Zitrone über den Spinat und lege den Lachs darauf zurück. Serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
