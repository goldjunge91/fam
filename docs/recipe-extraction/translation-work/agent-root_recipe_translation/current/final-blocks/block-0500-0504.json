    {
      "externalId": "waivy:toh-salmon-veggie-packets",
      "slug": "toh-salmon-veggie-packets",
      "title": "Lachs-Gemüse-Päckchen",
      "instructions": "Zarte Lachsfilets garen zusammen mit knackiger gelber Paprika und Zuckerschoten in eigenen Päckchen aus Backpapier. Ein Spritzer Zitrone sorgt für ein frisches, unkompliziertes Abendessen. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/salmon-veggie-packets/",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Tiefgekühlte Lachsfilets sind meist günstiger als frische und eignen sich nach dem Auftauen und Trockentupfen bestens.",
        "Lass den Weißwein weg und verwende etwas Brühe und einen Schuss Weißweinessig. Das Gericht bleibt dadurch frisch und aromatisch.",
        "Ersetze Zuckerschoten durch beliebiges knackiges Gemüse aus dem Angebot, zum Beispiel grüne Bohnen oder Spargel, in ähnlich große Stücke geschnitten."
      ],
      "substitutions": [
        {
          "forIngredientId": "white-wine",
          "swap": "Hühner- oder Gemüsebrühe mit einem Spritzer Zitrone",
          "savings": "~$0.30 pro Rezept"
        },
        {
          "forIngredientId": "yellow-bell-pepper",
          "swap": "Rote oder orange Paprika",
          "savings": "gleich"
        },
        {
          "forIngredientId": "snap-peas",
          "swap": "Geputzte grüne Bohnen oder Spargel",
          "savings": "~$2 pro Rezept"
        }
      ],
