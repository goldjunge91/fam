    {
      "externalId": "waivy:toh-saucy-pork-chop-skillet",
      "slug": "toh-saucy-pork-chop-skillet",
      "title": "Schweinekoteletts mit Soße aus der Pfanne",
      "instructions": "Zarte Schweinekoteletts aus dem Rücken braten in einer herzhaften Tomaten-Rinderbrühe mit süßer Zwiebel und Kräutern. Zum Schluss kommt eine glänzende Bratensoße darüber und das Gericht wird auf lockerem Vollkornreis serviert. Ein wärmendes Abendessen aus einer Pfanne, das in einer halben Stunde fertig ist. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/saucy-pork-chop-skillet/",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Kaufe ein ganzes Schweinefilet und schneide die Koteletts selbst. Das ist pro Pfund viel günstiger als fertig geschnittene Koteletts ohne Knochen.",
        "Ersetze Rinderbrühe durch Wasser mit einem Brühwürfel, um Geld zu sparen und den herzhaften Geschmack zu erhalten.",
        "Verwende normalen braunen Reis statt Instantreis und koche eine große Menge vor. Das ist günstiger und lässt sich gut einfrieren."
      ],
      "substitutions": [
        {
          "forIngredientId": "pork-chop",
          "swap": "Hähnchenoberkeulen oder Hähnchenbrust ohne Knochen",
          "savings": "Oft günstiger pro Pfund und genauso schnell anzubraten"
        },
        {
          "forIngredientId": "beef-broth",
          "swap": "Hühnerbrühe oder in Wasser aufgelöster Brühwürfel",
          "savings": "Halbiert ungefähr die Brühenkosten"
        },
        {
          "forIngredientId": "brown-rice",
          "swap": "Weißer Reis oder Eiernudeln",
          "savings": "Weißer Reis ist normalerweise günstiger und kocht schneller"
        }
      ],
