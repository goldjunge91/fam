      "steps": [
        {
          "position": 0,
          "text": "Koche die Pasta in reichlich gesalzenem Wasser, bis sie gerade weich ist. Gieße sie gründlich ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter in einer großen, schweren Pfanne oder gusseisernen Pfanne bei mittlerer Hitze. Rühre das Mehl ein und gare es kurz, bis die Mischung glatt und klumpenfrei ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße nach und nach die Kaffeesahne dazu und rühre ständig, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe die Soße zum Kochen und gare sie unter ständigem Rühren etwa 2 Minuten, bis sie eindickt und glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und rühre den gewürfelten Käse ein, bis er vollständig zu einer glatten Soße geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die abgetropfte Pasta unter und rühre alles um, bis sie gleichmäßig überzogen und durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort servieren und nach Wunsch mit Rucola, halbierten Tomaten und frisch gemahlenem schwarzem Pfeffer verfeinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
