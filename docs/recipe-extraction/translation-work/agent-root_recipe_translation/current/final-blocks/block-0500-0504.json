      "steps": [
        {
          "position": 0,
          "text": "Koche den Vollkornreis nach Packungsanleitung und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Rapsöl in einer großen beschichteten Pfanne bei mittlerer bis hoher Hitze. Brate die Schweinekoteletts auf beiden Seiten an, bis sie gebräunt sind, und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die geschnittene Zwiebel in den Bratensatz und brate sie unter Rühren, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomaten, Rinderbrühe, Petersilie, Salz, Pfeffer, Basilikum und Oregano ein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Koteletts zurück in die Pfanne, reduziere die Hitze, decke sie ab und lass sie köcheln, bis das Schweinefleisch 145F erreicht hat, etwa 6 bis 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Schweinefleisch auf eine Servierplatte und halte es warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verrühre Mehl und Wasser zu einer glatten Mischung. Rühre sie in die Soße ein und koche alles unter ständigem Rühren etwa 2 Minuten, bis die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Löffle die Soße über das Schweinefleisch und serviere es mit Vollkornreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
