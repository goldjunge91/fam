      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel und Knoblauch in einer Pfanne bei mittelhoher bis hoher Hitze etwa 8 Minuten, bis es vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Kreuzkümmel, Salz, Pfeffer und abgetropfte schwarze Bohnen unter und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile Tortillachips auf einem Backblech und belege sie mit der Rindfleischmischung und Jalapeños.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Streue geriebenen Cheddar gleichmäßig über die Chips und backe sie bei 375°F 5-7 Minuten, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Blech aus dem Ofen und träufle vor dem Servieren Salsa darüber. Gib Kleckse saure Sahne darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort heiß und knusprig servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
