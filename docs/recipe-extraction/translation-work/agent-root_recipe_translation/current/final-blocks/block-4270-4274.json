      "steps": [
        {
          "position": 0,
          "text": "Entferne Kerne und Stiele der getrockneten roten Chilis und röste sie 1 Minute in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die gerösteten Chilis mit Zwiebel und Knoblauch in 2 Tassen Wasser und lasse sie 10 Minuten köcheln, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die Chilis glatt, streiche sie durch ein Sieb und vermische sie mit Hühnerbrühe und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer flachen Pfanne. Tauche jede Tortilla kurz hinein, damit sie weich wird, und anschließend in die rote Chilisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffel gezupftes Hähnchen und 1 Esslöffel Käse auf jede Tortilla. Rolle sie auf und lege sie mit der Nahtseite nach unten in eine gefettete Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die restliche rote Sauce über die Enchiladas und träufle Crema darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue den restlichen Käse darüber und backe die Enchiladas bei 350°F 25 Minuten, bis sie blubbern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
