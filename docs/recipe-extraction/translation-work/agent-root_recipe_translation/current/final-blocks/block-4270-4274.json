      "steps": [
        {
          "position": 0,
          "text": "Mariniere die Schweinefleischwürfel mindestens 30 Minuten in Orangensaft, Limettensaft, fein gehacktem Knoblauch und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und bräune die marinierten Schweinefleischstücke insgesamt etwa 10 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Schweinefleisch heraus und dünste die gewürfelten Zwiebeln im selben Topf etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Schweinefleisch samt Marinade zurück in den Topf. Füge Brühe und Kreuzkümmel hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse das Gericht zugedeckt 45 Minuten köcheln, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfelte Kartoffeln hinzu und gare sie weitere 20-25 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht heiß mit Maistortillas oder weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
