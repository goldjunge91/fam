      "steps": [
        {
          "position": 0,
          "text": "Würze das Rindfleisch mit Salz, Pfeffer und gehacktem Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide 1 Zwiebel in 4 große Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Fleisch mit den 4 Zwiebelspalten und der Brühe in den Schnellkochtopf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche es im Schnellkochtopf 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass den Druck ab und öffne den Deckel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Rindfleisch heraus und BEWAHRE 2 cups Brühe in einem anderen Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zerfasere das Fleisch mit 2 Gabeln. Es sollte so zart sein, dass es leicht auseinanderfällt. Falls nicht, gare es weitere 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Drücke die Sauté-Taste am Instant Pot. Gib Olivenöl dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Wenn das Gerät piept, gib geschnittene Zwiebel, Paprika und Tomaten hinein. Gare alles weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gib das zerkleinerte Rindfleisch zurück in den Topf und vermische es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gieße 1 1/2 cups der aufgehobenen Brühe, Worcestershire-Sauce, Tomatenmark, Ketchup und Kreuzkümmel hinein. Vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Wenn die Sauce zu trocken wirkt, gib noch einen Schuss Brühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Servieren!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
