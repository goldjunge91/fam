      "steps": [
        {
          "position": 0,
          "text": "Verquirle alle Zutaten für das Dressing in einer großen Servierschüssel. Koche die Nudeln nach Packungsanweisung, gieße sie ab und gib sie mit dem Dressing in die Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die Karotte mit einem Sparschäler längs in Streifen. Verfahre genauso mit der Gurke, bis du die Kerne erreichst, und wirf diese weg. Gib Karotte und Gurke mit zerkleinertem Hähnchen, Radieschen, roter Zwiebel und Minze zu den Nudeln. Vermenge alles gut mit dem Dressing, streue Erdnüsse darüber und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
