        {
          "position": 0,
          "text": "Schneide das Rinderfilet quer zur Faser in 1/4-inch dicke Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerstoße Knoblauch und Chilis zusammen und vermenge sie dann mit Fischsauce, Sojasauce, Palmzucker, schwarzem Pfeffer und Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mariniere die Rindfleischstreifen mindestens 2 hours oder über Nacht in der Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe das Rindfleisch mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Streifen auf ein Gitter über einem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie bei 160°F 3-4 hours und wende sie gelegentlich, bis das Fleisch vollständig getrocknet, aber noch leicht biegsam ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass das Trockenfleisch vollständig abkühlen, bevor du es in einem luftdichten Behälter aufbewahrst.",
          "timerMinutes": null,
