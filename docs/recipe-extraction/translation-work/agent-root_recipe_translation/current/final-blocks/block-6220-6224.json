      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und gare das Schweinehackfleisch unter Zerteilen 5-7 Minuten, bis es durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerstoße Knoblauch, Chilis und Schalotten in einem Mörser, bis sie duften und zerkleinert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die zerstoßene Mischung zum Schweinefleisch und rühre sie bei Hitze 1 Minute unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd, rühre Limettensaft und Fischsauce ein und lass alles etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe frische Minze, Koriander und die Hälfte der gerösteten Erdnüsse unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle das Gericht auf einen Teller und bestreue es mit den übrigen Erdnüssen und weiteren frischen Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es bei Zimmertemperatur mit Salatblättern und Klebreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
