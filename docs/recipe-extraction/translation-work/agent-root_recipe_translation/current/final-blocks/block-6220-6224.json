      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Knoblauch, Korianderwurzeln und schwarzen Pfeffer in einem Mörser zu einer pastenartigen Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Hähnchenschenkel mit der Knoblauchpaste ein. Gib dann Fischsauce und Salz dazu und überziehe das Fleisch gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass das Hähnchen mindestens 30 Minuten oder bis über Nacht im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf oder Wok auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tupfe das Hähnchen mit Küchenpapier trocken und gib es dann vorsichtig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere es 12-15 Minuten und wende es nach der Hälfte der Zeit, bis die Haut dunkelgoldbraun ist und die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass das Hähnchen auf Küchenpapier abtropfen und serviere es mit Limettenspalten und Klebreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
