          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Säubere den Fisch und ritze die Haut auf beiden Seiten diagonal ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reibe die Marinade in die Bauchhöhle und rundherum auf die Außenseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass den Fisch 20 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille ihn bei mittlerer Hitze 6-7 Minuten pro Seite, bis das Fleisch undurchsichtig und die Haut knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere den Fisch mit gehackten Frühlingszwiebeln und serviere ihn mit Limettenspalten.",
          "timerMinutes": null,
