      "steps": [
        {
          "position": 0,
          "text": "Gieße die Saubohnen aus der Dose ab und spüle sie gründlich unter kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem Topf bei mittlerer Hitze und gib gehackten Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Saubohnen und Kreuzkümmel hinzu und rühre 2 Minuten ständig, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerdrücke die Bohnen grob mit einem Löffelrücken und lasse einige ganz, damit die Masse Struktur behält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Zitronensaft ein und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Bohnen in eine Servierschüssel und beträufle sie mit zusätzlichem Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere mit frischer Petersilie und serviere warm mit Pitabrot und hart gekochten Eiern als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
