      "steps": [
        {
          "position": 0,
          "text": "Entferne Kerne und Stiele von den getrockneten Chilischoten und röste sie 2 Minuten trocken in einer Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilischoten 15 Minuten in heißem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die weichen Chilischoten samt Einweichwasser mit Tomaten, Sesam, Mandeln, Rosinen, Knoblauch, Zwiebel, Zimt und Nelken glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Mischung durch ein feinmaschiges Sieb, um Stücke der Chilischotenhaut zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche das Hähnchen 30 Minuten in Salzwasser und bewahre die Brühe auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Mole-Paste 5 Minuten unter ständigem Rühren in einem großen Topf mit Öl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gegartes Hähnchen und 2 cups der aufbewahrten Brühe dazu und lasse alles 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht mit warmen Tortillas und zusätzlichem Sesam darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
