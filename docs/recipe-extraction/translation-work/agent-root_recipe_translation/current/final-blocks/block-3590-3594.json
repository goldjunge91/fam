      "steps": [
        {
          "position": 0,
          "text": "Erwärme Bohnenmus in einem Topf bei mittlerer Hitze. Verdünne es mit 1/4 cup Wasser, falls es zu dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tauche jede Maistortilla in die warme Bohnensauce, sodass beide Seiten bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und brate die mit Bohnen überzogenen Tortillas je 1 Minute pro Seite, bis sie leicht knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle die gefüllten Tortillas auf und lege sie mit der Naht nach unten auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate Eier in derselben Pfanne mit der Eigelbseite nach oben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege die Enfrijoladas mit Spiegeleiern, den übrigen Bohnen, Käse, gewürfelter Zwiebel, Koriander und saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
