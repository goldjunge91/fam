      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch quer zur Faser in dünne Scheiben und klopfe sie leicht mit einem Fleischklopfer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Zwiebeln in dicke Ringe und hacke Knoblauchzehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze und würze das Rindfleisch mit Salz, Pfeffer und Kreuzkümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Fleisch 2-3 Minuten pro Seite, bis es gebräunt ist, und stelle es dann auf einem Teller beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dünste Knoblauch in derselben Pfanne, bis er duftet. Gib dann Zwiebeln dazu und gare sie weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Rindfleisch, Limettensaft, Tomate und Wasser zurück in die Pfanne und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß mit Reis oder Maistortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
