      "steps": [
        {
          "position": 0,
          "text": "Vermische warme Milch, Hefe und Zucker in einer Schüssel und lasse alles 5 Minuten stehen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Salz in einer großen Schüssel, gib Hefemischung, Eier und geschmolzene Butter dazu und knete 8 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle Speck und Zwiebel und dünste beides zusammen, bis der Speck knusprig und die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe die Speckmischung und Kümmelsamen unter den Teig, decke ihn ab und lasse ihn 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme den Teig zu einem Ring, lege ihn in eine gefettete Kugelhopfform und lasse ihn 30 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe ihn bei 375°F 35-40 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse ihn 10 Minuten in der Form abkühlen und stürze ihn dann auf ein Kuchengitter, damit er vollständig abkühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
