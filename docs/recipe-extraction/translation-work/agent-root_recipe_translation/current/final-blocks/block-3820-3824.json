      "steps": [
        {
          "position": 0,
          "text": "Schneide Brötchen in 0.5-inch große Würfel und gib sie in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Milch, gieße sie über die Brotwürfel und lasse alles 10 Minuten ziehen, bis das Brot die Milch aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke Zwiebel fein und vermische sie mit Eiern, Petersilie, Salz, Pfeffer und Muskatnuss unter das eingeweichte Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Mischung 5 Minuten ruhen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme daraus 8 Kugeln von etwa 2.5 inches Durchmesser und drücke sie vorsichtig zusammen, damit sie halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Knödel vorsichtig ins kochende Wasser und koche sie, bis sie an die Oberfläche steigen. Gare sie dann weitere 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und serviere sie heiß zu Fleischragout oder Pilzsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
