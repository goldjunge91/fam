      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und tupfe Schweinshaxen mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Schmortopf bei mittelhoher bis hoher Hitze und bräune die Haxen insgesamt 10-12 Minuten von allen Seiten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Zwiebel, Karotte und Sellerie in große Stücke und gare sie 5 Minuten im Topf, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche dann mit Bier ab und löse Röstspuren vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Brühe, Lorbeerblätter, Salz und Pfeffer dazu und lege die Haxen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und schmoren alles 2 Stunden im Ofen, bis das Fleisch sehr zart ist und vom Knochen fällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Haxen auf einen Teller, seihe den Schmorsud durch ein feinmaschiges Sieb in einen Topf und lasse ihn 10 Minuten köcheln, damit er einkocht und intensiver schmeckt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Haxen mit darübergelöffelter Sauce und Kartoffelpüree oder Semmelknödeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
