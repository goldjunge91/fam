      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Eier, Milch, Salz und Zucker zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare gehackte Zwiebel 3 Minuten in einer kleinen Pfanne bei mittlerer Hitze weich und hebe sie dann unter das Sauerkraut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Pflanzenöl in einer schweren Pfanne oder Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib löffelweise Teig ins heiße Öl und frittiere ihn etwa 2 Minuten, bis die Unterseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende Krapfen und frittiere die andere Seite etwa 1.5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide jeden Krapfen noch warm leicht ein und fülle einen Löffel Sauerkrautmischung hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestäube sie leicht mit Puderzucker und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
