      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch würfeln, trocken tupfen und würzen. Speck im Schmortopf auslassen und herausnehmen. Fleisch portionsweise im Fett anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel und Karotte 4 Minuten anbraten. Knoblauch und Tomatenmark dazugeben und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl darüberstreuen und 2 Minuten garen. Wein und Brühe angießen und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fleisch und Speck zurück in den Topf geben. Thymian und Lorbeer hinzufügen. Zugedeckt bei 325°F 2 Stunden schmoren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pilze und Perlzwiebeln separat in Butter anbraten und in den letzten 30 Minuten dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und würzen. Mit Kartoffelpüree oder Eiernudeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
