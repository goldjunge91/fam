      "steps": [
        {
          "position": 0,
          "text": "Knoblauchzehen mit Salz, Kreuzkümmel, Oregano und schwarzem Pfeffer in einer Schüssel zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Machen Sie tiefe Schlitze in die Schweineschulter und reiben Sie die Knoblauchpaste gründlich in alle Schnitte und über die gesamte Oberfläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Orangensaft, Limettensaft und Olivenöl vermischen und über das Schweinefleisch gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Schweinefleisch abdecken und mindestens 4 Stunden, am besten über Nacht, im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie das Schweinefleisch mit der Marinade in einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ohne Deckel 3–4 Stunden braten und alle 30 Minuten mit dem Bratensaft beträufeln, bis die Haut knusprig und das Fleisch gabelzart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Aus dem Ofen nehmen und vor dem Schnitzen 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
