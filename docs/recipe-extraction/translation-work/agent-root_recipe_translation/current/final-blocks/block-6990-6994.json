      "steps": [
        {
          "position": 0,
          "text": "Knoblauchzehen mit Salz und Kreuzkümmel zu einer Paste zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Rindfleischscheiben mit der Knoblauchpaste einreiben und mit Limettensaft beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Zwiebel in Ringe schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Braten Sie die Rindfleischscheiben portionsweise 2-3 Minuten pro Seite, bis sie goldbraun und nach Ihren Wünschen gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Rindfleisch herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In derselben Pfanne die Zwiebelringe kurz 2-3 Minuten anbraten, bis sie leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren Sie das Bistec mit den sautierten Zwiebeln garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
