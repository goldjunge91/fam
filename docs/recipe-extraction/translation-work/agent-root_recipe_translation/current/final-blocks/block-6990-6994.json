      "steps": [
        {
          "position": 0,
          "text": "Das Rindfleisch in 1 Zoll große Würfel schneiden und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf erhitzen und das Rindfleisch von allen Seiten insgesamt etwa 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch hinzufügen und 1 Minute lang umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit der Rinderbrühe aufgießen, Kreuzkümmel hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren und 20 Minuten köcheln lassen, dann geschälte und gewürfelte Kartoffeln und Kochbananen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Mais (frisch vom Maiskolben oder aus der Dose) hinzufügen und weitere 15–20 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit zusätzlichem Salz und Pfeffer abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
