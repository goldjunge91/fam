      "steps": [
        {
          "position": 0,
          "text": "Hähnchen trocken tupfen und innen sowie außen mit Salz, Knoblauchpulver und schwarzem Pfeffer einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen in einen Schongarer legen und die geviertelte Zwiebel in die Bauchhöhle geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe um das Hähnchen gießen und Flüssigrauch darüberträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abdecken und auf niedriger Stufe 6–7 Stunden garen, bis sich das Fleisch leicht mit einer Gabel zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen aus dem Schongarer nehmen und das Fleisch mit zwei Gabeln zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Haut und Knochen entsorgen und das zerpflückte Fleisch mit der Kochflüssigkeit vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm mit Reis oder als Sandwichfüllung servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
