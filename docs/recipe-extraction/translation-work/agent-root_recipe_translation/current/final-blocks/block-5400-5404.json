      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Flügel trocken und wende sie leicht in Maisstärke und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und bräune die Flügel insgesamt 8 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke Knoblauch, Schalotten und Thai-Chilis zusammen zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Fischsauce, Limettensaft, Honig und die Knoblauch-Schalotten-Chili-Paste in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Sauce über die gebräunten Flügel und bringe sie zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Setze einen Deckel auf und lass die Flügel 15 Minuten köcheln, bis sie gar sind und die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Deckel ab und lass alles weitere 3 Minuten köcheln, damit die Sauce einkocht und die Flügel karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
