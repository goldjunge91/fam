      "steps": [
        {
          "position": 0,
          "text": "Koche die Quinoa. Bereite die Croûtons zu: Würfle das Brot, vermenge es mit Öl und Knoblauch und backe es bei 375°F 12 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Für das Caesar-Dressing Knoblauch, Sardellenpaste, Dijon-Senf, Zitrone, griechischen Joghurt, Olivenöl und Parmesan verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Massiere den Grünkohl 2 Minuten mit der Hälfte des Dressings, bis er weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze den Lachs und brate ihn 4 Minuten pro Seite scharf an. Zerpflücke ihn in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte Grünkohl, Quinoa, Lachs, Croûtons und Parmesan in einer Schale und gib zusätzliches Dressing darüber.",
          "timerMinutes": null,
