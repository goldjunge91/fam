      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser zum Kochen und blanchiere Schweineohren 2-3 Minuten. Nimm sie heraus und entferne unter fließendem Wasser Haare und Rückstände.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gereinigten Ohren zurück in frisches kochendes Salzwasser und lasse sie 30-35 Minuten köcheln, bis sie sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Ohren ab, lasse sie abkühlen und schneide sie in etwa 1/4-inch dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Reisessig, Sojasauce, Sesamöl und Chiliöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die geschnittenen Ohren zum Dressing und vermische alles vorsichtig, aber gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue das Gericht mit gehackten Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Salat bei Raumtemperatur oder gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
