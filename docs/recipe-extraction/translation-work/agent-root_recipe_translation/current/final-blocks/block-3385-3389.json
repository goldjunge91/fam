          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche Soba-Nudeln nach Packungsanweisung in kochendem Salzwasser, gieße sie ab und spüle sie mit kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die gekochten Nudeln auf zwei Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schöpfe die heiße Brühe gleichmäßig über die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege jede Schale mit Schweinefleischscheiben, Fischkuchen, Frühlingszwiebeln und eingelegtem Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue jede Schale mit Bonitoflocken und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
