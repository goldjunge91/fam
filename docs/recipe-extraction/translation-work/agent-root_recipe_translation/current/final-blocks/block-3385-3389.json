      "steps": [
        {
          "position": 0,
          "text": "Schneide den Schweinebauch in 2-inch große Würfel und lasse die Schwarte daran.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blanchiere die Schweinefleischwürfel 5 Minuten in kochendem Wasser, gieße sie ab und spüle sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Wasser, Sojasauce, Mirin, Sake, Zucker und zerdrückten Ingwer in einem großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den blanchierten Schweinebauch in den Topf und bringe alles zum Kochen. Reduziere dann die Hitze.",
