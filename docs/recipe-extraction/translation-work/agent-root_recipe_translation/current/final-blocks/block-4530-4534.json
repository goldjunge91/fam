      "steps": [
        {
          "position": 0,
          "text": "Ofen auf 400 °F vorheizen. Fleisch, Kartoffeln und Karotten in 1 Zoll große Würfel schneiden, Zwiebel würfeln und Knoblauch hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem Topf erhitzen und Fleischwürfel insgesamt etwa 8 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel und Knoblauch hinzufügen und 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark, Kreuzkümmel und Paprikapulver einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln und Karotten hinzufügen und mit Gewürzen sowie Öl vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei Verwendung eines Tontopfs (Testi) diesen mit Folie und Teig am Rand verschließen; andernfalls einen abgedeckten Schmortopf verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Topf in den Ofen stellen und 60 Minuten garen, bis das Fleisch zart und das Gemüse gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tonsiegel vorsichtig aufbrechen und heiß mit frischem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
