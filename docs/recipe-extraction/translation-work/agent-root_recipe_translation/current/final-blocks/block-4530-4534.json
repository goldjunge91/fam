      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch in 1.5 Zoll große Würfel schneiden und Knoblauchzehen hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl, Zitronensaft, Knoblauch, Paprikapulver, Kreuzkümmel, Salz und Pfeffer in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rindfleischwürfel in der Marinade wenden und mindestens 2 Stunden oder über Nacht kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebeln und Paprika in 1 Zoll große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rindfleisch, Zwiebel und Paprika abwechselnd auf Spieße stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grill oder Grillpfanne stark erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Spieße 10–12 Minuten grillen und alle 2–3 Minuten wenden, bis das Rindfleisch nach Wunsch gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "2 Minuten ruhen lassen und mit Pitabrot, Joghurtsauce und frischem Salat servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
