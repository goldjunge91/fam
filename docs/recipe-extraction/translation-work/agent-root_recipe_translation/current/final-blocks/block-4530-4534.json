      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser mit Hefe und Zucker verrühren und 5 Minuten stehen lassen, bis es schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, Hefemischung und Öl hinzufügen und 8 Minuten zu einem glatten, elastischen Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig mit einem feuchten Tuch abdecken und 45 Minuten gehen lassen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 6 gleich große Stücke teilen und jedes zu einer etwa 12 Zoll langen Rolle formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Rolle zu einem Ring formen, die Enden überlappen und auf ein gefettetes Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Melasse mit 1 Esslöffel Wasser verrühren und jeden Simit-Ring damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Melasse bestrichene Simits in Sesamsamen wenden, bis sie vollständig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 400 °F 20–25 Minuten goldbraun und knusprig backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf einem Kuchengitter 10 Minuten abkühlen lassen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
