      "steps": [
        {
          "position": 0,
          "text": "Koche die Tapiokaperlen 15-20 Minuten in gesalzenem Wasser, bis sie durchsichtig sind. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Hühnerbrühe in einem großen Topf bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke den Knoblauch und schneide die Zwiebel in Scheiben. Gib beides zur Brühe und lass sie 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zupfe das Krabbenfleisch auseinander und gib es zusammen mit der Fischsauce zur Brühe. Lass alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gekochten Tapiokaperlen zur Brühe und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile alles auf Schüsseln und belege es mit gehackten Frühlingszwiebeln, frittierten Schalotten und einem Spritzer frischer Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
