      "steps": [
        {
          "position": 0,
          "text": "Koche die Reisnudeln nach Packungsanweisung, gieße sie ab und spüle sie mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite die Dip-Sauce zu, indem du Fischsauce, Limettensaft, Zucker, gehackten Knoblauch und geschnittene Chilis in einer Schüssel vermischst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle die gekochten Nudeln mindestens 15 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Gurke in dünne Scheiben und hacke die frischen Minzblätter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die gekühlten Nudeln auf Schüsseln und belege sie mit Gurke, Minze und Garnelen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Träufle die vorbereitete Dip-Sauce darüber und serviere das Gericht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
