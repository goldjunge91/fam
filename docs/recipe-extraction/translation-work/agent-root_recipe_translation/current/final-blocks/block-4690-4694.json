      "steps": [
        {
          "position": 0,
          "text": "Röste die Poblano-Schoten direkt über einer Gasflamme oder unter dem Grill, bis sie rundum schwarz sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gerösteten Schoten 5 Minuten in einen Plastikbeutel, damit sie dämpfen, und ziehe anschließend die Haut unter kaltem fließendem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entferne die Samen und schneide die Schoten in dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Öl in einer Pfanne und brate die geschnittene Zwiebel und den gehackten Knoblauch etwa 3 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Paprikastreifen dazu und gare sie 2 Minuten. Gieße dann die Sahne hinzu und lass alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zupfe den Oaxaca-Käse in Stücke und rühre ihn unter die Rajas, bis er geschmolzen ist. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Rajas auf warmen Tortillas und garniere sie mit Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
