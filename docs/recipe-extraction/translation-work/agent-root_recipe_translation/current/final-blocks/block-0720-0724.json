    {
      "externalId": "waivy:mfr-lebanese-lentil-soup",
      "slug": "mfr-lebanese-lentil-soup",
      "title": "Libanesische rote Linsensuppe",
      "instructions": "Rote Linsen köcheln mit Zwiebel, Kreuzkümmel und Zitrone, bis sie zu einer samtigen, leuchtend gelben Suppe zerfallen. Ein wärmendes, preiswertes Grundgericht aus der Levante mit 22 g Eiweiß pro Schüssel.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 35,
      "storageInstructions": "Im Kühlschrank bis zu 5 Tage haltbar; lässt sich bis zu 3 Monate gut einfrieren.",
      "reheatingInstructions": null,
      "cheapTips": [
        "1 lb Linsen reicht für 4 großzügige Portionen und kostet insgesamt etwa $2.",
        "Am nächsten Tag schmeckt die Suppe noch besser. Koche am Wochenende gleich die doppelte Menge."
      ],
      "substitutions": [
