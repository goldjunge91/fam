      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchenschenkel mit Kreuzkümmel, Paprikapulver, Salz und Pfeffer. Brate sie in Olivenöl bei mittelhoher Hitze 3 Minuten pro Seite an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Zwiebel dazu und gare sie 3 Minuten, bis sie weich wird. Rühre Knoblauch, Ingwer und Zimt ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib zerkleinerte Tomaten und Kichererbsen dazu. Lege das Hähnchen in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass den Eintopf zugedeckt 30 Minuten köcheln, bis das Hähnchen zart ist. Nimm es heraus und löse das Fleisch vom Knochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das gezupfte Hähnchen zurück in den Topf, schmecke den Eintopf ab und verfeinere ihn mit Zitronensaft. Zu Couscous servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
