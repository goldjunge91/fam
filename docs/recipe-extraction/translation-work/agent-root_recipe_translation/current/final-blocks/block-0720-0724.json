      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl bei mittlerer Hitze. Brate gewürfelte Zwiebel etwa 8 Minuten an, bis sie goldbraun ist. Gib Knoblauch, Kreuzkümmel und Kurkuma dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib abgespülte Linsen, gewürfelte Karotte und 6 Tassen Wasser oder Gemüsebrühe dazu. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze und lass die Suppe 25 Minuten köcheln, bis die Linsen vollständig weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere die Suppe mit einem Stabmixer oder portionsweise im Standmixer, bis sie glatt ist. Gib Wasser dazu, bis sie die gewünschte Konsistenz erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verfeinere die Suppe mit Zitronensaft, Salz und Pfeffer. Garniere sie mit frischem Koriander und etwas Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
