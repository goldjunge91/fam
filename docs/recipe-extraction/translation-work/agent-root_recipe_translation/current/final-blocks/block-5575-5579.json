      "steps": [
        {
          "position": 0,
          "text": "Zubereitung: In a large bowl, combine gemahlen beef, breadcrumbs, egg, Parmesan, garlic, salt, and black pepper mit your hands bis just mixed.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zubereitung: Rolle mixture into 16-20 meatballs about 1.5 inches in diameter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zubereitung: Hitze olive oil in a large skillet over mittel-hoch Hitze and brown meatballs on all sides, about 8-10 Minuten total.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zubereitung: Gieße marinara sauce over meatballs and reduce Hitze to mittel-niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Köcheln for 15-20 Minuten, rührenring occasionally, bis sauce eindickens and meatballs are kochened through.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zubereitung: Meanwhile, bring a large pot of salted water to a boil and kochen spaghetti according to package directions.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zubereitung: Drain pasta and divide among serving bowls.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zubereitung: Top mit meatballs and sauce, then servieren immediately.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
