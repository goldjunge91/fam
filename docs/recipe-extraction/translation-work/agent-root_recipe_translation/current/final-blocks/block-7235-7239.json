      "steps": [
        {
          "position": 0,
          "text": "Taue gefrorenen Mais auf und tupfe ihn sehr trocken, damit er bräunt statt zu dämpfen. Lasse Dosenmais gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 1 Esslöffel Butter in einer ofenfesten Pfanne bei mittlerer bis hoher Hitze. Gib den Mais dazu und brate ihn 4-5 Minuten unter gelegentlichem Rühren, bis er stellenweise leicht verkohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf mittlere Stufe. Rühre übrige Butter, Mayonnaise, Zucker, Salz, Pfeffer und nach Wunsch Jalapeño ein, bis der Mais glänzend überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den Mais gleichmäßig und streue geriebenen Mozzarella darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne ab und gare alles 3-4 Minuten, bis der Käse schmilzt. Alternativ 2-3 Minuten unter einen heißen Backofengrill stellen, bis der Käse blubbert und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue geschnittene Frühlingszwiebeln darüber und serviere den Mais direkt aus der Pfanne mit Brot oder Reis zum Auftunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
