    {
      "externalId": "waivy:garlic-parmesan-chicken",
      "slug": "garlic-parmesan-chicken",
      "title": "Knoblauch-Parmesan-Hähnchen",
      "instructions": "Saftiges, in der Pfanne gebratenes Hähnchen in einer buttrigen Knoblauch-Parmesan-Sahnesauce, die nach Restaurantessen schmeckt und wenig kostet.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Kaufe eine große Packung Hähnchenbrust im Angebot und friere sie portionsweise ein; aus 2 Brüsten werden Schnitzel für 4 Personen.",
        "Reibe Parmesan selbst vom Stück, statt geriebenen zu kaufen. Er schmilzt besser und kostet pro Unze weniger.",
        "Verwende statt Sahne halb Sahne, halb Milch oder Vollmilch mit einem Teelöffel Mehl."
      ],
      "substitutions": [
        {
          "forIngredientId": "heavy-cream",
          "swap": "whole Milch thickened mit 1 tsp Mehl, oder evaporated Milch",
          "savings": "~$1.50"
        },
        {
          "forIngredientId": "chicken-breast",
          "swap": "boneless Hähnchen thighs, which are cheaper und stay juicier",
          "savings": "~$1.00"
        },
        {
          "forIngredientId": "parmesan",
          "swap": "any hard grating Käse oder pecorino du already have",
          "savings": "~$0.75"
        }
