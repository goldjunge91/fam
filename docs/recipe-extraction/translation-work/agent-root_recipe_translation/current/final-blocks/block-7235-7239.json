      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mayonnaise, Ketchup, Senf und einen Esslöffel fein gehackte Gewürzgurken zur Spezialsauce. Stelle sie kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Rinderhack mit gewürfelter Zwiebel, Salz, Pfeffer, Knoblauchpulver und Zwiebelpulver. Forme 8 lockere Kugeln von je etwa 2 oz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öle eine große Pfanne oder Grillplatte leicht ein und erhitze sie auf mittlerer bis hoher Stufe. Setze eine Hackfleischkugel auf eine Tortilla und drücke sie mit einem Pfannenwender fest bis an die Ränder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Fleischseite 2-3 Minuten, bis sich eine kräftige Kruste bildet. Wende vorsichtig und brate die Tortillaseite etwa 1 minute knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege eine Scheibe amerikanischen Käse auf das Fleisch. Lasse ihn 30 seconds schmelzen und setze den Taco auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege jeden Taco mit geschnittenem Salat, Gewürzgurkenscheiben und etwas Spezialsauce. Klappe ihn zusammen und serviere heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
