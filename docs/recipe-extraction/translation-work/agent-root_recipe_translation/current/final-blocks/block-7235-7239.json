      "steps": [
        {
          "position": 0,
          "text": "Halbiere jede Hähnchenbrust waagerecht, sodass 4 dünne Schnitzel entstehen. Tupfe sie trocken und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Mehl und Knoblauchpulver auf einem Teller. Wende jedes Schnitzel darin und schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl und 1 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze. Brate das Hähnchen je Seite 4-5 Minuten goldbraun und gar (165F Kerntemperatur), dann auf einen Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittlere Stufe und schmilz die übrigen 2 tablespoons Butter. Gib gehackten Knoblauch dazu und brate ihn 30-60 seconds duftend, aber ohne Bräunung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Hühnerbrühe dazu und löse die Bratrückstände. Rühre Sahne und italienische Kräuter ein. Lasse die Sauce 2-3 Minuten leicht eindicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und rühre Parmesan ein, bis die Sauce glatt und glänzend ist. Schmecke mit Salz, Pfeffer und Chiliflocken ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege Hähnchen samt Fleischsaft zurück in die Pfanne, löffle Sauce darüber und lasse es 1-2 Minuten köcheln. Garniere mit frischer Petersilie und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
