      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mayonnaise, Rotweinessig, Olivenöl, einen Schuss Pepperoncini-Lake, Oregano, Salz und Pfeffer in einer großen Schüssel zu einem cremigen Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Staple Schinken, Truthahn und Peperoni, rolle sie zusammen und schneide sie in Streifen. Gib sie mit Römersalat, roter Zwiebel, Tomate und geschnittenen Pepperoncini in die Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge alles, bis der Salat gleichmäßig glänzend überzogen ist. Rühre nach Wunsch Parmesan unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Halbiere die Hoagie-Brötchen längs, ohne sie ganz durchzuschneiden, und lege je 2 Scheiben Provolone hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle den gehackten Grinder-Salat großzügig in die Brötchen und drücke ihn leicht an, damit er zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Halbiere jedes Sandwich diagonal und serviere es sofort, solange das Brot knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
