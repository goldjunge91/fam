      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und koche die Linguine etwa 9 Minuten bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze währenddessen Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze und dünste gehackten Knoblauch und Chiliflocken 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Venusmuscheln in die Pfanne, gieße Weißwein dazu, decke sie ab und gare sie 3-4 Minuten, bis sie sich öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Garnelen hinzu und gare sie ohne Deckel 2 Minuten. Rühre dann zerdrückte Tomaten unter und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Pasta abtropfen und gib sie in die Pfanne. Vermenge sie vorsichtig mit Meeresfrüchten und Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer, garniere mit frischer Petersilie und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
