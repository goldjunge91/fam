          "position": 0,
          "text": "Tupfe das Steak trocken und würze beide Seiten großzügig mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze einen Grill oder eine Grillpfanne auf hoher Stufe, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grille das Steak pro Seite 5-6 Minuten für medium-rare und passe die Zeit je nach Dicke an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille währenddessen Jalapeños und Zwiebelscheiben 3-4 Minuten, bis sie leicht verkohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerdrücke gehackten Knoblauch mit Koriander, Limettensaft und Salz in einer kleinen Schüssel zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Steak vom Grill und lasse es 3 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide das Steak quer zur Faser in Streifen und richte es mit dem gegrillten Gemüse auf einem Teller an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib die Koriander-Knoblauch-Paste darauf und serviere es sofort mit warmen Tortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
