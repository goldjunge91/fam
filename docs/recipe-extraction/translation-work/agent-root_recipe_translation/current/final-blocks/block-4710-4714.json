      "steps": [
        {
          "position": 0,
          "text": "Koche die Ramen-Nudeln nach Packungsanweisung, lass sie abtropfen und spüle sie unter kaltem Wasser ab, bis sie gekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Sojasauce, Mirin, Reisessig und Wasser in einer kleinen Schüssel zu einer Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Gurke in feine Streifen und den Schinken in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche ein Ei 6-7 Minuten weich, kühle es in Eiswasser ab und schäle es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle zwei Schüsseln mit Eiswürfeln und lege die gekühlten Nudeln darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Gurke, Schinken und halbiertes Ei auf den Nudeln an, bestreue alles mit Sesam und serviere die Dip-Sauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
