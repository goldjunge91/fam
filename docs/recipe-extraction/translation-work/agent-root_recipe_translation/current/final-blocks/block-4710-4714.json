      "steps": [
        {
          "position": 0,
          "text": "Bestreiche eine Seite jeder Brotscheibe mit Dijon-Senf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege 2 Brotscheiben mit der Senfseite nach oben hin und belege sie mit Schinken und Käse. Lege die übrigen Brotscheiben mit der Senfseite nach unten darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 Esslöffel Butter in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Sandwiches in die Pfanne und brate sie 3-4 Minuten, bis die Unterseite goldbraun ist. Drücke sie leicht mit einem Pfannenwender an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende die Sandwiches vorsichtig und brate die andere Seite 2-3 Minuten, bis der Käse schmilzt und das Brot goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Sandwiches aus der Pfanne und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die restliche Butter in die Pfanne und brate die Eier darin 2-3 Minuten als Spiegeleier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege ein Spiegelei auf jedes Sandwich, würze mit Salz und Pfeffer und serviere sofort.",
