      "steps": [
        {
          "position": 0,
          "text": "Vermische Rinderhackfleisch, Semmelbrösel, Ei, die Hälfte der gehackten Zwiebel, gehackten Knoblauch, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme die Mischung zu 1-Zoll großen Bällchen und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf oder Schmortopf bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Fleischbällchen vorsichtig in das heiße Öl und bräune sie etwa 5 Minuten von allen Seiten an. Brate sie bei Bedarf portionsweise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Fleischbällchen heraus und stelle sie beiseite. Dünste die restliche gewürfelte Zwiebel 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Tomatensauce und Rinderbrühe dazu und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Fleischbällchen zurück in den Topf, reduziere die Hitze auf mittelniedrig, decke den Topf ab und lasse alles 20 Minuten köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis oder in einer Schüssel warmer Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
