      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425 °F vor und teile den Blumenkohl in Röschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke den Knoblauch fein. Verrühre Harissa-Paste, Olivenöl, Honig, Zitronensaft, Knoblauch, Salz und Kreuzkümmel in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende die Blumenkohlröschen in der Harissa-Mischung, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den marinierten Blumenkohl in einer Lage auf einem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste ihn 22–25 Minuten und wende ihn nach der Hälfte der Zeit, bis er goldbraun und an den Rändern knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Blumenkohl aus dem Ofen und bestreue ihn mit Sesam und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere ihn warm als Beilage oder mit Couscous oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
