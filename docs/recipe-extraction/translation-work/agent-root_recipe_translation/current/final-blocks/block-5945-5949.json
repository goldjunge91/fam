      "steps": [
        {
          "position": 0,
          "text": "Teile den Blumenkohl in kleine Röschen, schneide die Zwiebel in dünne Scheiben und hacke die grüne Chili fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einer großen Pfanne oder einem Wok bei mittelhoher Hitze. Gib die Kreuzkümmelsamen dazu und lasse sie 30 Sekunden brutzeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebelwürfel dazu und brate sie 2 Minuten weich. Füge Ingwer und grüne Chili hinzu und brate alles unter Rühren 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Blumenkohlröschen dazu und brate sie unter Rühren 3 Minuten, bis sie langsam weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreue den Blumenkohl mit Kurkuma, Chilipulver und Salz und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und gare den Blumenkohl bei mittlerer Hitze 8–10 Minuten. Rühre gelegentlich um, bis er weich und an den Rändern leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre kurz vor dem Servieren frischen Koriander und Zitronensaft unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
