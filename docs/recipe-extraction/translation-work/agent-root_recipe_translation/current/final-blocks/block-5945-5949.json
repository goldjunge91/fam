      "steps": [
        {
          "position": 0,
          "text": "Teile den Blumenkohl in mundgerechte Röschen und tupfe sie mit Küchenpapier gründlich trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Mehl, Speisestärke und Wasser zu einem dünnflüssigen Teig und überziehe jedes Röschen damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl in einem tiefen Topf oder Wok auf 350 °F. Frittiere den Blumenkohl vorsichtig portionsweise etwa 4 Minuten goldbraun und knusprig. Lasse ihn auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Sojasauce, Reisessig und Sriracha in einem kleinen Topf. Gib Knoblauch und Ingwer hinzu und lasse die Soße 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge den knusprigen Blumenkohl in einer großen Schüssel mit der Soße, bis er gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte den Blumenkohl an und garniere ihn vor dem Servieren mit Frühlingszwiebelringen und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
