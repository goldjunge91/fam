      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375 °F vor. Teile den Blumenkohl in Röschen, koche sie 5 Minuten in Salzwasser bissfest und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter in einem Topf bei mittlerer Hitze. Rühre das Mehl mit dem Schneebesen ein und gare die Mehlschwitze unter Rühren 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre nach und nach die Milch ein und lasse die Soße unter ständigem Rühren etwa 5 Minuten eindicken. Nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Gruyère, Salz, Pfeffer und Muskatnuss in die Soße, bis der Käse vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Blumenkohl in eine gebutterte Auflaufform und übergieße ihn mit der Käsesoße. Vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Panko-Semmelbrösel und Parmesan und verteile die Mischung gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Auflauf 25 Minuten, bis die Oberfläche goldbraun ist und die Soße am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse den Auflauf vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
