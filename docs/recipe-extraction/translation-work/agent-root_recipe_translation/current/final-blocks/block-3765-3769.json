      "steps": [
        {
          "position": 0,
          "text": "Erwärme Meeresfrüchtebrühe in einem separaten Topf und rühre Safranfäden ein, damit sie ihr Aroma abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Paella-Pfanne oder einem breiten flachen Topf bei mittlerer Hitze und dünste gewürfelte Zwiebel und gehackten Knoblauch 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Gib dann Reis hinzu und röste ihn unter Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße warme Safranbrühe hinzu und bringe alles zum Kochen. Rühre in der ersten Minute gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse alles ohne Deckel 15 Minuten köcheln, ohne umzurühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bette Fischfilets und Garnelen in den Reis, würze mit Salz und Pfeffer und gare alles weitere 8-10 Minuten, bis der Reis weich und die Meeresfrüchte gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd, decke sie ab und lasse das Gericht 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht direkt aus der Pfanne mit Meeresfrüchten und Reis zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
