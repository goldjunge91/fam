      "steps": [
        {
          "position": 0,
          "text": "Würze Schweinekoteletts mit Salz und Pfeffer und bräune sie in Olivenöl in einem großen Topf bei mittelhoher Hitze je Seite 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm die Koteletts heraus und stelle sie beiseite. Dünste gewürfelte Zwiebel und gehackten Knoblauch im selben Topf 4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche den Topf dann mit Weißwein ab und löse die Röststoffe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Koteletts zurück in den Topf und füge Brühe, Lorbeerblatt und Thymian hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, decke den Topf ab, reduziere die Hitze und lasse es 25-30 Minuten sanft köcheln, bis das Schweinefleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne das Lorbeerblatt und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Koteletts auf Servierteller und löffle die eingekochte Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
