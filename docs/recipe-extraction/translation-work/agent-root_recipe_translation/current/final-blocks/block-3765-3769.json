      "steps": [
        {
          "position": 0,
          "text": "Würfle Schweinefett fein und lasse es in einem großen Topf bei niedriger Hitze 10 Minuten aus. Entferne dann die Grieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste fein gehackte Zwiebel und Knoblauch im ausgelassenen Fett 5 Minuten weich und lasse die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Schweineblut in einer großen Schüssel glatt und vermische es mit der abgekühlten Zwiebelmischung, Reis oder Semmelbröseln, Pinienkernen, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spüle Naturdärme ab und binde ein Ende zu. Fülle die Därme vorsichtig mithilfe eines Trichters oder Wurstfüllers mit der Blutmischung und lasse am Ende 0.5 Zoll frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Binde die gefüllten Därme zu, stich sie mit einer Nadel ein, damit sie nicht platzen, und lasse sie mindestens 30 Minuten im Kühlschrank ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze einen großen Topf Wasser oder Brühe auf 160°F (70°C) und lege Botifarra negra vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pochiere sie bei dieser Temperatur (nicht kochen lassen) 30-40 Minuten, bis die Würste aufschwimmen und sich fest anfühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie heraus und lasse sie leicht abkühlen. Serviere sie in Scheiben oder ganz, nach Wunsch in der Pfanne knusprig gebraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
