      "steps": [
        {
          "position": 0,
          "text": "1. Kartoffeln vorbereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln mit Schale weich kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vollständig abkühlen lassen (am besten über Nacht), dann schälen und fein stampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2. Teig zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffelpüree, Mehl, Grieß und Salz in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mischung kneten, bis ein glatter, nicht klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "3. Šúĺlance formen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Teig in Portionen teilen und jede zu einer dünnen Rolle formen (etwa 1.5 cm Durchmesser).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "In 3 cm lange Stücke schneiden und zwischen den Handflächen zu kleinen Knödeln rollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "4. Knödel garen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Einen Topf mit Salzwasser zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Knödel portionsweise hineingeben und etwa 2–3 Minuten kochen, bis sie an die Oberfläche steigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Abgießen und in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "5. Topping zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
