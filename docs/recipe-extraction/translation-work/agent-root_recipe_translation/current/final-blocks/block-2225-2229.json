      "steps": [
        {
          "position": 0,
          "text": "Hähnchen mit Eiweiß überziehen:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen, Eiweiß, 1/2 Teelöffel koscheres Salz und Maisstärke in einer Schüssel vermengen. Rühren, bis das Hähnchen gleichmäßig überzogen ist. 15 Minuten bei Zimmertemperatur oder bis zu über Nacht im Kühlschrank ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Süß-saure Sauce zubereiten:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ananassaft, Essig, Ketchup, 1/2 Teelöffel koscheres Salz und braunen Zucker verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen bei starker Hitze pfannenrühren:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine große Pfanne oder einen Wok bei starker Hitze erhitzen, bis ein Wassertropfen sofort zischt und verdampft. 1 Esslöffel Speiseöl hineingießen und schwenken, sodass der Boden bedeckt ist. Die Pfanne muss sehr heiß sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hähnchen dazugeben und Stücke in einer Lage verteilen. 1 Minute unberührt braten, bis die Unterseiten gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenden und die andere Seite 1 Minute braten. Das Hähnchen sollte in der Mitte noch leicht rosa sein. Auf einen sauberen Teller geben und möglichst viel Öl in der Pfanne lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Paprika und Ingwer pfannenrühren:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Hitze auf mittlere Stufe reduzieren und den übrigen 1 Teelöffel Speiseöl dazugeben. Öl erhitzen und dann Paprikastücke sowie Ingwer hineingeben. 1 Minute braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Ananas, Sauce und anschließend das Hähnchen dazugeben:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Ananasstücke und süß-saure Sauce dazugeben. Hitze auf hohe Stufe erhöhen. Sobald die Sauce köchelt, Hähnchenstücke zurück in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "1 bis 2 Minuten köcheln lassen, bis das Hähnchen durchgegart ist. Die Garzeit hängt davon ab, wie dick das Hähnchen geschnitten wurde. Am besten ein Stück herausnehmen und aufschneiden. Ist es rosa, noch eine Minute weitergaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Abschmecken und servieren:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
