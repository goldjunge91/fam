      "steps": [
        {
          "position": 0,
          "text": "Nimm die Steaks 30 Minuten vor dem Braten aus dem Kühlschrank, damit sie Zimmertemperatur annehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe die Steaks mit Küchenpapier vollständig trocken und würze beide Seiten großzügig mit Meersalz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer gusseisernen Pfanne bei hoher Hitze, bis es gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Steaks für einen rosa Gargrad 4-5 Minuten pro Seite und bewege sie dabei möglichst nicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Butter, zerdrückten Knoblauch und Rosmarin in die Pfanne. Neige die Pfanne und übergieße die Steaks 2 Minuten lang mit der schäumenden Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Steaks auf einen vorgewärmten Teller und lasse sie vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
