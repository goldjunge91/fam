      "steps": [
        {
          "position": 0,
          "text": "Ritze die Schwarte des Schweinebauchs kreuzweise ein, ohne ins Fleisch zu schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe einen großen Topf Wasser zum Kochen und blanchiere den Schweinebauch 5 Minuten. Gieße ihn ab und spüle ihn mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasauce, Ingwer, Knoblauch, Honig, Reisessig, 1 cup Wasser und Sternanis in einem großen Topf oder Schmortopf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Schweinebauch mit der Schwarte nach oben hinein. Bringe die Flüssigkeit zum Kochen, reduziere dann die Hitze und lasse alles zugedeckt 90 Minuten schmoren, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Deckel ab, erhöhe die Hitze und koche die Sauce 10-15 Minuten ein, bis sie glänzend und sirupartig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den Schweinebauch auf ein Schneidebrett und lasse ihn 5 Minuten ruhen. Schneide ihn dann auf und richte ihn auf einer Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die übrige Sauce über den Schweinebauch und garniere ihn vor dem Servieren mit gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
