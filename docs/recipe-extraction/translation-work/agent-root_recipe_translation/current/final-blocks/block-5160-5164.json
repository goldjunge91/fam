      "steps": [
        {
          "position": 0,
          "text": "Schmilz die Butter in einem kleinen Topf und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle das Eigelb in einer hitzebeständigen Schüssel über leicht siedendem Wasser im Wasserbad etwa 3 Minuten, bis es hell und schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Träufle die warme Butter unter ständigem Rühren langsam zum Eigelb, bis die Sauce eindickt. Rühre Zitronensaft, Salz, weißen Pfeffer und Cayennepfeffer ein und nimm die Schüssel vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe den Lachs trocken, bestreiche ihn mit Olivenöl und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Grill auf mittlere bis hohe Hitze vor. Grille den Lachs mit der Hautseite nach oben 5-6 Minuten, wende ihn und grille die Hautseite 4-5 Minuten, bis er gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte den Lachs an, gib Sauce hollandaise darüber und garniere ihn mit frischem Dill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
