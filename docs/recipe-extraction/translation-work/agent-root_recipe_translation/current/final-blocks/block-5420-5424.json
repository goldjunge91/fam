      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 EL Öl in einer Pfanne bei mittlerer bis hoher Hitze, gib die Tortillachips dazu und rühre 1–2 Minuten um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Salsa Verde über die Chips und vermenge alles vorsichtig, bis die Chips überzogen und leicht weich, aber noch knusprig sind, etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Chilaquiles aus der Pfanne und halte sie auf einem Teller warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl in die Pfanne, schlage die Eier hinein und brate sie nach Wunsch. Würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme die Weizentortillas in einer trockenen Pfanne je Seite 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Chilaquiles auf den Tortillas und gib je 2 Spiegeleier und einen Klecks saure Sahne darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue alles mit Queso fresco und Koriander, rolle die Tortillas wie Burritos auf und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
