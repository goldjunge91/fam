      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebel, hacke Jalapeño und Knoblauch und dünste alles in Öl bei mittlerer Hitze in einer Pfanne an, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Dosentomaten samt Saft in die Pfanne und lass alles 5 Minuten köcheln. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die schwarzen Bohnen separat in einem Topf und die Tortillas in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Eier in einer separaten Pfanne als Spiegeleier, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile schwarze Bohnen mittig auf den Tortillas und belege sie mit je einem Spiegelei und der Hälfte des Käses.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Ranchero-Sauce über die Eier und bestreue alles mit dem restlichen Käse und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Falte die Tortillas wie Burritos und serviere sie sofort mit zusätzlicher Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
