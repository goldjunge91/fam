      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Garnelen trocken, lass die Schalen dran und vermische sie in einer Schüssel mit Salz und Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Knoblauch in Scheiben und halbiere getrocknete Chilis. Entferne nach Wunsch die Kerne, wenn du es milder magst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok bei hoher Hitze. Gib Knoblauch und getrocknete Chilis dazu und rühre 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Garnelen in einer Lage hinein und gare sie ohne Rühren 3 Minuten, bis sie auf einer Seite zu bräunen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende sie und gare weitere 2-3 Minuten, bis die Schalen vollständig orange und die Garnelen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Presse kurz vor dem Servieren Limettensaft darüber und bestreue das Gericht mit schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
