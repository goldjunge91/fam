      "steps": [
        {
          "position": 0,
          "text": "Zerdrücke Krabbenschalen und lass sie 20 Minuten in Hühnerbrühe köcheln, damit sie Geschmack abgeben. Seihe die Brühe dann durch ein Seihtuch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Topf und dünste gehackten Knoblauch 30 Sekunden an. Gib Tomatenmark dazu und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die abgeseihte Krabbenbrühe hinein und bringe sie zum Kochen. Gib Garnelen dazu und lass sie 5 Minuten köcheln, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze die Suppe mit Fischsauce und Limettensaft und nimm sie dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Reisfadennudeln nach Packungsanweisung, gieße sie ab und verteile sie auf Servierschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe heiße Suppe über die Nudeln und serviere sie mit frischen Kräutern und Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
