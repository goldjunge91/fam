      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Rindfleisch und Schweinefleisch 3 Minuten in kochendem Wasser. Gieße es ab und spüle es mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerdrücke Zitronengrasstängel und hacke Knoblauch. Vermische beides mit 1 EL Garnelenpaste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe Rinderbrühe in einem großen Topf zum Kochen. Gib blanchiertes Fleisch, Zitronengras und die Knoblauch-Garnelenpaste-Mischung dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass alles 60 Minuten köcheln, bis das Fleisch zart ist. Seihe die Brühe ab und würze sie mit Fischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerfasere das gegarte Fleisch, verteile es auf Servierschalen und gieße heiße Brühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche Reisfadennudeln nach Packungsanweisung, gieße sie ab und gib sie in die Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere dazu Limettenspalten und frische Kräuter, die nach Geschmack hinzugefügt werden können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
