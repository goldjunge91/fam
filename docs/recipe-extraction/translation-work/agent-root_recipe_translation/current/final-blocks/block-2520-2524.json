      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, Tapiokamehl, Salz und Wasser in einer Schüssel glatt und lass den Teig dann 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Schweinebauch und Garnelen klein und würze sie mit Fischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 EL Öl in einer kleinen Pfanne bei mittlerer Hitze und brate das Schweinefleisch etwa 5 Minuten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Garnelen dazu und gare sie 2 Minuten, bis sie rosa werden. Füge dann gehackte Frühlingszwiebeln hinzu und nimm die Pfanne vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze die restlichen 2 EL Öl in einer flachen Pfanne bei mittelhoher Hitze und gieße 0.25 cup Teig in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile sofort 2 EL Schweinefleisch-Garnelen-Füllung darauf und gare alles 3-4 Minuten, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schiebe den Pfannkuchen auf einen Teller und serviere ihn warm mit Fischsauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
