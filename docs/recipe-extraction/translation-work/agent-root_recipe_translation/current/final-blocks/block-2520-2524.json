      "steps": [
        {
          "position": 0,
          "text": "Töte Krabben möglichst schonend, entferne den oberen Panzer und die Innereien und schneide jede Krabbe in Viertel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch und Chili. Vermische Tamarindenpaste, Fischsauce, Zucker und Wasser in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze. Brate Knoblauch und Chili 30 Sekunden unter Rühren an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Krabbenstücke dazu und brate sie 3 Minuten unter Rühren, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Tamarindensauce hinein und reduziere die Hitze auf mittlere Stufe. Decke die Pfanne ab und gare alles 8-10 Minuten, bis die Krabben durchgegart und die Sauce glänzend ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
