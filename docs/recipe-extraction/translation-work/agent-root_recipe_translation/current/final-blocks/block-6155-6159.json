      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in mittelgroße Stücke und mariniere es 15 Minuten in Joghurt, Ingwer-Knoblauch-Paste, Chilipulver und Kurkuma.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide 3 Zwiebeln in dünne Scheiben und 1 Zwiebel in Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche den Basmatireis 20 Minuten in Wasser ein und gieße ihn anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche Wasser mit Lorbeerblättern, Zimt, Kardamom und Nelken in einem großen Topf auf. Gib den abgetropften Reis mit Salz dazu und gare ihn, bis er zu 70% gar ist. Gieße ihn anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze 2 tbsp Ghee in einem schweren Topf und brate die Zwiebelscheiben dunkelgolden an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze das restliche Ghee im selben Topf und brate das marinierte Hähnchen bei hoher Hitze unter Rühren 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue die Hälfte der gebratenen Zwiebeln über das Hähnchen und verteile den halbgegarten Reis gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue die restlichen gebratenen Zwiebeln darüber und beträufle den Reis mit Kokosmilch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Decke den Topf fest mit Folie und anschließend mit einem Deckel ab. Gare alles bei hoher Hitze 2 Minuten, bis Dampf entsteht, reduziere dann die Hitze und gare es weitere 20-25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schalte die Hitze aus und lass den Topf zugedeckt 5 Minuten ruhen. Lockere den Reis vorsichtig mit einer Gabel auf und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
