      "steps": [
        {
          "position": 0,
          "text": "Koche die Eier 10 Minuten hart, schäle sie und halbiere sie anschließend.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Koriander- und Kreuzkümmelsamen 1 Minute in einer trockenen Pfanne an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die gerösteten Gewürze mit Knoblauch, Ingwer, grünen Chilischoten und 3 tbsp Kokosmilch zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Kokosöl in einer Pfanne und dünste gehackte Zwiebeln goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Gewürzpaste dazu und gare sie unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Kurkuma, Chilipulver und Curryblätter ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die restliche Kokosmilch hinein und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib die Eierhälften vorsichtig dazu und lass sie 3-4 Minuten heiß werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Würze mit Salz und serviere das Curry heiß mit Reis oder Dosa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
