      "steps": [
        {
          "position": 0,
          "text": "Säubere die Krabbe, viertle sie und spüle sie gründlich unter kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Koriandersamen, Kreuzkümmelsamen und schwarze Pfefferkörner 1 Minute in einer trockenen Pfanne an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mahle die gerösteten Gewürze mit Knoblauch, Ingwer und 2 tbsp Wasser zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Kokosöl in einer großen Pfanne, gib gehackte Zwiebeln dazu und brate sie goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib grüne Chilischoten und Curryblätter dazu und rühre 30 Sekunden um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gemahlene Gewürzpaste dazu und gare sie unter häufigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Chilipulver und Kurkumapulver ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib die Krabbenstücke dazu und gare sie bei hoher Hitze 3 Minuten. Rühre dabei um, damit sie mit Masala überzogen werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gieße Wasser dazu, decke die Pfanne ab und lass alles 12-15 Minuten köcheln, bis die Krabbe gar und das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Würze mit Salz und serviere das Gericht heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
