      "steps": [
        {
          "position": 0,
          "text": "Preheat Ofen zu 325°F und vermengen Rindfleisch mit Mehl, Salz, und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brown Rindfleisch in batches in Butter bei mittlerer bis hoher Hitze, beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sauté gehackt Zwiebeln bis soft, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "zurückgeben Rindfleisch zu Topf, hinzufügen Tomate Paste, und garen 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "gießen in Brühe und ale, hinzufügen bay leaf und Thymian, dann bring zu boil.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Cover und köcheln in Ofen für 60 Minuten, stirring halfway.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "hinzufügen carrots und potatoes schneiden in chunks, weiter cooking 35-40 Minuten bis weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Transfer Rindfleisch Mischung zu pie Gericht, abkühlen 15 Minuten, dann cover mit puff pastry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Brush pastry mit verquirlt Ei und backen at 400°F für 25-30 Minuten bis goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
