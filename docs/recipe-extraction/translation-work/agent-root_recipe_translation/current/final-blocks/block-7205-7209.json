      "steps": [
        {
          "position": 0,
          "text": "erhitzen lard und Wasser together bis steaming, dann mischen in Mehl und Salz zu form warm Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "kneten bis glatt, cover, und lassen rest 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "mischen gemahlen Schweinefleisch mit fein gehackt Zwiebel, Salbei, und Pfeffer für Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Divide Teig in 4 parts, formen je in ein ball, und hollow out zu form pie shells.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fill je shell mit Schweinefleisch Mischung und seal top mit Teig, crimping edges.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brush mit verquirlt Ei und backen at 375°F für 45 Minuten bis goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "erhitzen Brühe und gießen through steam hole in je pie after cooling 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "vollständig abkühlen lassen before serving.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
