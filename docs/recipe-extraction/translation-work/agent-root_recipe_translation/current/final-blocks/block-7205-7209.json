      "steps": [
        {
          "position": 0,
          "text": "mischen gemahlen Schweinefleisch, breadcrumbs, Zwiebel, Salbei, Ei, Salz, und Pfeffer in einer großen Schüssel bis well combined.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "formen der Mischung in ein loaf und wrap mit caul fat oder drape bacon strips über der top.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "erhitzen Öl in ein roasting Pfanne und brown der haslet auf all sides für 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "gießen Hähnchen Brühe around der haslet und roast at 350°F für 60 Minuten bis es vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "entfernen aus Ofen und lassen rest für 10 Minuten before slicing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
