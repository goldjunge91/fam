      "steps": [
        {
          "position": 0,
          "text": "Weiche Safranfäden 10 Minuten in warmer Milch ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einer Pfanne mit schwerem Boden bei mittlerer Hitze und gib Milchpulver unter ständigem Rühren dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Kondensmilch hinein und rühre weitere 5-7 Minuten, bis die Masse eindickt und sich vom Pfannenboden löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Safran samt Milch und Kardamompulver hinzu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und lasse die Masse 5 Minuten abkühlen, bis sie sich anfassen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Befeuchte deine Hände leicht und forme kleine runde Kugeln von etwa 1 Zoll Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere jedes Peda mit gehackten Pistazien und Mandeln und drücke sie leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bewahre die Pedas bis zu 1 Woche in einem luftdichten Behälter im Kühlschrank auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
