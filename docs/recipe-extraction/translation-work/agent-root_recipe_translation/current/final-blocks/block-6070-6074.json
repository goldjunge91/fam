      "steps": [
        {
          "position": 0,
          "text": "Bringe Sojasauce, dunkle Sojasauce, Shaoxing-Wein, Zucker, Ingwer, Frühlingszwiebeln, Sternanis und Wasser zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse die Brühe 5 Minuten köcheln, damit sich die Aromen verbinden, und lasse sie vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe die Fischfilets trocken, lege sie in eine flache Form und gieße die abgekühlte Brühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Form ab und mariniere den Fisch mindestens 4 Stunden oder über Nacht im Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem Wok, bis es raucht, und lege den marinierten Fisch vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate den Fisch auf jeder Seite 2-3 Minuten, bis die Außenseite karamellisiert und rauchig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege den Fisch auf eine Servierplatte, beträufle ihn mit Marinade und serviere ihn bei Zimmertemperatur oder gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
