      ],
      "steps": [
        {
          "position": 0,
          "text": "In einer großen Schüssel 1/2 Tasse Buchweizenmehl, 2/3 Tasse Weizenmehl, 1/2 TL Salz und 1 TL Hefe verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In der Mitte eine Mulde formen und 1 Tasse warme Milch hineingießen. Glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schüssel abdecken und den Teig etwa 1 Stunde gehen lassen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig verfeinern und ruhen lassen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 EL geschmolzene Butter und 1 Eigelb unter den Teig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einer separaten Schüssel 1 Eiweiß steif, aber nicht trocken schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eischnee vorsichtig unter den Teig heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schüssel abdecken und den Teig 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Blini ausbacken",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Butter in einer großen beschichteten Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Teig in Klecksen von Vierteldollargröße in die Pfanne geben. Nicht zu viele auf einmal hineingeben. Etwa 1 Minute backen, bis sich Bläschen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Wenden und weitere 30 Sekunden backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Fertige Blini auf einen Teller geben und mit einem sauberen Küchentuch abdecken, damit sie warm bleiben. Mehr Butter in die Pfanne geben und mit dem restlichen Teig wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
