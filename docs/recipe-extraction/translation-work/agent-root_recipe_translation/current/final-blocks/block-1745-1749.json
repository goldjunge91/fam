      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 180C Umluft/200C Ober-/Unterhitze/Gasstufe 6 vorheizen. Sechs Friand- oder Muffinförmchen großzügig einfetten. Butter schmelzen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Puderzucker und Mehl in eine Schüssel sieben. Mandeln hinzufügen und alles mit den Fingern vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eiweiß in einer zweiten Schüssel schaumig und weich schlagen. In die trockenen Zutaten eine Mulde drücken. Eiweiß und Zitronenschale hineingeben und Butter leicht unterrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig auf die Förmchen verteilen. Ein großer Servierlöffel eignet sich gut dafür. Eine Handvoll Blaubeeren auf jeden Kuchen streuen und 15–20 Minuten backen, bis sie sich fest anfühlen und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In den Förmchen 5 Minuten abkühlen lassen, dann herauslösen und auf einem Gitter abkühlen lassen. Zum Servieren leicht mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
