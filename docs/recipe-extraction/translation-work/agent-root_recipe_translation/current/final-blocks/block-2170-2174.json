      "steps": [
        {
          "position": 0,
          "text": "Tofu vorbereiten:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tofu abtropfen lassen und vorsichtig aus der Verpackung auf einen großen Teller geben. Tofu quer in Scheiben von 1/2 inch schneiden. Mit den Handflächen die Scheiben vorsichtig seitlich auseinanderdrücken, sodass sie fächerförmig auf dem Teller liegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnieren und servieren:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sojasauce und Sesamsauce darüberträufeln. Mit Frühlingszwiebeln und Sesamsamen garnieren und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reste fest abdecken und bis zu 2 Tage im Kühlschrank aufbewahren. Du kannst sie direkt kalt aus dem Kühlschrank genießen oder in 30-Sekunden-Intervallen in der Mikrowelle erwärmen, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
