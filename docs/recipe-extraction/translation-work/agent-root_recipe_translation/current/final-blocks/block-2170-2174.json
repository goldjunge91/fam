      ],
      "steps": [
        {
          "position": 0,
          "text": "Ergibt 2 Portionen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Roste auf obere und mittlere Schiene setzen und den Ofen auf 450 Grad vorheizen. Alle Zutaten waschen und trocknen. Süßkartoffeln in 1/2-inch-Würfel schneiden. Auf einem Backblech mit etwas Öl, Salz und Pfeffer vermengen. Auf der oberen Schiene 12 Minuten rösten (die Zucchini kommt später dazu).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Währenddessen Apfel halbieren, entkernen und in dünne Halbmonde schneiden. Knoblauch schälen und fein hacken. Zitrone vierteln. Zucchini putzen, längs halbieren und quer in 1/2-inch-dicke Halbmonde schneiden. Auf einem zweiten Backblech mit etwas Öl und einer Prise Salz und Pfeffer vermengen. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinefleisch mit Küchenpapier trocken tupfen und rundherum mit Salz und Pfeffer würzen. Etwas Öl in einer großen Pfanne bei mittelhoher Hitze erhitzen. Schweinefleisch hineingeben und auf jeder Seite 4–5 Minuten braten, bis es gebräunt und durchgegart ist. Herd ausschalten und Fleisch auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald die Süßkartoffeln 12 Minuten geröstet wurden, das Backblech mit Zucchini auf die mittlere Schiene stellen. Weiter rösten, bis beide Gemüsesorten gebräunt und weich sind, weitere 12–15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Währenddessen 1 TBSP Butter (2 TBSP für 4 Portionen) in der für das Schweinefleisch verwendeten Pfanne bei mittelhoher Hitze schmelzen. Apfel dazugeben und mit Salz und Pfeffer würzen. Unter Ablösen der gebräunten Stücke vom Pfannenboden 2–3 Minuten garen, bis der Apfel etwas weich ist. Knoblauch dazugeben und 30 Sekunden braten, bis er duftet. 1/z Tasse Wasser (3/4 Tasse für 4 Portionen), Brühkonzentrat und 11/2 TL Zucker (3 TL für 4 Portionen) hinzufügen. Unter Rühren 3–5 Minuten garen, bis die Sauce eingedickt und der Apfel sehr weich ist. Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pfanne mit Apfel vom Herd nehmen, 1 TBSP Butter (2 TBSP für 4 Portionen) und einen Spritzer Zitronensaft einrühren. Schweinefleisch, Zucchini und Süßkartoffeln auf Teller verteilen. Schweinefleisch mit glasierter Apfelsauce bedecken. Zucchini mit einem Spritzer Zitronensaft abrunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
