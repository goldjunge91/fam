      "steps": [
        {
          "position": 0,
          "text": "Verrühre Gochujang, Sojasauce, braunen Zucker, Sesamöl und gehackten Knoblauch in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche die Schweinebauchstreifen mit der Marinade und stelle sie mindestens 1 Stunde kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine gusseiserne Pfanne bei mittelhoher Hitze und brate den marinierten Schweinebauch 4-5 Minuten pro Seite, bis er karamellisiert und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittelniedrige Stufe und gare das Fleisch ohne Deckel weitere 30-40 Minuten, bis es zart ist und das Fett ausgelassen wurde. Dabei gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Bolillo-Brötchen längs auf und bestreiche beide Seiten mit Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege jedes Brötchen mit dem gegarten Schweinebauch, eingelegten Jalapeños und geschnittener Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort servieren. Nach Wunsch die Brötchen auf der Grillplatte mit dem Bratfett erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
