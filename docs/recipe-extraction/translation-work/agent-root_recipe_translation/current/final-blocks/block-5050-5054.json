      "steps": [
        {
          "position": 0,
          "text": "Mische gezupftes Hähnchenfleisch mit Gochujang, Sojasauce, Sesamöl und Frühlingszwiebeln in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Tortillas aus und verteile die Hähnchenmischung darauf. Gib jeweils eine kleine Handvoll Cheddar dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle jede Tortilla fest auf, klappe die Seiten ein und lege sie mit der Naht nach unten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Pflanzenöl in einer tiefen Pfanne auf eine Tiefe von 2 Zoll und bringe es auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Flautas portionsweise vorsichtig ins heiße Öl und frittiere sie 2-3 Minuten pro Seite, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die fertigen Flautas auf Küchenpapier, damit überschüssiges Öl abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie mit einer Dip-Sauce aus saurer Sahne und Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
