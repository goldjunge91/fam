      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine große Pfanne bei mittelhoher Hitze. Brate das Rinderhackfleisch etwa 5 Minuten an und zerkrümle es dabei, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und gewürfelte Zwiebel dazu und gare alles 3 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre schwarze Bohnensauce, Sojasauce und braunen Zucker gründlich ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gewürfelte Kartoffel dazu und gare alles zugedeckt bei mittlerer Hitze 8-10 Minuten, bis die Kartoffel weich ist. Dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den gekochten Reis auf vier Schüsseln und forme jeweils in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den geriebenen Salat als Unterlage auf den Reis in jeder Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die schwarze Bohnensauce mit Rindfleisch in die Mitte und garniere die Schüsseln mit knusprigen Tortillastreifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
