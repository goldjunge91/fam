          "position": 0,
          "text": "Vermische Weizenmehl und Reismehl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Kokosmilch, zerdrückte Banane, Jaggery, Kardamom und Salz dazu und verquirle alles zu einem glatten Teig.",
