      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Kokosöl in einer großen Pfanne und brate die geschnittenen Zwiebeln darin tief goldbraun. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Öl die Rindfleischwürfel bei starker Hitze 3-4 Minuten, bis sie von allen Seiten gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre rotes Chilipulver, Kurkuma und Korianderpulver ein, sodass alle Fleischstücke gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser dazu, reduziere die Hitze und lasse alles zugedeckt 35-40 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald das Rindfleisch gar ist, erhöhe die Hitze und gib die beiseitegestellten Röstzwiebeln und Curryblätter dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre 3-5 Minuten ununterbrochen, bis die Flüssigkeit verdampft ist und das Fleisch eine karamellisierte Kruste bekommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz ab und serviere das Gericht heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
