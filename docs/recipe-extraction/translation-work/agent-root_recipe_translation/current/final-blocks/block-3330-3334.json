      "steps": [
        {
          "position": 0,
          "text": "Weiche die Venusmuscheln 30 Minuten in Salzwasser ein und spüle sie anschließend gründlich unter kaltem fließendem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle die fermentierten schwarzen Bohnen ab und zerdrücke sie mit gehacktem Knoblauch und Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Pflanzenöl in einem großen Wok oder einer Pfanne bei starker Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Bohnenmischung dazu und brate sie 30 Sekunden unter Rühren, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Venusmuscheln, Sojasauce, Reiswein und Wasser in den Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Wok ab und gare alles 5-7 Minuten. Schüttle die Pfanne gelegentlich, bis sich die Muscheln öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wirf geschlossene Muscheln weg, beträufle die übrigen mit Sesamöl und garniere sie mit geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort in einer Schüssel mit dem Kochsud.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
