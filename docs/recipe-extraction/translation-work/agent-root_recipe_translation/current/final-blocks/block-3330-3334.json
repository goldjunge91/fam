      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz, Zucker und Kurkumapulver in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 3 tbsp Öl zu den trockenen Zutaten und verreibe es mit den Fingerspitzen, bis die Mischung Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach Wasser dazu und knete einen glatten, weichen Teig. Decke ihn ab und lasse ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 10-12 gleich große Kugeln und rolle jede zu einem dünnen Kreis von etwa 5-6 inches Durchmesser aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F. Ein Teigstück sollte darin sofort brutzeln und an die Oberfläche steigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die ausgerollten Teigfladen vorsichtig ins heiße Öl und frittiere sie etwa 20 Sekunden pro Seite, bis sie aufgehen und hellgolden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus, lasse sie auf Küchenpapier abtropfen und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie mit Curry oder Dal oder genieße sie pur mit Jaggery.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
