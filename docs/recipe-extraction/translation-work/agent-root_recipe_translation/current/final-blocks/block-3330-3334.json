      "steps": [
        {
          "position": 0,
          "text": "Weiche Urad Dal 4 Stunden in Wasser ein und gieße es anschließend vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle das eingeweichte Urad Dal mit Wasser in einer Küchenmaschine oder einem Nassmahlwerk zu einem glatten, luftigen Teig. Er sollte dickflüssig und nicht dünn sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle den Teig in eine Schüssel und lasse ihn 10 Minuten ruhen, damit er etwas aufgehen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackte Zwiebel, grüne Chilischoten, Ingwer, Curryblätter, Salz und schwarzen Pfeffer dazu und rühre alles vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Befeuchte deine Hand leicht mit Wasser, nimm eine kleine Portion Teig und forme daraus einen Ring, indem du den Daumen durch die Mitte drückst und das Loch vorsichtig vergrößerst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die geformten Vada vorsichtig ins heiße Öl und frittiere jeweils 4-5 Stück etwa 2-3 Minuten, bis sie rundherum goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus, lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Sambar oder Kokos-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
