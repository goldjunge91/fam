      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 220C/425F/Gasstufe 7 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne und bräune das Rindfleisch rundum. (Möglicherweise musst du portionsweise arbeiten.) Beiseitestellen und dann die Nieren in derselben Pfanne von beiden Seiten anbräunen. Gib Zwiebeln hinzu und gare sie 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch zurück in die Pfanne, streue Mehl darüber und wende das Fleisch und die Zwiebeln darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Brühe in die Pfanne, rühre gut um und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse alles 1½ hours ohne Deckel köcheln. Wenn zu viel Flüssigkeit verdampft, gib mehr Brühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd. Gib Salz, Pfeffer und Worcestershire-Soße hinzu und lasse alles vollständig abkühlen. Fülle die Fleischmischung in eine Pieform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rolle den Teig 5mm/¼in dick und 5cm/2in größer als die verwendete Form aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hebe den Teig mit einem Nudelholz an und lege ihn über die Pieform. Schneide den Rand zu und drücke ihn mit Fingern und Daumen wellig fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bestreiche die Oberfläche mit verquirltem Ei und backe die Pie 30-40 Minuten goldbraun und aufgegangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Mit cremigem Kartoffelstampf und gedämpftem Gemüse servieren, um die Bratensoße aufzunehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
