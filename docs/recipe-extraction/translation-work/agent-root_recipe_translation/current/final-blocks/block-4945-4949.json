      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 350°F vor und backe den Tortenboden 10 Minuten, bis er leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Kondensmilch, Zitronensaft, Zitronenschale und 4 Eigelb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Maisstärke und 2 Esslöffel Wasser in einer kleinen Schüssel glatt und rühre die Mischung unter die Zitronenfüllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Füllung in den teilweise vorgebackenen Boden und backe die Torte 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage währenddessen 4 Eiweiß mit Weinsteinpulver schaumig. Gib nach und nach Zucker dazu und schlage die Masse steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Torte aus dem Ofen und verstreiche das Baiser auf der heißen Füllung. Ziehe es bis an den Rand des Bodens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Torte weitere 10-12 Minuten, bis das Baiser goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf einem Kuchengitter 1 Stunde abkühlen und stelle sie dann vor dem Servieren mindestens 3 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
