      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor und fette eine runde 9-Zoll-Auflaufform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile die Kirschen gleichmäßig in der vorbereiteten Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Mehl, Milch, Eier, Zucker, Vanille und Salz etwa 1 Minute im Mixer, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den Teig über die Kirschen und backe das Clafoutis 30-35 Minuten goldbraun, bis ein in die Mitte gestecktes Messer sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Clafoutis aus dem Ofen und lasse es 10 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestäube es großzügig mit Puderzucker und serviere es warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
