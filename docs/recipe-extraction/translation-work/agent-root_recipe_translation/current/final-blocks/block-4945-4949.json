      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und dünste gehackten Knoblauch und Schalotten etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Wasser dazu und bringe es zum Kochen. Rühre Tamarindenpaste und Fischsauce ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ananasstücke und geviertelte Tomaten dazu und lasse alles 8 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Okraschoten und Fischfilets dazu und gare sie 5-7 Minuten, bis der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Probiere die Suppe und schmecke sie bei Bedarf mit weiterer Fischsauce oder Tamarindenpaste ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Suppe in eine Servierschüssel und garniere sie vor dem Servieren mit frischem Dill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
