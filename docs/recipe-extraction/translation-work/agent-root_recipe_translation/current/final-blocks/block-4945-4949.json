      "steps": [
        {
          "position": 0,
          "text": "Erhitze Sahne und Milch mit Vanille, bis sie dampfen, aber nicht kochen. Lasse die Mischung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eigelb mit 0.33 Tasse Zucker und Salz etwa 2 Minuten, bis die Masse hell ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die heiße Sahnemischung unter ständigem Rühren langsam zu den Eigelben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Creme durch ein feines Sieb und verteile die Beeren auf 4 Förmchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Creme über die Beeren in die Förmchen. Stelle diese in ein Wasserbad, dessen heißes Wasser bis zur halben Höhe der Förmchen reicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Creme bei 325°F 20-25 Minuten, bis die Ränder fest sind, die Mitte aber noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Förmchen aus dem Ofen und dem Wasserbad und stelle sie mindestens 4 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue die Oberfläche vor dem Servieren mit dem restlichen Zucker und karamellisiere ihn mit einem Brenner goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
