      "steps": [
        {
          "position": 0,
          "text": "Knoblauch, Petersilie, Oregano, Kreuzkümmel, Olivenöl, Essig, Salz und Pfeffer zu einer Chimichurri-Sauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hälfte der Chimichurri-Sauce zum Servieren beiseitestellen. Die übrige Sauce auf beide Seiten von Rippchen und Steaks streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen Holzkohlegrill auf mittlere Hitze vorbereiten oder eine Grillpfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die kurzen Rippchen zuerst 25–30 Minuten grillen, alle 5 Minuten wenden und mit Chimichurri bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Steaks dazulegen und für medium-rare je Seite 8–10 Minuten grillen, dabei häufig mit Sauce bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Fleisch auf ein Schneidebrett legen und vor dem Servieren 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der beiseitegestellten Chimichurri-Sauce und knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
