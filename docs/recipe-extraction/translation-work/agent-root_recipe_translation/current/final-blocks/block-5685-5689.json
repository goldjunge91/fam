      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in mundgerechte Stücke schneiden und 15 Minuten in Joghurt, Garam Masala, Kreuzkümmel, Paprika, der Hälfte des Knoblauchs und Salz marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und das Hähnchen etwa 8–10 Minuten goldbraun braten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne Zwiebel, restlichen Knoblauch und Ingwer etwa 3 Minuten anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatensauce einrühren und 5 Minuten köcheln lassen, damit sie etwas eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen zurück in die Pfanne geben, Sahne hinzufügen und 10–12 Minuten köcheln lassen, bis das Fleisch gar und die Sauce dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und mit Salz und Pfeffer nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nach Wunsch mit frischem Basmati-Reis, Koriander und Limette servieren.",
