      "steps": [
        {
          "position": 0,
          "text": "Einen Marshmallow auf einen Röststock oder eine lange Gabel stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Marshmallow 4–6 Zoll über mittelheiße Lagerfeuerkohlen halten und langsam drehen, damit er gleichmäßig bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2–3 Minuten rösten, bis die Außenseite goldbraun und das Innere weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ein Stück Schokolade halbieren und auf einen Graham-Cracker legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den gerösteten Marshmallow vom Stock auf die Schokolade schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem weiteren Graham-Cracker zu einem Sandwich zusammensetzen und leicht andrücken, damit der Marshmallow die Schokolade schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Essen 10 Sekunden abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
