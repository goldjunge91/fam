      ],
      "steps": [
        {
          "position": 0,
          "text": "Schwarzen Pfeffer, Salz und Knoblauchpulver zu einer Trockenwürzung vermischen und die ganze Rinderbrust großzügig damit einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Rinderbrust mit der Fettseite nach oben auf ein großes Stück Folie in einen Bräter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderbrühe, Essig, braunen Zucker und Raucharoma vermischen und neben das Fleisch gießen, nicht darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Folie fest um das Fleisch wickeln, vollständig verschließen und in einen auf 325°F vorgeheizten Ofen stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Etwa 14–15 Stunden garen (ungefähr 2 Stunden pro Pfund), bis das Fleisch gabelzart ist. Nach 12 Stunden durch die Folie prüfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen und 30 Minuten in der Folie ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vorsichtig auspacken, quer zur Faser in 0.5 Zoll dicke Scheiben schneiden und mit dem Bratensaft servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
