      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl, Zucker, Salz und Hefe in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Milch und Wasser hinzufügen und zu einem groben Teig verrühren. 5 Minuten kneten, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in Folie wickeln und 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kalte Butter zwischen Frischhaltefolie zu einem 6 × 8 Zoll großen Rechteck klopfen. Sie soll formbar, aber kühl bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig zu einem 12 × 8 Zoll großen Rechteck ausrollen. Butter mittig platzieren, Teig darüberfalten und Ränder verschließen. 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teig auf 12 × 24 Zoll ausrollen, in Drittel falten, um 90 Grad drehen und erneut ausrollen und falten. Dies insgesamt 3-mal wiederholen und zwischen den Faltungen jeweils 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nach der letzten Faltung über Nacht kühlen. Dann Dreiecke ausschneiden, jeweils zu Hörnchen aufrollen und auf Backpapier legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Croissants bei Raumtemperatur 1.5–2 Stunden gehen lassen, bis sie aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit verquirltem Ei bestreichen und bei 400°F 18–20 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
