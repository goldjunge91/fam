      "steps": [
        {
          "position": 0,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fügen Sie die Reis-A-Roni-Nudelmischung hinzu und rösten Sie sie unter häufigem Rühren 2 Minuten lang, bis sie leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe und Wasser dazugeben und umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringen Sie die Mischung zum Kochen, reduzieren Sie dann die Hitze auf eine niedrige Stufe und decken Sie sie mit einem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Etwa 17 Minuten köcheln lassen, bis der Reis fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gefrorene Erbsen und Karotten unterrühren und weitere 3 Minuten ohne Deckel garen, bis das Gemüse durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, mit Salz und Pfeffer würzen und vor dem Servieren 1 Minute stehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
