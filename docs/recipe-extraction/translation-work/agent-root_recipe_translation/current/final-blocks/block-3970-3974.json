      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in kleine Würfel schneiden und in Olivenöl knusprig und goldbraun braten. Herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf das Rinderhackfleisch mit gehackter Zwiebel und Knoblauch anbraten und dabei zerteilen, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Harissapaste, Salz und Pfeffer einrühren und 2 Minuten weitergaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die gebratenen Kartoffeln zurück in den Topf geben und gut mit dem Fleisch vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3 Mulden in die Mischung drücken und jeweils ein Ei hineinschlagen. Abdecken und 4–5 Minuten garen, bis die Eier gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit frischem Koriander bestreuen und direkt aus dem Topf heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
