          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reisfadennudeln nach Packungsanleitung kochen und auf Servierschüsseln verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Fischbrühe-Mischung mit einer Schöpfkelle über die Nudeln in den Schüsseln geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit gebratenen Schalotten und frischem Koriander garnieren und Limettenspalten dazu servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
