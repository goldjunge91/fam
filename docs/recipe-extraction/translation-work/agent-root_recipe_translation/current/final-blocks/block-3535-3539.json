      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermengen, dann 1/4 cup Öl hinzufügen und mit den Fingerspitzen einarbeiten, bis die Mischung wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach warmes Wasser hinzufügen, bis ein Teig entsteht; kurz kneten und abgedeckt 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 tbsp Öl in einer Pfanne erhitzen und Schweinehack mit Knoblauch, Zwiebel und Kartoffel etwa 8 Minuten garen, bis alles durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Currypulver und Sojasauce einrühren, weitere 2 Minuten garen und die Füllung etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in 8 gleiche Stücke teilen und jedes zwischen Frischhaltefolie dünn ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2 tbsp Füllung auf eine Hälfte jedes Teigkreises geben, zuklappen und die Ränder mit einer Gabel zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das übrige Öl in einer tiefen Pfanne erhitzen und Curry-Puffs je Seite etwa 3 Minuten goldbraun frittieren; dann auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
