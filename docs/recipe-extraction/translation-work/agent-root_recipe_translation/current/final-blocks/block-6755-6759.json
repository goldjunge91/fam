      "steps": [
        {
          "position": 0,
          "text": "Weizenkörner, Kichererbsen und Spalterbsen 2 Stunden in Wasser einweichen, dann abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lammfleisch in kleine Würfel schneiden und Zwiebeln würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ghee in einem großen, schweren Topf erhitzen und die Zwiebeln darin goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lammstücke dazugeben und von allen Seiten 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie eingeweichte Körner, Kichererbsen und Spalterbsen mit 8 Tassen Wasser in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und abgedeckt 2 Stunden köcheln lassen, dabei gelegentlich umrühren, um ein Anhaften zu verhindern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fügen Sie Kurkuma, Salz und Pfeffer hinzu und kochen Sie dann 30 Minuten lang weiter, bis die Mischung sehr dick und breiartig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In den letzten Schritten ständig umrühren, um eine glatte, cremige Konsistenz zu erreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
