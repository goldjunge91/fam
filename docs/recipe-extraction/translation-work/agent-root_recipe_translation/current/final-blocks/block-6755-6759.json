      "steps": [
        {
          "position": 0,
          "text": "Bereiten Sie eine Salzlake vor, indem Sie Salz und Zucker in kochendem Wasser mit Lorbeerblättern, Pfefferkörnern und Senfkörnern auflösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kühlen Sie die Sole vollständig auf Raumtemperatur ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spülen Sie den Lachsrogen vorsichtig unter kaltem Wasser ab, um alle Rückstände zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie den Rogen zusammen mit einer zerdrückten Knoblauchzehe in ein sterilisiertes Glasgefäß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gießen Sie die abgekühlte Salzlake über den Lachsrogen und achten Sie darauf, dass dieser vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verschließen Sie das Glas und stellen Sie es vor dem Servieren 24–48 Stunden lang in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekühlt auf geröstetem Brot oder mit Sauerrahm als Frühstück oder Vorspeise servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
