      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch und Markknochen in einen großen Topf legen und mit kaltem Wasser 2 inches bedecken. Zum Kochen bringen und 5 Minuten den Schaum abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbierte Zwiebel, Karotten, Sellerie, Lauch, Lorbeerblatt und Thymian dazugeben. Hitze reduzieren und 60 Minuten sanft köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gemüse und Rindfleisch auf einen Teller geben und Brühe zurück in den Topf abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geschälte Kartoffeln dazugeben und Brühe erneut zum Köcheln bringen. 15–20 Minuten garen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rindfleisch und übriges Gemüse zum Durchwärmen zurück in den Topf geben. Mit Salz und Pfeffer würzen und in Schalen mit Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
