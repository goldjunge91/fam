      "steps": [
        {
          "position": 0,
          "text": "Kalbfleisch in 2-inch-Stücke schneiden, 5 Minuten in kochendem Salzwasser blanchieren, dann abgießen und abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem großen Topf bei mittlerer Hitze schmelzen. Kalbfleisch, Perlzwiebeln und Karotten dazugeben und 5 Minuten garen, ohne sie zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl über das Fleisch streuen, 1 Minute rühren, dann Brühe und Lorbeerblatt hinzufügen. Zum Köcheln bringen und abgedeckt 35–40 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pilze dazugeben und weitere 5 Minuten köcheln lassen, bis alle Zutaten weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eigelb und Sahne in einer Schüssel verquirlen. Unter Rühren langsam eine Kelle heiße Brühe dazugeben, dann Mischung unter ständigem Rühren vom Herd genommen in den Topf gießen. Abschmecken und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
