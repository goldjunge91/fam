      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in 1/4-inch-Pommes schneiden, 15 Minuten in kaltem Wasser einweichen und anschließend gründlich trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf auf 325°F erhitzen und Kartoffeln portionsweise 5–7 Minuten frittieren, bis sie weich, aber noch nicht gebräunt sind. Auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Steaks auf beiden Seiten großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine gusseiserne Pfanne bei starker Hitze erhitzen, bis sie raucht. Steaks für medium-rare auf jeder Seite 3–4 Minuten scharf anbraten. Dann mit Butter, Knoblauch und Rosmarin 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öltemperatur auf 375°F erhöhen und Kartoffeln weitere 2–3 Minuten goldbraun und knusprig frittieren. Salzen und mit Steak sowie Zitrone servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
