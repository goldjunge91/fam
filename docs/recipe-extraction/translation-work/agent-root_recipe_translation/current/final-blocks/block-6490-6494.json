      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und blanchiere die Kohlblätter 3-4 Minuten, bis sie biegsam sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Zwiebel in Butter an und vermenge sie dann mit Rinderhackfleisch, gekochtem Reis, Ei, Paprikapulver, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 2-3 Esslöffel Füllung auf jedes Kohlblatt und rolle es fest auf. Klappe dabei die Seiten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe in eine Auflaufform und lege die Kohlrouladen mit der Naht nach unten hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge Tomatensauce mit 1/2 cup Wasser und gieße sie über die Rouladen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form mit Folie ab und backe die Rouladen bei 350°F 50-60 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne die Folie und backe alles weitere 10 Minuten, bis die Rouladen leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
