      "steps": [
        {
          "position": 0,
          "text": "Klopfe die Rindersteaks zwischen Frischhaltefolie mit einem Fleischklopfer dünn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche jedes Steak mit Senf und belege es mittig mit Speck, Zwiebel und einer Gewürzgurke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle die Steaks fest auf und fixiere sie mit Zahnstochern oder Küchengarn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einem großen Topf und brate die Rouladen pro Seite 3 Minuten rundherum braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreue die Rouladen mit Mehl und wende sie darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Rotwein und Rinderbrühe dazu. Decke den Topf ab und lass alles 45-50 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Rouladen heraus und decke sie locker mit Folie ab, damit sie warm bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass die Sauce 10 Minuten einkochen, gieße sie dann über die Rouladen und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
