      "steps": [
        {
          "position": 0,
          "text": "Vermenge Hefe, warme Milch und 1 tbsp Zucker. Lass die Mischung 5 Minuten stehen, bis sie schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mehl, den restlichen Zucker, Salz, Eier und weiche Butter zur Hefemischung. Knete alles 8-10 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe Rosinen unter den Teig und lass ihn in einer geölten, abgedeckten Schüssel 60 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke die Luft aus dem Teig und teile ihn in drei gleich lange Stränge. Rolle jeden Strang auf 16-inch Länge aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Flechte die drei Stränge auf einem mit Backpapier ausgelegten Backblech zusammen und lass den Zopf 30 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche den Zopf mit verquirltem Eigelb, bestreue ihn mit gehobelten Mandeln und backe ihn bei 375°F 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass den Zopf vor dem Anschneiden und Servieren warm oder bei Zimmertemperatur 10 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
