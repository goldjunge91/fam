      "steps": [
        {
          "position": 0,
          "text": "Löse Hefe in warmer Milch mit 1 Esslöffel Zucker auf und lass sie 5 Minuten stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mehl, Salz und den restlichen Zucker in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hefemischung, Ei, geschmolzene Butter und Vanille zur Mehlmischung. Knete alles 8-10 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Schüssel ab und lass den Teig an einem warmen Ort 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke die Luft aus dem Teig und verteile ihn in einer gefetteten 9x13 inch Backform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form ab und lass den Teig weitere 30-40 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Kuchen bei 375°F 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verrühre Puderzucker und Wasser und träufle den Guss über den warmen Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
