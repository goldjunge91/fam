      "steps": [
        {
          "position": 0,
          "text": "Vermenge Traubensaft, Wasser, Zucker, Zimtstange und Gewürznelken in einem Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass die Suppe ohne Deckel 10 Minuten köcheln, damit die Gewürze ziehen. Nimm dann Zimtstange und Nelken heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Maisstärke mit kaltem Wasser zu einer glatten Mischung und rühre sie in die köchelnde Traubensuppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Suppe unter ständigem Rühren 2-3 Minuten, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd und rühre Zitronensaft ein, um die Süße auszubalancieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Suppe warm in Schalen und garniere sie nach Wunsch mit einer dünnen Zimtstange oder einer kleinen Apfelscheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
