      "steps": [
        {
          "position": 0,
          "text": "Die gewürfelte Zwiebel in Olivenöl bei mittlerer Hitze 5 Minuten anschwitzen. Knoblauch, Kreuzkümmel und Paprikapulver dazugeben und 1 Minute mitbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Linsen und 2.5 Tassen Wasser dazugeben. Aufkochen lassen, dann die Hitze reduzieren, abdecken und 20–22 Minuten köcheln lassen, bis die Linsen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Spinat unter die heißen Linsen rühren, bis er zusammenfällt. Zitronensaft darübergeben und mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier pochieren: In einem kleinen Topf Wasser sanft köcheln lassen. Das Wasser in einen Strudel rühren, die Eier hineingleiten lassen und 3 Minuten garen. Mit einer Schaumkelle herausheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Linsen auf zwei Schüsseln verteilen und jeweils mit 2 pochierten Eiern belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
