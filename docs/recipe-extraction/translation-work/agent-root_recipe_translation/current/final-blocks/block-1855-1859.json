        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200 °C Umluft/220 °C/425 °F/Gasstufe 7 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wenn du keine gewürfelte Lammschulter gekauft hast, schneide die Schulter oder Keule in große Stücke und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Große Stücke gehacktes Lammfleisch auf einem roten Schneidebrett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite die Ölmarinade zu:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische 80ml Olivenöl mit Knoblauchpüree, getrocknetem Tomatenpüree, schwarzem Pfeffer und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Olivenöl, getrocknetes Tomatenpüree, Knoblauchpüree und schwarzer Pfeffer in einer silbernen Schüssel zu einer kroatischen Peka-Marinade vermischt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Kartoffeln und Gemüse in eine große Auflaufform mit Deckel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gehacktes Gemüse wie rote Zwiebel, Zucchini, Kartoffeln und rote Paprika in einer gusseisernen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege die gewürfelte Lammschulter auf das Gemüse und gieße Marinade und Wein darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Lammstücke mit getrockneter-Tomaten-Ölsauce auf gehackter roter Zwiebel, Aubergine, Zucchini und Kartoffeln in einer gusseisernen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib Rosmarin, Thymian und Salbei darauf und versuche, die Kräuter obenauf zu halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "So kannst du die Kräuterstängel nach dem Garen leicht entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Lammstücke mit getrockneter-Tomaten-Ölsauce, bedeckt mit Thymian, Rosmarin und Salbei, auf gehackter roter Zwiebel, Aubergine, Zucchini und Kartoffeln in einer gusseisernen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Setze den Deckel auf die Auflaufform und gare das Gericht 1hr 30 minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
