      "steps": [
        {
          "position": 0,
          "text": "Brate den Ingwer in reichlich Öl, bis er goldbraun und leicht knusprig ist. Stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Fisch in Streifen und wende ihn in einer sehr dünnen Schicht Tempuramehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Frittiere den Fisch in reichlich Öl, bis er goldbraun und knusprig ist. Du kannst dasselbe Öl verwenden, in dem du den Ingwer gebraten hast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerdrücke den Knoblauch und hacke ihn fein. Hacke die Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die fermentierten Sojabohnen in einem Sieb abtropfen. Wenn du gesalzene Bohnen in sehr salziger Lake verwendest, spüle sie vor der Zugabe mit Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib einen Esslöffel Öl in eine tiefe Pfanne oder einen großen Topf und brate den Knoblauch leicht goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Sojabohnen dazu und brate sie einige Minuten unter Rühren an. Wenn sie sehr salzig sind, füge ¼- ½ Esslöffel Zucker hinzu, um den Geschmack auszugleichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Wasser dazu und brate alles eine Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rühre kurz vor dem Servieren den gebratenen Ingwer, die Frühlingszwiebel und den knusprigen Fisch unter. Serviere das Gericht mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
