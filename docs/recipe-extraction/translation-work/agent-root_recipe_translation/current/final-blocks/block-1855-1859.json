      "steps": [
        {
          "position": 0,
          "text": "Lege die rohen Hähnchenbrüste in den Schongarer. Gieße die ganze Flasche Salatdressing darüber. Streue die übrigen Zutaten darauf und vermische sie mit einem Löffel leicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Schongarer mit dem Deckel ab und gare das Hähnchen 4 Stunden auf hoher Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm alle Hähnchenbrüste aus dem Schongarer und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerpflücke die Hähnchenbrüste und gib sie in eine Glasschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Großteil der Flüssigkeit über das zerpflückte Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "FÜR DIE TACOS:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bereite die Guacamole-Sauce zu, indem du Avocado und grüne Salsa vermischst. Streiche die Mischung durch ein Sieb, bis sie glatt ist, und fülle sie in eine Quetschflasche. Schneide bei Bedarf die Öffnung im Verschluss der Flasche etwas größer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bereite die Sauerrahmsauce zu, indem du saure Sahne und Milch zu einer flüssigeren Sauce verrührst. Fülle sie in eine Quetschflasche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Fülle in einer 9x 13 großen Glasauflaufform alle 12+ Tacos mit einer Schicht Bohnenmus, gegartem Hähnchen und geriebenem Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Backe die Tacos bei 450 für 10–15 Minuten, bis der Käse geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Belege die Tacos nach dem Herausnehmen aus dem Ofen mit geschnittenen Kirschtomaten, Jalapeño und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Gib zum Schluss etwas Guacamole und saure Sahne darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
