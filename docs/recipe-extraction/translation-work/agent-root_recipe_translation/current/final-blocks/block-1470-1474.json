    {
      "externalId": "waivy:mfr-med-mussels-white-wine",
      "slug": "mfr-med-mussels-white-wine",
      "title": "Miesmuscheln in Weißwein und Knoblauch (Moules Marinières)",
      "instructions": "Der französische Klassiker: Frische Miesmuscheln öffnen sich dampfgegart in einer duftenden Brühe aus Knoblauch, Schalotten, Weißwein und frischem Thymian. Eines der schnellsten, eindrucksvollsten und günstigsten Meeresfrüchtegerichte, serviert mit knusprigem Brot zum Auftunken der Brühe.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 10,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Miesmuscheln sind die günstigsten Schalentiere und kosten oft 3 Dollar pro Pfund.",
        "Garnelen dienen hier als einfacher frischer Ersatz. Mit beiden gelingt die Zubereitung gleich gut.",
        "Das Brot ist unverzichtbar: Die Brühe ist das Beste an diesem Gericht."
      ],
      "substitutions": [
        {
          "forIngredientId": "shrimp",
          "swap": "Frische oder tiefgekühlte Miesmuscheln, die authentische Wahl"
        },
        {
          "forIngredientId": "thyme-fresh",
          "swap": "Getrockneter Thymian, davon die halbe Menge verwenden"
        }
      ],
