      "steps": [
        {
          "position": 0,
          "text": "Brate die in Scheiben geschnittene Schalotte und den Knoblauch bei mittlerer Hitze 3 Minuten in Olivenöl an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib frischen Thymian und Chiliflocken dazu. Füge die geputzten Muscheln und einen großzügigen Schuss Weißwein oder Brühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Topf sofort zu und dämpfe die Muscheln bei starker Hitze 4–5 Minuten, bis sie sich alle geöffnet haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wirf geschlossene Muscheln weg. Rühre Butter, Zitronensaft und Petersilie unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Muscheln im Topf mit knusprigem Brot zum Auftunken der Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
