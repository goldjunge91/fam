      "steps": [
        {
          "position": 0,
          "text": "Püriere für die Marinade Knoblauch, Orangensaft, Essig, Kreuzkümmel, Paprika, Chilipulver und eine Prise Achiote oder zusätzliches geräuchertes Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Hähnchen in dünne Scheiben und mariniere es mindestens 1 Stunde, idealerweise über Nacht. Gib auch Ananasstücke dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das Fleisch portionsweise bei starker Hitze an. Verteile es in einer dünnen Schicht und überfülle die Pfanne nicht, damit Röstaromen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die Tortillas. Fülle sie mit Fleisch, Ananasstücken, gewürfelter weißer Zwiebel und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Presse Limettensaft über jeden Taco. Serviere die Tacos mit Salsa Verde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
