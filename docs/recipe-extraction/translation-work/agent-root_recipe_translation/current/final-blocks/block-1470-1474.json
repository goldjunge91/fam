          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle die Brühe als Consommé-Dipsauce beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tauche die Tortillas in den warmen Consommé, fülle sie mit zerpflücktem Fleisch und Käse und klappe sie zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die getunkten Tacos in einer heißen, trockenen Pfanne von beiden Seiten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere sie mit Consommé zum Dippen, gehackter Zwiebel und Koriander.",
          "timerMinutes": null,
