      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer Tajine und bräune die Lammstücke portionsweise. Stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln, gehackten Knoblauch und Ingwer in den Topf und gare alles, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Zimt und Kreuzkümmel ein und gib dann das Lamm mit Rinderbrühe zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Topf ab und lasse alles 45 Minuten köcheln. Gib dann Backpflaumen und Honig hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles weitere 15 Minuten köcheln, bis das Lamm sehr zart und die Backpflaumen prall sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
