      "steps": [
        {
          "position": 0,
          "text": "Schneide das Fladenbrot in Dreiecke und röste es bei 375°F 8-10 Minuten im Ofen, bis es knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Kichererbsen ab, spüle sie ab und bewahre 0.5 Tasse Flüssigkeit auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Kichererbsen, Tahini, Zitronensaft, gehackten Knoblauch, Salz und die aufgehobene Kichererbsenflüssigkeit glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den Hummus auf dem Boden einer Servierschale und forme in der Mitte eine flache Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Joghurt in die Mulde und beträufle alles mit Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Pinienkerne 2 Minuten in einer trockenen Pfanne goldbraun und streue sie dann über den Joghurt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue alles mit Paprikapulver, umgib es mit gerösteten Fladenbrotchips und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
