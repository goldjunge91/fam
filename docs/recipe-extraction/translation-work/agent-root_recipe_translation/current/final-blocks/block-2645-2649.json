      "steps": [
        {
          "position": 0,
          "text": "Schneide Aubergine und Kartoffeln in 0.5 Zoll dicke Scheiben und brate sie in Olivenöl goldbraun. Stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Hähnchenschenkel mit Salz, Pfeffer und Piment und bräune sie in derselben Pfanne 5 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Zwiebel in Scheiben und brate sie goldbraun. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Pinienkerne etwa 2 Minuten in einer trockenen Pfanne, bis sie duften, und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spüle den Reis ab, gib ihn in die Pfanne und rühre 2 Minuten, damit er mit Öl überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Hühnerbrühe hinzu und bringe alles zum Kochen. Reduziere dann die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte die gebratene Aubergine und Kartoffeln auf den Reis und lege das Hähnchen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf ab und lasse alles 25 Minuten köcheln, bis der Reis weich ist und die Flüssigkeit aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse das Gericht 5 Minuten ruhen und stürze es dann auf eine große Platte, sodass der Reis unten und Gemüse und Hähnchen oben liegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
