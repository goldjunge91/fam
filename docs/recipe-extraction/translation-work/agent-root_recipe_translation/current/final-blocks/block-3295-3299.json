          "images": []
        },
        {
          "position": 3,
          "text": "Gekochten Reis hinzufügen und gut vermengen, dabei Klumpen zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tamarindenwasser über den Reis gießen und 2-3 Minuten gründlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
