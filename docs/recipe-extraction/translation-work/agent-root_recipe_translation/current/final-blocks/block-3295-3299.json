      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln dünn schneiden und in Öl goldbraun sowie knusprig frittieren; abtropfen lassen und die Hälfte zum Garnieren beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen 30 Minuten mit Joghurt, Ingwer-Knoblauch-Paste, der Hälfte der gebratenen Zwiebeln, Chili, Koriander, Minze, Biryani-Gewürz und Salz marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Safran in warmer Milch einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser mit ganzen Gewürzen und Salz kochen, Basmatireis hinzufügen und garen, bis er zu 70% gekocht ist; gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einem Topf mit schwerem Boden die Hälfte des marinierten Hähnchens schichten, dann die Hälfte des Reises, danach das restliche Hähnchen und schließlich den übrigen Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Safranmilch, beiseitegelegte gebratene Zwiebeln sowie restlichen Koriander und Minze darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Topf dicht mit Folie abdecken, den Deckel daraufsetzen und bei starker Hitze 2 Minuten erhitzen, bis sich Dampf bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hitze reduzieren und 25-30 Minuten garen, ohne den Deckel zu öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Hitze ausschalten und 5 Minuten ruhen lassen, dann vorsichtig mit einer Gabel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
