      "steps": [
        {
          "position": 0,
          "text": "Ofen auf 425°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischen Sie Vollkornmehl, Allzweckmehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in die Mehlmischung einreiben, bis Semmelbrösel entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nach und nach Buttermilch hinzufügen und umrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf einer bemehlten Arbeitsfläche kurz durchkneten und dann einen runden Laib formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf ein Backblech legen und die Oberseite mit einem Messer kreuzweise einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "25–30 Minuten backen, bis es goldbraun ist und beim Klopfen hohl klingt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
