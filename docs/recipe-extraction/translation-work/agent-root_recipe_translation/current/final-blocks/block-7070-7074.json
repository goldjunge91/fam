      "steps": [
        {
          "position": 0,
          "text": "Mehl, Hefe und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Honig und Wasser hinzufügen und rühren, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abdecken und 45 Minuten gehen lassen, bis die Masse geschwollen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 6 gleich große Stücke teilen und jedes zu einer Kugel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In die Mitte jeder Teigkugel ein Loch drücken und den Teig zu einem Bagel mit einer 2 Zoll großen Öffnung formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bagels auf Backpapier legen und 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Ofen auf 425 °F vorheizen und einen großen Topf Wasser zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bagels auf jeder Seite 1–2 Minuten kochen, bis sie schwimmen und leicht aufgehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Auf ein Backblech legen, mit verquirltem Ei bestreichen, mit Kernen bestreuen und 20–25 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
