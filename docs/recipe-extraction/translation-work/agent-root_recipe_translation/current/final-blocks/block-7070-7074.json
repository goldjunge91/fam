        },
        {
          "position": 4,
          "text": "Gießen Sie Guinness und Rinderbrühe hinzu und kratzen Sie die gebräunten Stücke vom Boden ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Rindfleisch wieder in den Topf geben, Thymian hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 45 Minuten kochen lassen, dann Kartoffeln und Karotten hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Ohne Deckel weitere 30–40 Minuten köcheln lassen, bis das Gemüse zart ist und das Rindfleisch auseinanderfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit Salz und Pfeffer abschmecken und heiß servieren.",
          "timerMinutes": null,
