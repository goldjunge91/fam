      "steps": [
        {
          "position": 0,
          "text": "Teig ausrollen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Puderzucker und bestäube damit die Arbeitsfläche. Rolle den Blätterteig zu einem Rechteck von 45 x 30cm aus. Rolle ihn der Länge nach zu einer langen Wurst auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in Scheiben schneiden",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide den Teig in 24 Scheiben von etwa 1-2cm Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jedes Teigstück ausrollen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle jede Scheibe leicht mit dem Nudelholz aus, sodass sie in 2 x 12-fach beschichtete Muffinformen passt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Teig in die Form drücken",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Drücke die Teigkreise in die Formen und forme dünne Böden. Stelle sie bis zur Verwendung kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Aromasirup zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Heize den Ofen auf 220C/Umluft 200C/Gasstufe 7 vor. Koche für den Zuckersirup Zucker, 200ml Wasser, Zitronenschale und Zimtstange auf. Reduziere die Flüssigkeit, bis sie sirupartig ist, lass sie abkühlen und entferne dann Zimt und Zitrone. Verquirle Eier, Eigelbe und Maismehl in einem anderen großen Topf glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Creme zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Erhitze Milch und Vanillesamen in einem separaten Topf bis kurz vor dem Kochen. Gieße die heiße Milch nach und nach über Eier und Maismehl und gare alles bei niedriger Hitze unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Sirup in die Creme geben",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Gib den abgekühlten Zuckersirup zur Creme und verquirle alles, bis die Creme leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
