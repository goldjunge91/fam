          "position": 2,
          "text": "Nasse und trockene Zutaten nur so lange vermengen, bis sie gerade verbunden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geriebenen Käse vorsichtig unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen.",
