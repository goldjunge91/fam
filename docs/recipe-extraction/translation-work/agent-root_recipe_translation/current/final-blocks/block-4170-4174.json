      "steps": [
        {
          "position": 0,
          "text": "Rinderbrust in einen großen Topf legen, mit Wasser bedecken, Salz und Lorbeerblätter hinzufügen und 45 Minuten kochen, bis sie sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fleisch herausnehmen, leicht abkühlen lassen und mit zwei Gabeln in dünne Fasern zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem anderen Topf erhitzen und gehackten Knoblauch, gewürfelte Zwiebel und Paprika 4 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatensauce, Kreuzkümmel und Pfeffer hinzufügen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerpflücktes Rindfleisch und 1 Tasse Rinderbrühe zur Sauce geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ohne Deckel 15–20 Minuten köcheln lassen und gelegentlich umrühren, bis sich die Aromen verbinden und die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und heiß mit Reis oder Pupusas servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
