      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und das Hähnchen mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen auf beiden Seiten jeweils 5 Minuten anbräunen, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf gehackten Knoblauch, gewürfelte Zwiebel und Paprika 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatensauce und Kreuzkümmel hinzufügen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen zurück in den Topf geben und Brühe sowie gewürfelte Kartoffeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 25–30 Minuten köcheln lassen, bis das Hähnchen durchgegart und die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren abschmecken und bei Bedarf nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
