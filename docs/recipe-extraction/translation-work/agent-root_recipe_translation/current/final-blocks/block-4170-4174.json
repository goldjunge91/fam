      "steps": [
        {
          "position": 0,
          "text": "Rinderbrust von allen Seiten großzügig mit Salz, Pfeffer und Kreuzkümmel würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen, schweren Topf bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Rinderbrust von allen Seiten scharf anbraten, bis sich eine dunkelbraune Karamellisierung bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fleisch herausnehmen und beiseitestellen. Gewürfelte Zwiebeln und gehackten Knoblauch goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fleisch zurück in den Topf geben und mit Sojasauce sowie Worcestershiresauce übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gebräunten Reste vom Topfboden lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rinderbrühe und Tomatenmark hinzufügen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fest abdecken und im Ofen bei 325 °F 1.5–2 Stunden schmoren, bis das Fleisch sehr zart ist. Nach der Hälfte der Zeit wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Aus dem Ofen nehmen, Fleisch zerpflücken oder aufschneiden und mit der Sauce aus dem Topf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
