      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Rinderrippchen 5 Minuten in kochendem Wasser. Gieße sie ab und spüle sie gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasoße, braunen Zucker, Sesamöl, gehackten Knoblauch, Ingwer und geriebene Birne in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die blanchierten Rippchen in einen Topf und gieße die Marinadenmischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 2 Tassen Wasser oder Rinderbrühe hinzu und bringe alles bei mittlerer bis hoher Hitze zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse die Rippchen 60-70 Minuten köcheln, bis sie zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gelegentlich umrühren und bei Bedarf mehr Brühe hinzugeben, damit die Rippchen teilweise bedeckt bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn die Rippchen gabelzart sind, erhöhe die Hitze, damit die Soße leicht eindickt.",
