          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zucchini und Tofu hinzu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falls du Muscheln oder Garnelen verwendest, gib sie jetzt dazu und gare sie 3-5 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre rote Chiliflocken ein und passe die Würzung bei Bedarf mit zusätzlicher Doenjang-Paste an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schalte die Hitze aus und träufle Sesamöl über den Eintopf.",
          "timerMinutes": null,
