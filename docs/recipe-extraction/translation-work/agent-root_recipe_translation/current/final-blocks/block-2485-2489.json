      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Spinat 2 Minuten in kochendem Salzwasser, gieße ihn ab und püriere ihn mit 0.25 Tasse Wasser glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer großen Pfanne und gib Kreuzkümmelsamen hinzu. Lasse sie 10 Sekunden aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel hinzu und gare sie etwa 4 Minuten weich. Füge dann Ingwer-Knoblauch-Paste hinzu und brate sie 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Tomate hinzu und gare sie 2 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Spinatpüree und 0.75 Tasse Wasser hinein. Bringe alles zum Köcheln und gare es 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Garam Masala und Salz hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge gewürfelten Paneer und Sahne oder Joghurt vorsichtig hinzu. Rühre behutsam, damit die Paneerwürfel nicht zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse das Curry 5 Minuten köcheln, ohne es aufzukochen, damit der Paneer zart bleibt. Probiere es, passe die Würzung an und serviere es mit Naan oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
