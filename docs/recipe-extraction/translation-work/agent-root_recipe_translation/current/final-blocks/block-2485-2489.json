      "steps": [
        {
          "position": 0,
          "text": "Bereite Zuckersirup zu: Vermische Zucker und 0.5 Tasse Wasser in einem Topf, bringe alles zum Kochen und lasse es 5 Minuten köcheln. Gib dann zerstoßenen Kardamom hinzu und lasse den Sirup vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und schneide das Brot in 2-Zoll große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Frittiere die Brotwürfel 1-2 Minuten pro Seite im heißen Öl, bis sie dunkelgoldbraun und knusprig sind. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Kondensmilch, Schlagsahne und 0.5 Tasse Milch in einer Schüssel. Gib 1 Esslöffel dieser Mischung zu den Safranfäden und lasse sie 5 Minuten einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Safranmilch zur Sahnemischung und rühre geriebenes Khoya ein, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tauche jedes frittierte Brotstück 2 Sekunden in den abgekühlten Sirup und lege es sofort auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die cremige Malai-Mischung (aus Kondensmilch und Sahne) über die Brotstücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Großzügig mit geschnittenen Pistazien und Mandeln garnieren und vor dem kalten Servieren 15 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
