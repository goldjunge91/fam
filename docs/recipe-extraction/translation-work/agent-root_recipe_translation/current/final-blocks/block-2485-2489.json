      "steps": [
        {
          "position": 0,
          "text": "Bringe 4 Tassen Wasser oder Brühe in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel und Knoblauch hinzu und gare sie 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Löse Doenjang-Paste in einer kleinen Schüssel mit 1/4 Tasse heißer Brühe auf und gib sie dann zurück in den Topf.",
