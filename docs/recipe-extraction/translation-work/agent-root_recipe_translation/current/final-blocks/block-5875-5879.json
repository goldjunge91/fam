      "steps": [
        {
          "position": 0,
          "text": "Schneide die Auberginen längs in 0.25-inch dicke Scheiben, salze sie großzügig und lasse sie 20 Minuten Wasser ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe die Auberginenscheiben mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle das Ei in einer flachen Schüssel und gib das Mehl in eine zweite. Wende die Auberginenscheiben erst im Mehl, dann im Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne und brate die Auberginenscheiben portionsweise etwa 3 Minuten pro Seite goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile eine dünne Schicht Marinara-Soße auf dem Boden einer 9x13 Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte Aubergine, Soße, gezupften Mozzarella und Parmesan in die Form. Wiederhole die Schichten, bis alle Zutaten aufgebraucht sind. Schließe mit Soße und Parmesan ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Auflauf bei 375°F 25-30 Minuten, bis er blubbert und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere ihn vor dem Servieren mit frischem Basilikum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
