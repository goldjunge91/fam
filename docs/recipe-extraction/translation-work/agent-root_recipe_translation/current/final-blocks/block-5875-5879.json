      "steps": [
        {
          "position": 0,
          "text": "Schneide die Pilze in Stücke und die Kartoffeln in 1-inch große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebeln und hacke den Knoblauch. Dünste beides in Olivenöl in einem großen Topf bei mittlerer Hitze 5 Minuten, bis es weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Paprikapulver und Tomatenmark ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Pilze und Kartoffeln dazu, vermenge alles gut und gare es 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Brühe an und gib Lorbeerblatt und Kümmelsamen hinzu. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 40 Minuten köcheln, bis Kartoffeln und Pilze sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre kurz vor dem Servieren saure Sahne ein und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gulasch in Schüsseln mit knusprigem Brot oder Eiernudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
