      "steps": [
        {
          "position": 0,
          "text": "Schneide die Aubergine in mundgerechte Würfel, weiche sie 10 Minuten in Salzwasser ein, gieße sie ab und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Zwiebel, Knoblauch und grüne Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Wok oder einer Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackte Zwiebel, Knoblauch und grüne Chili dazu und dünste alles 2 Minuten an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Auberginenstücke dazu und brate sie unter Rühren 8-10 Minuten, bis sie weich werden und leicht bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue Kurkuma, rotes Chilipulver, Korianderpulver und Salz darüber und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare das Gericht weitere 3-4 Minuten, bis die Aubergine weich ist und die Gewürze duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischem Koriander und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
