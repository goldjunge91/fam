      "steps": [
        {
          "position": 0,
          "text": "Zucchini waschen und die Enden abschneiden. Mit einem Apfelausstecher oder einem kleinen Messer die Mitte aushöhlen und das herausgelöste Fruchtfleisch beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne erhitzen und Zwiebel sowie Knoblauch etwa 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch dazugeben und etwa 5 Minuten anbraten, dabei zerkleinern. Dann den Reis hinzufügen und 1 Minute umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das beiseitegelegte Zucchinifruchtfleisch, Salz, Pfeffer und Kreuzkümmel unterrühren, 2 Minuten garen und vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede ausgehöhlte Zucchini mit einem kleinen Löffel fest mit der Fleisch-Reis-Mischung füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gefüllten Zucchini in einen Topf legen, die Dosentomaten und das Wasser darum gießen und die Flüssigkeit mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren, den Topf abdecken und 35-40 Minuten köcheln lassen, bis die Zucchini weich, aber nicht zerfallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit frischer Petersilie garnieren und heiß servieren, dabei die Tomatenbrühe darüberlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
