      "steps": [
        {
          "position": 0,
          "text": "Geröstete Paprika aus dem Glas abtropfen lassen und vorsichtig mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Jeweils eine Käsescheibe vorsichtig in eine Paprika stecken und die Paprika vollständig darum einschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Mehl in eine flache Schüssel geben und die Eier in einer anderen flachen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede gefüllte Paprika in Mehl wenden und überschüssiges Mehl abschütteln, dann in das verquirlte Ei tauchen, bis sie vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Öl in einer tiefen Pfanne auf 350°F erhitzen und die Paprika insgesamt etwa 3 Minuten von allen Seiten goldbraun frittieren, dann auf einen mit Küchenpapier ausgelegten Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einem separaten Topf die Tomatensauce bei mittlerer Hitze erwärmen und den gehackten Knoblauch, das Paprikapulver, Salz und Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sauce 5 Minuten köcheln lassen, bis sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die frittierten Paprika heiß servieren und dabei warme Tomatensauce darüber und darum löffeln.",
