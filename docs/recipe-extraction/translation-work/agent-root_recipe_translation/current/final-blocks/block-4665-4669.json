      "steps": [
        {
          "position": 0,
          "text": "Wenn du gesalzenen Kabeljau verwendest, ihn 12 Stunden in kaltem Wasser einweichen, das Wasser alle 3 Stunden wechseln, dann abgießen und den Fisch zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Olivenöl in einer Pfanne erhitzen und die gewürfelte Zwiebel etwa 4 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Reis zur Zwiebel geben und 1 Minute umrühren, dann den zerpflückten Fisch, den Dill und die Pinienkerne hinzufügen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Wasser und den Zitronensaft dazugießen, zum Kochen bringen, dann die Hitze reduzieren und 8 Minuten köcheln lassen, bis der Reis teilweise gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit schwarzem Pfeffer würzen und die Mischung etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Weinblätter abspülen und mit der glänzenden Seite nach unten auslegen. Etwa 1 Esslöffel Füllung auf jedes Blatt geben, dann die Seiten einschlagen und fest aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die gerollten Dolmas mit der Nahtseite nach unten in einen Topf legen, mit dem restlichen Olivenöl beträufeln und mit einem umgedrehten Teller beschweren, damit sie sich nicht wieder aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "1 Tasse Wasser in den Topf geben, zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 20 Minuten köcheln lassen. Warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
