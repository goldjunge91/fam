      "steps": [
        {
          "position": 0,
          "text": "Die Deckel der Paprika abschneiden und Kerne sowie Trennwände entfernen, dann beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Öl in einer großen Pfanne bei mittlerer Hitze erhitzen und die gewürfelte Zwiebel etwa 3 Minuten anbraten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hackfleisch in die Pfanne geben und etwa 5 Minuten anbraten, dabei zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den ungekochten Reis, das Paprikapulver, Salz und Pfeffer unterrühren und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Pfanne vom Herd nehmen, die Mischung etwas abkühlen lassen und dann das Ei zur Bindung unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Paprika mit der Fleisch-Reis-Mischung füllen und aufrecht in eine Auflaufform stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Dosentomaten mit der Rinderbrühe vermischen und um die Paprika gießen. Mit Alufolie abdecken und bei 375°F 30 Minuten backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Folie entfernen und weitere 10-15 Minuten backen, bis die Paprika sehr weich und die Füllung vollständig durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
