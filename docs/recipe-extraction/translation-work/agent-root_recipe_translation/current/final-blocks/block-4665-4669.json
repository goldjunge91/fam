      "steps": [
        {
          "position": 0,
          "text": "Die Safranfäden in 1/4 Tasse heißem Wasser 10 Minuten einweichen, bis das Wasser goldgelb ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Öl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und die Zwiebelscheiben etwa 6 Minuten goldbraun anbraten, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hähnchenschenkel mit Salz, Pfeffer und Kurkuma würzen, dann im selben Topf auf jeder Seite 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Zwiebeln zum Hähnchen zurück in den Topf geben, 1 Tasse Wasser hinzufügen, die Hitze reduzieren und zugedeckt 25 Minuten köcheln lassen, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während das Hähnchen gart, den Reis abspülen und in einem separaten Topf 4 Tassen Wasser zum Kochen bringen. Großzügig salzen, den Reis hinzufügen und 5 Minuten kochen, dann abgießen, sobald er teilweise gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restlichen 2 Esslöffel Öl in einem sauberen Topf erhitzen und den abgetropften Reis hineingeben, dabei vorsichtig mit einer Gabel mischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Dill und die Erbsen auf dem Reis verteilen, dann das Safranwasser gleichmäßig darüber gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Topf mit Alufolie und einem dicht schließenden Deckel abdecken und bei mittlerer Hitze 15 Minuten garen, bis der Reis locker ist und sich am Boden eine goldene Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Den Reis auf einer Platte anrichten und mit dem Hähnchen und der Sauce belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
