      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter in 1 Zoll große Würfel und die Leber in kleinere Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Schweinefleischwürfel portionsweise anbraten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bei Bedarf mehr Öl hinzufügen und die Leberstücke etwa 4 Minuten braten, bis sie gar sind. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Im selben Öl gewürfelte Zwiebeln und gehackten Knoblauch etwa 3 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln in dünne pommesartige Stifte schneiden und in die Pfanne geben. Unter häufigem Rühren 10 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schweinefleisch und Leber zurück in die Pfanne geben, Kreuzkümmel, Salz und Pfeffer hinzufügen und weitere 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Limettensaft abschließen und heiß direkt aus der Pfanne mit warmen Tortillas oder Arepas servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
