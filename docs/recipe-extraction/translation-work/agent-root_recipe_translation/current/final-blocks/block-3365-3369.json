      ],
      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gib die tiefgekühlten Teigtaschen vorsichtig hinein. Rühre behutsam um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche sie 5-7 Minuten, bis sie an die Oberfläche steigen, und lasse sie dann weitere 2 Minuten garen. Gieße sie anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem kleinen Topf bei mittlerer Hitze und gib getrocknete Chilischoten und Sichuan-Pfefferkörner dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Gewürze 2-3 Minuten, bis sie duften, nimm den Topf vom Herd und rühre gehackten Knoblauch ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Sojasauce, Reisessig und Sesamöl zur Chiliölmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die gekochten Teigtaschen in eine Servierschüssel und gieße die warme Chiliölmischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit gehackten Frühlingszwiebeln und serviere es sofort heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
