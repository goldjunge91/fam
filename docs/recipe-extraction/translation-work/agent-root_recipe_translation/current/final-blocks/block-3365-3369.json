      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Rindersehne 3 Minuten in kochendem Wasser, gieße sie ab und spüle sie gründlich mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf bei starker Hitze und röste Sichuan-Pfefferkörner, getrocknete Chilischoten und Sternanis 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwer dazu und brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Rindersehnenstücke dazu und gare sie 3 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Sojasauce und Hühnerbrühe dazu und bringe alles zum Kochen. Reduziere die Hitze, decke den Topf ab und lasse alles 1.5 hours köcheln, bis die Sehne sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Prüfe mit einer Gabel, ob das Fleisch zart ist; es sollte sich leicht zerzupfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle das Gericht mit Sesamöl, garniere es mit Frühlingszwiebeln und serviere es heiß in Schalen mit Kochsud.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
