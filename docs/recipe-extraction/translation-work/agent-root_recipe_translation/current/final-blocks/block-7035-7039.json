      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust in Salzwasser 12–15 Minuten pochieren, bis sie gar sind, dann in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In Scheiben geschnittene Pilze und Zwiebelwürfel in 2 Esslöffeln Butter anbraten, bis die Flüssigkeit weich und verdampft ist (ca. 8 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Machen Sie eine Mehlschwitze, indem Sie die restlichen 2 Esslöffel Butter schmelzen, Mehl unterrühren, bis eine glatte Masse entsteht, und 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Milch und Hühnerbrühe langsam unter ständigem Rühren einrühren, bis die Soße eindickt (ca. 5 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerkleinertes Hähnchenfleisch, gekochte Pilze und Zwiebeln, Thymian, Salz und Pfeffer unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Füllung in eine Kuchenform füllen und mit dem Kuchenboden belegen, die Ränder verschließen und mit geschlagenem Ei bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "400–25 Minuten bei 30 °C backen, bis die Kruste goldbraun ist und die Füllung an den Rändern Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
