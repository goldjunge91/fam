      "steps": [
        {
          "position": 0,
          "text": "Den Speck in Stücke schneiden und die Würstchen halbieren; Beides in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln und Zwiebeln schälen, in Scheiben schneiden und über das Fleisch schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Alles mit Hühnerbrühe übergießen, Thymian und Lorbeerblatt dazugeben und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bei mittlerer Hitze köcheln lassen, mit einem Deckel abdecken und 30–35 Minuten kochen lassen, bis die Kartoffeln weich und die Würste gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit der Brühe in Schüsseln füllen und heiß servieren, traditionell mit knusprigem Brot zum Aufsaugen der Flüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
