      "steps": [
        {
          "position": 0,
          "text": "Schweinehackfleisch, Garnelen, Bambussprossen, Knoblauch, Frühlingszwiebel, Sojasauce, Sesamöl und Maisstärke in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 Teelöffel Füllung in die Mitte jedes Wonton-Teigblatts geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teigränder mit Wasser befeuchten, zu einem Dreieck falten, dann zwei Ecken zusammenführen und zum Verschließen zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Einen großen Topf Wasser zum Kochen bringen und Wontons vorsichtig portionsweise zu je 6–8 hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald Wontons an die Oberfläche steigen, weitere 2 Minuten kochen und mit Brühe in eine Servierschüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alternativ Wontons für eine leichtere Variante 6–8 Minuten in einem Bambusdämpfer dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Chiliöl und Sojasauce zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
