      "steps": [
        {
          "position": 0,
          "text": "Rinderbrühe in einem Hot Pot oder einer großen flachen Pfanne am Tisch zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Getrocknete Chilis, Sichuan-Pfefferkörner, Ingwerscheiben und Knoblauch dazugeben, dann Hitze auf mittlere Stufe reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Alle rohen Zutaten auf einer Platte um den Topf herum anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jeder Gast nimmt Zutaten und taucht sie in die heiße Brühe, bis sie gar sind, 30 Sekunden bis 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sojasauce und Sesamöl in einzelnen Schälchen als Dip vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitergaren und essen, bis alle Zutaten aufgebraucht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die übrige Brühe kann zum Schluss als Suppe genossen werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
