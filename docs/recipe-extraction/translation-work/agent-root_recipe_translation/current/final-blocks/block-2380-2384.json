      "steps": [
        {
          "position": 0,
          "text": "Ente trocken tupfen und Haut überall mit einer Gabel einstechen, ohne das Fleisch zu durchbohren. An einem kühlen Ort 1 Stunde aufhängen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Honig, Sojasauce, Essig, Fünf-Gewürze-Pulver, Knoblauch und Ingwer in einer Schüssel vermischen und auf die Entenhaut streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entenbrust nach oben auf einen Rost über Wasser in einen auf 450°F vorgeheizten Ofen legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "25 Minuten braten, dann Temperatur auf 350°F reduzieren und weitere 1 Stunde braten, bis die Haut knusprig und das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ente 10 Minuten ruhen lassen, dann Haut und Fleisch mit einem scharfen Messer dünn aufschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pfannkuchen nach Packungsanleitung erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entenscheiben mit Pfannkuchen, Frühlingszwiebeln, Gurke und Hoisinsauce zum Einrollen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
