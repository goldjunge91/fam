      "steps": [
        {
          "position": 0,
          "text": "Den ganzen Fisch gründlich säubern und fest mit Salz bedecken. An einem kühlen Ort 3-4 Wochen pökeln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach dem Pökeln den Fisch abspülen und vorsichtig entgräten, dabei den Körper möglichst intakt lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gekochten Sushi-Reis mit Essig, Wasser und Zucker vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Bauchhöhle des Fischs vollständig mit dem gewürzten Reis füllen und fest andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den ganzen Fisch in Kombu-Algen wickeln und in ein sauberes Gefäß legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei Zimmertemperatur 6 months bis 1 year fermentieren lassen und gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auswickeln, in dünne Stücke schneiden und als Delikatesse bei Zimmertemperatur servieren.",
          "timerMinutes": null,
