        {
          "position": 0,
          "text": "Gurkenenden abschneiden und die Gurken senkrecht mit Dill und Zwiebelscheiben in saubere, sterilisierte Gläser füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Essig, Wasser, Zucker, Salz, Pfefferkörner und Senfkörner in einem Topf vermengen und aufkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die heiße Lake über die Gurken gießen, bis sie vollständig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Deckel auf die Gläser legen und auf Zimmertemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vor dem Servieren mindestens 2 Tage kalt stellen; nach 1 Woche schmecken sie am besten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
