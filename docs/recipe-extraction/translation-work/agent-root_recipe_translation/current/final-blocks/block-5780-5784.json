      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Sojabohnen über Nacht in Wasser einweichen, abgießen und 1 hour in frischem Wasser kochen, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die gekochten Bohnen abgießen und zum leichten Abkühlen auf sauberen Papiertüchern verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die warmen Bohnen mit Natto-Starterkultur in einem sterilisierten Gefäß vermengen und fest mit einem Tuch abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "An einem warmen Ort (etwa 104°F) 18-24 Stunden fermentieren lassen, bis eine klebrige, Fäden ziehende Konsistenz entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In den Kühlschrank stellen und 1-2 Tage reifen lassen, damit sich das Aroma voll entwickelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zu warmem Reis mit Sojasauce, Wasabi und Frühlingszwiebeln servieren. Vor dem Essen kräftig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
