      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und die in Scheiben geschnittenen Zwiebeln etwa 3 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute kochen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Kartoffeln und Kirschtomaten hinzufügen und 2 Minuten lang umrühren, bis sie mit Öl bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischbrühe angießen und zum Kochen bringen; Kartoffeln 15 Minuten kochen, bis sie fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fischfilets in große Stücke schneiden und zusammen mit den Paprikaflocken vorsichtig in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "8–10 Minuten leicht köcheln lassen, bis der Fisch gar ist und sich mit einer Gabel leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nach Bedarf mit Salz und schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln schöpfen, mit frischer Petersilie bestreuen und mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
