      "steps": [
        {
          "position": 0,
          "text": "Schweinefleisch mit Papiertüchern trocken tupfen und die Haut kreuzweise einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Fleisch einschneiden und halbierte Knoblauchzehen, Rosmarinzweige und Salbeiblätter in die Schnitte stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reiben Sie alle Oberflächen des Schweinefleischs großzügig mit Salz, schwarzem Pfeffer und Olivenöl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinefleisch in einen großen Bräter legen und mit Lorbeerblättern umgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weißwein und Brühe auf den Boden der Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 325 °F 3 Stunden braten und dabei alle 30 Minuten mit dem Bratensaft übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Temperatur auf 400 °F erhöhen und weitere 15–20 Minuten braten, bis die Schwarte knusprig ist und das Fleisch eine Kerntemperatur von 160 °F erreicht hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Das Fleisch 15 Minuten ruhen lassen, dann tranchieren und mit Bratenfett darüber servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
