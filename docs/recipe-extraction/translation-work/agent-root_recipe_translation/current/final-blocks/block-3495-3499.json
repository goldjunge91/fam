      "steps": [
        {
          "position": 0,
          "text": "Linsen, Weizen und Gerste 30 Minuten in Wasser einweichen und dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ghee in einem Topf mit schwerem Boden erhitzen und die Hälfte der geschnittenen Zwiebeln goldbraun braten; herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Ghee die restlichen Zwiebeln weich braten, dann Ingwer-Knoblauch-Paste hinzufügen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rindfleisch, rotes Chilipulver und Kurkumapulver hinzufügen und bei hoher Hitze 10 Minuten unter gelegentlichem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eingeweichte Linsen, Weizen und Gerste mit 8 cups Wasser hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze reduzieren und abgedeckt 1.5 Stunden köcheln lassen; gelegentlich umrühren, bis Fleisch und Getreide zu einer dicken Paste zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der Rückseite eines Löffels oder einem Stabmixer pürieren, bis die Mischung eine gleichmäßige, breiartige Konsistenz hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem heißen Servieren mit gebratenen Zwiebeln, frischer Minze, Koriander und einem Klecks Ghee garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
