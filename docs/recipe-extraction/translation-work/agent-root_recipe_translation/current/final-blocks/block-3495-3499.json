      "steps": [
        {
          "position": 0,
          "text": "Mehl, Wasser und Salz zu einem weichen Teig vermengen, gut kneten und abgedeckt 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Öl in einer Pfanne erhitzen und Zwiebeln goldbraun anbraten, dann Ingwer-Knoblauch-Paste und grüne Chili hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hackfleisch hinzufügen und bräunen, dann Garam Masala, Koriander und Salz einrühren und garen, bis die Mischung trocken ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 6 gleiche Portionen teilen und jeweils dünn oval ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 Esslöffel Füllung auf eine Hälfte jedes Ovals geben, die andere Hälfte darüberklappen und die Ränder mit Wasser verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das übrige Öl in einer tiefen Pfanne bei mittelhoher Hitze erhitzen und Lukhmi etwa 3-4 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Chutney oder Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
