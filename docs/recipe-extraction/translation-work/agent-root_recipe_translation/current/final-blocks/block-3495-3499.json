      "steps": [
        {
          "position": 0,
          "text": "Chana Dal 1 Stunde in Wasser einweichen und dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch mit eingeweichtem Dal, Wasser und Salz in einem Topf 20 Minuten kochen, bis Fleisch und Dal sehr weich und die Mischung trocken ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die gegarte Mischung abkühlen lassen und dann mit Ingwer-Knoblauch-Paste, grüner Chili, Koriander und Garam Masala in eine Küchenmaschine geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zu einer feinen Paste pulsieren, in eine Schüssel umfüllen und das verquirlte Ei untermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In 8-10 gleiche Portionen teilen und jeweils zu einer etwa 1/2-inch dicken Scheibe formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer Pfanne bei mittelhoher Hitze erhitzen und Kebabs je Seite 2-3 Minuten goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Minz-Chutney und Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
