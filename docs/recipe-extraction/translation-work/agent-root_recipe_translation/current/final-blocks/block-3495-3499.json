      "steps": [
        {
          "position": 0,
          "text": "Vollkornmehl, Salz und Öl in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach Wasser einrühren, bis ein weicher Teig entsteht, dann 5 Minuten kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 8 gleiche Kugeln teilen und 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Kugel auf einer bemehlten Fläche zu einem dünnen Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Roti auf die heiße Pfanne legen und etwa 1 Minute garen, bis sich Blasen bilden; wenden und die andere Seite 30 Sekunden garen, bis hellbraune Stellen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Tuch leicht andrücken, damit der Fladen aufgeht, dann auf einen Teller legen und dünn mit Öl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
