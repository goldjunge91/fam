          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Alles gut verrühren, damit sich die Zutaten gleichmäßig verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Abdecken und über Nacht oder mindestens 4 Stunden kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Am Morgen umrühren und mehr Milch hinzufügen, falls die Mischung zu dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In eine Schüssel geben und mit frischen Heidelbeeren, gehobelten Mandeln und Chiasamen belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
