      "steps": [
        {
          "position": 0,
          "text": "Kokosmilch in eine Schüssel gießen und mit einem Schneebesen verrühren, damit sich abgesetztes Fett wieder verbindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Chiasamen, Ahornsirup und Vanilleextrakt zur Kokosmilch geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2-3 Minuten gut verrühren und stehen lassen, dann erneut umrühren, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung auf zwei Gläser oder Schüsseln verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und über Nacht oder mindestens 4 Stunden im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Servieren umrühren und mehr Milch hinzufügen, falls die Mischung zu dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frische Mango würfeln und die Puddings mit Mango, Kokosflocken und Granola garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
