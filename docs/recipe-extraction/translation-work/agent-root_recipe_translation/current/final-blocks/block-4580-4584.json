      "steps": [
        {
          "position": 0,
          "text": "Sushi-Reis nach Packungsanleitung kochen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reisessig, Zucker und Salz vermischen, dann unter den warmen Reis heben, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier leicht verquirlen und in einer beschichteten Pfanne bei mittlerer Hitze zu Rührei braten, dann zum Abkühlen beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gurke in dünne Streifen schneiden und Karotten raspeln oder in feine Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Reis auf zwei Schalen verteilen und mit Rührei, Garnelen, Surimi, Gurke und Karotten belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nori-Algen darüberbröseln und mit Sesam bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Sojasoße zum Beträufeln oder als Dip servieren.",
          "timerMinutes": null,
