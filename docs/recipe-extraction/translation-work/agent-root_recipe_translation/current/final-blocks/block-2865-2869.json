      "steps": [
        {
          "position": 0,
          "text": "Warme Milch, Hefe und 1 Esslöffel Zucker in einer kleinen Schüssel vermengen und 5 Minuten stehen lassen, bis sich Schaum bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, restlichen Zucker und Salz in einer großen Schüssel vermengen und in der Mitte eine Mulde formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hefemischung, Eigelb und geschmolzene Butter in die Mulde gießen und verrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig 8-10 Minuten kneten, bis er glatt und elastisch ist, dann abdecken und an einem warmen Ort 1 Stunde gehen lassen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in 12 Stücke teilen, zu Kugeln rollen und auf mit Backpapier ausgelegte Backbleche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 30 Minuten gehen lassen, bis sie luftig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einem tiefen Topf auf 350°F erhitzen und die Krapfen vorsichtig 1-2 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und dann mit einem Spritzbeutel 1 Esslöffel Marmelade in die Mitte jedes warmen Pączki spritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Noch warm großzügig mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
