      "steps": [
        {
          "position": 0,
          "text": "Kutteln und 6 cups Rinderbrühe in einem großen Topf aufkochen, dann die Hitze reduzieren und 2.5 Stunden köcheln lassen, bis sie sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kutteln abgießen und beiseitestellen; 4 cups Kochflüssigkeit aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl im selben Topf erhitzen und gewürfelte Zwiebel, Karotte und Sellerie 5 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark, Paprikapulver und Majoran einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochte Kutteln mit der aufbewahrten Kochflüssigkeit, Lorbeerblättern, Salz und Pfeffer zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 30 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und heiß in Schalen mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
