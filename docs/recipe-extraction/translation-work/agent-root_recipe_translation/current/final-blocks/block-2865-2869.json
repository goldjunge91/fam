      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und grob reiben; Zwiebel in eine Schüssel reiben und überschüssige Flüssigkeit mit einem sauberen Küchentuch ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geriebene Kartoffelmischung mit Ei, Mehl, Salz und Pfeffer gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittelhoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Häufungen der Kartoffelmischung mit einem Esslöffel ins Öl geben und mit dem Pfannenwender auf 1/4-inch Dicke flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3-4 Minuten pro Seite goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gebackene Kartoffelpuffer auf einen mit Küchenpapier ausgelegten Teller legen, damit überschüssiges Öl abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm mit saurer Sahne als Belag oder Dip servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
