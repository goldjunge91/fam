      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze und brate frische Thunfischsteaks 2 Minuten pro Seite scharf an. Stelle sie beiseite (bei Thunfisch aus der Dose entfällt dieser Schritt).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste in derselben Pfanne Kreuzkümmelsamen und Pfefferkörner 1 Minute. Gib dann gehackten Knoblauch dazu und gare ihn, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Paprikapulver, Salz und Lorbeerblätter dazu und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Essig und Wasser dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Thunfisch zurück in die Pfanne (oder Thunfisch aus der Dose, in Stücke zerteilt), reduziere die Hitze und lasse alles 15-20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Flüssigkeit sollte um die Hälfte reduziert und der Thunfisch zart und mit Adobo-Aromen durchzogen sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Gericht leicht abkühlen und serviere es warm oder bei Raumtemperatur mit der darübergelöffelten Adobo-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
