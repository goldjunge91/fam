      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch dazu und gare ihn unter ständigem Rühren 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Garnelen in die Pfanne und gare sie 1 Minute pro Seite, bis sie beginnen, rosa zu werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreue die Garnelen mit Paprikapulver und roten Chiliflocken und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein dazu und presse Zitronensaft hinein. Gare alles weitere 2-3 Minuten, bis die Garnelen vollständig gar und undurchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und probiere das Gericht ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es heiß in einer Schüssel oder auf knusprigem Brot und garniere es mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
