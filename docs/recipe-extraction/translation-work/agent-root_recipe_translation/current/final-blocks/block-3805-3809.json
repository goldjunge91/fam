      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und nimm das Lamm 30 Minuten vor dem Garen aus dem Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Knoblauch, Paprikapulver, Kreuzkümmel, Salz, Pfeffer und Olivenöl zu einer Paste und reibe sie auf die gesamte Lammschulter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Lamm in einen Bräter und schiebe Rosmarin- und Thymianzweige unter und um das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wein und Rinderbrühe neben das Lamm in den Bräter, nicht darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Bräter fest mit Folie ab und brate alles 2 Stunden. Begieße das Fleisch alle 30 Minuten mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Folie ab, erhöhe die Ofentemperatur auf 425°F und brate alles ohne Abdeckung weitere 20-30 Minuten, bis die Haut goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke das Fleisch locker mit Folie ab und lasse es vor dem Tranchieren 15 Minuten ruhen. Serviere es mit Bratensaft als Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
