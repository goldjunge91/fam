      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen schweren Topf oder Schmortopf bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze Ziegenfleisch mit Salz und Pfeffer und bräune es portionsweise etwa 3-4 Minuten pro Seite an. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste Zwiebel im selben Topf etwa 5 Minuten weich. Gib dann Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und Kreuzkümmel ein und gare alles 2 Minuten, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche den Topf mit Rotwein ab, löse die Röstspuren und lasse die Flüssigkeit auf die Hälfte reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Fleisch, Lorbeerblätter, Thymian und Rinderbrühe zurück in den Topf. Bringe alles zum Köcheln, decke ab und gare es 90 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Kartoffeln dazu und lasse alles zugedeckt weitere 30 Minuten köcheln, bis Fleisch und Kartoffeln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und serviere das Gericht heiß in Schalen mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
