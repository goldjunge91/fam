      "steps": [
        {
          "position": 0,
          "text": "Bitte den Metzger, die Rindfleischscheiben dünn zu klopfen, oder lege sie zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer dünn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege eine Scheibe Rindfleisch aus und bestreiche sie leicht mit Senf. Lege mittig 1 Speckstreifen, eine dünne Zwiebelscheibe und eine Gewürzgurke darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle das Fleisch von einem Ende her fest auf und sichere es mit Küchengarn oder Zahnstochern. Wiederhole dies mit den übrigen Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne und bräune die Rouladen insgesamt etwa 8 Minuten von allen Seiten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die übrigen Zwiebelscheiben um die Rouladen herum und gare sie etwa 5 Minuten, bis die Zwiebeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestäube die Rouladen mit Mehl und rühre um. Gieße dann Rinderbrühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Pfanne ab und lasse alles bei niedriger Hitze 40-45 Minuten köcheln, bis das Fleisch zart ist. Wende die Rouladen nach der Hälfte der Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne Küchengarn oder Zahnstocher und serviere die Rouladen mit Sauce und Salzkartoffeln oder Eiernudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
