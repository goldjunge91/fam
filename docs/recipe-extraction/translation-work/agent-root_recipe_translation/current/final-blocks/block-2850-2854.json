      "steps": [
        {
          "position": 0,
          "text": "Lege die Schweinekoteletts zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 0.25 Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei Schüsseln bereit: Mehl mit Salz und Pfeffer, verquirlte Eier und Semmelbrösel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Schweinekotelett in Mehl und schüttle Überschuss ab. Tauche es dann in Ei und wende es gründlich in Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne auf 350°F und frittiere die panierten Koteletts 3-4 Minuten pro Seite, bis sie goldbraun und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege sie auf einen mit Küchenpapier ausgelegten Teller und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmilz Butter in derselben Pfanne und erwärme die Sardellenfilets 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate die Eier im restlichen Öl etwa 3-4 Minuten, bis das Eiweiß gestockt und das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege jedes Schnitzel mit einem Sardellenfilet und einem Spiegelei und serviere es sofort mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
