      "steps": [
        {
          "position": 0,
          "text": "Schneide die Zwiebeln in dünne Ringe und lasse die Ringe dabei ganz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 3 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze und gare die Zwiebeln etwa 10 Minuten unter gelegentlichem Rühren, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebeln in eine Schüssel, würze sie mit Salz, Pfeffer und Zucker und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Olivenöl und die übrige Butter in dieselbe Pfanne und erhitze sie auf hoher Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze die Rindersteaks mit Salz und Pfeffer und brate sie in der heißen Pfanne 4-5 Minuten pro Seite für einen mittleren Gargrad.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Steaks auf Servierteller und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Rinderbrühe und zerkrümelten Brühwürfel in die Pfanne, kratze die Bratrückstände vom Boden und lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege jedes Steak mit karamellisierten Zwiebeln, gieße die Pfannensauce darüber und serviere es sofort mit Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
