      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und tupfe die Schweinshaxe mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Haxe großzügig mit Salz, Pfeffer und zerdrücktem Knoblauch ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Bräter auf dem Herd und bräune die Haxe insgesamt etwa 10 Minuten von allen Seiten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib grob gehackte Zwiebeln, Karotten und Sellerie in den Bräter und röste alles bei 425°F 20 Minuten im Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Rinderbrühe über die Haxe, gib Lorbeerblätter hinzu, decke den Bräter mit Folie ab und reduziere die Hitze auf 325°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmore das Fleisch 2-2.5 Stunden, bis es mit einer Gabel zart ist und sich leicht vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Haxe auf ein Schneidebrett. Seihe den Bratensaft ab und schöpfe Fett ab, um nach Belieben eine Sauce zuzubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Haxe im Ganzen oder tranchiert mit Sauce, Senf und Salzkartoffeln oder Sauerkraut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
