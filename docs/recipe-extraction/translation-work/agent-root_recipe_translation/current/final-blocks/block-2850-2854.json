      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und bräune das Rindfleisch portionsweise insgesamt etwa 8 Minuten. Würze es mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Zwiebeln in den Topf und gare sie etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Rinderbrühe in den Topf, gib Lorbeerblätter hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittlere bis niedrige Stufe, decke den Topf ab und lasse alles 30 Minuten köcheln, bis das Fleisch weich zu werden beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelte Kartoffeln und Karotten hinzu und lasse alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre gehackten Kohl ein und lasse alles 10-15 Minuten köcheln, bis das gesamte Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere den Eintopf und würze ihn bei Bedarf mit mehr Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn heiß in Schalen mit frischem Brot zum Eintunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
