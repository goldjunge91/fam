      "steps": [
        {
          "position": 0,
          "text": "Die Reisnudeln 15 Minuten in Wasser bei Zimmertemperatur einweichen, bis sie biegsam sind, dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Eier in einer Schüssel verquirlen und in einem heißen Wok mit 1 Esslöffel Öl zu Rührei braten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das restliche Öl in den Wok geben und die Garnelen bei starker Hitze etwa 3 Minuten braten, bis sie rosa sind. An den Rand schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Knoblauch in den Wok geben und 30 Sekunden braten. Die abgetropften Nudeln hinzufügen und unter ständigem Wenden 2–3 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sojasauce und Sesamöl über die Nudeln gießen. Sojasprossen, Rührei und gehackte Frühlingszwiebeln hinzufügen und alles 1–2 Minuten vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken, bei Bedarf nachwürzen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
