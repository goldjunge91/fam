      "steps": [
        {
          "position": 0,
          "text": "2 Eier in eine Schüssel schlagen. Milch, Zucker und eine Prise Salz hinzufügen und alles gut verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 Esslöffel Butter in einer beschichteten Pfanne bei mittlerer bis niedriger Hitze schmelzen und die Eiermischung hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Eier mit einem Pfannenwender behutsam vom Rand zur Mitte schieben, während sie stocken. Etwa 3–4 Minuten braten, bis ein weiches, cremiges Rührei entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Brotscheiben in einer separaten Pfanne oder im Toaster leicht goldbraun rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Toast mit Butter bestreichen und auf Teller legen. Auf jede Scheibe eine großzügige Portion Rührei geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das übrige Ei in eine kleine Schüssel schlagen und in einer sauberen Pfanne braten. Jeweils auf den Toast legen, mit Ketchup beträufeln und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
