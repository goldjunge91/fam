        {
          "position": 0,
          "text": "Den Fisch gründlich säubern und trocken tupfen. Die Haut auf beiden Seiten schräg einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Fisch auf Backpapier in einen Dämpfeinsatz legen. Die Hälfte des Ingwers und 2 gehackte Frühlingszwiebeln darüber verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "0.5 cup Wasser in den Dämpftopf gießen und zum Kochen bringen. Den Einsatz über das kochende Wasser stellen und den Fisch 10–12 Minuten dämpfen, bis er gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sojasauce, Sesamöl und Reisessig in einer kleinen Schüssel verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einer kleinen Pfanne erhitzen, bis es gerade zu rauchen beginnt. Vorsichtig über den gedämpften Fisch gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Fisch mit dem übrigen Ingwer und den Frühlingszwiebeln belegen, mit der Sojasaucenmischung beträufeln und sofort servieren.",
