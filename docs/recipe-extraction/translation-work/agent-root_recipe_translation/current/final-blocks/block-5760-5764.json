      "steps": [
        {
          "position": 0,
          "text": "Die Holzspieße 20 Minuten in Wasser einweichen. Reiskuchen und Fischkuchen anschließend in 1-inch große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reiskuchen- und Fischkuchenstücke abwechselnd bis zum Ende auf die Spieße stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sojasauce, Zucker, Sesamöl, Knoblauch und Gochugaru in einer kleinen Schüssel verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen. Die Spieße pro Seite 3–4 Minuten braten, bis die Reiskuchen leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Sauce großzügig auf die Spieße pinseln und weitere 2–3 Minuten braten. Dabei gelegentlich wenden und gut mit Sauce bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einer Platte anrichten, mit Sesamsamen bestreuen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
