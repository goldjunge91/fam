      "steps": [
        {
          "position": 0,
          "text": "Weiche die Reisnudeln 5 Minuten in warmem Wasser ein und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle die Eier in einer kleinen Schüssel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 Esslöffel Öl in einem Wok bei hoher Hitze und brate die Eier zu Rührei. Nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl hinzu und brate den gehackten Knoblauch und die gewürfelte Zwiebel 1 Minute unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Garnelen hinzu und gare sie etwa 2 Minuten, bis sie rosa sind. Füge dann die gewürfelten Karotten hinzu und gare alles 1 Minute weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue das Currypulver über die Zutaten und rühre 30 Sekunden um, damit alles bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die abgetropften Nudeln und die Sojasauce hinzu und vermenge alles 2-3 Minuten lang ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Rührei zurück in die Pfanne und vermische es mit gehackten Frühlingszwiebeln. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
