      "steps": [
        {
          "position": 0,
          "text": "Die Stacheln und Unebenheiten der Nopales mit einem scharfen Messer entfernen und gründlich abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die gesäuberten Nopales in 1/4-Zoll große Stücke würfeln und in einen großen Topf mit kochendem Salzwasser geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hälfte der Zwiebel und den Knoblauch in den Topf geben und 12 Minuten kochen, bis alles weich ist, dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und die restliche gewürfelte Zwiebel und Jalapeño 2 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die gekochten Nopales in die Pfanne geben und unter häufigem Rühren 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und Koriander, Limettensaft und Salz nach Geschmack unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm als Beilage oder Salat servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
