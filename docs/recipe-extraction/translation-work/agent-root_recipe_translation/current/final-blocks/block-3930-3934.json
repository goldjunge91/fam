      "steps": [
        {
          "position": 0,
          "text": "Vermische Wasser, grobes Salz, Pökelsalz, Pfefferkörner, Koriandersamen, Knoblauch und Lorbeerblätter in einem großen Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse die Salzlake vollständig auf Raumtemperatur abkühlen und stelle sie dann in den Kühlschrank, bis sie kalt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege Rinderbrust in die kalte Lake und stelle sie 7 Tage kalt. Wende das Fleisch gelegentlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch aus der Lake und spüle es gründlich unter kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Paprikapulver, Senfkörner und zerstoßene Pfefferkörner und bedecke die gesamte Fleischoberfläche damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wickle das Fleisch in Mulltuch und hänge es an einem kühlen Ort auf oder stelle es 2-3 Tage in den Kühlschrank, damit sich das Aroma entwickelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide es dünn auf und serviere es kalt oder dämpfe das ganze Stück vor dem Aufschneiden 3 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
