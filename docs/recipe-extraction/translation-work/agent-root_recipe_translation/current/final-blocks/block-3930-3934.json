      "steps": [
        {
          "position": 0,
          "text": "Spüle getrocknete Bohnen ab, weiche sie über Nacht in kaltem Wasser ein und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste gewürfelte Zwiebeln und gehackten Knoblauch etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tomatenmark hinzu und gare es 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Gemüsebrühe an und gib abgetropfte Bohnen, Lorbeerblätter und Thymian hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und lasse die Bohnen 60-75 Minuten köcheln, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Zitronensaft ein und würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne Lorbeerblätter und serviere die Suppe heiß als herzhaftes, dickes Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
