      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweinerückenspeck in kleine 1/2 Zoll große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Würfel in eine schwere Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gare sie langsam 40-50 Minuten und rühre gelegentlich um, bis das Fett schmilzt und die Würfel knusprig und goldbraun werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Würfel schrumpfen, während das Fett austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die knusprigen Stücke mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue sie noch warm mit Salz, schwarzem Pfeffer und Knoblauchpulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie vollständig abkühlen und bewahre sie dann bis zu 1 Woche in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Als Snack pur oder zerbröselt über Polenta oder Salaten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
