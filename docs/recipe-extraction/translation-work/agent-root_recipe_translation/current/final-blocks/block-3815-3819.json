      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Eier, Salz und Wasser zu einem dickflüssigen, klebrigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe einen großen Topf Salzwasser sprudelnd zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke den Teig mithilfe eines Spätzlehobels oder einer durchlöcherten Kelle durch die Öffnungen ins kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Spätzle, bis sie aufschwimmen, dann weitere 2 Minuten. Gieße sie anschließend in einem Sieb ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide währenddessen die Zwiebel und gare sie etwa 10 Minuten in Butter bei mittlerer Hitze goldbraun und karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte in einer Auflaufform die Hälfte der Spätzle, dann die Hälfte des Käses und anschließend die restlichen Spätzle und den restlichen Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue schwarzen Pfeffer darüber und gieße karamellisierte Zwiebeln samt Butter darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze den Auflauf im Ofen bei 375°F 10 Minuten, bis der Käse geschmolzen und die Oberfläche goldbraun ist. Garniere dann mit Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
