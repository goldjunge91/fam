      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eier, Mehl, Milch, Salz und Pfeffer zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer beschichteten Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße eine dünne Teigschicht in die Pfanne und neige sie, damit sich der Teig gleichmäßig verteilt. Gare ihn je Seite 1-2 Minuten hellgolden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wiederhole den Vorgang, bis der gesamte Teig aufgebraucht ist. Staple die fertigen Crêpes auf einem Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Crêpes leicht abkühlen, rolle sie auf und schneide sie in dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Rinderbrühe in einem großen Topf zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Crêpestreifen und Petersilie in die heiße Brühe und erwärme alles 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren und mit frischem Schnittlauch garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
