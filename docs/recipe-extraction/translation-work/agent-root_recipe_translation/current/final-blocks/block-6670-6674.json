      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz vermischen und dann mit Wasser verkneten, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig in 12 gleich große Portionen teilen und abgedeckt 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer Schüssel gekochte Kabeljauflocken, gehackte Zwiebeln, Koriander und gehackte Habanero-Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Teigportion zu einem dünnen Oval flach drücken, 1 Esslöffel Füllung auf eine Seite geben, dann falten und die Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und die Panaden portionsweise 3–4 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit scharfer Soße oder Salsa als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
