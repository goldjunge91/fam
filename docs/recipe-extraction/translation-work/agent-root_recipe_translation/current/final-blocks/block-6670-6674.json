      "steps": [
        {
          "position": 0,
          "text": "Salzfisch über Nacht oder mindestens 8 Stunden in Wasser einweichen, dabei das Wasser zweimal wechseln, um das Salz zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salzfisch 15 Minuten kochen, dann abgießen und in mundgerechte Stücke schneiden, dabei alle Gräten entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grüne Kochbananen, Dasheen und Yamswurzel schälen, in 2 Zoll große Stücke schneiden und 25 Minuten in Salzwasser kochen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während das Gemüse kocht, Öl in einer Pfanne erhitzen und Zwiebel sowie Knoblauch 2 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomaten, grüne Gewürze, Salzfischflocken und ggf. scharfe Paprika hinzufügen und 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Gemüse abgießen, zur Salzfischmischung geben und vorsichtig unterheben, bis alles heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
