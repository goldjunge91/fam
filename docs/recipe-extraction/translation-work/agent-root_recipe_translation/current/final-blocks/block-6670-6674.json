      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und Zwiebel, Knoblauch, grüne Gewürze und Thymian 3 Minuten anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehacktes Callaloo dazugeben und 5 Minuten kochen lassen, dabei gelegentlich umrühren, bis es leicht zusammenfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kokosmilch einfüllen und zum Kochen bringen, dann Krabbenfleisch und ggf. scharfe Paprika hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "15–20 Minuten köcheln lassen, bis Callaloo sehr zart ist und die Aromen miteinander verschmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frühlingszwiebeln unterrühren und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 2 Minuten köcheln lassen und heiß mit Roti oder Dhal und Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
