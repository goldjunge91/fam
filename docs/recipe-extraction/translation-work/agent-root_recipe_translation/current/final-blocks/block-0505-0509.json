      "steps": [
        {
          "position": 0,
          "text": "Vermische die geschnittenen Rumpsteakstreifen mit gehacktem Ingwer, zwei Knoblauchzehen, Pfeffer und der Hälfte des Salzes. Lass das Fleisch etwa 15 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre während das Rindfleisch ruht Kokosmilch, Zucker, Sriracha, Limettenschale, Limettensaft und das übrige Salz zur Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 EL Öl in einer großen Pfanne bei mittlerer bis hoher Hitze. Brate das Rindfleisch im Wok-Stil, bis es gerade durchgegart ist, 2 bis 3 Minuten, und lege es dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das übrige Öl in die Pfanne und brate rote Paprika, rote Zwiebel, Jalapeño und die letzte Knoblauchzehe 2 bis 3 Minuten, bis das Gemüse knackig-zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Kokossoße dazu und lass sie leicht köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in die Pfanne und füge den Spinat dazu. Gare alles unter gelegentlichem Rühren, bis der Spinat zusammengefallen und das Gericht heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verfeinere das Gericht mit Frühlingszwiebeln und Koriander und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
