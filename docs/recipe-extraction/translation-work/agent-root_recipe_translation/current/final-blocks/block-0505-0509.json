      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 400F vor und fette 10 Muffinförmchen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Rinderhack mit gehacktem Sellerie, Zwiebel und grüner Paprika in einer großen Pfanne bei mittlerer Hitze. Zerkleinere das Fleisch, bis es nicht mehr rosa ist, etwa 5-7 Minuten. Gieße das Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Barbecue-Soße ein und bringe alles zum Kochen. Reduziere die Hitze und lass die Mischung ohne Deckel 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trenne den Teig in 10 Stücke und drücke jedes zu einem runden Fladen von etwa 5 Zoll Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke einen Teigfladen auf den Boden und an die Seiten jedes gefetteten Muffinförmchens und gib dann die Rindfleischfüllung hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Förmchen 9-11 Minuten, bis der Teig goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue sie mit Cheddar und schiebe sie 1-2 Minuten zurück in den Ofen, gerade bis der Käse geschmolzen ist. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
