      "steps": [
        {
          "position": 0,
          "text": "Verrühre griechischen Joghurt und Ranch-Dressing in einer kleinen Schüssel, bis die Mischung glatt ist. Gib nach und nach kaltes Wasser dazu, bis das Dressing dünn genug zum Beträufeln ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Putenspeck knusprig, schneide ihn dann in mundgerechte Stücke und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Krautsalatmischung und gehackten Blattsalat und verteile das Grün auf vier Tellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ordne gewürfeltes Hähnchen, zerbröselten Feta, gehackten Apfel, Kichererbsen, Avocado, Putenspeck und Frühlingszwiebeln in ordentlichen Reihen auf dem Salat an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle jeden Salat mit dem Joghurt-Ranch-Dressing und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
