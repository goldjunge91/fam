      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze. Gib gewürfeltes Hähnchen und gehackte Zwiebel dazu und rühre ein paar Minuten, bis die Zwiebel weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Kürbis, Graupen, Taco-Gewürz, Salz, Pfeffer und Hühnerbrühe ein. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze, decke den Topf ab und lass alles 10 bis 12 Minuten köcheln, bis die Graupen zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre schwarze Bohnen, Mais, Kaffeesahne, Salsa und Koriander ein. Erhitze alles unter gelegentlichem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Suppe in Schüsseln und gib nach Wunsch gewürfelte Avocado und Tomaten darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
