        {
          "forIngredientId": "half-and-half",
          "swap": "Vollmilch oder ein Schuss Sahne, mit Wasser verdünnt",
          "savings": "Verwendet, was bereits vorrätig ist"
        },
        {
          "forIngredientId": "chicken-breast",
          "swap": "Hähnchenoberkeulen ohne Knochen und Haut oder übriges Hähnchen vom Drehspieß",
          "savings": "Schenkel sind pro Pfund günstiger"
