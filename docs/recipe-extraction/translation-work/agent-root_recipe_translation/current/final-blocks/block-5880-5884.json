      "steps": [
        {
          "position": 0,
          "text": "Stich die Auberginen mit einer Gabel ein und röste sie 8-10 Minuten direkt über einer Gasflamme oder unter dem Backofengrill, bis die Haut schwarz und das Fruchtfleisch weich ist. Wende sie gelegentlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Löffle das weiche Auberginenfleisch heraus und zerdrücke es in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die Zwiebel fein und hacke Knoblauch und Ingwer. Würfle auch die Tomate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne und gib die Kreuzkümmelsamen hinein. Lasse sie 30 Sekunden knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Zwiebel dazu und dünste sie etwa 5 Minuten goldbraun an. Gib dann Knoblauch und Ingwer hinzu und gare alles 1 Minute weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Tomate dazu und gare sie etwa 3 Minuten, bis sie weich ist. Rühre rotes Chilipulver und Garam Masala ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe Aubergine, Joghurt und Kokosmilch unter und lasse alles 8-10 Minuten köcheln, bis die Mischung cremig und gleichmäßig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und garniere das Gericht vor dem Servieren mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
