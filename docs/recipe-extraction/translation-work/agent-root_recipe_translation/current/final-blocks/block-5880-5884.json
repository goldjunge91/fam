      "steps": [
        {
          "position": 0,
          "text": "Schneide die Aubergine in 0.25-inch dicke Scheiben, salze sie und lasse sie 15 Minuten Wasser ziehen. Tupfe sie anschließend trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Auberginenscheiben in 3 tbsp Olivenöl von beiden Seiten etwa 3 Minuten goldbraun und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide das Hähnchen in mundgerechte Stücke und würze es mit Salz, Pfeffer und Kreuzkümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das restliche Olivenöl in einer großen Pfanne und gare das Hähnchen bei mittlerer bis hoher Hitze 5-6 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Zwiebeln in dünne Scheiben und gib sie zum Hähnchen in die Pfanne. Gare alles 8-10 Minuten, bis die Zwiebeln weich und karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Sumach und Hühnerbrühe ein und lasse alles 3-4 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Röste die Pinienkerne 2-3 Minuten in einer trockenen Pfanne bei mittlerer Hitze goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erwärme das Fladenbrot und belege es mit Auberginenscheiben, der Hähnchen-Zwiebel-Mischung und den gerösteten Pinienkernen. Sofort servieren.",
          "timerMinutes": null,
