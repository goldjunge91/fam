      "steps": [
        {
          "position": 0,
          "text": "Hacke Tomaten und Paprika grob und hacke den Knoblauch fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste den Knoblauch 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Tomaten und Paprika hinzu und gare sie ohne Deckel 15-18 Minuten unter gelegentlichem Rühren, bis das Gemüse sehr weich ist und die Mischung einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Paprikapulver, Kreuzkümmel und rotes Chilipulver dazu. Rühre gut um und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerdrücke die Mischung mit einem Holzlöffel, bis eine stückige Soße entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre frischen Koriander und Zitronensaft ein und würze mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht warm oder bei Zimmertemperatur mit Brot oder Crackern.",
