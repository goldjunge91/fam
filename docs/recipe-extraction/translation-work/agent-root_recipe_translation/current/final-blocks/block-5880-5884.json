      "steps": [
        {
          "position": 0,
          "text": "Schneide die Aubergine in 2-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch und Ingwer und schneide die Frühlingszwiebeln. Halte weiße und grüne Teile getrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Auberginenstücke portionsweise dazu und brate sie 4-5 Minuten unter Rühren an, bis sie weich und an den Rändern leicht gebräunt sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Knoblauch, Ingwer und die weißen Teile der Frühlingszwiebeln in den Wok und brate sie 30 Sekunden unter Rühren an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die Chilipaste ein und gare sie 15 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Auberginen zurück in den Wok. Füge Sojasoße, Reisessig, Zucker und Brühe hinzu, vermenge alles und lasse es 2-3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit den grünen Frühlingszwiebelteilen und serviere es heiß auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
