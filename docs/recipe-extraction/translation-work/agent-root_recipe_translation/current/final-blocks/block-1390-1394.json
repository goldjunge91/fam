      "steps": [
        {
          "position": 0,
          "text": "Für die Hollandaise: Verrühre 2 Eigelbe und Zitronensaft über einem Wasserbad, bis die Masse dick wird. Träufle langsam geschmolzene Butter dazu und rühre dabei ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 EL Essig in leicht köchelndes Wasser. Schlage jedes Ei einzeln ins Wasser und poche es 3–4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbiere und toaste die English Muffins. Erwärme den kanadischen Speck in einer Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte Muffin, kanadischen Speck, pochiertes Ei und Hollandaise mit Cayennepfeffer aufeinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
