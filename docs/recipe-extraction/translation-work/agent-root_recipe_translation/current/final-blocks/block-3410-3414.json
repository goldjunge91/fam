      "steps": [
        {
          "position": 0,
          "text": "Weiche den Tremella-Pilz 10 Minuten in warmem Wasser ein, bis er weich ist. Spüle ihn ab und zerteile ihn in kleine Röschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche rote Datteln 5 Minuten in warmem Wasser ein und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle und entkerne die Birnen und schneide sie in Viertel oder Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe 5 cups Wasser mit Ingwerscheiben in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Birnenstücke, Tremella, rote Datteln und Kandiszucker in das kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze und lasse alles ohne Deckel 20 Minuten köcheln, bis die Birnen sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Gojibeeren in den letzten 2 Minuten der Garzeit dazu und serviere das Gericht warm oder gekühlt in Schalen mit Kochsud.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
