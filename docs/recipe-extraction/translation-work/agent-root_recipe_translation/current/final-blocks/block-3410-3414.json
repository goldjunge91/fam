      "steps": [
        {
          "position": 0,
          "text": "Erhitze Kokosmilch, Wasser, Zucker, Salz und Pandanblätter (falls verwendet) in einem Topf bei mittlerer Hitze, bis sich der Zucker aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib tiefgekühltes Durianfruchtfleisch dazu und rühre vorsichtig, bis alles vermischt und die Mischung warm ist (etwa 5 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe die Durianmischung vorsichtig unter den gekochten Klebreis, bis alles gleichmäßig vermengt ist. Zerdrücke dabei möglichst nicht den Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Reis 5 Minuten ruhen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile ihn auf Schalen und bestreue ihn mit geröstetem Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere ihn bei Raumtemperatur oder leicht warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
