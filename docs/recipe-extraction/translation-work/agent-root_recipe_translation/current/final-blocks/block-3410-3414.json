      "steps": [
        {
          "position": 0,
          "text": "Weiche den eingelegten Fisch 30 Minuten in Wasser ein, um den Salzgehalt zu verringern, gieße ihn ab und zerteile ihn in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Bambussprossen aus der Dose ab und spüle sie ab. Frische Sprossen blanchierst du 5 Minuten und schneidest sie anschließend in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok bei mittelhoher bis hoher Hitze und brate Knoblauch, Ingwer und getrocknete Chilischoten 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den zerteilten eingelegten Fisch dazu und brate ihn 2 Minuten unter Rühren, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Bambussprossen dazu und brate sie 3 Minuten unter Rühren. Füge dann Sojasauce und Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel 15 Minuten köcheln und rühre gelegentlich um, bis sich die Aromen verbunden haben und die Sauce leicht eingekocht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle das Gericht mit Sesamöl, bestreue es mit Frühlingszwiebeln und serviere es heiß mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
