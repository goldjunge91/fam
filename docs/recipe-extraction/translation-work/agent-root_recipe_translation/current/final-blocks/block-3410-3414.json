      "steps": [
        {
          "position": 0,
          "text": "Presse den Tofu 10 Minuten zwischen Küchenpapier mit einem Gewicht, um überschüssiges Wasser zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den gepressten Tofu in 3/4-inch große Würfel und den Spam in ähnlich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 EL Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze und brate die Tofuwürfel etwa 8 Minuten, bis sie von allen Seiten goldbraun sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl dazu und brate die Spamstücke etwa 3 Minuten, bis sie leicht gebräunt sind. Gib dann Knoblauch dazu und gare ihn 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kohl und Karotte dazu und rühre ständig, bis der Kohl gerade zart ist, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe das Gemüse an den Rand, gieße verquirlte Eier in die Mitte und rühre sie, bis sie gerade gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib den Tofu zurück in die Pfanne, füge Sojasauce, Salz und Pfeffer hinzu und vermische alles vorsichtig. Erhitze es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort auf gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
