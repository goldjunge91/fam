      "steps": [
        {
          "position": 0,
          "text": "Schneide überschüssiges Fett vom Rindfleisch ab und schneide es quer zur Faser in ¼-inch dicke Streifen. Teilweises Einfrieren für 2 Stunden erleichtert das Schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasauce, Essig, Honig, Chilipulver, Knoblauchpulver, Ingwerpulver, schwarzen Pfeffer und Sesamöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Rindfleischstreifen mindestens 4 Stunden, besser über Nacht, in der Mischung im Kühlschrank ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Streifen mit Küchenpapier trocken, um überschüssige Marinade zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Streifen einlagig und ohne Überlappung auf mit Folie ausgelegte Ofengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie bei 160°F 5-6 Stunden, bis das Rindfleisch vollständig trocken und leicht brüchig, aber noch etwas zäh ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse es vollständig abkühlen und bewahre es bis zu 2 Wochen in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
