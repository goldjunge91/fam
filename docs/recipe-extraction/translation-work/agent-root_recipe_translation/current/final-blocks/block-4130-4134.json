      "steps": [
        {
          "position": 0,
          "text": "Knoblauch hacken und mit Kreuzkümmel, Paprika, Oregano, Salz, Pfeffer und Olivenöl zu einer Paste vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweineschwarte rautenförmig einschneiden, ohne ins Fleisch zu schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürzpaste rundherum und in die Einschnitte einreiben und mindestens 2 Stunden bei Raumtemperatur ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinefleisch mit der Schwarte nach oben in einen Bräter legen und Brühe darum herum gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bei 375°F 2.5 bis 3 Stunden braten und alle 30 Minuten mit dem Bratensaft übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wenn die Schwarte knusprig ist und die Kerntemperatur 160°F erreicht, aus dem Ofen nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Tranchieren 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren und den Bratensaft über das Fleisch löffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
