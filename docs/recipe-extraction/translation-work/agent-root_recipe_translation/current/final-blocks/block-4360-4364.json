      "steps": [
        {
          "position": 0,
          "text": "2.5 Tassen Mehl, 0.5 TL Salz und 1 Tasse kalte Butterwürfel mit einem Teigmischer vermengen, bis die Mischung groben Streuseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eiswasser 1 EL nach dem anderen hinzufügen und vorsichtig mischen, bis der Teig gerade zusammenhält, dann halbieren, einwickeln und 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "5 Tassen Marionbeeren, 0.75 Tasse Zucker, 2 EL Maisstärke und 1 EL Zitronensaft in einer Schüssel vermengen und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine Teigportion ausrollen, in eine 9-Zoll-Kuchenform legen und die Beerenfüllung hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den übrigen Teig ausrollen und darauflegen, die Ränder verschließen, Überstehendes abschneiden und Öffnungen einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 Ei mit 1 EL Wasser verquirlen und auf den oberen Teig streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 50-60 Minuten backen, bis der Teig goldbraun ist und die Füllung an den Rändern blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren auf einem Kuchengitter mindestens 2 Stunden vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
