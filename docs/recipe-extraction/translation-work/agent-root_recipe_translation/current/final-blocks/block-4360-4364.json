      "steps": [
        {
          "position": 0,
          "text": "Den Sushi-Reis nach Packungsanweisung kochen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spam in 8 dünne Scheiben schneiden und in einer Pfanne bei mittlerer bis hoher Hitze 2 Minuten pro Seite braten, bis die Ränder leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer kleinen Schüssel Sojasauce, Zucker und Mirin verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Sojamischung auf die gebratenen Spam-Scheiben streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nori-Blätter halbieren, sodass Streifen von etwa 2 Zoll Breite und 7 Zoll Länge entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine Musubi-Form (oder einen kleinen rechteckigen Behälter als Ersatz) auf ein Nori-Blatt stellen und mit einer Schicht Reis, einer Scheibe Spam und einer weiteren Schicht Reis füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fest andrücken und das Musubi auf einen Teller stürzen, dann die Nori-Streifen um die Seiten wickeln, damit alles zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Sesam bestreuen und bei Raumtemperatur oder leicht angewärmt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
