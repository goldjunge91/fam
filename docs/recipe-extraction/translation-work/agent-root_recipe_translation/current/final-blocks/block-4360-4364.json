      "steps": [
        {
          "position": 0,
          "text": "Garnelen trocken tupfen und bei Bedarf entdarmen, die Schwänze dranlassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "3 Tassen Pflanzenöl in einem tiefen Topf oder einer Fritteuse auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "0.5 Tasse Mehl, 0.5 Tasse Maisstärke, 1 Ei, 0.75 Tasse Eiswasser und 0.25 TL Salz glatt verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Garnelen portionsweise in den Teig tauchen und 2-3 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf Küchenpapier geben und sofort mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "0.25 Tasse Sojasauce und 2 EL Mirin in einer kleinen Schüssel als Dip vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tempura heiß mit Zitronenspalten und Dip servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
