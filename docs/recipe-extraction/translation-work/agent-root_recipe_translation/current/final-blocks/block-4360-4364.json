      "steps": [
        {
          "position": 0,
          "text": "Ti-Blätter 1 Minute in kochendem Wasser blanchieren, damit sie weich werden, dann abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ono-Filets mit Küchenpapier trocken tupfen und beide Seiten mit Salz und weißem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kokosmilch, gehackten Knoblauch, gehackten Ingwer und den Saft einer Zitrone in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwei Ti-Blätter überlappend auslegen, sodass eine große Fläche entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein Ono-Filet in die Mitte der Ti-Blätter legen und die Kokosmilchmischung darüberlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit geschnittenen Frühlingszwiebeln bestreuen und die Ti-Blätter nach oben um den Fisch falten, sodass die Enden sicher eingeschlagen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit den übrigen drei Filets und Ti-Blatt-Paaren wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die eingewickelten Fischpäckchen auf ein Bananenblatt oder Backpapier legen und in einem abgedeckten Topf mit 1 Zoll Wasser 15-18 Minuten dämpfen, bis der Fisch undurchsichtig ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort in den ungeöffneten Ti-Blatt-Päckchen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
