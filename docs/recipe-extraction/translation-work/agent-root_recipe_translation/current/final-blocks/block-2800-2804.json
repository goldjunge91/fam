      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und tupfe das Schweinefleisch innen und außen mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fülle den Bauchraum mit Knoblauchzehen, Zwiebelstücken, Thymian und Lorbeerblättern und verschließe die Öffnung mit Zahnstochern oder Spießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Außenseite gründlich mit Salz, schwarzem Pfeffer und Pflanzenöl ein und massiere es in die Schwarte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das Schweinefleisch in einen Bräter, gib 2 cups Wasser hinein und brate es ohne Deckel 3 bis 3.5 Stunden. Begieße es alle 30 Minuten mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhöhe die Ofentemperatur auf 425°F während der letzten 20 Minuten, damit die Haut knusprig und goldbraun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Kerntemperatur im dicksten Teil der Keule sollte 160°F betragen. Gare andernfalls weiter und prüfe alle 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse den Braten vor dem Tranchieren 15 Minuten ruhen und serviere ihn mit Lebersauce und Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
