      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze und bräune Rind- oder Schweinefleischwürfel etwa 8 Minuten von allen Seiten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Topf gehackten Knoblauch und geschnittene Zwiebel etwa 2 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Fleisch zurück in den Topf, füge Rinderbrühe hinzu und bringe alles zum Kochen. Reduziere die Hitze und lasse es zugedeckt 30 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Erdnussbutter mit 1 cup heißer Brühe aus dem Topf glatt und rühre sie dann in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Annatto-Pulver dazu und rühre gut um. Füge grüne Bohnen und Auberginenstücke hinzu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Pak Choi dazu und lasse ihn weitere 3 Minuten zusammenfallen. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht zu weißem Reis und reiche nach Wunsch Garnelenpaste (Bagoong) dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
