      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 EL Öl in einer großen Pfanne bei mittelhoher Hitze und brate Schweinehackfleisch unter Zerteilen etwa 5 Minuten an, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden. Füge dann fein geschnittenen Kohl und Karotten hinzu und gare alles 3 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Sojasauce ein, nimm die Pfanne vom Herd und lasse die Füllung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Speisestärke und Wasser in einer kleinen Schüssel zu einer Paste zum Verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ein Lumpia-Teigblatt auf eine saubere Fläche und gib 2 EL Füllung in die Mitte. Schlage die Seiten ein, rolle es fest auf und verschließe das Ende mit der Stärkepaste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze 3 cups Öl in einem tiefen Topf auf 350°F und frittiere die Lumpia-Rollen portionsweise 2 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit süß-saurer Sauce oder Essig zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
