      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittlerer Hitze und brate geschnittenen Ingwer und gehackten Knoblauch 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittene Zwiebel dazu und gare sie 1 Minute. Füge dann Hähnchenstücke hinzu und bräune sie leicht 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe dazu, bringe sie zum Kochen, reduziere die Hitze und lasse alles zugedeckt 20 Minuten köcheln, bis das Hähnchen fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schäle Chayote, schneide sie in Stücke, gib sie in den Topf und lasse alles 10 Minuten köcheln, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Spinat oder Pechay dazu und gare alles weitere 2 Minuten, bis das Grün zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Fischsauce, Salz und Pfeffer und serviere die Suppe heiß mit weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
