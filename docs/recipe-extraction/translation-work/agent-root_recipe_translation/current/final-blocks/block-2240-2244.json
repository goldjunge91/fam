      "steps": [
        {
          "position": 0,
          "text": "Vermische Zitronensaft, Paprikapulver und rote Zwiebeln in einer großen flachen Schale. Schneide jeden Hähnchenschenkel dreimal ein, wende ihn im Saft und stelle ihn 10 mins beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische alle Zutaten für die Marinade und gieße sie über das Hähnchen. Vermenge alles gründlich, decke es ab und stelle es mindestens 1 hr kalt. Du kannst dies bis zu einem Tag im Voraus vorbereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Grill vor. Lege die Hähnchenteile auf einen Rost über einem Backblech. Bestreiche sie mit etwas Öl und grille sie 8 mins pro Seite, bis sie leicht verkohlt und vollständig durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
