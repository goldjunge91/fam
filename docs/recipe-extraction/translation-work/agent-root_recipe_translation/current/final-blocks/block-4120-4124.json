      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher bis hoher Hitze und bräune das Rinderhackfleisch an, während du es zerteilst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel, Knoblauch und Paprika in den Topf und gare sie 3 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Kartoffeln dazu und rühre sie unter, damit sie mit Öl überzogen sind. Gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Gemüsebrühe hinzu, gib Kreuzkümmel, Salz und Pfeffer dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse alles 15 Minuten köcheln, bis die Kartoffeln fast gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Mais und grüne Erbsen unter und gare alles weitere 5 Minuten, bis das Gemüse zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und serviere das Gericht heiß.",
          "timerMinutes": null,
