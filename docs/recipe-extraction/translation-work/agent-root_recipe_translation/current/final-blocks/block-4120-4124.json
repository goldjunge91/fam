      "steps": [
        {
          "position": 0,
          "text": "Tupfe den Ochsenschwanz trocken und würze ihn mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher bis hoher Hitze und bräune den Ochsenschwanz insgesamt 8 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Ochsenschwanz heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste im selben Topf die gewürfelte Zwiebel und den Knoblauch 3 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomatensauce und Kreuzkümmel hinzu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den Ochsenschwanz zurück in den Topf und füge Rinderbrühe und Lorbeerblätter hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse es 60 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Kartoffeln und Oliven hinzu, decke den Topf ab und lasse alles weitere 20 Minuten köcheln, bis das Fleisch zart und die Kartoffeln gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schmecke ab, passe die Würzung an und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
