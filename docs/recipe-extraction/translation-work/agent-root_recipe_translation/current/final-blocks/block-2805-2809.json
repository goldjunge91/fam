      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze und bräune Rindfleischstücke etwa 10 Minuten rundherum an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Topf gehackten Knoblauch und gewürfelte Zwiebel etwa 2 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch zurück in den Topf, füge Rinderbrühe und Tomatensauce hinzu und bringe alles zum Kochen. Reduziere die Hitze und lasse es zugedeckt 45 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Kartoffeln und Karotten in Stücke, gib sie in den Topf und lasse alles 15 Minuten köcheln, bis das Gemüse fast weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelte rote Paprika und Erbsen dazu und lasse alles weitere 5 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre geriebenen Cheddar ein, bis er geschmolzen ist, und würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß zu weißem Reis oder mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
