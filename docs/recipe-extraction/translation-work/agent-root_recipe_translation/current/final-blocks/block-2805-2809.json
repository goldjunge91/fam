      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer Schüssel und arbeite kalte Butter ein, bis die Mischung Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib verquirltes Ei und nach und nach Wasser dazu, bis ein Teig entsteht. Knete ihn vorsichtig glatt, wickle ihn ein und stelle ihn 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche gewürfelte Kartoffel 5-7 Minuten in kochendem Salzwasser, bis sie gerade weich ist, und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate Rinderhackfleisch mit gehacktem Knoblauch und Zwiebel etwa 8 Minuten gar. Rühre Kartoffel und Rosinen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig dünn zwischen Plastikfolien aus und schneide 3-inch große Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1 EL Füllung auf jeden Kreis, klappe ihn halbmondförmig zusammen und drücke die Ränder mit einer Gabel fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere die Empanadas insgesamt etwa 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit Essig oder süßer Chilisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
