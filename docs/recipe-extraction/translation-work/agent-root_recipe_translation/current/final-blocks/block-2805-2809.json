      "steps": [
        {
          "position": 0,
          "text": "Koche Schweinekopf oder -schulter 30 Minuten in Salzwasser, bis das Fleisch zart ist. Lasse es abkühlen und hacke es fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Hühnerleber in einem separaten Topf 5 Minuten, gieße sie ab und hacke sie fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher Hitze und brate gehackten Knoblauch und gewürfelte Zwiebel etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehacktes Schweinefleisch und Leber in die Pfanne und gare alles unter häufigem Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Limettensaft, Sojasauce, Essig und gehackte rote Chilischoten ein und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe die Mischung an den Rand der Pfanne, schlage ein Ei in die Mitte und verrühre es leicht. Vermische es dann mit dem Schweinefleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und serviere das Gericht heiß auf einer heißen Platte mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
