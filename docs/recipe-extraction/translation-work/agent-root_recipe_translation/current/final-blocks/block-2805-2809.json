      ],
      "steps": [
        {
          "position": 0,
          "text": "Bitte den Fischhändler, das Rückgrat zu entfernen und die Haut intakt zu lassen, oder filetiere den Fisch vorsichtig selbst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Schweinehackfleisch mit gehacktem Knoblauch und gewürfelter Zwiebel an. Rühre Rosinen, Oliven, Salz und Pfeffer ein und lasse die Mischung abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die abgekühlte Schweinefleischmischung gleichmäßig in den Bauchraum des Fisches.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle ein Ei in einer flachen Schale. Bestäube den gefüllten Fisch leicht mit Mehl, tauche ihn in das Ei und wende ihn erneut in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen Pfanne und brate den Fisch vorsichtig etwa 5-7 Minuten pro Seite goldbraun. Nimm ihn dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bereite im selben Öl eine einfache Mehlschwitze zu, indem du Mehl einrührst und 1 Minute garst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Tomatensauce und Wasser dazu und rühre glatt. Lege den Fisch zurück in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke die Pfanne ab und lasse alles 15-20 Minuten köcheln, bis der Fisch zart und die Sauce dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege den Fisch auf eine Platte und gieße vor dem Servieren die Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
