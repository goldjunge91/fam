      "steps": [
        {
          "position": 0,
          "text": "Schneide Sushi-Thunfisch in 3/4-inch große Würfel und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Sojasauce, Sesamöl, Reisessig, Ingwer und Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Marinade über den Thunfisch und vermische alles vorsichtig. Stelle die Schüssel dann 10 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile Sushi-Reis auf zwei Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jede Schale mit mariniertem Thunfisch und richte Avocadoscheiben daneben an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere das Gericht vor dem Servieren mit geschnittener Frühlingszwiebel und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
