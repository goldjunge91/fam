      "steps": [
        {
          "position": 0,
          "text": "Vermische Olivenöl, Kreuzkümmel, Chilipulver, Salz und Pfeffer und reibe die Mischung auf die Fischfilets.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Pfanne bei mittelhoher Hitze und gare den Fisch 4-5 Minuten pro Seite, bis er sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerteile den gegarten Fisch in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische fein geschnittenen Kohl mit dem Saft von 1 Limette und einer Prise Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme Tortillas in einer trockenen Pfanne 20 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische saure Sahne mit Koriander und dem Saft der zweiten Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Tortilla mit Fisch, Kohl, Avocado und Koriander-Limetten-Creme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
