      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Hähnchenstücke hinein und brate sie 5-6 Minuten unter Rühren, bis sie nicht mehr rosa sind. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib bei Bedarf weiteres Öl dazu und brate das Gemüse 3-4 Minuten unter Rühren, bis es bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hähnchen zurück in den Wok, füge gehackten Knoblauch und Ingwer hinzu und gare alles 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Sojasauce, Speisestärke und Wasser und gieße die Mischung in den Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge alles und gare es 1-2 Minuten, bis die Sauce eindickt und alle Zutaten überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle das Gericht auf eine Servierplatte, bestreue es mit Sesam und serviere es zu Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
