      "steps": [
        {
          "position": 0,
          "text": "Lege Hähnchenbrustfilets zwischen Frischhaltefolie und klopfe sie auf 1/2-inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Hähnchen mit Salz und Pfeffer und wende es leicht in Mehl. Schüttle Überschuss ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Butter und Olivenöl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Hähnchen 4-5 Minuten pro Seite goldbraun an und lege es dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Hühnerbrühe, Zitronensaft und Kapern in dieselbe Pfanne und löse gebräunte Reste vom Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Sauce 2-3 Minuten köcheln und lege dann das Hähnchen zurück in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles weitere 1-2 Minuten, bis das Hähnchen durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Richte das Hähnchen auf Pasta oder Reis an, gieße die Sauce darüber und garniere es mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
