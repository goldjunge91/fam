      "steps": [
        {
          "position": 0,
          "text": "Vermische Salz und Zucker im Verhältnis 2:1. Verteile Dill auf dem Lachs und reibe die Salz-Zucker-Mischung ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wickle den Lachs fest in Folie und stelle ihn 24–48 Stunden in den Kühlschrank. Wende ihn einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spüle die Beize ab und tupfe den Fisch trocken. Schneide ihn diagonal in dünne Scheiben.",
          "timerMinutes": null,
