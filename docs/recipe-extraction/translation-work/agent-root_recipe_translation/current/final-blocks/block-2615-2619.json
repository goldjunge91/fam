      "steps": [
        {
          "position": 0,
          "text": "Schneide das Fladenbrot in kleine Stücke und röste es im Ofen bei 375°F 8 Minuten, bis es knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Joghurt, gehackten Knoblauch und Salz in einer Schüssel, bis die Masse glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Kichererbsen aus der Dose ab, spüle sie ab und erwärme sie vorsichtig in einer Pfanne mit 1 Esslöffel Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Tahini mit Zitronensaft und etwas Wasser in einer weiteren Schüssel, bis eine Sauce zum Beträufeln entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile das geröstete Fladenbrot auf einem Teller, gib Joghurtsauce darauf und löffle die warmen Kichererbsen darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle alles mit Tahinisauce und vollende das Gericht mit Olivenöl, Granatapfelmelasse und Sumach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
