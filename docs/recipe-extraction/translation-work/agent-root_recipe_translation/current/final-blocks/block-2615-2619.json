      "steps": [
        {
          "position": 0,
          "text": "Spüle die Linsen unter kaltem Wasser ab und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 3 Esslöffel Olivenöl in einem großen Topf bei mittlerer Hitze, gib die Zwiebelringe hinzu und gare sie etwa 10 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Hälfte der karamellisierten Zwiebeln heraus und stelle sie als Garnitur beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Linsen, Reis, Kreuzkümmel, Salz und Pfeffer zu den übrigen Zwiebeln in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Gemüsebrühe hinzu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse alles 30 Minuten ohne Deckel köcheln, bis Linsen und Reis weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre gelegentlich um und gib bei Bedarf mehr Wasser hinzu, damit nichts ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Gericht auf eine Servierplatte und garniere es mit den beiseitegestellten knusprigen Zwiebeln und etwas Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
