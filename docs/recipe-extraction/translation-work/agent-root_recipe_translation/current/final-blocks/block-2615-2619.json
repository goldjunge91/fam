      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf oder Schmortopf bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Hähnchen mit Salz und Pfeffer, bräune es insgesamt 5 Minuten von allen Seiten und nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste im selben Topf die Zwiebeln etwa 4 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und Ingwer hinzu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in den Topf und füge Brühe, Aprikosen, Oliven und Zimt hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Köcheln, reduziere die Hitze, decke den Topf ab und lasse das Gericht 35-40 Minuten köcheln, bis das Hähnchen sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es mit Couscous oder Brot, um die Sauce aufzunehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
