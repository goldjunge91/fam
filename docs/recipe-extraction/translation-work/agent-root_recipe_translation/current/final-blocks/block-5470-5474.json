      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und lege ein Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe die Hähnchenflügel mit Küchenpapier trocken und gib sie in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Paprikapulver, Cayennepfeffer, Knoblauchpulver, Zwiebelpulver, schwarzen Pfeffer und Salz in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle die Flügel mit Olivenöl und vermische sie, bis sie gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Streue die Gewürzmischung darüber und vermenge alles, bis die Flügel vollständig gewürzt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Flügel in einer Lage auf dem vorbereiteten Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie 25-30 Minuten knusprig und goldbraun und wende sie nach der Hälfte der Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle die fertigen Flügel mit Honig und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
