      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen schweren Topf bei mittlerer Hitze und rühre Mehl ein. Gare die Mehlschwitze unter ständigem Rühren 20-25 Minuten, bis sie tief schokoladenbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel, Sellerie, Paprika und Knoblauch zur Mehlschwitze und gare alles unter häufigem Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe unter Rühren langsam hinzu, damit sich keine Klumpen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Lorbeerblätter und Cayennepfeffer hinzu, bringe alles zum Kochen und reduziere dann die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bräune Andouille-Wurstscheiben in einer separaten Pfanne und gib sie dann zum Gumbo.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse das Gumbo 30 Minuten unter gelegentlichem Rühren köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib geschnittene Okra hinzu und lasse alles weitere 15-20 Minuten köcheln, bis die Okra zart und das Gumbo eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne die Lorbeerblätter und serviere das Gumbo auf gekochtem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
