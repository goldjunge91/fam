      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig zu, indem du kalte Butter mit Mehl und Salz zu einer Semmelbrösel-Textur verarbeitest. Gib nach und nach Wasser hinzu, bis ein Teig entsteht, und kühle ihn 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Lammhackfleisch mit gewürfelter Zwiebel in einer Pfanne, würze mit Salz und Pfeffer, gib dann Rinderbrühe hinzu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in zwei Hälften und rolle ihn auf einer bemehlten Fläche passend für eine 4-Zoll-Pastetenform samt Deckel aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die mit Teig ausgelegte Form mit der Lammfleischmischung, lege den Teigdeckel darauf, verschließe die Ränder mit einer Gabel, bestreiche sie mit verquirltem Ei und schneide kleine Dampfschlitze hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Pastete bei 400°F 35-40 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie vor dem Herausnehmen aus der Form und warmen Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
