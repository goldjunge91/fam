      "steps": [
        {
          "position": 0,
          "text": "Koche gewürfelte Steckrübe 15 Minuten in Salzwasser, bis sie weich genug zum Einstechen mit einer Gabel ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche gewürfelte Kartoffeln in einem separaten Topf 15 Minuten in Salzwasser, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Steckrübe und Kartoffeln getrennt ab und zerdrücke sie jeweils mit 1.5 EL Butter und 2 EL Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze das Steckrübenpüree mit Salz, Pfeffer und Muskatnuss und das Kartoffelpüree mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme den Haggis nach Packungsanleitung (normalerweise 15 Minuten in kochendem Wasser oder 8 Minuten in der Mikrowelle).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Steckrüben- und Kartoffelpüree auf Tellern an, lege den Haggis in die Mitte und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
