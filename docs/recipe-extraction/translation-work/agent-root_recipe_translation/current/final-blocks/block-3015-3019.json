      "steps": [
        {
          "position": 0,
          "text": "Öl in einer Pfanne bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Andouille-Würste der Länge nach halbieren und mit der Schnittseite nach unten in die Pfanne legen; pro Seite 4 Minuten braten, bis sie gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Po' Boy-Brötchen in der Pfanne pro Seite 1 Minute leicht toasten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Innenseiten der Brötchen mit Mayonnaise bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Salat, Tomate und Zwiebel auf die untere Hälfte jedes Brötchens schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gegarte Wursthälften auf das Gemüse legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gewürzgurken und etwas scharfe Sauce hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sandwich schließen und sofort servieren.",
          "timerMinutes": null,
