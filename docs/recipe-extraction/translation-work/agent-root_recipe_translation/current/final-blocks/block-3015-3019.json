      "steps": [
        {
          "position": 0,
          "text": "Maniokblätter gründlich waschen und von den Stielen entfernen; harte Teile entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maniokblätter sehr fein hacken oder zerstampfen (traditionell im Mörser).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem großen Topf erhitzen und Hackfleisch bei mittelhoher Hitze anbraten, dabei in kleine Stücke zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebel, Knoblauch und Ingwer hinzufügen und 3 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatenmark einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wasser hinzufügen und aufkochen, dann Hitze reduzieren und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gehackte Maniokblätter und Kokosmilch einrühren, abdecken und 30 Minuten köcheln lassen; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Cayennepfeffer würzen und mit Reis, Kochbananen oder Maniokwurzel servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
