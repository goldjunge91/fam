      "steps": [
        {
          "position": 0,
          "text": "Öl in einer Fritteuse oder einem großen Topf auf 350°F erhitzen und Kartoffelspalten 8-10 Minuten goldbraun frittieren; auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öltemperatur auf 375°F erhöhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Backpulver, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bier und Ei verquirlen, dann mit den trockenen Zutaten zu einem dickflüssigen Teig vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fischfilets mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jedes Filet in den Teig tauchen, vollständig überziehen und vorsichtig ins heiße Öl geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "6-8 Minuten goldbraun frittieren, bis sich der Fisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einer Schaumkelle herausnehmen, auf Küchenpapier abtropfen lassen, leicht salzen und mit Pommes, Zitronenspalten und Malzessig servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
