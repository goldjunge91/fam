      "steps": [
        {
          "position": 0,
          "text": "Brühe in einem separaten Topf erhitzen und auf dem Herd sanft köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pilze in Olivenöl bei mittelhoher Hitze goldbraun anbraten und dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einem großen Topf 1 tbsp Butter bei mittlerer Hitze schmelzen und Zwiebel sowie Knoblauch etwa 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis hinzufügen und unter ständigem Rühren 1 Minute anrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wein angießen und rühren, bis er aufgenommen ist; dann nach und nach eine Kelle warme Brühe hinzufügen, häufig rühren und warten, bis jede Zugabe aufgenommen ist, bevor mehr dazukommt (insgesamt etwa 18-20 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wenn der Reis cremig und al dente ist, vom Herd nehmen und restliche Butter, Parmesan, Pilze, Salz sowie Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 1 Minute ruhen lassen, dann sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
