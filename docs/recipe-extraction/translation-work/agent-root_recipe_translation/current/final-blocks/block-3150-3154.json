      "steps": [
        {
          "position": 0,
          "text": "Brühe in einem Topf mit Ingwer, Knoblauch und Salz zum Kochen bringen, dann ganze Hähnchenbrust hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "15 Minuten köcheln lassen, bis das Hähnchen durch ist, dann herausnehmen und in mundgerechte Stücke zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kochbrühe durch ein feinmaschiges Sieb abseihen und 2.5 cups Brühe aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis unter kaltem Wasser abspülen, mit der aufbewahrten Brühe in den Topf geben und aufkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren, abdecken und 15 Minuten köcheln lassen, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasauce, Fischsauce und Reisessig in einer kleinen Schüssel als Sauce zum Servieren vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reis auf Schalen verteilen, mit zerpflücktem Hähnchen belegen, mit Koriander und Frühlingszwiebeln garnieren und Sauce dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
