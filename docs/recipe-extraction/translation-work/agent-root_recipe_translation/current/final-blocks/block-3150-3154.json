      "steps": [
        {
          "position": 0,
          "text": "1 tbsp Butter in einem großen Topf bei mittelhoher Hitze erhitzen und Rinderhackfleisch etwa 5 Minuten anbräunen, dabei zerteilen; beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf 1 tbsp Butter schmelzen und Zwiebel, Karotte sowie Sellerie (Soffritto) etwa 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 1 Minute garen, dann das gegarte Rindfleisch zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wein angießen und etwa 3 Minuten köcheln lassen, bis er größtenteils aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brühe in einem separaten Topf erhitzen und sanft köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reis zum Ragù geben und unter ständigem Rühren 1 Minute anrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nach und nach jeweils eine Kelle warme Brühe hinzufügen, häufig rühren und warten, bis jede Zugabe aufgenommen ist, bevor mehr dazukommt (insgesamt etwa 18-20 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenn der Reis cremig und al dente ist, vom Herd nehmen und restliche Butter sowie Parmesan einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit Salz und Pfeffer würzen, 1 Minute abgedeckt ruhen lassen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
