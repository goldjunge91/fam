      "steps": [
        {
          "position": 0,
          "text": "Die Ramen-Nudeln 3 Minuten in kochendem Salzwasser garen, abgießen und unter kaltem Wasser abspülen, bis sie abgekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine Pfanne bei mittlerer bis hoher Hitze erwärmen. Die Hähnchenbrustscheiben 4 Minuten garen und dabei mit Sojasauce und Mirin würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dashi-Brühe mit Sojasauce und Mirin zu einer kalten Brühe verrühren und im Kühlschrank kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Eier 6–7 Minuten weich kochen, abkühlen lassen und halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die kalten Nudeln auf zwei Schüsseln verteilen und mit der kalten Brühe übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Hähnchen, Gurke, Tomate, halbierten weichgekochten Eiern, Nori-Streifen, Sesam und Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
