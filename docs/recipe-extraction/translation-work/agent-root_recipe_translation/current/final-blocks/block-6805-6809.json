      "steps": [
        {
          "position": 0,
          "text": "Buchweizenmehl und Salz in einer Schüssel vermischen. Unter Rühren nach und nach Wasser zugießen, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer beschichteten Pfanne bei mittlerer Hitze erwärmen. Löffelweise Teig hineingeben und mit der Löffelrückseite leicht flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jeden Buchweizenfladen auf jeder Seite 3–4 Minuten braten, bis er goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sojasauce, Mirin und Dashi-Brühe in einer kleinen Schüssel zu einer Glasur verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Glasur auf beide Seiten der gegarten Fladen streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Soba Gaki auf Tellern anrichten und vor dem Servieren mit gehackten Frühlingszwiebeln und Sesam bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
