      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Ackerbohnen abspülen und mindestens 4 Stunden oder über Nacht in Wasser einweichen. Anschließend abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen. Zwiebel und Schinken 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch und Paprikapulver dazugeben und 1 Minute anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hühnerbrühe angießen und eingeweichte Bohnen, Kartoffelwürfel sowie Lorbeerblatt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 25–30 Minuten köcheln lassen, bis Bohnen und Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und nach Bedarf mit Salz und Pfeffer würzen, dann heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
