      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf mit Salzwasser zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Nudeln hinein, rühre einmal um und koche sie etwa 10 Minuten oder gemäß Packungsanweisung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wasche währenddessen die Tomaten und schneide sie in Viertel. Schneide die Oliven in Scheiben. Wasche das Basilikum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Tomaten in eine Salatschüssel und zupfe die Basilikumblätter darüber. Gib einen Esslöffel Olivenöl hinzu und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn die Nudeln gar sind, gieße sie in ein Sieb ab und spüle sie mit kaltem Wasser ab, damit sie schnell abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Nudeln mit Tomaten und Basilikum in die Salatschüssel und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge die geschnittenen Oliven, abgetropften Mozzarellakugeln und Thunfischstücke hinzu. Gut vermischen und den Salat mindestens eine halbe Stunde ruhen lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue kurz vor dem Servieren reichlich frisch gemahlenen schwarzen Pfeffer über die Nudeln und beträufle sie mit dem restlichen Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
