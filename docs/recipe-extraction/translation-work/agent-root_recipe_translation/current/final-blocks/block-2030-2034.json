      "steps": [
        {
          "position": 0,
          "text": "Zerbrösele das Brot in kleine Stücke. Besprenkle es mit kaltem Wasser, decke es mit einem feuchten Tuch ab und lasse es 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tsp Olivenöl in einer tiefen Pfanne. Gib die Knoblauchzehen mit Schale einzeln hinein. Schneide jede Zehe mit einem Messer leicht ein und brate sie 5 Minuten weiter. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse das Brot im selben Öl, in dem alles gebraten wurde, unter ständigem Rühren 15 Minuten köcheln und mahle etwas schwarzen Pfeffer darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Knoblauch hinzu und rühre etwa 20 Minuten weiter. Das Gericht ist fertig, wenn das Brot weich und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
