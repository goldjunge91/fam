      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Aubergine der Länge nach in 1/4-inch dicke Scheiben, salze beide Seiten und lasse sie 15 Minuten ruhen, damit Flüssigkeit austritt. Tupfe sie dann mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle drei Schüsseln bereit: eine mit Mehl, eine mit verquirlten Eiern und eine mit Panko und 1/2 cup Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende jede Auberginenscheibe in Mehl, tauche sie in Ei und überziehe sie dann mit der Bröselmischung. Drücke diese leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze und brate die Auberginenscheiben portionsweise 3 Minuten pro Seite goldbraun an. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile eine dünne Schicht Marinara-Sauce auf dem Boden einer 9x13-inch-Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte Auberginenscheiben, Sauce und Mozzarella in die Form. Wiederhole die Schichten und schließe mit Sauce und dem übrigen Mozzarella ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Auflauf 20 Minuten, bis der Käse geschmolzen ist und blubbert. Garniere ihn vor dem Servieren mit frischem Basilikum und dem restlichen Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
