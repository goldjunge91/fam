      ],
      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eier in einer Schüssel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 EL Pflanzenöl in einem großen Wok oder einer Pfanne bei hoher Hitze. Gieße die Eier hinein und rühre sie gar. Nimm sie dann heraus und hacke sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die übrigen 2 EL Öl in den Wok und brate gewürfelte Zwiebel und Knoblauch 1 Minute unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib tiefgekühlte Erbsen und Karotten dazu und rühre 2 Minuten ständig, bis alles durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekühlten Reis dazu, löse Klümpchen auf und brate ihn 3-4 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Sojasauce und Sesamöl über den Reis und vermenge alles, bis der Reis gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Rührei zurück in den Wok und hebe es vorsichtig unter den Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Frühlingszwiebeln dazu, würze nach Geschmack mit Salz und weißem Pfeffer und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
