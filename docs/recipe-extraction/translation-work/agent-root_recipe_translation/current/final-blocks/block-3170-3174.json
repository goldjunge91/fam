      "steps": [
        {
          "position": 0,
          "text": "Schneide Speck in kleine Stücke und brate ihn in einem großen Topf bei mittlerer Hitze knusprig an. Nimm ihn heraus und stelle ihn beiseite. Lasse das Fett im Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze Hähnchenschenkel mit Salz und Pfeffer und bräune sie mit der Hautseite nach unten 6 Minuten im Speckfett an. Wende sie, gare sie weitere 4 Minuten und nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate im selben Topf Pilze und Perlzwiebeln bei mittelhoher Hitze 5 Minuten goldbraun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und Tomatenmark in den Topf und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Rotwein in den Topf und löse gebräunte Reste vom Boden. Gib dann Hühnerbrühe, Lorbeerblatt und Thymian dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Hähnchenschenkel mit der Hautseite nach oben zurück in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf ab und lasse alles 45 Minuten köcheln, bis das Hähnchen zart und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Pilze, Perlzwiebeln und Speck zurück in den Topf und lasse alles weitere 5 Minuten ohne Deckel köcheln. Würze mit Salz und Pfeffer und serviere es zu Eiernudeln oder mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
