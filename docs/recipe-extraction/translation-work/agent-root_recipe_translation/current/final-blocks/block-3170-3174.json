      "steps": [
        {
          "position": 0,
          "text": "Weiche Reisnudeln 20 Minuten in Wasser bei Raumtemperatur ein, bis sie biegsam sind, und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Presse überschüssige Flüssigkeit aus dem Tofu, indem du ihn zwischen Küchenpapier legst. Schneide ihn dann in kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Tamarindenpaste, Fischsauce, braunen Zucker und Limettensaft in einer kleinen Schüssel und stelle die Sauce beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem großen Wok oder einer Pfanne bei hoher Hitze und brate Tofuwürfel 3 Minuten an, bis sie leicht goldbraun sind. Nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe das Öl an den Rand des Woks, gieße die verquirlten Eier hinein und rühre sie teilweise gar. Vermische sie dann mit dem Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib abgetropfte Nudeln, Paprika und Zuckerschoten dazu und brate alles 2 Minuten unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gieße die Sauce über die Nudeln und vermenge alles 2 Minuten. Gib den Tofu zurück in den Wok und mische ihn unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere das Gericht mit zerstoßenen Erdnüssen, Frühlingszwiebeln und Limettenspalten garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
