      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 9x13 inch große Backform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier und Zucker etwa 3 Minuten, bis die Masse hell und luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe Mehl, Backpulver, Salz und Vanille vorsichtig unter, bis alles gerade eben vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den Teig in die Form und backe ihn 25-30 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stich mit einer Gabel Löcher über die gesamte Oberfläche des warmen Kuchens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge gezuckerte Kondensmilch, Kondensmilch und Sahne und gieße die Mischung langsam über den Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass den Kuchen vollständig abkühlen und stelle ihn dann mindestens 4 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche den Kuchen vor dem Servieren mit Schlagsahne und garniere ihn mit Maraschinokirschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
