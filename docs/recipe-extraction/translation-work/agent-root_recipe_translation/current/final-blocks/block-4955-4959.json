      "steps": [
        {
          "position": 0,
          "text": "Röste Sichuan-Pfeffer 2 Minuten in einer trockenen Pfanne bei mittlerer Hitze, bis er duftet. Zerdrücke ihn anschließend leicht mit der Rückseite eines Löffels.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einem großen Topf und dünste zerdrückten Knoblauch und geschnittenen Ingwer 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gerösteten Pfeffer, getrocknete Chilischoten und Sternanis dazu und brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Brühe und Wasser dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lass die Brühe 10-15 Minuten köcheln, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Sojasauce und Sesamöl ein und passe die Würzung nach Geschmack an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Brühe für eine mildere Variante durch ein Sieb oder lass Pfefferkörner und Chilischoten für mehr Geschmack darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die Brühe in einen Hotpot oder halte sie im Topf warm, um dünn geschnittenes Fleisch und Gemüse hineinzutunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
