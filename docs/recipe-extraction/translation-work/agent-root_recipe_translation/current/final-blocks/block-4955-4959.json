          "position": 3,
          "text": "Gib Tomatenmark dazu und brate es unter ständigem Rühren 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Krabbenschalen und getrocknete Garnelen dazu und gare sie 3 Minuten. Gieße Wasser dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze und lass die Brühe 30 Minuten köcheln, damit sie das Krabbenaroma aufnimmt. Gieße sie dann durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Brühe zurück in den Topf und rühre Fischsauce und Zucker ein. Gib das Krabbenfleisch wieder dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Koche die Reisfadennudeln nach Packungsanleitung. Schneide den Tofu in Würfel und lass ihn kurz in der Brühe köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Verteile die Nudeln auf Schüsseln, schöpfe Krabbenbrühe darüber und gib Tofuwürfel darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere die Suppe mit frischen Kräutern, Limettenspalten und zusätzlicher Fischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
