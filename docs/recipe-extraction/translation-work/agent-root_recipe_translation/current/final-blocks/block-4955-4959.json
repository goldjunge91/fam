      "steps": [
        {
          "position": 0,
          "text": "Weiche die getrockneten Chilischoten 10 Minuten in heißem Wasser ein. Gieße sie ab und püriere sie mit Knoblauch, Schalotten, Galgant, Kurkuma und Garnelenpaste zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und brate die Gewürzpaste unter ständigem Rühren 5 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Fischstücke dazu und gare sie 3-4 Minuten. Zerteile sie dabei in kleinere Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wasser dazu und bringe die Brühe zum Kochen. Lass sie anschließend 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Brühe durch ein feines Sieb, entsorge die festen Bestandteile und gib die Brühe zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Tamarindenpaste, Fischsauce und Kokosmilch ein und lass die Suppe weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Reisnudeln separat nach Packungsanleitung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Nudeln auf Schüsseln, schöpfe die Brühe darüber und garniere sie mit Gurkenscheiben sowie weiteren Beilagen wie Fischsauce und Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
