      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Schweineknochen und Schweinefleisch 5 Minuten in kochendem Wasser. Gieße das Wasser ab und spüle alles unter kaltem Wasser sauber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gib die gereinigten Knochen, Schweinefleisch, halbierte Zwiebel, zerdrückten Ingwer und Knoblauchzehen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sobald die Brühe kocht, reduziere die Hitze und lass sie ohne Deckel 3-4 Stunden köcheln. Schöpfe regelmäßig Fett und Verunreinigungen ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Schweinefleisch nach 1.5 Stunden heraus, schneide es dünn auf und stelle es für die Toppings beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Brühe nach insgesamt 3-4 Stunden durch ein feines Sieb und würze sie mit Sojasauce, Mirin und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Ramen-Nudeln nach Packungsanleitung, normalerweise 3-4 Minuten, und lass sie abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Eier 7 Minuten, bis sie weich sind. Schäle und halbiere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Nudeln auf zwei große Schüsseln und schöpfe heiße Tonkotsu-Brühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Belege jede Schüssel mit Schweinefleischscheiben, halben weich gekochten Eiern, Nori-Streifen, geschnittenen Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Beträufle die Toppings mit Chiliöl und serviere die Ramen sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
