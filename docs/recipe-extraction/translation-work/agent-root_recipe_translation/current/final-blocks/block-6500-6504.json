      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und brate die Rindfleischstücke insgesamt 8 Minuten von allen Seiten braun an. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate gewürfelte Zwiebel und Knoblauch im selben Topf etwa 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib stückige Tomaten, Rinderbrühe, Zimtstange und Lorbeerblatt zusammen mit dem Fleisch zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lass das Fleisch 45 Minuten köcheln, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Orzo-Nudeln ein und lass alles 15 Minuten köcheln, bis die Nudeln gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer und entferne Zimtstange und Lorbeerblatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß und bestreue es mit geriebenem Pecorino Romano.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
