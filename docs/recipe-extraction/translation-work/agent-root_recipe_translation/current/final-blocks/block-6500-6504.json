      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mehl, Eier, Milch, Salz und Pfeffer zu einem glatten Teig und lass ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1/2 Esslöffel Öl in einer beschichteten 10-inch-Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße 1/4 cup Teig in die Pfanne und schwenke sie rasch, damit sich der Teig dünn verteilt. Backe ihn 1 Minute goldgelb, wende ihn und backe ihn weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe den Pfannkuchen auf ein Schneidebrett und wiederhole den Vorgang mit dem restlichen Teig. Staple die Pfannkuchen mit Backpapier dazwischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide jeden abgekühlten Pfannkuchen in etwa 1/2 inch breite Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmilz Butter in einem Topf und brate gehackte Zwiebel 2 Minuten an. Gib gehackte Petersilie dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass Rinderbrühe aufköcheln, gib die Pfannkuchenstreifen dazu und gare sie 3-4 Minuten, bis sie heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schöpfe die Suppe in Schalen und serviere sie heiß als wärmende Mahlzeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
