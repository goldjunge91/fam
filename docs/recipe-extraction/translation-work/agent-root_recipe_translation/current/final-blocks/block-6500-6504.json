      "steps": [
        {
          "position": 0,
          "text": "Weiche Schweinenetz oder Speckstreifen 10 Minuten in warmem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Schweine- und Rinderhackfleisch mit fein gewürfelter Zwiebel, gehackter Petersilie, Koriandersamen, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme aus der Fleischmischung 8 längliche Frikadellen von etwa 3 inches Länge und 1 inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wickle jede Frikadelle vollständig mit Schweinenetz oder Speckstreifen ein, die sich überlappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate Sheftalia pro Seite 6-7 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare sie weiter, bis ein Fleischthermometer eine Kerntemperatur von 160°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Sheftalia heiß mit Zitronenspalten und Pita-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
