      "steps": [
        {
          "position": 0,
          "text": "Vermenge Essig, Wein, Zwiebel, Karotte, Sellerie, Wacholderbeeren und Lorbeerblätter in einer großen Schüssel mit dem Rindfleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke die Schüssel ab und mariniere das Fleisch 24-48 Stunden im Kühlschrank. Wende es gelegentlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Rindfleisch aus der Marinade, tupfe es mit Küchenpapier trocken und stelle die Marinade beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Marinade ab. Bewahre Flüssigkeit und Gemüse getrennt auf und entsorge Lorbeerblätter und Wacholderbeeren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl in einem großen Topf und brate das Rindfleisch pro Seite 3-4 Minuten rundherum braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue das Fleisch mit Mehl und bräune es 1 Minute. Gib das beiseitegestellte Gemüse dazu und brate es 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Marinadenflüssigkeit und Rinderbrühe über das Fleisch. Bringe alles zum Köcheln, decke den Topf ab und gare das Fleisch 2-2.5 Stunden, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm das Rindfleisch heraus und decke es locker mit Folie ab. Seihe die Sauce ab, rühre Zucker ein, lass sie 5 Minuten köcheln und gieße sie über das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
