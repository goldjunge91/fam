      "steps": [
        {
          "position": 0,
          "text": "Maniokwurzel schälen und mit einer Reibe oder Küchenmaschine fein raspeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Überschüssige Flüssigkeit aus dem geraspelten Maniok mit einem Passiertuch oder sauberen Küchentuch ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ausgedrückten Maniok mit Salz und gehacktem Knoblauch zu einem Teig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig zu flachen, runden Fladen von etwa 0.5 inches Dicke formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einem tiefen Topf auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bammy-Fladen insgesamt etwa 3-4 Minuten goldbraun und knusprig frittieren, dabei beide Seiten bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit scharfer Sauce oder einer Dip-Sauce nach Wahl servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
