      "steps": [
        {
          "position": 0,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fein gewürfelte Zwiebel hinzufügen und etwa 2 Minuten glasig dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maniokmehl nach und nach unter ständigem Rühren hinzufügen, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weiter rühren und nach und nach etwas Wasser zugießen, bis eine dicke, formbare Paste entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geriebenen Käse einrühren, bis er vollständig geschmolzen und die Mischung goldgelb ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem Löffel Häufchen auf einen Teller setzen oder die Masse in der Pfanne flach drücken und zu Fladen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fladen braten oder toasten, bis die Ränder knusprig sind, oder warm direkt aus der Pfanne servieren.",
