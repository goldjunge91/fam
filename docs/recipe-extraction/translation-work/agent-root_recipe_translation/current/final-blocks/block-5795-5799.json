          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kurz abkühlen lassen, fein hacken und mit Salz und Pfeffer zur Dukkah-Gewürzmischung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis niedriger Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier vorsichtig in die Pfanne schlagen und etwa 4-5 Minuten braten, bis das Eiweiß gestockt und das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die gegarten Eier großzügig mit Dukkah bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
