      "steps": [
        {
          "position": 0,
          "text": "1 Esslöffel Öl in einem großen Wok oder einer Pfanne bei starker Hitze erhitzen. Eier zu Rührei braten, bis sie gar sind, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das restliche Öl in den Wok geben und fein gehackten Knoblauch 30 Sekunden unter Rühren braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sambal Oelek hinzufügen und 30 Sekunden braten. Dann den gekochten Reis hinzufügen und Klümpchen auseinanderdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Reis 3-4 Minuten unter Rühren braten, bis er durchgewärmt und mit Sambal überzogen ist. Tiefgekühltes Gemüse und Sojasauce hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2-3 Minuten kochen, bis das Gemüse warm ist. Rührei und geschnittene Frühlingszwiebel unterheben und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
