      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl und brate das Hähnchen etwa 5 Minuten unter Rühren, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib schwarzen Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle die Eier, nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl und den kalten Reis dazu, löse Klumpen und brate alles 2 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte grüne Bohnen dazu und brate sie 2 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Hähnchen und Eier zurück in die Pfanne, gieße Sojasoße und Fischsoße dazu und vermenge alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere den Bratreis mit Frühlingszwiebeln und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
