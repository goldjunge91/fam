      "steps": [
        {
          "position": 0,
          "text": "Bringe Hühnerbrühe in einem großen Topf bei mittlerer bis hoher Hitze zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehack und Leber dazu, zerkleinere das Fleisch beim Garen und koche es etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel, Salz, Pfeffer und Salbei dazu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Maisgrieß langsam und unter ständigem Rühren ein, damit keine Klumpen entstehen. Gare ihn etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und rühre 20 Minuten häufig, bis die Masse sehr dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege eine Kastenform mit Frischhaltefolie aus, gieße die Masse hinein und streiche die Oberfläche glatt. Stelle sie über Nacht oder mindestens 4 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Scrapple aus der Form und schneide es in 0.5-inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer Hitze und brate die Scheiben etwa 3 Minuten pro Seite goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
