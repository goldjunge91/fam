      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebel und hacke Knoblauch und Ingwer. Dünste alles in 2 Esslöffeln Butter, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Garnelen, Fisch und Jakobsmuscheln in mundgerechte Stücke, gib sie in die Pfanne und gare sie 5 Minuten, bis sie undurchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gehackten Koriander ein und lasse die Mischung leicht abkühlen. Rühre dann 2 verquirlte Eier ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche 5 Filoteigblätter mit geschmolzener Butter und schichte sie übereinander. Verteile die Meeresfrüchtemischung mittig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe den Filoteig über die Füllung und rolle ihn zu einem festen Päckchen. Bestreiche es mit der restlichen Butter und verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Bastilla bei 375°F 25 Minuten goldbraun und bestäube sie dann mit einer Mischung aus Zimt und Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
