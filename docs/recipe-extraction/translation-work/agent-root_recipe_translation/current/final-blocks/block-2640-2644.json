      "steps": [
        {
          "position": 0,
          "text": "Hacke den Knoblauch und vermische ihn mit Kreuzkümmel, Paprikapulver, Salz, Pfeffer, Olivenöl und Zitronensaft zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ritze die Haut des Lamms rautenförmig ein und reibe das Fleisch rundherum mit der Gewürzpaste ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Lamm mit der Hautseite nach oben auf einen Bratrost und brate es bei 325°F 3 Stunden. Übergieße es alle 45 Minuten mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhöhe die Hitze auf 450°F in den letzten 15 Minuten, damit die Haut knusprig und goldbraun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse das Lamm 10 Minuten ruhen, tranchiere es und serviere es mit warmem Fladenbrot und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
