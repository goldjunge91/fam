      "steps": [
        {
          "position": 0,
          "text": "Vermische Hartweizengrieß, Mehl, Salz und Backpulver in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe geschmolzene Butter in die trockene Mischung ein, bis sie Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 2-3 tablespoons Wasser dazu und vermische alles, bis der Teig feucht, aber nicht klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hacke die Datteln fein und forme kleine Kugeln mit etwa 1 inch Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm einen Löffel Teig, drücke ihn flach, lege eine Dattelkugel in die Mitte und verschließe den Teig darum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere die Makroudh 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Honig und Wasser in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tauche die warmen Makroudh sofort in die Honigmischung und wende sie gründlich darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
