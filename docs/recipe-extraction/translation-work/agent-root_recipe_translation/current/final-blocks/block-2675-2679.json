      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer großen Schüssel, gib warmes Wasser dazu und knete den Teig 8 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn 15 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 6 gleich große Kugeln und lasse sie weitere 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ziehe eine Teigkugel auf einer geölten Fläche sehr dünn auseinander, bis sie fast durchsichtig ist, und bestreiche sie großzügig mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falte den Teig der Länge nach in Drittel und dann der Breite nach erneut in Drittel, sodass ein quadratisches Päckchen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze eine beschichtete Pfanne oder Grillplatte bei mittelhoher Hitze mit einer dünnen Schicht Öl oder Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das gefaltete Teigquadrat in die heiße Pfanne und gare es 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es sofort, mit Honig beträufelt und nach Wunsch mit Zimt bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Wiederhole den Vorgang mit den übrigen Teigkugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
