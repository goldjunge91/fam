      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebel und Petersilie fein und vermische sie mit Salz, Pfeffer und Harissa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 EL Olivenöl in einer kleinen Pfanne bei mittlerer Hitze und brate die Zwiebelmischung 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege ein Brickteigblatt auf die Arbeitsfläche und gib die Zwiebelmischung auf ein Viertel des Blatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage ein Ei auf die Mischung und falte das Brickteigblatt zu einem Dreieck, wobei du die Seiten einschlägst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das restliche Olivenöl in einer Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere das Brick-Dreieck 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
