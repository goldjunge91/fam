      "steps": [
        {
          "position": 0,
          "text": "Erhitze 3 tablespoons Butter in einem großen Topf und bräune die Hähnchenstücke pro Seite 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln, Knoblauch, Zimtstange, Ingwer und Kurkuma dazu und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe dazu und bringe sie zum Köcheln. Gare das Hähnchen dann zugedeckt 30 Minuten, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste Mandeln 3 Minuten in einer trockenen Pfanne und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bereite Couscous nach Packungsanweisung mit 2 cups Brühe aus dem Hähnchentopf zu und lockere ihn dann mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die übrige Butter, Rosinen und gerösteten Mandeln vorsichtig unter den Couscous.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere die Hühnerbrühe und passe die Würzung mit Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Häufle die Couscousmischung auf eine Servierplatte, richte die Hähnchenstücke darauf an und schöpfe Brühe um den Couscous herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht heiß und garniere es nach Wunsch mit zusätzlichen Mandeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
