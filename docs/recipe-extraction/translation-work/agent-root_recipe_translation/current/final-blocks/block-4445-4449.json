        },
        {
          "position": 1,
          "text": "Entferne die Stiele vom Grünkohl und schneide die Blätter in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib in den letzten 5 Minuten der Kartoffelkochzeit den gehackten Grünkohl ins kochende Wasser.",
