          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Erdnussbutter, Sojasauce, Reisessig, Sesamöl, gehackten Knoblauch und Wasser in einer kleinen Schüssel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Gurke in feine Streifen und die Frühlingszwiebeln in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die gekühlten Nudeln auf zwei Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Erdnusssauce über die Nudeln und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Gurke, Frühlingszwiebeln und zerstoßene Erdnüsse darauf und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
