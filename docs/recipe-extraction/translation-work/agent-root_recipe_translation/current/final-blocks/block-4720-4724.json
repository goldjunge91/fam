      "steps": [
        {
          "position": 0,
          "text": "Weiche den Klebreis 30 Minuten in Wasser ein. Gieße ihn ab und koche ihn in frischem Wasser etwa 20 Minuten, bis er klebrig und weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche den Schweinebauch 15 Minuten mit Salz und schwarzem Pfeffer, bis er teilweise gar ist, und schneide ihn dann in Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische gekochten Reis und Schweinefleisch mit gehacktem Knoblauch, Fischsauce und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Blanchiere Bananenblätter kurz in kochendem Wasser, damit sie weich werden, und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ein Bananenblattquadrat auf die Arbeitsfläche. Gib in die Mitte eine Schicht Reismischung, einen Löffel Mungbohnenpaste und darauf eine weitere Schicht Reismischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falte die Ecken des Bananenblatts zu einem quadratischen Päckchen über die Füllung. Wickle ein weiteres Bananenblatt darum und binde es mit Küchengarn zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Päckchen 45 Minuten in Wasser, bis der Reis gar ist und zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie leicht abkühlen, bevor du sie auswickelst und mit Fischsaucen-Dip servierst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
