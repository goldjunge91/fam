      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Wasser zum Kochen. Koche die Reisnudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 EL Öl in einem großen Topf bei mittlerer Hitze und dünste Laksa-Paste, Knoblauch und Ingwer 2 Minuten an, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kokosmilch und Hühnerbrühe dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfeltes Hähnchen hinzu und gare es 8 Minuten, bis es fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre grüne Bohnen, Garnelen, Fischsauce und Limettensaft ein und lasse alles 5 Minuten köcheln, bis die Garnelen rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche währenddessen Eier in einem separaten Topf 6-7 Minuten weich. Schäle und halbiere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Nudeln auf vier Schüsseln und schöpfe Laksa-Brühe mit Hähnchen und Garnelen darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere jede Schüssel mit Eihälften und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
