      "steps": [
        {
          "position": 0,
          "text": "Maisschalen oder Kochbananenblätter 30 Minuten in warmem Wasser einweichen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen mit der Hälfte der Zwiebel und Salz kochen, bis es gar ist, dann zerkleinern und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter mit Salz cremig schlagen, dann nach und nach Masa Harina und warme Brühe hinzufügen und verrühren, bis die Masse leicht und locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Restliche Zwiebel und Knoblauch in einer Pfanne anbraten, zerkleinertes Hähnchen, Oliven und Rosinen hinzufügen und 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein weiches Blatt flach auslegen, eine dünne Schicht Masa in die Mitte streichen, mit Hähnchenfüllung belegen und die Seiten nach innen falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Tamales mit Maisschalenstreifen zusammenbinden und aufrecht in einen Dämpftopf mit etwa 2 Zoll Wasser am Boden stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit zusätzlichen Maisschalen bedecken und 45 Minuten dämpfen, bis sich die Masa leicht vom Blatt löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
