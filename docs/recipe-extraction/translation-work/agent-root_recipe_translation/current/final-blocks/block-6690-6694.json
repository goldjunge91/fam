      "steps": [
        {
          "position": 0,
          "text": "Maniok schälen, in 2 Zoll große Stücke schneiden und 15 Minuten in Salzwasser kochen, bis er weich ist. Abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Grüne Kochbananen schälen und in dicke Ringe schneiden, separat 10 Minuten kochen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebeln und Knoblauch darin anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischbrühe hinzufügen und zum Kochen bringen, dann Fischfilets hinzufügen und 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garnelen hinzufügen und weitere 3 Minuten kochen, bis sie rosa und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kokosmilch einfüllen und vorsichtig umrühren, dann gekochte Yuca und Kochbananen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 5 Minuten köcheln lassen, mit Salz und Pfeffer würzen und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
