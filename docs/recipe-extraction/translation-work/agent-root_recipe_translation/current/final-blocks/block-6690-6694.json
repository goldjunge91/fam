          "position": 0,
          "text": "Bananenblätter über einer Flamme erhitzen, um sie geschmeidig zu machen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen großen Topf mit Bananenblättern auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Rindfleisch in Stücke schneiden und auf den Topfboden legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kochbananen, Maniok und Kartoffeln schälen, in Stücke schneiden und über das Fleisch schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Zwiebeln, Knoblauch und Koriander über das Gemüse streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alles mit Rinderbrühe übergießen, sodass alles bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Falten Sie die Bananenblätter darüber, um sie zu bedecken, und decken Sie den Topf dann mit einem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "60 Minuten köcheln lassen, bis das Fleisch sehr zart und das Gemüse gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Vor dem Servieren mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
