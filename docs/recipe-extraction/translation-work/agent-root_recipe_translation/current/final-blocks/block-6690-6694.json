        {
          "position": 0,
          "text": "Erhitzen Sie die Milch in einem großen Topf auf 185 °F und rühren Sie dabei gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vom Herd nehmen und unter leichtem Rühren langsam Essig hinzufügen, bis sich der Quark löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "5 Minuten ruhen lassen, dann zum Abtropfen durch ein Käsetuch gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spülen Sie den Quark unter kaltem Wasser ab und geben Sie ihn zum vollständigen Abtropfen in ein Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Quark vorsichtig mit Salz, gehackten Zwiebeln, Koriander und gehacktem Jalapeño vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitzen Sie Bananenblätter über einer Flamme, um sie weich zu machen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eine Form oder kleine Schüssel mit Bananenblättern auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit der Käsemischung füllen und die Blätter darüber falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mindestens 30 Minuten im Kühlschrank lagern und bei Zimmertemperatur oder leicht erwärmt servieren.",
