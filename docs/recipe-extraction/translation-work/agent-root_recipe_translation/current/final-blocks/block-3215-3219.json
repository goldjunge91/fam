      "steps": [
        {
          "position": 0,
          "text": "Lege Hähnchenbrustfilets zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 1/2-inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, eine mit verquirlten Eiern und eine mit Panko und 1/4 cup Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jede Hähnchenbrust in Mehl und schüttle Überschuss ab. Tauche sie dann in Ei und überziehe sie mit der Bröselmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze und brate das Hähnchen 4-5 Minuten pro Seite goldbraun an. Lege es dann in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile 1 cup Marinara-Sauce über dem Hähnchen und gib Mozzarella sowie den übrigen Parmesan darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe das Gericht bei 400°F 10-12 Minuten, bis der Käse geschmolzen ist und blubbert. Serviere es mit der restlichen Marinara-Sauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
