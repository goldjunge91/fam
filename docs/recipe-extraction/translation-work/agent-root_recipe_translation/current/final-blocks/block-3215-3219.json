      "steps": [
        {
          "position": 0,
          "text": "Gib Eier, Vanille-Proteinpulver, Haferflocken, griechischen Joghurt und Milch in einen Mixer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die Banane und gib sie mit Backpulver und Zimt in den Mixer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere alles 30-45 Sekunden auf hoher Stufe, bis die Masse glatt und gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Butter in einer beschichteten Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 1/4 cup Teig in die Pfanne und gare den Pfannkuchen 2-3 Minuten, bis die Ränder trocken aussehen und sich oben Blasen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende den Pfannkuchen vorsichtig und gare die andere Seite 1-2 Minuten hellgoldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole den Vorgang mit dem restlichen Teig, sodass insgesamt 4 Pfannkuchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere jeder Person 2 Pfannkuchen mit Ahornsirup und nach Wunsch Beeren oder griechischem Joghurt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
