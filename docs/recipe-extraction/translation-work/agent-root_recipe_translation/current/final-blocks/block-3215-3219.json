      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine große Pfanne oder Grillplatte bei mittlerer Hitze und bestreiche eine Seite einer Tortilla leicht mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Tortilla mit der gebutterten Seite nach unten in die Pfanne und streue 1/2 cup Käse auf eine Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 1/4 cup Hähnchen und 1/4 der gewürfelten Paprika und Zwiebel auf den Käse und klappe die Tortilla zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare die Quesadilla 3-4 Minuten, bis die Unterseite goldbraun und knusprig ist. Wende sie und gare die andere Seite 2-3 Minuten, bis der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege sie auf ein Schneidebrett und wiederhole den Vorgang mit den übrigen Tortillas und der Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide die Quesadillas in Dreiecke und serviere sie mit Salsa und saurer Sahne dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
