      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einem Wok bei hoher Hitze und verquirle die Eier. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 Esslöffel Öl dazu und gare gewürfeltes Hähnchen etwa 5 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe das Hähnchen zur Seite, gib das restliche Öl und den Knoblauch dazu und rühre 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib kalten Reis dazu, löse Klumpen und brate ihn 2 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das gefrorene Gemüse hinzu und vermenge alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Sojasoße, Mirin und Zucker in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Teriyaki-Soße über den Reis und vermenge alles 1 Minute, bis der Reis gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib die Eier zurück in die Pfanne, vermenge alles vorsichtig, garniere mit Frühlingszwiebeln und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
