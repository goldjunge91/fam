      "steps": [
        {
          "position": 0,
          "text": "Alle Zutaten für die Marinade in einer kleinen Küchenmaschine pürieren. Marinade auf das Hähnchen reiben und 1 Stunde bei Zimmertemperatur ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backofen auf 190C/Umluft 170C/Gasstufe 5 erhitzen. Hähnchen in einen Bräter legen und 1 Stunde 20 Minuten garen. Locker mit Folie abdecken und 20 Minuten ruhen lassen. Währenddessen die Zutaten für den Krautsalat vermischen und würzen. Hähnchen mit Krautsalat, Pommes und Würzsaucen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
