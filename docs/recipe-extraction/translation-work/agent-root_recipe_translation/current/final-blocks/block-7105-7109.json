      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in dünne Pommes schneiden und 15 Minuten in kaltem Wasser einweichen, dann trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl auf 350 °F erhitzen und die Kartoffeln portionsweise goldbraun braten, etwa 8 Minuten pro Portion, und auf Papiertücher legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch mit gehackten Zwiebeln, Petersilie, Eigelb, Worcestershire-Sauce, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Aus der Rindfleischmischung ein Pastetchen formen und mit einem Messer fein hacken oder zerkleinern, um eine Tartar-Textur zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Soßenpulver mit Wasser bei mittlerer Hitze etwa 3 Minuten lang verquirlen, bis es glatt und eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiße Pommes auf einen Teller legen, mit rohem Rindertatar belegen, alles mit heißer Soße übergießen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
