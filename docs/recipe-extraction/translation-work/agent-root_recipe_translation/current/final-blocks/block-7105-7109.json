      "steps": [
        {
          "position": 0,
          "text": "Steak und Garnelen trocken tupfen; Steak mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zum Frittieren von Pommes Frites Öl in einem tiefen Topf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1.5 EL Butter in einer Pfanne bei starker Hitze erhitzen; Steak 4 Minuten pro Seite anbraten, wenn es mittel-selten ist; 5 Minuten ruhen lassen, dann in Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne die restliche Butter schmelzen und den gehackten Knoblauch 30 Sekunden lang anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garnelen hinzufügen, mit Salz und Pfeffer würzen und 2-3 Minuten pro Seite braten, bis sie rosa sind; Zitronensaft darüberpressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gefrorene Pommes Frites goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einem Topf die Rindersoße erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Pommes auf einen Teller schichten und mit Käsequark, Steakscheiben und Garnelen belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Alles mit heißer Rindersoße beträufeln und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
