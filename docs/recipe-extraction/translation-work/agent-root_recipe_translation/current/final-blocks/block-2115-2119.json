      "steps": [
        {
          "position": 0,
          "text": "Kochen: Wasser zum Kochen bringen, Eier vorsichtig hineingeben und genau 6½ bis 7 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eisbad: Eier sofort für 3–5 Minuten in eine Schüssel mit Eiswasser geben, damit der Garvorgang stoppt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Marinieren (optional, aber empfohlen): Eier schälen und in einer Mischung aus 2 EL Sojasauce, 2 EL Mirin, 1 TL Zucker und 4 EL Wasser mindestens 4 Stunden (oder über Nacht) marinieren.",
          "timerMinutes": null,
