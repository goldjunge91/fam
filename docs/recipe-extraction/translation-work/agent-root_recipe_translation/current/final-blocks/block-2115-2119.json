      ],
      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 400 Grad F (200 Grad C) vorheizen. Backform von 10x14x2 inch einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Margarine in einer Pfanne bei mittlerer Hitze erhitzen und Zwiebel einrühren. Etwa 5 Minuten unter Rühren garen, bis die Zwiebel weich und glasig ist. Hitze reduzieren und weitere etwa 40 Minuten garen und rühren, bis die Zwiebel sehr weich und dunkelbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe in einem großen Topf zum Kochen bringen. Hähnchenbrüste einrühren, Hitze reduzieren und etwa 20 Minuten köcheln lassen, bis das Fleisch in der Mitte nicht mehr rosa ist. Vom Herd nehmen. Hähnchenbrüste mit einer Schaumkelle auf einen Teller geben und Brühe aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffeln mit einem elektrischen Entsafter entsaften. Trockene Kartoffelmasse in eine Schüssel geben und Saft wegschütten. Salz und Pfeffer einrühren, dann so viel der aufbewahrten Brühe dazugeben, dass die Mischung die Konsistenz von Haferbrei erhält. Übrige Brühe beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hälfte der Kartoffelmischung gleichmäßig in der vorbereiteten Form verteilen. Gegarte Hähnchenbrust gleichmäßig darauflegen und karamellisierte Zwiebel darüber verteilen. Übrige Kartoffelmischung darauf verstreichen, sodass Zwiebeln und Hähnchen bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Im vorgeheizten Ofen etwa 1 Stunde goldbraun backen. Hühnerbrühe wieder erhitzen und nach Wunsch über einzelne Portionen gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
