        {
          "position": 0,
          "text": "Säubere den Tintenfisch, indem du Kopf und Innereien entfernst. Bewahre den Tintenbeutel auf, falls vorhanden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Körper in Ringe und hacke die Tentakel in mundgerechte Stücke.",
