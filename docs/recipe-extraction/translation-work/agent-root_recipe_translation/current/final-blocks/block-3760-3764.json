      "steps": [
        {
          "position": 0,
          "text": "Würze Hähnchenschenkel mit Salz und Pfeffer und bräune sie in Olivenöl in einem großen Tontopf oder schweren Topf je Seite 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen heraus und stelle es beiseite. Dünste gewürfelte Zwiebel und gehackten Knoblauch im selben Topf 3 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Gib dann Reis hinzu und röste ihn unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße warme Hühnerbrühe hinzu und gib die Hähnchenschenkel zurück in den Topf. Betten sie in den Reis ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf teilweise ab und lasse es 20 Minuten ohne Rühren köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Prüfe, ob die Flüssigkeit größtenteils aufgenommen und der Reis weich ist. Gib bei Bedarf noch etwas Brühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd, decke ihn vollständig ab und lasse alles 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere mit frischer Petersilie und serviere direkt aus dem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
