      ],
      "steps": [
        {
          "position": 0,
          "text": "Schäle Kartoffeln, schneide sie in 1 Zoll große Würfel und koche sie 10 Minuten in Salzwasser, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Kohl in dünne Streifen und gib ihn für die letzten 5 Minuten der Kochzeit zu den Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Kartoffeln und Kohl vollständig ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle Speck und brate ihn in einer großen Pfanne bei mittlerer Hitze knusprig. Nimm ihn heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle die Zwiebel und dünste sie im Speckfett 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib abgetropfte Kartoffeln und Kohl in die Pfanne und zerdrücke sie vorsichtig mit einem Holzlöffel, während du sie mit der Zwiebel vermischst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare die Mischung 8-10 Minuten und rühre gelegentlich um, bis sich am Boden eine goldene Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre knusprigen Speck ein, würze mit Salz und Pfeffer und serviere heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
