      "steps": [
        {
          "position": 0,
          "text": "Weiche Stockfisch 24 Stunden in kaltem Wasser ein und wechsle das Wasser 3 Mal, um das Salz zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche den entsalzten Fisch 8 Minuten in Wasser, bis er gar ist. Gieße ihn ab und lasse ihn abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerteile den gegarten Fisch in mundgerechte Stücke und entferne alle verbliebenen Gräten oder Haut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle rote Paprika, rote Zwiebel und Sellerie fein und gib alles in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Fischflocken und grüne Oliven zum Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Olivenöl und Rotweinessig, gieße das Dressing über den Salat und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer, garniere mit frischer Petersilie und serviere bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
