      "steps": [
        {
          "position": 0,
          "text": "Reibe die Kartoffeln und drücke die gesamte Flüssigkeit mit einem sauberen Küchentuch aus. Würze sie mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke die Kartoffeln in eine gebutterte Form der Größe 9x13 und forme einen Boden. Backe ihn bei 400°F 20 Minuten, bis er goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste Wurst, Zwiebel und Paprika an. Verquirle die Eier mit Milch und Gewürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Wurstmischung auf dem Kartoffelboden, gib die Eier darüber und belege alles mit Cheddar. Backe den Auflauf 25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
