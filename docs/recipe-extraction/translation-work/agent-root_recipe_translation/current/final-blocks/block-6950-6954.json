      "steps": [
        {
          "position": 0,
          "text": "Krabbenfleisch mit zerstoßenen Salzcrackern, Mayonnaise, Ei, Senf, Worcestershire-Sauce und Old Bay-Gewürz vorsichtig unterheben, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Aus der Mischung 4 etwa 1/2 Zoll dicke Pastetchen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mindestens 30 Minuten in den Kühlschrank stellen (kann beim Erhitzen von Öl erfolgen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pflanzenöl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Krabbenkuchen vorsichtig in das heiße Öl legen und auf jeder Seite 3-4 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Papiertücher geben und kurz abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm mit Zitronenspalten oder Remoulade servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
