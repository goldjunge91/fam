        {
          "position": 0,
          "text": "Röste Erdnüsse, Sesam und Kokosnuss zusammen, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle die geröstete Mischung mit Tamarindenpaste zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide grüne Chilischoten längs ein und entferne vorsichtig die Kerne, lasse den Stiel dran.",
