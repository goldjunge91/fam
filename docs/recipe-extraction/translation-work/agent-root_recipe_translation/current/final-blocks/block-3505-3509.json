      "steps": [
        {
          "position": 0,
          "text": "Mariniere das Fleisch 30 Minuten mit Joghurt, Ingwer-Knoblauch-Paste, der Hälfte des Garam Masala und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Topf mit schwerem Boden und brate Zwiebeln tief goldbraun. Nimm die Hälfte heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das marinierte Fleisch zu den übrigen Zwiebeln und gare es 5 Minuten bei starker Hitze unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomaten dazu und gare sie, bis sie vollständig zu einer Paste zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze, decke den Topf ab und gare alles 45 Minuten, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Korianderpulver, Kreuzkümmelpulver, das restliche Garam Masala und grüne Chilischoten dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche alles ohne Deckel weitere 10 Minuten, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht vor dem Servieren mit Röstzwiebeln und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
