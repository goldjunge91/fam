        {
          "position": 3,
          "text": "Belege alles mit den übrigen Röstzwiebeln und der Minz-Koriander-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf fest mit Folie ab und stelle eine Tawa (Grillplatte) oder einen schweren Topf darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare alles bei starker Hitze 2 Minuten, bis sich Dampf bildet, und reduziere dann die Hitze.",
