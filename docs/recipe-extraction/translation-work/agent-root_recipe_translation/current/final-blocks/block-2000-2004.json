      "steps": [
        {
          "position": 0,
          "text": "Rosinen und Backpflaumen in eine kleine Schüssel geben und mit ausreichend Wasser bedecken. Zitronensaft dazugeben und mindestens 1 Stunde einweichen lassen. Abgießen. Backpflaumen grob hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Währenddessen Butter in einer großen Pfanne erhitzen, Zwiebel dazugeben und 5 Minuten garen. Gewürfeltes Lamm, Lammhackfleisch und zerdrückte Knoblauchzehen dazugeben. Unter ständigem Rühren 5 Minuten braten, bis alles gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2/3 Tasse (150 Milliliter) Brühe in die Pfanne gießen. Zum Kochen bringen, dann Hitze reduzieren, abdecken und 1 Stunde köcheln lassen oder bis das Lamm zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Übrige Brühe dazugeben und zum Kochen bringen. Abgespülten Langkornreis und eine große Prise Safran dazugeben. Umrühren, abdecken und 15 Minuten köcheln lassen oder bis der Reis gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgetropfte Rosinen, abgetropfte gehackte Backpflaumen sowie Salz und Pfeffer nach Geschmack dazugeben. Einige Minuten erhitzen, dann auf eine vorgewärmte Servierplatte geben und mit Zweigen glatter Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
