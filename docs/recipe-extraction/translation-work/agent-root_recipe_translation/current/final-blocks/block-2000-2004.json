      "steps": [
        {
          "position": 0,
          "text": "Fleisch mit Mehl bestäuben, sodass es leicht überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einem großen Topf so viel Pflanzenöl erhitzen, dass der Boden bedeckt ist, und Zwiebel sowie Fleisch darin leicht anbräunen. Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Karotten, Brühe und nach Geschmack weitere Gewürze dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zum Kochen bringen, abdecken und die Hitze reduzieren, sodass alles köchelt. Mindestens eine Stunde köcheln lassen oder bis das Fleisch zart ist. Lass dir beim Garen Zeit: Je länger das Fleisch gart, desto besser wird der Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backofen auf 180C/350F/Gasstufe 4 vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abgetropfte Kartoffelwürfel zum Lamm geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mischung in eine Pasteten- oder Auflaufform geben und mit Mürbeteig abdecken. Drei Schlitze in die Teigdecke schneiden, damit beim Garen Dampf entweichen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit verquirltem Ei bestreichen und etwa 40 Minuten backen, bis der Teig goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
