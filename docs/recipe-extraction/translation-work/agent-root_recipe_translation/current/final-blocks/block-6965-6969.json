      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie eine 9 x 13 Zoll große Backform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kuchenmischung, zerdrückte Ananas mit Saft, Eiern und Pflanzenöl in einer Schüssel vermischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in die vorbereitete Form füllen und 25–30 Minuten backen, bis ein Zahnstocher in der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Kuchen in der Form auf einem Kuchengitter vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frischkäse und Butter schaumig schlagen, dann nach und nach Puderzucker hinzufügen und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den geschlagenen Belag unter die Frischkäsemischung heben, um eine Glasur zu erzeugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Zuckerguss auf dem abgekühlten Kuchen verteilen und bis zum Servieren im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Quadrate schneiden und gekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
