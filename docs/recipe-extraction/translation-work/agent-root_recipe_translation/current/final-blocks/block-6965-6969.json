      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 450 °F vor und legen Sie ein großes Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ordnen Sie die Austern in ihrer Schale auf dem vorbereiteten Backblech an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einem Topf schmelzen und gehackten Knoblauch, scharfe Soße, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Über jede Auster eine kleine Menge Knoblauchbuttermischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Austern 8–10 Minuten rösten, bis sich die Schalen zu öffnen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen und alle verbleibenden Schalen mit einem Austernmesser vollständig öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den frischen Zitronensaft über die Austern pressen und mit Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit Austerncrackern und zusätzlich geschmolzener Butter zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
