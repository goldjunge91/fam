      "steps": [
        {
          "position": 0,
          "text": "Hähnchenschenkel mit Salz und Pfeffer würzen und in einem großen Topf in heißem Öl auf jeder Seite 4 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Hähnchen herausnehmen und beiseite stellen, dann die gewürfelten Zwiebeln im Topf 3 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Kartoffeln und Hühnerbrühe in den Topf geben, dann das Huhn wieder in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zugedeckt 15 Minuten köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mischen Sie Butter und Mehl zu einer Paste und rühren Sie sie dann in den Topf, um die Brühe zu verdicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ohne Deckel weitere 5 Minuten köcheln lassen, damit es leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Geben Sie einen Löffel Keksteig über den Topf, decken Sie ihn ab und lassen Sie ihn 10 Minuten lang köcheln, bis die Kekse durchgebacken sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schüsseln mit Keksen darauf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
