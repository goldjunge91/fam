      "steps": [
        {
          "position": 0,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen und gewürfelte Zwiebeln und Paprika 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schieben Sie das Gemüse beiseite, schlagen Sie die Eier in die Pfanne und rühren Sie es etwa 4 Minuten lang um, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brühwurst, gekochte Kartoffeln und die Hälfte des Käses unterrühren und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite erwärmen, um sie geschmeidig zu machen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine Tortilla flach auslegen, 1 Tasse Füllung in die Mitte geben, mit restlichem Käse und einem Löffel Salsa belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falten Sie das untere Drittel der Tortilla über die Füllung, schlagen Sie die Seiten ein und rollen Sie sie fest von sich weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wickeln Sie jeden Burrito in Folie ein und servieren Sie ihn warm mit Salsa als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
