      "steps": [
        {
          "position": 0,
          "text": "Spüle gelbe Moong-Dal-Linsen (oder rote Linsen) ab. Lass sie mit Kurkuma und 4 Tassen Wasser 20 Minuten köcheln, bis sie zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite das Tadka zu: Erhitze Olivenöl in einer kleinen Pfanne. Gib Kreuzkümmel dazu und lass ihn 30 Sekunden brutzeln. Gib Zwiebel dazu und gare sie 4 Minuten. Gib Knoblauch und Ingwer dazu und gare alles 2 Minuten. Gib Tomaten dazu und gare alles 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Tadka in die Linsen und verrühre alles. Gib Spinat dazu und lass ihn 1 Minute zusammenfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Zitronensaft und frischen Koriander ein. Würze mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Suppe mit Brot oder Reis als sättigendere Mahlzeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
