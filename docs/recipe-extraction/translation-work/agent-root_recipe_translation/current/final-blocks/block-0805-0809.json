      "steps": [
        {
          "position": 0,
          "text": "Röste 1 EL ungekochten Reis 3 Minuten in einer trockenen Pfanne, bis er goldbraun ist. Lass ihn abkühlen und mahle ihn grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Putenhackfleisch 5–6 Minuten in Olivenöl bei mittelhoher Hitze und zerteile es dabei. Lass es nicht vollständig austrocknen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Pfanne vom Herd und würze das Fleisch mit Limettensaft, Fischsoße und Chiliflocken. Hebe geschnittene Schalotten unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte den Salat auf einer Platte auf Salatblättern an. Garniere ihn mit frischer Minze, Koriander, Frühlingszwiebeln und geröstetem Reispulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere den Salat mit zusätzlichen Limettenspalten.",
