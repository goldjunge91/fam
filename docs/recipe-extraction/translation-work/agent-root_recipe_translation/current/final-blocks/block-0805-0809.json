      "steps": [
        {
          "position": 0,
          "text": "Koche 6 Eier hart: Bedecke sie mit kaltem Wasser, bringe es zum Kochen und lass die Eier 9 Minuten köcheln. Schrecke sie in Eiswasser ab und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ritze die Eier mit einem Messer leicht ein, damit die Soße einziehen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Zwiebel 6 Minuten in Olivenöl an, bis sie kräftig goldbraun ist. Gib Knoblauch und Ingwer dazu und gare alles 2 Minuten. Gib alle Gewürze dazu und röste sie 1 Minute an. Gib gehackte Tomaten dazu und lass alles 6 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Eier vorsichtig in die Soße. Lass alles 5 Minuten köcheln und übergieße die Eier dabei mit Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere das Curry auf Reis mit Koriander.",
          "timerMinutes": null,
