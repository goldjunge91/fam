      ],
      "steps": [
        {
          "position": 0,
          "text": "Schneide Kaninchen in mundgerechte Stücke und erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Kaninchenstücke insgesamt etwa 8 Minuten von allen Seiten, nimm sie dann heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste gewürfelte Zwiebel, Karotte und Sellerie im selben Topf etwa 8 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch hinzu und gare ihn 1 Minute. Gib dann das Kaninchen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche mit Rotwein ab und lasse ihn etwa 5 Minuten einkochen, bis sich die Menge halbiert hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Dosentomaten und Hühnerbrühe hinzu, bringe alles zum Köcheln und gare es 2 Stunden, bis das Kaninchen sehr zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche Tagliatelle nach Packungsanweisung al dente, gieße sie ab und vermische sie mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere Tagliatelle mit Kaninchen-Ragù und geriebenem Pecorino Romano.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
