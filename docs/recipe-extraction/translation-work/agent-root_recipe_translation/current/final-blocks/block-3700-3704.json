          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere Tomaten, entferne die Kerne und würfle das Fruchtfleisch fein in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke Knoblauch und gib ihn mit gezupftem frischem Basilikum zu den Tomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle alles mit Olivenöl und Balsamico-Essig, würze mit Salz und lasse es 5 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reibe jede geröstete Scheibe mit einer ganzen Knoblauchzehe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Tomatenmischung großzügig auf jeder Bruschetta.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort servieren, solange das Brot noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
