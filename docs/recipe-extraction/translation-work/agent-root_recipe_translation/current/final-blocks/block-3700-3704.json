      "steps": [
        {
          "position": 0,
          "text": "Koche Hähnchenbrüste mit Zwiebel und Salz 20 Minuten in Wasser, bis sie gar sind, und zupfe das Fleisch dann auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Poblano-Chilis über offener Flamme oder unter dem Grill, bis sie verkohlt sind. Lege sie 5 Minuten in eine Plastiktüte, ziehe die Haut ab und entferne die Kerne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere geröstete Poblanos, Tomaten, Chipotles, Knoblauch und 1/2 Tasse Hühnerbrühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne und dünste gewürfelte Zwiebel 2 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die pürierte Sauce in die Pfanne und lasse sie unter gelegentlichem Rühren 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gezupftes Hähnchen und die restliche Brühe hinzu und lasse alles 10 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht, passe das Salz an und serviere es heiß mit Avocadoscheiben darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
