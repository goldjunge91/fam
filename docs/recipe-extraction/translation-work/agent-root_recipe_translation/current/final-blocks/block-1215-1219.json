      "steps": [
        {
          "position": 0,
          "text": "Schmore die Hähnchenschenkel 15 Minuten mit Knoblauch, Ingwer, süßer Sojasauce und Austernsauce, bis sie zart sind. Zerteile das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Nudeln nach Packungsangabe. Vermische sie mit Sesamöl und 1 EL süßer Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Brühe mit einem Schuss süßer Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte die gewürzten Nudeln mit Hähnchen, Pilzen, frittierten Schalotten und Frühlingszwiebel in einer Schale an. Serviere die Brühe dazu.",
          "timerMinutes": null,
