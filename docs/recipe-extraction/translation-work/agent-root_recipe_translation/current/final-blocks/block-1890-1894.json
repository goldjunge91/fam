      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen, dann eine Tasse Wasser zugießen und mit dem Kneten beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wenn der Teig noch nicht zusammenhält oder zu trocken ist, nach und nach das restliche Wasser zugeben, bis er sehr elastisch ist und sich beim Ziehen nicht reißt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig nur 10 Minuten ruhen lassen. Anschließend je nach gewünschter Größe in 6-8 Kugeln teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verwendete Butter, Ghee oder Öl erwärmen und in eine tiefe Schüssel gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teigkugeln in die warme Butter legen und 15 bis 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backofen auf 550F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erste Teigkugel mit den Händen auf einer sauberen Arbeitsfläche so dünn wie möglich ausziehen. Ziel ist, durch den Teig die Arbeitsfläche zu sehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Teig über sich selbst falten und zwischen den Faltungen mit der Buttermischung bestreichen, sodass ein Quadrat entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Beiseitelegen und die nächste Kugel vorbereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Die zweite Kugel wie die erste dünn ausziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Die vorherige Kugel mit der Nahtseite nach unten in die Mitte legen. Äußeren Teig darüberfalten, beim Falten mit weiterer Buttermischung bestreichen und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "So auch mit der dritten und vierten Kugel verfahren. Die entstandene Teigform mit der Nahtseite nach unten in eine 10 inch große Back- oder Pieform legen und die Oberseite mit weiterer Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Mit den übrigen 4 Kugeln eine zweite Form zubereiten. Gefalteten Feteer mit den Händen leicht andrücken, damit er sich in der Backform ausbreitet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Im vorgeheizten Ofen 10 Minuten backen. Sobald der Feteer aufgeht, den Grill einschalten, damit die Oberseite bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
