      "steps": [
        {
          "position": 0,
          "text": "Lammfleisch in große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kohl in große Spalten schneiden, dabei den Strunk dranlassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Lage Lammfleisch mit der Fettseite nach unten auf den Boden eines großen Topfes legen. Mit Pfefferkörnern und Salz bestreuen. Kohlspalten darauflegen. Mit weiteren Lagen Lamm, Pfefferkörnern und Kohl wiederholen. Mit Kohl abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Optional: Für einen dickeren Eintopf ein paar Esslöffel Mehl über das Lamm streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wasser in den Topf geben und aufkochen. Abdecken und Hitze reduzieren. Bei niedriger Hitze 2–3 Stunden garen, bis sich das Lamm leicht vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salzkartoffeln und frischer Petersilie servieren und großzügig mit Fårikål-Brühe übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
