      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und würfeln; Zwiebel fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und Zwiebel sowie gehackten Knoblauch (5 Minuten) weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln und Brühe hinzufügen, aufkochen und 12 Minuten köcheln lassen, bis die Kartoffeln fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischfilets hinzufügen und 5 Minuten köcheln lassen, dann Garnelen dazugeben und 3-4 Minuten garen, bis sie durch sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mayonnaise in einer separaten Schüssel mit einem Schuss heißer Brühe verrühren, damit sie sich temperiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Mayonnaise-Mischung abseits der Hitze langsam in den Topf rühren, sodass eine cremige Suppe entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und weißem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schalen servieren und mit frischer Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
