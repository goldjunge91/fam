      "steps": [
        {
          "position": 0,
          "text": "Wasser und Butter in einem Topf zum Kochen bringen, dann Mehl und Salz einrühren, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 5 Minuten abkühlen lassen und anschließend in eine Churrera (einen Spritzbeutel mit großer Sterntülle) füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem tiefen Topf oder Schmortopf auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "6-inch-Streifen Teig direkt in das heiße Öl spritzen und mit einer Schere abschneiden; 2-3 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Churros auf Küchenpapier abtropfen lassen und sofort in der Zimt-Zucker-Mischung wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für die Schokoladensauce Milch in einem Topf bei mittlerer Hitze erwärmen und Kakaopulver sowie Zucker glatt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warme Churros mit heißer Schokolade zum Eintunken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
