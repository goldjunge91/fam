      "steps": [
        {
          "position": 0,
          "text": "Fisch ausnehmen, unter kaltem Wasser abspülen und trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fisch längs auf Holzspieße stecken (die Spieße zuvor 30 Minuten einweichen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grobes Salz mit Paprikapulver mischen und den Fisch von beiden Seiten großzügig damit bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grill oder gusseiserne Pfanne stark erhitzen und die Fläche leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch 4-5 Minuten pro Seite grillen oder in der Pfanne braten, bis die Haut knusprig und das Fleisch undurchsichtig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Knoblauch fein hacken und mit Olivenöl vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den gegarten Fisch auf eine Servierplatte legen, mit Knoblauchöl beträufeln, frische Zitrone darüber auspressen und mit Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
