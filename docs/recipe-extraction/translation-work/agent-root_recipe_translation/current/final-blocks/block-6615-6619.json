      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 3 Esslöffel Öl und Wasser dazu und rühre, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig vorsichtig 2-3 Minuten, bis er glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 12 Kugeln und lasse sie 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke jede Kugel zu einer etwa 0.25 inch dicken Scheibe flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze das Frittieröl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere jede Teigscheibe 2-3 Minuten pro Seite, bis sie aufgegangen und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass die Yaniqueques auf Küchenpapier abtropfen, beträufle sie mit Honig und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
