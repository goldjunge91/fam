      "steps": [
        {
          "position": 0,
          "text": "Vermische die fein gehackte Zwiebel mit Hackfleisch, Mehl, Ei, Paprika, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme die Masse zu einem großen runden Fladen und lege ihn in eine gefettete Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl in einer Pfanne. Brate den Fladen 4-5 Minuten auf einer Seite an, wende ihn vorsichtig und brate die andere Seite ebenfalls an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den angebratenen Fladen zurück in die Auflaufform und gieße Wasser oder Brühe darum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Form mit Folie ab und backe den Fladen bei 375°F 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Folie ab und backe weitere 10 Minuten, damit die Sauce etwas einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass den Fladen 5 Minuten abkühlen und schneide ihn dann in Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn heiß und löffle die Sauce aus der Form darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
