      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Öl in einer Pfanne und dünste die dünn geschnittene Zwiebel etwa 8 Minuten goldbraun und weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Pastrami in kleine Stücke und brate ihn 3 Minuten mit der Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Paprika und schwarzen Pfeffer ein, nimm die Pfanne vom Herd und lass die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 425°F vor und ziehe den Pizzateig auf einem Backblech rechteckig auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Pastrami-Zwiebel-Mischung gleichmäßig auf dem Teig und lasse rundherum einen 0.5-inch breiten Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig von der langen Seite her fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wickle die Teigrolle auf dem Backblech spiralförmig ein und bestreiche sie mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe das Gebäck 20-25 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lass es 5 Minuten abkühlen, schneide es in Scheiben und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
