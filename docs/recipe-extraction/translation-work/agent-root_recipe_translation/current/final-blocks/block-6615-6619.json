      "steps": [
        {
          "position": 0,
          "text": "Weiche die getrockneten Bohnen 8 Stunden oder über Nacht in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Bohnen ab und gib sie mit 6 cups frischem Wasser in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass das Wasser aufkochen und die Bohnen anschließend 45 Minuten köcheln, bis sie langsam weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze währenddessen Öl in einer separaten Pfanne und dünste die gewürfelte Zwiebel und den Knoblauch an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Paprika und Tomatenmark zur Zwiebelmischung und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die Zwiebelmischung und das Lorbeerblatt unter die Bohnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 30-40 Minuten köcheln, bis die Bohnen sehr weich sind und die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne das Lorbeerblatt und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht heiß und beträufle es nach Wunsch mit Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
