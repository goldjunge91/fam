      "steps": [
        {
          "position": 0,
          "text": "Bringe Hühnerbrühe in einem Topf zum Kochen und gib Naturreis dazu. Rühre einmal um, reduziere die Hitze auf niedrig, decke den Topf ab und gare den Reis 25-30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe Hähnchenbrustfilets mit Küchenpapier trocken und würze beide Seiten mit Knoblauchpulver, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer Pfanne oder Grillpfanne bei mittelhoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Hähnchen in die heiße Pfanne und gare die erste Seite 6-7 Minuten ohne es zu bewegen, bis sie goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende das Hähnchen, presse Zitronensaft darüber, gib Thymianzweige dazu und gare es weitere 6-7 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen vom Herd und lasse es vor dem Servieren 3 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lockere den gegarten Naturreis mit einer Gabel auf und verteile ihn auf Tellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege je ein Hähnchenbrustfilet auf eine Portion Reis und beträufle es mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
