      "steps": [
        {
          "position": 0,
          "text": "Gieße Thunfisch aus der Dose in einem Sieb ab und drücke vorsichtig überschüssige Flüssigkeit heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den Thunfisch in eine Schüssel und vermische ihn mit Mayonnaise, gewürfeltem Sellerie, roter Zwiebel und Relish.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze den Thunfischsalat mit Salz und schwarzem Pfeffer und rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Brotscheiben nach Wunsch leicht, damit sie mehr Biss und Geschmack haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den Thunfischsalat gleichmäßig auf zwei Brotscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Salat und Tomatenscheiben auf den Thunfischsalat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die Sandwiches mit den übrigen Brotscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide sie diagonal durch und serviere sie sofort oder wickle sie für später in Folie ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
