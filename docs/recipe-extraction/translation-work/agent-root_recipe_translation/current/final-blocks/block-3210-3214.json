      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eiweiß mit Salz und Pfeffer in einer Schüssel, bis es leicht schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer beschichteten 8-inch-Pfanne bei mittlerer Hitze, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Eiweiß in die Pfanne und lasse es 1 Minute ungestört garen, bis die Unterseite anfängt fest zu werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe mit einem Pfannenwender die gegarten Ränder vorsichtig zur Mitte und neige die Pfanne, damit flüssiges Ei an die Ränder läuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn die Oberseite größtenteils gestockt, aber noch leicht feucht ist, streue Käse, Tomate, Spinat und Frühlingszwiebel auf eine Hälfte des Omeletts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe das Omelett über der Füllung zusammen und schiebe es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es sofort, solange es heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
