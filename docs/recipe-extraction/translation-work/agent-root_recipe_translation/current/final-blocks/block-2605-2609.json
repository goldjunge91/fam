          "images": []
        },
        {
          "position": 1,
          "text": "Die Fischhaut auf jeder Seite an zwei Stellen einschneiden, damit sie sich nicht wölbt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Bauchhöhle mit Zitronen- und Knoblauchscheiben füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fisch innen und außen mit Olivenöl bestreichen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grill auf mittelhohe Hitze vorheizen und den Rost gut einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fisch 6-8 Minuten pro Seite grillen, bis sich das Fleisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf eine Servierplatte legen, mit dem restlichen Olivenöl beträufeln und frische Petersilie darübergeben.",
