      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne oder einem Wok bei mittelhoher bis hoher Hitze. Brate das gewürfelte Hähnchen etwa 6 Minuten rundum an, nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln in die Pfanne und gare sie etwa 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gehackten Knoblauch und Ingwer ein und gare sie 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kreuzkümmel, Koriander, Chilipulver und Kurkuma hinzu und gare alles unter Rühren 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in die Pfanne und füge gewürfelte Tomaten und Paprikastreifen hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre alles gut um und lasse es ohne Deckel 15 Minuten köcheln, bis das Hähnchen gar und die Paprika noch bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis oder Naan servieren.",
