      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der Chilis, falls du es milder magst. Hacke sie mit Handschuhen fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf mit schwerem Boden bei mittelhoher bis hoher Hitze. Gib Kreuzkümmelsamen hinzu und röste sie 30 Sekunden, bis sie aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebeln hinzu und gare sie unter häufigem Rühren etwa 10 Minuten dunkelgoldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und Ingwer hinzu und gare sie 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre alle gehackten Chilis und Tomatenmark ein und gare alles unter ständigem Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfeltes Hähnchen hinzu, wende es in der Gewürzpaste und gare es 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Kokosmilch hinzu, reduziere die Hitze auf mittlere Stufe und lasse alles 20 Minuten köcheln, bis das Hähnchen gar und die Sauce dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und serviere das Gericht mit Reis und Joghurt. Stelle reichlich Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
