      "steps": [
        {
          "position": 0,
          "text": "Schweinefleisch, Garnelen, Frühlingszwiebeln, Sojasauce, Sesamöl und Ingwer in einer Schüssel gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein Wonton-Teigblatt rautenförmig auf die Arbeitsfläche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Etwa 0.5 Teelöffel Füllung in die Mitte des Teigblatts geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Teigblatt zu einem Dreieck zusammenklappen, die Ränder zum Verschließen andrücken, dann die beiden Ecken des Dreiecks zusammenführen und festdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen großen Topf mit Wasser sprudelnd aufkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Wontons vorsichtig portionsweise in das kochende Wasser geben und dabei sanft umrühren, damit sie nicht zusammenkleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sobald die Wontons an die Oberfläche steigen, weitere 2-3 Minuten kochen, bis sie dauerhaft oben schwimmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln mit heißer Brühe oder einer Soja-Essig-Dipsauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
