      "steps": [
        {
          "position": 0,
          "text": "Eier in einer großen Schüssel verquirlen, dann Pflanzenöl untermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer anderen Schüssel Matzenmehl, Salz, schwarzen Pfeffer, Zwiebelpulver und Knoblauchpulver vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Matzenmischung unter die Eiermasse heben, bis alles verbunden ist, dann abdecken und 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hühnerbrühe in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hände befeuchten, die Matzenmischung zu 12 golfballgroßen Portionen formen und vorsichtig in die kochende Brühe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Brühe erneut sanft aufkochen, die Hitze auf mittlere bis niedrige Stufe reduzieren und 30-40 Minuten ohne Deckel köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Matzenknödel gehen auf und schwimmen an der Oberfläche, wenn sie fertig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln mit heißer Brühe servieren und mit frischem Dill garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
