      "steps": [
        {
          "position": 0,
          "text": "Streife Grünkohlblätter von den harten Mittelstielen und zupfe sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch und Sardellen mit einem Messer oder Mörser zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Knoblauch-Sardellen-Paste, Zitronensaft, Mayonnaise, Olivenöl, Senf und Worcestershiresauce in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze das Dressing nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Grünkohl in eine große Schüssel und gieße das Dressing darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Massiere den Grünkohl 1-2 Minuten mit den Händen, bis die Blätter weicher sind und das Dressing gleichmäßig verteilt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Croûtons und den Großteil des Parmesans hinzu und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile den Salat auf Servierschalen und bestreue ihn mit dem restlichen Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
