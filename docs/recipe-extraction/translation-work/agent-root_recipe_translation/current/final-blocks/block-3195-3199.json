      "steps": [
        {
          "position": 0,
          "text": "Gieße Kichererbsen aus der Dose ab, spüle sie ab und pulsiere sie in einer Küchenmaschine mit Zwiebel, Knoblauch und Petersilie grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Mehl, Kreuzkümmel, Koriander, Backpulver, Salz und Pfeffer ein und kühle die Mischung 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme die Mischung zu 1-Zoll-Kugeln und drücke sie leicht zu Bratlingen flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere Falafel 2-3 Minuten pro Seite goldbraun. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Tahini, Zitronensaft und Wasser zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hacke Salat, Tomaten und Gurken in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege Salat auf eine Platte und gib Tomaten, Gurken und warme Falafel darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle alles mit Tahinisauce und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
