      "steps": [
        {
          "position": 0,
          "text": "Gib Mehl und Salz in eine Schüssel. Füge Rindertalg, Korinthen, Zucker sowie Zitronen- und Orangenschale hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße 150ml Milch dazu und vermische alles zu einem festen, aber feuchten Teig. Gib bei Bedarf mehr Milch hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme eine dicke, etwa 20cm lange Rolle. Lege sie auf ein großes Rechteck Backpapier. Wickle es locker ein, damit der Pudding aufgehen kann, und binde die Enden wie bei einem Knallbonbon mit Küchengarn zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle einen Dämpfeinsatz über einen großen Topf mit kochendem Wasser. Lege den Pudding hinein, decke ihn ab und dämpfe ihn 1 1/2 hours. Fülle den Topf von Zeit zu Zeit mit Wasser nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Pudding aus dem Dämpfeinsatz und lasse ihn vor dem Auswickeln etwas abkühlen. In Scheiben schneiden und mit Vanillesoße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
