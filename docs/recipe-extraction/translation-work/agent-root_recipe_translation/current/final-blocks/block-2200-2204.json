      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln kochen: Gib die Kartoffeln in einen Topf mit kaltem Wasser und bringe es zum Kochen. Koche sie 20 Minuten oder bis sie weich sind. Sie sind gar, wenn ein Messer leicht hindurchgleitet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Harissa-Gewürz, Olivenöl, Salz, Pfeffer und Zitronensaft in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Wasser ab, sobald die Kartoffeln gar sind, und schneide sie grob in Hälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Harissa-Mischung und Frühlingszwiebeln zu den Kartoffeln und rühre um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den Rucola in einer großen Salatschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Kartoffelmischung darauf und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge Feta und Minze hinzu und streue Pinienkerne darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
