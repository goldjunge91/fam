      "steps": [
        {
          "position": 0,
          "text": "Weiche die Holzspieße 20 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Paniermehl und Milch in einer kleinen Schüssel und lass die Mischung 5 Minuten stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Rinderhackfleisch, Schweinehackfleisch, die Paniermehlmischung, Zwiebel, Ei, Salz, Pfeffer und Muskatnuss, bis alles gerade so verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Mischung 16 Fleischbällchen und stecke jeweils 2 Fleischbällchen auf einen Spieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Butter in einer großen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Fleischbällchenspieße 12-15 Minuten und wende sie gelegentlich, bis sie gebräunt und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit Preiselbeermarmelade und saurer Sahne als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
