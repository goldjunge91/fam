      "steps": [
        {
          "position": 0,
          "text": "Weiche die Kichererbsen über Nacht ein, gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf, brate die Rindfleischwürfel rundherum an, nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Zwiebeln und Knoblauch im selben Topf etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Rindfleisch, Kichererbsen, Kreuzkümmel, Salz, Pfeffer und Wasser zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lass das Gericht 60-70 Minuten köcheln, bis Rindfleisch und Kichererbsen zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke das Gericht ab und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
