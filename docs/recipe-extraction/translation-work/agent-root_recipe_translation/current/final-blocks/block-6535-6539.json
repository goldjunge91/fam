      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl und Salz in einer Schüssel und forme in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Wasser und Öl hinzu, vermenge alles zu einem groben Teig und knete ihn 5 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 8 Stücke und rolle jedes zu einer dünnen Scheibe aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge Feta, Minze und Schwarzkümmelsamen in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Käsemischung auf eine Hälfte jeder Scheibe und klappe sie zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe jedes Fladenbrot pro Seite 2-3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es warm mit Naturjoghurt oder Labneh.",
