      "steps": [
        {
          "position": 0,
          "text": "Weiche Bulgur 15 Minuten in warmem Wasser ein, bis er weich ist. Gieße überschüssiges Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Lammhackfleisch mit der Hälfte der Zwiebel und des Knoblauchs an. Gib Kreuzkümmel, Salz und Pfeffer dazu. Stelle die Füllung zum Abkühlen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die übrige Zwiebel und den Knoblauch in Öl goldbraun an und stelle sie für die Sauce beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge Bulgur mit Hackfleisch und den restlichen Gewürzen zu einem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Befeuchte deine Hände, forme kleine ovale Hüllen, fülle sie mit der Lammfleischmischung und verschließe sie sorgfältig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl auf 350°F und frittiere Kubbeh portionsweise 2-3 Minuten, bis sie goldbraun sind und aufsteigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie mit Zwiebel-Knoblauch-Sauce oder Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
