      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl, Wasser und Salz zu einem festen Teig. Knete ihn glatt und lass ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune das Hackfleisch mit Zwiebel und Knoblauch an, würze mit Kurkuma und Pfeffer und lass es etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig dünn aus, schneide ihn in kleine Quadrate und gib jeweils einen Teelöffel Fleischmischung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe jedes Quadrat zu einem Dreieck zusammen und drücke die Ränder fest. Falte dann die Ecken zusammen, sodass ein Päckchen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe Brühe zum Kochen und gib die Teigtaschen portionsweise hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche sie 8-10 Minuten, bis sie aufsteigen und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Kichererbsen dazu und lass alles weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Teigtaschen heiß in Brühe mit frischen Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
