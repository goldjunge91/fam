      "steps": [
        {
          "position": 0,
          "text": "Vermenge Joghurt, Zitronensaft, Knoblauch, Ingwer, Paprikapulver, Kreuzkümmel, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Hähnchenwürfel dazu und überziehe sie gründlich mit der Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke die Schüssel ab und stelle das Hähnchen mindestens 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Grillpfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stecke die Hähnchenstücke auf Spieße und grille sie pro Seite 4-5 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere das Hähnchen heiß mit Reis oder Fladenbrot und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
