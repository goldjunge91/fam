      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor. Würfle die Süßkartoffel und schneide die übrigen Gemüse in große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge alles Gemüse mit 1 tbsp Olivenöl, der Hälfte der Gewürze, Salz und Pfeffer auf einem großen Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Hähnchenschenkel mit dem restlichen Olivenöl, italienischen Kräutern, geräuchertem Paprikapulver, Knoblauch, Salz und Pfeffer. Lege sie zwischen das Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste alles 30–35 Minuten, bis das Hähnchen goldbraun und das Gemüse karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass das Hähnchen vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
