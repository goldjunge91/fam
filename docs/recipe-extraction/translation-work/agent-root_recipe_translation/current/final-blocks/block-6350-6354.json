      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie Muscheln, indem Sie die Muscheln schrubben und die Bärte entfernen. Entsorgen Sie alle, die sich nicht schließen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem großen Topf schmelzen und gehackte Schalotten und Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weißwein angießen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Muscheln hinzufügen, abdecken und 5–7 Minuten garen. Dabei den Topf gelegentlich schwenken, bis sich die Schalen öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Muscheln mit einem Schaumlöffel herausnehmen und alle ungeöffneten Muscheln wegwerfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sahne in die Kochflüssigkeit einrühren und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Geben Sie die Muscheln wieder in den Topf, fügen Sie gehackte Petersilie, Salz und Pfeffer hinzu und rühren Sie vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln mit der Soße und knusprigem Brot zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
