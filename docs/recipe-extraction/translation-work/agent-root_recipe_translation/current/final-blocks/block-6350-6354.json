      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 375 °F vorheizen und eine Auflaufform einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schalotten und Champignons in Butter goldbraun anbraten, dann in der Auflaufform verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Seezunge trocken tupfen und Filets auf der Pilzmischung anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wein und Fischbrühe über die Seezunge gießen, mit Salz und Pfeffer würzen und mit Backpapier abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "12–15 Minuten backen, bis die Seezunge gerade gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In der Zwischenzeit Garnelen in Butter rosa anbraten, dann gereinigte Muscheln hinzufügen und kochen, bis sich die Schalen öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Auflaufform aus dem Ofen nehmen und die Kochflüssigkeit vorsichtig in einen Topf gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sahne und Zitronensaft unterrühren, dann Garnelen und Muscheln in die Soße geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Seezunge auf Serviertellern anrichten, mit Meeresfrüchten und Soße belegen und mit Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
