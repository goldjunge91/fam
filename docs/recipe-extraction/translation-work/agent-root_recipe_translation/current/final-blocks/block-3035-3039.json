      "steps": [
        {
          "position": 0,
          "text": "Hackfleisch mit gehackter Zwiebel, Petersilie, Minze, Knoblauch, Salz und Pfeffer in einer Schüssel gründlich vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischung in 8 gleiche Portionen teilen und jede länglich um einen Metallspieß zu einem zylindrischen Kebab formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grill oder Grillpfanne auf mittelhohe Hitze vorheizen und den Rost mit Öl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kebabs 10-12 Minuten grillen und häufig wenden, damit sie gleichmäßig garen und rundum bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatenhälften neben den Kebabs etwa 8-10 Minuten grillen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Chelo (persischen Reis) zubereiten, indem Basmatireis gekocht und mit geschmolzener Butter sowie Safran aufgelockert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reis auf einer Platte anrichten, heiße Kebabs darauflegen und mit gegrillter Tomate sowie Zwiebelscheiben servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
