      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch marinieren:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre die Marinade (1 Teelöffel Sojasauce, 1 Teelöffel chinesischer Reiswein, 1/2 Teelöffel Speisestärke, 1/8 Teelöffel schwarzer Pfeffer) in einer mittelgroßen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Rindfleischscheiben dazu, vermenge sie mit der Marinade und lass sie 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sauce vorbereiten:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre die Zutaten für die Sauce (2 Esslöffel Austernsauce, 1 Teelöffel chinesischer Reiswein, 1 Teelöffel Sojasauce, 1/4 cup Hühnerbrühe) in einer kleinen Schüssel. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brokkoli blanchieren oder dämpfen:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe einen Topf Wasser zum Kochen. Gib den Brokkoli hinein und gare ihn etwa 2 Minuten, bis er bissfest ist. Gieße ihn gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rindfleisch im Wok braten:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Erhitze eine große Pfanne oder einen Wok bei hoher Hitze, bis ein Wassertropfen zischend sofort verdampft. Gib das Öl dazu und schwenke die Pfanne, damit es sich verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gib das Rindfleisch hinein und verteile es sofort in einer Lage auf der Pfannenfläche, möglichst ohne dass sich die Stücke berühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Brate das Fleisch 1 Minute ungestört. Wende die Scheiben, gib Knoblauch dazu und brate alles weitere 30 seconds to 1 Minute, bis das Fleisch nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Sauce, Speisestärke und Brokkoli dazugeben:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Gieße Sauce und angerührte Speisestärke (1 Teelöffel Speisestärke in 1 Esslöffel Wasser aufgelöst) hinein. Rühre, bis die Sauce kocht und nach etwa 30 seconds eindickt. Hebe den Brokkoli unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Sofort servieren, mit gedämpftem Reis oder pur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
