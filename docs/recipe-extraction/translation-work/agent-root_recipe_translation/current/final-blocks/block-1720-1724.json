      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 150C/300F/Gas 2 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende das Rindfleisch mit Mehl, Salz und schwarzem Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze einen großen Schmortopf. Gib die Hälfte des Rapsöls und so viel Rindfleisch hinein, dass der Topfboden gerade bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate es rundum braun an, nimm es heraus und stelle es beiseite. Wiederhole dies mit dem restlichen Öl und Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Rindfleisch zurück in den Topf, gieße den Wein dazu und koche, bis sich die Flüssigkeit halbiert hat. Gib Brühe, Zwiebel, Karotten, Thymian und Senf dazu und würze großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und stelle ihn für zwei Stunden in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf aus dem Ofen, prüfe die Würzung und lass alles abkühlen. Entferne den Thymian.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenn das Fleisch abgekühlt und der Pie bereit zum Zusammensetzen ist, heize den Ofen auf 200C/400F/Gas 6 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib das Rindfleisch in eine Pieform. Bestreiche den Rand mit verquirltem Eigelb und lege den Teig darüber. Bestreiche auch die Oberfläche mit weiterem verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schneide überschüssigen Teig so ab, dass genug zum Verzieren des Randes bleibt. Backe den Pie 30 Minuten, bis der Teig goldbraun und durchgebacken ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Für die grünen Bohnen bringe einen Topf Salzwasser zum Kochen. Gib die Bohnen hinein und gare sie 4-5 Minuten, bis sie gerade weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Gieße die Bohnen ab, vermenge sie mit Butter und würze sie mit schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Serviere je einen großen Löffel Pie mit grünen Bohnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
