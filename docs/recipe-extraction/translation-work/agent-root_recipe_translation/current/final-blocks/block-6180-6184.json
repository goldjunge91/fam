      "steps": [
        {
          "position": 0,
          "text": "Vermische geraspelten Palmzucker, Kokosnuss, schwarzen Sesam und Salz in einer Schüssel zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser zum Reismehl und vermische es mit den Fingern, bis die Masse Semmelbröseln ähnelt und beim Zusammendrücken zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm eine kleine Portion Teig (etwa 2 Esslöffel), drücke sie in der Handfläche flach und gib 1 Esslöffel Füllung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage die Teigränder um die Füllung und drücke sie vorsichtig zusammen, sodass eine glatte Kugel entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Ghee in einer flachen Pfanne oder auf einer Grillplatte bei mittlerer Hitze und lege das Pitha hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe es auf der ersten Seite 3-4 Minuten goldbraun. Wende es vorsichtig und backe die andere Seite weitere 3-4 Minuten, bis sie gleichmäßig gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das Pitha auf einen Teller und lass es vor dem Servieren warm oder bei Zimmertemperatur 2-3 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
