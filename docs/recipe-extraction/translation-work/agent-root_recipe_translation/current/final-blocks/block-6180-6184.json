      "steps": [
        {
          "position": 0,
          "text": "Weiche Urdbohnen und halbierte Kichererbsen zusammen 2 Stunden in Wasser ein und gieße sie gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle die eingeweichten Linsen in einem Nassmahlwerk oder einer Küchenmaschine. Gib möglichst wenig Wasser hinzu, bis ein dicker, luftiger Teig entsteht, der seine Form behält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Teig in eine Schüssel und hebe grüne Chilischoten, Ingwer, Zwiebel, Curryblätter, Salz, zerstoßene Pfefferkörner und Kreuzkümmelsamen vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Masse 15 Minuten ruhen und erhitze währenddessen Kokosöl in einem tiefen Topf auf 350°F (175°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Befeuchte deine Hände, nimm eine Portion Teig (etwa 2 Esslöffel) und forme eine Kugel. Drücke mit dem Daumen ein Loch in die Mitte und erweitere es vorsichtig zu einem Ring.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Vadas vorsichtig ins heiße Öl gleiten und frittiere jeweils 3-4 Stück, ohne den Topf zu voll zu machen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere sie 3-4 Minuten und wende sie einmal, bis beide Seiten goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus, lass sie auf Küchenpapier abtropfen und serviere sie warm mit Kokos-Chutney oder Sambar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
