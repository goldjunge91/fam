      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Knoblauch, Korianderwurzeln und schwarze Pfefferkörner gemeinsam in einem Mörser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die Paste mit Fischsauce, Limettensaft, Öl und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe das schmetterlingsartig aufgeschnittene Hähnchen innen und außen gründlich mit der Marinade ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse es mindestens 30 Minuten bei Raumtemperatur oder bis zu 4 Stunden im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize Grill oder Grillpfanne auf mittelhohe bis hohe Hitze vor und öle den Rost ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Hähnchen mit der Hautseite nach unten auf den Grill und gare es 20-25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende es und gare es mit der Hautseite nach oben weitere 15-20 Minuten, bis die Haut knusprig ist und die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse es vor dem Servieren 5 Minuten ruhen und reiche Klebreis und Papayasalat dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
