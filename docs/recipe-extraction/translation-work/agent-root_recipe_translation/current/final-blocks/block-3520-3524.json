        {
          "position": 0,
          "text": "Erhitze Öl in einem Topf und dünste Knoblauch, Galgant und Zitronengras 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Kokosmilch und Wasser dazu und bringe alles zum sanften Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Fischfilet und Fischkuchenscheiben dazu und lasse sie 10-12 Minuten köcheln, bis der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Fischsauce ein und schmecke das Gericht ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Dill dazu und rühre vorsichtig, damit der Fisch nicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles weitere 2-3 Minuten köcheln, bis der Dill zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß in Schalen mit Brühe und Klebreis als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
