      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Topf und dünste Knoblauch, Schalotten und Galgant 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinerippchen dazu und bräune sie 5-7 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Wasser oder Brühe dazu, bringe alles zum Kochen, reduziere dann die Hitze und lasse es köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche das Schweinefleisch 15-20 Minuten, bis es fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kürbiswürfel dazu und lasse alles weitere 10 Minuten köcheln, bis der Kürbis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Fischsauce ein, probiere das Gericht und schmecke es nach Bedarf ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Dill dazu, rühre vorsichtig um und lasse alles weitere 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere den herzhaften Eintopf heiß mit Klebreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
