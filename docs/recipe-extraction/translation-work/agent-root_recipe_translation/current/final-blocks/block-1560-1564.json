      "externalId": "waivy:mfr-ital-pasta-norma",
      "slug": "mfr-ital-pasta-norma",
      "title": "Pasta alla Norma",
      "instructions": "Siziliens berühmtes Pastagericht: geröstete Auberginenwürfel mit einer kräftigen Tomatensauce, bissfesten Rigatoni, gezupftem Basilikum und reichlich gesalzener Ricotta. So sättigend, dass man das Fleisch nicht vermisst.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Auberginen sind in der Saison sehr günstig. Verwende zwei große.",
        "Auberginen zu rösten statt zu braten braucht nur einen Bruchteil des Öls.",
        "Ricotta ist optional, macht das Gericht aber besonders üppig."
      ],
      "substitutions": [
        {
          "forIngredientId": "rigatoni",
          "swap": "Penne oder Ziti, jede röhrenförmige Pasta"
        },
        {
          "forIngredientId": "ricotta",
          "swap": "Zerbröselter Feta für eine salzigere Note"
        }
      ],
