      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 425 °F vor und legen Sie einen Tortenboden in eine 9-Zoll-Kuchenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blaubeeren, Zucker, Maisstärke, Zitronensaft und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Heidelbeermischung in den Tortenboden geben und mit Butterstückchen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit dem zweiten Tortenboden bedecken, Ränder abschneiden und mit einer Gabel festdrücken, um ihn zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ei und Wasser verquirlen, um das Ei zu verquirlen, dann die obere Kruste damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneiden Sie vier kleine Schlitze in die obere Kruste, damit der Dampf entweichen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15 Minuten bei 425 °F backen, dann die Hitze auf 350 °F reduzieren und 35–40 Minuten backen, bis die Kruste goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Schneiden mindestens 2 Stunden auf einem Kuchengitter abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
