      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie zwei runde 8-Zoll-Kuchenformen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker etwa 3 Minuten lang schaumig rühren, bis eine leichte, lockere Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fügen Sie die Eier einzeln hinzu, schlagen Sie sie nach jeder Zugabe auf und mischen Sie dann die Vanille unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer separaten Schüssel Mehl, Backpulver und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abwechselnd trockene Zutaten und Buttermilch zur Buttermischung geben, beginnend und abschließend mit trockenen Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teilen Sie den Teig in Portionen auf und färben Sie die Portionen mit roter und gelber Lebensmittelfarbe ein, um Hummerfarben zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bunte Teige in Formen schichten und 28–32 Minuten backen, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vollständig abkühlen lassen, dann Schichten einfrieren und stapeln, wobei die Außenseite mit Frischkäse-Zuckerguss bestreicht wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Formen Sie den Fondant zu einer Hummerfalle und legen Sie ihn als Dekoration darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
