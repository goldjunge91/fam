      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und kochen Sie die Nudeln 1 Minute lang al dente, dann abtropfen lassen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem großen Topf bei mittlerer Hitze schmelzen, dann Mehl einrühren und 1 Minute kochen lassen, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Unter ständigem Rühren langsam Milch hinzufügen, um Klumpen zu vermeiden, und dann 5 Minuten kochen lassen, bis die Masse eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vom Herd nehmen und Cheddar und Gruyere-Käse unterrühren, bis alles geschmolzen und glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochte Nudeln, Hummerfleisch und Estragon vorsichtig unterheben und mit Salz, Pfeffer und Cayennepfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In eine gebutterte 9x13-Auflaufform geben und mit Panko-Semmelbröseln belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15–18 Minuten backen, bis die Ränder goldbraun und sprudelnd sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
