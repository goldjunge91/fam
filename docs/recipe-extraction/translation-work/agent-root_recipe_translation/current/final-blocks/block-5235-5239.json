          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Chipotle-Chilis mit saurer Sahne und dem Saft einer 1/2 Limette zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme schwarze Bohnen und Mais zusammen in einem kleinen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den gekochten Reis auf zwei Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege jede Schale mit Hähnchen, Bohnen, Mais, Käse und einem Klecks Chipotle-Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere die Bowls mit Koriander und Limettenspalten.",
