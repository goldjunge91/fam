      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in Salzwasser etwa 15 Minuten sehr weich kochen, schälen und gründlich stampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ají-Schote und Knoblauch zu einer glatten Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffelpüree mit Ají-Knoblauch-Paste, zerkrümeltem Frischkäse, Milch, Ei, Salz und Pfeffer glatt vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pflanzenöl in einem tiefen Topf oder einer Fritteuse auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit zwei Löffeln oder einem Eisportionierer vorsichtig kleine ovale Bratlinge formen und ins heiße Öl gleiten lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "3-4 Minuten goldbraun frittieren, dabei nach der Hälfte einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einer Schaumkelle herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren, nach Wunsch mit Aji Verde oder Huancaína-Sauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
