        {
          "position": 2,
          "text": "Gewürfelte Zwiebel hinzufügen und weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Chilipastenmischung über das Schweinefleisch gießen und gut umrühren.",
          "timerMinutes": null,
