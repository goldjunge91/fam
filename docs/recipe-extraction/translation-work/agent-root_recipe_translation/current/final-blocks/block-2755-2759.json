      "steps": [
        {
          "position": 0,
          "text": "Garnelen trocken tupfen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 tbsp Olivenöl in einem Wok oder einer großen Pfanne bei starker Hitze erhitzen, bis es raucht; Garnelen hinzufügen und 2 Minuten unter Rühren braten, bis sie sich rosa färben, dann auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die restlichen 2 tbsp Öl in die Pfanne geben und geschnittene Zwiebeln, Knoblauch sowie gewürfelte Ají-Schote 3 Minuten unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte rote Paprika und Tomaten hinzufügen und weitere 3 Minuten pfannenrühren, bis das Gemüse bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garnelen zurück in die Pfanne geben und alles vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasauce und Weißweinessig hinzufügen und 2 Minuten unter ständigem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und bei Bedarf zusätzlich Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort auf weißem Reis servieren und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
