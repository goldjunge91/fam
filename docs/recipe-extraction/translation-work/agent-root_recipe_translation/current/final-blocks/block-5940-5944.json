      "steps": [
        {
          "position": 0,
          "text": "Bringe die Gemüsebrühe in einem großen Topf zum Kochen und teile den Blumenkohl in Röschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Blumenkohlröschen 8–10 Minuten, bis sie gerade weich sind. Gieße sie gut ab und gib sie auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pelle währenddessen die hart gekochten Eier und hacke sie fein. Hacke den Knoblauch ebenfalls fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz die Butter in einer Pfanne bei mittlerer Hitze. Gib die Panko-Semmelbrösel dazu und röste sie unter ständigem Rühren 3–4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den gehackten Knoblauch zu den Semmelbröseln und brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und rühre die gehackten Eier und frische Petersilie unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Semmelbrösel-Ei-Mischung auf den warmen Blumenkohlröschen und beträufle sie mit Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
