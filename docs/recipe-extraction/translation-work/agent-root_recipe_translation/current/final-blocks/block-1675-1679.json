      "steps": [
        {
          "position": 0,
          "text": "Aubergine und Kürbis schälen und in mittelgroße Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem mittelgroßen Topf bei mittelhoher Hitze erwärmen. Zwiebel und Knoblauch 2 Minuten weich, aber nicht braun dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kürbis und Aubergine dazugeben und weitere zwei bis drei Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser zugießen, bis das Gemüse gerade bedeckt ist. Zum Kochen bringen, Hitze reduzieren und köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehackten Spinat dazugeben, umrühren und weitere 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gemüsemischung in ein Sieb gießen und abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abgetropftes Gemüse zurück in den Topf geben und mit einem Kartoffelstampfer oder einem stabilen Schneebesen kräftig zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen und abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
