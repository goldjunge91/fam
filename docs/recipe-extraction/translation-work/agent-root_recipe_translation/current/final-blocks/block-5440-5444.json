        {
          "position": 0,
          "text": "Schneide die Pilze in Scheiben und würfle die Zwiebel fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 EL Butter in einer Pfanne und dünste Pilze und Zwiebeln 8 Minuten goldbraun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme aus dem Rinderhackfleisch 8 kleine Patties und würze sie mit Salz, Pfeffer und Knoblauchpulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Patties in derselben Pfanne bei mittlerer bis hoher Hitze je Seite 3–4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jedes Patty mit einer Scheibe Schweizer Käse und decke die Pfanne 1 Minute ab, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Sliderbrötchen mit der restlichen Butter an und belege sie mit Rindfleisch, Käse und Pilzmischung.",
