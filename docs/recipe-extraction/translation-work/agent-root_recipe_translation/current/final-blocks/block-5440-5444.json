          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerpflücke das gegarte Hähnchen mit zwei Gabeln in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge das gezupfte Hähnchen mit Buffalo-Sauce, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die Sliderbrötchen mit Butter und röste sie in einer Pfanne je Seite 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Brötchen mit Buffalo-Hähnchen und bestreue es mit zerbröseltem Blauschimmelkäse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Slider mit Selleriestangen und Ranch-Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
