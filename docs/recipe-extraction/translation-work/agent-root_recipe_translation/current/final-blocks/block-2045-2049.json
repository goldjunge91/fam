      "steps": [
        {
          "position": 0,
          "text": "Pfanne erhitzen und etwas Öl hineingeben. Zuerst zerdrückten Knoblauch und Ingwer anbraten, dann Hackfleisch und alle Gewürze dazugeben. Wenn das Fleisch gar ist, zum Abkühlen beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine weitere große Schüssel nehmen. Ei, gehackte Tomate, gehackte Frühlingszwiebel und Hackfleisch hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein 2-lagiges Filoteigblatt oder 1 Blatt Frühlingsrollenpapier nehmen. Mit Butter bestreichen und etwas Füllung in die Mitte geben. Teig zusammenfalten und die Verschlussstelle mit weiterer Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pfanne erhitzen und etwas Öl hineingeben. Päckchen darin braten, bis beide Seiten und alle 4 Kanten goldbraun sind. (Oder das Päckchen rundherum mit geschmolzener Butter bestreichen und bei 180°C 10–15 Minuten im Ofen backen.)",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Genießen!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
