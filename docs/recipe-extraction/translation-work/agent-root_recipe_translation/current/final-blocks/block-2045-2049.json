      "steps": [
        {
          "position": 0,
          "text": "Zwiebel und Knoblauch hacken, Pilze in Scheiben schneiden und Buchweizen waschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl erhitzen und Zwiebel leicht anschwitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pilze und Knoblauch dazugeben und weiter anschwitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Salz, Gemüsewürze, Buchweizen und Lorbeerblatt dazugeben und mit Wasser bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sanft köcheln lassen. Kurz bevor alles vollständig gar ist, Pfeffer, mit Mehl verrührte saure Sahne, gehackte Petersilie und Essig nach Geschmack dazugeben.",
