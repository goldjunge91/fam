      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne und brate Knoblauch an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehackfleisch dazu und brate es unter Zerteilen krümelig und braun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Garnelen hinzu und gare sie 2-3 Minuten, bis sie sich rosa färben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe dazu, gib Fischsauce, Zucker und schwarzen Pfeffer hinein und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Taue Bánh-Hỏi-Nudeln auf, falls sie tiefgekühlt sind, und trenne sie vorsichtig voneinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Nudeln in die Pfanne und rühre sie vorsichtig unter, damit sie sich mit Brühe und Toppings vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles 3-4 Minuten, bis die Nudeln durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit Frühlingszwiebeln und serviere es heiß in flachen Schalen mit Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
