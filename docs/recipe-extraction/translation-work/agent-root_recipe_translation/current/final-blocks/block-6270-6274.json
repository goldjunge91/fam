      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einer großen Pfanne bei mittlerer Hitze und brate gehackten Knoblauch 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehackfleisch dazu und brate es 5 Minuten unter Zerteilen, bis keine rosa Stellen mehr zu sehen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gewürfelte Karotten und geraspelten Kohl ein und gare alles 4 Minuten, bis das Gemüse leicht weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sojasauce, Salz und Pfeffer dazu, nimm die Pfanne vom Herd und lass die Füllung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffels Füllung in die Mitte jedes Teigblatts, klappe die Ecken ein, rolle es fest auf und verschließe den Rand mit etwas Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze 3 cups Öl in einem tiefen Topf oder Wok auf 350°F und frittiere die Lumpia portionsweise jeweils 2-3 Stück etwa 3 Minuten pro Portion goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie heiß mit süß-saurer Sauce oder Essig zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
