      "steps": [
        {
          "position": 0,
          "text": "Verrühre gehackten Knoblauch, Fischsauce, Zucker, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche beide Seiten jedes Reispapierblatts mit der Öl-Saucen-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Sesam gleichmäßig auf eine Seite jedes Blatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze einen Grill oder eine Grillpfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille das Reispapier pro Seite 2-3 Minuten, bis es knusprig und leicht angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide es in Dreiecke oder mundgerechte Stücke und serviere es heiß oder bei Zimmertemperatur mit Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
