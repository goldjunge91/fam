      "steps": [
        {
          "position": 0,
          "text": "Lass die Kichererbsen abtropfen und zerdrücke sie mit einer Gabel, ohne sie zu fein zu pürieren; etwas Struktur soll bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Mehl, Kreuzkümmel, Knoblauchpulver und Salz unter. Forme 6 kleine Bratlinge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche sie mit Olivenöl und gare sie bei 380°F 12 Minuten in der Heißluftfritteuse; wende sie nach 6 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Übergieße den Couscous mit kochendem Wasser aus dem Wasserkocher, decke ihn 5 Minuten ab und lockere ihn mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Joghurt, Zitronensaft und eine Prise Salz. Serviere Couscous, Bratlinge und Joghurtsauce zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
