      "steps": [
        {
          "position": 0,
          "text": "Nehmen Sie die Steaks 30 Minuten vor dem Garen aus dem Kühlschrank und tupfen Sie sie mit Papiertüchern trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Beide Seiten großzügig mit koscherem Salz und schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer gusseisernen Pfanne bei starker Hitze erhitzen, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Braten Sie die Steaks 4–5 Minuten pro Seite an, um sie mittel-selten zuzubereiten, und reduzieren Sie dann die Hitze auf mittlere Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter, Knoblauch und Thymian in die Pfanne geben und die Steaks 2 Minuten lang kontinuierlich damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einen Teller geben und vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
