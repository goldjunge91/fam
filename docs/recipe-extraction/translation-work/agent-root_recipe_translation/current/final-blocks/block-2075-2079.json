      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350ºF (180ºC) vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erdnussbutter, Zucker und Ei in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen Löffel Teig abnehmen und zu einer Kugel rollen. Teigkugeln auf ein antihaftbeschichtetes Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für zusätzliche Verzierung und gleichmäßigeres Backen die Teigkugeln mit einer Gabel flach drücken, dann die Gabel um 90º drehen und nochmals drücken, sodass ein Kreuzmuster entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
