      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in einem großen Topf mit Salzwasser sehr weich kochen. Abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln mit einem Stampfer grob mit mindestens 30 ml (2 Esslöffeln) Butter zerdrücken. Mit einem elektrischen Mixer und der Milch pürieren. Mit Salz und Pfeffer würzen. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backofenrost auf mittlere Höhe stellen und den Ofen auf 190 °C (375 °F) vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer großen Pfanne Zwiebel in der übrigen Butter anbräunen. Fleisch dazugeben und goldbraun braten. Mit Salz und Pfeffer würzen. Vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fleisch leicht auf den Boden einer quadratischen Auflaufform von 20 cm (8 inch) drücken. Mit Mais und Kartoffelpüree bedecken. Mit Paprika und Petersilie bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwa 30 Minuten backen. Unter dem Grill fertig garen. 10 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
