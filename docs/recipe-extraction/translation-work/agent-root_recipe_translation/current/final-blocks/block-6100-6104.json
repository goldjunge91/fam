      "steps": [
        {
          "position": 0,
          "text": "Weiche Basmatireis 20 Minuten in Wasser ein und gieße ihn ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide 2 Zwiebeln in dünne Scheiben und brate sie in Ghee goldbraun. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke die dritte Zwiebel fein und gare sie im restlichen Ghee weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Ingwer-Knoblauch-Paste dazu und gare sie 1 Minute. Füge Hackfleisch hinzu und brate es bei hoher Hitze 5 Minuten krümelig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Joghurt und Chilipulver ein und lasse alles 10 Minuten köcheln, bis das Fleisch teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den abgetropften Reis und Erbsen dazu und vermische alles vorsichtig. Gieße 4 Tassen kochendes Wasser hinein und füge Kardamom und Zimt hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf fest ab, bringe alles 3 Minuten zum Kochen, reduziere dann die Hitze und gare den Reis 20 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege den Pulao mit Röstzwiebeln, decke ihn 2 Minuten ab, lockere ihn mit einer Gabel auf und serviere heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
