      "steps": [
        {
          "position": 0,
          "text": "Weiche den Klebreis vor der Verwendung mindestens 1 ½ Stunden in Wasser ein. Gieße ihn ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite eine runde oder quadratische Kuchenform mit 9-inch Durchmesser vor und besprühe sie mit Backspray oder lege sie mit Frischhaltefolie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Kokosmilch, Wasser, Salz und Reis. Gieße die Mischung in die Form und lege Pandanknoten darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dämpfe alles 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lockere den Reis nach 30 Minuten auf und entferne die Pandanknoten. Drücke den gedämpften Reis mit einem gefetteten Pfannenwender flach. Achte darauf, dass keine Löcher, Luftblasen oder Lücken im Reis bleiben, besonders an den Rändern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe alles weitere 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Pandansaft, Kokosmilch, Weizenmehl, Maismehl und Zucker gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Eier dazu, verquirle alles gut und seihe die Mischung in eine mittelgroße Metallschüssel oder einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Stelle die Pandanmischung über siedendes Wasser (Wasserbad oder Bain-Marie).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Rühre ständig und gare die Mischung, bis die Creme eindickt (15 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gieße die Pandancreme auf die Klebreisschicht und klopfe leicht gegen die Form, damit Luftblasen entweichen. Dämpfe alles weitere 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Nimm Seri Muka Kuih aus dem Dämpfer und lass es vollständig abkühlen, bevor du es in Rechtecke oder Rauten schneidest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
