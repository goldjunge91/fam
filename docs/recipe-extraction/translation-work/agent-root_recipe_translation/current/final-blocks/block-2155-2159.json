      "steps": [
        {
          "position": 0,
          "text": "Würze 6 Wolfsbarschfilets mit Salz und Pfeffer und ritze die Haut 3 Mal ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine schwere Pfanne und gib 1 EL Sonnenblumenöl hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Wolfsbarschfilets mit der Hautseite nach unten 5 mins oder bis die Haut sehr knusprig und goldbraun ist. Der Fisch sollte fast gar sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende die Filets, gare sie weitere 30 seconds - 1 minute und lege sie dann auf eine Servierplatte. Halte sie warm. Brate den Wolfsbarsch in 2 Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze 2 EL Sonnenblumenöl und brate ein großes Stück geschälten, in Stifte geschnittenen Ingwer, 3 dünn geschnittene Knoblauchzehen und 3 fein geschnittene rote Chilis etwa 2 mins goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und wende ein Bund zerkleinerte Frühlingszwiebeln darin. Beträufle den Fisch mit 1 EL Sojasauce und löffle den Pfanneninhalt darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
