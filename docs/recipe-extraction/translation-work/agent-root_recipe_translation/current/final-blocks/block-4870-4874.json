      "steps": [
        {
          "position": 0,
          "text": "Den Reis unter kaltem Wasser abspülen, bis das Wasser klar abläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hühnerbrühe mit Ingwerscheiben in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Reis hinzufügen und umrühren, damit er nicht am Topfboden klebt. Dann die Hitze reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ohne Deckel 60–70 Minuten köcheln lassen und gelegentlich umrühren, bis der Reis zerfällt und ein cremiger Brei entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abalone aus der Dose abgießen, in dünne Scheiben schneiden und in den letzten 5 Minuten der Kochzeit zum Reisbrei geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Sojasauce, Salz und weißem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schalen schöpfen und mit Sesamöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
