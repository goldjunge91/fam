          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch, gehackte Leber, Zwiebeln, Knoblauch, Ingwer und scharfe Chilischoten in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Fleischmischung großzügig mit Salz, Pfeffer, Kreuzkümmel und Koriander würzen und gründlich vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hüllen vorsichtig mit einem Wurstfüller oder Spritzbeutel mit der Fleischmischung füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hüllen mit Küchengarn in Abständen von 4 Zoll abbinden, sodass einzelne Würste entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Wurst mehrmals mit einer Gabel einstechen, damit sie nicht platzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Würste bei mittlerer bis hoher Hitze 15–20 Minuten grillen oder in der Pfanne braten und dabei häufig wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
