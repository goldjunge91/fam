      "steps": [
        {
          "position": 0,
          "text": "Pfeilwurzmehl mit Wasser in einer Schüssel zu einer glatten Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Milch in einem Topf bei mittlerer Hitze erwärmen, bis sie dampft, aber nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Pfeilwurzelpaste langsam unter ständigem Rühren in die heiße Milch gießen, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Unter weiterem Rühren 3–4 Minuten kochen, bis die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zucker, Salz und Vanilleextrakt hinzufügen und rühren, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Noch 1 Minute kochen, bis die gewünschte Dicke erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schalen füllen und heiß servieren, nach Wunsch mit Zimt oder Honig garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
