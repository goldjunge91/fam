      "steps": [
        {
          "position": 0,
          "text": "5 Tassen Wasser mit Salz in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Maismehl langsam unter ständigem Rühren einstreuen, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hitze reduzieren und 15 Minuten köcheln lassen. Häufig umrühren, bis die Masse dick und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einem anderen Topf Öl erhitzen und Zwiebeln sowie Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Tomaten, Bohnen, Kreuzkümmel und 1 Tasse Wasser hinzufügen. 12 Minuten köcheln lassen, bis der Eintopf eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den heißen Posho auf Tellern anrichten und den Bohneneintopf darüberlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
