      "steps": [
        {
          "position": 0,
          "text": "Rindfleischwürfel, Zwiebeln, Tomaten und Paprika abwechselnd auf die eingeweichten Holzspieße stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl, Salz, Pfeffer, Knoblauch und Zitronensaft in einer Schüssel vermischen und großzügig auf die Spieße pinseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen Grill oder eine Grillpfanne bei mittlerer bis hoher Hitze stark erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Spieße auf den heißen Grill legen und 12–15 Minuten garen. Alle 3 Minuten wenden, bis das Fleisch gebräunt und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und vor dem Servieren 2 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
