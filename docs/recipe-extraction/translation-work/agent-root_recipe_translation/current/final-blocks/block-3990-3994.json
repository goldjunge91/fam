      "steps": [
        {
          "position": 0,
          "text": "Mungbohnen gründlich abspülen, 2 Stunden in Wasser einweichen und anschließend abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bohnen in frischem Wasser 30 Minuten kochen, bis sie teilweise gar sind, dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebeln, Knoblauch und Ingwer anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Tomaten hinzufügen und unter gelegentlichem Rühren 5 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die teilweise gekochten Bohnen hinzufügen und 4 Tassen frisches Wasser zugießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 20–25 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gelegentlich umrühren und mehr Wasser hinzufügen, falls die Bohnen zu trocken wirken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen und heiß als Hauptgericht oder mit Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
