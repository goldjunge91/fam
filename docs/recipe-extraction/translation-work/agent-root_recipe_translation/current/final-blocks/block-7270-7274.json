          "swap": "almond-Milch oder oat-Milch",
          "savings": "Mit Pflanzendrink wird es milchfrei; Eigenmarken sind oft günstiger als Milch."
        },
        {
          "forIngredientId": "protein-powder",
          "swap": "greek-Joghurt",
          "savings": "Eine halbe Tasse griechischer Joghurt liefert Eiweiß und Cremigkeit und kostet weniger als hochwertiges Proteinpulver."
        },
        {
          "forIngredientId": "peanut-butter",
          "swap": "gefroren-berries",
          "savings": "Eine Handvoll tiefgekühlte Beeren ergibt eine fruchtigere und günstigere Mischung."
        }
