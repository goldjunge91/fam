      "steps": [
        {
          "position": 0,
          "text": "Koche Augenbohnen in Salzwasser etwa 12-15 Minuten, bis sie weich sind, und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zermahle geriebene Kokosnuss, Kreuzkümmelsamen, grüne Chilis und Ingwer mit möglichst wenig Wasser zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Kokosöl in einem Topf und gib Curryblätter hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kürbiswürfel hinzu und dünste sie 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochte Augenbohnen und die gemahlene Kokospaste hinzu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare alles bei mittlerer Hitze 8-10 Minuten, bis der Kürbis weich ist und sich die Aromen verbunden haben. Heiß mit Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
