      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 Esslöffel Kokosöl in einer großen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Reismehl hinzu und röste es 3-4 Minuten unter ständigem Rühren, bis es hellbraun duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Pfanne vom Herd und lasse die Mischung etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz in einer anderen Pfanne Jaggery mit 0.5 Tasse Wasser bei niedriger Hitze und rühre, bis es vollständig aufgelöst ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kokosraspeln und zerstoßenen Kardamom zur Jaggery-Mischung und gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das geröstete Reismehl zur Jaggery-Kokos-Mischung und rühre alles gut durch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die restlichen 2 Esslöffel Kokosöl und Salz hinzu und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Mischung auf Backpapier und verstreiche sie etwa 0.5 Zoll dick.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie 10-15 Minuten abkühlen, schneide sie dann in Quadrate und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
