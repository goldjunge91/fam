      "steps": [
        {
          "position": 0,
          "text": "Erhitze Kokosöl in einem großen Topf bei mittlerer Hitze, gib gehackte Zwiebel hinzu und gare sie 4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch, Ingwer und getrocknete Chili hinzu und rühre 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Currypulver und Kurkumapulver hinzu und rühre 1 Minute ständig, damit die Gewürze ihr Aroma entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchenwürfel hinzu und brate sie 3-4 Minuten unter Rühren leicht rundum an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch hinzu, gib Curryblätter dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 25-30 Minuten köcheln. Rühre gelegentlich um, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Limettensaft und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit gedämpftem Reis oder Roti servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
