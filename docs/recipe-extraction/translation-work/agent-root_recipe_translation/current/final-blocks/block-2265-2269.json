      "steps": [
        {
          "position": 0,
          "text": "Siebe die trockenen Zutaten zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die flüssigen Zutaten und rühre sie unter die trockenen. Verrühre alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib mit einem Teelöffel kleine Portionen (nicht größer) in heißes Öl (365 Grad, nicht heißer). Wende sie nach wenigen Augenblicken, bis alle Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm sie heraus und lasse sie abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wälze sie noch warm in Zimtzucker und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
