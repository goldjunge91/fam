      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Kimchi dazu und brate alles unter Rühren 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Reis vom Vortag dazu, lockere Klümpchen auf und brate ihn 3 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Sojasauce und Sesamöl dazu und vermenge alles 1 Minute lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schiebe den Reis an den Pfannenrand und forme in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das übrige Öl in die Mulde und schlage die Eier hinein. Rühre sie, bis sie gerade gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mische das Rührei unter den Reis und rühre Frühlingszwiebeln ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere den Reis, passe bei Bedarf das Salz an und serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
