      "steps": [
        {
          "position": 0,
          "text": "Koche die Eier 8-10 Minuten hart, kühle sie ab, schäle sie und schneide sie in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Kartoffel in dünne Scheiben und brate sie in Olivenöl etwa 15 Minuten goldbraun und weich. Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Aubergine längs in 1/4-inch dicke Scheiben und bestreiche sie mit Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Auberginenscheiben bei 400°F 20 Minuten, bis sie weich und leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Tahini, Zitronensaft, gehackten Knoblauch, Salz und Wasser zu einer glatten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme das Fladenbrot in einer Pfanne oder im Ofen 1 Minute, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte gebratene Kartoffeln, geröstete Aubergine und Eierscheiben auf dem geöffneten Fladenbrot an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle die Füllung großzügig mit Tahini-Sauce und serviere das Sabich sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
