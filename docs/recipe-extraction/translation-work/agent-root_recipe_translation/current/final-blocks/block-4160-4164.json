          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Je 2 Esslöffel Masa auf jedes Maisblatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Löffel Hähnchen, eine Scheibe Jalapeño, eine Olive und eine Rosine in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seiten des Blatts über die Füllung und das untere Ende nach oben falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tamales aufrecht in einen Dämpftopf mit Wasser unterhalb des Dämpfeinsatzes stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "45 Minuten dämpfen und vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Warm mit heißer Schokolade oder Kaffee servieren.",
