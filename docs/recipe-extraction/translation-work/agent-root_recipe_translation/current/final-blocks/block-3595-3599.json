      "steps": [
        {
          "position": 0,
          "text": "Vermische Masa Harina mit warmem Wasser und Salz zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme den Teig zu 9 kleinen Kugeln etwa in Walnussgröße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke jede Kugel zwischen Frischhaltefolie vorsichtig zu einer dünnen runden Scheibe und lasse die Mitte etwas dicker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne auf 350°F und frittiere die Scheiben je 1 Minute pro Seite, bis sie leicht goldbraun und aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse sie auf Küchenpapier abtropfen und leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze zerpflücktes Hähnchen mit Limettensaft und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jedes Salbute mit Salat, Tomate, eingelegter Zwiebel und gewürztem Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle es mit Habanero-Sauce und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
