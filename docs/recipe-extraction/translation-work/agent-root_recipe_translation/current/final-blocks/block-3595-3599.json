      "steps": [
        {
          "position": 0,
          "text": "Brate Schweinehackfleisch in einer Pfanne bei mittlerer Hitze krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Zwiebel und Knoblauch dazu und gare alles, bis es duftet. Würze dann mit Kreuzkümmel und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke hart gekochte Eier und grüne Oliven und mische sie unter das gegarte Schweinefleisch. Lasse die Füllung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite Masa-Teig zu, indem du Masa Harina mit warmem Wasser und Salz vermischst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 8 gleich große Portionen und drücke jede zwischen Frischhaltefolie zu einer Scheibe von 4-inch Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 2 tbsp Schweinefleischfüllung und einige gehackte Eistücke in die Mitte jeder Scheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klappe die Scheiben halbmondförmig zusammen und drücke die Ränder fest, um sie zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze Öl auf 350°F und frittiere Empanadas 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
