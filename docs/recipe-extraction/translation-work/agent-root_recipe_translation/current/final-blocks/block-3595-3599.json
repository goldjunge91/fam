      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweinefleisch in 1-inch große Würfel und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Zwiebel, Knoblauch, Limettensaft, Orangensaft, Kreuzkümmel, Oregano, Salz und Pfeffer zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Marinade über das Schweinefleisch, gib geschnittene Habanero dazu und stelle es mindestens 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einem großen Topf oder Schmortopf bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinefleisch und Marinade in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und gare alles 35-40 Minuten, bis das Schweinefleisch zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht mit Limettenspalten und warmen Maistortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
