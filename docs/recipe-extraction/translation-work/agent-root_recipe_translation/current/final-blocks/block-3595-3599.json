      "steps": [
        {
          "position": 0,
          "text": "Vermische Masa Harina mit warmem Wasser und Salz zu einem weichen Teig, der zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Teig in 12 gleich große Kugeln und drücke jede zwischen Frischhaltefolie zu einer dünnen Scheibe von 3-inch Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere jede Scheibe 30 Sekunden. Wende sie und frittiere sie, bis sie aufgeht, aber noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Scheiben aus dem Öl und schneide vorsichtig noch warm seitlich einen Schlitz in jede Panucho.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle jedes Panucho mit 1-2 tbsp zerdrückten schwarzen Bohnen, indem du einen kleinen Löffel verwendest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege es mit zerpflücktem Hähnchen, gewürzt mit Limettensaft, Salz und gehackter Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Panuchos mit eingelegten Zwiebeln und Habanero-Sauce als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
