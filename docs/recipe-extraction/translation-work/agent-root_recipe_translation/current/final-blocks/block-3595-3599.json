      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer Pfanne und brate Tortillas knusprig. Lege sie dann auf Servierteller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste in derselben Pfanne gewürfelte Zwiebel und Schinken, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Erbsen zur Schinkenmischung und gare alles 2 Minuten. Stelle die Mischung beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage Eier in die Pfanne und brate sie mit der Eigelbseite nach oben oder als Spiegelei mit leicht gestocktem Eigelb, bis das Eiweiß fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bereite eine einfache Sauce zu, indem du Tomate, Habanero und Salz pürierst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Spiegeleier auf die gebratenen Tortillas und gib Schinken-Erbsen-Mischung daneben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle das Gericht mit Tomaten-Habanero-Sauce und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
