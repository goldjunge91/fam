      "steps": [
        {
          "position": 0,
          "text": "Rotwein, Essig, Knoblauchzehen, Lorbeerblätter und Pfefferkörner in einer Schüssel vermengen, um die Marinade zuzubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Entenstücke in einen großen Behälter legen, die Marinade darübergießen, abdecken und über Nacht oder mindestens 4 Stunden im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Ente aus der Marinade nehmen, trocken tupfen und die Marinade separat aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und die Entenstücke von allen Seiten anbraten, insgesamt etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die beiseitegestellte Marinade über die Ente gießen, zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 45 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln schälen und vierteln, mit der Ente in den Topf geben und weitere 25 Minuten köcheln lassen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz würzen, mit frischer Petersilie garnieren und heiß servieren, dabei die kräftige Sauce darüberlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
