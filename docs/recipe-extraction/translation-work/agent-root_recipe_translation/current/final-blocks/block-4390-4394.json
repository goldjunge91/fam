      "steps": [
        {
          "position": 0,
          "text": "Fischbrühe und Weißwein in einem großen Topf zum Kochen bringen, dann Garnelen und Muscheln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "4-5 Minuten kochen, bis die Garnelen rosa sind und sich die Muscheln öffnen, dann die Meeresfrüchte herausnehmen und die Brühe abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Altbackenes Brot in Würfel schneiden und Olivenöl in einem Topf bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch ins Öl geben und 1 Minute anbraten, dann die Brotwürfel hinzufügen und schwenken, bis sie vollständig mit Öl bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die abgesiebte Brühe über die Brotmischung gießen und 5 Minuten köcheln lassen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer würzen, dann die Eier direkt in den Topf schlagen und vorsichtig rühren, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garnelen und Muscheln zurück in den Topf geben, den Koriander unterrühren und in tiefen Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
