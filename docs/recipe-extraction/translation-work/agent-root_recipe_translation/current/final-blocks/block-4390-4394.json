      "steps": [
        {
          "position": 0,
          "text": "Kutteln unter kaltem, fließendem Wasser gründlich säubern und in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Getrocknete Bohnen 8 Stunden oder über Nacht in Wasser einweichen, dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebel und Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kutteln und Stücke der Rinderschulter hinzufügen und 10 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Weißwein ablöschen, dann Brühe, Bohnen, Karotten und Lorbeerblätter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 2.5 Stunden köcheln lassen, bis die Kutteln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
