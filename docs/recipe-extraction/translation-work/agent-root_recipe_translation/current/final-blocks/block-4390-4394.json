      "steps": [
        {
          "position": 0,
          "text": "Altbackenes Brot in mundgerechte Würfel schneiden und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen und gehackten Knoblauch hinzufügen; anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wasser oder Brühe in die Pfanne geben und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brotwürfel hinzufügen und 5-7 Minuten ständig rühren, bis das Brot die Flüssigkeit aufgesogen hat und cremig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und Pfeffer würzen, dann die Migas an den Rand der Pfanne schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier in die Mitte der Pfanne schlagen und braten, bis das Eiweiß fest, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Migas mit den Spiegeleiern darauf servieren und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
