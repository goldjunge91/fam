      "steps": [
        {
          "position": 0,
          "text": "Gib die geschnittene Räucherwurst mit gewürfelter Zwiebel, Staudensellerie, Paprika und Knoblauch in den Topf des Reiskochers. Starte einen vollständigen Garzyklus (etwa 8-10 Minuten) und rühre einmal um, damit die Wurst Fett abgibt und das Gemüse weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle den trockenen Reis ab, bis das Wasser klar bleibt. Gib ihn mit den abgetropften Schwarzaugenbohnen, Hühnerbrühe, Cajun-Gewürz, geräuchertem Paprikapulver und Lorbeerblatt in den Topf. Rühre alles um, sodass der Reis in einer gleichmäßigen Schicht unter der Flüssigkeit liegt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schließe den Deckel und starte einen vollständigen Garzyklus für weißen Reis. Der Reiskocher schaltet auf Warmhalten um, sobald die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass das Gericht zugedeckt 10 Minuten auf Warmhalten ruhen, damit der Reis ausdampft und fester wird. Öffne den Deckel nicht vorher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Entferne das Lorbeerblatt und lockere den Reis mit einer Gabel auf. Hebe Wurst und Bohnen vom Boden unter. Probiere das Gericht und gib nach Bedarf Salz oder mehr Cajun-Gewürz dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle das Gericht in Schüsseln, gib geschnittene Frühlingszwiebeln darauf und serviere scharfe Sauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
