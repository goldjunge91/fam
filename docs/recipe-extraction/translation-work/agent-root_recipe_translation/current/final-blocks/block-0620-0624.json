      "steps": [
        {
          "position": 0,
          "text": "Gib den trockenen Reis in den Topf des Reiskochers und gieße Hühnerbrühe sowie so viel Wasser dazu, dass die 2-Tassen-Reis-Markierung erreicht wird (insgesamt etwa 2 Tassen Flüssigkeit). Rühre Knoblauchpulver, Zwiebelpulver und Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die gewürfelten rohen Hähnchenstücke auf den Reis und beträufle sie mit etwa der Hälfte der Buffalo-Sauce. Schließe den Deckel und starte einen vollständigen Garzyklus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öffne nach Ende des Zyklus den Deckel und prüfe, ob das Hähnchen durchgegart und nicht mehr rosa ist. Falls der Reis noch fest oder das Hähnchen noch nicht gar ist, gib einen Schuss Wasser dazu, schließe den Deckel und starte einen zweiten kurzen Garzyklus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schalte auf Warmhalten. Rühre das Hähnchen unter den Reis und zerteile es dabei leicht. Rühre dann die übrige Buffalo-Sauce und den geriebenen Cheddar ein, bis der Käse geschmolzen und die Mischung cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe nach Wunsch gewürfelten Staudensellerie unter und lass das Gericht zugedeckt 5 Minuten auf Warmhalten ruhen, damit es fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle das Gericht in Schüsseln und gib geschnittene Frühlingszwiebeln sowie etwas Ranch-Dressing darüber. Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": []
    },
