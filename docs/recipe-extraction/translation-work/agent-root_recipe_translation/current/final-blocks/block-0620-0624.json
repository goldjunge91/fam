      "steps": [
        {
          "position": 0,
          "text": "Spüle 1 Tasse (trockenen) Jasminreis pro 2 Portionen unter kaltem Wasser ab, bis das Wasser größtenteils klar bleibt. Gieße ihn ab und gib ihn mit 2 Tassen Wasser in den Reiskocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre 1 EL Pflanzenöl, 1 TL Salz, den Saft von 1 Limette und nach Wunsch das Lorbeerblatt ein, damit der Reis vollständig gewürzt gart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schließe den Deckel und starte einen normalen Garzyklus für weißen Reis, bis der Reiskocher auf Warmhalten umschaltet. Lass den Reis dann 10 Minuten auf Warmhalten ruhen, ohne den Deckel zu öffnen, damit der Dampf die Körner fertig gart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Entferne das Lorbeerblatt und lockere den Reis vorsichtig mit einer Gabel oder einem Reislöffel auf, damit sich die Körner trennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe den gehackten Koriander und den Saft der zweiten Limette unter, solange der Reis noch warm ist, damit er das Aroma aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere den Reis und gib nach Bedarf eine weitere Prise Salz oder etwas Limettensaft dazu. Serviere ihn als Grundlage für Burrito-Bowls, Tacos oder gegrilltes Eiweiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
