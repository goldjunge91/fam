      "steps": [
        {
          "position": 0,
          "text": "Gemüsebrühe zum Kochen bringen und rote Linsen hinzufügen. 12 Minuten kochen, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bulgur einrühren und weitere 5 Minuten kochen, bis die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vom Herd nehmen und gehackte Zwiebel, Minze, Petersilie, Salz und Chiliflocken einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "5 Minuten abkühlen lassen, bis die Masse angefasst werden kann, dann Olivenöl und Zitronensaft einträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hände anfeuchten und die Mischung zu kleinen ovalen Bratlingen von etwa 1.5 Zoll Länge formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einer Servierplatte anrichten und bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
