      "steps": [
        {
          "position": 0,
          "text": "Auberginen längs halbieren und das Fruchtfleisch rautenförmig einschneiden, ohne die Schale zu durchtrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und Auberginenhälften portionsweise mit der Schale nach unten 4 Minuten braten. Wenden und weitere 3 Minuten braten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fruchtfleisch herauslöffeln, dabei eine 0.5 Zoll dicke Schale lassen. Fruchtfleisch hacken und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne Rinderhackfleisch mit gewürfelter Zwiebel 5 Minuten bräunen, dann Knoblauch und Tomatenmark hinzufügen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehacktes Auberginenfleisch, Petersilie, Salz und Pfeffer einrühren und weitere 3 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auberginenschalen mit der Fleischmischung füllen, in eine Auflaufform legen und Tomatensauce darum gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Folie abdecken und bei 375 °F 20 Minuten backen, dann aufdecken und weitere 10 Minuten backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
