      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln, bis sie weich sind. Zerdrücke sie mit Butter und warmer Milch zu einem lockeren Püree.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare Zwiebel und Karotte in Öl, bis sie weich sind. Gib Knoblauch, Rinderhackfleisch und Thymian dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark, Worcestershiresauce und Brühe ein. Lass alles 10 Minuten köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die tiefgekühlten Erbsen dazu und fülle alles in eine Auflaufform. Verteile das Kartoffelpüree darauf und rauhe die Oberfläche mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Auflauf bei 400°F 25 Minuten, bis die Kartoffelspitzen goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
