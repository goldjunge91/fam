      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teigboden zu: Verreibe kalte Butter mit Mehl und einer Prise Salz, gib kaltes Wasser dazu und verknete alles zu einem Teig. Kühle ihn 30 Minuten, rolle ihn aus und kleide damit eine 9-Zoll-Tarteform aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe den Teigboden blind bei 375°F 12 Minuten mit Backgewichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Speck und Zwiebel an und verteile beides mit dem Käse im Teigboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Eier mit Milch, Salz, Pfeffer und Muskatnuss und gieße die Mischung über die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Quiche 30–35 Minuten, bis sie gerade gestockt ist und in der Mitte noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
