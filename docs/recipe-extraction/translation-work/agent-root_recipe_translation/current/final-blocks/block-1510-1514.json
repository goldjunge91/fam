      "steps": [
        {
          "position": 0,
          "text": "Würfle das ganze Gemüse grob. Gare Zwiebel und Knoblauch in Öl, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das gesamte Gemüse und die gehackten Tomaten dazu und würze mit Kräutern. Lass alles 25 Minuten köcheln, bis der Eintopf dick und sämig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle den Eintopf in eine ofenfeste Form, falls der Topf nicht ofenfest ist. Drücke 6 Mulden hinein und schlage jeweils ein Ei hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe alles bei 375°F 12–15 Minuten, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garniere mit frischem Basilikum und serviere dazu knuspriges Brot.",
