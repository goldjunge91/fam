    {
      "externalId": "waivy:mfr-eu-tortilla-espanola",
      "slug": "mfr-eu-tortilla-espanola",
      "title": "Spanische Tortilla de Patatas (Kartoffelomelett)",
      "instructions": "Spaniens beliebtestes Gericht: ein dickes, cremiges Omelett aus Eiern und Kartoffeln, langsam in Olivenöl gegart und einmal gewendet. Warm oder bei Zimmertemperatur gegessen, als Bocadillo in ein Baguette gefüllt oder einfach in Stücke geschnitten als Tapas serviert. Schlicht, zeitlos und perfekt.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "6 Eier, 4 Kartoffeln und 2 Zwiebeln kosten weniger als 2 Dollar für 4 Personen.",
        "Das langsame Frittieren der Kartoffeln macht den Unterschied zwischen einer guten und einer großartigen Tortilla. Nimm dir Zeit dafür.",
        "Die Tortilla hält sich stundenlang bei Zimmertemperatur und eignet sich gut zur Essensvorbereitung oder als Proviant."
      ],
      "substitutions": [
        {
          "forIngredientId": "onion",
          "swap": "Lauch für eine mildere, süßere Variante"
        },
        {
          "forIngredientId": "olive-oil",
          "swap": "Verwende weniger, wenn das Budget knapp ist. 2 EL reichen"
        }
      ],
