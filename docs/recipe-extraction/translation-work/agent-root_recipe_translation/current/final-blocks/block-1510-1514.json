      "steps": [
        {
          "position": 0,
          "text": "Schneide die Aubergine in 1/2 Zoll dicke Scheiben, bestreiche sie mit Olivenöl und röste sie bei 425°F 20 Minuten, bis sie goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite die Fleischsauce zu: Gare Rinderhackfleisch mit Zwiebel, Knoblauch, Tomatenmark, gehackten Tomaten, Zimt und Piment.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Béchamelsauce zu: Schmilz Butter, rühre Mehl ein und gib nach und nach warme Milch dazu. Rühre, bis die Sauce dick wird. Würze mit Muskat und rühre Eigelb und Parmesan unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte Aubergine, Fleischsauce, Aubergine und Béchamelsauce in die Form. Backe alles bei 350°F 45 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Moussaka vor dem Anschneiden 15 Minuten ruhen. Leicht abgekühlt hält sie besser zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
