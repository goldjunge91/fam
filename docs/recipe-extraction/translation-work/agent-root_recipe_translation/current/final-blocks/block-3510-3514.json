      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in dicke Würfel schneiden und in Öl frittieren, bis sie außen goldbraun sind; beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erdnüsse, Sesamsamen, Kokosnuss und getrocknete Chilis zusammen trocken rösten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geröstete Zutaten mit Tamarindenpaste zu einer Paste mahlen und bei Bedarf Wasser hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer Pfanne erhitzen, Kreuzkümmelsamen hinzufügen und dann geschnittene Zwiebeln goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomaten und Kurkuma hinzufügen und garen, bis die Tomaten zu einer Paste zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erdnusspaste einrühren und 2 Minuten bei mittlerer Hitze garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittierte Kartoffeln hinzufügen und vorsichtig mit der Gewürzpaste überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nach Bedarf Wasser hinzufügen, bis die Sauce eine dicke Curry-Konsistenz hat, und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
