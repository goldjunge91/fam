          "position": 0,
          "text": "Getrocknete Aprikosen 10 Minuten in heißem Wasser einweichen und dann fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Jaggery in kleine Stücke brechen, damit er schneller schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ghee in einer Pfanne mit schwerem Boden erhitzen und gehackte Aprikosen hinzufügen.",
