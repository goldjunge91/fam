      "steps": [
        {
          "position": 0,
          "text": "Klebreis unter kaltem Wasser abspülen, bis das Wasser klar bleibt, dabei vorsichtig mit der Hand umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis mindestens 2 Stunden oder wenn möglich über Nacht in Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eingeweichten Reis vollständig abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abgetropften Reis mit 2.5 cups frischem Wasser in einem Reiskocher oder Topf vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bei hoher Hitze kochen, bis das Wasser aufkocht, dann Hitze reduzieren und abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "15-20 Minuten köcheln lassen, bis das gesamte Wasser aufgenommen und der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochten Reis in einen Bambuskorb für Klebreis oder eine Holzschüssel mit einem warmen, feuchten Tuch geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abdecken und vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
