      "steps": [
        {
          "position": 0,
          "text": "Gekühlte Bohnen in einem Topf erwärmen und die Hälfte der Salsa Verde untermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brathähnchen in einer Pfanne erwärmen und in mundgerechte Stücke zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Pfanne auf mittlere bis hohe Stufe erhitzen und die Tortillas erhitzen, bis sie geschmeidig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die untere Hälfte jeder Tortilla mit der Bohnenmischung bestreichen und dann mit Hühnchen, Käse und Jalapeños belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie die Tortilla in eine Kegelform und befestigen Sie sie bei Bedarf mit einem Zahnstocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sauerrahm mit restlicher Salsa Verde zu einer Nieselsauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren die Waffel mit Sahnesauce, Koriander und frischem Limettensaft belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
