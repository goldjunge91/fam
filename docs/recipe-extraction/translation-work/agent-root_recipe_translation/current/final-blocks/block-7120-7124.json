      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 400 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Backpulver und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kalte Butter in kleine Würfel schneiden und in die Mehlmischung einarbeiten, bis sie wie grobe Krümel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den geriebenen Cheddar und die gewürfelten Jalapeños unterheben, dann Buttermilch hinzufügen und vorsichtig verrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf eine bemehlte Fläche geben, zu einem 1 Zoll dicken Rechteck formen und in 4 Brötchen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kekse auf das vorbereitete Backblech legen und die Oberfläche mit Honig bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "12–15 Minuten goldbraun backen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
