      "steps": [
        {
          "position": 0,
          "text": "Mochiko-Mehl und Zucker in einer mikrowellengeeigneten Schüssel vermengen, Wasser hinzufügen und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Minuten auf hoher Stufe in der Mikrowelle erhitzen, gut umrühren, dann weitere 2 Minuten erhitzen, bis die Mischung dick und glänzend ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aus der Mikrowelle nehmen, Kokosaroma einrühren und 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Arbeitsfläche großzügig mit Maisstärke bestäuben, damit nichts klebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mochi-Mischung auf die mit Maisstärke bestäubte Fläche geben und die Oberseite ebenfalls mit zusätzlicher Maisstärke bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald die Masse kühl genug zum Anfassen ist, etwa 1 Minute sanft kneten, bis sie glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf etwa 1/4-inch Dicke ausrollen und in 1.5-inch Quadrate schneiden oder mit einem Ausstecher ausstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Jedes Stück rundum in Kokosraspeln wenden und zum Abkühlen auf Backpapier legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
