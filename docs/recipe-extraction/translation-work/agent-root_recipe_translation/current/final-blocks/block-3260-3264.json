      "steps": [
        {
          "position": 0,
          "text": "Milchpulver, Mehl und Backpulver in einer Schüssel vermengen, dann geschmolzene Butter und ausreichend Milch hinzufügen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig in kleine walnussgroße Kugeln teilen und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zucker und Wasser in einem Topf zum Kochen bringen, zerdrückte Kardamomkapseln hinzufügen, vom Herd nehmen und Rosenwasser einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einem tiefen Topf auf 350°F erhitzen und Gulab Jamun vorsichtig portionsweise hineingeben, ohne den Topf zu überfüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Unter gelegentlichem Wenden etwa 5-7 Minuten portionsweise frittieren, bis sie rundum dunkel goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einer Schaumkelle herausnehmen und sofort in den warmen Zuckersirup legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren mindestens 30 Minuten im Sirup ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
