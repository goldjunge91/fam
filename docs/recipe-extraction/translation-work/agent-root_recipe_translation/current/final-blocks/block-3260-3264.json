      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350°F vorheizen und eine Backform von 9x13 einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Backpulver und Salz in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "5 Eier mit Zucker hell und dick aufschlagen, dann Mehlmischung und Milch vorsichtig unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in die vorbereitete Form gießen und 25-30 Minuten backen, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während der Kuchen backt, Kondensmilch, ungesüßte Kondensmilch und normale Milch vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abgekühlten Kuchen überall mit einer Gabel einstechen, dann langsam die Milchmischung über die gesamte Oberfläche gießen, bis sie aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sahne mit Vanille und restlichem Zucker zu steifen Spitzen schlagen und auf dem abgekühlten Kuchen verstreichen oder aufspritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit frischen Erdbeeren belegen und vor dem Servieren mindestens 2 Stunden kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
