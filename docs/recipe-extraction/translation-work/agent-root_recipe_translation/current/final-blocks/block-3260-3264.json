      "steps": [
        {
          "position": 0,
          "text": "Hefe mit warmer Milch vermengen und 5 Minuten stehen lassen, bis sich Schaum bildet; dann zur Mehlmischung mit Zucker, Salz und Eiern geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig 10 Minuten glatt kneten und dann nach und nach weiche Butter einkneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiterkneten, bis der Teig elastisch und luftig ist, dann Rosinen und kandierte Schale unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in eine gefettete Schüssel legen, mit Frischhaltefolie abdecken und an einem warmen Ort 2 Stunden gehen lassen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig zu einem runden Laib formen und in eine Panettoneform oder eine hohe, mit Backpapier ausgelegte Kuchenform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 90 Minuten gehen lassen, bis der Teig über den Formrand steigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backofen auf 375°F vorheizen und Panettone 40-50 Minuten backen, bis ein in die Mitte gesteckter Spieß sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "15 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen und vollständig auskühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
