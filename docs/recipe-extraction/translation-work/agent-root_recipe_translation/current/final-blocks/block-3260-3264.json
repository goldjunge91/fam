      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 400°F vorheizen und Backbleche mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasser und Butter zum Kochen bringen, vom Herd nehmen und Mehl einrühren, bis sich eine Teigkugel bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Leicht abkühlen lassen, dann Eier einzeln einrühren, bis der Teig glatt und glänzend ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einen Spritzbeutel mit großer runder Tülle füllen und 4-inch lange Streifen auf die vorbereiteten Backbleche spritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "25-30 Minuten backen, bis sie aufgegangen und goldbraun sind, dann auf Kuchengittern abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für die Konditorcreme Milch erhitzen und Eigelb mit Zucker und Maisstärke verquirlen, bevor die heiße Milch langsam eingerührt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Creme zurück auf die Hitze stellen und unter ständigem Rühren dick kochen, dann vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abgekühlte Éclairs waagerecht aufschneiden, mit Konditorcreme füllen und mit geschmolzener Schokolade vermischt mit Sahne überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
