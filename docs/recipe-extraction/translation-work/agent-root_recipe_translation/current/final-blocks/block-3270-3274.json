      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, 1/4 cup Zucker, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage in einer anderen Schüssel Ei auf und vermische es mit Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe die flüssigen Zutaten unter die trockenen, bis alles gerade vermengt ist. Nicht zu stark rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Teig in einen Spritzbeutel oder eine Donut-Dosierflasche und spritze ihn in eine Fritteuse oder einen Schmortopf mit auf 350°F erhitztem Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere Donuts 1-1.5 Minuten pro Seite goldbraun und nimm sie dann mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Zimt mit 1 cup Kristallzucker in einer flachen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wälze warme Donuts in der Zimtzuckermischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vor dem Servieren auf einem Gitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
