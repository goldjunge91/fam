      ],
      "steps": [
        {
          "position": 0,
          "text": "Spüle Klebreis gründlich unter kaltem Wasser ab, bis das Wasser klar bleibt, und gieße ihn dann gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Reis und 1.5 cups Wasser in einen Reiskocher oder Topf und gare ihn nach Packungsanweisung, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze währenddessen Kokosmilch mit Zucker und Salz in einem Topf bei mittlerer Hitze, bis sich der Zucker aufgelöst hat. Nicht kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle gekochten Reis in eine Schüssel und gieße 3/4 der Kokosmilchmischung darüber. Rühre vorsichtig, bis die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schäle Mangos, entferne die Kerne und schneide das Fruchtfleisch in dünne Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile Klebreis auf Serviertellern und richte Mangoscheiben daneben an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle Reis und Mango mit der übrigen Kokossauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue das Gericht mit Sesam und serviere es sofort, solange der Reis noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
