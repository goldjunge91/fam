      "steps": [
        {
          "position": 0,
          "text": "Streue Gelatine über 3 tablespoons kaltes Wasser und lasse sie 5 Minuten quellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sahne, Milch und Zucker in einem Topf bei mittlerer Hitze und rühre, bis sich der Zucker aufgelöst hat. Nimm den Topf dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gequollene Gelatine und Vanilleextrakt ein, bis die Gelatine vollständig aufgelöst ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Mischung durch ein feinmaschiges Sieb in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße sie in Dessertgläser oder Förmchen und fülle diese etwa zu 3/4.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle sie mindestens 4 Stunden kalt oder bis sie fest geworden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Portion kurz vor dem Servieren mit frischen Beeren und beträufle sie mit Honig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
