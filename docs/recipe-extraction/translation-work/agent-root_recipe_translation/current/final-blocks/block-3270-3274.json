      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, geriebene Kokosnuss, Jaggery und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser dazu und vermische alles, bis der Teig die Konsistenz von feuchtem, krümeligem Sand hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fette einen Puttu Kudam (zylindrischen Dämpfer) ein oder verwende eine hohe Dose. Fülle sie abwechselnd mit Teigschichten und geschnittener Banane.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dämpfe den gefüllten Kudam 8-10 Minuten über kochendem Wasser, bis alles gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke den Puttu mit einem Stab oder Stößel auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere ihn heiß mit Banane oder Kichererbsencurry.",
