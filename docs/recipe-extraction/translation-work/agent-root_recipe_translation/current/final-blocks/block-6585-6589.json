      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem Tajine oder schweren Topf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Zwiebeln, Paprika und Knoblauch 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwer, Kreuzkümmel, Paprikapulver und Kurkuma dazu und rühre 1 Minute, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackte Tomaten und Oliven hinzu und lasse alles sanft köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze den Fisch mit Salz und Pfeffer und lege die Filets in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Zitronenscheiben auf den Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf ab und lasse alles 15-20 Minuten köcheln, bis sich der Fisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht direkt aus dem Tajine mit warmem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
