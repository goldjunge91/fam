      "steps": [
        {
          "position": 0,
          "text": "Brate Fleisch, Zwiebeln und Knoblauch in einer Pfanne bei mittelhoher Hitze 8 Minuten an. Zerkleinere das Fleisch dabei in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm die Pfanne vom Herd und lasse die Mischung leicht abkühlen. Rühre dann 1 verquirltes Ei, Minze, Salz und Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 375°F vor und bestreiche eine 9x13 Auflaufform mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege 3 Filoteigblätter in die Form und bestreiche jedes mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Fleischmischung gleichmäßig auf dem Filoteig und streue Feta darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte 4 weitere Filoteigblätter auf die Füllung und bestreiche jedes mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verquirle die übrigen 2 Eier und bestreiche das oberste Filoteigblatt damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
