      "steps": [
        {
          "position": 0,
          "text": "Aubergine würfeln, salzen und 20 Minuten ziehen lassen, dann trocken tupfen. In Olivenöl 8–10 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf Knoblauch und Chiliflocken 30 Sekunden anbraten. Gehackte Tomaten zugeben und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pasta kochen und etwas Nudelwasser auffangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abgetropfte Pasta mit der Sauce vermengen. Aubergine und bei Bedarf Nudelwasser dazugeben, um die Sauce zu verdünnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit gezupftem Basilikum und geriebenem Parmesan servieren.",
          "timerMinutes": null,
