      "steps": [
        {
          "position": 0,
          "text": "Backe die tiefgekühlten Kartoffelbällchen nach Packungsanleitung goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Speckstreifen bei mittlerer bis hoher Hitze knusprig und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in der Pfanne und brate beide Eier nach Wunsch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die Weizentortillas in einer trockenen Pfanne etwa 30 Sekunden pro Seite, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jede Tortilla mit einer Scheibe Käse, einer Portion Kartoffelbällchen, einem gebratenen Ei, Speckstücken und dem restlichen Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage gegenüberliegende Tortilla-Ecken zur Mitte und falte sie zu einem Paket. Wickle es fest in Folie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Röste die eingewickelten Tortillas in einer Pfanne bei mittlerer Hitze 2 Minuten pro Seite, bis die Außenseite knusprig ist. Serviere sie anschließend.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
