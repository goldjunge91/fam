      "steps": [
        {
          "position": 0,
          "text": "Vermische Achiotepaste mit Limettensaft und 1 tbsp Olivenöl zu einer Marinade und reibe sie auf das Schweinefilet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse das Schweinefleisch 10 Minuten marinieren, während du die Tortillas in einer trockenen Pfanne erwärmst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 tbsp Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze. Brate das marinierte Schweinefleisch pro Seite 4 Minuten gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch aus der Pfanne und lasse es 2 Minuten ruhen. Schneide es dann quer zur Faser in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dünste in derselben Pfanne gewürfelte Zwiebel 2 Minuten weich. Gib Ananas hinzu und brate sie 1 Minute mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe die Mischung an den Pfannenrand und rühre die Eier in der Pfanne gar. Vermische sie anschließend mit dem Schweinefleisch und der Ananas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Füllung auf die warmen Tortillas und serviere sie mit Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
