      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Schmortopf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die gewürfelten Kartoffeln in einer zweiten Pfanne bei mittlerer Hitze 8 Minuten weich und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Frühstückswurst in derselben Pfanne krümelig an und gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die Eier in der Pfanne, bis sie gar sind, und vermische sie mit der gebratenen Wurst und den Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne jeweils 30 Sekunden pro Seite, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Füllung aus Ei, Wurst, Kartoffeln, Käse und Zwiebel in die Mitte jeder Tortilla. Schlage die Seiten ein und rolle sie fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Chimichangas vorsichtig mit der Nahtseite nach unten in das heiße Öl und frittiere sie 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie vor dem Servieren auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
