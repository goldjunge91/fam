      "steps": [
        {
          "position": 0,
          "text": "Brate die Wurstbratlinge in einer Pfanne bei mittlerer Hitze pro Seite 4-5 Minuten gar und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in derselben Pfanne und brate beide Eier als Spiegeleier oder nach Wunsch. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbiere die Bolillo-Brötchen und höhle etwas weiche Krume aus, damit Platz für die Füllung ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die untere Brötchenhälfte jeweils mit Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jedes Brötchen mit einem Wurstbratling, Spiegelei, Käsescheibe, Avocadoscheiben und Tomatenscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue die Füllung mit frischem Koriander und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Setze die obere Brötchenhälfte auf und serviere die Torta sofort oder wickle sie zum Warmhalten in Folie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
