          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tamarindenpaste, Chilipulver und Salz einrühren und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bei mittlerer Hitze 5 Minuten unter ständigem Rühren kochen, bis die Masse eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung auf Backpapier verteilen und abkühlen lassen, bis sie sich verarbeiten lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie die Mischung zu kleinen Kugeln in der Größe von Walnüssen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rollen Sie jede Kugel gleichmäßig in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einem luftdichten Behälter aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
