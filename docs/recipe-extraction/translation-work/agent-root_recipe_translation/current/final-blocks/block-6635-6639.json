      "steps": [
        {
          "position": 0,
          "text": "Maniok schälen und mit einer Küchenreibe oder einer Küchenmaschine fein reiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wenn Sie frische Kokosnuss verwenden, reiben Sie das Fleisch; Andernfalls verwenden Sie vorgeraspelte Kokosnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter und braunen Zucker cremig rühren, bis sie leicht und locker sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier einzeln unterrühren und dann Vanilleextrakt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geriebenen Maniok, Kokosraspeln, Zimt, Muskatnuss, Salz und Rosinen untermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle den Teig in eine gefettete 9x13 inch große Backform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Kuchen bei 350°F 50-60 Minuten, bis er goldbraun ist und ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Etwas abkühlen lassen, in Quadrate schneiden und servieren.",
          "timerMinutes": null,
