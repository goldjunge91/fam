      "steps": [
        {
          "position": 0,
          "text": "Ente in Stücke schneiden, überschüssige Haut und Fett entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen, schweren Topf erhitzen und die Entenstücke goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ente herausnehmen und beiseite stellen, dabei 2 Esslöffel Fett im Topf belassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebeln und Knoblauch würfeln und im Topf anbraten, bis sie weich und gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Currypulver und Kurkuma einrühren und 2 Minuten kochen lassen, damit die Gewürze aufgehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Ente wieder in den Topf geben, Wasser hinzufügen und zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 60 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gewürfelte Kartoffeln, geschnittenes Chili, Koriander und Kokosmilch hinzufügen und weitere 30 Minuten köcheln lassen, bis die Ente zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer abschmecken und mit Roti oder Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
