      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz vermischen und dann Wasser hinzufügen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 2 Minuten lang kneten und 15 Minuten abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fisch mit Limettensaft einreiben und 10 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 3 Kugeln teilen und zu dünnen Ovalen flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne erhitzen und Teigovale goldbraun und aufgebläht braten, dann abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Im gleichen Öl die marinierten Fischstücke anbraten, bis sie gar und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Machen Sie eine schnelle Soße, indem Sie Tomatensoße mit gewürfelten Zwiebeln, Knoblauch und Koriander vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren Sie den Fisch auf oder in einem frittierten Auflauf und beträufeln Sie ihn mit Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
