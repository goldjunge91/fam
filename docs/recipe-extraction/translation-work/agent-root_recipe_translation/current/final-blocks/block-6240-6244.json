      "steps": [
        {
          "position": 0,
          "text": "Säubere die Hühnerherzen, entferne Fett und Blutgefäße und halbiere sie längs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Herzen 15 Minuten in Salzwasser vor und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere rote Chilis, Knoblauch und Schalotten mit 2 Esslöffel Wasser zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne und brate die Chilipaste 2 Minuten an, bis sie duftet. Gib dann Kurkuma dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge die vorgekochten Hühnerherzen hinzu und brate sie 5 Minuten unter Rühren, damit sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kokosmilch und Limettensaft dazu, würze mit Salz und Palmzucker und lass alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß, sobald die Herzen zart und die Sauce dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
