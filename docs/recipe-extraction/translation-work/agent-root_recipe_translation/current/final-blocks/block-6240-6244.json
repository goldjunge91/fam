      "steps": [
        {
          "position": 0,
          "text": "Verrühre Klebreismehl und 0.5 cup Wasser in einem Topf zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter im Topf bei mittlerer Hitze und gib die Reismehlpaste unter ständigem Rühren dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße langsam Kokosmilch ein und rühre dabei, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Palmzucker, Kurkuma und Salz dazu und rühre regelmäßig weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Mischung 15-20 Minuten unter gelegentlichem Rühren, bis sie dick wird und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle sie in eine Servierschüssel oder einzelne Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue sie mit Kokosraspeln und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
