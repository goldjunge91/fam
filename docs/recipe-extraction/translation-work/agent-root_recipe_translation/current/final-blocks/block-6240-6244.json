      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln, schneide sie in 1-inch-Würfel und frittiere sie in Öl goldbraun. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere rote Chilis, Knoblauch und Schalotten mit 2 Esslöffel Wasser zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 Esslöffel frisches Öl in einem Wok und brate die Chilipaste 1 Minute an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die frittierten Kartoffeln zur Chilipaste und schwenke sie 2 Minuten darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch und Limettensaft dazu, würze mit Salz und Palmzucker und lass alles 8 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre gelegentlich um, bis die Sauce eindickt und an den Kartoffeln haftet. Serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
