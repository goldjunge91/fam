      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Rinderhesse und Schweineknochen 3 Minuten in kochendem Wasser. Gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Schalotten, Knoblauch, rote Chilis und Zitronengras zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und brate die Gewürzpaste 2 Minuten an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib blanchiertes Fleisch und Knochen dazu, gieße 8 Tassen frisches Wasser hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse die Brühe 60 Minuten köcheln, bis das Fleisch zart und die Brühe aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seihe die Brühe ab und gib sie zurück in den Topf. Würze sie mit Fischsauce und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Reisnudeln nach Packungsanweisung und verteile sie auf Servierschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zupfe das zarte Rind- und Schweinefleisch auseinander. Schöpfe heiße Brühe über die Nudeln und belege sie mit dem Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Garniere die Suppe mit frischen Kräutern, roten Chilischeiben und knusprigen Röstschalotten und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
