      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Schalotten und Knoblauch zusammen mit Kurkuma und Salz zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Fisch in Stücke und überziehe ihn gründlich mit der Gewürzpaste. Lasse ihn 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Topf bei mittelhoher Hitze und gib die panierten Fischstücke vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wasser um den Fisch herum in den Topf, bringe es zum Kochen und lasse alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche währenddessen die Reisnudeln nach Packungsanweisung, gieße sie ab und verteile sie auf Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze die Brühe mit Fischsauce und schmecke ab. Passe die Würzung bei Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schöpfe Fisch und aromatische Brühe über die Reisnudeln in den Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue die Suppe mit gehackten Frühlingszwiebeln und frischem Dill. Serviere sie mit Limettenspalten und Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
