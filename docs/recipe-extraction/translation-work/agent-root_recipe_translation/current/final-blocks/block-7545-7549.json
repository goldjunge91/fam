      "steps": [
        {
          "position": 0,
          "text": "Ein Gitter in die Ofenmitte setzen und auf 375°F (190°C) vorheizen. Zwei Bleche mit Backpapier belegen. Cranberrys grob hacken und Orange vor dem Auspressen abreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Backpulver, Natron und Salz verquirlen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche Butter, Kristallzucker und braunen Zucker etwa 3 Minuten hell und luftig schlagen. Ei einrühren, dann Vanille, Orangenschale und 3 tablespoons frischen Orangensaft. Glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trockene Zutaten in zwei Portionen bei niedriger Stufe einrühren. Cranberrys von Hand unterheben. Nicht zu lange rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Runde Portionen von etwa 1.5 tablespoons abstechen und mit 2 inches Abstand auf die Bleche setzen. Oberseiten mit feuchten Fingern abrunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Je Blech 11 to 13 Minuten backen, bis die Ränder fest und leicht goldgelb, die Mitten aber noch weich sind. 5 Minuten auf dem Blech ruhen lassen, dann auf einem Gitter auskühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Puderzucker mit 2 to 3 tablespoons des zurückbehaltenen Orangensafts und einer Prise Schale glatt und dickflüssig verrühren. Saft tropfenweise ergänzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Ausgekühlte Kekse mit Glasur beträufeln oder dünne Linien darauf ziehen. Etwa 20 Minuten fest werden lassen, bevor sie gestapelt oder luftdicht aufbewahrt werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
