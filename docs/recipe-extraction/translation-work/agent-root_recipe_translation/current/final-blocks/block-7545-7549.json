      "steps": [
        {
          "position": 0,
          "text": "Gitter im oberen und unteren Drittel einsetzen und auf 350F (175C) vorheizen. Zwei Bleche mit Backpapier auslegen. Falls nötig Pekannüsse 6-8 Minuten auf einem trockenen Blech rösten, abkühlen lassen und grob hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Natron, Backpulver, Zimt und Salz verquirlen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche Butter mit beiden Zuckersorten 3-4 Minuten hell und luftig schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier einzeln und dann Vanille einrühren. Nach jeder Zugabe die Schüsselwand abstreifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trockene Zutaten bei niedriger Stufe einrühren, bis kein Mehl mehr sichtbar ist. Nicht überrühren. Haferflocken, Schokolade, geröstete Pekannüsse und Kokos von Hand unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Großzügige Portionen von 2 Esslöffel (etwa 2 oz) abstechen und mit 2 inches Abstand aufs Blech setzen. Für gleichmäßige Kekse zu Kugeln rollen, für rustikale Ränder grob portionieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "12-14 Minuten backen; die Bleche nach der Hälfte der Zeit oben/unten und vorne/hinten tauschen. Herausnehmen, wenn die Ränder goldgelb und fest sind, die Mitten aber noch leicht weich aussehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten auf dem Blech ruhen lassen, dann auf einem Gitter vollständig auskühlen. Luftdicht halten sie bis zu 5 Tage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
