    {
      "externalId": "waivy:bake2-kolaczki",
      "slug": "bake2-kolaczki",
      "title": "Kolaczki (polnische Frischkäsekekse)",
      "instructions": "Zarte, mürbe polnische Weihnachtskekse aus einem reichhaltigen Frischkäse-Butterteig. In Quadrate geschnitten, mit dicker Fruchtkonfitüre gefüllt, über den Ecken zusammengefaltet und blassgolden gebacken, dann mit Puderzucker bestäubt. Der Teig enthält keinen Zucker; der Gegensatz zwischen leicht säuerlichem Gebäck und süßer Konfitüre ist typisch.",
      "prepTimeMinutes": 30,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Frischkäse und Butter der Hausmarke funktionieren genauso gut. Puderzucker verdeckt jeden Unterschied und spart Geld.",
        "Ein Glas dicke Konfitüre im Angebot kaufen. Aprikose, Himbeere oder Pflaume sind traditionelle Füllungen; nimm die günstigste.",
        "Puderzucker selbst herstellen: 1/4 cup Zucker mit einer Prise Speisestärke in einer sauberen Kaffeemühle mixen."
      ],
      "substitutions": [
        {
          "forIngredientId": "apricot-jam",
          "swap": "Himbeer- oder Preiselbeerkonfitüre oder eine dicke Pflaumen- beziehungsweise Mohnfüllung – alles klassische Kolaczki-Füllungen.",
          "savings": "Verwende vorhandene Konfitüre, statt ein neues Glas zu kaufen."
        },
        {
          "forIngredientId": "cream-cheese",
          "swap": "Die gleiche Menge säuerlichen Bauernkäse oder gut abgetropften Vollfett-Ricotta verwenden.",
          "savings": "Neutral."
