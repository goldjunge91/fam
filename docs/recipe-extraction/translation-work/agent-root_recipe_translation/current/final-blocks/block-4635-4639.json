      "steps": [
        {
          "position": 0,
          "text": "Wasche die Auberginen und schneide sie der Länge nach ein, ohne sie ganz durchzuschneiden. Der Stiel soll dabei intakt bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebeln fein und hacke die grünen Chilischoten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl in einer großen Pfanne und gib die Kreuzkümmelsamen hinein, bis sie knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Zwiebeln dazu und brate sie goldbraun. Füge dann die Ingwer-Knoblauch-Paste und die grünen Chilischoten hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Korianderpulver, Kurkumapulver und Salz unter und gare alles 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teile die Füllung gleichmäßig auf und fülle jede Aubergine großzügig durch den Einschnitt mit der gegarten Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ordne die gefüllten Auberginen in derselben Pfanne an und decke sie mit einem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gare sie bei mittlerer Hitze 25-30 Minuten und rühre gelegentlich um, bis die Auberginen weich und zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Garniere sie mit frischem Koriander und serviere sie heiß mit Reis oder Roti.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
