      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische griechischen Joghurt, Sahne, Ingwer-Knoblauch-Paste, Garam Masala, Kreuzkümmel, Chilipulver, Zitronensaft und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Hähnchenstücke dazu und wende sie gleichmäßig in der Marinade. Stelle sie 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate das marinierte Hähnchen portionsweise 6-8 Minuten, bis es goldbraun und durchgegart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das gesamte Hähnchen zurück in die Pfanne und lasse es 3-4 Minuten köcheln, bis die Sauce leicht andickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und passe die Würzung bei Bedarf mit Salz und Gewürzen an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß mit Basmatireis oder Naan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
