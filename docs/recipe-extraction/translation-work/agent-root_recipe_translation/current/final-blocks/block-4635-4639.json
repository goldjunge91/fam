      "steps": [
        {
          "position": 0,
          "text": "Wasche die Zucchini und höhle sie mit einem Kugelausstecher oder einem kleinen Messer aus. Lasse dabei eine dünne Wand stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke das herausgelöste Zucchinifruchtfleisch fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel und gehacktem Knoblauch in einer Pfanne an. Rühre dann Reis und gehackte Zucchini unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze die Füllung mit Salz und Pfeffer und fülle die Mischung dann mit einem Löffel in die ausgehöhlten Zucchini.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ordne die gefüllten Zucchini mit der Nahtseite nach unten in einem großen Topf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Tomatensauce und Rinderbrühe und gieße die Mischung über die Zucchini.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und decke den Topf mit einem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse alles 35-40 Minuten köcheln, bis die Zucchini weich und der Reis vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie heiß in Schüsseln mit etwas Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
