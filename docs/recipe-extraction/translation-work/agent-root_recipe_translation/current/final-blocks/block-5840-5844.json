      "steps": [
        {
          "position": 0,
          "text": "Soak bamboo skewers in Wasser für 30 Minuten to prevent burning.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Press tofu, cut into 1-inch cubes, und thread onto soaked skewers.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Whisk together peanut butter, coconut milk, lime juice, Knoblauch, ginger, soy Sauce, brown Zucker, und red Pfeffer flakes bis smooth.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brush tofu skewers mit half the peanut Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Grille or Grille Pfanne over mittlerer-hoher Erhitze und Koche skewers für 4-5 Minuten per Seite bis lightly charred.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warm remaining peanut Sauce in a small saucepan over niedriger Erhitze für 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib skewers to a serving platter und drizzle mit warm peanut Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere mit extra Sauce on the Seite für dipping.",
