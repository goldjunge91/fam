      "steps": [
        {
          "position": 0,
          "text": "Wasche die Chilischoten und tupfe sie mit Küchenpapier vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer kleinen Pfanne auf 350°F (teste mit einem Holzlöffel; es sollten sofort Bläschen entstehen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib vorsichtig jeweils 2-3 Chilischoten ins heiße Öl und frittiere sie 30-45 Sekunden, bis die Haut leicht Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm sie mit einer Schaumkelle heraus und lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische gehackten Knoblauch, Schalotten, Limettensaft, Salz und Zucker in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die warmen frittierten Chilischoten mit dem Sambal-Dip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
