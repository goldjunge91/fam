      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Chilischoten 5 Minuten in heißem Wasser ein, bis sie weich sind. Entferne dann Stiele und Kerne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerstoße eingeweichte Chilischoten, Knoblauch, Schalotten und Garnelenpaste zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und brate die Paste 2-3 Minuten an, bis sie duftet und dunkler wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomaten aus der Dose samt Saft dazu und lass alles unter gelegentlichem Rühren 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Garnelen, Fischsauce, Limettensaft und Zucker dazu und gare alles 5 Minuten, bis die Garnelen rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Paste warm mit frischem Gemüse wie langen Bohnen, Kohl oder Gurkenscheiben zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
