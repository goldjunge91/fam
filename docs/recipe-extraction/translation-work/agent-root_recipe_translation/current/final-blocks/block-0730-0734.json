      "steps": [
        {
          "position": 0,
          "text": "Würfle Tomate und Zwiebel fein. Gare sie in Pflanzenöl bei mittlerer Hitze, bis sie weich sind und duften. Das ist die Grundlage des Sofrito.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch und Kreuzkümmel dazu und gare alles 1 Minute. Füge abgetropfte Kidneybohnen und 1 cup Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass die Mischung 20 Minuten köcheln und zerdrücke einige Bohnen am Topfrand, damit die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Eier 7 Minuten weich, kühle sie ab und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Reis. Serviere die Bohnen auf dem Reis mit einem halbierten Ei, Koriander und Salz nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
