      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch in 2-Zoll-Würfel und wende es in gewürztem Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einem großen Schmortopf und bräune das Fleisch rundherum an, etwa 10 Minuten. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste die geschnittenen Zwiebeln etwa 15 Minuten, bis sie karamellisiert sind, und gib dann den gehackten Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und braunen Zucker ein und brate alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche mit Bier ab, kratze die Röststoffe vom Topfboden und gib dann Brühe, Lorbeerblätter, Thymian und Fleisch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und schmorte alles bei 325°F 2 Stunden lang im Ofen, bis das Rindfleisch mürbe ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf aus dem Ofen, entferne die Lorbeerblätter und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit knusprigem Brot oder gekochten Kartoffeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
