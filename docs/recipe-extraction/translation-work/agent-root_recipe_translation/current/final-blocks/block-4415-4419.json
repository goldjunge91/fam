      "steps": [
        {
          "position": 0,
          "text": "Erwärme die Milch mit 2 EL Butter auf 110°F und gib dann Hefe und Zucker dazu. Lasse die Mischung 5 Minuten stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Ei, Salz und Mehl, bis ein weicher Teig entsteht. Knete ihn 8 Minuten von Hand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig in einer geölten Schüssel 1 Stunde gehen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig zu einem 12x8 Zoll großen Rechteck aus und bestreiche ihn mit weicher Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Zimt und braunen Zucker und streue die Mischung gleichmäßig über den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig von der langen Seite her fest auf und schneide ihn in 8 gleich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Stücke auf ein gebuttertes Backblech, decke sie ab und lasse sie 45 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche sie mit Ei und streue Hagelzucker darüber. Backe sie bei 375°F 20 Minuten lang, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
