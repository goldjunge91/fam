      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in 1.5-Zoll-Stücke und alle Gemüse in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe die Brühe in einem großen Topf zum Kochen und gib die Hähnchenstücke dazu. Reduziere dann die Hitze und lasse alles köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Karotten, Sellerie, Lauch, Pastinaken und Zwiebel dazu. Lasse alles 40 Minuten köcheln, bis Hähnchen und Gemüse weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Eigelb und Sahne in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ziehe den Topf kurz vom Herd und temperiere die Eiermischung langsam, indem du unter ständigem Rühren eine Kelle heiße Brühe einarbeitest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Eiermischung unter ständigem Rühren zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre die Butter ein und würze großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze alles weitere 2 Minuten bei niedriger Hitze und rühre vorsichtig um. Serviere das Gericht anschließend in flachen Schalen mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
