      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in dünne Pommes frites und weiche sie 30 Minuten in kaltem Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reinige die Muscheln unter kaltem fließendem Wasser, entferne die Bärte und entsorge alle offenen Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die Butter in einem großen Topf und brate den gehackten Knoblauch und die Schalotte 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den Wein dazu, gib das Lorbeerblatt hinein, bringe alles zum Kochen und gib die Muscheln dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und gare die Muscheln 5-7 Minuten. Schüttle den Topf gelegentlich, bis sich die Schalen öffnen. Entsorge geschlossene Muscheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze währenddessen das Öl auf 350°F und frittiere die abgetropften Kartoffeln portionsweise 3-4 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Pommes auf Küchenpapier abtropfen und würze sie mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile Muscheln und Brühe auf zwei Schalen, garniere sie mit Petersilie und serviere sie mit Pommes und Mayonnaise oder Aioli.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
