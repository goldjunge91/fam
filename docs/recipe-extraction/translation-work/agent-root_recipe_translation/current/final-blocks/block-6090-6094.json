      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Ghee in einer großen Pfanne mit schwerem Boden bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Reismehl dazu und röste es unter ständigem Rühren 5-7 Minuten an, bis es duftet und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße langsam unter ständigem Rühren Kokosmilch dazu, damit keine Klümpchen entstehen und nichts ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geraspelten Palmzucker, Kardamom und Salz dazu. Rühre weiter, während die Masse etwa 15-20 Minuten eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald die Masse sehr dick ist und sich vom Pfannenrand löst, hebe Cashewkerne und Rosinen unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare alles unter Rühren weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Masse auf ein gefettetes Backblech und verstreiche sie gleichmäßig etwa 0.75 Zoll dick.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass alles vollständig abkühlen und schneide die Masse dann in Quadrate oder Rechtecke. Bewahre sie in einem luftdicht verschlossenen Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
