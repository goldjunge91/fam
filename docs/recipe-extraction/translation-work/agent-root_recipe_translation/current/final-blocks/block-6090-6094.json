      "steps": [
        {
          "position": 0,
          "text": "Weiche den Basmatireis 20 Minuten in Wasser ein und gieße ihn anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Fleisch in 1 Zoll große Stücke und die Zwiebeln in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Ghee in einem Topf mit schwerem Boden und brate die Hälfte der Zwiebeln goldbraun an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste die restlichen Zwiebeln im selben Ghee weich. Gib Ingwer-Knoblauch-Paste dazu und gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Fleisch dazu und gare es bei hoher Hitze unter ständigem Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Joghurt und Gewürze ein. Lass das Fleisch 15 Minuten köcheln, bis es teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib den abgetropften Reis dazu und vermenge alles vorsichtig. Gieße 4 Tassen kochendes Wasser hinein, decke den Topf fest ab und gare alles bei hoher Hitze 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reduziere die Hitze auf niedrige Stufe und gare alles zugedeckt 20 Minuten, bis der Reis weich und das Wasser aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib die gebratenen Zwiebeln darauf, decke den Topf 2 Minuten ab, lockere den Reis dann mit einer Gabel auf und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
