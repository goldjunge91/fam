      "steps": [
        {
          "position": 0,
          "text": "Hacke eine Zwiebel sehr fein und verknete sie mit Lammhackfleisch, Ingwer, Knoblauch, Kardamom, Zimt, Salz und Pfeffer, bis die Masse klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme daraus 8-10 glatte, längliche Bällchen von etwa 3 Zoll Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die zweite Zwiebel in Scheiben und brate sie in Ghee bei mittlerer Hitze goldbraun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Fleischbällchen vorsichtig in dasselbe Ghee und bräune sie 5-7 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Joghurt mit Chilipulver und gieße die Mischung über die Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Wasser und die gebratenen Zwiebeln dazu. Bringe alles zum Köcheln, decke den Topf ab und gare die Bällchen bei niedriger Hitze 35-40 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sauce sollte eindicken und die Fleischbällchen sollten zart sein. Schmecke ab und würze bei Bedarf mit Salz nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß in einer flachen Schüssel mit der reichhaltigen, cremigen Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
