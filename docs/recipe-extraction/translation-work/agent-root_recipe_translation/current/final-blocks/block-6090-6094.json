      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, geraspelte Kokosnuss, Kardamompulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee und gieße es über die Reismehlmischung. Vermenge alles mit den Fingern, bis die Mischung groben Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Wasser in einem kleinen Topf und löse den geraspelten Palmzucker bei niedriger Hitze unter gelegentlichem Rühren darin auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die warme Palmzucker-Flüssigkeit zur Mehlmischung und rühre, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 12 gleich große Portionen und forme jede zu einem kleinen ovalen oder runden Fladen von etwa 2 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F (175°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Fladen portionsweise 2-3 Minuten pro Seite im heißen Öl, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie warm. Innen sind sie leicht weich, außen knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
