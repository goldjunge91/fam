      "steps": [
        {
          "position": 0,
          "text": "Pintobohnen aus der Dose abgießen und unter kaltem Wasser abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel und Jalapeño würfeln und den Knoblauch hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmalz oder Öl in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebel und Knoblauch hinzufügen und 1 Minute braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bohnen in die Pfanne geben und während des Garens mit einem Kartoffelstampfer zerdrücken, bis eine dicke Paste entsteht, etwa 5 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jalapeño, Kreuzkümmel, Salz und schwarzen Pfeffer unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 3 Minuten unter Rühren garen, bis die Bohnen vollständig vermischt und cremig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm mit Tortillas oder als Frühstücksbeilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
