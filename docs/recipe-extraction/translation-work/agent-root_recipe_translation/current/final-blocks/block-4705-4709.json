      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen, in 1/2-Zoll große Würfel schneiden und unter kaltem Wasser abspülen, um Stärke zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Chorizo aus der Wursthaut lösen und in kleine Stücke zupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und gewürfelte Zwiebel sowie Knoblauch hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerbröselte Chorizo in die Pfanne geben und 3 Minuten braten, bis sie zu bräunen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffelwürfel hinzufügen und unter häufigem Rühren 15-18 Minuten garen, bis die Kartoffeln weich und an den Rändern leicht knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gewürfelte Jalapeño in den letzten 2 Garminuten hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer würzen und heiß mit warmen Tortillas servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
