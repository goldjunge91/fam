      "steps": [
        {
          "position": 0,
          "text": "Rosinen in einer kleinen Schüssel 10 Minuten in heißem Wasser einweichen und anschließend gut abgießen. So quellen sie auf und bleiben in den gebackenen Keksen weich und saftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Butter mit braunem und Kristallzucker in einer großen Schüssel mit dem Handrührgerät 2-3 Minuten hell und luftig schlagen. Eier einzeln einrühren, dann Vanille dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Natron, Zimt, Muskat und Salz in einer separaten Schüssel verquirlen. Zu den feuchten Zutaten geben und bei niedriger Stufe rühren, bis alles gerade vermengt ist und keine trockenen Mehlstellen mehr sichtbar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Haferflocken, abgetropfte Rosinen und gehackte Walnüsse von Hand unterheben. Den Teig abdecken und mindestens 30 Minuten oder bis zu 24 Stunden kühlen, damit er fester wird und das Aroma sich vertieft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Ofen auf 350F (175C) vorheizen und zwei Backbleche mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig in Portionen von 2 tablespoons auf die Bleche setzen, mit etwa 2 inches Abstand. Die Oberseiten leicht flach drücken, da sich die Kekse nicht stark ausbreiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jeweils ein Blech 11-13 Minuten backen, bis die Ränder goldbraun sind und die Mitte noch leicht ungebacken aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Kekse 5 Minuten auf dem heißen Blech ruhen lassen, damit sie fertig stocken. Anschließend zum vollständigen Auskühlen auf ein Gitter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
