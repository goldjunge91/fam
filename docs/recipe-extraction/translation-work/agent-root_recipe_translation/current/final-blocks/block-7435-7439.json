    {
      "externalId": "waivy:bake-oatmeal-raisin-cookies",
      "slug": "bake-oatmeal-raisin-cookies",
      "title": "Haferflocken-Rosinen-Kekse",
      "instructions": "Weiche, goldbraune Haferflocken-Rosinen-Kekse mit knusprigen Rändern und zarter Mitte. Weiche Butter, saftige Rosinen und warmer Zimt sorgen für den klassischen Geschmack. Brauner Zucker und Haferflocken geben ihnen die typische chewy Konsistenz. Eine kurze Ruhezeit vertieft das Aroma.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 13,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Haferflocken und Rosinen lose kaufen, um im Vergleich zu abgepackten Marken den Preis pro Keks zu senken.",
        "Rosinen in heißem Wasser oder übrig gebliebenem Kaffee einweichen. So bleiben sie saftig, ohne dass du teurere weiche Backrosinen kaufen musst.",
        "Teig vorbereiten und Portionen einfrieren. Backe nur einige Kekse auf einmal, dann reicht eine Menge für Wochen."
      ],
      "substitutions": [
        {
          "forIngredientId": "walnuts",
          "swap": "Weglassen oder günstigere Haferflocken verwenden, damit die Kekse mehr Biss bekommen.",
          "savings": "Spart etwa $2.50 pro Zubereitung"
        },
        {
          "forIngredientId": "white-sugar",
          "swap": "Ausschließlich braunen Zucker verwenden, damit die Kekse noch zäher und karamelliger werden.",
          "savings": "Spart einige Cent und eine Vorratszutat"
        },
        {
          "forIngredientId": "vanilla-extract",
          "swap": "Eine Prise zusätzlicher Zimt und ein Schuss Ahornsirup.",
          "savings": "Spart etwa $0.40 pro Zubereitung"
        }
