      "steps": [
        {
          "position": 0,
          "text": "Mehl, Natron, Zimt, gemahlenen Ingwer, gemahlene Nelken, Piment und Salz in einer Schüssel verquirlen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Butter mit braunem Zucker in einer großen Schüssel etwa 2-3 Minuten hell und luftig schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Melasse, Ei und Vanille dazugeben und glatt verrühren. Dabei die Schüsselwand abstreifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trockene Zutaten einrühren, bis ein weicher Teig ohne Mehlspuren entsteht. Abdecken und mindestens 1 Stunde kühlen. Der Teig ist weich; durch das Kühlen laufen die Kekse im Ofen nicht zu stark auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Ofen auf 350F vorheizen und Backbleche mit Backpapier auslegen. Rohrohrzucker in eine kleine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teig zu runden Kugeln in der Größe eines Esslöffels portionieren, in grobem Zucker wälzen und mit etwa 2 inches Abstand auf das Blech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "9-11 Minuten backen, bis die Oberflächen aufgegangen und aufgerissen sind und die Ränder gerade fest, die Mitte aber noch leicht weich aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten auf dem Blech abkühlen lassen, damit die Kekse fertig stocken, dann auf ein Gitter setzen. Beim Abkühlen werden sie außen fest und bleiben innen zäh.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
