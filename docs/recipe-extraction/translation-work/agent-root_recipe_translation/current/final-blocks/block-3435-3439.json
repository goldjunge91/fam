        {
          "position": 0,
          "text": "Reis und beide Linsensorten 30 Minuten zusammen in Wasser einweichen und dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eingeweichten Reis und die Linsen mit 1 cup frischem Wasser in einer Küchenmaschine zu einem groben Teig mahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 tablespoons Öl in einer Pfanne erhitzen und Kreuzkümmelsamen hinzufügen, bis sie knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ingwer, grüne Chilis und geriebenes Gemüse hinzufügen und 2-3 Minuten anbraten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das gegarte Gemüse zusammen mit Joghurt, Salz und Natron unter den Teig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teig in eine gefettete runde Auflaufform oder gusseiserne Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 30-35 Minuten backen, bis der Handvo goldbraun ist und ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Etwas abkühlen lassen, in Stücke schneiden und heiß servieren.",
