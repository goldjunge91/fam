      "steps": [
        {
          "position": 0,
          "text": "Nimm das Steak 30 Minuten vor dem Garen aus dem Kühlschrank und tupfe es mit Küchenpapier vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze beide Seiten kurz vor dem Garen großzügig mit Meersalz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine Gusseisenpfanne oder den Grill auf sehr hohe Hitze, bis sie oder er raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das Steak auf die heiße Fläche und gare es ohne Bewegen 5-6 Minuten für medium-rare. Wende es und gare es weitere 4-5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib in der letzten Minute Olivenöl, Rosmarin, Thymian und zerdrückten Knoblauch in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Begieße das Steak mit dem Kräuteröl, indem du die Pfanne neigst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das Steak auf ein Schneidebrett und lass es vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es mit frischen Zitronenspalten und bestreue es nach Wunsch mit Fleur de Sel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
