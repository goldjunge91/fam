      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gare Penne nach Packungsanweisung bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle währenddessen Guanciale und brate es in einer großen Pfanne bei mittlerer Hitze etwa 8 Minuten knusprig aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm Guanciale heraus und stelle es beiseite. Lass etwa 1 Esslöffel Fett in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle die Zwiebel und dünste sie im restlichen Fett 3-4 Minuten weich. Gib Chiliflocken dazu und gare sie 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße zerkleinerte Tomaten hinein und lass sie 10 Minuten unter gelegentlichem Rühren köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Guanciale zurück in die Sauce und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Pasta ab, gib sie zur Sauce und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren und mit geriebenem Pecorino Romano bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
