      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und würze Kalbshaxen mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende die Haxen in Mehl und schüttle überschüssiges Mehl ab. Bräune sie in Olivenöl bei mittelhoher Hitze 4-5 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Haxen heraus. Gib gewürfelte Zwiebel, Karotten und Sellerie in denselben Topf und dünste sie 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Gieße dann Wein und Brühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Haxen zurück in den Topf. Gib Lorbeerblatt und Thymian dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und stelle ihn in den Ofen. Schmore das Fleisch 2-2.5 Stunden, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Haxen auf Servierteller. Seihe die Schmorflüssigkeit durch ein feines Sieb und schöpfe das Fett von der Oberfläche ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Sauce über die Haxen und serviere sie mit Risotto oder Polenta.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
