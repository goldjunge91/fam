      "steps": [
        {
          "position": 0,
          "text": "Klopfe Hähnchenbrust zwischen Frischhaltefolie auf eine Dicke von quarter-inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze Mehl mit Salz und Pfeffer und wende die Hähnchenstücke gleichmäßig darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl und Butter in einer großen Pfanne bei mittelhoher Hitze, bis die Mischung schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Hähnchen 3-4 Minuten pro Seite goldbraun und durch. Lege es dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackten Knoblauch in dieselbe Pfanne und gare ihn 30 Sekunden. Gieße dann Zitronensaft und Brühe hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kapern dazu und lege das Hähnchen zurück in die Pfanne. Lass alles 2 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere und passe die Würze an. Mit frischer Petersilie garniert servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
