      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Algen 5-10 Minuten in kaltem Wasser einweichen, bis sie weich und aufgequollen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Algen gründlich abgießen und überschüssiges Wasser vorsichtig ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sesamsamen in einer trockenen Pfanne bei mittlerer Hitze 1-2 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sojasauce, Reisessig, Sesamöl, braunen Zucker, gehackten Knoblauch und geriebenen Ingwer in einer kleinen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weiche Algen mit dem Dressing in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vorsichtig wenden, bis alles gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit gerösteten Sesamsamen bestreuen und vor dem Servieren mindestens 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
