          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Rührei auf zwei Teller verteilen und mit dem Toast servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nach Wunsch mit frischem Schnittlauch garnieren.",
