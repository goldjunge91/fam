      "steps": [
        {
          "position": 0,
          "text": "Die Brühe in einem großen Topf bei starker Hitze zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Zitronengrasstängel leicht andrücken und zusammen mit Galgantscheiben und ganzen Chilischoten in die Brühe geben. 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen und Pilze dazugeben und 3–4 Minuten garen, bis die Garnelen rosa werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Tomaten einrühren und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen, Limettensaft und Fischsauce einrühren und abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die festen Zutaten nach Wunsch abseihen oder für mehr Biss in der Suppe lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schüsseln schöpfen und mit frischem Koriander und Limettenspalten garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
