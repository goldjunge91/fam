      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf mit Salzwasser für die Nudeln zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleischwürfel mit Salz und Pfeffer würzen und portionsweise in 2 Esslöffeln Butter bei mittelhoher Hitze anbraten. Herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf die geschnittenen Zwiebeln und Pilze in der restlichen Butter 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl über das Gemüse streuen, gut umrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rinderbrühe und Tomatenmark einrühren und das Fleisch wieder in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hitze reduzieren, den Topf abdecken und alles 30 Minuten köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Währenddessen die Eiernudeln nach Packungsanweisung kochen, abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Stroganoff vom Herd nehmen und saure Sahne sowie Worcestersauce einrühren, ohne die Sauce nochmals aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Den Stroganoff über den warmen Nudeln servieren und nach Möglichkeit mit frischer Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
