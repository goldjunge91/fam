          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eier in eine Schüssel schlagen und mit Milch, Salz und Pfeffer verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer beschichteten Pfanne bei mittlerer Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
