      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in Salzwasser etwa 20 Minuten sehr weich kochen, abgießen und noch warm schälen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Warme Kartoffeln durch eine Kartoffelpresse oder Passiermühle auf eine saubere Arbeitsfläche drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In der Mitte eine Mulde formen, Ei und Salz hineingeben und nach und nach Mehl einarbeiten, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 4 Portionen teilen und jede zu einer etwa 0.5 Zoll dicken Rolle formen, dann in 1 Zoll große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen großen Topf Salzwasser zum Kochen bringen, Gnocchi vorsichtig hineingeben und kochen, bis sie an die Oberfläche steigen. Anschließend weitere 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Währenddessen Butter in einer Pfanne bei mittlerer Hitze mit gehacktem Knoblauch und frischem Salbei schmelzen und etwa 3 Minuten braten, bis es duftet und leicht bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gnocchi mit einer Schaumkelle herausnehmen und vorsichtig in der Buttermischung wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Schalen verteilen, mit geriebenem Parmesan und frischem schwarzem Pfeffer bestreuen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
