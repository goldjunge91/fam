      "steps": [
        {
          "position": 0,
          "text": "Fisch gründlich säubern, Innereien und Schuppen entfernen und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Garnelen fein hacken und mit Semmelbröseln, Ei, gehacktem Knoblauch, gewürfelter Zwiebel und Petersilie zur Füllung vermengen. Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischbauch vorsichtig mit der Garnelenmischung füllen und die Füllung mit den Fingern gleichmäßig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einer großen Auflaufform auf dem Herd bei mittlerer bis hoher Hitze erhitzen und den gefüllten Fisch vorsichtig hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch pro Seite 3 Minuten anbräunen, dann Weißwein und Fischbrühe in die Form geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auflaufform in den auf 400 °F vorgeheizten Ofen stellen und 25–30 Minuten backen, bis der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fisch vorsichtig auf eine Servierplatte legen, mit Bratensaft und Zitronensaft beträufeln und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
