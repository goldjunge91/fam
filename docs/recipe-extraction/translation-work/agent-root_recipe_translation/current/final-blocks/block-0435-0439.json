      "steps": [
        {
          "position": 0,
          "text": "Halbiere die Tomaten und gib sie in ein Sieb. Bestreue sie mit 1 Teelöffel Meersalzflocken und lass sie mindestens 20 Minuten stehen. Das Salz macht die Tomaten weicher, entzieht ihnen überschüssige Flüssigkeit und intensiviert ihren Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Richte die gesalzenen Tomaten auf einer Servierplatte an und zupfe die Burrata darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreue alles mit frisch gemahlenem schwarzem Pfeffer und nach Geschmack mit zusätzlichem Meersalz. Träufle reichlich natives Olivenöl extra darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle den Salat nach Wunsch mit Balsamicoessig und streue ganze Basilikumblätter darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sofort servieren. Nach Wunsch geröstetes Sauerteigbrot dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
