      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350F vor und lass die Koteletts 10 bis 15 Minuten bei Zimmertemperatur ruhen, damit sie sich entspannen und mehr Glasur aufnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Apfelmus, braunen Zucker, Barbecuesauce, Worcestershiresauce, gehackten Knoblauch, Salz und Pfeffer in einer Schüssel, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Schweinekoteletts nebeneinander in eine gusseiserne oder andere ofenfeste Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Löffle großzügig Glasur über die Koteletts und bedecke sie gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie ohne Abdeckung 20 bis 25 Minuten, bis ein Thermometer an der dicksten Stelle 145F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Koteletts vor dem Servieren 5 Minuten ruhen und löffle dann die Glasur aus der Pfanne darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
