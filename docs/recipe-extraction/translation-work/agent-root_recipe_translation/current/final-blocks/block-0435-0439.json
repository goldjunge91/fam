          "swap": "Reife Strauch- oder Roma-Tomaten",
          "savings": "Ungefähr halb so teuer"
        },
        {
          "forIngredientId": "balsamic",
          "swap": "Ein Spritzer frischer Zitronensaft oder Rotweinessig",
          "savings": "Verwende, was du bereits hast"
        }
