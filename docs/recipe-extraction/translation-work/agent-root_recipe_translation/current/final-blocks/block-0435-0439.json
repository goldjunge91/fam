              "key": "77b41be0-3051-5f63-9b0b-81c79e21737e",
              "ingredientName": "Chiliflocken",
              "grams": 2.5,
              "quantity": 2.5,
              "unit": "g",
              "position": 14,
              "optional": true,
              "source_note": "Chiliflocken, zum Servieren"
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Mariniere die Garnelen: Bestreue sie in einer kleinen Schüssel mit Paprikapulver, Salz und schwarzem Pfeffer und schwenke sie darin. Mariniere sie höchstens 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Pasta nach Packungsanleitung, aber 1 Minute kürzer, damit sie in der Sauce fertig gart. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen, tiefen, schweren Pfanne bei mittelhoher Hitze. Gib die Garnelen dazu und brate sie etwa 1 Minute pro Seite. Nimm sie heraus und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Butter, rote Zwiebel und Knoblauch in dieselbe Pfanne. Gare alles unter Rühren 1-2 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte sonnengetrocknete Tomaten und Hühnerbrühe dazu. Gare alles 1-2 Minuten, bis die Brühe auf die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Babyspinat dazu und gare ihn unter Rühren etwa 1 Minute, bis er gerade zusammengefallen ist (bei festerem Blattgemüse wie Grünkohl oder Mangold 4-5 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Sahne dazu und lass alles 1-2 Minuten köcheln, bis die Sauce leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Parmesan ein und gib dann gegarte Pasta und Garnelen dazu. Nach Wunsch einige Garnelen für die Oberfläche beiseitelegen. Alles in der Sauce wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schmecke das Gericht ab und serviere es sofort mit zusätzlichem Parmesan und nach Wunsch Chiliflocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
