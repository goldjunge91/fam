      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen, schweren Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das tiefgekühlte Gemüse dazu und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch dazu und gare ihn unter Rühren eine weitere 1 Minute mit dem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den gekochten Reis und den abgetropften Thunfisch dazu und gare alles 1 Minute. Rühre dabei um, damit sich die Zutaten vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schiebe alles auf eine Seite der Pfanne. Gieße die verquirlten Eier auf die freie Seite und gare sie 2-3 Minuten, bis sie fest sind. Hebe sie dann unter die Reismischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Tamari und Sesamöl ein, gare alles eine letzte 1 Minute und serviere das Gericht heiß.",
