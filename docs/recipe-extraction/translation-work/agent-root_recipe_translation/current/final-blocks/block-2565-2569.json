          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle ihn mit zusätzlichem Olivenöl und streue Chiliflocken darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
