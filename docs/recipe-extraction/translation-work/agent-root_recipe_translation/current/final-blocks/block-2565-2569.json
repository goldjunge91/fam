      "steps": [
        {
          "position": 0,
          "text": "Schneide Kalbfleisch in 1.5-inch große Würfel und blanchiere sie 5 Minuten in kochendem Salzwasser. Gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze. Gib Mehl dazu und rühre ständig 2 Minuten, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße nach und nach Hühnerbrühe zur Mehlschwitze und verquirle alles glatt. Gib dann blanchiertes Fleisch und Lorbeerblatt dazu und lass alles 40 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Perlzwiebeln, Karotten und Pilze hinzu und lass alles weitere 20 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eigelb mit Milch und Zitronensaft in einer Schüssel zu einer Liaison.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Temperiere die Eiermischung langsam, indem du unter ständigem Rühren heiße Brühe zugibst. Rühre sie dann bei ausgeschalteter Hitze in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und weißem Pfeffer. Die Sauce soll cremig und glatt sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in flachen Schalen mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
