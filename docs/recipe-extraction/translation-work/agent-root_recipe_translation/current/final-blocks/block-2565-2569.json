      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweine- oder Hähnchenfleisch in 1-inch große Würfel und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Olivenöl, Zitronensaft, gehackten Knoblauch, Oregano, Salz und Pfeffer und gieße die Marinade über das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass es mindestens 15 Minuten bei Raumtemperatur oder bis zu 4 Stunden im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke das Fleisch abwechselnd mit Zwiebel- und Tomatenstücken auf Metallspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine Grillpfanne oder einen Außengrill auf hohe Hitze und gare die Spieße 10-12 Minuten. Wende sie gelegentlich, bis das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Pitabrot auf dem Grill 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Spieße mit Pitabrot, frischen Tomaten- und Zwiebelscheiben und Tzatzikisauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
