      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und koche Penne nach Packungsanweisung. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne und dünste gewürfelte Zwiebel etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Rinderhackfleisch dazu und gare es etwa 8 Minuten unter Zerteilen, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und Zimt ein und gare alles 2 Minuten. Würze dann mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmilz 4 Esslöffel Butter in einem Topf und rühre Mehl zu einer Mehlschwitze ein. Gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße nach und nach Milch unter ständigem Rühren dazu, bis eine glatte, dicke Béchamelsauce entsteht, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische gekochte Pasta mit der Hälfte der Béchamelsauce und der Hälfte des Parmesans und verteile sie dann in einer gefetteten Auflaufform von 9x13.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Fleischsauce über der Pasta und gib die restliche Béchamelsauce sowie Parmesan darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backe den Auflauf 30-35 Minuten, bis die Oberfläche goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
