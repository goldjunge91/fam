      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und stich die Auberginen rundherum mit einer Gabel ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Auberginen direkt auf dem Ofenrost 25-30 Minuten, bis sie ganz weich sind und zusammenfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass sie abkühlen, bis sie nur noch lauwarm sind. Löffle dann das Fruchtfleisch in ein Sieb und lass es 5 Minuten abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Auberginenfleisch in eine Schüssel und zerdrücke es mit einer Gabel, bis es leicht stückig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hacke Knoblauch und würfle rote Zwiebel fein. Hebe beides unter die Aubergine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Zitronensaft, Olivenöl, Salz und Pfeffer ein, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe gehackte frische Petersilie unter und passe die Würze bei Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle den Dip in eine Servierschüssel und serviere ihn bei Raumtemperatur mit Pitabrot oder Crackern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
