      "steps": [
        {
          "position": 0,
          "text": "Koche das ganze Hähnchen in 6 cups Wasser mit Kurkuma und Salz 35 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen heraus und lass es etwas abkühlen. Zupfe das Fleisch ab und entsorge die Knochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Seihe die Brühe in einen Topf ab und erhitze sie wieder. Weiche getrocknete Garnelen in warmem Wasser ein und gib sie dann zur Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Brühe 10 Minuten köcheln, würze sie mit Fischsauce und schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Reisnudeln nach Packungsanweisung, gieße sie ab und verteile sie auf Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe heiße Brühe über die Nudeln in jeder Schale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Schale mit gezupftem Hähnchen, Röstschalotten, geschnittenen Frühlingszwiebeln und frischen Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
