      "steps": [
        {
          "position": 0,
          "text": "Gieße kochendes Wasser langsam zur Tapiokastärke und rühre dabei mit einem Essstäbchen, bis ein heißer Teig entsteht. Knete ihn 2 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle den Schweinebauch fein, entferne die Darmader der Garnelen, hacke sie grob und vermenge sie mit Schweinefleisch, Frühlingszwiebel, Fischsauce, Salz und Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchte deine Hände, nimm 1 tbsp Tapiokateig und drücke ihn in der Handfläche flach. Gib 1 tsp Füllung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe den Teig zu einem Halbmond zusammen und drücke die Ränder fest zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege einen Bambusdämpfer mit Backpapier aus und ordne die Teigtaschen mit Abstand darin an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe sie 12 Minuten über kochendem Wasser, bis sie glasig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit einer einfachen Dip-Sauce aus Fischsauce, Wasser, Zucker und Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
