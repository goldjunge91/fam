      "steps": [
        {
          "position": 0,
          "text": "Säubere und entweide das Spanferkel gründlich. Tupfe es innen und außen mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Salz, Pfeffer, gehackten Knoblauch, Lorbeerblätter, Thymian und Zwiebelstücke. Fülle die Mischung großzügig in die Bauchhöhle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Binde die Beine mit Küchengarn zusammen und fixiere das Maul mit einem Bambusstab, damit das Spanferkel beim Braten seine Form behält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite einen Holzkohlegrill oder Drehspieß vor. Spieße das Spanferkel auf und befestige es fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate es über mittelheißen Kohlen 3-4 Stunden. Wende es gelegentlich und beträufle es alle 30 Minuten mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Haut sollte goldbraun und knusprig werden, während das Fleisch eine Kerntemperatur von 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass das Spanferkel 15 Minuten ruhen. Viertle es dann und serviere es mit Lebersauce aus pürierter Leber, Essig und Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
