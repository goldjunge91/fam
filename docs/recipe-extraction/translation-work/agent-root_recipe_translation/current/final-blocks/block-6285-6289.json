      "steps": [
        {
          "position": 0,
          "text": "Schneide die Fischfilets in mundgerechte Stücke und entferne die Darmader der Garnelen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Fisch, Garnelen und Limettensaft in einer großen Schüssel. Lass die Meeresfrüchte 10 Minuten in der Säure ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Kokosmilch in einem Topf bei mittlerer Hitze. Gib gehackten Knoblauch und Ingwer dazu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den mit Limettensaft gebeizten Fisch und die Garnelen samt Flüssigkeit in die Kokosmilch und lass alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge geschnittene rote Zwiebel und gehackte Chili hinzu und lass alles weitere 3 Minuten köcheln, bis die Garnelen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und schmecke das Verhältnis von Limette und Kokosmilch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß oder bei Zimmertemperatur, garniert mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
