      "steps": [
        {
          "position": 0,
          "text": "Vermenge Calamansi-Saft, gehackten Knoblauch, Ingwer, Sojasauce, Essig und braunen Zucker in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Hähnchenstücke in einen Behälter, gieße die Marinade darüber und stelle sie mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Annatto-Öl in einer großen Pfanne bei mittlerer bis hoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Hähnchen aus der Marinade (bewahre die Flüssigkeit auf) und brate es im heißen Öl pro Seite 5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die aufbewahrte Marinade in die Pfanne und bringe sie zum Köcheln. Reduziere dann die Hitze auf mittlere bis niedrige Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und lass alles 20 Minuten köcheln, bis das Hähnchen gar ist und die Sauce etwas eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer und serviere das Hähnchen mit Reis und angekohlten Calamansi- oder Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
