      "steps": [
        {
          "position": 0,
          "text": "Frischen Spinat in kochendem Salzwasser 2 Minuten blanchieren, dann überschüssige Feuchtigkeit gründlich ausdrücken und fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackte Walnüsse in einer trockenen Pfanne bei mittlerer Hitze 3-4 Minuten rösten, dabei gelegentlich umrühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Walnüsse in einer Küchenmaschine zerkleinern, bis sie grob gemahlen sind, dann Spinat, Knoblauch, Granatapfelmelasse, rote Paprikaschote und Koriander hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mischen Sie alles, bis alles gut vermischt, aber immer noch leicht strukturiert ist, und fügen Sie nach Bedarf Wasser hinzu, um eine pastenartige Konsistenz zu erreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In eine Servierschüssel geben und zu einem Hügel formen, dann nach Wunsch mit weiteren Granatapfelkernen oder einer Walnuss garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei Zimmertemperatur mit frischem Brot oder als Teil einer Mezze-Platte servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
