      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und die Rindfleischwürfel portionsweise anbraten, insgesamt etwa 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rindfleisch herausnehmen und die gewürfelten Zwiebeln und den Knoblauch im selben Topf etwa 8 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Paprikapulver und Kümmel einrühren und 1 Minute kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Rindfleisch wieder in den Topf geben, Rinderbrühe und Majoran hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und lassen Sie das Fleisch zugedeckt 60 Minuten köcheln, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln und Karotten hinzufügen und weitere 35-40 Minuten köcheln lassen, bis das gesamte Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Großzügig mit Salz und Pfeffer würzen und dampfend heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
