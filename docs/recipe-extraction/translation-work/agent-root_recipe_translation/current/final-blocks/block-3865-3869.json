      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf mit Salzwasser zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer Schüssel Mehl, Eier, Wasser und Salz vermischen, bis ein dicker Teig entsteht, der etwas weicher als ein fester Teig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halten Sie ein Sieb oder einen Nokedli-Maker über das kochende Wasser und drücken Sie den Teig in kleinen Mengen durch die Löcher, um Tropfennudeln zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kochen Sie die Nokedli 2-3 Minuten lang, nachdem sie an der Oberfläche schwimmen, und nehmen Sie sie dann mit einem Schaumlöffel in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einer separaten Pfanne Butter bei mittlerer Hitze schmelzen und die gewürfelten Zwiebeln etwa 5 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Paprikapulver in die Zwiebelbutter einrühren und 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Paprikabutter über die Nokedli gießen, mit schwarzem Pfeffer würzen und vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
