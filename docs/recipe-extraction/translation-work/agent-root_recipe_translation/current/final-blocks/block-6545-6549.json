      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Deckel der Paprika ab und entferne Kerne und weiße Innenhäute, ohne die Paprikawände zu beschädigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Rinderhackfleisch und gehackte Zwiebel in Olivenöl an und rühre dann den ungekochten Reis ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre 1/2 Tasse Tomatensauce, Salz und Pfeffer unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Paprika mit der Fleisch-Reis-Mischung und stelle sie aufrecht in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische die übrige Tomatensauce mit Rinderbrühe und gieße die Mischung um die Paprika herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Form mit Folie ab und backe die Paprika 40 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne die Folie, lasse das Gericht 5 Minuten ruhen und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
