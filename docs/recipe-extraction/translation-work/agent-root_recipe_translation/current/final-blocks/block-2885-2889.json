      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine große Pfanne bei mittlerer bis hoher Hitze und bräune das Rinderhackfleisch, bis es gar ist. Zerteile es dabei in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Hühnerleber in die Pfanne und gare sie etwa 3-4 Minuten, bis sie nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gewürfelte Zwiebel, Sellerie, Paprika und gehackten Knoblauch ein und gare alles etwa 5 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Reis in die Pfanne und rühre 2 Minuten ständig um, damit die Körner leicht angeröstet werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Hühnerbrühe hinzu, würze mit Salz, schwarzem Pfeffer und Cayennepfeffer und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke die Pfanne ab und lasse alles 20 Minuten köcheln, bis der Reis weich ist und die Flüssigkeit aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lockere den Reis mit einer Gabel auf und probiere ihn. Passe die Würzung vor dem Servieren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
