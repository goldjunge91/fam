      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittlerer bis hoher Hitze und brate den Rinderbraten insgesamt etwa 10 Minuten von allen Seiten braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Fleisch heraus und stelle es beiseite. Gib Zwiebel und Knoblauch hinzu und gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Rinderbraten zurück in den Topf und füge Brühe, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze, decke den Topf ab und lasse alles 2 Stunden köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Karotten und Kartoffeln hinzu, decke den Topf ab und lasse alles weitere 45 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Braten heiß in Schalen mit Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
