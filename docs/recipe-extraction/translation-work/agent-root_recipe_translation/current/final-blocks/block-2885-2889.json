      "steps": [
        {
          "position": 0,
          "text": "Vermische Paprikapulver, Knoblauchpulver, Zwiebelpulver, Cayennepfeffer, Thymian, Oregano, schwarzen Pfeffer und Salz in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe Fischfilets trocken und bestreiche beide Seiten großzügig mit der Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine gusseiserne Pfanne bei mittlerer bis hoher Hitze etwa 2 Minuten, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Butter in die Pfanne und schwenke sie, damit der Boden bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege Fischfilets in die heiße Pfanne und gare sie 3-4 Minuten, ohne sie zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende die Filets vorsichtig und gare die andere Seite 2-3 Minuten, bis die Kerntemperatur 145°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Filets auf Servierteller und serviere sie sofort mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
