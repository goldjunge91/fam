      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz. Arbeite kalte Butter ein, bis die Mischung an Semmelbrösel erinnert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Eigelb mit kaltem Wasser und gib es zum Teig. Nur so lange mischen, bis alles gerade verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme den Teig zu einer flachen Scheibe, wickle ihn in Frischhaltefolie und stelle ihn 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig aus und drücke ihn in eine 9-Zoll-Tarteform. Stich den Boden mit einer Gabel ein und backe ihn bei 375°F 12 Minuten, bis er hellgolden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze die Sahne, bis sie dampft. Gieße sie über die Schokodrops und lasse alles 1 Minute stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre die Schokoladenmischung glatt und rühre Maissirup und Vanille ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Ganache in den warmen Tarteboden und lasse sie auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle die Tarte etwa 2 Stunden kalt, bis die Ganache fest ist, und serviere sie dann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
