      "steps": [
        {
          "position": 0,
          "text": "Schneide den Rührkuchen in 1-Zoll-Würfel und schichte die Hälfte davon in eine große Glasschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Beträufle die Kuchenwürfel mit Sherry oder Saft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite den Vanillepudding nach Packungsanweisung mit Milch zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Hälfte des Puddings über die Kuchenschicht und verteile die Hälfte der Himbeeren darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte die übrigen Kuchenwürfel und den restlichen Pudding darauf, dann gib die übrigen Himbeeren dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage Schlagsahne mit Zucker und Vanille steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Schlagsahne obenauf und bestreue sie mit Mandeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle das Dessert vor dem Servieren mindestens 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
