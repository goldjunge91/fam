      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, 2 Esslöffel Kristallzucker, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Arbeite kalte Butter ein, bis die Mischung an Semmelbrösel erinnert. Rühre dann die Milch ein, bis gerade ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze 4 gleich große Teigportionen auf das Backblech und backe sie 12-15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide währenddessen die Erdbeeren auf und vermische sie mit dem restlichen Kristallzucker. Lasse sie 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage Schlagsahne mit Puderzucker und Vanille steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die noch warmen Gebäckstücke waagerecht auf und schichte Erdbeeren und Schlagsahne darauf. Setze die obere Hälfte wieder auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange das Gebäck noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
