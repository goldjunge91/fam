      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln 20 Minuten in Salzwasser, bis sie teilweise gar sind. Gieße sie ab und lasse sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Pancetta und Zwiebel in Olivenöl etwa 4 Minuten an, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Kalbshackfleisch hinzu und brate es etwa 6 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd und rühre Ricotta, Parmesan, Ei, Petersilie, Salz und Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Halbiere die abgekühlten Kartoffeln und höhle sie aus, sodass eine dünne Schale bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Kartoffelschalen mit der Fleischmischung und lege sie in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 375°F 20-25 Minuten, bis die Kartoffeln weich und die Oberseiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß und garniere sie mit zusätzlichem Parmesan und frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
