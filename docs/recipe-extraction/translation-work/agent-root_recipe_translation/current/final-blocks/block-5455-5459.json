        {
          "position": 0,
          "text": "Koche die gewürfelten Kartoffeln 12-15 Minuten in Salzwasser, bis sie sehr weich sind. Gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerdrücke die Kartoffeln mit Butter, Milch, Salz und Pfeffer zu einer cremigen Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe Cheddar, Speck, die Hälfte der Frühlingszwiebeln und Sauerrahm unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze die Kartoffelmasse in 4 Häufchen auf ein gebuttertes Backblech. Forme mit der Rückseite eines Löffels Nester mit einer leichten Vertiefung in der Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie bei 375°F 15 Minuten, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue jedes Nest mit den übrigen Frühlingszwiebeln und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nach Wunsch kannst du die Mitte vor dem Servieren mit einem Spiegelei oder einer Hackfleischmischung füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
