      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 375°F vorheizen und Pitabrot in 1-inch-Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pitabrotstücke mit 1 tbsp Olivenöl, Salz und Pfeffer vermengen, auf einem Backblech verteilen und 8-10 Minuten goldbraun und knusprig rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Salat, Tomate, Gurke, Paprika und Radieschen schneiden und in einer großen Salatschüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zitronensaft, restliches Olivenöl, gehackten Knoblauch, Sumach, Salz und Pfeffer in einer kleinen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dressing über den Salat geben und alles gut vermengen, sodass das Gemüse überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kurz vor dem Servieren die warmen, knusprigen Pitachips daraufgeben und vorsichtig erneut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
