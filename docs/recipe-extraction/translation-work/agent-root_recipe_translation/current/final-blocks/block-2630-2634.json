      "steps": [
        {
          "position": 0,
          "text": "Ghee in einem großen Topf erhitzen und die Lammwürfel portionsweise von allen Seiten anbraten, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf Zwiebeln weich dünsten, Knoblauch und Piment hinzufügen und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lamm zurück in den Topf geben, Hühnerbrühe hinzufügen und aufkochen. Dann die Hitze reduzieren und zugedeckt 45 Minuten köcheln lassen, bis das Lamm zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Joghurt und Maisstärke in einer Schüssel glatt verrühren, dann unter ständigem Rühren langsam 1 cup heiße Brühe aus dem Topf hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Joghurtmischung unter ständigem Rühren langsam zurück in den Topf gießen und 10 Minuten sanft köcheln lassen, ohne sie aufzukochen, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pinienkerne in einer trockenen Pfanne rösten, bis sie duften, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pitabrot auf eine Platte legen, Lamm und Joghurtsauce darübergeben und mit gerösteten Pinienkernen und frischer Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
