      "steps": [
        {
          "position": 0,
          "text": "Olivenöl, Zitronensaft, gehackten Knoblauch, Koriander, Petersilie, Salz, Pfeffer, Kreuzkümmel und Paprikapulver in einer Schüssel zu einer Marinade vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fischfilets auf einen Teller legen, beide Seiten mit Marinade bestreichen und 15 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grill auf mittelhohe Hitze vorheizen und den Rost leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischfilets mit der Hautseite nach unten auf den Grill legen und 4-5 Minuten garen, ohne sie zu bewegen, bis die Haut goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Filets vorsichtig wenden und weitere 3-4 Minuten garen, bis der Fisch undurchsichtig ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort mit gegrillten Zitronenspalten, Reis und frischem Salat servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
