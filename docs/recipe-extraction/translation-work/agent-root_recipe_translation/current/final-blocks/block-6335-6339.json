      "steps": [
        {
          "position": 0,
          "text": "Den gewürfelten Fisch in einer nichtmetallischen Schüssel mit Limettensaft vermischen und darauf achten, dass alle Stücke eingetaucht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Fisch 10 Minuten in der Säure ziehen lassen, damit er dadurch „gart“. Er sollte undurchsichtig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den größten Teil des Limettensafts abgießen und etwa 2 Esslöffel davon zurücklassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch, Zwiebeln, Chilischoten, Ingwer, Knoblauch und Fischsauce zum Fisch geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vorsichtig umrühren, um alle Zutaten gleichmäßig zu vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und mit Salz, Pfeffer und zusätzlicher Fischsauce abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort in einer Schüssel oder auf einem Salatblatt als Vorspeise servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
