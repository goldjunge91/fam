      "steps": [
        {
          "position": 0,
          "text": "Klebreis unter kaltem Wasser abspülen, bis das Wasser klar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasser in einem Topf zum Kochen bringen und Reis hinzufügen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und lassen Sie den Reis 15 Minuten lang köcheln, bis er fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch dazugeben und gründlich verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Braunen Zucker, Salz und Butter hinzufügen und verrühren, bis sich alles aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei schwacher Hitze 5–8 Minuten unter häufigem Rühren weiterkochen, bis die Mischung cremig und dickflüssig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Servierschüsseln füllen und mit gerösteten Sesamkörnern und zerstoßenen Erdnüssen belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß als süßes Frühstück oder Snack servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
