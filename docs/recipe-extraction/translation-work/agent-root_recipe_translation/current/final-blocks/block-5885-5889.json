      "steps": [
        {
          "position": 0,
          "text": "Röste die Auberginen 8-10 Minuten direkt über einer Gasflamme oder unter dem Backofengrill, bis sie rundum geschwärzt sind. Wickle sie dann 5 Minuten in Folie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ziehe die verkohlte Haut ab, gib das Fruchtfleisch in eine Schüssel, zerdrücke es glatt und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf und brate die Fleischwürfel mit der gewürfelten Zwiebel etwa 8 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Gib dann 1.5 cups Wasser, Salz und Pfeffer dazu und lasse alles 25 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmilz währenddessen Butter in einem Topf und rühre Mehl ein, bis eine Mehlschwitze entsteht. Gieße nach und nach Milch unter ständigem Rühren dazu, bis die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und rühre zerdrückte Aubergine und Käse glatt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile den Fleischeintopf auf Servierschüsseln und gib reichlich Auberginenpüree darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
