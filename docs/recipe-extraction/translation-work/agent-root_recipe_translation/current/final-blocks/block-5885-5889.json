      "steps": [
        {
          "position": 0,
          "text": "Halbiere die Auberginen längs und höhle das weiche Innere aus. Lasse dabei eine 0.25-inch dicke Schale stehen und hacke das Fruchtfleisch fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Zwiebel, Knoblauch, Tomate und grüne Paprika und hacke die Petersilie fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 3 tbsp Olivenöl in einer Pfanne bei mittlerer Hitze und brate das Hackfleisch 4-5 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zwiebel und Knoblauch dazu und gare sie 3 Minuten. Rühre dann Tomatenmark, gewürfelte Paprika und Tomate ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe das gehackte Auberginenfleisch, Petersilie, Salz und Pfeffer unter und gare alles 5 Minuten, bis die Mischung verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Auberginenschalen mit dem restlichen Olivenöl, lege sie mit der Schnittseite nach oben in eine Auflaufform und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Auberginenschalen mit der Fleischmischung und gieße Wasser um die Auberginen herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Form zugedeckt bei 375°F 25-30 Minuten, bis die Auberginen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
