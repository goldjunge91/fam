      "steps": [
        {
          "position": 0,
          "text": "Schneide die Auberginen in 3-inch große Stücke und wende sie gründlich in Speisestärke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere die Auberginen portionsweise 3-4 Minuten goldbraun und weich. Lasse sie anschließend auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Dashi, Sojasoße, Mirin, Zucker, gehackten Knoblauch und Ingwer in einem Topf und lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte die frittierte Aubergine auf einer Servierplatte an und gieße die heiße Dipsoße darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garniere das Gericht sofort mit Bonitoflocken und gehackter Frühlingszwiebel und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
