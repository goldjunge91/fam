      "steps": [
        {
          "position": 0,
          "text": "Udon nach Packungsanleitung garen und 1/4 Tasse Nudelwasser auffangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pilze in Butter bei hoher Hitze 4–5 Minuten bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch hinzufügen und 30 Sekunden garen. Spinat dazugeben und vermengen, bis er zusammenfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Miso und Sojasauce in das aufgefangene Nudelwasser rühren und über Nudeln und Pilze gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit den abgetropften Udon vermengen. Mit einem weich gekochten Ei, Sesamöl, Frühlingszwiebeln und Sesam garnieren.",
