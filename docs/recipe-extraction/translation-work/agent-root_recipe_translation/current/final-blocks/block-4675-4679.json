      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 425°F vorheizen und den Reis auf einem Blech verteilen, damit er 5 Minuten leicht trocknet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Garnelen mit Salz und Pfeffer würzen und um den Reis herum auf dem Blech verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "5-7 Minuten braten, bis die Garnelen rosa werden, dann zur Seite schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier in einer Schüssel verquirlen, dann auf das Blech geben und in kleine Stücke zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tiefgekühlte Erbsen und Karotten, gehackten Knoblauch und Ingwer auf das Blech geben und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasoße und Sesamöl über alles träufeln und vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 3-4 Minuten braten, bis das Gemüse vollständig erhitzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mit gehackten Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
