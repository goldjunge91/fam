      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrüste auf 1/4-inch Dicke klopfen und leicht mit Mehl bestäuben, das mit Salz und Pfeffer vermischt wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl und Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenbrüste pro Seite 3-4 Minuten scharf anbraten, dann auf ein Blech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne die in Scheiben geschnittenen Champignons und den gehackten Knoblauch 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Pfanne mit Marsalawein ablöschen und dann die Hühnerbrühe dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Champignonsoße über das Hähnchen auf dem Blech gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 12-15 Minuten backen, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
