      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 400°F vorheizen und ein Blech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zucchini und Spargel in 2-inch große Stücke schneiden und die Zitrone in dünne Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Gemüse auf dem Blech verteilen und mit Olivenöl beträufeln, dann mit Salz, Pfeffer, Thymian und gehacktem Knoblauch würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Gemüse 10 Minuten braten, dann an den Rand schieben und die Kabeljaufilets in die Mitte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Kabeljau mit Salz, Pfeffer und Thymian würzen und mit Zitronenscheiben belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 10-12 Minuten braten, bis sich der Kabeljau leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit dem Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
