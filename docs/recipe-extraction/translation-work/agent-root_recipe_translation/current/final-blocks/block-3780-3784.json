      "steps": [
        {
          "position": 0,
          "text": "Verquirle Kichererbsenmehl, Wasser, Salz, Pfeffer und Zwiebelpulver glatt und lasse den Teig 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1.5 tablespoons Olivenöl in einer 10-inch gusseisernen oder beschichteten Pfanne bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Hälfte des Teigs in die heiße Pfanne und verstreiche ihn mit einem Pfannenwender dünn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreue ihn mit Rosmarin und gare ihn 3-4 Minuten, bis sich die Ränder lösen und die Unterseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende den Fladen und gare ihn weitere 2 Minuten, bis er fest ist. Lege ihn dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wiederhole den Vorgang mit dem restlichen Öl und Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide den Fladen in Spalten und serviere ihn heiß mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
