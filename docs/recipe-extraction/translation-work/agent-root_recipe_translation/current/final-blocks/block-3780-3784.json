      "steps": [
        {
          "position": 0,
          "text": "Weiche Stockfisch 24 Stunden in kaltem Wasser ein und wechsle das Wasser mehrmals.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Kartoffeln und Stockfisch getrennt jeweils etwa 20 Minuten weich und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerpflücke den gegarten Stockfisch und entferne alle übrigen Gräten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schäle heiße Kartoffeln und zerdrücke sie mit gehacktem Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme Olivenöl und Milch zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Kartoffeln und Stockfisch und schlage dann nach und nach die warme Öl-Milch-Mischung unter, bis alles luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Zitronensaft, Muskatnuss, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht warm mit gerösteten Brotscheiben oder Crackern.",
