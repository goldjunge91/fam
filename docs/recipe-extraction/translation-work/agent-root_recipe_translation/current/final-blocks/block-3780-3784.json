      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Wasser, 2 tablespoons Olivenöl und Salz zu einem weichen Teig und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Zwiebeln und Knoblauch dünn und dünste sie in 2 tablespoons Olivenöl bei niedriger bis mittlerer Hitze 25 Minuten, bis sie sehr weich und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze karamellisierte Zwiebeln mit Thymian, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke den Teig in eine geölte 9x13 inch große Backform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile karamellisierte Zwiebeln gleichmäßig auf dem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Sardellen im Rautenmuster auf die Zwiebeln und verteile Oliven zwischen den Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Tarte bei 425°F 15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie 5 Minuten abkühlen, schneide sie in Quadrate und serviere sie warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
