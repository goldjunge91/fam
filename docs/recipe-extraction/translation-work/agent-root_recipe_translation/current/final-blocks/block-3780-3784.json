      "steps": [
        {
          "position": 0,
          "text": "Würfle Speck und brate ihn in einem Schmortopf knusprig. Nimm ihn heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Rindfleisch in 1.5-inch große Würfel und bräune es portionsweise im Speckfett an. Nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Perlzwiebeln und Pilze goldbraun und schiebe sie dann an den Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und Tomatenmark dazu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche mit Rotwein ab und löse die Röstspuren vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Rindfleisch und Speck zurück in den Topf und füge Karotten, Thymian und Lorbeerblätter hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf ab und schmoren alles im Ofen bei 325°F 2-2.5 Stunden, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
