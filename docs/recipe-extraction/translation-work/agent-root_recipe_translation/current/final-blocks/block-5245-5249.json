      "steps": [
        {
          "position": 0,
          "text": "Bringe Salzwasser in einem großen Topf zum Kochen und gare die Penne nach Packungsanleitung bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste den Knoblauch etwa 1 Minute an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kirschtomaten und rote Zwiebel dazu und gare alles 5–7 Minuten. Zerdrücke die Tomaten dabei vorsichtig, sobald sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Pasta ab und gib sie zur Tomatenmischung in die Pfanne. Vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und hebe zerbröselten Feta, frisches Basilikum und Zitronensaft unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
