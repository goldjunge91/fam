      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gare die Ramen-Nudeln 2–3 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während die Nudeln kochen, schmilz Butter in einer separaten Pfanne bei mittlerer bis hoher Hitze und dünste den gehackten Knoblauch an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage die Eier in die gebutterte Pfanne und brate sie als Spiegeleier, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Nudeln ab, fange 1 Tasse Kochwasser auf und gib die Nudeln zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Sojasauce, Sriracha, Sesamöl und das aufgefangene Kochwasser unter die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Nudeln auf Servierschalen und belege sie mit Spiegeleiern und Mozzarella.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue alles mit Frühlingszwiebeln und serviere sofort, solange der Käse noch leicht schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
