      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilis und röste sie 1 Minute in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gerösteten Chilis mit Rinderbrühe, der halben Zwiebel, Knoblauchzehen, Kreuzkümmel, Oregano und Essig in einen Topf und lass alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die Chilisauce glatt und streiche sie durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Rinderschulter in einen großen Topf und gieße die abgesiebte Chilisauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lass das Fleisch zugedeckt 1.5 Stunden köcheln, bis es sehr zart ist und sich leicht zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Fleisch heraus, zerpflücke es mit zwei Gabeln und gib es zurück in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze die Tortillas in einer trockenen Pfanne, tauche jede 2 Sekunden in die warme Brühe und fülle sie dann mit dem gezupften Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Tacos mit gewürfelter Zwiebel, Koriander und einer kleinen Schale Brühe zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
