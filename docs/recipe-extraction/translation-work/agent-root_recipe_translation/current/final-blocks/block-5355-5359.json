      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in dünne Scheiben, die Paprika in mundgerechte Stücke und die Chilischoten in dünne Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die breiten Reisnudeln nach Packungsanleitung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 Esslöffel Öl in einem Wok oder einer großen Pfanne bei starker Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und geschnittene Chilischoten dazu und brate sie unter Rühren etwa 30 Sekunden an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Hähnchenstücke dazu und brate sie etwa 5-7 Minuten, bis sie gebräunt und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Paprika und gekochte Nudeln dazu. Gieße Sojasauce, Fischsauce und Limettensaft hinein und streue Zucker darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge alles bei starker Hitze 2-3 Minuten miteinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zupfe die Basilikumblätter klein und hebe sie kurz vor dem Servieren unter. Behalte etwas zum Garnieren zurück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
