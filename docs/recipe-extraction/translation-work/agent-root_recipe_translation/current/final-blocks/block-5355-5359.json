      "steps": [
        {
          "position": 0,
          "text": "Verrühre Sojasauce, Mirin, Zucker, Sesamöl, Reisessig und gehackten Knoblauch in einer kleinen Schüssel zu einer Tare-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe einen großen Topf mit Salzwasser zum Kochen. Koche die Ramen-Nudeln bissfest und gieße sie gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die heißen Nudeln auf zwei Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße jeweils die Hälfte der Tare-Sauce über die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die Nudeln mit einer Zange oder Essstäbchen kräftig mit der Sauce, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib je ein halbiertes weich gekochtes Ei, zerrissene Nori-Streifen und geschnittene Frühlingszwiebeln darauf. Bestreue alles mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Nudeln sofort, solange sie noch warm sind. Vermische sie nach Wunsch kurz vor dem Essen erneut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
