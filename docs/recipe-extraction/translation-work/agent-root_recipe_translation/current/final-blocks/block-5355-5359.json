      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Würfel oder dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Sojasauce, Honig, Reisessig, gehackten Knoblauch und Ingwer, Sesamöl und Gochugaru in einer kleinen Schüssel zu einer Yangnyeom-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne oder einem Wok bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Hähnchenstücke dazu und brate sie unter gelegentlichem Rühren etwa 10-12 Minuten goldbraun und durchgegart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Yangnyeom-Sauce über das gegarte Hähnchen und vermenge alles, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate alles bei starker Hitze weitere 2-3 Minuten unter ständigem Rühren, bis die Sauce eindickt und leicht karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte das Hähnchen auf Serviertellern an und garniere es mit Sesam und geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
