      "steps": [
        {
          "position": 0,
          "text": "Öl in einem mittelgroßen Topf erhitzen. Zwiebel und Ingwer hineingeben und einige Minuten weich garen. Currypaste einrühren und 1 Minute weitergaren. Gehackte Tomaten und Kokoscreme angießen. Zum Kochen bringen und 5 Minuten köcheln lassen. Wenn die Mischung zu dick wird, etwas kochendes Wasser hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Garnelen hineingeben und je nach Größe weitere 5–10 Minuten garen. Mit etwas einfachem Reis servieren und nach Wunsch mit gehacktem Koriander bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
