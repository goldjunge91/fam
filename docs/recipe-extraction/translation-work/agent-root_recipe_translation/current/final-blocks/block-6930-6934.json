      "steps": [
        {
          "position": 0,
          "text": "Rinderdarm 15 Minuten in warmem Wasser einweichen, dann innen und außen vorsichtig abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel fein würfeln und im Rinderfett bei mittlerer Hitze goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Semmelbrösel, Paprika, Salz, Pfeffer und Knoblauchpulver in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gekochte Zwiebeln und Fett unter die Semmelbröselmischung rühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Masse mit einem Spritzbeutel oder Trichter in die Hülle füllen und an jedem Ende 1 Zoll frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Binden Sie die Hüllenenden mit Küchengarn zusammen und stechen Sie sie mit einer Gabel ein, damit sie nicht platzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einen Topf mit Rinderbrühe und gewürfelten Karotten geben, zum Kochen bringen und dann 1 Stunde köcheln lassen, bis die Masse fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Etwas abkühlen lassen, in Portionsstücke schneiden und heiß mit Bratensaft servieren.",
