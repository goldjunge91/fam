      "steps": [
        {
          "position": 0,
          "text": "Den Hering aus dem Glas abtropfen lassen und unter kaltem Wasser abspülen, um überschüssigen Essig zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Zwiebel in dünne Scheiben schneiden und den Apfel schälen und in kleine Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sauerrahm, Zucker, Dill und Pfeffer in einer mittelgroßen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hering, Zwiebel und Apfel in einen Glasbehälter schichten und Sahnesoße darübergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vorsichtig umrühren und den Behälter mit Plastikfolie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mindestens 4 Stunden oder über Nacht im Kühlschrank lagern, damit sich die Aromen vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekühlt auf Roggenbrot mit eingelegten Gurken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
