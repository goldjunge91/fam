      ],
      "steps": [
        {
          "position": 0,
          "text": "Koche Hähnchenbrüste in 2 cups Brühe mit der Hälfte der Zwiebel 20 Minuten, bis sie gar sind. Bewahre die Brühe auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste getrocknete Ancho- und Guajillo-Chilischoten 1 Minute pro Seite in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche die gerösteten Chilischoten 15 Minuten in heißem Wasser ein und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere die eingeweichten Chilischoten mit Tomaten, Knoblauch, Mandeln, der restlichen Zwiebel und 1 cup Brühe vollständig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seihe die Sauce durch ein feinmaschiges Sieb und drücke die festen Bestandteile mit einem Löffel aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem großen Topf, gib die abgesiebte Sauce dazu und gare sie unter ständigem Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die aufbewahrte Hühnerbrühe und die übrige 1 cup frische Brühe dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib zerpflücktes Hähnchen dazu und lasse alles 10 Minuten köcheln. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere es mit Reis und warmen Maistortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
