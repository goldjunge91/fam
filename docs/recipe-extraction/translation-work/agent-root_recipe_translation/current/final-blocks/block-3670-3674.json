      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 8x8 inch große Backform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Kokosmilch, Eier, Zucker und Vanilleextrakt in einem Mixer glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Mehl, Speisestärke und Salz zur flüssigen Mischung und mixe, bis keine Klümpchen mehr da sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig auf Schüsseln auf und färbe jede mit einer anderen Lebensmittelfarbe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die erste farbige Schicht in die Backform und backe sie 5-7 Minuten, bis sie fest, aber nicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die nächste farbige Schicht darauf und backe sie weitere 5-7 Minuten. Wiederhole dies mit den übrigen Farben, bis der gesamte Teig aufgebraucht und geschichtet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sobald die letzte Schicht fest ist, backe den gesamten Kuchen weitere 10 Minuten, bis er fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse ihn in der Form vollständig abkühlen, schneide ihn in Quadrate und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
