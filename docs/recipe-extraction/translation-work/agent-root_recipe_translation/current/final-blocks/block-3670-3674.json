      ],
      "steps": [
        {
          "position": 0,
          "text": "Schneide Hähnchenbrüste in mundgerechte Stücke und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze und bräune die Hähnchenstücke 4-5 Minuten an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste in derselben Pfanne gewürfelte Zwiebel und Knoblauch etwa 2 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere Kürbiskerne, Serrano-Chilischoten, Tomatillos, Koriander und Brühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Kernmischung in die Pfanne und gare sie unter ständigem Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Hähnchen und die restliche Brühe zurück in die Pfanne und lasse alles 15-20 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und würze es mit Salz und Pfeffer nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß mit Reis oder warmen Tortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
