      "steps": [
        {
          "position": 0,
          "text": "Schäle Süßkartoffeln und schneide sie in 1-inch große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser in einem großen Topf zum Kochen, gib Süßkartoffeln dazu und koche sie 15 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Kartoffeln ab und gib sie bei mittlerer Hitze zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib braunen Zucker, Butter, Zimt, Nelken und Salz dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerdrücke oder püriere alles bis zur gewünschten Konsistenz und rühre dabei 10 Minuten häufig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Vanilleextrakt dazu und rühre, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Masse in eine Servierschüssel oder schneide sie nach dem Abkühlen in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
