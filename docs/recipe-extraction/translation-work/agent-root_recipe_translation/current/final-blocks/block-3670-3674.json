      "steps": [
        {
          "position": 0,
          "text": "Falls du ungepufften Amaranth verwendest, röste ihn portionsweise 2-3 Minuten in einer trockenen Pfanne bei mittlerer Hitze. Schüttle die Pfanne häufig, bis die Körner aufpoppen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Sesam 2 Minuten in einer trockenen Pfanne, bis er duftet, und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Piloncillo, Honig und Butter in einem Topf bei mittlerer Hitze und rühre, bis alles geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Zuckermischung 3-4 Minuten, bis sie die Weichkugelstufe erreicht (240°F auf einem Zuckerthermometer).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd und rühre Vanille und Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib rasch gepufften Amaranth und Sesam dazu und rühre, bis alles überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verstreiche die Mischung auf Backpapier und lasse sie 10 Minuten abkühlen und fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide sie in Quadrate oder brich sie in Stücke und bewahre sie in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
