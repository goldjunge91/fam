      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer Pfanne und brate gewürfeltes Hähnchen unter Rühren etwa 3 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zwiebel und Karotten dazu und gare sie 2 Minuten. Füge dann Erbsen hinzu und gare alles 1 Minute weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Reis, Ketchup und Sojasoße ein, löse Klumpen und erhitze alles etwa 2 Minuten. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den Bratreis auf zwei Tellern und forme Hügel daraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze 1 Esslöffel Butter in einer beschichteten Pfanne bei mittlerer Hitze. Verquirle 2 Eier mit einem Schuss Wasser und gieße sie in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald die Eier oben gerade gestockt, aber noch leicht flüssig sind, schiebe sie vorsichtig auf einen Reisberg und klappe sie um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole Schritt 5-6 mit der restlichen Butter und den Eiern für die zweite Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verziere jedes Omurice mit Ketchup und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
