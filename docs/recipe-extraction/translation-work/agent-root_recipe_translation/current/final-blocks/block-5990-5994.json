      "steps": [
        {
          "position": 0,
          "text": "Löse Hefe und Zucker in warmem Wasser auf. Lasse die Mischung 5 Minuten stehen, bis sie schäumt, und verknete sie dann mit Mehl und Salz zu einem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 10 Minuten glatt, decke ihn ab und lasse ihn 45 Minuten gehen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Hühnerbrühe und löse die Gelatine darin auf. Vermische sie mit Schweinehack, Sojasoße, Sesamöl und Frühlingszwiebeln. Stelle die Mischung kalt, bis sie geliert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 12 gleich große Stücke und rolle jedes zu einem dünnen Kreis von etwa 3 Zoll Breite aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1 tbsp Schweinefleisch-Gelee-Füllung in die Mitte jedes Kreises und falte die Ränder zu einem Beutel zusammen. Kräusle den Teig dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Bao mit der Naht nach oben auf Backpapierquadrate und lasse sie 15 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer Hitze. Lege die Bao mit der flachen Seite nach unten hinein und brate sie 3-4 Minuten, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
