      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Wasser und Salz zu einem Teig. Knete ihn etwa 8 Minuten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn 30 Minuten ruhen. Teile ihn dann in 16 gleich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Hackfleisch mit gehackter Zwiebel, Knoblauch, Ingwer, Sojasoße, Sesamöl und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle jedes Teigstück zu einem dünnen Kreis aus. Gib 1 tbsp Füllung in die Mitte, klappe den Teig halbmondförmig zusammen und falte die Ränder zum Verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Momos portionsweise mit der flachen Seite nach unten 3-4 Minuten goldbraun an. Wende sie und gare sie weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit einer Dipsoße aus Sojasoße, gehacktem Ingwer und Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
