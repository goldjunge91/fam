      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle die Eier, bis sie gar sind. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl dazu und brate gewürfeltes Hähnchen etwa 4 Minuten unter Rühren durch. Nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib bei Bedarf mehr Öl dazu und brate Knoblauch und Zwiebel 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib kalten Reis dazu, löse Klumpen und brate ihn 2 Minuten unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Hähnchen und Eier zurück in die Pfanne. Rühre Fischsoße, Sojasoße und Chiliflocken ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schwenke alles 1 Minute, bis es vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Pfanne vom Herd und rühre kurz vor dem Servieren frisches Basilikum ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
