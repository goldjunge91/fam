      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl, Joghurt und Salz zu einem festen Teig. Knete ihn gut durch und teile ihn in 4 gleich große Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und rolle jede Kugel direkt über dem Wasser zu einer langen zylindrischen Form (Gatte).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche die Gatte 8-10 Minuten, bis sie an die Oberfläche steigen. Gieße sie ab und lasse sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die abgekühlten Gatte in 1 Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer Pfanne, gib Kreuzkümmelsamen hinein und röste sie, bis sie aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Ingwer-Knoblauch-Paste und Zwiebeln hinzu und dünste alles goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge Tomaten, Chilipulver und Kurkuma hinzu und gare sie, bis die Tomaten zu einer Paste zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Gatte-Stücke und 1 Tasse Wasser dazu und lasse alles 8-10 Minuten köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Garniere mit frischem Koriander und serviere heiß mit Bajra-Roti.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
