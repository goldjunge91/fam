      "steps": [
        {
          "position": 0,
          "text": "Vermische Lammhackfleisch mit der Hälfte der Zwiebel, Ingwer, Knoblauch und Chilipulver, bis alles gut verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme daraus 8 leicht flachgedrückte ovale Bratlinge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne und brate die übrigen Zwiebeln goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kreuzkümmelpulver dazu und röste es 30 Sekunden, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Joghurt hinzu, rühre gut um und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Fleischbratlinge vorsichtig in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Wasser dazu und bringe alles zum Kochen. Reduziere die Hitze, decke die Pfanne ab und lasse es 25 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wende die Bratlinge nach der Hälfte der Garzeit vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Würze mit Salz und serviere das Gericht heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
