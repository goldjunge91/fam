          "position": 0,
          "text": "Schäle die Kartoffeln und stich sie mehrmals mit einer Gabel ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Topf mit schwerem Boden und gib Kreuzkümmelsamen und Lorbeerblätter hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib pürierte Zwiebel dazu und gare sie 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge Ingwer und Knoblauch hinzu und gare alles 2 Minuten, bis es duftet.",
