      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete rote Chilischoten 15 Minuten in warmem Wasser ein. Püriere sie anschließend mit 2 Esslöffeln Wasser zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Topf mit schwerem Boden, gib Kreuzkümmelsamen hinein und röste sie, bis sie aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Zwiebeln hinzu und brate sie etwa 8 Minuten tief goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge Ingwer-Knoblauch-Paste hinzu und gare sie 2 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Fleischstücke dazu und brate sie bei hoher Hitze 5 Minuten unter gelegentlichem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Joghurt, Chilipaste, Korianderpulver und Kurkuma ein und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Wasser und Salz dazu, bringe alles zum Kochen, reduziere die Hitze und decke den Topf ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse alles 45-50 Minuten köcheln, bis das Fleisch sehr zart und die Sauce dick und dunkelrot ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere heiß mit Bajra-Roti oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
