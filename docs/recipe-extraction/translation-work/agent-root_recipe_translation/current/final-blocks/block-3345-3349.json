      "steps": [
        {
          "position": 0,
          "text": "Weiche Mung-Dal und Reis zusammen 3-4 Stunden in Wasser ein und gieße sie dann vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Dal und Reis mit wenig Wasser im Mixer zu einem leicht groben Teig und gib nach und nach Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Teig in eine Schüssel und rühre grüne Chili, Ingwer, Zwiebel, Kreuzkümmelsamen und Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Teig 5-10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer beschichteten Pfanne oder Dosa-Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße 0.5 Tasse Teig in die heiße Pfanne und verstreiche ihn vorsichtig rund, etwa 0.25 Zoll dick.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Fladen 3-4 Minuten goldbraun, wende ihn vorsichtig und backe die andere Seite weitere 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege ihn auf einen Teller und serviere ihn heiß mit Kokos- oder Tamarinden-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
