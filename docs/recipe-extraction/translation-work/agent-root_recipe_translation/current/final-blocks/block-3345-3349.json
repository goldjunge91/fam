      "steps": [
        {
          "position": 0,
          "text": "Spüle Reis und Schälerbsen getrennt unter kaltem Wasser, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einem großen Topf, gib Kreuzkümmelsamen und Pfefferkörner hinzu und rühre 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Cashews hinzu und röste sie etwa 1 Minute goldbraun. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib im selben Topf Ingwer und grüne Chili hinzu und dünste alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Reis und Schälerbsen hinein und rühre 2-3 Minuten ständig, damit sie mit Ghee überzogen werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße 4 Tassen Wasser hinzu, salze und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 15-18 Minuten köcheln, bis Reis und Dal weich sind und das Wasser aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre die gerösteten Cashews ein und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
