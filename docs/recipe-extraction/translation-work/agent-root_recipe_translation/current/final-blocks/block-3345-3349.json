      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Rindfleischwürfel 3 Minuten in kochendem Wasser, gieße sie ab und spüle sie unter kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und brate Ingwerscheiben, Knoblauch und getrocknete Chilis 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Doubanjiang hinzu und brate es 1 Minute unter Rühren, gib dann das Rindfleisch dazu und brate weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe hinzu, gib Sternanis, Zimtstange, Lorbeerblätter und Kandiszucker dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 60 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Sojasauce hinzu, probiere und passe die Würzung nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Eiernudeln separat in kochendem Wasser nach Packungsanweisung und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Nudeln auf Schalen, schöpfe Rindfleisch und Brühe darüber und garniere mit Frühlingszwiebeln und etwas Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
