      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mehl, Speisestärke und Wasser in einer kleinen Schüssel zu einer glatten Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Öl in einer großen beschichteten Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Austern hinzu und brate sie 1 Minute an, schiebe sie dann an den Pfannenrand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl in die Pfanne, füge gehackten Knoblauch hinzu und dünste ihn 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Mehlmischung gleichmäßig über Austern und Pfanne und verteile die Austern darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Eier mit Salz und weißem Pfeffer und gieße sie über die Mischung. Gare sie ohne Rühren 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn der Boden stockt, schiebe das gegarte Ei zur Mitte und neige die Pfanne, damit flüssiges Ei an die Ränder läuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sobald das Omelett größtenteils gestockt ist, klappe es zusammen, gare es 1 weitere Minute und lege es dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Beträufle es mit Sojasauce und Sesamöl, garniere es vor dem Servieren mit Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
