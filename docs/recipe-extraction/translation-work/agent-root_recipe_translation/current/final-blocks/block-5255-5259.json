      "steps": [
        {
          "position": 0,
          "text": "Lege die Hähnchenbrust zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 1/2 Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, Salz und Pfeffer, eine mit verquirltem Ei und eine mit Panko-Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jede Hähnchenbrust zuerst im Mehl, dann im Ei und anschließend im Panko. Drücke die Panade leicht an, damit sie haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Dutch Oven auf 350°F und gib das panierte Hähnchen vorsichtig in das heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere es 6-8 Minuten pro Seite goldbraun, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen heraus und lass es auf einem mit Küchenpapier ausgelegten Teller abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Röste die Brioche-Brötchen und bestreiche sie mit Mayonnaise. Belege sie dann mit Salat, Hähnchen, Tomate und eingelegter Mango.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
