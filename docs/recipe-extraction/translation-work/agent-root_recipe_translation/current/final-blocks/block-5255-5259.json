          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerteile den gegrillten Fisch mit einer Gabel in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Tortillas mit geraspeltem Kohl, Fisch, Avocado, Koriander und Salsa.",
