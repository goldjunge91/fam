      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenschenkel in mundgerechte Stücke und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittelhoher Hitze und brate das Hähnchen portionsweise insgesamt etwa 12-15 Minuten goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Hähnchen aus der Pfanne und stelle es beiseite. Reduziere die Hitze auf mittlere Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Butter in die Pfanne und brate Knoblauch und Ingwer etwa 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in die Pfanne und rühre Sojasauce, Honig und Sesamöl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche alles 3-5 Minuten unter gelegentlichem Rühren, bis die Sauce eindickt und das Hähnchen überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit Frühlingszwiebeln und Sesam und serviere es mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
