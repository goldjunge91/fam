      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste die gewürfelte Zwiebel etwa 5 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Ingwer hinzu und rühre 1 Minute ständig um, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre das Currypulver ein und röste die Gewürze noch eine Minute unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die abgetropften Kichererbsen, die Dosentomaten samt Saft, Kokosmilch und Gemüsebrühe in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe die Mischung zum Köcheln und lasse sie 15 Minuten unter gelegentlichem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre den frischen Spinat ein und gare ihn etwa 2 Minuten, bis er zusammenfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere das Curry heiß mit Reis oder Naan-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
