    {
      "externalId": "waivy:mfr-chn-mapo-tofu",
      "slug": "mfr-chn-mapo-tofu",
      "title": "Mapo Tofu",
      "instructions": "Sichuans berühmtestes Gericht: Seidentofu in einer prickelnd scharfen Sauce aus Doubanjiang (fermentierter Chilipaste mit Bohnen), Schweinehackfleisch, Knoblauch, Ingwer und Sichuanpfeffer – zugleich betäubend, scharf, herzhaft und seidig. Eines der besten Gerichte der Welt.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Seidentofu ist eine der günstigsten eiweißreichen Zutaten und passt perfekt zu diesem Gericht.",
        "Chili-Knoblauch-Sauce von Huy Fong kostet $3 und reicht für mehr als 10 Portionen Mapo Tofu.",
        "Das Gericht ist in 25 Minuten fertig und kostet $2 pro Person."
      ],
      "substitutions": [
        {
          "forIngredientId": "chili-garlic-sauce",
          "swap": "Doubanjiang (scharfe Bohnenpaste) für die authentische Sichuan-Variante"
        },
        {
          "forIngredientId": "cornstarch",
          "swap": "Weglassen oder 1 EL Mehl verwenden – die Sauce wird dann etwas dünner"
        }
      ],
