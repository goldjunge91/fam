      "steps": [
        {
          "position": 0,
          "text": "Ritze die Fischfilets ein und fülle die Schnitte mit Ingwerstreifen. Dämpfe den Fisch bei hoher Hitze 8–10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide währenddessen den übrigen Ingwer und die Frühlingszwiebel in feine Streifen und verteile sie auf dem Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasauce und Sesamöl und gieße die Mischung über den Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Pflanzenöl, bis es raucht, und gieße es über Fisch, Ingwer und Frühlingszwiebel, sodass es zischt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere den Fisch sofort mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
