      "steps": [
        {
          "position": 0,
          "text": "Brate Chili-Knoblauch-Sauce und den Doubanjiang-Ersatz (Chili-Knoblauch-Sauce mit Miso) 2 Minuten in Öl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch und Ingwer dazu und gare alles 30 Sekunden. Füge Schweinehackfleisch oder zerkrümelten festen Tofu hinzu und brate ihn gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Brühe dazu und bringe sie zum Kochen. Lege gewürfelten Seidentofu vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre 1 TL Speisestärke mit 2 EL Wasser zu einer glatten Mischung und rühre sie zum Andicken der Sauce ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verfeinere das Gericht mit Sesamöl und Frühlingszwiebel und serviere es auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
