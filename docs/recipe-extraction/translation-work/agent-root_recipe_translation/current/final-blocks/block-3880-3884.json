      ],
      "steps": [
        {
          "position": 0,
          "text": "Bräune Rindfleischwürfel 5-6 Minuten in einem großen Topf bei mittelhoher Hitze rundherum an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebeln im selben Topf 3 Minuten weich. Gib gehackten Knoblauch hinzu und gare ihn 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Rindfleisch zurück in den Topf und füge Rinderbrühe hinzu. Bringe alles zum Kochen und reduziere dann die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und lasse alles 35-40 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Bohnen aus der Dose ab und spüle sie ab (oder weiche getrocknete Bohnen 8 Stunden ein und koche sie separat weich) und gib sie in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles ohne Deckel weitere 10 Minuten köcheln, rühre frischen Koriander ein und schmecke die Würzung ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß als dickflüssigen Eintopf in Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
