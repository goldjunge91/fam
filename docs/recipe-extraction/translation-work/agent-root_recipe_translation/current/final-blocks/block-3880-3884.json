      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib warmes Wasser und Öl zum Mehl und rühre, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig auf einer bemehlten Fläche 8-10 Minuten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 3 Kugeln, bestreiche sie leicht mit Öl, decke sie mit einem Tuch ab und lasse sie 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine gusseiserne Pfanne oder Grillplatte bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle jede Teigkugel auf einer bemehlten Fläche zu einem dünnen, gleichmäßigen Fladen von etwa 0.1 Zoll Dicke aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege den Fladen vorsichtig in die heiße Pfanne und backe ihn je Seite 2-3 Minuten, bis er leicht goldbraun ist und stellenweise Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche beide Seiten noch warm leicht mit geschmolzener Butter und staple die Fladen auf einem Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
