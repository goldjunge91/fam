      "steps": [
        {
          "position": 0,
          "text": "Koche ungeschälte Rote Bete 20-25 Minuten in Salzwasser, bis sie mit einer Gabel weich sind. Gieße sie ab und lasse sie leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die abgekühlten Rüben und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste Walnüsse 2 Minuten in einer trockenen Pfanne und mahle oder hacke sie dann mit gehacktem Knoblauch zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Walnuss-Knoblauch-Paste mit Weißweinessig, Salz, Pfeffer, Wasser und Koriander in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Rote-Bete-Stücke zur Mischung und rühre, bis alles vollständig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse das Gericht vor dem Servieren 10 Minuten ziehen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
