      "steps": [
        {
          "position": 0,
          "text": "Verquirle Milch, Eier, Zucker und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Mehl hinzu und verquirle es zu einem glatten, dünnflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer 10 Zoll großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 1/4 Tasse Teig in die Mitte und neige die Pfanne, damit sich der Teig dünn kreisförmig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Pfannkuchen 1-2 Minuten, bis die Unterseite hellgolden ist. Wende ihn und backe die andere Seite weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege ihn auf einen Teller und wiederhole den Vorgang mit dem restlichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche jeden Pfannkuchen mit Butter und Honig, klappe ihn zusammen und serviere ihn warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
