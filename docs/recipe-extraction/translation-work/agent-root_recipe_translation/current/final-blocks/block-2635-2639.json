      "steps": [
        {
          "position": 0,
          "text": "Mandelmehl, 2 tablespoons Honig, Zimt und Orangenschale in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter schmelzen und ein Filoteigblatt damit bestreichen; 2 weitere Blätter mit Butter dazwischen darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Drittel der Mandelmischung am Rand verteilen und den Teig fest wie eine Rolle aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Rolle zu einer Spirale drehen und auf ein Backblech legen; mit dem übrigen Filoteig und der Füllung wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das ganze Gebäck mit verquirltem Ei bestreichen und bei 375°F 25 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das warme Gebäck vor dem Servieren mit dem restlichen Honig beträufeln und mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
