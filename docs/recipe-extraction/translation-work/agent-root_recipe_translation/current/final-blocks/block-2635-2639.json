      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Schälerbsen abspülen und mit 4 cups Wasser in einen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Aufkochen, dann die Hitze reduzieren und 20 Minuten köcheln lassen, bis die Erbsen sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch hacken und zusammen mit Kreuzkümmel und Paprikapulver zu den Erbsen geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weitere 3 Minuten köcheln lassen, dann mit einem Stabmixer glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Olivenöl darüberträufeln, mit Salz, Pfeffer und Petersilie bestreuen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
