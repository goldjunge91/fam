      "steps": [
        {
          "position": 0,
          "text": "Auberginen in 1/2-inch-Würfel schneiden, in ein Sieb geben, mit Salz bestreuen und 10 Minuten abtropfen lassen, damit bittere Flüssigkeit austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Auberginenwürfel mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer großen Pfanne bei mittelhoher Hitze erhitzen und Auberginen 8-10 Minuten weich und leicht gebräunt anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Tomaten, Kreuzkümmel und Paprikapulver in die Pfanne geben und 8-10 Minuten unter gelegentlichem Rühren garen, bis die Tomaten zerfallen und eine Sauce bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frischen Koriander und Petersilie einrühren, probieren und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 2 Minuten garen, dann in eine Servierschüssel geben und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm oder bei Raumtemperatur mit Pitabrot und Oliven servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
