      "steps": [
        {
          "position": 0,
          "text": "Bei frischen Weinblättern diese 2 Minuten in kochendem Wasser blanchieren und abgießen; Weinblätter aus dem Glas gut abspülen und abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch, gekochten Reis, gehackte Zwiebel, Minze, Petersilie, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Weinblatt mit der glänzenden Seite nach unten auf eine Fläche legen und 1 tbsp Füllung nahe am Blattansatz platzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den unteren Teil des Blatts über die Füllung falten, die Seiten einschlagen und das Blatt dann fest zur Spitze hin aufrollen, sodass eine Rolle entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Topfboden mit zusätzlichen Weinblättern auslegen und die gerollten Dolmas mit der Naht nach unten schichtweise darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tomatensauce, Zitronensaft und 1 cup Wasser über die Dolmas gießen, mit Olivenöl beträufeln und einen Teller darauflegen, damit sie zusammengedrückt bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Aufkochen, dann abdecken, die Hitze reduzieren und 40 Minuten köcheln lassen, bis sich die Aromen verbunden haben und die Flüssigkeit etwas eingekocht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm oder bei Raumtemperatur mit Joghurt als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
