      ],
      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 180 °C vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Karotten, Zwiebel, Knoblauch, Kreuzkümmelsamen, Koriandersamen, Salz und Olivenöl in einer Schüssel vermengen. Auf ein Backblech geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backblech in den vorgeheizten Ofen schieben und 10–12 Minuten rösten oder bis die Karotten weich sind. Vom Herd nehmen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gebackene Karottenmischung mit etwas Wasser zu einer glatten Paste pürieren und in eine Schüssel abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Karottenmischung in einer beschichteten Pfanne erhitzen. Zwei Tassen Wasser dazugeben und zum Kochen bringen. Garam Masala dazugeben und verrühren. Salz dazugeben und gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen, Zitronensaft dazugeben und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
