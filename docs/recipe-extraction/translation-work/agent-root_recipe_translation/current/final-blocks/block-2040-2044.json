            },
            {
              "key": "bd2e5114-a643-5dc0-af17-ff7c9e31225f",
              "ingredientName": "Olivenöl",
              "grams": 7.5,
              "quantity": 7.5,
              "unit": "g",
              "position": 6,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln in 3–4 Esslöffeln Olivenöl anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleischwürfel oder Hähnchenschnitzel dazugeben und auf jeder Seite 3–4 Minuten scharf anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 Liter Wasser oder so viel dazugeben, dass das Fleisch gerade bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bei mittlerer Hitze garen, bis das Fleisch durch ist (ich mache das normalerweise im Schnellkochtopf und lasse es 5 Minuten unter Druck garen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gefrorene Molokhia dazugeben und umrühren, bis sie vollständig aufgetaut ist und die Mischung anschließend aufkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einer anderen Pfanne 1/4 bis 1/2 Tasse Olivenöl und die Knoblauchzehen bei mittelniedriger Hitze erhitzen, bis der Knoblauch duftet (nicht bräunen, sonst wird er bitter).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl und Knoblauch zur Molokhia geben, Hitze reduzieren und 5–10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nach Geschmack salzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit reichlich Zitronensaft servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Mit etwas Kurzkornreis oder Pitabrot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
