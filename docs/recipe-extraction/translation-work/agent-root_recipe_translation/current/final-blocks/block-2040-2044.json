      ],
      "steps": [
        {
          "position": 0,
          "text": "1. Kürbis schälen und die inneren Kerne entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2. Fruchtfleisch in 2 cm große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "3. Orangenschale mit möglichst wenig weißer Haut abreiben und in streichholzgroße Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "4. Saft aus den Orangen pressen. Kardamomkapseln öffnen, Samen herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "5. Kürbis, Orangensaft, Orangenstreifen, Zucker und ganze Kardamomsamen in einen großen Topf geben, gut vermengen und etwa 10 Stunden oder über Nacht marinieren lassen. Gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "6. Mischung zum Kochen bringen, dann Hitze reduzieren und köcheln lassen, bis die Flüssigkeit eingedickt und sirupartig ist. Das kann etwa eine Stunde oder etwas länger dauern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abkühlen lassen, dann in saubere, trockene Gläser füllen. Genießen!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
