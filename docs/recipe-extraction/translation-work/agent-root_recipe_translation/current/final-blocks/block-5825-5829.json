      "steps": [
        {
          "position": 0,
          "text": "Cut Schweinefleisch belly into 1.5-inch cubes und blanch in boiling Wasser für 5 Minuten, then drain und pat dry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in a heavy Topf over mittlerer-hoher Erhitze und brown Schweinefleisch cubes on all sides für 8 Minuten total.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib ginger slices, Knoblauch cloves, und star anise, stirring für 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Deglaze Pfanne mit Shaoxing wine, scraping up browned bits, und let köcheln für 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib soy Sauce, rock Zucker, und Wasser, then bring to a boil.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduce Erhitze to niedriger, cover partially, und köcheln für 60 Minuten bis Schweinefleisch is very tender.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Uncover und increase Erhitze to mittlerer, simmering für 10 more Minuten to reduce und andicken Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere in bowls mit Sauce, garnished mit sliced scallion und steamed Reis on the Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
