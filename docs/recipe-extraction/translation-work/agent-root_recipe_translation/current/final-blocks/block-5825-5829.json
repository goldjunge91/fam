      "steps": [
        {
          "position": 0,
          "text": "Mince Knoblauch und Schneide red bell Pfeffer und Zwiebel into bite-sized pieces.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in a large wok or skillet over hoher Erhitze bis just smoking.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib minced Knoblauch und sliced chili und Koche für 20 Sekunden bis fragrant.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gemahlen Schweinefleisch und break apart mit a spatula, cooking für 4-5 Minuten bis cooked through.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib bell Pfeffer und Zwiebel, then vermische everything together und Koche für 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pour in soy Sauce, oyster Sauce, fish Sauce, und Wasser, stirring constantly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib cashews und vermische everything together für 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Taste und adjust seasoning if needed, then Serviere immediately over steamed jasmine Reis.",
          "timerMinutes": null,
