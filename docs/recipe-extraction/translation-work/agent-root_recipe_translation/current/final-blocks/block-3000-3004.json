      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und bestäube ein Backblech leicht mit Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Natron, Salz und nach Wunsch Kümmel in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Buttermilch dazu und hebe sie vorsichtig mit einem Teigschaber unter, bis ein grober Teig entsteht. Hebe nach Wunsch Rosinen unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Teig auf eine bemehlte Fläche, forme einen runden Laib und lege ihn auf das vorbereitete Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide mit einem scharfen Messer ein tiefes X in die Oberseite des Laibs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe das Brot 35-40 Minuten, bis es goldbraun ist und beim Klopfen auf die Unterseite hohl klingt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse es vor dem Schneiden 10 Minuten auf einem Gitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
