      "steps": [
        {
          "position": 0,
          "text": "Reibe rohe Kartoffeln und drücke überschüssige Flüssigkeit mit einem sauberen Küchentuch oder Käsetuch aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Backpulver, Salz und Pfeffer in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle in einer anderen Schüssel Eier und Milch und gib dann die geriebenen Kartoffeln dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe die feuchten Zutaten unter die Mehlmischung, bis alles gerade vermengt ist. Der Teig bleibt dick.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Butter auf einer Grillplatte oder in einer großen Pfanne bei mittelhoher Hitze, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 3-inch große Portionen Teig auf die Grillplatte und drücke sie mit einem Pfannenwender leicht flach. Gare sie 3-4 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit Butter, Marmelade oder saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
