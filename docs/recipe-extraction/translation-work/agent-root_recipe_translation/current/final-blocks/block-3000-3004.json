      "steps": [
        {
          "position": 0,
          "text": "Koche geviertelte Kartoffeln 15-18 Minuten in Salzwasser, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare in einem separaten Topf geraspelten Kohl mit 2 EL Butter bei mittlerer Hitze etwa 8 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Kartoffeln gründlich ab und stampfe sie mit den übrigen 2 EL Butter und Milch glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe gekochten Kohl und gehackte Frühlingszwiebeln unter das Kartoffelpüree.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze großzügig mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere das Gericht heiß. Nach Wunsch kannst du in der Mitte eine Mulde formen und für mehr Geschmack ein Stück Butter hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
