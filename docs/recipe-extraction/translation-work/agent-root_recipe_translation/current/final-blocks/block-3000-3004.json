      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig zu: Arbeite kalte Butter in Mehl und Salz ein, bis die Mischung Semmelbröseln ähnelt. Gib nach und nach Wasser dazu, forme einen Teig und stelle ihn 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Rinderhackfleisch und gewürfelte Zwiebel in einer Pfanne an, gieße Fett ab, gib Rinderbrühe dazu und lasse alles 15 Minuten köcheln. Würze mit Salz und Pfeffer und lasse die Füllung abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche Kartoffeln 15-18 Minuten in Salzwasser weich und stampfe sie dann mit 2 EL Butter und Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig aus, kleide eine 9-inch-Pastetenform damit aus, fülle die Fleischmischung hinein, lege einen Teigdeckel darauf, drücke die Ränder zu und schneide Dampfschlitze hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Pastete bei 375°F 35-40 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie vor dem Anschneiden 10 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Pastete mit cremigem Kartoffelpüree.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
