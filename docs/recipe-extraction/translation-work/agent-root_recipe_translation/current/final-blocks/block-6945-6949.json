      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und tupfen Sie die Putenkeulen mit Papiertüchern trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischen Sie braunen Zucker, Paprika, Knoblauchpulver und schwarzen Pfeffer zu einer trockenen Einreibung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tragen Sie die Gewürzmischung großzügig auf alle Seiten der Putenkeulen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Legen Sie die Putenkeulen mit der Hautseite nach oben auf ein mit Folie ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "45 Minuten bei 350 °F backen, bis die Haut anfängt zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Während die Putenkeulen kochen, Ketchup, Apfelessig, Melasse und Worcestershire-Sauce in einem Topf vermischen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Putenkeulen mit der Barbecuesauce bestreichen und weitere 30 Minuten backen, dabei alle 10 Minuten mit der Sauce bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen und 5 Minuten ruhen lassen, bevor es mit zusätzlicher Soße serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
