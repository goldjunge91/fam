      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 325 °F vor und nehmen Sie den Truthahn 1 Stunde vor dem Garen aus dem Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Truthahn innen und außen mit Papiertüchern trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche Butter mit gehacktem Salbei, gehacktem Knoblauch, Salz und schwarzem Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reiben Sie die Buttermischung unter und über die Putenhaut und achten Sie darauf, dass sie so weit wie möglich unter die Brusthaut gelangt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Hohlraum mit Thymianzweigen, Zwiebelvierteln und der ganzen Zitrone füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Legen Sie den Truthahn mit der Brustseite nach oben auf einen Bräter in einer Bratpfanne und gießen Sie Hühnerbrühe auf den Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ungefähr 3 Stunden lang rösten und alle 30 Minuten mit Bratenfett begießen, bis die Innentemperatur des Oberschenkels 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen und 20 Minuten ruhen lassen, bevor es angeschnitten und serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
