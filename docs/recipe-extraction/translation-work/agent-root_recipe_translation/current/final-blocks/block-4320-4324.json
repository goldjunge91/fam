      "steps": [
        {
          "position": 0,
          "text": "Erhitze Pflanzenöl in einem schweren Topf oder einer Fritteuse auf 375°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Maisstärke, Backpulver, Salz und schwarzen Pfeffer in einer flachen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Ei und Milch in einer weiteren Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Muscheln mit Küchenpapier trocken. Tauche sie in die Eiermischung und wende sie dann in der Mehlmischung. Schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Muscheln portionsweise pro Seite 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie sofort mit Zitronenspalten und Remoulade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
