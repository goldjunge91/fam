      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche den gesalzenen Kabeljau 24 Stunden in kaltem Wasser ein und wechsle das Wasser alle 6 Stunden. Koche ihn anschließend 20 Minuten in frischem Wasser, bis er zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Kartoffeln, bis sie mit einer Gabel leicht einzustechen sind. Schäle sie und zerstampfe sie in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerpflücke den gekochten Kabeljau in kleine Stücke und entferne Gräten. Vermische ihn mit Kartoffelpüree und fein gewürfelter Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre das verquirlte Ei unter und würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme die Mischung zu Frikadellen von etwa 2 Zoll Breite und 0.5 Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle eine Panierstation mit Mehl, verquirltem Ei und Semmelbröseln in getrennten flachen Schüsseln bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende jede Frikadelle in Mehl, dann Ei und Semmelbröseln. Drücke die Panade vorsichtig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne auf 350°F und brate die Küchlein pro Seite 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Remoulade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
