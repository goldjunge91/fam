      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme eine Mulde und gib Wasser und Pflanzenöl hinein. Verrühre alles zu einem festen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig 2 Minuten auf einer bemehlten Fläche und rolle ihn dann 0.125-Zoll dick aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide den Teig mit einem Messer oder Ausstecher in kleine mundgerechte Quadrate oder Kreise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Cracker auf ein mit Backpapier ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche sie leicht mit Olivenöl und streue Meersalz darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 400°F 12-15 Minuten, bis sie hellgoldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf einem Kuchengitter abkühlen und serviere sie zu Meeresfrüchte-Chowder oder Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
