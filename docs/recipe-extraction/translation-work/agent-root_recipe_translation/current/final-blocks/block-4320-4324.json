      "steps": [
        {
          "position": 0,
          "text": "Fülle einen großen Topf mit Wasser und gib Salz, Thymian und Lorbeerblatt hinzu. Bringe das Wasser sprudelnd zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Hummer vorsichtig mit dem Kopf voran in das kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Topf ab und bringe das Wasser erneut zum Kochen. Reduziere dann die Hitze leicht und dämpfe 15-18 Minuten lang, bei Hummern mit einem Gewicht von 1.25-1.5 Pfund.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Hummer mit einer Zange heraus und lasse sie auf einem Schneidebrett 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmilz Butter mit Zitronensaft und schwarzem Pfeffer in einem kleinen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Halbiere die Hummer längs und entferne die dunkle Ader, die am Schwanz entlangläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit warmer zerlassener Butter zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
