      "steps": [
        {
          "position": 0,
          "text": "Eier in einem Topf mit Wasser 10 Minuten lang hart kochen, dann abkühlen lassen und schälen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel würfeln und in Hühnerfett bei mittlerer Hitze ca. 8 Minuten lang karamellisieren lassen, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie die Hühnerleber in dieselbe Pfanne und kochen Sie sie bei mittlerer bis hoher Hitze etwa 4 bis 5 Minuten lang, bis sie innen nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gekühlte Leber, hartgekochte Eier und karamellisierte Zwiebeln in eine Küchenmaschine geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pulsieren, bis es gehackt, aber nicht ganz glatt ist, so dass eine rustikale Textur erhalten bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit koscherem Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei Zimmertemperatur auf Matzencrackern oder Roggenbrot als Vorspeise oder Aufstrich servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
