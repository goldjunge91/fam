    {
      "externalId": "waivy:mfr-chinese-steamed-fish",
      "slug": "mfr-chinese-steamed-fish",
      "title": "Chinesischer gedämpfter Fisch mit Ingwer und Frühlingszwiebeln",
      "instructions": "Tilapia oder Wolfsbarsch im Ganzen dämpfen, bis das Fleisch zart auseinanderfällt, und mit heißer Sojasauce sowie Ingwer-Frühlingszwiebel-Öl übergießen. Eine der reinsten Techniken der chinesischen Fischküche.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 12,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Tilapia gehört zu den günstigsten Weißfischen und eignet sich perfekt zum chinesischen Dämpfen.",
        "Das heiße Öl, das über den Frühlingszwiebeln zischt, ist die klassische Technik. So entfalten die Aromaten ihren Geschmack."
      ],
      "substitutions": [
        {
          "forIngredientId": "tilapia",
          "swap": "Wolfsbarsch, Kabeljau oder einen beliebigen Weißfisch verwenden."
        },
