      "steps": [
        {
          "position": 0,
          "text": "Ritze die Fischfilets ein. Lege sie mit geschnittenem Ingwer obenauf auf einen Teller in einen Dämpfeinsatz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dämpfe den Fisch 10–12 Minuten, bis er sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entferne den Ingwer. Garniere den Fisch mit in feine Streifen geschnittenen Frühlingszwiebeln und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Sojasauce mit Sesamöl und 2 EL Wasser. Erhitze Pflanzenöl, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße das heiße Öl über die Frühlingszwiebeln, sodass sie kräftig zischen. Träufle Sojasauce darüber und serviere den Fisch mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
