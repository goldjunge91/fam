      "steps": [
        {
          "position": 0,
          "text": "Zerdrücke Knoblauch und Salz zu einer Paste und vermische sie mit Paprikapulver, Essig, Wein, Olivenöl, Lorbeerblättern und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe das Hähnchen trocken, lege es in einen großen Bräter und reibe die Marinade innen und außen in die Bauchhöhle und auf die Haut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke das Hähnchen ab und stelle es für mindestens 4 Stunden oder über Nacht für mehr Geschmack in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor und gib das marinierte Hähnchen ohne Abdeckung hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate es 40-45 Minuten und übergieße es alle 15 Minuten mit Bratensaft, bis die Haut goldbraun ist und die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Presse frischen Zitronensaft über das Hähnchen und lasse es vor dem Tranchieren und Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
