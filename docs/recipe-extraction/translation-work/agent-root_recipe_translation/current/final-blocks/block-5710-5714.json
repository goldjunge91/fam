      "steps": [
        {
          "position": 0,
          "text": "Püriere Frühlingszwiebeln, Knoblauch, Ingwer, Habanero, Thymian, Piment, Zimt, Limettensaft, Kokosmilch, Sojasoße und braunen Zucker glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ritze die Hähnchenkeulen flach ein und reibe sie vollständig mit der Jerk-Marinade ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke das Fleisch ab und stelle es mindestens 4 Stunden oder über Nacht in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 425°F vor und lege das marinierte Hähnchen mit der Hautseite nach oben auf ein mit Folie belegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate es 30-35 Minuten, bis die Haut verkohlt ist und die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse das Fleisch 5 Minuten ruhen und serviere es mit Limettenspalten und Reis oder Kochbananen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
