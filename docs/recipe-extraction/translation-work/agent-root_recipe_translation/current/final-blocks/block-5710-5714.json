      "steps": [
        {
          "position": 0,
          "text": "Ritze die Schwarte der Schweineschulter mit flachen diagonalen Schnitten rautenförmig ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Meersalz, Flüssigrauch, gehackten Knoblauch und Ingwer, Sojasoße und braunen Zucker zu einer Paste und reibe sie auf das ganze Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wickle das Fleisch in Ti- oder Bananenblätter, damit die Marinade eingeschlossen bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das Fleisch mit der Fettseite nach oben in einen Schongarer, gib Wasser auf den Boden und gare es 6-8 Stunden auf niedriger Stufe, bis es sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch aus dem Schongarer und lasse es etwas abkühlen. Zerteile es mit zwei Gabeln und entferne überschüssiges Fett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Kochsud über das zerteilte Fleisch und serviere es warm in Brötchen oder mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
