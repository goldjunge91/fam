      "steps": [
        {
          "position": 0,
          "text": "Schneide den Schweinebauch in 2-inch große Würfel und gib sie mit Wasser, Knoblauch, Lorbeerblättern und schwarzem Pfeffer in einen großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lasse das Fleisch zugedeckt 30 Minuten köcheln, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Schweinefleisch ab und hebe die Flüssigkeit auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische im selben Topf Sojasoße, Essig, braunen Zucker und 0.5 Tasse der aufgehobenen Kochflüssigkeit. Rühre, bis sich der Zucker aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Schweinefleischwürfel zurück in den Topf, füge geschnittene Zwiebel hinzu und lasse alles ohne Deckel 5 Minuten köcheln, damit die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Würfel in einer Pfanne oder über Holzkohle etwa 3-5 Minuten, bis die Ränder karamellisiert und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
