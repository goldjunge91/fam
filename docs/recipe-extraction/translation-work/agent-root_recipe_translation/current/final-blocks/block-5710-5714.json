      "steps": [
        {
          "position": 0,
          "text": "Röste Koriandersamen 1 Minute in einer trockenen Pfanne und zerstoße sie anschließend mit schwarzem Pfeffer im Mörser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Schweine- und Rinderhack, fein gehacktes Fett, gehackten Knoblauch, die Koriandermischung, Salz, Paniermehl und Ei in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge alles gründlich, bis die Masse gleichmäßig und klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spüle die Schweinedärme mit kaltem Wasser aus und weiche sie 5 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Därme mit einem Wurstfüller oder Spritzbeutel mit großer Tülle und drehe sie alle 4-5 Zoll zu Würsten ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Würste bei mittlerer bis hoher Hitze 15-20 Minuten. Wende sie gelegentlich, bis sie gebräunt und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit gegrillten Zwiebeln und traditionellem afrikanischem Pap oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
