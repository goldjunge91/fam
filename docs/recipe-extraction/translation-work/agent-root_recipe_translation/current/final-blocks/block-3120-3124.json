      "steps": [
        {
          "position": 0,
          "text": "Rinderbrühe in einem kleinen Topf bei mittlerer Hitze mit Worcestershiresauce, Rinderbrühwürfel und Thymian erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln dünn schneiden, zur Brühe geben und 8 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Thymianzweig aus der Brühe nehmen und Brühe bei niedriger Hitze warm halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geschnittenes Roastbeef 3 Minuten in der Brühe erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sandwichbrötchen aufschneiden und jedes mit 2 Scheiben Schweizer Käse belegen, dann 2 Minuten überbacken, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warmes Roastbeef auf die käsebelegten Brötchen häufen und mit kleinen Schalen Brühe zum Eintunken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
