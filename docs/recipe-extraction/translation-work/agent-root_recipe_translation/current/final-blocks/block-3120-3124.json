      "steps": [
        {
          "position": 0,
          "text": "Kichererbsen abgießen und mit Zwiebel, Knoblauch, Petersilie und Kreuzkümmel in einer Küchenmaschine grob vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Backpulver hinzufügen und erneut pulsieren, bis die Mischung zusammenhält, aber noch krümelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung 15 Minuten kühlen, dann zu 8 kleinen Kugeln formen und leicht flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und Falafelkugeln vorsichtig 3-4 Minuten goldbraun frittieren, dabei einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittierte Falafel auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hummus auf jeden Wrap streichen und Salat, Tomaten sowie frittierte Falafel daraufgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Tahinisauce beträufeln, fest einwickeln und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
