      "steps": [
        {
          "position": 0,
          "text": "Das Rindfleisch sehr dünn schneiden (zum leichteren Schneiden vorher 1 Stunde teilweise einfrieren) und in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sojasauce, braunen Zucker, Sesamöl, Reisessig, Knoblauch, Ingwer und Frühlingszwiebel zur Marinade verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Marinade über das Rindfleisch gießen, gut vermengen und 10–15 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine große Pfanne oder Grillpfanne bei mittlerer bis hoher Hitze stark erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Fleisch portionsweise braten, ohne die Pfanne zu überfüllen: je Seite 2–3 Minuten, bis es karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf eine Servierplatte geben und mit Sesam bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort servieren, nach Wunsch mit gedämpftem Reis und Salatblättern zum Einwickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
