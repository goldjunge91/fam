      "steps": [
        {
          "position": 0,
          "text": "Picanha in 1.5 Zoll dicke Steaks schneiden und die Fettschicht kreuzweise einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauch, Koriander, Petersilie, Limettensaft und Olivenöl zu einer Chimichurri-Marinade verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Steaks auf beiden Seiten großzügig salzen und mit der Hälfte der Chimichurri bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Einen Holzkohlegrill auf hohe Hitze vorbereiten oder eine Grillpfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Steaks je Seite 5–7 Minuten für medium-rare grillen. Dabei mit Marinade bestreichen und für Grillstreifen drehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Fleisch 10 Minuten ruhen lassen und dann quer zur Faser in Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der restlichen Chimichurri, gegrillten Zwiebeln und Reis oder Bohnen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
