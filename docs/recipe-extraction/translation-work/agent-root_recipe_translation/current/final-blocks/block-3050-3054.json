      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche Reis 30 Minuten in Salzwasser ein und gieße ihn dann gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe 4 cups Salzwasser in einem großen Topf zum Kochen, gib Reis dazu und gare ihn ohne Deckel 8 Minuten, bis er teilweise weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße den Reis in einem Sieb ab und hebe 1 cup Kochwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Safranfäden mit heißem Wasser und lasse sie 5 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Joghurt und Eigelb glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche Boden und Seiten des Topfs mit 2 tbsp Butter und lege dünne Kartoffelscheiben als Boden hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte die Hälfte des Reises auf die Kartoffeln, beträufle ihn mit Safranwasser, gib den übrigen Reis darauf, gieße die Joghurtmischung darüber und verteile 2 tbsp Butter in kleinen Stücken darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf mit Folie und Deckel ab, reduziere die Hitze auf niedrig und dämpfe den Reis 25 Minuten, bis sich am Boden eine goldene Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Fahre mit einem Messer am Rand entlang und stürze den Reis auf eine Servierplatte, sodass die goldene Tahdig-Kruste sichtbar wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
