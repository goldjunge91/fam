      "steps": [
        {
          "position": 0,
          "text": "Tupfe Fischfilets trocken und würze sie mit Salz, Pfeffer und Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stecke Fischfilets und Tomatenscheiben abwechselnd mit Zwiebelringen auf Metallspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Olivenöl, frischen Zitronensaft, gehackten Knoblauch, Petersilie, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die Spieße großzügig mit der Zitronen-Kräuter-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze einen Grill oder eine Grillpfanne auf mittelhohe Hitze und grille die Spieße 4-5 Minuten pro Seite, bis der Fisch undurchsichtig ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie sofort mit gegrillten Zitronenspalten und zusätzlicher frischer Petersilie dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
