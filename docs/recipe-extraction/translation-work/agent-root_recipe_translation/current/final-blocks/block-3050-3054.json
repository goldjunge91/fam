      "steps": [
        {
          "position": 0,
          "text": "Würze Hähnchenbrustfilets mit Salz und Pfeffer und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tbsp Butter in einem großen Topf und gare geschnittene Zwiebeln etwa 7 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe die Zwiebeln zur Seite, gib das Hähnchen dazu und bräune es insgesamt 5 Minuten auf beiden Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 2 cups Wasser dazu, decke den Topf ab und lasse alles 25 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe 5 cups Salzwasser zum Kochen und koche Reis 10 Minuten, bis er teilweise weich ist. Gieße ihn gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse Safran 5 Minuten in heißem Wasser ziehen und vermische ihn dann mit 0.5 cup abgetropftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte den restlichen Reis mit Berberitzen und Safranreis im Topf und verteile die übrige Butter darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf fest ab und dämpfe den Reis bei niedriger Hitze 25 Minuten, bis sich am Boden eine Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Röste Mandeln 2 Minuten in einer trockenen Pfanne und garniere damit Reis und Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
