      "steps": [
        {
          "position": 0,
          "text": "Spüle getrocknete Spalterbsen ab und gib sie mit 6 cups Gemüsebrühe in einen großen Topf. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lasse die Erbsen 20 Minuten köcheln, bis sie teilweise weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer separaten Pfanne und brate gewürfelte Zwiebel etwa 5 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die angebratene Zwiebel zusammen mit Kidneybohnen, Petersilie, Dill und Spinat in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles ohne Deckel 25 Minuten köcheln und rühre gelegentlich um, bis Erbsen und Gemüse weich und die Suppe dick sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer und lasse alles weitere 5 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Suppe dick in Schalen, nach Wunsch mit etwas Olivenöl beträufelt und frischen Kräutern garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
