              "unit": "g",
              "position": 10,
              "optional": true,
              "source_note": "Teelöffel, geröstet, zum Garnieren"
            },
            {
              "key": "726a19cf-f942-54e5-b571-a183f0970b6c",
              "ingredientName": "Wasser",
              "grams": 540,
              "quantity": 540,
              "unit": "g",
              "position": 11,
