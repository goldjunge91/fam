      "steps": [
        {
          "position": 0,
          "text": "Yuca schälen und 20 Minuten in Salzwasser kochen, bis sie sehr weich ist. Anschließend gründlich abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den gekochten Yuca mit einer Gabel zerdrücken, bis eine glatte Masse entsteht, dann etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschlagene Eier, gehackte Zwiebeln, gehackten Knoblauch, Mehl, Salz und Pfeffer untermischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen, dann vorsichtig einen Löffel der Mischung in das heiße Öl geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf jeder Seite 3–4 Minuten goldbraun braten, dabei einmal wenden und dann mit einem Schaumlöffel herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit saurer Sahne zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
