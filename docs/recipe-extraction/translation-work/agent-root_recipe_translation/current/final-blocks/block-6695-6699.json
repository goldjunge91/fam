      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Yuca-Mehl, zerbröckeltes Queso-Fresko, Salz, Zucker und Backpulver in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer separaten Schüssel Eier, geschmolzene Butter und Milch verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nasse und trockene Zutaten vermengen und umrühren, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in kleinen Häufchen mit 2 Zoll Abstand auf das vorbereitete Backblech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "20–25 Minuten backen, bis der Teig goldbraun ist und ein Zahnstocher in der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
