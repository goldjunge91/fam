      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen, in kleine Würfel schneiden und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem großen Topf schmelzen und gewürfelte Zwiebeln und gehackten Knoblauch darin anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderbrühe hinzufügen und zum Kochen bringen, dann Kartoffelwürfel hinzufügen und 15 Minuten köcheln lassen, bis die Kartoffeln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und fügen Sie unter ständigem Rühren langsam den geriebenen Mozzarella hinzu, bis er geschmolzen und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Milch einrühren und weitere 2 Minuten köcheln lassen, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit frischem Koriander garnieren und heiß mit warmen Maistortillas als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
