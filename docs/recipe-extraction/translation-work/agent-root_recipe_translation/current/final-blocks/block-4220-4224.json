      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Maisblätter 30 Minuten in warmem Wasser einweichen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchenbrust mit der Hälfte der Zwiebel in Wasser garen, bis sie vollständig durch ist. Zerpflücken und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter cremig schlagen, dann nach und nach Masa Harina mit warmer Hühnerbrühe und Salz einrühren, bis ein weicher, streichfähiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerpflücktes Hähnchen mit Tomaten aus der Dose, Oliven, Rosinen und der restlichen gewürfelten Zwiebel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein eingeweichtes Maisblatt flach auslegen und etwa 2 Esslöffel Masa in der Mitte verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Einen Löffel Hähnchenfüllung in die Mitte der Masa geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Seiten des Maisblatts über die Füllung klappen und dann den unteren Teil hochfalten, die Oberseite offen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tamalitos mit der offenen Seite nach oben in einen Topf mit 2 Zoll Wasser am Boden stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit zusätzlichen Maisblättern abdecken und 30 Minuten dämpfen, bis die Masa gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Warm in den Maisblättern servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
