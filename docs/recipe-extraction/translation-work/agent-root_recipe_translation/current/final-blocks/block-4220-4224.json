      "steps": [
        {
          "position": 0,
          "text": "Mehl mit 1 Teelöffel Salz vermischen und kalte Butter einarbeiten, bis die Mischung Semmelbröseln ähnelt. Eigelb und warmes Wasser hinzufügen, zu Teig formen und 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl erhitzen und Rinderhackfleisch mit gewürfelter Zwiebel anbraten. Gewürfelte Kartoffel, Erbsen, Kreuzkümmel, Chilipulver und Brühe hinzufügen und köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füllung mit Salz und Pfeffer würzen und vor der Verwendung vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 12 Stücke teilen und jedes zu einem 4 Zoll großen Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeweils 2 Esslöffel Füllung in die Mitte geben, den Teig halbieren und die Ränder mit einer Gabel zum Verschließen zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Salteña mit Eierglasur bestreichen und auf ein mit Backpapier belegtes Blech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400 °F 20–25 Minuten goldbraun backen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
