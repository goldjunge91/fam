      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und Fischfilets auf beiden Seiten mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fischfilets pro Seite 3–4 Minuten garen, bis sie leicht gebräunt und durchgegart sind. Vorsichtig herausnehmen und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf geschnittene Zwiebeln und Knoblauch etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Essig, Wasser, Lorbeerblätter, Jalapeños und Kreuzkümmel hinzufügen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch zurück in die Pfanne geben und 5 Minuten sanft köcheln lassen, damit er die Aromen aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fisch und Sauce in ein Glasgefäß geben und vor dem Servieren mindestens 2 Stunden oder über Nacht kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
