      "steps": [
        {
          "position": 0,
          "text": "Weiche Kidneybohnen über Nacht ein, gieße sie dann ab und spüle sie gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und bräune die Rindfleischstücke etwa 5 Minuten pro Seite rundherum an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch in den Topf und gare alles, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wasser dazu, füge Bohnen und Thymian hinzu und bringe alles zum Kochen. Reduziere dann die Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und gare alles 45 Minuten, bis die Bohnen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfelte Karotten und Kartoffeln dazu und lasse alles weitere 20 Minuten ohne Deckel köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Kokosmilch ein, würze mit Salz und Pfeffer und gare alles vor dem Servieren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
