      "steps": [
        {
          "position": 0,
          "text": "Weiche den Saltfish 12-24 Stunden in kaltem Wasser ein und wechsle das Wasser mehrmals, um überschüssiges Salz zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche den eingeweichten Saltfish 15 Minuten, gieße ihn ab und zerpflücke das Fleisch. Entferne Haut und Gräten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl, Backpulver, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische den zerpflückten Fisch in einer anderen Schüssel mit fein gehackter Zwiebel, Knoblauch und Thymian.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge nasse und trockene Zutaten und gib nach und nach Wasser dazu, bis ein dicker Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf oder Schmortopf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Löffel des Teigs ins heiße Öl und frittiere sie insgesamt etwa 3-4 Minuten auf beiden Seiten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit scharfer Sauce oder Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
