      "steps": [
        {
          "position": 0,
          "text": "Schäle die Brotfrucht, entferne den Kern und schneide sie in große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Brotfruchtstücke auf einem mit Backpapier ausgelegten Blech bei 400°F 25-30 Minuten goldbraun und weich. Rühre sie nach der Hälfte der Zeit um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und brate Zwiebel und Knoblauch 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Tomaten, Thymian und eine ganze Scotch-Bonnet-Chilischote dazu und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe Ackee aus der Dose vorsichtig unter, damit die Stücke nicht zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib geröstete Brotfruchtstücke in die Pfanne und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und schwarzem Pfeffer. Entferne Scotch-Bonnet-Chilischote und Thymianzweige und serviere das Gericht warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
