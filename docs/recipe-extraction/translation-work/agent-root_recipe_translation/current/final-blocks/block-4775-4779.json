      "steps": [
        {
          "position": 0,
          "text": "Wische das Kombu vorsichtig mit einem feuchten Tuch ab, aber wasche es nicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe 4 cups Wasser in einem Topf zum Köcheln, gib das Kombu dazu und halte die Brühe 8 Minuten bei leichter Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Kombu heraus, kurz bevor das Wasser kräftig kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhöhe die Hitze, bis sich kleine Bläschen bilden. Schalte den Herd aus und gib die Bonitoflocken dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Bonitoflocken 3 Minuten ohne Rühren absinken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Brühe durch ein feines Sieb oder Passiertuch und entsorge die festen Bestandteile.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Salz und Mirin ein und schmecke die Brühe ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verwende sie sofort oder lagere sie bis zu 3 days im Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
