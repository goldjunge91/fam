      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln etwa 10 Minuten, bis sie sich leicht mit einer Gabel einstechen lassen. Lass sie abkühlen und schneide sie in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Putze die grünen Bohnen und koche sie 4 Minuten, bis sie gar, aber noch bissfest sind. Lass sie abtropfen und abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche die Eier 10 Minuten, lass sie abkühlen, schäle sie und viertle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Olivenöl, Essig, Senf und Salz zu einem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte den Römersalat auf Tellern oder einer großen Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile Kartoffeln, grüne Bohnen, Thunfisch, Eier, Tomaten, Zwiebel und Oliven in einzelnen Bereichen auf dem Salat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle den Salat mit dem Dressing oder serviere es dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermenge alles vorsichtig und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
