      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine runde Kuchenform von 9 Zoll ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle blanchierte Mandeln in einer Küchenmaschine zu feinem Pulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Eier und Zucker etwa 5 Minuten hell und dickcremig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe gemahlene Mandeln, geschmolzene Butter, Zitronenschale, Zimt und Salz unter, bis alles gut vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in die vorbereitete Form und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Kuchen 35-40 Minuten goldbraun, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass den Kuchen vollständig in der Form abkühlen und bestäube ihn vor dem Servieren großzügig mit Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
