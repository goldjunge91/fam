      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor. Falls du Krabbenschalen verwendest, säubere sie gründlich und lege sie auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Olivenöl und dünste gewürfelte Zwiebel und gehackten Knoblauch 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Semmelbrösel, Paprikapulver, Krabbenfleisch, Salz und Pfeffer gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Krabbenschalen großzügig mit der Mischung oder gib sie in eine gebutterte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle die Oberfläche mit dem restlichen Olivenöl und backe alles 20 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Presse direkt nach dem Herausnehmen Zitronensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß als elegante Vorspeise oder leichte Hauptspeise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
