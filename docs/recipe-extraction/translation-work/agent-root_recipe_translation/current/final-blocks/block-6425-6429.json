      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Garnelen trocken und würze sie leicht mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze, bis es glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden, bis er duftet. Achte darauf, dass er nicht anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Paprikapulver und Chiliflocken dazu und rühre einige Sekunden um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Garnelen dazu und gare sie auf der ersten Seite 2 Minuten. Wende sie und gare sie weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle sie mit Zitronensaft, schwenke sie darin und gare sie weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Garnelen auf eine Servierplatte und serviere sie sofort mit knusprigem Brot, um das Öl aufzunehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
