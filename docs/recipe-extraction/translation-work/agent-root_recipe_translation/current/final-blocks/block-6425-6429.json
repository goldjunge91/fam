      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebeln fein und gare sie langsam 15 Minuten in Olivenöl, bis sie sehr weich und karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische in einer großen Schüssel Schweineblut, gekochten Reis, gewürfeltes Schweinefett, gehackten Knoblauch, Paprikapulver, Salz und Pfeffer mit den abgekühlten Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge die Füllung gründlich und fülle sie dann vorsichtig mit einem Trichter und Wurstfüller in vorbereitete Schweinedärme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Binde die Därme in Abständen von 4 Zoll ab, um einzelne Morcilla-Würste zu formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe Wasser in einem großen Topf zum sanften Köcheln und pochierte Morcilla 30 Minuten darin. Halte die Temperatur unter 180°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schrecke die Morcilla 10 Minuten in Eiswasser ab und stelle sie bis zum Servieren in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Würste zum Servieren in Scheiben und brate sie in einer Pfanne mit Olivenöl pro Seite 3 Minuten leicht knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
