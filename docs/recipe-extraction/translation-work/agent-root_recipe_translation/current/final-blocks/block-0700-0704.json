      "steps": [
        {
          "position": 0,
          "text": "Erwärme die schwarzen Bohnen mit Kreuzkümmel, Knoblauchpulver und einer Prise Salz in einer kleinen Pfanne, bis sie heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze etwas Öl in einer beschichteten Pfanne. Verquirle die Eier mit Salz und brate sie bei mittlerer Hitze zu Rührei, bis sie gerade gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Tortillas kurz in derselben Pfanne oder über einer offenen Flamme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede Tortilla mit der Hälfte des Rühreis, der Hälfte der Bohnen, einer Portion geriebenem Käse und einem Löffel Salsa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falte die Seiten ein und rolle die Burritos fest auf. Sofort servieren oder für ein Frühstück zum Mitnehmen in Folie wickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
