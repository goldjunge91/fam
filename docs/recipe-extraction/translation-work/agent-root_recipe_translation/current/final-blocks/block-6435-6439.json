          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eigelb und Zucker in der Metallschüssel etwa 2 Minuten hell und dickcremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle die Schüssel über das Eis und gieße langsam Marsalawein hinein. Schlage dabei 8-10 Minuten ständig weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage die Masse weiter, bis sie auf einem Thermometer 160°F erreicht oder dick und luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Schüssel von der Hitze und rühre Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile Zabaione auf Dessertgläser und serviere sofort Löffelbiskuits zum Dippen dazu.",
