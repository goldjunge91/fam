      "steps": [
        {
          "position": 0,
          "text": "Taue den Tiefkühlspinat vollständig auf und drücke ihn mit einem sauberen Küchentuch trocken, bis keine Flüssigkeit mehr austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Ricotta, ausgedrückten Spinat, 1/2 cup Parmesan, Ei, Muskatnuss, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe Mehl vorsichtig unter, bis ein weicher Teig entsteht. Knete ihn nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe Salzwasser in einem großen Topf zum sanften Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme mit zwei Löffeln Gnocchi, indem du Löffelportionen des Teigs ins siedende Wasser gibst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche sie 3-4 Minuten, nachdem sie an die Oberfläche gestiegen sind. Nimm sie dann mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass Butter mit Salbeiblättern in einer kleinen Pfanne schmelzen, bis sie duftet und leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schwenke die gekochten Gnocchi in der Buttersauce und dem restlichen Parmesan und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
