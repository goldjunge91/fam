      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und fette eine 6-cup-Backform oder Förmchen mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Milch in einem Topf, bis sie dampft, aber nicht kocht. Nimm sie dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eigelb und Zucker etwa 3 Minuten hell und dickcremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Siebe Kakaopulver zur Eiermischung und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die heiße Milch unter ständigem Rühren langsam zur Eiermischung, damit das Eigelb nicht stockt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre zerstoßene Amaretti-Kekse und eine Prise Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Mischung in die vorbereitete Form und stelle sie in einen größeren Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle heißes Wasser in den Bräter, bis es bis zur halben Höhe der Backform reicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backe den Pudding 25-30 Minuten, bis er gestockt, in der Mitte aber noch leicht wackelig ist. Lass ihn abkühlen und stelle ihn vor dem Servieren mindestens 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
