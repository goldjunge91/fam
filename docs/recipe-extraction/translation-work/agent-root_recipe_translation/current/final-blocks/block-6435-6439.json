      "steps": [
        {
          "position": 0,
          "text": "Bereite den Pastateig aus Mehl und 3 Eiern zu. Knete ihn glatt, wickle ihn ein und lass ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Zwiebel und Knoblauch fein und dünste sie in 1 Esslöffel Butter 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hackfleisch dazu und brate es 5 Minuten krümelig an. Lass es leicht abkühlen und vermische es mit 1/4 cup Parmesan und 1 Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Pastateig auf einer bemehlten Fläche sehr dünn aus und schneide ihn in 2-inch große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1 Teelöffel Füllung auf die Hälfte jedes Quadrats, klappe es zu einem Dreieck und führe dann die Ecken zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Brühe in einem großen Topf sanft zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Plin in die kochende Brühe und gare sie 3-4 Minuten, bis sie an die Oberfläche steigen und dort 1 Minute bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Plin auf Schüsseln und schöpfe Brühe darüber. Beträufle sie mit gebräunter Butter und Salbei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
