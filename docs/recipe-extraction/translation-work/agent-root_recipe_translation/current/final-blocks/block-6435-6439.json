      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine runde Kuchenform von 9-inch mit Butter ein und bestäube sie mit Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere geröstete Haselnüsse in einer Küchenmaschine fein. Achte darauf, dass keine Haselnussbutter entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Butter und Zucker etwa 3 Minuten hell und luftig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Eier einzeln dazu und schlage nach jeder Zugabe gut, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Mehl, Backpulver und Salz in einer kleinen Schüssel und hebe sie dann unter die feuchte Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe gemahlene Haselnüsse und Vanilleextrakt nur so lange unter, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße den Teig in die vorbereitete Form und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Kuchen 30-35 Minuten, bis ein in die Mitte gesteckter Zahnstocher mit einigen feuchten Krümeln herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lass den Kuchen 15 Minuten in der Form abkühlen und stürze ihn dann auf ein Gitter. Lass ihn vollständig abkühlen, bevor du ihn mit Puderzucker bestäubst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
