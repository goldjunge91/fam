      "steps": [
        {
          "position": 0,
          "text": "Kohlkopf 10 Minuten kochen, bis die Blätter weich werden, dann vorsichtig abziehen und 12-14 Blätter beiseite legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch, Schweinehackfleisch, Reis, gehackte Zwiebeln, gehackten Knoblauch, Paprika, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie 2 Esslöffel Füllung auf jedes Kohlblatt, falten Sie die Seiten ein und rollen Sie es von unten nach oben fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Restliche Kohlstücke in einen Topf schichten und die Rollen mit der Nahtseite nach unten in Reihen anordnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatenmark mit Rinderbrühe vermischen und über die Brötchen gießen, zum Kochen bringen und dann zugedeckt 60 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
