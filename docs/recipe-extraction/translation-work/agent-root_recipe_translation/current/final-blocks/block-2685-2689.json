      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Teffmehl, Weizenmehl und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach Wasser unter Rühren hinzu, bis ein glatter, klumpenfreier Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Hefe ein und decke die Schüssel mit einem Tuch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Teig 3-5 Tage bei Raumtemperatur fermentieren und rühre ihn einmal täglich um, bis er säuerlich riecht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine beschichtete Pfanne oder Crêpe-Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße etwa 1/2 Tasse Teig in die Mitte der heißen Pfanne und neige sie, damit sich der Teig zu einem dünnen Kreis verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Pfanne ab und gare den Teig 2-3 Minuten, bis die Oberfläche fest, aber noch leicht feucht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege das Injera auf einen Teller und lasse es vollständig abkühlen, bevor du es stapelst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
