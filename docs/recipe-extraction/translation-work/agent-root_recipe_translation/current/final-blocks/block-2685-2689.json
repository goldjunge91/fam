      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch in 1-Zoll-Würfel und würze es mit Salz und Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Zwiebel, Paprika und Tomate und hacke den Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bräune die Rindfleischwürfel portionsweise 5 Minuten und stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dünste in derselben Pfanne die Zwiebel etwa 5 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Knoblauch, Ingwer und Paprika hinzu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Fleisch zurück in die Pfanne, füge gewürfelte Tomate hinzu und lasse alles 10 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
