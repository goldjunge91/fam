      "steps": [
        {
          "position": 0,
          "text": "Heize dein Waffeleisen vor und bestreiche es leicht mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage in einer anderen Schüssel die Eier mit dem Zucker hellcremig auf und rühre dann die geschmolzene Butter und Vanille ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge feuchte und trockene Zutaten nur kurz und rühre dann die Milch ein, bis der Teig die richtige Konsistenz hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Teig in das heiße Waffeleisen und backe ihn etwa 4-5 Minuten, bis die Waffeln goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die fertigen Waffeln zum kurzen Abkühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestäube sie großzügig mit Puderzucker und serviere sie warm mit Marmelade oder Schokoladensauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
