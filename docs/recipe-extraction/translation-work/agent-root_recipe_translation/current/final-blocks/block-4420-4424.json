      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor und koche die Chicorée-Köpfe 15 Minuten in Salzwasser, bis sie weich sind; lasse sie anschließend gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wickle jeden Chicorée-Kopf in eine Scheibe Schinken und lege ihn in eine gebutterte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz die Butter in einem Topf bei mittlerer Hitze, rühre das Mehl ein, um eine Mehlschwitze herzustellen, und gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Milch nach und nach unter ständigem Rühren dazu, damit keine Klumpen entstehen, und würze mit Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Sauce 5 Minuten köcheln, bis sie eindickt, und rühre dann drei Viertel des Käses ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Sauce über die Chicorée-Schinken-Rollen, streue den restlichen Käse darüber und backe alles 20 Minuten, bis es blubbert und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Gericht vor dem heißen Servieren 2 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
