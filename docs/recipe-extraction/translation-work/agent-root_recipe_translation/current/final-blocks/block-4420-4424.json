      "steps": [
        {
          "position": 0,
          "text": "Bereite eine Béchamelsauce zu, indem du Butter schmilzt, Mehl mit dem Schneebesen einrührst und nach und nach unter ständigem Rühren Milch zugibst, bis die Sauce eindickt, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Garnelen in kleine Stücke und hebe sie mit Muskatnuss, Salz und Pfeffer unter die Béchamelsauce. Lasse die Mischung auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe das Eigelb unter, fülle die Masse in einen Spritzbeutel und stelle sie 30 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spritze 3-Zoll-Stangen auf Backpapier und friere sie 30 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle zum Panieren drei Schüsseln mit verquirltem Ei, Mehl und Semmelbröseln bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende jede gefrorene Krokette zuerst in Mehl, dann in Ei und anschließend in Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze das Öl auf 350°F und frittiere die Kroketten portionsweise 2-3 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie sofort mit Zitronenspalten und Remoulade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
