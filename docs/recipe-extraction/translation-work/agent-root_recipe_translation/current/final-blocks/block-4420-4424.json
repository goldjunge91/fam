      "steps": [
        {
          "position": 0,
          "text": "Brate fein gewürfelte Schalotten in 2 EL Butter an, bis sie weich sind, etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Hühnerlebern dazu und brate sie etwa 6 Minuten, bis sie gerade durchgegart, innen aber noch rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lösche mit Cognac ab und lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Lebermischung in einen Mixer und püriere sie glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib weiche Butter, Thymian, Salz und Pfeffer dazu und verarbeite alles kurz, bis die Masse cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe Schlagsahne und Eigelb von Hand unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Masse in eine mit Frischhaltefolie ausgelegte Terrine oder Kastenform und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kühle die Pastete vor dem Stürzen und Servieren mit Brot mindestens 4 Stunden oder über Nacht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
