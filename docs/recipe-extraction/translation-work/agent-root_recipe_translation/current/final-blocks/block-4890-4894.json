      "steps": [
        {
          "position": 0,
          "text": "2 EL Olivenöl in einer großen Pfanne bei mittelhoher Hitze erhitzen. Gewürfelte Zwiebel und Paprika hinzufügen und etwa 4 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch hinzufügen und 30 Sekunden braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen, Limettensaft, Kreuzkümmel, Salz und Pfeffer hinzufügen und 3–4 Minuten garen, bis die Garnelen rosa und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine Tortilla auf eine saubere Arbeitsfläche legen. Die Hälfte der Garnelenmischung auf einer Hälfte verteilen und mit 1/2 Tasse Käse belegen. Zusammenklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1/2 EL Olivenöl in einer sauberen Pfanne bei mittlerer Hitze erhitzen. Die Quesadilla hineinlegen und je Seite 2–3 Minuten braten, bis sie goldbraun und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit den übrigen zwei Tortillas und der restlichen Füllung wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Quesadillas in Dreiecke schneiden und sofort mit saurer Sahne servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
