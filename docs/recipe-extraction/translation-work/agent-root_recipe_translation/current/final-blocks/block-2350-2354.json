      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und verteile 0.5 cup Marinarasoße auf dem Boden einer Auflaufform von 9x13 inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Ricotta, Spinat, Ei, 0.5 cup Parmesan, gehackten Knoblauch, Salz, Pfeffer und eine Prise Muskatnuss in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Cannelloni-Röhren mithilfe eines Spritzbeutels oder kleinen Löffels mit der Ricottamischung und lege sie mit der Nahtseite nach unten in die vorbereitete Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die restliche Marinarasoße über die Cannelloni, sodass sie vollständig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische den restlichen Parmesan mit Mozzarella und verteile alles gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form mit Folie ab und backe sie 25 Minuten. Entferne dann die Folie und backe weitere 15 Minuten, bis der Käse geschmolzen ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Gericht vor dem Servieren 5 Minuten abkühlen, damit die Füllung nicht herausläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
