      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gib den Stängelkohl hinein. Koche ihn 3 Minuten, bis er gerade weich ist. Nimm ihn mit einem Schaumlöffel heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Orecchiette im selben Topf nach Packungsanweisung al dente. Gieße sie ab und bewahre 1 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste gehackten Knoblauch und Chiliflocken 30 seconds an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gegarten Stängelkohl und Hühnerbrühe in die Pfanne. Rühre um und erhitze alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gegarten Nudeln in die Pfanne und vermenge alles. Füge nach Bedarf Nudelwasser hinzu, bis eine leichte Soße entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und rühre Parmesan und Zitronensaft ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und schmecke es mit Salz und schwarzem Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren und zusätzlich Parmesan dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
