      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine Auflaufform von 9x13 inch leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer Pfanne bei mittlerer Hitze und erwärme jede Tortilla kurz, etwa 10 seconds pro Seite, damit sie biegsam wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Salsa Verde, Crema und Hühnerbrühe in einer Schüssel und gieße 1 cup dieser Mischung auf den Boden der vorbereiteten Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische in einer separaten Schüssel gezupftes Hähnchen mit 1 cup Käse, gehacktem Knoblauch, der Hälfte des Korianders sowie Salz und Pfeffer nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauche jede warme Tortilla in die restliche Salsa-Mischung und lege sie auf einen Teller. Fülle sie mit 2-3 tablespoons der Hähnchenmischung, streue Zwiebelscheiben darüber und rolle sie fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege jede gerollte Enchilada mit der Nahtseite nach unten in die Auflaufform über die Salsa-Schicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die übrige Salsa-Mischung über die Enchiladas und streue den restlichen Käse gleichmäßig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke die Form mit Folie ab und backe sie 25 Minuten. Entferne die Folie und backe weitere 10 Minuten, bis der Käse geschmolzen ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit dem restlichen Koriander garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
