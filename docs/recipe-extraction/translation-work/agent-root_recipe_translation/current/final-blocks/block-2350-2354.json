      "steps": [
        {
          "position": 0,
          "text": "Lege Poblano-Chilis direkt über eine Gasflamme oder unter den Grill, bis die Haut rundum verkohlt ist. Gib sie dann 5 Minuten in einen Plastikbeutel, damit sie im Dampf ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ziehe die verkohlte Haut unter kaltem fließendem Wasser von jeder Chili ab. Schneide vorsichtig einen Schlitz hinein und entferne die Kerne, ohne die Chili aufzutrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste gewürfelte Zwiebel und Knoblauch etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Rinderhackfleisch dazu und brate es unter Zerteilen mit einem Löffel braun. Gieße überschüssiges Fett ab und gib gewürfelten Apfel, Rosinen und gehackte Backpflaumen hinzu. Gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre gehackte Pekannüsse und Mandeln ein, würze mit Salz und Pfeffer, nimm die Pfanne vom Herd und lasse die Füllung etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede geröstete Poblano-Chili vorsichtig mit der Fleischmischung, etwa 3-4 tablespoons pro Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für die Walnusssoße püriere zerdrückte Walnüsse mit mexikanischer Crema, Knoblauch, Salz und etwas Wasser, bis die Soße glatt und gießfähig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Richte die gefüllten Poblanos auf einer Servierplatte an und gieße großzügig Walnusssoße über jede Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit zerbröseltem Queso Fresco, Granatapfelkernen und frischem Koriander garnieren und bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
