      "steps": [
        {
          "position": 0,
          "text": "Verquirle Sojasauce, Ketchup, Worcestershiresauce, Zucker und rote Chiliflocken in einer kleinen Schüssel zu einer Soße und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze etwa 2 Teelöffel Öl in einer großen Pfanne bei mittlerer bis hoher Hitze. Brate die Schweinefleischstreifen unter Rühren 2-3 Minuten, bis sie nicht mehr rosa sind, und lege sie dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl dazu und brate den Brokkoli etwa 3 Minuten. Gib Krautsalatmischung, Bambussprossen und Knoblauch dazu und gare alles weitere 3-4 Minuten, bis der Brokkoli bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Schweinefleisch zurück in die Pfanne, gieße die Soße dazu und rühre, bis alles durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Ramen nach Packungsanleitung, aber ohne die Gewürzpäckchen, und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die abgetropften Nudeln in die Pfanne und wende alles, bis die Nudeln mit Soße überzogen sind. Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
