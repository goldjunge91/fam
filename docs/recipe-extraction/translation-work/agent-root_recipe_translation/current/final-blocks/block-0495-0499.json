      "steps": [
        {
          "position": 0,
          "text": "Verquirle Hühnerbrühe, Apfelsaftkonzentrat und Senf in einer kleinen Schüssel und stelle die Mischung beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Schweinemedaillons auf beiden Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen beschichteten Pfanne bei mittlerer bis hoher Hitze. Brate das Schweinefleisch auf beiden Seiten braun an und lege es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Knoblauch in dieselbe Pfanne und brate ihn etwa eine Minute. Gieße dann die Brühemischung dazu und löse die gebräunten Reste vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe die Soße zum Kochen, reduziere dann die Hitze und lasse sie ohne Deckel 6 bis 8 Minuten köcheln, bis die Flüssigkeit auf ungefähr 1/3 Tasse reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Schweinefleisch zurück in die Pfanne, decke sie ab und gare es bei niedriger Hitze 3 bis 4 Minuten, bis es 145 Grad F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verrühre Maisstärke und kaltes Wasser zu einer glatten Mischung, rühre sie in die Soße und koche alles 2 Minuten, bis die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue frische Petersilie darüber und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
