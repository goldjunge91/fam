      "steps": [
        {
          "position": 0,
          "text": "Schmilz 1 Esslöffel Butter in einer großen 12-inch-Pfanne bei mittlerer Hitze. Brate die Schweinefleischscheiben etwa 2 bis 4 Minuten pro Seite an, bis sie gerade gar sind, und lege sie dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den restlichen Esslöffel Butter bei mittlerer bis hoher Hitze in dieselbe Pfanne. Brate die Pilze, bis sie fast weich sind, rühre dann den Knoblauch ein und gare alles eine weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die geviertelten Kartoffeln, etwa 1 1/2 Tassen Brühe, Worcestershiresauce, Salz und Pfeffer dazu. Bringe alles zum Kochen, decke die Pfanne ab, reduziere die Hitze und lasse die Kartoffeln 10 bis 15 Minuten köcheln, bis sie sich leicht mit einer Gabel einstechen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle das Mehl mit der restlichen Brühe, bis die Mischung glatt ist, und rühre sie dann in die Pfanne. Bringe alles erneut zum Kochen und rühre, bis die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die geschnittenen Frühlingszwiebeln ein, gib das Schweinefleisch samt ausgetretenem Saft zurück in die Pfanne und erhitze alles vor dem Servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
