      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser, Hefe und 1 Teelöffel Zucker in einer Schüssel vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, restlichen Zucker und Salz vermischen, dann eine Mulde formen und Hefemischung und Olivenöl hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischen, bis ein Teig entsteht, dann auf einer bemehlten Arbeitsfläche 5-7 Minuten lang kneten, bis ein glatter und elastischer Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lassen Sie den Teig in einer geölten Schüssel mit einem feuchten Handtuch abgedeckt 30 Minuten lang gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf ein geöltes Backblech zu einem dünnen, gleichmäßigen Rechteck drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreichen Sie die Oberfläche mit verquirltem Ei und verteilen Sie die gehobelten Mandeln gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375 °F 20–25 Minuten backen, bis das Gebäck goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
