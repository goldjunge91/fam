      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer breiten Paellapfanne bei mittlerer bis hoher Hitze erhitzen. Hähnchenwürfel und Wurst von allen Seiten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fügen Sie gehackten Knoblauch und gewürfelte Tomaten hinzu und kochen Sie, bis die Tomaten weich sind, etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reis einrühren und 2 Minuten lang gut mit Öl bestreichen, dann grüne Bohnen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heiße Brühe über den Reis gießen, Safran und Paprika einrühren und nicht noch einmal umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ohne Deckel 18–20 Minuten köcheln lassen, bis der Reis weich ist und die Brühe aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In den letzten 2–3 Minuten die Hitze erhöhen, damit sich am Pfannenboden eine knusprige goldbraune Kruste (costra) bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, mit Folie abdecken und vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
