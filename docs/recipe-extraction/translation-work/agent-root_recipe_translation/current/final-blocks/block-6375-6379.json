      "steps": [
        {
          "position": 0,
          "text": "Salzwasser in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maisgrieß unter ständigem Rühren langsam einstreuen, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und lassen Sie es 15 Minuten lang köcheln. Dabei häufig umrühren, um ein Anhaften und Anbrennen zu verhindern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während das Maismehl kocht, den Schinken würfeln, den Knoblauch fein hacken und dann das Olivenöl in einer Pfanne erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Knoblauch und Schinken in Öl anbraten, bis sie knusprig sind und duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Schinken-Knoblauch-Mischung in das gekochte Maismehl einrühren und mit schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in Schüsseln mit der Kochflüssigkeit servieren, um eine breiartige Konsistenz zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
