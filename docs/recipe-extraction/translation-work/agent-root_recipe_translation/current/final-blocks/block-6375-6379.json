      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Erdmandeln 2 Stunden in Wasser einweichen. Abgießen und mit 3 Tassen frischem Wasser sehr fein pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Mischung durch ein feines Sieb oder ein Käsetuch abseihen und auspressen, um die gesamte Flüssigkeit zu extrahieren. Anschließend das Fruchtfleisch trocken drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zucker und Salz unter die Horchata rühren und bis zum Servieren kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für Fartons Mehl, Zucker und Backpulver mischen und dann geschlagenes Ei, Milch und Vanille getrennt verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mischen Sie die nassen und trockenen Zutaten, bis sie gerade vermischt sind, und geben Sie dann kleine Löffel auf ein gefettetes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 375 °F 12–15 Minuten goldbraun backen. Leicht abkühlen lassen und mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Servieren Sie Horchata gekühlt in Gläsern zusammen mit warmen Fartons zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
