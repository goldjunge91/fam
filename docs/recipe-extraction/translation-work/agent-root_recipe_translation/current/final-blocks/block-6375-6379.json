      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer breiten Paella-Pfanne erhitzen und gehackten Knoblauch und gewürfelte Zwiebeln anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis hinzufügen und 2 Minuten lang umrühren, damit er mit Öl bedeckt ist, ohne dass er braun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heiße Brühe in die Pfanne gießen, Safran und Paprika einrühren und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze auf mittlere Stufe reduzieren und ohne Rühren 15–18 Minuten köcheln lassen, bis der Reis fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In den letzten 5 Minuten der Garzeit Garnelen, Fischstücke und geputzte Muscheln auf dem Reis verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kochen, bis die Meeresfrüchte gar sind, der Reis zart und die Muscheln geöffnet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, mit Folie abdecken, 2 Minuten ruhen lassen und dann direkt aus der Pfanne servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
