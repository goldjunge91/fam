    {
      "externalId": "waivy:rice-cooker-castella-cake",
      "slug": "rice-cooker-castella-cake",
      "title": "Japanischer Castella-Biskuit aus dem Reiskocher",
      "instructions": "Ein wolkenweicher japanischer Biskuitkuchen mit Honig, der im Reiskocher ganz ohne Ofen goldbraun und herrlich wackelig gelingt.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Eier, Mehl und Zucker sind preiswerte Vorratszutaten. Der ganze Kuchen kostet weniger als ein Stück vom Bäcker.",
        "Du brauchst keinen Mixer. Ein Schneebesen und etwas Muskelkraft reichen völlig, um das Eiweiß steif zu schlagen.",
        "Falls dein Reiskocher zu früh auf Warmhalten schaltet, drücke einfach alle 10 Minuten erneut auf Garen, bis der Kuchen fest ist. Du brauchst dafür kein neues Gerät."
      ],
      "substitutions": [
        {
          "forIngredientId": "honey",
          "swap": "Stattdessen Zucker oder Ahornsirup verwenden",
          "savings": "Spart den Honigkauf und etwa $0.40"
        },
        {
          "forIngredientId": "vegetable-oil",
          "swap": "Geschmolzene Butter für einen reichhaltigeren Geschmack",
          "savings": "Verwende, was bereits im Kühlschrank ist, ohne zusätzliche Kosten (0 $)."
        },
        {
          "forIngredientId": "milk",
          "swap": "Wasser oder eine beliebige Pflanzenmilch",
          "savings": "Spart etwa $0.10, wenn Milchprodukte weggelassen werden"
        }
      ],
