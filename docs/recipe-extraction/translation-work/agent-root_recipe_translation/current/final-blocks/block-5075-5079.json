      "steps": [
        {
          "position": 0,
          "text": "Koche Fettuccine in kochendem Salzwasser bissfest. Stelle 1/2 Tasse Nudelwasser beiseite und gieße die Nudeln ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einer großen Pfanne bei mittlerer Hitze und dünste den gehackten Knoblauch 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die gekochte Pasta zusammen mit 1/4 Tasse Nudelwasser in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd und beträufle die Pasta mit Trüffelöl und Yuzu-Saft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische alles vorsichtig und gib bei Bedarf weiteres Nudelwasser dazu, bis eine seidige Sauce entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Parmesan ein, bis er vollständig eingearbeitet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte die Pasta auf Tellern an und garniere sie mit gehobeltem schwarzem Trüffel, weißem Pfeffer und frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
