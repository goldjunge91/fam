      "steps": [
        {
          "position": 0,
          "text": "Bringe Dashi-Brühe in einem großen Topf zum Kochen und gib den gereinigten Oktopus hinein. Reduziere die Hitze und lasse ihn 45 Minuten sanft köcheln, bis er zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Oktopus aus der Dashi-Brühe und lasse ihn etwas abkühlen. Schneide ihn dann in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze. Gib gehackten Knoblauch und Paprikaflocken dazu und dünste sie etwa 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gekochten Oktopusstücke dazu und vermische alles, damit sie mit Knoblauchöl überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Presse Zitronensaft über den Oktopus und würze ihn mit Meersalz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate alles 3-4 Minuten, bis es durchgewärmt und an den Rändern leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Gericht auf eine Servierplatte und garniere es mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere den Oktopus warm oder bei Zimmertemperatur mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
