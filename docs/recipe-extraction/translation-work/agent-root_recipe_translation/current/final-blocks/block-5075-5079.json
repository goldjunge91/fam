      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eigelb und Zucker etwa 5 Minuten über einem Wasserbad, bis die Masse hell und warm ist. Nimm sie vom Herd und lasse sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe Mascarpone vorsichtig unter die abgekühlte Eimischung, bis sie glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Matcha-Pulver mit Milch, bis es sich aufgelöst hat. Hebe es zusammen mit Vanilleextrakt unter die Mascarponemischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tauche jeden Löffelbiskuit kurz in eine flache Schale mit der übrigen Milch und lege sie nebeneinander in eine 8x8-Zoll-Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verstreiche die Hälfte der Matcha-Mascarpone-Mischung auf den Löffelbiskuits.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege eine weitere Schicht eingetauchter Löffelbiskuits darauf und bedecke sie mit der restlichen Creme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestäube die Oberfläche mit Kakaopulver und stelle das Tiramisu mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es gekühlt und bestäube es nach Wunsch mit weiterem Kakaopulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
