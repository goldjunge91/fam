          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe sie 12-15 Minuten goldbraun, nimm sie dann heraus und lass sie 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge währenddessen die geschnittenen Erdbeeren mit Zucker und Vanilleextrakt und lass sie 5 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide jedes abgekühlte Röllchen waagerecht auf und fülle es mit Sahne und der Erdbeermischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestäube die Röllchen mit Puderzucker und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
