      "steps": [
        {
          "position": 0,
          "text": "Bringe 2 Tassen Wasser in einem Topf zum Kochen und gib die Tapiokaperlen hinein. Rühre gelegentlich um und koche sie 25-30 Minuten, bis sie durchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die gekochten Perlen ab, spüle sie mit kaltem Wasser ab und vermenge sie dann mit 1 Esslöffel braunem Zucker.",
