      "steps": [
        {
          "position": 0,
          "text": "Für Kecap Manis: Erhitze Sojasauce und braunen Zucker, bis sich der Zucker zu einer dickflüssigen süßen Sauce auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Nudeln, gieße sie ab und lass sie abkühlen. Brate Knoblauch und Zwiebel im Wok an und gib Garnelen dazu. Gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Nudeln und Sauce dazu und schwenke alles bei hoher Hitze, bis die Nudeln überzogen und leicht angeröstet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe die Nudeln an den Rand, rühre die Eier in der Mitte des Woks und vermische anschließend alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib ein Spiegelei darauf und serviere die Nudeln mit geschnittener Gurke und Sriracha.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
