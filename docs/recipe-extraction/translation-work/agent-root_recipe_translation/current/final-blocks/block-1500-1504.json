      "steps": [
        {
          "position": 0,
          "text": "Weiche die Reisnudeln 20 Minuten in warmem Wasser ein, bis sie biegsam, aber noch nicht ganz gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Für die Sauce: Vermische Fischsauce, Reisessig, braunen Zucker, 1 EL Erdnussbutter (optional) und Sriracha.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Garnelen und Tofu getrennt in sehr heißem Öl an und nimm sie heraus. Rühre die Eier im Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib abgetropfte Nudeln und Sauce dazu und schwenke alles bei hoher Hitze 2–3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Eiweißzutaten, Frühlingszwiebel und Mungobohnensprossen zurück in den Wok. Serviere das Gericht mit Limette, zerstoßenen Erdnüssen und zusätzlicher Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
