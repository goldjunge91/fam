      "steps": [
        {
          "position": 0,
          "text": "Mangoldblätter 2 Minuten in kochendem Salzwasser blanchieren, dann abgießen und trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brot 2 Minuten in Milch einweichen, dann überschüssige Flüssigkeit ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel fein hacken und in einer Pfanne weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinehackfleisch, eingeweichtes Brot, gegarte Zwiebel und Ei in einer Schüssel vermengen; mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Je 2 EL Füllung auf ein Mangoldblatt geben und aufrollen, dabei die Seiten einschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rinderbrühe in einem Topf zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Capuns vorsichtig in die köchelnde Brühe geben und 20 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Capuns in der Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
