      "steps": [
        {
          "position": 0,
          "text": "Gesalzenes Wasser in einem großen Topf sanft zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den vorbereiteten Lutfisk in portionsgerechte Stücke schneiden und in einen Pochierkorb oder ein Käsetuch legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Stücke in kochendes Wasser tauchen und 8-10 Minuten köcheln lassen, bis der Fisch zart ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Fisch vorsichtig herausnehmen und auf einer Servierplatte anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter in einem Topf schmelzen und das Mehl mit einem Schneebesen einrühren, um eine Mehlschwitze herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sahne nach und nach unter ständigem Rühren mit dem Schneebesen einarbeiten, bis die Sauce andickt, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sauce mit Salz, weißem Pfeffer und Senf würzen, über den Fisch gießen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
