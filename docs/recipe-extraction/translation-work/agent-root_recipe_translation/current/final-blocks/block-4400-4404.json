      "steps": [
        {
          "position": 0,
          "text": "Vermischen Sie Mehl und Salz, geben Sie dann Wasser und geschmolzene Butter hinzu und kneten Sie alles zu einem glatten, weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rollen Sie den Teig zwischen zwei Bögen Backpapier dünn aus und schneiden Sie daraus 3 Zoll große Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermischen Sie gekochten Reis, Milch, Ei und schwarzen Pfeffer für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie 1 Esslöffel Füllung auf jeden Teigkreis, falten Sie ihn in der Mitte und verschließen Sie die Ränder mit einer Gabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie die Piroggen auf ein gebuttertes Backblech und backen Sie sie bei 400°F 20-25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Servieren Sie die Piroggen heiß mit Butter und einem dünnen Eier-Butter-Aufstrich dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
