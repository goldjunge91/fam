      "steps": [
        {
          "position": 0,
          "text": "Erhitzen Sie die saure Sahne in einem großen Topf bei mittlerer Hitze und rühren Sie gelegentlich um, bis sie sich zu trennen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermischen Sie in einer separaten Schüssel das Mehl mit etwas kalter Milch zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühren Sie die Mehlpaste langsam mit einem Schneebesen in die heiße saure Sahne ein und rühren Sie ständig, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie die restliche Milch, Butter, Salz, Pfeffer und Zimt hinzu und rühren Sie, bis die Mischung die Konsistenz eines dicken Breis erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lassen Sie alles 5 Minuten köcheln und rühren Sie häufig um, bis die Sauce nach oben steigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteilen Sie den Brei auf Schalen und geben Sie auf jede Portion Marmelade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
