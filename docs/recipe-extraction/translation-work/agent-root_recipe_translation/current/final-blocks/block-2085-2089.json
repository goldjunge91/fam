      "steps": [
        {
          "position": 0,
          "text": "1 Backofen auf 230°C vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Zucker und frische Hefe in das warme Wasser bröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "3 Die Mischung 10–15 Minuten an einem warmen Ort stehen lassen (wir finden eine sonnige Fensterbank am besten), bis sich Schaum an der Oberfläche bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "4 Mehl und Salz in eine große Rührschüssel sieben, in der Mitte eine Mulde formen und Hefemischung sowie Olivenöl hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "5 Hände leicht bemehlen und die Zutaten langsam vermischen, bis sie sich verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "6 Arbeitsfläche großzügig mit Mehl bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "7 Teig auf die Fläche geben und 10 Minuten kneten, bis er glatt, seidig und weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "8 Auf ein leicht geöltes, antihaftbeschichtetes Backblech legen (wir verwenden ein rundes, aber jede Form ist geeignet!).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "9 Passata darauf verstreichen und bis zum Rand verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "10 Mozzarella (oder einen anderen Käse) gleichmäßig darauf verteilen, mit Oregano und schwarzem Pfeffer würzen und mit etwas Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
