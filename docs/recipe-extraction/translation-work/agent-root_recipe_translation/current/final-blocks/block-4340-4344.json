      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 425°F vorheizen und den Pastetenboden in eine 9-Zoll-Pastetenform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Butter in einem Topf schmelzen und die gewürfelte Zwiebel etwa 3 Minuten glasig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Mehl über die Zwiebeln streuen und unter ständigem Rühren 1 Minute anschwitzen, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Milch und Weißwein nach und nach unter ständigem Rühren einrühren, bis die Sauce andickt, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Senf, Salz, Pfeffer und Hummerfleisch einrühren und 2 Minuten erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hummerfüllung in den Pastetenboden gießen und die Ränder mit verquirltem Eigelb bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "25-30 Minuten backen, bis der Teig goldbraun ist und die Füllung am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
