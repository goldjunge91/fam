      "steps": [
        {
          "position": 0,
          "text": "Zubereitung: Bringe eine groß Topf von Salzed Wasser zu koche und koche spaghetti nach Packungsanleitung, anschließend abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zubereitung: Clean razor Muscheln under kalt Wasser und entferne die tough neck skin nach Wunsch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zubereitung: Erhitze das Olivenöl in eine groß skillass und sauté Knoblauch bis fragrant, etwa 1 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib razor Muscheln und Weißwein, dann decke ab und koche für 3-4 Minuten bis Muscheln open.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zubereitung: Rühre in zerdrückt Tomaten und rot Pfeffer flakes, dann köchle für 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entsorge jede Muscheln that did not open.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge gekocht spaghetti mit Muschel Soße und belege mit frisch Petersilie, Salz, und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zubereitung: Serviere sofort mit zusätzlich Soße spooned über die belege.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
