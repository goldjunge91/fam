      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 325°F vorheizen und eine 2-Quart-Backform mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "3 Tassen Milch in einem Topf erhitzen, bis Dampf aufsteigt, dann den Maisgrieß langsam unter ständigem Rühren einrieseln lassen, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Melasse, Butter, Ingwer, Zimt und Salz einrühren und 2 Minuten kochen, bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Eier in einer Schüssel verquirlen und angleichen, indem die heiße Milchmischung unter ständigem Rühren langsam hinzugefügt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Alles in die vorbereitete Backform gießen und mit der übrigen 1 Tasse kalter Milch bedecken, ohne umzurühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "60-75 Minuten backen, bis die Oberfläche gebräunt ist und ein in die Mitte gestochenes Messer sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "10 Minuten abkühlen lassen und warm mit Vanilleeis oder Schlagsahne servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
