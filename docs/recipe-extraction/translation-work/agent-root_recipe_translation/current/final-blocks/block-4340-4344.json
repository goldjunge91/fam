      "steps": [
        {
          "position": 0,
          "text": "Die Brühe in einem separaten Topf erhitzen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Olivenöl in einer großen Pfanne erhitzen und die Pilze mit dem Thymian etwa 8 Minuten goldbraun braten, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne 1 Esslöffel Butter schmelzen und die gewürfelte Zwiebel mit dem Knoblauch glasig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Arborio-Reis hinzufügen und unter ständigem Rühren 2 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Weißwein über den Reis gießen und rühren, bis er größtenteils aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die warme Brühe nach und nach schöpfkellenweise hinzufügen, dabei ständig rühren und jeweils warten, bis die Brühe aufgenommen ist, bevor die nächste Kelle dazukommt, insgesamt etwa 18-20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn der Reis cremig und zart ist, die übrigen 3 Esslöffel Butter, den Parmesan und die gegarten Pilze unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer abschmecken und sofort in flachen Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
