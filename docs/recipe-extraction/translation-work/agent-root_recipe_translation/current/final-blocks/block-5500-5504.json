      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilis. Röste sie in einer trockenen Pfanne 1-2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die weichen Chilis mit 1 cup Einweichwasser, Zwiebel, Knoblauch, Essig, Kreuzkümmel und Oregano glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze die Rinderschulter mit Salz und Pfeffer. Bräune sie in einem großen Topf bei mittlerer bis hoher Hitze 8-10 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seihe die Chilisauce ab und gieße sie über das Fleisch. Gib Rinderbrühe und Lorbeerblätter dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf ab und lasse das Fleisch 2.5-3 Stunden köcheln, bis es butterzart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Fleisch heraus, zupfe es mit Gabeln auseinander und gib es zurück in die Brühe. Lasse es weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erwärme die Tortillas. Serviere die Birria in flachen Schüsseln mit gezupftem Fleisch und Brühe, dazu Limette und Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
