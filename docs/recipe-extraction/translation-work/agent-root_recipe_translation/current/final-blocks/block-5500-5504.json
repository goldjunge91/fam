          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schöpfe Gemüse und Brühe über den gekochten Reis in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gegarten Rindfleischscheiben darauf und garniere mit Frühlingszwiebeln.",
