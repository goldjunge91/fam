      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis nach Packungsanleitung und verteile ihn auf zwei Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze. Gib das Rinderhackfleisch dazu und brate es unter Zerteilen 5-7 Minuten an, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Ingwer dazu und brate ihn 1 Minute mit. Gieße Sojasauce, Mirin, Zucker und Dashi-Brühe hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Fleischmischung 3-4 Minuten köcheln, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schiebe das Fleisch an den Rand der Pfanne und rühre die Eier in der Mitte 2-3 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die Erbsen ein und gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Fleisch-Ei-Mischung auf den Reisschüsseln und gieße übrige Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
