      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Guajillo- und Chipotle-Chilis 1-2 Minuten in einer trockenen Pfanne an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein. Püriere sie anschließend mit 1.5 cups Einweichwasser, Tomatenmark, Zwiebel, Knoblauch, Essig, Kreuzkümmel, Oregano und Nelken glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Rinderschulter mit Salz und Pfeffer und bräune sie in einem großen Topf 8-10 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Chili-Tomaten-Sauce ab und gieße sie über das Fleisch. Gib Rinderbrühe dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf ab und lasse alles 2.5-3 Stunden köcheln, bis das Fleisch leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Fleisch heraus, zupfe es auseinander und gib es für 15 Minuten zurück in den Topf, damit es Geschmack aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Birria in flachen Schüsseln mit gezupftem Fleisch, Brühe und warmen Tortillas. Dazu Limettenspalten reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
