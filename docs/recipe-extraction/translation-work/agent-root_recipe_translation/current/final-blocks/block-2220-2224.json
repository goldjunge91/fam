      "steps": [
        {
          "position": 0,
          "text": "Reis unter kaltem Wasser abspülen, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln in Olivenöl weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürze dazugeben und rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Übrige Zutaten dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sanft zum Kochen bringen und dann 30 Minuten köcheln lassen, bis die Brühe vollständig aufgenommen und der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Als Beilage oder Füllung für Dolmas servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
