      "steps": [
        {
          "position": 0,
          "text": "2 Esslöffel Öl in einer großen Pfanne oder einem Topf bei mittlerer Hitze erhitzen, bis es schimmert. Zwiebeln dazugeben und unter gelegentlichem Rühren 5 bis 7 Minuten weich garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinerten Grünkohl zu den Zwiebeln geben und gut vermengen. Hitze auf mittelniedrig stellen, abdecken und 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nach 5 Minuten Deckel abnehmen, nach Geschmack salzen und Sahne einrühren. Weitere 5 Minuten ohne Deckel garen und gelegentlich umrühren. Die Sahne dickt leicht ein und macht den Grünkohl mit Zwiebeln köstlich cremig. Lecker!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit deinem kenianischen Lieblingseintopf und Ugali als Beilage servieren!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
