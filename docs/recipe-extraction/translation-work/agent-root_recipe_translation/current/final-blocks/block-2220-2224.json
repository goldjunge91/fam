      "steps": [
        {
          "position": 0,
          "text": "Mandelboden",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backofen auf 345°F (175°C) vorheizen und Kuchenform einfetten (ich verwende eine Springform von 27 cm). Nach Wunsch Boden mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mandeln in einer Mandelmühle oder Küchenmaschine mahlen. Ich lasse sie gern etwas grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier und Zucker vorsichtig verquirlen, bis alles vermengt ist, nicht länger. Gemahlene Mandeln, Mehl und Backpulver einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in die Form gießen und etwa 45–50 Minuten backen. Darauf achten, dass die Oberfläche nicht anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gelbe Eiercreme",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eigelb, Sahne, Zucker und Vanille in einen Topf geben. Bei niedriger bis mittlerer Hitze unter ständigem Rühren etwa 15 Minuten erhitzen, bis die Mischung eindickt. Hitze erhöhen, falls sie nicht eindickt, aber nicht kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mischung auf Zimmertemperatur abkühlen lassen und dann Butter dazugeben. Für eine luftige Eiercreme kann ein elektrischer Mixer verwendet werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Zusammensetzen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Kuchen vollständig abkühlen lassen, bevor er aus der Form genommen und mit Creme überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
