      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze die Hühnerbrühe in einem separaten Topf und halte sie auf dem Herd warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste die gewürfelte Zwiebel etwa 3 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Arborio-Reis dazu und rühre 2 Minuten ständig, bis die Körner am Rand leicht glasig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein dazu und rühre, bis er fast vollständig aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib schöpflöffelweise warme Brühe dazu und rühre häufig. Warte jeweils, bis die Flüssigkeit aufgenommen ist, bevor du mehr zugibst (insgesamt etwa 18-20 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn der Reis cremig und weich, aber noch leicht bissfest ist, rühre die Tintenfischtinte ein, bis sie gleichmäßig verteilt ist und der Reis schwarz wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Pfanne vom Herd und rühre Butter und Parmesan ein, bis das Risotto cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Würze mit Salz und Pfeffer und serviere das Risotto sofort in warmen Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
