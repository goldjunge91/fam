      "steps": [
        {
          "position": 0,
          "text": "Weiche Kidneybohnen mindestens 6 Stunden oder über Nacht in Wasser ein. Gieße sie anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die eingeweichten Bohnen in frischem Wasser 45-50 Minuten weich. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke Zwiebeln, Tomaten, Knoblauch und Ingwer fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem großen Topf und gib Kreuzkümmelsamen dazu. Lasse sie 30 Sekunden knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gehackten Zwiebeln dazu und gare sie 3-4 Minuten, bis sie glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Knoblauch und Ingwer dazu und gare alles 1 Minute. Füge dann Tomaten hinzu und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Kurkuma, Chilipulver und Salz ein. Gib die gegarten Bohnen dazu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischem Koriander und serviere es heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
