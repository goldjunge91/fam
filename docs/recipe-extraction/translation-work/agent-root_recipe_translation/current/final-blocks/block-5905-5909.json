      "steps": [
        {
          "position": 0,
          "text": "Spüle die braunen Linsen ab und gib sie mit 3 Tassen Wasser in einen Topf. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lasse die Linsen 20 Minuten köcheln, bis sie teilweise gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Zwiebeln in dünne Scheiben und erhitze 3 Esslöffel Olivenöl in einer Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare die Hälfte der Zwiebeln bei mittlerer Hitze 8-10 Minuten goldbraun und karamellisiert. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die übrigen Zwiebeln mit Bulgur, Gemüsebrühe, Kreuzkümmel, Salz und Pfeffer zu den Linsen in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles 15-20 Minuten köcheln, bis Linsen und Bulgur weich sind und die Flüssigkeit aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Zitronensaft und die übrigen 2 Esslöffel Olivenöl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Gericht in eine Servierschüssel und belege es vor dem Servieren mit den karamellisierten Zwiebeln.",
