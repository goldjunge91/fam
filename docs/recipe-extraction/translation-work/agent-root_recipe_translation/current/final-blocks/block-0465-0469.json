      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhack und gehackte rote Zwiebel in einer großen Pfanne bei mittlerer Hitze. Zerkleinere das Fleisch beim Braten, bis kein rosa Fleisch mehr zu sehen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße überschüssiges Fett und Flüssigkeit aus der Pfanne ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre den abgetropften Mais, Tortillastücke, Salsa oder Taco-Soße und etwa 1 Tasse Cheddar ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare alles unter gelegentlichem Rühren weiter, bis es blubbert und durchgewärmt ist und die Tortillas weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den restlichen Cheddar darauf und lass ihn schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib nach Wunsch etwas scharfe Soße darüber und serviere das Gericht mit saurer Sahne, Frühlingszwiebel, Tomate, Koriander und zusätzlicher Salsa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
