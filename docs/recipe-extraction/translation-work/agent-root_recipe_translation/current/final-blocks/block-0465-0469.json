              "source_note": "gerieben fettreduziert, etwa 2 Tassen"
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 350 F (175 C) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die großen Muschelnudeln nach Packungsanleitung, bis sie gerade weich sind. Gieße sie ab und spüle sie mit kaltem Wasser, damit sie nicht weitergaren und sich leichter füllen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fette eine 13x9-Zoll-Auflaufform leicht ein und verteile etwa 1/2 Tasse Marinara-Soße auf dem Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze in jede Muschelnudel ein Fleischbällchen und ordne sie in der Form über der Soße an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die restliche Marinara-Soße über die gefüllten Muschelnudeln und verteile Mozzarella darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form ab und backe sie 35 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Deckel ab und backe alles weitere 3 bis 5 Minuten, bis die Soße blubbert und der Käse vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
