      "steps": [
        {
          "position": 0,
          "text": "Säubere die Lebern von Sehnen und Gallenresten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib sie mit allen übrigen grob gehackten Zutaten in eine feuerfeste Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Mischung und bedecke sie mit Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze den Deckel auf die Form und gare alles bei niedriger Ofentemperatur (300ºF) 2 Stunden lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Püriere die Masse im Mixer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke sie ab und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Sherry oder Brandy dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die Pastete in eine Form und bedecke sie mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
