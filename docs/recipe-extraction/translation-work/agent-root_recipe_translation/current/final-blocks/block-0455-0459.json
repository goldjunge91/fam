      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375 F vor und fette eine 9-Zoll-Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme die grüne Enchilada-Soße in einer kleinen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tauche 4 Tortillas nacheinander in die Soße, sodass beide Seiten überzogen sind. Lege sie überlappend auf den Boden der Auflaufform, bis dieser bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile 1 Tasse Hähnchen, 1 Tasse Cheddar und 2 EL geschnittene Oliven darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege eine zweite Lage in Soße getauchter Tortillas darauf und gib das übrige Hähnchen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße übrige Enchilada-Soße darüber und schließe mit dem restlichen Cheddar und den Oliven ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Auflauf 10 bis 15 Minuten, bis er durchgewärmt und der Käse vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide ihn in Stücke und serviere ihn nach Wunsch mit Salsa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
