      "steps": [
        {
          "position": 0,
          "text": "Trockenfrüchte, Rindertalg, Paniermehl, braunen Zucker, geriebenen Apfel und gemahlene Mandeln in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer zweiten Schüssel die Eier verquirlen und nach Wunsch den Brandy einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Eiermischung mit den trockenen Zutaten vermengen und Zimt sowie Muskatnuss hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Alles gründlich verrühren, bis die Zutaten gleichmäßig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Masse auf zwei gefettete Puddingformen verteilen und mit Backpapier und Alufolie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Im Wasserbad 3 Stunden dämpfen und dabei den Wasserstand konstant halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vollständig abkühlen lassen, einwickeln und bis zu 3 Monate kühl lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren erneut 1–2 Stunden dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
