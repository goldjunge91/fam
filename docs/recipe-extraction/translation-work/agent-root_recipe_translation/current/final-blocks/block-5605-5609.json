      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 400°F vorheizen. Jakobsmuschelschalen säubern oder feuerfeste Förmchen bereitstellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schalotten und Champignons fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Butter in einer Pfanne schmelzen und Schalotten sowie Champignons darin anbraten, bis die Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die gewürfelten Jakobsmuscheln, Weißwein und Fischfond hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Jakobsmuscheln mit einer Schaumkelle herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Garflüssigkeit bei mittlerer bis hoher Hitze auf die Hälfte einkochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sahne einrühren und 3 Minuten köcheln lassen, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Jakobsmuscheln zurück in die Sauce geben und mit Salz und weißem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Die Mischung auf die Schalen verteilen, mit Gruyère und Paniermehl bestreuen und mit der restlichen Butter belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "12–15 Minuten backen, bis die Oberfläche goldbraun und die Sauce blubbernd ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
