      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 425°F vorheizen und ein Backblech mit Alufolie auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hähnchenflügel mit Küchenpapier trocken tupfen und mit Öl, Salz und Pfeffer vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Flügel nebeneinander auf dem Backblech verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "30–35 Minuten backen, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Währenddessen die Butter in einem kleinen Topf bei niedriger Hitze schmelzen. Frank’s-Sauce, Knoblauchpulver, Zwiebelpulver und Cayennepfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Sauce 2–3 Minuten unter gelegentlichem Rühren köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die gebackenen Flügel in eine große Schüssel geben und mit der scharfen Sauce übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vorsichtig wenden, bis die Flügel gleichmäßig überzogen sind, und sofort mit Ranch- oder Blauschimmelkäse-Dip servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
