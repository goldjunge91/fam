      "steps": [
        {
          "position": 0,
          "text": "Stutze die Artischockenstiele und schneide das obere 1/4 jeder Artischocke ab. Halbiere sie dann der Länge nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schabe mit einem Löffel die haarige Mitte heraus und wirf sie weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische gehackte Petersilie, gehackten Knoblauch, Semmelbrösel, geriebenen Pecorino Romano, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Kräutermischung gleichmäßig in die Mitte jeder Artischockenhälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Artischocken mit der Schnittseite nach oben dicht nebeneinander in einen schweren Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Olivenöl und Zitronensaft darüber und gib dann Wasser dazu, bis die Seiten zur Hälfte bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf ab und lasse alles 30-40 Minuten sanft köcheln, bis die Artischockenherzen beim Einstechen mit einer Gabel zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm oder bei Raumtemperatur und löffle Kochflüssigkeit über jede Artischocke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
