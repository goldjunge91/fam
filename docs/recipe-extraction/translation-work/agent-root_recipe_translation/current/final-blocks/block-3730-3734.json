      "steps": [
        {
          "position": 0,
          "text": "Tupfe den Ochsenschwanz mit Küchenpapier trocken und würze ihn großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und bräune die Ochsenschwanzstücke portionsweise insgesamt etwa 10 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Ochsenschwanz heraus und stelle ihn beiseite. Dünste dann gehackte Zwiebel, Karotten und Sellerie im selben Topf 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche den Topf mit Rotwein ab und löse die Röstspuren vom Boden. Gib dann Tomaten aus der Dose und Rinderbrühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Ochsenschwanz und Lorbeerblätter zurück in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf teilweise ab und lasse alles 2.5-3 Stunden sanft köcheln, bis das Fleisch sehr zart ist und vom Knochen fällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schöpfe überschüssiges Fett von der Oberfläche ab, würze mit Salz und Pfeffer und serviere das Gericht heiß mit Schmorflüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
