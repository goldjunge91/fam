      "steps": [
        {
          "position": 0,
          "text": "Teile das Rinderhackfleisch in zwei gleich große Portionen. Forme daraus Bratlinge, die etwas größer als die Brötchen sind, und drücke mit dem Daumen eine flache Mulde in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze beide Seiten der Bratlinge großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine gusseiserne Pfanne oder den Grill, bis sie beziehungsweise er sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Bratlinge für einen mittleren Gargrad etwa 2-3 Minuten pro Seite. Drücke sie nicht herunter und brate sie, bis die Außenseite kräftig gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Briochebrötchen mit der Schnittseite nach unten 1-2 Minuten auf dem heißen Grill, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die untere Brötchenhälfte mit Mayonnaise und die obere mit Ketchup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die untere Brötchenhälfte mit Salat, Tomatenscheiben, dem gebratenen Patty, Zwiebelscheiben und Gewürzgurken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Setze die obere Brötchenhälfte auf und serviere den Burger sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
