      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Fischfilets mit Küchenpapier trocken und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, eine mit verquirltem Ei und eine mit Panko-Semmelbröseln und einer Prise Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Filet im Mehl und klopfe Überschuss ab. Tauche es ins Ei und wende es anschließend in den Panko-Bröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Öl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die panierten Filets vorsichtig 3-4 Minuten pro Seite, bis sie goldbraun sind und der Fisch leicht auseinanderblättert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die English Muffins im Toaster oder Backofen leicht goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche beide Hälften jedes Muffins mit Remoulade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege ein gebratenes Filet auf die untere Muffinhälfte, gib eine Käsescheibe darauf, setze die obere Hälfte auf und serviere den Burger sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
