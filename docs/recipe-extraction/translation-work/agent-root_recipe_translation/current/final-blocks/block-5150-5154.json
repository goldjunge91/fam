      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eigelb und Zucker etwa 2 Minuten, bis die Masse hell und dickflüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sahne und Milch in einem Topf bei mittlerer Hitze, bis Dampf aufsteigt, aber die Flüssigkeit nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die heiße Sahnemischung unter ständigem Rühren langsam zum Eigelb, damit es sich temperiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Mischung zurück in den Topf und erhitze sie bei niedriger Hitze unter ständigem Rühren, bis sie 160°F erreicht und einen Löffel überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Masse durch ein feines Sieb in eine Schüssel und lasse sie auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre das Aktivkohlepulver in die abgekühlte Creme, bis es vollständig und klümpchenfrei eingearbeitet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Vanilleextrakt und Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kühle die Mischung mindestens 2 Stunden im Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gefriere die Masse in der Eismaschine nach Herstelleranleitung und anschließend vor dem Servieren 4 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
