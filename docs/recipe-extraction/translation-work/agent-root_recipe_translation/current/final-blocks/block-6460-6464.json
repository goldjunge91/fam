      "steps": [
        {
          "position": 0,
          "text": "Buchweizenmehl, Allzweckmehl und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In der Mitte eine Mulde formen und 2 Eier hineinschlagen, dann nach und nach Milch und Wasser unter Rühren hinzufügen, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine beschichtete Crêpe-Pfanne oder Bratpfanne bei mittlerer bis hoher Hitze erhitzen und leicht mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "0.25 Tasse Teig in die Pfanne gießen, die Pfanne sofort schwenken und den Teig etwa 1 Minute dünn ausbacken, bis die Unterseite hellgolden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drehen Sie den Crêpe um und legen Sie eine Schinkenscheibe und 3 Esslöffel Käse auf eine Hälfte. Schlagen Sie dann ein Ei auf die andere Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kochen, bis das Eiweiß fest ist (ca. 2-3 Minuten), dann den Crêpe in zwei Hälften falten und auf einen Teller gleiten lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
