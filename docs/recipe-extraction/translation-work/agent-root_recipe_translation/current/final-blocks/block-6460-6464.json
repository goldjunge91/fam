      "steps": [
        {
          "position": 0,
          "text": "Gurken schälen, der Länge nach halbieren und in 0.5 Zoll dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel fein würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer großen Pfanne schmelzen und die Zwiebel darin anbraten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gurkenstücke hinzufügen und unter leichtem Rühren 3 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Rinderbrühe, Essig und Zucker aufgießen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "15–20 Minuten köcheln lassen, bis die Gurken weich, aber noch leicht fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Dill und Sauerrahm vorsichtig unterrühren, dann erhitzen, ohne zu kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm als Beilage oder leichtes Hauptgericht servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
