      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie die Magenschleimhaut und den Darm des Schweins gründlich unter fließendem kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweineschulter und -därme in kleine Stücke schneiden und zusammen mit gehacktem Knoblauch und Schalotten zermahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hackfleisch mit Salz, Pfeffer, Wein und Thymianblättern gründlich vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füllen Sie die Mischung mit einem Wurstfüller fest in die vorbereitete Magenschleimhaut oder den Dickdarm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Binden Sie die Enden mit Küchengarn fest zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Andouille 90 Minuten lang in kochendem Wasser pochieren, bis sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lassen Sie es vollständig abkühlen und stellen Sie es dann in den Kühlschrank, bevor Sie es in Scheiben schneiden und gegrillt oder mit Senf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
