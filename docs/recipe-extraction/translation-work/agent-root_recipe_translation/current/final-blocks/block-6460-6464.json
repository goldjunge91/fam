      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 375 °F vorheizen und die Ente innen und außen mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Entenhohlraum mit geviertelten Zwiebeln, Karottenstücken und Apfelstücken füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Entenhaut mit Salz und Pfeffer würzen und dann mit der Brust nach oben auf einen Bräter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "30 Minuten braten, dann die Ofentemperatur auf 350 °F reduzieren und weitere 90 Minuten braten. Dabei das ausgelassene Fett regelmäßig abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Ente auf ein Schneidebrett legen und 10 Minuten ruhen lassen, dann den Vogel vierteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bräter auf den Herd stellen, mit Rinderbrühe ablöschen, Thymian und Lorbeerblatt hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sauce abseihen und mit geschnitzten Entenstücken und Salzkartoffeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
