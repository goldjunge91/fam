      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie zwei runde 9-Zoll-Kuchenformen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Zucker, Kakaopulver, Backpulver und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer anderen Schüssel Eier, Buttermilch, Öl, Essig, rote Lebensmittelfarbe und Vanille verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie die feuchten Zutaten in die trockenen Zutaten und vermischen Sie alles, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig gleichmäßig auf die vorbereiteten Pfannen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "30–35 Minuten backen, bis ein Zahnstocher in der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kühlen Sie die Kuchen 10 Minuten lang in der Form ab und stürzen Sie sie dann auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zum Zuckerguss weichen Frischkäse und Butter glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nach und nach Puderzucker und Vanille hinzufügen und rühren, bis die Masse leicht und schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Sobald die Kuchen abgekühlt sind, verteilen Sie den Zuckerguss zwischen den Schichten und auf der Außenseite des Kuchens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
