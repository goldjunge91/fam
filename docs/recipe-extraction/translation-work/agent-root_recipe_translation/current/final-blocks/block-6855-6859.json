      "steps": [
        {
          "position": 0,
          "text": "Den Speck knusprig braten, dann abtropfen lassen und in Stücke zerbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem Topf bei mittlerer Hitze schmelzen und Mehl unterrühren, sodass eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Unter ständigem Rühren nach und nach Milch zugießen, bis eine glatte Soße entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Käse, Salz und Pfeffer zur Sauce geben und rühren, bis sie geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Toasten Sie die Brotscheiben leicht und legen Sie zwei Scheiben auf jeden Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Putenbrustscheiben auf den Toast legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tomaten in Scheiben schneiden und über dem Truthahn anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gießen Sie die Käsesauce großzügig über das Sandwich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit zerbröckeltem Speck belegen und 2–3 Minuten unter den Grill legen, bis die Soße Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
