      "steps": [
        {
          "position": 0,
          "text": "Braunen Zucker, Paprika, Knoblauchpulver, schwarzen Pfeffer und Salz in einer Schüssel vermischen, um eine Trockenreibe zu erzeugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das gesamte Bruststück großzügig mit der Trockenmasse bestreichen und 2 Stunden bei Zimmertemperatur ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 325 °F vor und legen Sie das Bruststück mit der Fettseite nach oben in eine große Bratpfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe, Worcestershire-Sauce und Apfelessig vermischen und um das Bruststück gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decken Sie die Pfanne fest mit Folie ab und backen Sie sie 5–6 Stunden lang, bis das Fleisch sehr zart ist und sich leicht auseinanderziehen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entfernen Sie die Folie, erhöhen Sie die Hitze auf 400 °F und backen Sie sie 30 Minuten lang ohne Deckel, damit sich eine Rinde bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15 Minuten ruhen lassen, dann gegen die Faserrichtung in 1/4 cm dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Scheiben mit zerlassener Butter bestreichen und mit Bratenfett als Soße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
