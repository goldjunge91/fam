      "steps": [
        {
          "position": 0,
          "text": "Koche die Pasta und hebe etwas Nudelwasser auf. Brate den Lachs 4 Minuten pro Seite in Olivenöl an. Zerzupfe ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Knoblauch 30 Sekunden an. Nimm die Pfanne vom Herd und rühre griechischen Joghurt, Zitrone, Dill und einen Schuss Nudelwasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle die Pfanne zurück auf niedrige Hitze (nicht kochen lassen, sonst gerinnt der Joghurt). Gib Spinat und zerzupften Lachs dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge die Pasta mit der Soße. Garniere sie mit Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
