    {
      "externalId": "waivy:mfr-salmon-yogurt-cream-pasta",
      "slug": "mfr-salmon-yogurt-cream-pasta",
      "title": "Pasta mit Lachs und Zitronencreme",
      "instructions": "Zerzupfter Lachs in einer leichten Creme aus griechischem Joghurt mit Zitrone und Dill: der ganze Genuss einer cremigen Pasta ohne Sahne und obendrein 36 g Eiweiß.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 18,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Griechischer Joghurt ergibt eine überzeugende cremige Soße mit einem Bruchteil des Fetts und der Kosten von Schlagsahne.",
        "Lachs aus der Dose eignet sich genauso gut. Zerzupfe ihn und gib ihn während der Zubereitung der Soße dazu."
      ],
      "substitutions": [
        {
          "forIngredientId": "salmon",
          "swap": "Lachs oder Thunfisch aus der Dose"
        },
        {
