      "steps": [
        {
          "position": 0,
          "text": "Lege Schweineschnitzel zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 0.25 Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, eine mit verquirltem Ei und eine mit Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Schnitzel in Mehl, dann in Ei und anschließend in Semmelbröseln. Drücke die Panade leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Schnitzel 3-4 Minuten pro Seite goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und presse frischen Zitronensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Brötchen waagerecht auf und bestreiche die unteren Hälften mit Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege die Brötchen mit Rucola und Tomatenscheiben, gib die Schnitzel darauf und serviere sie mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
