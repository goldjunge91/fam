      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweineschulter in Stücke und koche sie 25 Minuten in kochendem Salzwasser, bis sie zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerpflücke das gegarte Schweinefleisch mit zwei Gabeln und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste gewürfelte Zwiebel und gehackten Knoblauch 2 Minuten in Öl, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomatensauce und Chipotle-Chilis in die Pfanne und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Püriere die Sauce mit einem Stabmixer glatt oder fülle sie dafür in einen Mixer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze die Sauce mit Limettensaft und Salz und gib dann das zerpflückte Schweinefleisch hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Brötchen waagerecht auf und bestreiche die unteren Hälften mit Bohnenmus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege sie mit zerpflücktem Schweinefleisch und schöpfe reichlich Sauce über das Sandwich, bis es durchtränkt ist. Sofort mit zusätzlicher Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
