      "steps": [
        {
          "position": 0,
          "text": "Mehl, Hefe und Salz in einer großen Schüssel vermischen, dann warmes Wasser und 2 Esslöffel Olivenöl hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kneten, bis ein zottiger Teig entsteht, dann 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine rechteckige Backform (9 x 13 Zoll) mit 1 Esslöffel Olivenöl einölen und den Teig ausdrücken, um ihn gleichmäßig zu füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig 20 Minuten gehen lassen, bis er aufgeht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatensauce gleichmäßig auf dem Teig verteilen, dabei einen kleinen Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Mozzarella-Käse über die Soße verteilen, dann Peperoni darüberstreuen und mit Cheddar-Käse abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "475–15 Minuten bei 18 °C backen, bis die Kruste golden ist und der Käse Blasen bildet und an den Rändern leicht knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Schneiden in Quadrate 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
