        {
          "position": 0,
          "text": "Maisschalen 30 Minuten in warmem Wasser einweichen, damit sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmalz mit einem Mixer 5 Minuten lang schaumig schlagen, dann Masa Harina, Hühnerbrühe, Backpulver und Salz untermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerkleinertes Hähnchen mit roter Chilisauce und gewürfelten Zwiebeln vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Legen Sie eine eingeweichte Maisschale flach hin und verteilen Sie 2 Esslöffel Masa in der Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie 1 Esslöffel Hühnermischung in die Mitte der Masa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falten Sie beide Längsseiten der Schale über die Füllung und falten Sie dann die spitze Unterseite nach oben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stellen Sie die Tamales aufrecht in einen Dampfgartopf mit Wasser darunter, bedecken Sie sie mit zusätzlichen Schalen und dämpfen Sie sie 45 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
