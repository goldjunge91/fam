      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eiweiß und Zucker schaumig schlagen, dann das Mehl vorsichtig unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschmolzene Butter, Vanilleextrakt und Wasser einrühren, bis eine glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 Esslöffel Teig im Abstand von 3 cm auf das Backblech geben und 5–7 Minuten backen, bis die Ränder goldbraun werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aus dem Ofen nehmen und schnell ein Vermögen auf den Keks legen, dann in zwei Hälften falten und dann über einen Glasrand zu einem Dreieck formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abkühlen lassen und 1 Minute fest werden lassen, dann aus dem Glas nehmen und mit der Naht nach unten hinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem restlichen Teig wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
