      "steps": [
        {
          "position": 0,
          "text": "Die Lammkeule mit Salz, Pfeffer, der Hälfte des Pimentes und gehacktem Knoblauch einreiben und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Heizen Sie den Ofen auf 375 °F vor und braten Sie das Lamm 1 Stunde lang, bis es eine Innentemperatur von 145 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Während das Lammfleisch gebraten wird, den Bulgurweizen 15 Minuten lang in warmem Wasser einweichen, bis er weich ist, und dann gut abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lammhackfleisch mit Zwiebelwürfeln in einer Pfanne anbraten, dann den restlichen Piment, die Hälfte der Minze sowie Salz und Pfeffer unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das gegarte Lammhackfleisch mit dem abgetropften Bulgurweizen vermischen und zu ovalen Pastetchen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kibbeh-Pastetchen in Olivenöl bei mittlerer Hitze 3-4 Minuten pro Seite braten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pinienkerne in einer trockenen Pfanne ca. 3 Minuten rösten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lassen Sie das Lamm 10 Minuten ruhen, schneiden Sie es dann in Scheiben und servieren Sie es mit Kibbeh-Pastetchen, die mit gerösteten Pinienkernen und der restlichen frischen Minze belegt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
