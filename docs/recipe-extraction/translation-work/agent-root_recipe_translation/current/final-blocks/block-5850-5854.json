      "steps": [
        {
          "position": 0,
          "text": "Cut tempeh into 1-inch cubes und Pfanne-fry in 1 Esslöffel Öl over mittlerer Erhitze bis golden on all sides, about 8 Minuten, then set aside.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze remaining Öl und sauté Knoblauch, ginger, galangal, und red chili für 1 Minute bis fragrant.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib sliced Zwiebel und Koche für 2 Minuten bis softened.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "rühre in turmeric powder und Koche für 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib coconut milk und bring to a gentle köcheln, then Gib fried tempeh cubes.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "köcheln uncovered für 15-20 Minuten, stirring occasionally, bis Sauce reduces und coats the tempeh und Öl separates slightly (characteristic of true rendang).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Finish mit lime juice, Salz, und Pfeffer to taste, then Serviere mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
