          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verstreiche die Mischung 1/4-inch dick auf einem nassen Backblech und lasse sie vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide mit einem Glas oder Ausstecher 2-inch große Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Kreise in eine gebutterte Auflaufform und setze Butterflöckchen sowie Parmesan darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe sie bei 400°F 15-20 Minuten goldbraun und oben knusprig.",
