      "steps": [
        {
          "position": 0,
          "text": "Koche Spaghetti in kochendem Salzwasser bissfest und bewahre vor dem Abgießen 1 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate währenddessen gewürfelten Guanciale etwa 5 Minuten in einer großen Pfanne bei mittlerer Hitze knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre schwarzen Pfeffer unter den Guanciale und nimm die Pfanne vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib heiße, abgetropfte Pasta in die Pfanne mit Guanciale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und gib 3/4 cup geriebenen Pecorino Romano unter ständigem Schwenken dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib nach und nach Nudelwasser hinzu, um ohne Milchprodukte eine cremige Sauce zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht sofort mit zusätzlichem Pecorino Romano und frisch gemahlenem schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
