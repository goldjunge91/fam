      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl und bräune gemahlenes Kaninchenfleisch an. Zerteile es dabei mit einem Löffel und nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste im selben Topf Zwiebel, Karotte und Sellerie etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wein dazu, löse die Röstspuren vom Topfboden und gib dann Tomaten und Wacholderbeeren dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kaninchenfleisch zurück in den Topf und lasse alles ohne Deckel 45 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer. Die Sauce sollte kräftig und konzentriert sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche Pappardelle in kochendem Salzwasser bissfest und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische die Pasta mit der Sauce und serviere sie mit geriebenem Parmesan bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
