      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "1 lb Linsen für $2 ergibt 4 großzügige Portionen – eines der preiswertesten Gerichte überhaupt.",
        "Die Gewürze in Öl anzurösten, die Tadka-Technik, ist der Schlüssel zu einem tiefen, vielschichtigen Aroma."
      ],
      "substitutions": [
        {
          "forIngredientId": "lentils",
          "swap": "Rote Spaltlinsen verwenden. Sie garen schneller (20 Minuten) und ergeben einen seidigen Eintopf."
        }
