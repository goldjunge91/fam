      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem schweren Topf bei mittlerer Hitze. Gare die gewürfelten Zwiebeln etwa 10 Minuten, bis sie goldbraun sind. Das bildet die Geschmacksgrundlage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch, Ingwer und alle Gewürze dazu und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib abgespülte Linsen und 3 cups Wasser dazu. Bringe alles zum Kochen, reduziere die Hitze und lass den Eintopf unter gelegentlichem Rühren 25 Minuten köcheln, bis er dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz. Serviere den Eintopf mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
