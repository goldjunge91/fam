      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor. Dünste die Zwiebel 3 Minuten in Olivenöl an; gib Knoblauch und Paprika dazu und gare sie 3 Minuten; füge Zucchini und Spinat hinzu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Trenne 6 Eier. Verquirle 6 Eiweiß mit 4 ganzen Eiern, italienischen Kräutern, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Eiermischung in eine ofenfeste Pfanne über das Gemüse. Zerbrösele Feta darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare alles auf dem Herd 2 Minuten, bis die Ränder stocken. Stelle die Pfanne dann für 12–15 Minuten in den Ofen, bis die Frittata vollständig gestockt und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Frittata vor dem Schneiden in Stücke 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
