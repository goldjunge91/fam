      "steps": [
        {
          "position": 0,
          "text": "Wenn Sie gesalzenen Kabeljau verwenden, lassen Sie ihn 24 Stunden lang in kaltem Wasser einweichen und wechseln Sie das Wasser alle 6 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den eingeweichten Kabeljau 10 Minuten in siedendem Wasser garen. Abgießen, abkühlen lassen und in kleine Stücke zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Backpulver, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer separaten Schüssel das Ei mit der Milch verquirlen und dann mit der Mehlmischung vermischen, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kabeljauflocken, gehackte Zwiebeln und gehackte Petersilie unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löffelweise Teig vorsichtig ins heiße Öl geben und etwa 2–3 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Aioli oder Tomatensauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
