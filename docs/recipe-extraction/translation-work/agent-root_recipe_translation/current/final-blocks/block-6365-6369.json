      "steps": [
        {
          "position": 0,
          "text": "Fischfond in einem Topf erhitzen und die Safranfäden in der warmen Brühe ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer breiten Paellapfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und Knoblauch etwa 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis hinzufügen und 2 Minuten lang ständig rühren, bis er leicht geröstet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Safran angereicherte Brühe hinzufügen und zum Kochen bringen, dann auf kleiner Flamme köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Fisch mit Salz und Pfeffer würzen und ohne Rühren auf den Reis legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ohne Deckel 18–20 Minuten kochen, bis der Reis zart und der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vom Herd nehmen, Zitronensaft über das Gericht auspressen und den Fisch zusammen mit dem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
