      "steps": [
        {
          "position": 0,
          "text": "Aubergine der Länge nach halbieren und das Fruchtfleisch einschneiden. Mit der Schnittfläche nach oben bei 400 °F 15 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ganze rote Paprika und Tomaten auf dasselbe Blech legen und in den letzten 10 Minuten der Auberginen-Backzeit mitrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aus dem Ofen nehmen und etwas abkühlen lassen, dann die Haut vom Gemüse abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geröstetes Gemüse in kleine Stücke schneiden und in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehackten Knoblauch und Olivenöl untermischen und mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mindestens 5 Minuten bei Zimmertemperatur ruhen lassen, damit sich die Aromen entfalten können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei Zimmertemperatur mit gerösteten Brotscheiben zum Dippen oder Bestreichen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
