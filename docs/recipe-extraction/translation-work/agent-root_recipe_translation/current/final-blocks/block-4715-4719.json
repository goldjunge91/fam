      "steps": [
        {
          "position": 0,
          "text": "Falls du Teig aus Weizenstärke verwendest, dämpfe dünne Teigblätter 2 Minuten, lasse sie abkühlen und schneide sie in breite Nudeln. Falls du Reispapier verwendest, weiche es in Wasser ein und schneide es in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasauce, Reisessig, Sesamöl, Chiliöl, gehackten Knoblauch und Wasser in einer Schüssel zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Gurke in feine Streifen und die Frühlingszwiebeln in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Nudeln in Servierschüsseln und richte Gurke und Frühlingszwiebeln darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Sauce über die Nudeln und garniere mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische alles gut und serviere bei Zimmertemperatur oder gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
