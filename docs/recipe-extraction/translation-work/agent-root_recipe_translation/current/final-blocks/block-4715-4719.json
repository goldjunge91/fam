          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Nudeln ab und spüle sie unter kaltem fließendem Wasser gründlich ab, bis sie abgekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Dashi, Sojasauce und Mirin in einem kleinen Topf und lasse die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reibe den Daikon fein und schneide Frühlingszwiebeln in dünne Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Nori in dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle Schüsseln mit Eis und richte die Nudeln darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie mit Dip-Sauce und garniere mit Wasabi, geriebenem Daikon, Frühlingszwiebeln, Nori und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
