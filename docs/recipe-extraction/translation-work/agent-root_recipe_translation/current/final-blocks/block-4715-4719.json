      "steps": [
        {
          "position": 0,
          "text": "Erhitze Sesamöl in einem großen Topf bei mittelhoher bis hoher Hitze und dünste gehackten Knoblauch und Zwiebel weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Gochugaru und Gochujang hinzu und rühre 1 Minute, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe dazu und bringe sie zum Kochen. Rühre dann Sojasauce ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tintenfisch und Muscheln in die Brühe und lasse sie 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Garnelen hinzu und gare sie weitere 2 Minuten, bis sie rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Ramen-Nudeln nach Packungsanweisung und verteile sie auf Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schöpfe Meeresfrüchte und Brühe über die Nudeln, garniere mit Frühlingszwiebeln und serviere heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
