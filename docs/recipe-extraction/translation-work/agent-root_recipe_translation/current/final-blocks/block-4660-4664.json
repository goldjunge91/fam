      "steps": [
        {
          "position": 0,
          "text": "Die Deckel der Paprika abschneiden und Kerne sowie Trennwände entfernen, dann beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen und die gewürfelte Zwiebel sowie den Knoblauch etwa 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Rinderhackfleisch in die Pfanne geben und etwa 5 Minuten anbraten, dabei beim Garen zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den ungekochten Reis unterrühren und 2 Minuten garen, dann die Dosentomaten mit ihrem Saft und 1 Tasse Wasser oder Brühe dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Mischung 15 Minuten köcheln lassen, bis der Reis teilweise gegart ist, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hälfte des Parmesans unter die Fleisch-Reis-Mischung rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Paprika locker mit der Füllung füllen und aufrecht in eine Auflaufform stellen. Die übrige Tomatensauce um die Paprika gießen und jede mit dem restlichen Parmesan bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Alufolie abdecken und bei 375°F 25 Minuten backen, dann die Folie entfernen und weitere 10 Minuten backen, bis die Paprika weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
