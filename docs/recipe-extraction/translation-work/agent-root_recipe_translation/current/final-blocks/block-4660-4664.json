      "steps": [
        {
          "position": 0,
          "text": "2 Esslöffel Olivenöl in einer Pfanne erhitzen und die gewürfelte Zwiebel etwa 4 Minuten glasig dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Reis zur Zwiebel geben und 1 Minute umrühren, dann Tomatenmark, Minze und Pinienkerne hinzufügen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Wasser und den Zitronensaft dazugießen, zum Kochen bringen, dann die Hitze reduzieren und 8 Minuten köcheln lassen, bis der Reis teilweise gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Füllung mit Salz und Pfeffer würzen und zum leichteren Verarbeiten etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Weinblätter abspülen und mit der glänzenden Seite nach unten auslegen. Etwa 1 Esslöffel Füllung nahe am Stiel auf jedes Blatt geben, dann die Seiten einschlagen und fest aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gerollten Dolmas mit der Nahtseite nach unten dicht nebeneinander in einen Topf legen, mit dem restlichen Olivenöl beträufeln und mit einem umgedrehten Teller beschweren, damit sie sich nicht wieder aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "1 Tasse Wasser in den Topf geben, zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vom Herd nehmen, 5 Minuten ruhen lassen und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
