      "steps": [
        {
          "position": 0,
          "text": "Schwarze Pfefferkörner grob in einer Gewürzmühle oder mit Mörser und Stößel mahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "6 cups gesalzenes Wasser in einem großen Topf zum Kochen bringen und die Pasta hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den gemahlenen Pfeffer in einer großen Pfanne bei mittlerer Hitze 2 Minuten rösten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pecorino Romano fein reiben und in einer Schüssel beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn die Pasta al dente ist, 2 cups Nudelwasser auffangen und die Pasta abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 cup heißes Nudelwasser in die Pfanne zum Pfeffer geben und umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die heiße Pasta in die Pfanne geben und unter ständigem Schwenken nach und nach den Käse darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Weiter schwenken und nach und nach Nudelwasser hinzufügen, bis eine cremige Sauce entsteht, dann sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
