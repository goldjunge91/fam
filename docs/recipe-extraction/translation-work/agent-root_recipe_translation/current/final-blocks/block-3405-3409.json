      "steps": [
        {
          "position": 0,
          "text": "Ritze den Tintenfischkörper rautenförmig ein und schneide ihn in 2 Zoll große Stücke; lasse die Tentakel ganz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende den Tintenfisch in Speisestärke und lasse ihn 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Frittiere den Tintenfisch portionsweise je 2-3 Minuten goldbraun und knusprig und lege ihn dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate im selben Wok getrocknete Chilis, Knoblauch und Ingwer 1 Minute, bis alles stark duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den Tintenfisch mit Sojasauce und Essig zurück in den Wok und schwenke alles 2 Minuten bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle ihn mit Sesamöl, garniere ihn mit Frühlingszwiebeln und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
