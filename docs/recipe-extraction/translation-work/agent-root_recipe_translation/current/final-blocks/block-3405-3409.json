      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser in einem Topf zum Kochen und gib Salz hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze in einer separaten Pfanne Öl bei mittlerer Hitze und brate gehackten Knoblauch, Ingwer und getrocknete Chilis 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die heiße aromatische Ölmischung unter Rühren ins kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Öltee 3-4 Minuten köcheln, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Erdnüsse für extra Knusprigkeit 2 Minuten in einer trockenen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe den Öltee in Schalen und belege jede Portion mit gebratenen Schalotten, gerösteten Erdnüssen, Sesamsamen und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren und mit leichten Crackern oder Reiskuchen genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
