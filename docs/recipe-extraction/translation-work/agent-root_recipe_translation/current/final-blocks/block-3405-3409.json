      "steps": [
        {
          "position": 0,
          "text": "Weiche Shiitake-Pilze 15 Minuten in warmem Wasser ein, drücke sie trocken und hacke sie fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle den Klebreis ab und koche ihn mit 1.25 Tassen Wasser, Sojasauce und gehackter Wurst, bis er klebrig und gar ist (etwa 20 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Sesamöl, gehackten Ingwer und gehackte Pilze unter den gekochten Reis und lasse ihn leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Töte die Krabben schnell und schonend, entferne vorsichtig den oberen Panzer und säubere die Kiemen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle jede Krabbenschale großzügig mit der Klebreismischung und drücke sie fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die gefüllten Krabben mit der Schale nach oben in einen Dämpfeinsatz über kochendem Wasser und dämpfe sie 20 Minuten, bis das Krabbenfleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere sie mit Frühlingszwiebeln und serviere sie heiß direkt in der Schale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
