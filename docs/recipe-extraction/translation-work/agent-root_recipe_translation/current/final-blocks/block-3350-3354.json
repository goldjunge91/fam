      "steps": [
        {
          "position": 0,
          "text": "Schweinebauchwürfel 5 Minuten in kochendem Wasser blanchieren, dann abgießen und unter kaltem Wasser abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 EL Öl in einem großen Topf erhitzen und Knoblauch sowie Ingwer 1 Minute anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinefleisch hinzufügen und 3-4 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Topf mit Shaoxing-Wein ablöschen, dann Sojasauce, dunkle Sojasauce, Zucker, Sternanis und Zimtstange hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wasser oder Brühe angießen und aufkochen, dann abdecken, die Hitze reduzieren und 30 Minuten köcheln lassen, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reis unter kaltem Wasser abspülen, bis das Wasser klar ist, dann in die Schmorflüssigkeit geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gut umrühren, abdecken und aufkochen, dann Hitze reduzieren und 15 Minuten köcheln lassen, bis der Reis gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hitze ausschalten und abgedeckt 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Halbierte hart gekochte Eier auf dem Reis anrichten, mit Frühlingszwiebeln garnieren und direkt aus dem Topf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
