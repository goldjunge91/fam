      "steps": [
        {
          "position": 0,
          "text": "Teebeutel oder losen Tee in 1 cup heißem Wasser 5 Minuten ziehen lassen, herausnehmen und 10 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einem separaten Topf 2 Tassen Wasser zum Kochen bringen, Tapiokaperlen hinzufügen und gelegentlich umrühren; 8-10 Minuten kochen, bis sie durchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tapiokaperlen abgießen, sofort unter kaltem Wasser abspülen und dann mit 2 EL braunem Zucker vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den restlichen 1 EL braunen Zucker auf zwei hohe Gläser verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jedes Glas bis zur Hälfte mit Eiswürfeln füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abgekühlten Tee gleichmäßig auf die Gläser über das Eis gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jeweils 0.375 Tasse Milch in die Gläser gießen und umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gekochte Tapiokaperlen auf die Gläser verteilen und mit breiten Trinkhalmen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
