      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser, Zucker und Hefe vermengen und 5 Minuten stehen lassen, bis sich Schaum bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermengen, in der Mitte eine Mulde formen und Hefemischung sowie Öl hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühren, bis ein grober Teig entsteht, dann 8 Minuten kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In eine geölte Schüssel legen, mit Frischhaltefolie abdecken und 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während der Teig geht, Schweinefleisch mit Knoblauch und Ingwer in einer Pfanne bei mittlerer Hitze 3 Minuten garen, bis es leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasauce, braunen Zucker, Fünf-Gewürze-Pulver und Sesamöl zum Schweinefleisch geben und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gegangenen Teig in 6 gleiche Stücke teilen und jedes auf Backpapier zu einem dünnen Kreis von 4-inch ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brötchen auf Backpapier in einem Bambusdämpfer oder Topf mit Dampfeinsatz 8-10 Minuten dämpfen, bis sie luftig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backpapier vorsichtig abziehen und jedes Brötchen in der Mitte falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Jedes Brötchen mit der Schweinefleischmischung, eingelegtem Senfkohlgrün und Koriander füllen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
