      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 9x13 inch große Auflaufform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche den geschnittenen Kürbis und die gewürfelte Zwiebel 8 Minuten in Salzwasser, bis sie weich sind. Lass sie anschließend gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Milch und Eier und vermenge sie mit dem gegarten Kürbis, der Zwiebel, 3/4 cup Käse, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung in die vorbereitete Form. Bestreue sie mit Semmelbröseln und dem übrigen Käse und gib 1 tbsp Butter in kleinen Stückchen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Auflauf 25-30 Minuten, bis die Oberfläche goldbraun und der Auflauf fest ist. Lass ihn vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
