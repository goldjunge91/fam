      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Süßkartoffeln in 0.25-inch dicke Pommes und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge die Pommes in einer Schüssel mit Öl, Salz, Pfeffer und Paprikapulver, bis alles gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Pommes in einer Lage auf dem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie 15-18 Minuten und wende sie nach der Hälfte der Zeit, bis sie goldbraun und an den Rändern knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Pommes auf eine Servierplatte und bestreue sie sofort mit Käse und Speckwürfeln. Beträufle sie mit saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere sie mit Frühlingszwiebeln und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
