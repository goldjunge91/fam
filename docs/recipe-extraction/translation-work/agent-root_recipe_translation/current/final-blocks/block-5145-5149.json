      "steps": [
        {
          "position": 0,
          "text": "Halbiere die Kirschtomaten und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Olivenöl, Balsamico-Essig, gehackten Knoblauch, Salz und schwarzen Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Dressing über die Tomaten und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Tomaten 2-3 Minuten marinieren, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die marinierten Tomaten auf zwei Tellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege eine Burrata-Kugel in die Mitte jedes Tellers und öffne sie vorsichtig, damit der cremige Kern sichtbar wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zupfe Basilikumblätter und verteile sie über Salat und Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das übrige Dressing rund um den Teller und serviere den Salat sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
