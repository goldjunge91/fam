      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und 2 Esslöffel Öl mit Wasser vermengen, bis ein fester Teig entsteht. 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Öl in einer Pfanne erhitzen und Kreuzkümmelsamen dazugeben. Zwiebel hinzufügen und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gekochte Kartoffeln, Erbsen, grüne Chili und Garam Masala dazugeben und vermengen. Abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 12 Kugeln teilen und jede dünn rund ausrollen, dann halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine Hälfte nehmen, gerade Kante anfeuchten und einen Kegel formen, indem die beiden Ecken zusammengeführt werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jeden Kegel mit 1 Esslöffel Kartoffelfüllung füllen und die offene Seite verschließen, indem die Ränder zusammengedrückt werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einem Topf mit schwerem Boden erhitzen und Samosas portionsweise etwa 3–4 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Tamarinden- und Minz-Chutney servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
