          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen in die Brühe geben und etwa 3–4 Minuten rosa garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mì-Quảng-Nudeln separat nach Packungsanleitung weich und kringelig kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Salat und frische Kräuter auf Serviertellern anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Nudeln, Schweinefleisch, Garnelen und Brühe daraufgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit zerstoßenen Erdnüssen garnieren und Sesamcracker dazu servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Limettenspalten und zusätzlicher Fischsauce zum Abschmecken servieren.",
