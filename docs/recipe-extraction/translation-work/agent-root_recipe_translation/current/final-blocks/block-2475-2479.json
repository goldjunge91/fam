      "steps": [
        {
          "position": 0,
          "text": "Reismehl, Kurkuma, Salz, Kokosmilch und Wasser in einer Schüssel zu einem dünnen Teig verrühren und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinebauch in dünne Streifen schneiden oder Garnelen verwenden, mit Fischsauce würzen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 EL Öl in einer großen beschichteten Pfanne bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine Portion Teig (etwa 1/2 Tasse) in die heiße Pfanne gießen und schwenken, damit er sich dünn zu einem großen runden Crêpe verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald die Unterseite knusprig und goldbraun wird, eine Portion Schweinefleisch, Sojasprossen und geschnittene Zwiebel auf eine Hälfte des Crêpes geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Crêpe halb zusammenklappen und etwa 2 Minuten weitergaren, bis die Ränder knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einen Teller geben und mit übrigem Teig und Füllung wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Salatblättern, frischen Kräutern und einer Dip-Sauce aus Fischsauce, Zucker, Limette und Knoblauch servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
