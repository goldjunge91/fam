      "steps": [
        {
          "position": 0,
          "text": "Getrocknete rote Chilis 10 Minuten in warmem Wasser einweichen, dann mit Knoblauch, Ingwer und Essig zu einer glatten Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kokosöl in einem schweren Topf erhitzen und Kreuzkümmelsamen darin rösten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschnittene Zwiebeln dazugeben und etwa 5 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Chilipaste dazugeben und unter ständigem Rühren 2 Minuten garen, damit sie nicht anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfeltes Schweinefleisch dazugeben und 5 Minuten unter Rühren garen, damit es mit der Gewürzmischung überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln, Salz und Wasser dazugeben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren, abdecken und 25–30 Minuten köcheln lassen, bis das Schweinefleisch zart und die Kartoffeln gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und Salz sowie Schärfe nach Bedarf anpassen. Mit Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
