      "steps": [
        {
          "position": 0,
          "text": "Röste die Brotscheiben im Toaster oder backe sie bei 400°F im Ofen, bis sie knusprig und goldbraun sind. (Die Röst- bzw. Backzeit hängt vollständig von Brotsorte und Dicke ab.)",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm eine Knoblauchzehe und reibe die Schnittfläche über die Oberseite einer Brotscheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm eine Tomatenhälfte und reibe die Schnittfläche über die Brotscheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle das Brot gleichmäßig mit etwas Olivenöl und streue eine Prise Salz darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wiederhole dies mit den übrigen Brotscheiben. Sofort servieren, solange sie schön warm sind!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
