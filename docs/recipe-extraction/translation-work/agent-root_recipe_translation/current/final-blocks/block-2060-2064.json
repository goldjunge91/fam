      "steps": [
        {
          "position": 0,
          "text": "Verrühre die Soße in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke den Knoblauch in einen Wok mit Öl. Stelle den Wok auf hohe Hitze. Sobald er heiß ist, gib Hähnchen und die Stiele des chinesischen Brokkolis hinein und gare alles, bis das Hähnchen hellgoldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe die Zutaten an den Rand des Woks, schlage das Ei hinein und rühre es zu Rührei. Keine Sorge, wenn es am Wokboden festklebt: Es wird leicht angeröstet und erhält dadurch authentischen Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Nudeln, Blätter des chinesischen Brokkolis und Soße hinzu. Vermische alles vorsichtig, bis die Nudeln dunkel gefärbt und die Blätter zusammengefallen sind. Sofort servieren!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
