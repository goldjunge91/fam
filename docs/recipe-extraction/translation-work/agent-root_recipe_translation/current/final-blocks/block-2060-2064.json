      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermenge den Ochsenschwanz mit Zwiebel, Frühlingszwiebel, Knoblauch, Ingwer, Chili, Sojasoße, Thymian, Salz und Pfeffer. Erhitze Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze. Bräune den Ochsenschwanz rundum etwa 10 Minuten. Gib ihn in einen Schnellkochtopf und gieße 375ml Wasser dazu. Koche ihn 25 Minuten unter Druck, nimm den Topf vom Herd und öffne den Deckel gemäß Herstelleranleitung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die dicken Bohnen und Pimentbeeren hinzu und bringe alles bei mittlerer bis hoher Hitze zum Köcheln. Löse Maisstärke in 2 tablespoons Wasser auf und rühre sie in den köchelnden Ochsenschwanz. Koche und rühre einige Minuten, bis die Soße eingedickt und die Bohnen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
