      "steps": [
        {
          "position": 0,
          "text": "Zerbrösele Paneer von Hand oder in einer Küchenmaschine fein, bis er Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einer Pfanne, gib den Paneer hinzu und rühre 5 Minuten ununterbrochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kondensmilch und gemahlenen Kardamom hinzu und vermische alles gut, bis die Masse glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche sie 3-4 Minuten, bis sie eindickt und sich vom Pfannenrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Masse auf einem Teller und lasse sie 15 Minuten vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme kleine Kugeln oder Scheiben und drücke gehackte Pistazien leicht darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wälze nach Wunsch etwas Sandesh in Kokosraspeln und stelle es bis zum Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
