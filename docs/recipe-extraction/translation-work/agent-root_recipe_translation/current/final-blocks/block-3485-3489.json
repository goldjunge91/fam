      "steps": [
        {
          "position": 0,
          "text": "Erhitze Milch auf 82°C (180°F), gib Kondensmilch und Zucker hinzu und rühre, bis sie sich aufgelöst haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse die Mischung auf etwa 43°C (110°F) abkühlen und gib zerstoßenen Kardamom und Muskatnusspulver hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Naturjoghurt in einer separaten Schüssel und hebe ihn vorsichtig unter die abgekühlte Milchmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung gleichmäßig auf Tontöpfchen oder Joghurtbehälter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wickle die Behälter in Alufolie und stelle sie in eine isolierte Kühlbox mit heißem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alternativ kannst du sie in einem Joghurtbereiter bei 110°F 6-8 Stunden inkubieren, bis die Masse fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bewege oder störe die Behälter nicht, während der Joghurt fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem gekühlten Servieren mindestens 2 Stunden kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
