      "steps": [
        {
          "position": 0,
          "text": "Wasche Reis und Mung-Dal getrennt und lasse sie gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einem schweren Topf und gib Kreuzkümmelsamen und Lorbeerblätter hinzu, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwer hinzu und gare ihn 30 Sekunden, dann gib gewürfelte Kartoffeln dazu und gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Reis, Mung-Dal, Kurkumapulver und Erbsen hinzu und rühre 2 Minuten vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser hinzu, salze und bringe alles bei hoher Hitze zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald es kocht, reduziere die Hitze, decke den Topf mit einem dicht schließenden Deckel ab und gare alles 18-20 Minuten, bis Reis und Dal weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd und lasse das Gericht zugedeckt 3 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lockere es mit einer Gabel auf und serviere es heiß mit Ghee und etwas Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
