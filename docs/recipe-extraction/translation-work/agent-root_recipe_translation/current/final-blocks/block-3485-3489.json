      "steps": [
        {
          "position": 0,
          "text": "Koche Milch auf, gib langsam Essig hinzu, bis sie gerinnt, und seihe sie dann durch ein Mulltuch ab, das 15 Minuten aufgehängt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete Paneer mit Mehl sehr vorsichtig zu einem glatten Teig und forme 14 kleine Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche Wasser mit 1.5 Tassen Zucker und zerstoßenem Kardamom 5 Minuten zu Zuckersirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe in einem separaten Topf Wasser mit dem restlichen Zucker zum Kochen und gib vorsichtig die Paneer-Kugeln hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre 3-4 Minuten vorsichtig mit einem Löffel um, damit sie nicht am Boden festkleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald die Kugeln aufschwimmen und größer werden, lasse sie 12-15 Minuten köcheln, bis sie schwammig und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Kugeln mit einer Schaumkelle in den Kardamom-Zuckersirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Rosenwasser hinzu, lasse alles vollständig abkühlen und stelle es vor dem Servieren 4 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
