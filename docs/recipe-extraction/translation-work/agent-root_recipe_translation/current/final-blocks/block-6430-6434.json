      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz. Forme in der Mitte eine Mulde und schlage die Eier hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Arbeite das Mehl mit einer Gabel nach und nach in die Eier ein, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig 10 Minuten glatt und elastisch. Wickle ihn ein und lass ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in Viertel und rolle sie von Hand oder mit einer Maschine sehr dünn zu langen Bändern aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Bänder in feine Streifen und lege sie zum leichten Antrocknen auf eine bemehlte Fläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Salzwasser zum Kochen und gare Tajarin 2-3 Minuten, bis sie an die Oberfläche steigen und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass Butter mit Salbei und gehacktem Knoblauch in einer Pfanne schmelzen. Schwenke die abgetropfte Pasta und geriebenen Käse darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
