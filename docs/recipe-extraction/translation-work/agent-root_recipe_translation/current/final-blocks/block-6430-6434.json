      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Eier, Milch und eine Prise Salz zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Zucchini und Aubergine in 1/4-inch dicke Scheiben, viertele die Pilze, schneide Äpfel in Scheiben und zerbrösele Amaretti-Kekse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem schweren Topf oder einer Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tauche Gemüse- und Obststücke in den Teig, sodass sie rundherum vollständig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die panierten Stücke vorsichtig portionsweise ins heiße Öl und überfülle den Topf nicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie pro Seite 3-4 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie sofort und bestreue sie mit Puderzucker und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
