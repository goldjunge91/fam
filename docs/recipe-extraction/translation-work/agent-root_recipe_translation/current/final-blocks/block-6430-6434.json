      "steps": [
        {
          "position": 0,
          "text": "Tupfe das Rindfleisch trocken und würze es von allen Seiten großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Schmortopf und bräune das Fleisch rundherum kräftig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und dünste gewürfelte Zwiebeln, Karotten, Sellerie und gehackten Knoblauch 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche dann mit der ganzen Flasche Barolo ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Rindfleisch zurück in den Topf, gib Brühe und Lorbeerblätter dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und schmoren das Fleisch im auf 325°F vorgeheizten Ofen 2.5 bis 3 Stunden, bis es mit einer Gabel zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Fleisch heraus und lass es ruhen. Seihe die Schmorflüssigkeit ab, reduziere sie auf dem Herd um die Hälfte und gieße sie zum Servieren über das aufgeschnittene Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
