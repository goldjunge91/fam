      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Bohnen 6 Stunden oder über Nacht ein. Gieße sie anschließend ab und spüle sie gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Zwiebel, Knoblauch und Salami fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Butter in einem großen Topf und dünste Zwiebel, Knoblauch und Salami 5 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die abgetropften Bohnen dazu und rühre 2 Minuten um. Gieße dann Rotwein hinein und lass ihn einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib warme Gemüsebrühe dazu und lass alles 20 Minuten köcheln, bis die Bohnen weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Reis ein und lass alles weitere 18 Minuten köcheln. Rühre häufig um, bis der Reis gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd und rühre geriebenen Parmesan ein, bis er vollständig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
