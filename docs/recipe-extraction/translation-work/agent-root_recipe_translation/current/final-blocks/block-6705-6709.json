      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und das Rindfleisch von allen Seiten etwa 10 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geviertelte Zwiebeln und Knoblauch dazugeben und 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit Rinderbrühe aufgießen und zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 45 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffeln in Stücke und Karotten in Scheiben schneiden und in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Maiskolben halbieren und in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 35–40 Minuten köcheln lassen, bis das Gemüse zart und das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln mit großzügiger Brühe und Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
