      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl und Salz. Gib nach und nach Wasser dazu und rühre, bis ein grober Teig entsteht. Knete ihn dann 10 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche den Teig mit 2 tbsp Öl, decke ihn mit Frischhaltefolie ab und lass ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das restliche Öl in einem kleinen Topf. Gib getrocknete Chilis, Sichuanpfefferkörner, gehackten Knoblauch und Ingwer dazu. Lass das Chiliöl 5 Minuten ziehen und seihe es dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Rinderbrühe in einem großen Topf leicht köcheln und würze sie mit Salz, Chiliöl und gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Halbiere den ruhenden Teig und rolle beide Stücke zu langen Strängen. Halte die Enden fest und schlage den Teig wiederholt auf die Arbeitsfläche, um etwa 15 Lagen zu erzeugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe einen großen Topf Wasser zum Kochen. Ziehe den Teigstrang vorsichtig zu dünnen Nudeln auseinander und gib sie ins kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Nudeln 2-3 Minuten, bis sie aufsteigen und weich sind. Hebe sie mit einer Schaumkelle heraus und gib sie in Schalen mit heißer Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere die Nudelsuppe mit Koriander und Sojasprossen, träufle etwas Chiliöl darüber und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
