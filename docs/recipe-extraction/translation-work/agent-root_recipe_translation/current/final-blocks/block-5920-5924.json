      "steps": [
        {
          "position": 0,
          "text": "Schneide den festen weißen Fisch in 0.5-inch-Würfel und gib sie in eine Glas- oder Keramikschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Presse den Saft von 6 Limetten über den Fisch, sodass er vollständig bedeckt ist. Lass ihn 15-20 Minuten ziehen, bis er undurchsichtig und fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die rote Zwiebel, hacke die Jalapeño und den Koriander und gib alles zusammen mit der gewürfelten Tomate zum gebeizten Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe Olivenöl, Salz und Pfeffer vorsichtig unter, ohne die Fischstücke zu zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den gekochten Reis auf vier Schalen und gib jeweils eine Portion Ceviche darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere das Gericht vor dem sofortigen Servieren mit Avocadoscheiben, Mais und zusätzlichem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
