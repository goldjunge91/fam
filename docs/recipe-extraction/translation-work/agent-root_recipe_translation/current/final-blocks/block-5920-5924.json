      "steps": [
        {
          "position": 0,
          "text": "Hacke Knoblauch und rote Chilis zusammen zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einem Wok oder einer großen Pfanne bei starker Hitze, bis es gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Knoblauch-Chili-Paste hinein und brate sie unter Rühren 30 Sekunden, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hackfleisch vom Schwein dazu und zerteile es beim Garen. Brate es unter ständigem Rühren 5-6 Minuten, bis es durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Fischsauce, Austernsauce, Limettensaft und Zucker ein. Gib dann frisches Basilikum dazu und schwenke alles 1 Minute rasch durch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile Jasminreis auf zwei Schalen und gib die Schweinefleischmischung sowie jeweils ein Spiegelei darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
