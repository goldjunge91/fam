      "steps": [
        {
          "position": 0,
          "text": "Würfle Zwiebel, Kartoffel und Zucchini in 0.5-inch-Würfel und hacke den Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne oder einem Wok bei mittlerer bis hoher Hitze. Brate das gewürfelte Fleisch darin braun an, nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die schwarze Bohnenpaste in derselben Pfanne bei mittlerer Hitze 1-2 Minuten unter Rühren an, bis sie etwas dunkler wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das gewürfelte Gemüse und den Knoblauch dazu und brate alles 3-4 Minuten unter Rühren, bis das Gemüse langsam weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Fleisch zurück in die Pfanne. Füge Wasser, Sojasauce und Zucker hinzu und lass alles 5 Minuten köcheln, bis das Gemüse weich und die Sauce eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Weizennudeln nach Packungsanweisung in kochendem Salzwasser und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Nudeln auf zwei Schalen, schöpfe die Sauce darüber und serviere nach Belieben jeweils ein Spiegelei dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
