      "steps": [
        {
          "position": 0,
          "text": "Püriere rote Chilis, Knoblauch und Zwiebeln zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Gewürzpaste hinzu und brate sie 2 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Garnelen hinzu und brate sie 2-3 Minuten unter Rühren, bis sie rosa werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelte Tomaten hinzu und brate alles weitere 2-3 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Limettensaft, Fischsauce und Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles 1 weitere Minute, bis die Garnelen vollständig gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht, passe die Würzung mit Salz und Pfeffer an und serviere es sofort mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
