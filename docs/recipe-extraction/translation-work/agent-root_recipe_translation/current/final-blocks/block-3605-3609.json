      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebeln, Knoblauch und rote Chilis fein und vermische sie mit dem Fischhack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier mit Kokosmilch, Kurkuma und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die Fischmischung mit der Ei-Kokos-Mischung und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Mischung gleichmäßig auf Quadraten aus Bananenblatt oder Folie und falte die Ränder zu fest verschlossenen Päckchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen Pfanne oder Grillpfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Päckchen mit der Naht nach unten hinein und gare sie 8-10 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende die Päckchen vorsichtig und gare die andere Seite weitere 7-8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Sambal oder Chilisauce als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
