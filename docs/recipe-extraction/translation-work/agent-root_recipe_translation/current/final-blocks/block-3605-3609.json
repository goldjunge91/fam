      "steps": [
        {
          "position": 0,
          "text": "Spüle Klebreis gründlich unter kaltem Wasser, bis es klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Kokosmilch mit Salz, Zucker und Wasser in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Reis zur Kokosmischung und rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Bambusrohre oder Folienröhren mit Bananenblättern aus und falte die Blätter passend ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle jede Röhre zu drei Vierteln mit der Reismischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falte die Bananenblattenden ein, um die Röhren zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Röhren senkrecht in einen großen Topf mit 2 Zoll Wasser am Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf ab und dämpfe alles 90 Minuten. Prüfe regelmäßig den Wasserstand und gib bei Bedarf mehr Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm den Topf vom Herd, lasse die Röhren leicht abkühlen und drücke den Lemang vorsichtig auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schneide ihn in Scheiben und serviere ihn warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
