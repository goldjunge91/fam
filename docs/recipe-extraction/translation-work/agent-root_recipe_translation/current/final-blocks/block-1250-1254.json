      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Kokosraspeln 2 Minuten in einer trockenen Pfanne, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische warme Kokosmilch, Honig, Kardamom und Vanille. Gib die Mischung zu den Kokosraspeln und verrühre alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass die Masse abkühlen, bis sie sich anfassen lässt. Rolle sie zu Kugeln und drücke jeweils eine Pistazie hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Kugeln 30 Minuten kalt, damit sie fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
