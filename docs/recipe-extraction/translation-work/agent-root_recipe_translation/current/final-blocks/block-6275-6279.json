      "steps": [
        {
          "position": 0,
          "text": "Entferne überschüssiges Fett von den Schweinerippchen und teile sie in einzelne Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe 6 cups Salzwasser in einem großen Topf zum Kochen und gib die Rippchen hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass sie 20 Minuten köcheln und schöpfe dabei aufsteigenden Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geviertelte Zwiebeln, gehackten Knoblauch und gewürfelten Rettich in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass alles weitere 15 Minuten köcheln, bis der Rettich weich und das Schweinefleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Patis, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Suppe heiß in Schalen mit der Brühe.",
