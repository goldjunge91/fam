      "steps": [
        {
          "position": 0,
          "text": "Vermenge süßes Reismehl, braunen Zucker und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach Kokosmilch dazu und rühre, bis eine glatte, dicke Paste entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Bananenblätter in 6x8-inch-Rechtecke und erwärme sie vorsichtig über einer Flamme, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 3 Esslöffels Teig in die Mitte jedes Bananenblattstücks.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe die Blattseiten über der Füllung zusammen und rolle sie fest zu einer Rolle auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe 2 cups Wasser in einem großen Topf zum Kochen und lege die eingewickelten Suman vorsichtig mit der Naht nach unten hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche sie 20 Minuten, bis die Päckchen aufsteigen und sich fest anfühlen, wenn man sie drückt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hebe sie mit einer Schaumkelle heraus und lass sie vor dem Servieren etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
