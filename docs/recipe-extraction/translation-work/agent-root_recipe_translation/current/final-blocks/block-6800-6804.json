      "steps": [
        {
          "position": 0,
          "text": "Die Fadennudeln nach Packungsanweisung kochen, abgießen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine flache Schüssel mit warmem Wasser füllen. Ein Reispapierblatt 10 Sekunden eintauchen, bis es biegsam ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Reispapier auf eine saubere Fläche legen. Salatblatt, Nudeln, Gurke, Garnelen, Minze und Koriander darauf schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Seiten nach innen falten und das Reispapier von sich weg fest aufrollen, ähnlich wie eine Frühlingsrolle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit den übrigen Reispapierblättern und Füllungen ebenso verfahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erdnussbutter, Hoisinsauce, Limettensaft und Wasser zu einer Dip-Sauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sommerrollen mit der Sauce zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
