      "steps": [
        {
          "position": 0,
          "text": "Die Nudeln 3 Minuten in kochendem Salzwasser garen. Abgießen und unter kaltem Wasser abspülen, bis sie vollständig abgekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sesampaste, Sojasauce, Reisessig, gehackten Knoblauch, Ingwer, Sesamöl und Chiliöl in einer Schüssel glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel warmes Wasser unter die Sauce rühren, bis sie die gewünschte Konsistenz hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die kalten Nudeln mit der Soße vermengen, bis sie gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Nudeln auf zwei Schüsseln verteilen und mit in feine Streifen geschnittener Gurke sowie gehackten Frühlingszwiebeln garnieren.",
