      "steps": [
        {
          "position": 0,
          "text": "Hühnerbrühe in einem Topf bei starker Hitze zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zitronengras, Galgant und Limettenblätter dazugeben und 5 Minuten köcheln lassen, damit sie ihr Aroma abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfeltes Hühnchen und Pilze dazugeben und 5 Minuten kochen lassen, bis das Hühnchen fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen und Thai-Chilis hinzufügen und 2 Minuten kochen lassen, bis die Garnelen rosa werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen, Limettensaft und Fischsauce einrühren und abschmecken. Die Suppe soll scharf, sauer und salzig schmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit frischem Koriander garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
