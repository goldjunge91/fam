      "steps": [
        {
          "position": 0,
          "text": "Sichuan-Pfefferkörner in einer trockenen Pfanne 1 Minute rösten, grob zerstoßen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Topf bei mittlerer Hitze erhitzen. Getrocknete Chilis und Knoblauch dazugeben und 30 Sekunden rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe angießen und zum Kochen bringen. Geröstete Pfefferkörner, Sojasauce und Reisessig einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tofu, Chinakohl und Pilze in die Brühe geben und 8 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abschmecken und nach Wunsch mehr Sojasauce oder Chili hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem heißen Servieren mit Sesamöl beträufeln und mit Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
