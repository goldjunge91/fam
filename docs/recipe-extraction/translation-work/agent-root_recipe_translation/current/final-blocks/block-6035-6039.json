      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Wok bei starker Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und brate sie 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Doubanjiang ein und gare es unter ständigem Rühren 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Brokkoliröschen und Pilze dazu und brate sie 3 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Paprika und Zuckerschoten hinzu und brate alles weitere 3 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Sojasauce und Wasser dazu und vermenge alles gut, damit das Gemüse überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles weitere 2-3 Minuten, bis das Gemüse bissfest und zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
