          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Chinakohl in große Stücke und verteile sie in einem Schmortopf oder einer großen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Fleischbällchen auf den Kohl und gieße die Hühnerbrühe darum herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lass es 30 Minuten köcheln, bis die Fleischbällchen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke die Brühe ab und würze sie bei Bedarf mit Sojasauce nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
