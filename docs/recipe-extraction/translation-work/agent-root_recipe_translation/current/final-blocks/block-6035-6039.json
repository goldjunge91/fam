      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 tbsp Öl in einem großen Wok bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre die Eier und nimm sie aus dem Wok. Gib das restliche Öl hinein und gare das Schweinehackfleisch etwa 5 Minuten, bis es durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch dazu und gare ihn 30 Sekunden. Füge dann geraspelten Kohl hinzu und brate alles 3 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Reiskuchen und Sojasauce dazu und schwenke alles vorsichtig, damit die Kuchen überzogen werden und nicht festkleben. Gare sie etwa 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Rühreier zurück in den Wok und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle das Gericht mit Sesamöl und bestreue es vor dem Servieren mit gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
