      "steps": [
        {
          "position": 0,
          "text": "Schäle den Daikon-Rettich, raspel ihn und drücke überschüssige Flüssigkeit mit einem Mulltuch oder sauberen Küchentuch aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die chinesische Wurst. Weiche die getrockneten Garnelen 10 Minuten in warmem Wasser ein, gieße sie ab und hacke sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Reismehl und Wasser glatt. Vermenge die Mischung mit geraspeltem Daikon, Wurst, Garnelen, Sojasauce, Sesamöl, Salz und gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung in eine mit Backpapier ausgelegte quadratische 8-inch-Backform und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Form in einen Dämpfeinsatz und dämpfe den Kuchen 30 Minuten, bis er fest ist und ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass den Kuchen 10 Minuten abkühlen, stürze ihn auf ein Schneidebrett und schneide ihn in 8 Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze 2 tbsp Öl in einer Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brate jedes Kuchenquadrat pro Seite 2-3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere den Kuchen heiß mit Sojasauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
