      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und lege ein großes Backblech mit Alufolie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Olivenöl, Zitronensaft, Paprikapulver, Kreuzkümmel, Koriander, Knoblauch, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge die Hähnchenstreifen mit der Hälfte der Marinade und lass sie 10 Minuten ziehen, während du das Gemüse vorbereitest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Zwiebeln auf dem Blech, träufle die übrige Marinade darüber und lege das Hähnchen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe alles 20-25 Minuten. Wende die Zutaten nach der Hälfte der Zeit, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme das Fladenbrot während der letzten 2 Minuten der Garzeit im Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Hähnchen und die Zwiebeln im warmen Fladenbrot mit Hummus, Tahini-Sauce und frischem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
