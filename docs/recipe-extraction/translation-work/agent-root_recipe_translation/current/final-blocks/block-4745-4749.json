      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und lege ein großes Backblech mit Alufolie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre griechischen Joghurt, Garam Masala, Paprikapulver, Kurkuma, die Hälfte des Knoblauchs und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende die Hähnchenwürfel in der Joghurtmischung und verteile sie auf dem vorbereiteten Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe das Hähnchen 15-18 Minuten, bis es teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl in einer Pfanne und dünste Zwiebel, restlichen Knoblauch und Ingwer weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Kokosmilch und Tomatensauce ein und lass die Sauce 5 Minuten köcheln. Gieße sie anschließend über das vorgegarte Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe alles weitere 10-12 Minuten, bis das Hähnchen vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht mit Basmatireis oder Naan-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
