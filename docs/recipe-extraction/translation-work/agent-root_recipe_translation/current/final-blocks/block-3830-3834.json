      "steps": [
        {
          "position": 0,
          "text": "Vermische warmes Wasser, Hefe und eine Prise Zucker in einer Schüssel und lasse alles 5 Minuten stehen, bis es schaumig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Salz in einer großen Schüssel, gib die Hefemischung hinzu und knete 5 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig ab und lasse ihn 20 Minuten gehen, bis er luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hacke Knoblauch und vermische ihn mit geschmolzener Butter und gehackter Petersilie. Stelle die Mischung beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer tiefen Pfanne oder Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ziehe den Teig zu Streifen und frittiere sie portionsweise vorsichtig je Seite 2-3 Minuten goldbraun und luftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Langos auf Küchenpapier abtropfen und bestreiche sie sofort noch warm mit der Knoblauch-Butter-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
