      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig zu, indem du Hefe mit warmem Wasser vermischst und 5 Minuten stehen lässt. Gib dann Mehl, Eier, 2 Esslöffel Butter und Salz hinzu und knete alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse den Teig zugedeckt 45 Minuten gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Füllung zu, indem du gewürfelte Äpfel, gehackte Walnüsse, Rosinen, Zucker und Zimt vermischst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig auf einer bemehlten Fläche sehr dünn zu einem Rechteck aus und bestreiche ihn mit der restlichen geschmolzenen Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Apfel-Walnuss-Mischung auf einer Teighälfte und Pflaumenmarmelade auf der anderen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig von der langen Seite her fest auf, forme eine Spirale und lege sie in eine gefettete 9x13-Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse den Teig 30 Minuten gehen, bestreiche ihn mit verquirltem Ei und backe ihn bei 350°F 40-45 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse das Gebäck vor dem Anschneiden 15 Minuten in der Form abkühlen.",
