      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste geschnittene Zwiebeln 8 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Paprikapulver hinzu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark und Kümmelsamen ein, gib dann Brühe hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide den Fisch in 2 Zoll große Stücke und gib ihn vorsichtig in die köchelnde Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles 15-20 Minuten köcheln, bis der Fisch gar ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schalen mit knusprigem Brot zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
