      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Schweinshaxe trocken und würze sie rundherum großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und bräune die Haxe etwa 12 Minuten insgesamt von allen Seiten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Zwiebel, Karotte und Sellerie hinzu und dünste alles 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe an, decke den Topf ab und lasse alles 2 Stunden köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Kartoffeln 15 Minuten in Salzwasser, bis sie gerade gar sind. Gieße sie ab und schneide sie noch warm in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge warme Kartoffelscheiben vorsichtig mit Essig, Senf und 6 Esslöffeln Kochbrühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Haxe aus dem Topf und seihe die Brühe ab. Bewahre 1.5 Tassen für die Sauce auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Haxe mit Kartoffelsalat und Bratensaft als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
