      "steps": [
        {
          "position": 0,
          "text": "Pochiere den geräucherten Schellfisch 5 Minuten in Milch. Nimm ihn heraus und zerpflücke ihn. Hebe die Milch auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Zwiebel und Lauch 5 Minuten in Butter an. Gib gewürfelte Kartoffel dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die aufgehobene Milch und Sahne dazu. Lass alles 15 Minuten köcheln, bis die Kartoffel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerdrücke einige Kartoffelstücke für mehr Konsistenz und hebe den zerpflückten Schellfisch unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit schwarzem Pfeffer und bestreue die Suppe mit Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
