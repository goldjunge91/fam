    {
      "externalId": "waivy:mfr-euro-soup-cullen-skink",
      "slug": "mfr-euro-soup-cullen-skink",
      "title": "Schottische Cullen Skink (Chowder mit geräuchertem Schellfisch)",
      "instructions": "Schottische dicke, cremige Suppe mit geräuchertem Schellfisch und Kartoffeln, benannt nach dem Ort Cullen, in dem sie entstanden ist. Süßer Lauch, rauchiger Fisch und Sahne machen sie zu einer besonders sättigenden Suppe für kalte Tage.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 25,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Geräucherten Schellfisch gibt es tiefgekühlt und günstiger als frisch.",
        "Die Milch vom Pochieren bildet die Suppengrundlage. So bleibt der ganze Geschmack erhalten und es wird nichts verschwendet.",
        "Falls kein Schellfisch erhältlich ist, nimm geräucherten Kabeljau oder einen anderen geräucherten Weißfisch."
      ],
      "substitutions": [
        {
          "forIngredientId": "smoked-haddock",
          "swap": "Geräucherter Kabeljau oder ein anderer geräucherter Weißfisch"
        },
        {
          "forIngredientId": "heavy-cream",
          "swap": "Fettarme Milch für eine leichtere Chowder"
        }
      ],
