      "steps": [
        {
          "position": 0,
          "text": "Mehl, Weinstein, Natron und Salz in einer Schüssel verquirlen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer großen Schüssel die weiche Butter mit 1 1/2 Tassen Zucker etwa 2–3 Minuten hell und luftig schlagen. Eier einzeln einrühren, dann Vanille hinzufügen und die Schüssel bei Bedarf zwischendurch ausschaben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die trockenen Zutaten bei niedriger Stufe unter die Buttermasse rühren, bis ein weicher Teig ohne Mehlnester entsteht. Abdecken und 30 Minuten kühlen, damit er fester wird und Aroma entwickelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Ofen auf 375 °F vorheizen und zwei Backbleche mit Backpapier belegen. In einer kleinen Schüssel 3 EL Zucker mit dem Zimt für die Hülle verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehäufte Esslöffel Teig abstechen, zu Kugeln rollen und großzügig im Zimtzucker wälzen. Mit etwa 2 Zoll Abstand auf die Bleche setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ein Blech nach dem anderen 9–11 Minuten backen, bis die Oberfläche aufreißt und die Ränder gerade fest sind. Die Mitte soll noch etwas weich und leicht unterbacken aussehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Kekse 5 Minuten auf dem Blech ruhen lassen, damit sie fest werden, dann auf ein Gitter setzen. Beim Abkühlen bleiben sie weich und zäh.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
