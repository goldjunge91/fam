    {
      "externalId": "waivy:cur-classic-banana-bread",
      "slug": "cur-classic-banana-bread",
      "title": "Klassisches Bananenbrot",
      "instructions": "Saftiger, zarter Kuchen aus sehr reifen Bananen, braunem Zucker und geschmolzener Butter mit kräftigem Karamellaroma. In einer Schüssel von Hand zusammengerührt und mit einer weichen, duftenden Krume gebacken.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 60,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Angeschlagene, sehr reife Bananen aus dem Reduzierungsregal kaufen; für dieses Rezept sind sie ideal und kosten weniger.",
        "Gepunktete Bananen geschält einfrieren. Vor dem Zerdrücken auftauen und abtropfen lassen.",
        "Walnüsse weglassen oder vorhandene Nüsse beziehungsweise Schokostückchen verwenden, um Kosten zu sparen."
      ],
      "substitutions": [
        {
          "forIngredientId": "sour-cream",
          "swap": "natur oder Greek Joghurt in gleich amount",
          "savings": "Vorhandenes aus dem Kühlschrank verwenden und den Kauf eines Bechers sparen"
        },
        {
          "forIngredientId": "butter",
          "swap": "Neutral Pflanzenöl, same amount",
          "savings": "Ungefähr 30% günstiger und hält das Brot besonders saftig"
        },
        {
          "forIngredientId": "brown-sugar",
          "swap": "White Zucker plus 1 tsp molasses",
          "savings": "Spart den Kauf eines zweiten Beutels Zucker"
        }
      ],
