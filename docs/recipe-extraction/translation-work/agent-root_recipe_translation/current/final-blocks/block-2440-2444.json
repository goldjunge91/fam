      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in 1.5-inch-Würfel schneiden und in Joghurt, 0.5 EL Garam Masala, der Hälfte der Knoblauchpaste, Salz und rotem Chilipulver 30 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel würfeln und 2 EL Öl in einer großen Pfanne bei starker Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenwürfel portionsweise etwa 6 Minuten insgesamt braten, bis sie gebräunt und gar sind. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Übriges Öl in derselben Pfanne erhitzen und gewürfelte Zwiebel etwa 3 Minuten weich garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Übrige Knoblauchpaste und Ingwerpaste dazugeben und 1 Minute braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tomatensauce und übriges Garam Masala einrühren und 8 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hähnchen zurück in die Pfanne geben und Sahne einrühren. Weitere 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Koriander garnieren und mit Basmatireis oder Naan servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
