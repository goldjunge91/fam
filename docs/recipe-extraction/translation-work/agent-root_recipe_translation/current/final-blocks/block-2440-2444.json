      "steps": [
        {
          "position": 0,
          "text": "Schweinefleisch und Hähnchen in dünne mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Topf bei mittlerer Hitze erhitzen und gehackten Knoblauch sowie ganze getrocknete Chilis 2 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweine- und Hähnchenstücke dazugeben und 5 Minuten braten, bis sie gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinebrühe angießen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Fischsauce und dunkler Sojasauce würzen, dann Hitze reduzieren und 8 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reisnudeln separat nach Packungsanleitung kochen und abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Nudeln in Schalen geben und heiße Brühe mit Fleisch darüber schöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Koriander und einem Spritzer Limette garnieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
