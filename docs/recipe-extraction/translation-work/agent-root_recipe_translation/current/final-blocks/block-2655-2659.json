      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel und Paprika etwa 8 Minuten in einer Pfanne bei mittlerer Hitze, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Fleischmischung mit Salz, Pfeffer und gehackter Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Crêpes flach aus, verteile die Fleischmischung darauf und rolle sie fest zu Zylindern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die gerollten Crêpes mit der Naht nach unten in eine gebutterte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Joghurt mit gehacktem Knoblauch und verstreiche ihn auf den Crêpes.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Tomatensauce in einer Pfanne und träufle sie über die Joghurtschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe das Gericht bei 350°F 25 Minuten, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß mit zusätzlicher Joghurtsauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
