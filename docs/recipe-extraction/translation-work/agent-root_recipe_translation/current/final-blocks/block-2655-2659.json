      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebel und Knoblauch fein und vermische sie dann mit Rinderhackfleisch, Lammhackfleisch, Chiliflocken, Paprikapulver, Kreuzkümmel, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge alles vorsichtig und forme flache ovale Frikadellen von etwa 0.5 inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine Grillpfanne oder einen Außengrill auf mittelhohe Hitze und grille die Frikadellen 5-6 Minuten pro Seite, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille währenddessen halbierte Tomaten mit der Schnittfläche nach unten 2-3 Minuten, bis sie angekohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme das Pitabrot auf dem Grill 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die gegrillte Tomate und die Kebab-Frikadelle ins Pitabrot und serviere sie mit zusätzlichem Paprikapulver und Chiliflocken dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
