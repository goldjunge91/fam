      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebel und Petersilie fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Rinderhackfleisch, Paniermehl, Ei, Zwiebel, Petersilie, Kreuzkümmel, Paprikapulver, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge alles vorsichtig mit den Händen, bis die Zutaten gerade verbunden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Masse 12-16 längliche Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Köfte portionsweise 3-4 Minuten pro Seite, bis sie gebräunt und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie auf einen Teller und serviere sie heiß mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie mit Fladenbrot oder zu Reis.",
          "timerMinutes": null,
