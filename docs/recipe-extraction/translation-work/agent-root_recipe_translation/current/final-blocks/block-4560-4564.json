      "steps": [
        {
          "position": 0,
          "text": "Schweinehackfleisch, gehackte Garnelen, Frühlingszwiebeln, Sojasauce, Sesamöl, Ingwer und Speisestärke in einer Schüssel vermengen und gut mischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein Shumai-Teigblatt in die Handfläche legen und etwa 1 EL Füllung in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Ränder des Teigblatts um die Füllung herum nach oben ziehen und die Seiten vorsichtig andrücken, sodass ein oben offener Beutel entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ein Dämpfkörbchen mit Backpapier auslegen und die Shumai mit der Nahtseite nach oben hineinlegen, mit Abstand zwischen den einzelnen Stückchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Etwas Wasser in einen Topf geben, das Dämpfkörbchen daraufsetzen, abdecken und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "12-15 Minuten dämpfen, bis die Teigblätter durchscheinend und die Füllung vollständig gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Sojasauce, Reisessig und Chiliöl zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
