      "steps": [
        {
          "position": 0,
          "text": "Quinoa unter kaltem Wasser abspülen und mit 2 Tassen Wasser in einen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 15 Minuten köcheln lassen, bis das Wasser aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zucchini und Paprika in 1-inch-Stücke schneiden und Kirschtomaten halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Gemüse mit 2 EL Olivenöl, gehacktem Knoblauch, Salz und Pfeffer vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Gemüse auf einem Backblech verteilen und bei 425°F 20 Minuten rösten, bis es zart und gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kichererbsen aus der Dose abgießen und abspülen, mit 1 EL Olivenöl vermengen und in den letzten 10 Minuten mit dem Gemüse rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den gekochten Quinoa auf zwei Schüsseln verteilen und mit geröstetem Gemüse und Kichererbsen belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Zitronensaft beträufeln, mit frischem Spinat und Feta bestreuen und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
