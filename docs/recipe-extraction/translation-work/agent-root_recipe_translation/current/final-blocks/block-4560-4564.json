      "steps": [
        {
          "position": 0,
          "text": "Den fein gehackten Chinakohl salzen, 5 Minuten ruhen lassen und anschließend mit Küchenpapier überschüssige Flüssigkeit ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinefleisch, Kohl, Frühlingszwiebeln, Sojasauce, Sesamöl, Knoblauch und Ingwer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Gyoza-Teigblatt in die Handfläche legen und 1 TL Füllung in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Rand des Teigblatts mit Wasser befeuchten, in der Mitte falten, dann auf der Oberseite 3-4 Falten legen und zum Verschließen andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Gyoza mit der flachen Seite nach unten hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2-3 Minuten braten, bis die Unterseiten goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "0.25 Tassen Wasser in die Pfanne geben, sofort mit einem Deckel abdecken und 5-7 Minuten dämpfen, bis die Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einer Dippsauce aus Sojasauce, Reisessig und Chiliöl servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
