              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 180C/350F/Gas 4 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl und Butter in einem ofenfesten Schmortopf und brate das Rindfleisch rundum braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Mehl darüber und gare es weitere 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und das gesamte Gemüse dazu und brate alles 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Wein, Brühe und Kräuter ein. Gib Worcestershiresauce und Balsamicoessig nach Geschmack dazu. Würze mit Salz und frisch gemahlenem schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und gare ihn etwa zwei hours im Ofen, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für die Klöße siebe Mehl, Backpulver und Salz in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Rindertalg und genug Wasser dazu, um einen festen Teig zu formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Forme mit bemehlten Händen aus Löffeln Teig kleine Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Nimm nach zwei hours den Deckel vom Eintopf und lege die Kugeln darauf. Decke den Topf wieder ab und gare alles weitere 20 Minuten, bis die Klöße aufgegangen und weich sind. Für eine goldene Oberfläche kannst du den Deckel beim Zurückstellen weglassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Serviere je einen Löffel Kartoffelstampf auf vier Tellern, gib Eintopf und Klöße darauf und bestreue alles mit gehackter Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
