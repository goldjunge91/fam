      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge in einer Schüssel Rindfleisch, Salz, 1 Prise weißen Pfeffer, 1 Teelöffel Sesamöl, 1/2 Ei, Speisestärke und 1 Esslöffel Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nudeln kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Nudeln in einen 6 qt Topf mit kochendem Wasser, sodass sie bedeckt sind. Koche sie bei hoher Hitze 10 seconds. Gieße sie ab und spüle sie mit kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Im Wok braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 2 Esslöffel Öl und das Rindfleisch in den Wok und brate es bei hoher Hitze, bis es halbgar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das gegarte Rindfleisch aus dem Wok und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib 2 Esslöffel Öl, Zwiebeln, gehackten Knoblauch, gehackten Ingwer, Sojasprossen, Pilze, Zuckerschoten und 1.5 cups Wasser (oder so viel, dass das Gemüse bedeckt ist) in den Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib die Nudeln in den Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Für die Sauce Austernsauce, 1 Prise weißen Pfeffer, 1 Teelöffel Sesamöl, Zucker und 1 Teelöffel Sojasauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib das Rindfleisch zurück in den Wok und brate alles unter Rühren weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
