      "steps": [
        {
          "position": 0,
          "text": "0. Erhitze Öl in einem Topf. Dünste Zwiebel und Knoblauch, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1. Gib das Rindfleisch dazu und brate es an, bis die Außenseite hellbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2. Gib Sojasauce dazu. Gieße Tomatensauce und Wasser hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3. Gib einen Knorr-Rinderbrühwürfel dazu. Schließe den Schnellkochtopf und gare alles 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "4. Brate Karotte und Kartoffel in der Pfanne an, bis sie gebräunt sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "5. Gib Chili, Leberaufstrich und Erdnussbutter dazu. Rühre um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "6. Gib Paprika, gebratene Kartoffel und Karotte dazu. Decke den Topf ab und gare alles weitere 5 to 7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "7. Würze mit Salz und gemahlenem schwarzem Pfeffer. Serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
