      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und 2 Esslöffel Olivenöl in einer Schüssel vermischen, dann nach und nach Wasser hinzufügen und 5 Minuten lang zu einem weichen Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teilen Sie den Teig in 3 gleiche Kugeln und lassen Sie ihn 10 Minuten unter einem Tuch ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rollen Sie jede Kugel auf einer bemehlten Oberfläche sehr dünn aus und bestreichen Sie sie dann mit dem restlichen Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteilen Sie entsteinte Datteln mit Zimt auf jedem dünnen Teigblatt und rollen Sie es dann fest wie eine Spirale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den ausgerollten Teig aufrollen und leicht flach drücken, dann in der Butter bei mittlerer Hitze 5 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Stücke schneiden und warm servieren, optional mit Honig beträufelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
