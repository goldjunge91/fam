      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und die Fleischstücke bei mittlerer bis hoher Hitze von allen Seiten etwa 8 Minuten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln und Knoblauch im selben Topf 3 Minuten anbraten, bis sie weich sind, dann Tomatenmark einrühren und 1 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie das Fleisch wieder in den Topf und fügen Sie Rinderbrühe hinzu, bringen Sie es zum Kochen, reduzieren Sie dann die Hitze und lassen Sie es abgedeckt 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Frik und abgetropfte Kichererbsen in den Topf geben und weitere 15 Minuten köcheln lassen, bis Frik weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und Pfeffer abschmecken, mit frischem Koriander garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
