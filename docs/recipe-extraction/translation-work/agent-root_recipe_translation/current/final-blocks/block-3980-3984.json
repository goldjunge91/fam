      "steps": [
        {
          "position": 0,
          "text": "Kochbananen schälen, indem man die Enden abschneidet und die Schale der Länge nach aufschneidet, dann die Schale abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kochbananen in 2 Zoll Runden schneiden und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebeln und gehackten Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Tomaten hinzufügen und 5 Minuten kochen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kochbananenstücke, Salz und Pfeffer hinzufügen und dann mit Gemüsebrühe aufgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Topf abdecken und 30-35 Minuten köcheln lassen, bis die Kochbananen sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kochbananen teilweise mit einer Gabel zerdrücken, um beim Kochen eine stückige Konsistenz zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Passen Sie die Gewürze an und servieren Sie es heiß als Hauptgericht oder Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
