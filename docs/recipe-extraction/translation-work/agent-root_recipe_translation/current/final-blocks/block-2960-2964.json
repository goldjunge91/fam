          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme Tortillas in einer Pfanne 30 Sekunden pro Seite, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege eine Tortilla flach hin und verteile die warme Bohnenmischung mittig, lasse dabei einen Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege die Bohnen mit gekochtem Reis, grünen Chilischoten und Cheddar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle die Tortilla fest auf und schlage beim Rollen die Seiten ein, sodass ein Burrito entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Burritos mit der Naht nach unten in eine Auflaufform und gieße Enchilada-Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue sie mit zusätzlichem Käse und backe sie bei 350°F 15 Minuten, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
