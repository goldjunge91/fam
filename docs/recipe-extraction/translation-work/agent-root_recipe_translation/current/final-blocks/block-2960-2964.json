      "steps": [
        {
          "position": 0,
          "text": "Schneide das Flankensteak quer zur Faser in dünne Streifen und gib es mit Limettensaft, gehacktem Knoblauch, Kreuzkümmel und Chilipulver in eine Schüssel. Lasse es 15 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Paprika und Zwiebel in 0.5-inch breite Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne oder einem Wok bei hoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das marinierte Steak portionsweise 3-4 Minuten an, bis es gebräunt ist. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Paprika und Zwiebeln in dieselbe Pfanne und gare sie unter häufigem Rühren 5-6 Minuten, bis sie leicht angekohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Steak zurück in die Pfanne, vermische es mit dem Gemüse und würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Tortillas in einer Pfanne 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die Fajita-Mischung auf eine Platte und serviere warme Tortillas dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
