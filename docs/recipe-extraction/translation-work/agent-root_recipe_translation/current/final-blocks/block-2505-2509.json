      "steps": [
        {
          "position": 0,
          "text": "Reis 4 Stunden in Wasser einweichen, dann mit geraspelter Kokosnuss zu einem glatten Teig mahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hefe mit Zucker und 1/4 Tasse warmem Wasser vermischen und 10 Minuten stehen lassen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hefemischung zum Reisteig geben und gut verrühren. Abdecken und 8 Stunden oder über Nacht fermentieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fermentierten Teig umrühren, damit Gas entweicht, dann Salz dazugeben und vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Appam-Pfanne oder beschichtete Pfanne bei mittlerer Hitze erhitzen und jede Mulde leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teig in die Mulden gießen und etwa 3–4 Minuten garen, bis die Ränder goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vorsichtig wenden und die andere Seite hellgoldbraun garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Herausnehmen und warm mit Gemüseeintopf oder Hähnchencurry servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
