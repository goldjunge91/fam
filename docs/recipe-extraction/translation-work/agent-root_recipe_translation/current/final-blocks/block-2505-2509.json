      "steps": [
        {
          "position": 0,
          "text": "Sesamöl in einem schweren Tontopf oder normalen Topf bei mittelhoher Hitze erhitzen und gehackten Knoblauch dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch in den Topf geben und etwa 3–4 Minuten braten, bis es gebräunt ist. Dabei zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gochugaru, Sojasauce und geschnittene Pilze einrühren und 1 Minute garen, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe angießen und zum Kochen bringen. Dann den weichen Tofu vorsichtig löffelweise hineingeben, ohne ihn zu zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze auf mittlere Stufe reduzieren und 5 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drei kleine Vertiefungen in den Tofu drücken und je ein Ei hineinschlagen. Abdecken und 3–4 Minuten köcheln lassen, bis die Eier gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und gehackte Frühlingszwiebeln dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort im heißen Topf mit gedämpftem Reis als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Hinweis: Am besten in einzelnen Schalen direkt aus dem erhitzten Topf servieren und essen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
