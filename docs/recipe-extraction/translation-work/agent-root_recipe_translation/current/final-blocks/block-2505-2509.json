          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch in einer Pfanne bei mittelhoher Hitze anbräunen und beim Garen zerteilen. Dann mit Sojasauce und Sesamöl würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 EL Pflanzenöl in einer Pfanne erhitzen und Eier mit der Spiegelseite nach oben braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gochujang mit 1 EL Sesamöl und 1 EL Sojasauce zu einer Sauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochten Reis auf zwei Schalen verteilen und gegartes Gemüse sowie Rindfleisch in separaten Abschnitten darauf anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Je ein Spiegelei mittig auf jede Schale legen und mit Gochujang-Sauce beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
