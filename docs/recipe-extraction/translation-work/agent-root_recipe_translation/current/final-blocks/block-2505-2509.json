      "steps": [
        {
          "position": 0,
          "text": "Hähnchenoberkeulen in große Stücke schneiden und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sesamöl in einem großen Topf oder Schmortopf bei mittelhoher Hitze erhitzen. Hähnchenstücke etwa 8 Minuten von allen Seiten goldbraun anbraten, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gochugaru, Gochujang, gehackten Knoblauch, Sojasauce und Zucker im selben Topf vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hähnchen zurück in den Topf geben und wenden, damit es gleichmäßig mit der scharfen Mischung überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wasser und gewürfelte Kartoffeln dazugeben und zum Kochen bringen. Hitze reduzieren und abgedeckt 25–30 Minuten köcheln lassen, bis Hähnchen durch und Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gelegentlich umrühren und mehr Wasser hinzufügen, falls die Sauce zu stark einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei Bedarf mit zusätzlichem Salz und Zucker abschmecken, um die Schärfe auszugleichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vom Herd nehmen, gehackte Frühlingszwiebeln dazugeben und in eine Servierschüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit Sesamsamen garnieren und heiß mit gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
