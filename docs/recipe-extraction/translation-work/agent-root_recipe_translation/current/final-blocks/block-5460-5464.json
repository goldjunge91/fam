      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und fette eine 9x13 baking dish mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die Kartoffeln und schneide sie mit einem Hobel oder scharfen Messer in 1/8-inch dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Sahne und Milch mit zerdrückten Knoblauchzehen in einem Topf, bis Dampf aufsteigt. Nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte die Hälfte der Kartoffeln in die Auflaufform und würze jede Lage mit Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Hälfte der Sahnemischung darüber und schichte die übrigen Kartoffeln und Sahne darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form mit Folie ab und backe alles 35 Minuten. Entferne die Folie und backe weitere 15-20 Minuten, bis die Oberfläche goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Gratin vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
