      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und backe die Kartoffeln auf einem Blech 40 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate währenddessen den Speck knusprig und schneide ihn anschließend in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbiere die abgekühlten Kartoffeln längs und höhle sie aus, sodass eine dünne Schale bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische das Kartoffelinnere mit Butter, Sauerrahm, der Hälfte des Käses und dem Speck. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Mischung zurück in die Kartoffelschalen und bestreue sie mit dem restlichen Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie weitere 10 Minuten, bis sie durchgewärmt sind und der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere die Kartoffeln mit Frühlingszwiebeln und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
