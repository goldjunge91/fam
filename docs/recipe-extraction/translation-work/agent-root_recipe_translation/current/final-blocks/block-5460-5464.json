      "steps": [
        {
          "position": 0,
          "text": "Koche die geschälten und gewürfelten Kartoffeln 15 Minuten in Salzwasser, bis sie sehr weich sind. Gieße sie vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke die Kartoffeln durch eine Kartoffelpresse in eine Schüssel und hebe heiße Sahne und 4 Esslöffel Butter unter, bis die Masse glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe Foie gras und Trüffel vorsichtig unter das Kartoffelpüree und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege eine kleine Kastenform mit Frischhaltefolie aus. Drücke die Kartoffelmasse fest hinein und stelle sie 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stürze das Pavé und schneide es in 1-inch dicke Rechtecke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate jede Scheibe in der restlichen Butter bei mittlerer bis hoher Hitze 2-3 Minuten pro Seite an, bis sich eine goldbraune Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Stücke sofort, solange sie innen warm und außen knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
