      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und schneide sie mit einem Messer oder Ausstecher in 2-inch große Zylinder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer großen Pfanne bei mittlerer bis hoher Hitze, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Kartoffelzylinder auf allen flachen Seiten jeweils etwa 2 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Brühe, Thymian und Knoblauch in die Pfanne und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne ab und schmore die Kartoffeln 20-25 Minuten, bis sie beim Einstechen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Deckel ab und lasse die Flüssigkeit bei mittlerer Hitze etwa 5 Minuten auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer und serviere die Kartoffeln mit der reduzierten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
