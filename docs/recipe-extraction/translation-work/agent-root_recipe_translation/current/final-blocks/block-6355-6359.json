      "steps": [
        {
          "position": 0,
          "text": "Kutteln unter fließendem Wasser gründlich reinigen und in 2 Zoll breite Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kutteln und Rinderfüße in kochendem Salzwasser 10 Minuten blanchieren, dann abtropfen lassen und abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem schweren Topf erhitzen und die blanchierten Kutteln und Rinderfüße von allen Seiten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebeln, Karotten, Sellerie und Knoblauch hinzufügen und kochen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatenmark einrühren und 2 Minuten kochen lassen, dann mit Weißwein ablöschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rinderbrühe, Lorbeerblätter und Thymian hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und bei 300 °F im Ofen 3–4 Stunden garen, bis die Kutteln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen, Lorbeerblätter entfernen und in flachen Schüsseln mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
