          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 20–25 Minuten köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
