      "steps": [
        {
          "position": 0,
          "text": "Zwiebel sehr fein hacken und mit Rinderhackfleisch, Schweinehackfleisch, Ei, Semmelbröseln, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Masse zu 1.5 Zoll großen Bällchen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze schmelzen und die Fleischbällchen portionsweise insgesamt etwa 10 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Fleischbällchen herausnehmen und beiseitestellen, dann Brühe in die Pfanne geben und dabei die Bratrückstände lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sahne und Preiselbeermarmelade einrühren, bis die Sauce glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Fleischbällchen zurück in die Pfanne geben und 10 Minuten köcheln lassen, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und die Würzung anpassen, dann über Eiernudeln oder Kartoffelpüree servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
