      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen, dann kalte Butter einarbeiten, bis die Mischung Brotkrümeln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eigelb und so viel kaltes Wasser hinzufügen, dass ein Teigball entsteht, dann 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ricotta, Ei und Muskatnuss für die Füllung in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig dünn ausrollen und in 3-Zoll-Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf jedes Quadrat einen kleinen Löffel Käsefüllung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig diagonal zusammenlegen und die Ränder mit einer Gabel andrücken, um sie zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Öl auf 350°F erhitzen und die Teigtaschen 2-3 Minuten pro Seite goldbraun ausbacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
