      "steps": [
        {
          "position": 0,
          "text": "Lachs mit Küchenpapier trocken tupfen und mit der Hautseite nach unten auf ein Stück Frischhaltefolie legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salz, Zucker, Pfefferkörner und Zitronenschale in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hälfte der Salzmischung auf dem Lachsfilet verteilen, dann mit frischem Dill bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die restliche Salzmischung über dem Dill verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fest in Frischhaltefolie wickeln und auf einen Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "24-48 Stunden kalt stellen, nach der Hälfte der Zeit einmal wenden und vorsichtig andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auswickeln, leicht abspülen, trocken tupfen und vor dem Servieren schräg in dünne Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
