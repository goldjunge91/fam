      "steps": [
        {
          "position": 0,
          "text": "Vermenge Zucker, Wasser, Zitronensaft, Zimtstange und Nelken in einem Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lass alles 10 Minuten köcheln. Rühre gelegentlich, bis sich der Zucker vollständig aufgelöst hat.",
