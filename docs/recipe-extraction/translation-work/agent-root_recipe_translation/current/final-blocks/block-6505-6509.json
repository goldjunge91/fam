      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und schneide das Pita-Brot in Dreiecke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die Pita-Dreiecke mit 1 Esslöffel Olivenöl, verteile sie auf einem Backblech und backe sie 10 Minuten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spüle die Kichererbsen ab und lass sie abtropfen. Erwärme sie dann mit 2 Esslöffels Olivenöl 5 Minuten bei mittlerer Hitze in einem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere Tahini, Zitronensaft, gehackten Knoblauch, Wasser und Salz in einer Küchenmaschine cremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Tahinisauce in einer flachen Schalenform auf einer Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib warme Kichererbsen in die Mitte der Tahinisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege alles mit knusprigen Pita-Chips, beträufle es mit dem restlichen Olivenöl und bestreue es mit Paprikapulver und Petersilie. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
