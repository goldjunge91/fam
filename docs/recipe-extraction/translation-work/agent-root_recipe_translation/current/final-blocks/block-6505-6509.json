      ],
      "steps": [
        {
          "position": 0,
          "text": "Bringe Hühnerbrühe mit einer halbierten Zwiebel in einem großen Topf zum Kochen und gib die Hähnchenbrust dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass das Hähnchen 15 Minuten köcheln, bis es gar ist. Nimm es heraus und zupfe es in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das gezupfte Hähnchen zurück in die Brühe, füge Reis hinzu und lass alles 15 Minuten köcheln, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage die Eier in einer Schüssel hell auf und rühre dann langsam Zitronensaft ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd und träufle die Eiermischung sehr langsam unter ständigem Rühren in die heiße Brühe, sodass Fäden entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz, weißem Pfeffer und frischem Dill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Suppe sofort heiß. Koche sie nach Zugabe der Eimischung nicht mehr auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
