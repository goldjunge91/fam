      "steps": [
        {
          "position": 0,
          "text": "Gieße Tahini in eine große Rührschüssel und rühre es glatt und cremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre nach und nach esslöffelweise Öl ein, bis es vollständig aufgenommen und die Masse heller ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Vanilleextrakt und Salz dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Siebe nach und nach Puderzucker hinein und rühre weiter, bis die Masse dick und teigartig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Masse in eine gefettete 8x8 inch Backform und drücke sie mit einem geölten Teigschaber fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streiche die Oberfläche glatt und garniere sie mit gehackten Pistazien. Drücke sie leicht in die Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Form 30 Minuten kalt, schneide die Halva dann in kleine Quadrate und serviere sie gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
