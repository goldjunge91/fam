          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Walnüsse mindestens 20 Minuten im Sirup auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die kandierten Walnüsse mit etwas Sirup in Serviergläser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie bei Zimmertemperatur als Löffelsüßigkeit zu Kaffee oder griechischem Joghurt.",
