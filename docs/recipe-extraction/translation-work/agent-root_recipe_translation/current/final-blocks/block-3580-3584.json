      "steps": [
        {
          "position": 0,
          "text": "Eiernudeln nach Packungsanleitung kochen, abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hühnerbrühe in einem großen Topf zum Kochen bringen, dann Sojasauce und Austernsauce hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch und Schalotten hacken und in einer separaten Pfanne 1 Minute in Öl anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen in die Pfanne geben und je Seite 2-3 Minuten garen, bis sie rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochte Nudeln in die Brühe geben und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frühlingszwiebeln hacken und die Knoblauch-Garnelen-Mischung schneiden, dann Nudeln und Brühe auf Servierschüsseln verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Schüssel mit Garnelenmischung, Bohnensprossen und Frühlingszwiebeln belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit zusätzlicher Sojasauce und Chiliöl dazu servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
