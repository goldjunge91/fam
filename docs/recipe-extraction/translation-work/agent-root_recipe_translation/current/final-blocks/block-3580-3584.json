      "steps": [
        {
          "position": 0,
          "text": "Wasser in einem Wasserkocher aufkochen und mit den Teebeuteln in eine Teekanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tee 3-4 Minuten ziehen lassen, bis er kräftig und dunkel ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gezuckerte und ungesüßte Kondensmilch in zwei hohe Gläser gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den frisch gebrühten heißen Tee in ein separates Kännchen oder eine Tasse gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Tee vorsichtig aus großer Höhe in einem gleichmäßigen Strahl über die Milch gießen, damit er sich vermischt und Schaum bildet; das ist die traditionelle Ziehtechnik.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Mischung 2-3 Mal zwischen Kännchen und Glas hin- und hergießen, damit Schaum entsteht und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die fertige Mischung in die beiden Serviergläser gießen und nach Geschmack Zucker hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß in hohen Gläsern mit einem Löffel servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
