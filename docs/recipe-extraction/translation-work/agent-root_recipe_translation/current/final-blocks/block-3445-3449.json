      "steps": [
        {
          "position": 0,
          "text": "Würfle Hähnchenbrust und gare sie in Öl bei starker Hitze etwa 5-7 Minuten, bis sie durch ist. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Kohl, Karotte und Zwiebel in mundgerechte Stücke und hacke die grüne Chilischote.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib in derselben Pfanne oder auf der Grillplatte das restliche Öl dazu und brate die Zwiebeln 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Karotten und Kohl dazu und brate sie 3-4 Minuten bei starker Hitze unter Rühren, bis sie leicht weich, aber noch knackig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Roti in 1-inch große Stücke und gib sie zusammen mit dem gegarten Hähnchen in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue Currypulver und Sojasauce darüber und vermische alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schiebe die Mischung an den Rand, verrühre das Ei in der freien Fläche und mische es dann unter die übrigen Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib grüne Chilischote, Salz und Pfeffer nach Geschmack dazu und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
