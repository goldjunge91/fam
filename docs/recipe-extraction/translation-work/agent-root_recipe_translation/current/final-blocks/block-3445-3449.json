          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe sie 12-15 Minuten, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie aus dem Dämpfer und lasse sie vor dem Herauslösen 2 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
