      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne und dünste fein gehackte Zwiebeln, Knoblauch und Ingwer 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rinderhackfleisch dazu und gare es bei mittelhoher bis hoher Hitze 5-7 Minuten krümelig, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Currypulver ein und gare es eine weitere Minute, damit sich die Gewürzaromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle die Kartoffel und gib sie zusammen mit grünen Erbsen zum Fleisch. Gare alles 8-10 Minuten, bis die Kartoffeln zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochten Reis, Sojasauce, Salz und Pfeffer zur Fleischmischung und rühre alles gut unter. Gare es 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erweiche Bananenblätter, indem du sie über eine offene Flamme hältst, und schneide sie dann in Viertel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Teile die Reis-Fleisch-Mischung in 4 Portionen und wickle jede fest in ein Bananenblatt. Verschließe die Ränder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege die Päckchen auf ein Backblech und backe sie bei 350°F 15-20 Minuten oder dämpfe sie zugedeckt in einem Topf 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie heiß in der Bananenblattverpackung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
