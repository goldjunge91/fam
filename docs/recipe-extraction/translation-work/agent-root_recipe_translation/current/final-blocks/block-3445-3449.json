      "steps": [
        {
          "position": 0,
          "text": "Röste Erdnüsse 5 Minuten in einer trockenen Pfanne bei mittlerer Hitze. Nimm sie heraus und lasse sie leicht abkühlen, bevor du die Haut durch Reiben entfernst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Sesam separat in derselben Pfanne 2-3 Minuten trocken, bis er duftet, und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerdrücke Kardamomkapseln, löse die Samen heraus und wirf die Kapseln weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Ghee in der Pfanne und gib Jaggery dazu. Rühre, bis er vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib geröstete Erdnüsse, Sesam, Kardamomsamen, Kokosnuss und Salz zum geschmolzenen Jaggery und vermische alles gründlich 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Mischung auf einen gefetteten Teller oder Backpapier und verstreiche sie mit einem gefetteten Löffel gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie 20 Minuten abkühlen, bis sie leicht fest ist, und schneide sie dann in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
