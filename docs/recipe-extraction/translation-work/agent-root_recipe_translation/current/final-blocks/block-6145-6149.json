      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hammelfleisch in mittelgroße Stücke und reinige es gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Koriander- und Kreuzkümmelsamen trocken an und mahle sie anschließend fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem schweren Topf und brate die Zwiebelscheiben kräftig an, bis sie dunkelbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Ingwer-Knoblauch-Paste hinzu und gare sie 1 Minute. Füge dann die Tomaten hinzu und gare sie weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Chilipulver und die gemahlenen Gewürze dazu und rühre alles bei niedriger Hitze 2 Minuten um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Füge Hammelfleisch und Salz hinzu und brate alles bei hoher Hitze unter Rühren 3–4 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mahle die Kokosnuss fein und gib sie in den Topf. Gieße Wasser dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse das Curry 45–50 Minuten köcheln, bis das Fleisch ganz zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
