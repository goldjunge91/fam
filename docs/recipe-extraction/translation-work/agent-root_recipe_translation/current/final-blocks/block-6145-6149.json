      "steps": [
        {
          "position": 0,
          "text": "Hänge Naturjoghurt 2–3 Stunden oder über Nacht in einem Seihtuch auf, damit die Molke abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerstoße die Kardamomkapseln, entnimm die Samen und mahle sie fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche die Safranfäden in 2 Esslöffeln warmer Milch 5 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Mandeln und Pistazien in dünne Streifen und röste sie leicht in Ghee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische abgetropften Joghurt, Zucker, Kardamompulver und Safran samt Milch in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage alles kräftig glatt und cremig auf und verteile die Masse auf Servierschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere jede Schale mit gerösteten Nüssen und einigen Safranfäden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
