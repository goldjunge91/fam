      "steps": [
        {
          "position": 0,
          "text": "Weiche Sabudana 30 Minuten in Wasser ein, bis die Kügelchen aufgequollen und durchsichtig sind. Gieße sie anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Kartoffeln in kleine Würfel und röste die Erdnüsse in einer trockenen Pfanne leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne und gib die Kreuzkümmelsamen hinein. Röste sie, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib fein gehackte Zwiebel und grüne Chili hinzu und dünste sie, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Kartoffelwürfel und Kurkuma hinzu, rühre um und gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib abgetropfte Sabudana und geröstete Erdnüsse dazu, vermische alles und gare es 3–4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz ab, bestreue das Gericht mit Koriander und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
