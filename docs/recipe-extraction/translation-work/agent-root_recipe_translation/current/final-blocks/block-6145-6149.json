      "steps": [
        {
          "position": 0,
          "text": "Mariniere die Hähnchenstücke 30 Minuten in Joghurt, Kurkuma, Salz und gehacktem Ingwer-Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Reis und Dal getrennt 30 Minuten ein und gieße beides anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mahle den abgetropften Reis und Dal mit gehackten Zwiebeln, grünen Chilis und dem restlichen Ingwer-Knoblauch grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne und gare die gemahlene Mischung bei niedriger Hitze 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das marinierte Hähnchen zur Mischung und rühre gut um, damit es gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme die Mischung mit einer feuchten Handfläche zu ovalen oder runden Küchlein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einem tiefen Topf und gib die Küchlein vorsichtig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frittiere sie bei mittlerer Hitze 6–8 Minuten rundherum goldbraun und wende sie vorsichtig. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
