      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und in 1-Zoll große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lauch putzen, die dunkelgrünen Teile entfernen und in 1-Zoll dicke Ringe schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen großen Topf mit gesalzenem Wasser zum Kochen bringen und Kartoffeln und Lauch hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "20 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Gemüse abgießen und zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Butter und Milch dazugeben und stampfen, bis die Masse cremig, aber noch leicht stückig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz, Pfeffer und Muskatnuss würzen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
