      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln und Perlzwiebeln in gesalzenem Wasser 15-18 Minuten kochen, bis sie sich mit einer Gabel leicht einstechen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geschnittenen Raclettekäse, Schinken und vorbereitetes Gemüse auf einer Platte anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Raclette- oder gusseisernes Pfännchen bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Käsescheiben oder kleine Stücke vom Käselaib auf die heiße Fläche legen und etwa 2-3 Minuten schmelzen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald der Käse geschmolzen ist und Blasen wirft, den geschmolzenen Käse auf einen warmen Teller schaben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dazu gekochte Kartoffeln, Zwiebeln, Cornichons, Schinken und frischen Pfeffer reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für jeden Gast wiederholen und das Pfännchen während der gesamten Mahlzeit laufend nachfüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
