      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und fein in ein Sieb reiben; überschüssige Flüssigkeit mit Küchenpapier ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die halbe Zwiebel fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geriebene Kartoffeln mit gehackter Zwiebel, Salz und Pfeffer vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1.5 EL Butter und 1 EL Öl in einer großen beschichteten Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hälfte der Kartoffelmischung fest in die Pfanne drücken und dabei einen flachen, gleichmäßigen Puffer formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "6-8 Minuten ohne Rühren braten, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einen Teller gleiten lassen, die restliche Butter und das restliche Öl in die Pfanne geben, die Rösti zurück in die Pfanne wenden und die andere Seite 6-8 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf eine Servierplatte gleiten lassen, in Spalten schneiden und mit Schnittlauch bestreuen; heiß mit Apfelmus oder saurer Sahne servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
