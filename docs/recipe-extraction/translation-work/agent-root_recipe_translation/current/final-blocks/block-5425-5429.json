      "steps": [
        {
          "position": 0,
          "text": "Heize das Waffeleisen und den Ofen auf 200°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Mehl, Backpulver, Zucker und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage die Eier in einer zweiten Schüssel mit Milch und geschmolzener Butter gut auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge die flüssigen und trockenen Zutaten und rühre nur so lange, bis sie gerade verbunden sind. Kleine Klümpchen dürfen bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in ein gefettetes Waffeleisen und backe die Waffeln etwa 4–5 Minuten pro Stück goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Halte die fertigen Waffeln im Ofen warm, während der restliche Teig ausgebacken wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme die Schinkenscheiben in einer Pfanne je Seite 1–2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege Schinken und Käse zwischen zwei Waffeln, beträufle sie mit Ahornsirup und serviere die Sandwiches.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
