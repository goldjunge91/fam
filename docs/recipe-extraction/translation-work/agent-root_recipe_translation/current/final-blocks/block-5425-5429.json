      "steps": [
        {
          "position": 0,
          "text": "Schneide die Chorizo in dünne Scheiben und brate sie bei mittlerer bis hoher Hitze 3–4 Minuten, bis die Ränder gebräunt sind und Fett austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch dazu und brate sie 2–3 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die gerösteten Paprika und Paprika dazu, verrühre alles und schiebe die Mischung an den Pfannenrand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage die Eier auf die freie Pfannenseite und rühre sie etwa 3–4 Minuten zu Rührei, bis sie gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Hoagie-Brötchen auf und röste sie in einer trockenen Pfanne oder im Ofen leicht goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Chorizo-Ei-Mischung auf beide Brötchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
