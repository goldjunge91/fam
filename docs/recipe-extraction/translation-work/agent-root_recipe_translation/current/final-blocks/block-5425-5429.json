      "steps": [
        {
          "position": 0,
          "text": "Brate die Speckscheiben bei mittlerer Hitze etwa 5–7 Minuten knusprig. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Wurst-Patties in dieselbe Pfanne und brate sie insgesamt etwa 6–8 Minuten, bis sie auf beiden Seiten gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Blutwurstscheiben dazu und brate sie je Seite 2 Minuten. Schiebe das Fleisch anschließend an den Pfannenrand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Tomate in Scheiben und brate sie mit der Schnittseite nach unten 1–2 Minuten in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Eier in die Pfanne und brate sie nach Wunsch. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide die Brötchen auf und erwärme sie 30 Sekunden im Ofen oder direkt in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die warmen Brötchen mit Butter und fülle sie jeweils mit Speck, Wurst, Blutwurst, Tomate und einem Spiegelei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
