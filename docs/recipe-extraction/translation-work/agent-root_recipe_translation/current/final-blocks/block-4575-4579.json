      "steps": [
        {
          "position": 0,
          "text": "In einem Schraubglas oder Behälter Haferflocken, Milch, griechischen Joghurt, Erdnussbutter und Honig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Alles gut verrühren, damit sich die Erdnussbutter löst und die Zutaten gleichmäßig vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vanilleextrakt und Chiasamen hinzufügen und erneut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit einem Deckel verschließen und über Nacht oder mindestens 4 Stunden im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Am Morgen umrühren und mehr Milch hinzufügen, falls die Mischung zu dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Banane in Scheiben schneiden und auf den Haferflocken verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kalt aus dem Glas essen oder nach Wunsch 1-2 Minuten in der Mikrowelle erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
