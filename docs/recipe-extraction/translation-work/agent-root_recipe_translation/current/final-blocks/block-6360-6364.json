      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und Fenchelscheiben und Zwiebeln anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Kartoffeln, Fischbrühe, gehackten Knoblauch und Safran hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze reduzieren und 15 Minuten köcheln lassen, bis die Kartoffeln fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Fischfilets vorsichtig dazugeben und 8–10 Minuten pochieren, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch und Kartoffeln mit einem Schaumlöffel herausnehmen und auf einer Servierplatte warm halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Kochflüssigkeit in eine Schüssel abseihen und etwas abkühlen lassen. Dann Mayonnaise und Eigelb glatt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Mischung zurück in den Topf geben und bei geringer Hitze unter ständigem Rühren erwärmen, bis sie eine sämige Konsistenz erreicht. Nicht kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Safransauce über den Fisch und das Gemüse gießen, mit Fenchelblättern garnieren und mit geröstetem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
