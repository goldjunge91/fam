      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter und Schweinebauch in 2 Zoll große Stücke schneiden und in einen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mit Wasser bedecken und Salz, Pfeffer, Thymian und Lorbeerblatt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aufkochen lassen, dann die Hitze reduzieren und zugedeckt 2.5 Stunden köcheln lassen, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Schweinefleisch abgießen, 1/2 Tasse Kochflüssigkeit auffangen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schweinefleisch mit zwei Gabeln in feine Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehackte Schalotten in Butter weich kochen und dann zum zerkleinerten Schweinefleisch geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beiseite gestellte Kochflüssigkeit untermischen, bis die Mischung eine streichfähige Konsistenz erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In eine Terrine oder eine Servierschüssel geben, abkühlen lassen und im Kühlschrank aufbewahren, bis es fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf geröstetem Brot mit Gurken und Cornichons servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
