          "images": []
        },
        {
          "position": 4,
          "text": "Frischen Zitronensaft auspressen und zur Schalottenmischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In jede Auster eine kleine Menge Vinaigrette geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit frischen Zitronenschnitzen und schwarzem Pfeffer servieren.",
          "timerMinutes": null,
