      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 300 °F vorheizen und eine große Form aus Steingut oder Keramik mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis, Milch, Zucker, Butter und Zimtstange in der Auflaufform vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gut umrühren und gemahlenen Zimt und Muskat darüber streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ohne Deckel 2.5–3 Stunden backen und gelegentlich, etwa alle 45 Minuten, umrühren, damit nichts ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Der Reis sollte die Milch aufsaugen und oben eine goldene Kruste bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen und die Zimtstange wegwerfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vanilleextrakt und zusätzliches Salz nach Geschmack einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm in Schüsseln servieren und bei Bedarf die aromatische Kruste von den Seiten abkratzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
