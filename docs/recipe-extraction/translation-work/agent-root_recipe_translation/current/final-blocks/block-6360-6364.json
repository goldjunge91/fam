      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz mischen. Kalte Butter einarbeiten, bis die Mischung wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach Wasser hinzufügen, bis der Teig gerade zusammenkommt, dann 20 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Äpfel schälen, entkernen und in dünne Scheiben schneiden, dann mit Zucker und Zimt vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig zu einem dünnen, runden Blech ausrollen und auf ein Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Apfelscheiben überlappend auf dem Teig anordnen und dabei einen 2 Zoll breiten Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Teigränder in rustikalen Falten über die Äpfel falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit verquirltem Ei bestreichen und bei 400 °F 25–30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
