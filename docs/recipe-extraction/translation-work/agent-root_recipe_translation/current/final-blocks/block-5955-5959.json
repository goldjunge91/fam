      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf mit Salzwasser sprudelnd zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Hummer mit dem Kopf voran hinein und decke den Topf ab. Koche sie 12–15 Minuten, bis die Schalen leuchtend rot sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle währenddessen die Kartoffeln, schneide sie in 2 Zoll große Stücke und koche sie 15 Minuten in Salzwasser weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Hummer heraus und lasse sie etwas abkühlen. Halbiere sie längs und löse das Fleisch aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Kartoffeln ab und vermenge sie mit geschmolzener Butter, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Kartoffeln und Hummerfleisch auf Tellern an und garniere sie mit Petersilie und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
