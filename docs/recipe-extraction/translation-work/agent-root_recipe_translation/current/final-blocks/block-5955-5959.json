      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400 °F vor und schäle die Kartoffeln. Lege jede Kartoffel auf ein Schneidebrett und platziere einen Holzlöffel daneben als Anschlag.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide jede Kartoffel von oben in Abständen von etwa einem Viertel Zoll ein. Schneide dabei nur bis zu drei Vierteln durch; der Holzlöffel verhindert, dass du ganz durchschneidest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Kartoffeln mit den Einschnitten nach oben in eine Auflaufform und bestreiche sie großzügig mit einer Mischung aus geschmolzener Butter und Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile gehackten Knoblauch zwischen den Kartoffelscheiben. Stecke einige kleine Rosmarinstücke und dünne Butterstücke zwischen die Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze die Oberseiten großzügig mit Salz und Pfeffer und gieße die Brühe um die Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Thymianzweige in die Brühe und decke die Auflaufform mit Folie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Kartoffeln zugedeckt 35 Minuten. Entferne die Folie und backe sie weitere 10 Minuten, bis sie weich und oben goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Kartoffeln heiß direkt aus der Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
