      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und reibe sie fein. Drücke überschüssige Flüssigkeit mit einem sauberen Küchentuch aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Zwiebel fein und vermische sie in einer Schüssel mit den geriebenen Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle das Ei und vermische es mit der Kartoffelmasse, Mehl, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Öl in einer großen Pfanne bei mittelhoher Hitze, bis es glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Löffel der Masse ins Öl und drücke sie mit einem Pfannenwender zu dünnen, etwa 3 Zoll breiten Puffern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate sie auf jeder Seite 3–4 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Puffer auf Küchenpapier abtropfen und serviere sie sofort mit Apfelmus und saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
