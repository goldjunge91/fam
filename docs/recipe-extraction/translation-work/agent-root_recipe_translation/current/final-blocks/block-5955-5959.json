      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400 °F vor und stich die Kartoffeln rundherum mit einer Gabel ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe die Kartoffeln 45–50 Minuten direkt auf dem Ofenrost, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze währenddessen die Baked Beans in einem Topf bei mittlerer Hitze, bis sie warm sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Kartoffeln aus dem Ofen und halbiere sie längs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Löffle aus jeder Hälfte etwas Kartoffelinneres heraus und entsorge es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Kartoffelhälften auf Teller, gib jeweils einen Löffel Baked Beans darauf und bestreue sie großzügig mit Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schiebe sie weitere 3–5 Minuten in den Ofen, bis der Käse geschmolzen ist. Gib anschließend Butter, Schnittlauch, Salz und Pfeffer darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
