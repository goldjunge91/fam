      "steps": [
        {
          "position": 0,
          "text": "Achiote-Paste mit Orangensaft, Limettensaft, Knoblauch, Kreuzkümmel, Nelken und Salz zu einer Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweineschulter rundherum mit der Paste einreiben, abdecken und mindestens 2 Stunden im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backofen auf 325°F vorheizen und eine Auflaufform mit Bananenblättern auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mariniertes Schweinefleisch mittig hineinlegen, Bananenblätter darüberfalten und fest mit Folie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "4.5 bis 5 Stunden backen, bis sich das Schweinefleisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen, leicht abkühlen lassen und Schweinefleisch in mundgerechte Stücke zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garflüssigkeit abseihen und über das zerteilte Schweinefleisch träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf warmen Tortillas mit gewürfelter roter Zwiebel und Koriander servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
