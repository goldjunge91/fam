      "steps": [
        {
          "position": 0,
          "text": "Mehltortillas stapeln und in je 6 Spalten schneiden (wie Pizzastücke), sodass insgesamt 36 Stücke entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pflanzenöl in einer tiefen Pfanne auf 350°F erhitzen (ein kleines Stück Tortilla sollte sofort brutzeln, wenn es hineingegeben wird).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tortillastücke vorsichtig in kleinen Portionen von etwa 10–12 Stück in das heiße Öl geben und 1–2 Minuten hellgolden und knusprig frittieren; dabei vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Chacales mit einer Schaumkelle herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Noch warm die frittierten Tortillastücke in einer flachen Schüssel mit Puderzucker und gemahlenem Zimt vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf eine Servierplatte geben und warm als süßen Snack genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
