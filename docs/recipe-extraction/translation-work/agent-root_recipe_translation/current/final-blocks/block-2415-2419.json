      "steps": [
        {
          "position": 0,
          "text": "Limettensaft, Orangensaft, Knoblauch, Kreuzkümmel, Oregano, Olivenöl und geschnittene Jalapeños in einem Mixer pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Skirt Steak in einen Beutel mit Zipverschluss geben, Marinade darüber gießen, verschließen und 4–8 Stunden im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Steak 30 Minuten vor dem Garen aus dem Kühlschrank nehmen und Grill auf hohe Hitze vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Steak für medium-rare 5–7 Minuten pro Seite grillen und gelegentlich mit übriger Marinade bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fleisch 10 Minuten ruhen lassen und dann quer zur Faser in Streifen von quarter-inch Dicke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tortillas kurz auf dem Grill erwärmen und dann mit Carne Asada füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit gewürfelter Zwiebel, Koriander, Limettenspalten und Salsa servieren.",
