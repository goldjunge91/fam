      "steps": [
        {
          "position": 0,
          "text": "Masa Harina, warmes Wasser und Salz in einer Schüssel vermischen, bis ein weicher Teig entsteht. 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig in 8 gleich große Portionen teilen, zu Kugeln formen und jede auf Frischhaltefolie zu einer Scheibe von 3 inch Durchmesser und etwa 1/4 inch Dicke flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pflanzenöl in einer Pfanne bei mittelhoher Hitze erhitzen. Jede Masa-Scheibe vorsichtig in das heiße Öl gleiten lassen und 1–2 Minuten leicht goldbraun braten, dann wenden und die andere Seite 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sopes herausnehmen und sofort, solange sie noch warm und biegsam sind, die Ränder zu einer niedrigen Wand hochdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Löffel warmes Bohnenmus auf jede Sope streichen und mit zerteiltem Hähnchen belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Sope mit zerkleinertem Salat, zerbröckeltem Queso Fresco und einem Klecks saurer Sahne belegen, dann mit Salsa beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
