      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter mit der Hälfte der Zwiebel und Salz in 8 Tassen Wasser 1.5 Stunden sehr zart kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stiele und Kerne der getrockneten Chilis entfernen und 15 Minuten in heißem Wasser einweichen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eingeweichte Chilis mit Knoblauch, Kreuzkümmel und 1 Tasse Einweichflüssigkeit glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Chilimischung durch ein feines Sieb in die Schweinebrühe abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgetropften Mais dazugeben und 20 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schweinefleisch mit zwei Gabeln zerteilen und zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Limettensaft würzen und in Schalen mit gewürfelter Zwiebel und Limettenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nach Wunsch mit gehobeltem Kohl, Radieschen und Tostadas garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
