      "steps": [
        {
          "position": 0,
          "text": "Froschschenkel mit Küchenpapier trocken tupfen und leicht salzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Wok oder einer großen Pfanne bei hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Froschschenkel hineingeben und 4-5 Minuten unter Rühren anbraten, bis sie leicht gebräunt sind, dann herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Im selben Wok Knoblauch, Ingwer und rote Chilis unter ständigem Rühren 30 Sekunden anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Froschschenkel zurück in den Wok geben und Sojasauce, Essig, Zucker und Brühe hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "6-8 Minuten unter Rühren braten, bis die Froschschenkel gar sind und die Sauce leicht eingekocht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frühlingszwiebeln unterheben und vor dem Servieren 1 Minute gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
