      "steps": [
        {
          "position": 0,
          "text": "Koche Jasminreis und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch und Chilis zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und Chilis hinein und brate sie unter Rühren 30 Sekunden an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinehackfleisch dazu und zerteile es beim Garen. Brate es 5-7 Minuten, bis es vollständig durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Sojasauce, Fischsauce und braunen Zucker dazu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zupfe die Basilikumblätter mit den Händen klein und gib sie zum Schweinefleisch. Wende alles rasch 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht auf Reis und belege es nach Wunsch mit einem Spiegelei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
