      "steps": [
        {
          "position": 0,
          "text": "Erhitze 3 Esslöffel Kokosmilch in einer großen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Currypaste dazu und brate sie 2 Minuten an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die restliche Kokosmilch hinein und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide das Hähnchen in mundgerechte Stücke und gib es zum Curry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass alles 12-15 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide Paprika in Streifen und gib sie zusammen mit den abgetropften Bambussprossen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles weitere 5 Minuten, bis die Paprika bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke das Curry mit Fischsauce, Limettensaft und braunem Zucker ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Vor dem Servieren mit zerstoßenen Erdnüssen und Basilikum garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
