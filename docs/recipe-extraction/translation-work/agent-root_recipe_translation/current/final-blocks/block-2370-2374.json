          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd und lass die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Limettensaft, Fischsauce und getrocknete Chilis ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Reismehl dazu und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hacke Minze, Koriander und Frühlingszwiebeln und rühre sie unter die Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Mischung in Salatblättern als Wraps, dazu gewürfelte rote Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
