      "steps": [
        {
          "position": 0,
          "text": "Butter in einem großen Topf schmelzen und gewürfelte Zwiebeln und Sellerie etwa 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streuen Sie Mehl über das Gemüse und rühren Sie es 1 Minute lang ständig um, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischbrühe angießen und gewürfelte Kartoffeln dazugeben; zum Kochen bringen und 10 Minuten köcheln lassen, bis die Kartoffeln fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Fisch in mundgerechte Stücke schneiden und zusammen mit den Garnelen in den Topf geben. 5 Minuten köcheln lassen, bis die Meeresfrüchte gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sahne einrühren und ca. 2 Minuten erwärmen, ohne zu kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Großzügig mit Salz und weißem Pfeffer würzen und heiß mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
