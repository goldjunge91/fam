      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 400 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischen Sie Vollkornmehl, Allzweckmehl, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Buttermilch einrühren, bis ein zottiger Teig entsteht; nicht übermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig auf dem Backblech zu einem runden Laib formen und oben mit einem Messer ein Kreuz einritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "30-35 Minuten backen, bis das Brot goldbraun ist und beim Klopfen hohl klingt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwas abkühlen lassen, in Scheiben schneiden und leicht rösten; Mit Butter und Frischkäse bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit geräuchertem Lachs belegen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
