      "steps": [
        {
          "position": 0,
          "text": "Erhitzen Sie eine große Pfanne bei mittlerer bis hoher Hitze und braten Sie die Speckscheiben etwa 5 Minuten pro Seite, bis sie knusprig sind, und legen Sie sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In derselben Pfanne die Würstchen 8–10 Minuten anbraten, dabei gelegentlich wenden und dann herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Champignons und Tomaten in Scheiben schneiden, dann die Champignons im restlichen Fett 3 Minuten anbraten und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Halbierte Tomaten in die Pfanne geben und mit der Schnittfläche nach unten 2 Minuten braten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärmen Sie gebackene Bohnen in einem kleinen Topf bei schwacher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier in der Pfanne etwa 3–4 Minuten bis zum gewünschten Gargrad braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Speck, Würstchen, Eier, Pilze, Tomaten und Bohnen auf einem Teller anrichten und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
