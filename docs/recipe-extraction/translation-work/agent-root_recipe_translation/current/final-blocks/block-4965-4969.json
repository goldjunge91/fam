      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und wickle eine 7-inch Springform mit Alufolie ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Graham-Cracker-Brösel mit geschmolzener Butter und drücke sie fest auf den Boden der Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Frischkäse glatt. Gib nach und nach Zucker dazu und rühre 2 Minuten weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Eier einzeln dazu und rühre nach jedem Ei. Rühre anschließend saure Sahne, Passionsfruchtpüree, Vanille und Zitronensaft ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig über den Boden und stelle die Springform in eine größere Bratform, die mit 1 inch heißem Wasser gefüllt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Kuchen 45-50 Minuten, bis der Rand fest ist und die Mitte beim Bewegen noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schalte den Ofen aus und öffne die Tür 4 inches weit. Lass den Käsekuchen 1 Stunde im Ofen ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm ihn aus dem Ofen und dem Wasserbad. Lass ihn vollständig abkühlen und stelle ihn vor dem Herauslösen und Anschneiden mindestens 6 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
