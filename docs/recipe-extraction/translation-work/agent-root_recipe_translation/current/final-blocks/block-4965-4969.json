      "steps": [
        {
          "position": 0,
          "text": "Verreibe kalte Butter mit Mehl und Salz, bis eine krümelige Masse entsteht. Gib Eiswasser dazu, bis sich der Teig verbindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Teig in zwei Hälften, forme flache Scheiben, wickle sie in Folie und stelle sie 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 375°F vor und rolle eine Teigscheibe für eine 9-inch Kuchenform aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge Rhabarber, Zucker, Maisstärke und Zitronensaft und fülle die Mischung in den Teigboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle die zweite Teigscheibe aus und lege sie darüber. Drücke die Ränder zum Verschließen zusammen und forme sie dekorativ.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle das Ei mit 1 Esslöffel Wasser und bestreiche damit die obere Teigschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide Lüftungsschlitze in den Teigdeckel und backe den Kuchen 50-60 Minuten, bis er goldbraun ist und die Füllung am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Kuchen vor dem Anschneiden mindestens 30 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
