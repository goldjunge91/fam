          "images": []
        },
        {
          "position": 3,
          "text": "Schlage die Sahne in einer separaten Schüssel mit einem elektrischen Mixer zu weichen Spitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
