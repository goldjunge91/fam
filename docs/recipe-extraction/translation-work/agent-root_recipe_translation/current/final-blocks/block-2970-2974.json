      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Topf und bräune das Fleisch mit gewürfelter Zwiebel 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Ingwer und Knoblauch hinzu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe hinzu und bringe sie zum Kochen. Reduziere dann die Hitze und lasse alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib ganze Scotch-Bonnet-Chilis, schwarze Pfefferkörner, Thymian und Salz hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles weitere 15 Minuten köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere die Suppe und passe die Würzung bei Bedarf an. Sie sollte scharf bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Suppe heiß in Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
