      "steps": [
        {
          "position": 0,
          "text": "Schäle die Yamswurzeln, indem du die dicke Schale mit einem Messer entfernst und die faserige Schicht darunter abziehst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die geschälten Yamswurzeln in gleichmäßige Stücke von etwa 2 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe Salzwasser in einem großen Topf zum Kochen und gib die Yamsstücke hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche sie 15-20 Minuten, bis sie ganz weich sind und sich leicht mit einer Gabel durchstechen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße sie gründlich ab und hebe 1 Tasse Kochwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerdrücke sie mit einem Holzstößel oder einem stabilen Löffel und gib nach und nach Kochwasser hinzu, bis eine glatte, lockere Konsistenz entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Butter hinzu und zerdrücke alles weiter, bis es gut vermischt und luftig ist. Sofort servieren.",
