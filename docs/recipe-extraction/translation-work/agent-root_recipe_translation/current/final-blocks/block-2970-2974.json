      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und bräune Hackfleisch mit gewürfelter Zwiebel 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Dosentomaten hinzu und gare alles 5 Minuten, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Brühe hinzu und bringe sie zum Kochen. Reduziere dann die Hitze und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Okra hinzu, die in 0.5 Zoll große Stücke geschnitten ist, und rühre gut um, damit sie nicht zu schleimig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Suppe 15 Minuten köcheln, bis die Okra weich, aber nicht matschig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz, schwarzem Pfeffer und Chiliflocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß, am besten mit Fufu oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
