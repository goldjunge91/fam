      "steps": [
        {
          "position": 0,
          "text": "Püriere gekochte Schwarzaugenbohnen mit Zwiebel, roter Paprika, Scotch Bonnet, Knoblauch und Fisch glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Mischung in eine Schüssel und hebe Eier und Backpulver unter, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salz und 2 Esslöffel Öl hinzu und rühre, bis der Teig glatt und gießfähig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fette kleine Schalen oder Förmchen mit dem restlichen Öl ein und fülle sie zu 3/4 mit Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Schalen in einen größeren Topf mit heißem Wasser (Wasserbad), decke ihn ab und dämpfe 25-30 Minuten, bis die Masse fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stecke einen Zahnstocher in die Mitte, um den Gargrad zu prüfen; er sollte sauber herauskommen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Förmchen 5 Minuten abkühlen, fahre mit einem Messer am Rand entlang und stürze die Küchlein auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
