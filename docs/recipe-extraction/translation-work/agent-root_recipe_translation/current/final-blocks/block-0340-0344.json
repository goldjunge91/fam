      "steps": [
        {
          "position": 0,
          "text": "Weiche 8 Holzspieße 5 Minuten in kaltem Wasser ein, damit sie nicht verbrennen. Prüfe, ob sie in deine Pfanne passen, und kürze sie bei Bedarf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische in einer großen Schüssel das Hähnchen mit Tamari, Honig, Reisweinessig und Knoblauch. Wende es darin und lasse es mindestens 20 Minuten marinieren, für ein kräftigeres Aroma bis zu 24 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke das marinierte Hähnchen auf die eingeweichten Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Olivenöl in einer großen, schweren Pfanne und brate die Spieße 8-10 Minuten unter regelmäßigem Wenden, bis das Fleisch durchgegart ist. Gib in den letzten Minuten das Wasser dazu, um den Bratensatz zu lösen und eine glänzende Glasur zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Hähnchen von den Spießen und bestreue es mit Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Halbiere die Brötchen. Bestreiche jeweils eine Hälfte mit Mayonnaise und belege sie dann mit Hähnchen, Karotte, Gurke, Koriander und nach Wunsch Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
