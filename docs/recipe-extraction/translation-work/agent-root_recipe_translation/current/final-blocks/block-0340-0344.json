      "steps": [
        {
          "position": 0,
          "text": "Gib das Hähnchen, den Mirin und 2 EL Sojasauce in eine mittelgroße Schüssel und wende alles, bis es gut überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 EL Olivenöl in einer großen, schweren Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das Hähnchen 4-6 Minuten, bis es gerade gar ist. Nimm es aus der Pfanne und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche 1 EL Öl zusammen mit dem Speck in dieselbe Pfanne. Brate alles 2-3 Minuten goldbraun. Falls nötig, gib einen Schuss Wasser dazu, um klebrige Reste vom Pfannenboden zu lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Knoblauch dazu und brate ihn unter Rühren 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den tiefgekühlten Mais und die Erbsen dazu und brate alles unter Rühren 1 Minute, bis das Gemüse aufgetaut ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schiebe alles auf eine Seite der Pfanne und gieße das verquirlte Ei hinein. Brate es 1-2 Minuten, bis es gestockt ist, und mische es dann unter den Speck, Mais und die Erbsen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Hähnchen zusammen mit dem gekochten Reis, den restlichen 2 EL Sojasauce, dem Sesamöl und der Frühlingszwiebel zurück in die Pfanne. Vermische alles und erhitze es gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere den Bratreis nach Wunsch mit knusprigen Röstzwiebeln und Chiliöl.",
          "timerMinutes": null,
