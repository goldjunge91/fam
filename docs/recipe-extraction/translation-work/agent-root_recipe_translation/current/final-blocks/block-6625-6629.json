      "steps": [
        {
          "position": 0,
          "text": "Schäle die grünen Mangos, schneide sie in feine Streifen und lege sie 30 Minuten in Salzwasser ein. Anschließend gut abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einem Topf und gib die Senfkörner hinein. Lasse sie 30 Sekunden aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib fein gehackte Zwiebeln, Knoblauch, Ingwer und die in Scheiben geschnittenen Chilischoten dazu und dünste alles weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Kurkuma ein, gib die Mangostreifen dazu und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Essig dazu, salze und lasse die Mangos 10 Minuten köcheln, bis sie weich, aber noch bissfest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass das Atchar abkühlen und fülle es zur Aufbewahrung in Gläser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
