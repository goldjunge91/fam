      "steps": [
        {
          "position": 0,
          "text": "Zerkleinere Zwiebel, Knoblauch und Ingwer in einer Küchenmaschine fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Rinderhack mit den Aromaten, Koriander, Kreuzkümmel, Chilipulver, Panko, Ei, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme 12-16 ovale Kofta und stelle sie 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Öl in einer Pfanne bei mittlerer bis hoher Hitze und brate die Kofta rundherum etwa 3-4 Minuten pro Seite an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf mittlere bis niedrige Stufe und gare die Kofta weitere 8-10 Minuten durch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie mit Reis und Joghurtdip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
