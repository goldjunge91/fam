      "steps": [
        {
          "position": 0,
          "text": "Koche die Farfalle nach Packungsanleitung bissfest. Gieße sie ab und gib sie zurück in den warmen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate währenddessen das Schweinebrät in einer großen Pfanne bei mittlerer Hitze krümelig und vollständig gar (4-6 Minuten). Gieße das Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz die Butter in einem kleinen Topf bei mittlerer Hitze und rühre dann das Mehl ein, bis eine glatte Paste entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die Kaffeesahne langsam ein und bringe die Soße unter ständigem Rühren zum Kochen, bis sie eindickt (1-2 Minuten). Nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre den zerbröselten Gorgonzola, Salz und Zitronen-Pfeffer-Gewürz in die heiße Soße, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Käsesoße über die abgetropfte Pasta, gib die gegarte Wurst und den frischen Spinat dazu und mische alles, bis der Spinat zusammengefallen und alles überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verfeinere das Gericht mit etwas gehacktem frischem Basilikum und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
