          "swap": "Vollkorn- oder Honigsenf für eine ähnliche Würze",
          "savings": "Verwende Vorrätiges statt Dijon-Senf zu kaufen"
        },
        {
          "forIngredientId": "brown-sugar",
          "swap": "Honig oder Ahornsirup für die Glasur",
          "savings": "Wenn flüssige Süßungsmittel vorrätig sind, entfällt ein separater Kauf"
        },
        {
          "forIngredientId": "rice-vinegar",
          "swap": "Apfelessig oder Weißweinessig",
