      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 425F vor und lege ein tiefes Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Lachs in 4 gleich große Portionen, lege sie auf das Blech und würze sie rundherum mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe den Lachs etwa 10 Minuten. Nimm ihn dann heraus und schalte den Backofen auf Grillfunktion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre während der Lachs gart braunen Zucker, Dijon-Senf, Sojasoße und Reisessig in einem kleinen Topf und bringe die Mischung kurz zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche jede Lachsportion großzügig mit der warmen Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille den Lachs etwa 6 Zoll von der Hitzequelle entfernt 1 bis 2 Minuten, bis die Glasur Blasen wirft und sich der Fisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
