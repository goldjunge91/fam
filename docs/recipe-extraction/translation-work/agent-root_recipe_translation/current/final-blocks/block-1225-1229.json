      "steps": [
        {
          "position": 0,
          "text": "Brate Kielbasa-Scheiben und Schweinefleischstücke in einem großen Topf an. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Zwiebel und Knoblauch 3 Minuten an und gib Tomatenmark, Paprikapulver und Piment dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Sauerkraut, Pilze, Brühe und Lorbeerblatt dazu und lege das Fleisch zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass alles zugedeckt 40 Minuten köcheln und rühre gelegentlich um. Bigos schmeckt am nächsten Tag noch besser.",
