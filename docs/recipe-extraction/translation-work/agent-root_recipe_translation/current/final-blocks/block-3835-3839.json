      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweine- und Rindfleisch in 1.5 Zoll große Würfel und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und bräune das Fleisch portionsweise je Seite 3 Minuten. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch in den Topf und gare sie 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Hälfte der Kartoffelwürfel auf den Boden eines großen ofenfesten Topfs oder Schmortopfs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das gesamte gebräunte Fleisch darauf und verteile die übrigen Kartoffeln darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Wein und Brühe über alles und gib Lorbeerblätter und Thymianzweige hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf fest mit Folie und Deckel ab und schmorte alles im Ofen bei 325°F 2.5 Stunden, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne Lorbeerblätter und Thymian, schmecke das Gericht ab und serviere es direkt aus dem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
