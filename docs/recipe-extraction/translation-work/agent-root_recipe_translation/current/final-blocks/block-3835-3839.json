      "steps": [
        {
          "position": 0,
          "text": "Schäle, entkerne und schneide Äpfel dünn in eine Schüssel. Vermenge sie mit Zitronensaft, Zucker, Zimt, Rosinen und Vanille.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem kleinen Topf und bestreiche ein Backblech damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das erste Filoteigblatt auf das Backblech und bestreiche es leicht mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte die übrigen Filoteigblätter darauf, bestreiche jedes mit Butter und bestreue jedes zweite Blatt mit Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Apfelfüllung gleichmäßig auf dem Filoteig und lasse rundherum einen 1 Zoll breiten Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Strudel von der langen Seite her fest auf, schlage die Enden ein und lege ihn mit der Naht nach unten auf das Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die Oberseite mit der restlichen Butter und backe den Strudel bei 375°F 35-40 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse ihn 10 Minuten abkühlen, bestäube ihn dann mit Puderzucker und serviere ihn warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
