      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz, gib dann nach und nach Wasser hinzu und knete, bis ein glatter Teig entsteht. Lasse ihn zugedeckt 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Schweinehackfleisch mit gewürfelter Zwiebel und gehacktem Knoblauch 6 Minuten. Rühre Petersilie, Pfeffer und Salz nach Geschmack ein und lasse die Füllung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 4 Stücke und rolle jedes auf einer bemehlten Fläche dünn zu einem 8x10 Zoll großen Rechteck aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile ein Viertel der Fleischfüllung auf jedem Teigrechteck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig von der langen Seite her fest auf und forme eine Spirale. Stecke das Ende darunter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer großen Pfanne und brate die Rollen bei mittlerer Hitze je Seite 4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Senf und einem einfachen Salat servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
