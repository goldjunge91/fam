      "steps": [
        {
          "position": 0,
          "text": "Koche Eiernudeln nach Packungsanweisung in Salzwasser, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Säubere Pilze mit einem feuchten Tuch und schneide sie in 0.5 Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in einer großen Pfanne und gare gewürfelte Zwiebel und gehackten Knoblauch 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Pilzscheiben hinzu und gare sie 8 Minuten unter gelegentlichem Rühren, bis sie Flüssigkeit abgeben und leicht bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein an und gare ihn 1 Minute. Gib dann Brühe hinzu und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze und rühre Sahne, Salz und Pfeffer ein. Erwärme alles ohne zu kochen 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge gekochte Nudeln mit der Pilzrahmsauce und garniere mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
