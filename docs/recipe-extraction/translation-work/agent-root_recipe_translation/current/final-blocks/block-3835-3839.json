      "steps": [
        {
          "position": 0,
          "text": "Säubere jeden Fisch, indem du ihn ausnimmst und innen wie außen gründlich abspülst. Tupfe ihn dann trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze den Fisch innen mit Salz und Pfeffer und gib dünne Zitronenscheiben und einen Dillzweig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke jeden Fisch längs auf einen Stock oder Holzspieß, indem du ihn durch Maul und Schwanz führst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche jeden Fisch großzügig mit Öl und streue Salz und Pfeffer darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille den Fisch bei mittelhoher Hitze je Seite 6 Minuten, bis die Haut knusprig ist und das Fleisch leicht auseinanderfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche Brotscheiben mit Butter und röste sie neben dem Fisch oder auf einem Grillrost.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Fisch am Spieß mit geröstetem Brot, Zitronenspalten und frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
