      "steps": [
        {
          "position": 0,
          "text": "Bringe Milch und Gemüsebrühe in einem großen Topf bei mittlerer Hitze zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre den Maisgrieß langsam und in einem gleichmäßigen Strahl ein. Rühre dabei etwa 3 Minuten ständig, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf niedrig und rühre weitere 25-30 Minuten häufig um, bis die Polenta dick ist und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze in einer separaten Pfanne Olivenöl und dünste gewürfelte Zwiebel und Knoblauch 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinehackfleisch dazu, zerteile es mit einem Löffel und brate es 5-7 Minuten an, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lösche die Pfanne mit Weißwein ab und lass alles 3 Minuten köcheln. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Butter und Parmesan unter die gekochte Polenta, bis sie cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Polenta auf Schüsseln und gib die Schweinefleischsauce darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
