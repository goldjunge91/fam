      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste gewürfelte Zwiebel und gehackten Knoblauch 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Weißwein dazu, löse die Bratrückstände und lass alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Fischfond hinein und bringe ihn zum Kochen. Gib gewürfelte Kartoffeln dazu und lass sie 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Venus- und Miesmuscheln dazu, decke den Topf ab und gare sie 5 Minuten, bis sich die Schalen zu öffnen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Garnelen und Fischstücke dazu und lass alles sanft 5-8 Minuten köcheln, bis die Meeresfrüchte gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entsorge geschlossene Muscheln und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schöpfe die Suppe in Schüsseln, garniere sie mit frischer Petersilie und serviere sie mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
