      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gare die Spaghetti nach Packungsanleitung bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass währenddessen Butter in einer großen Pfanne bei niedriger Hitze schmelzen. Gib gehackten Knoblauch dazu und rühre 1 Minute vorsichtig um, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe 1/2 Tasse Nudelwasser auf, gieße die Spaghetti ab und gib sie mit der Knoblauchbutter in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle die Pasta mit Trüffelöl und schwenke sie vorsichtig darin. Gib nach und nach etwas Nudelwasser dazu, bis eine leichte Sauce entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und rühre die Hälfte des Parmesans ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Pasta auf Schüsseln und gib den restlichen Parmesan und frisch gemahlenen schwarzen Pfeffer darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
