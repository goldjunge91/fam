      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor. Schäle die Kartoffeln und schneide sie in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Petersilie und Knoblauch fein und vermische beides zu einer Art Gremolata.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege Kartoffel- und Zwiebelscheiben in eine Auflaufform. Beträufle sie mit 2 Esslöffeln Olivenöl und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe die Kartoffeln 15 Minuten, bis sie weich zu werden beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Kabeljaufilets auf die Kartoffeln, würze sie mit Salz und Pfeffer und gieße den Weißwein neben (nicht über) den Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische die übrigen 4 Esslöffel Olivenöl mit Petersilie und Knoblauch. Beträufle den Fisch damit und streue etwas Petersilie auf die Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Kabeljau 12-15 Minuten, bis er undurchsichtig ist und sich leicht zerteilen lässt. Presse frischen Zitronensaft darüber und serviere alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
