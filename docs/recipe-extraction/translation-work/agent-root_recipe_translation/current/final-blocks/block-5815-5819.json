      "steps": [
        {
          "position": 0,
          "text": "Gib die Schweinshaxe mit Wasser, Salz, Knoblauch, Pfefferkörnern und Lorbeerblättern in einen großen Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lasse das Fleisch 1.5 Stunden köcheln, bis es sehr zart und die Schwarte weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus, lasse es vollständig abkühlen und tupfe die Schwarte gründlich mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reibe die Schwarte mit Speisestärke ein, damit sie knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem tiefen Topf oder Wok auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Schweinshaxe vorsichtig ins heiße Öl gleiten und frittiere sie 10-15 Minuten. Wende sie gelegentlich, bis die Schwarte goldbraun und blasig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie zum Abtropfen auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit Essig-Dip und gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
