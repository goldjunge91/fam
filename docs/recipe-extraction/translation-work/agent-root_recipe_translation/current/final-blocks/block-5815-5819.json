      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweineschulter in 2-inch dicke und etwa 8 inches lange Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasoße, Hoisinsoße, Honig, Reisessig, gehackten Knoblauch und Ingwer sowie Lebensmittelfarbe in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse das Schweinefleisch mindestens 2 Stunden, am besten über Nacht im Kühlschrank, in der Soße marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor und lege ein Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das marinierte Schweinefleisch auf das vorbereitete Blech und stelle die Marinade beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate es 40-50 Minuten und bestreiche es alle 15 Minuten mit der beiseitegestellten Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende das Fleisch nach der Hälfte der Garzeit, damit es gleichmäßig bräunt und karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse es 5 Minuten ruhen und schneide es dann quer zur Faser in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
