      "steps": [
        {
          "position": 0,
          "text": "Je 4 Brotscheiben mit Schinken, Roastbeef, Pute und Käse belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mit einer weiteren Brotscheibe abdecken und vorsichtig andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier und Milch in einer flachen Schale verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze erhitzen und Sandwiches in die Eimischung tauchen, sodass beide Seiten bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sandwiches pro Seite 3–4 Minuten goldbraun braten, bis der Käse zu schmelzen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bier und Rinderbrühe in einem Topf zusammen 3 Minuten erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warme Sauce auf den Sandwiches in Serviertellern verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß und mit reichlich Sauce servieren.",
          "timerMinutes": null,
