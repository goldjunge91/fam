      "steps": [
        {
          "position": 0,
          "text": "Fischfond in einem separaten Topf erhitzen und während des Kochens sanft köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer breiten Paellapfanne oder großen Pfanne bei mittlerer Hitze erhitzen und Zwiebel sowie Knoblauch 2 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reis hinzufügen und unter häufigem Rühren 2–3 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weißwein zugießen und auf die Hälfte einkochen lassen, dann Lorbeerblätter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Warme Brühe nach und nach jeweils tassenweise zugießen. Gelegentlich umrühren und warten, bis die Flüssigkeit aufgenommen ist, bevor mehr hinzukommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nach 15 Minuten Muscheln und Miesmuscheln in den Reis setzen und anschließend Garnelen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 8–10 Minuten kochen, bis der Reis weich ist, sich die Muscheln geöffnet haben und die Garnelen rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Geschlossene Muscheln entsorgen, Lorbeerblätter entfernen und vor dem Servieren großzügig mit frischer Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
