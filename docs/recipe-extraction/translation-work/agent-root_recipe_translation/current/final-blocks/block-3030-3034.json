      "steps": [
        {
          "position": 0,
          "text": "Gehackten Ingwer, Knoblauch, Scotch-Bonnet-Chili, Zwiebel, Salz und schwarzen Pfeffer in einer kleinen Schüssel zur Gewürzmischung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Jede Kochbananenscheibe gründlich mit der Gewürzmischung bedecken und diese leicht andrücken, damit sie haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer tiefen Pfanne oder einem Topf auf 350°F erhitzen oder bis ein kleines Kochbananenstück beim Hineingeben sofort zischt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürzte Kochbananenscheiben vorsichtig portionsweise ins heiße Öl geben und die Pfanne nicht überfüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3-4 Minuten pro Seite goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einer Schaumkelle herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß als Snack oder Vorspeise servieren, nach Wunsch mit Limettenspalten oder scharfer Pfeffersauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
