      "steps": [
        {
          "position": 0,
          "text": "Safranfäden in 0.25 cup heißem Wasser 10 Minuten einweichen, damit sie Farbe abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Basmatireis gründlich unter kaltem Wasser abspülen, bis das Wasser klar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "4 cups Wasser zum Kochen bringen, Salz und abgespülten Reis hinzufügen und 8-10 Minuten kochen, bis der Reis teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis gründlich in einem Sieb abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 tablespoons Butter in einem beschichteten Topf schmelzen und Kartoffelscheiben auf dem Boden verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Joghurt mit 0.5 cup des teilweise gegarten Reises vermengen und über den Kartoffeln verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Übrigen Reis pyramidenförmig darauf schichten, dann Safranwasser darüberträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Restliche 2 tablespoons Butter in kleinen Stücken darauf verteilen, den Topf mit Folie und anschließend mit einem Deckel abdecken und bei mittlerer Hitze 20 Minuten garen, bis sich unten eine goldene Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit knuspriger Tahdig-Reiskruste oben und unten auf dem Reisberg servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
