        {
          "position": 0,
          "text": "Rindersteak und Wurst in mundgerechte Würfel schneiden und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln schälen und klein würfeln, dann etwa 12 Minuten in Salzwasser weich kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze erhitzen und Rindfleisch sowie Wurst etwa 8 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebeln, gehackten Knoblauch und geschnittene Jalapeños hinzufügen und etwa 5 Minuten garen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Tomaten und Rinderbrühe hinzufügen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Kartoffeln einrühren, mit Salz und Pfeffer würzen und weitere 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in Schüsseln servieren und darauf achten, dass jede Portion Fleisch, Kartoffeln und Brühe enthält.",
