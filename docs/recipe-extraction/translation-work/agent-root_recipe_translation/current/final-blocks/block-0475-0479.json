      "steps": [
        {
          "position": 0,
          "text": "Verrühre Kaffeesahne, Dijon-Senf, 1/4 cup Blauschimmelkäse und gehackten Knoblauch in einem kleinen Topf bei mittlerer Hitze mit dem Schneebesen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass die Sauce leicht köcheln, reduziere die Hitze auf niedrig und lass sie unter gelegentlichem Rühren einkochen, bis sich ihr Volumen etwa halbiert hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche währenddessen beide Ribeye-Steaks mit Olivenöl und würze sie rundherum mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille die Steaks zugedeckt bei hoher direkter Hitze auf einem geölten Rost 4 bis 6 Minuten pro Seite, bis sie den gewünschten Gargrad erreicht haben (135°F für rosa und im Kern blutig, 140°F für rosa, 145°F für fast durchgegart).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Steaks vom Grill und lass sie 10 Minuten ruhen, während die Sauce weiter einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Löffle die eingekochte Sauce über die Steaks und bestreue sie zum Schluss mit den übrigen 2 teaspoons zerbröseltem Blauschimmelkäse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
