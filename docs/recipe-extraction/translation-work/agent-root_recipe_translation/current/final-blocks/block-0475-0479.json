      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425F vor. Gare tiefgekühlten Brokkoli und Blumenkohl nach Packungsanleitung und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 Teelöffel Butter in einer kleinen Pfanne bei mittlerer Hitze. Rühre Semmelbrösel ein und röste sie unter Rühren etwa 2-3 Minuten goldbraun. Nimm sie vom Herd und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz die übrige Butter in einem großen Topf bei mittlerer Hitze. Rühre Mehl glatt ein und gieße dann langsam unter ständigem Rühren die Milch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bring die Sauce unter ständigem Rühren zum Kochen und gare sie 1-2 Minuten, bis sie eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd und rühre Cheddar und Parmesan ein, bis sie geschmolzen und die Sauce glatt ist. Hebe Schinken, Pfeffer und das abgetropfte Gemüse unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Löffle alles in eine gefettete quadratische 8-inch-Backform und verteile die gerösteten Brösel darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Auflauf ohne Abdeckung 10-15 Minuten, bis er heiß ist und blubbert. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
