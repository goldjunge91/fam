      "steps": [
        {
          "position": 0,
          "text": "Bringe 4 cups Wasser mit Ingwerscheiben zum Kochen. Gib Schweinebauch dazu und lass ihn 30 Minuten köcheln, bis er gar und zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Schweinefleisch aus dem Wasser, lass es leicht abkühlen und schneide es dann in 1/4-inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze und brate die Schweinefleischscheiben kurz etwa 1 Minute pro Seite an, bis sie leicht gebräunt sind. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib in denselben Wok Chilipaste, Knoblauch und Paprika. Brate alles 1 Minute unter Rühren, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinefleisch mit Sojasauce, Zucker und 2 Esslöffeln Kochflüssigkeit aus der Brühe zurück in den Wok. Wende alles 2-3 Minuten ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle das Gericht mit Sesamöl, gib Frühlingszwiebeln darüber und serviere es sofort mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
