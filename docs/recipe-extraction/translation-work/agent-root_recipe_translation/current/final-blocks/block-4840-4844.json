          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz und Zucker und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib bei Bedarf mehr Wasser dazu, um die Konsistenz anzupassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Reisbrei heiß in Schalen und garniere ihn mit gehackten Frühlingszwiebeln und Röstzwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
