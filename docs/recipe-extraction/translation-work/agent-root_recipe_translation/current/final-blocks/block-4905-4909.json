      "steps": [
        {
          "position": 0,
          "text": "Schneide das Blattgrün der Roten Bete ab und lege die Knollen mit Wasser und Salz in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe das Wasser zum Kochen und gare die Rote Bete 30-40 Minuten, bis ein Messer leicht hineingleitet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Knollen ab und lasse sie abkühlen, bis du sie anfassen kannst. Schäle sie und schneide sie in 1/4 Zoll dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Schalotte, Senf, Essig und Olivenöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die noch warmen Rote-Bete-Scheiben zum Dressing und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe Petersilie und Walnüsse unter und gib den Salat auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue ihn mit zerbröckeltem Ziegenkäse und serviere ihn bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
