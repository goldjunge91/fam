      "steps": [
        {
          "position": 0,
          "text": "Bringe Salzwasser zum Kochen, gib den Reis dazu und gare ihn unter gelegentlichem Rühren etwa 18 Minuten, bis er gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße den Reis ab und verteile ihn auf einem Backblech, damit er auf Zimmertemperatur abkühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den abgekühlten Reis in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomaten, Mozzarella, Mais, Gurken und rote Zwiebel zum Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Olivenöl, Essig, Petersilie, Salz und Pfeffer zu einem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Dressing über den Salat und mische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle den Salat vor dem Servieren mindestens 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
