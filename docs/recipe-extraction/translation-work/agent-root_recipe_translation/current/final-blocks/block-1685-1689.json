      "steps": [
        {
          "position": 0,
          "text": "Koche das Fleisch: Gib das Flankensteak mit Brühe oder Wasser und Salz in einen Topf. Koche es bei niedriger Hitze etwa 2 Stunden, bis es zart ist und sich leicht zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerpflücke das Fleisch: Gieße es nach dem Garen ab und zerteile es mit zwei Gabeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite das Gemüse zu: Brate gehackte Zwiebel, Paprika und Knoblauch in etwas Öl an. Gib Kreuzkümmel, Oregano, Paprikapulver und Salz dazu. Rühre das Fleisch unter und gare alles einige Minuten, bis sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite den Teig zu: Vermische Maismehl, warmes Wasser und Salz in einer Schüssel, bis ein weicher Teig entsteht. Lass ihn 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme die Arepas: Teile den Teig in 6 Portionen, forme Kugeln und drücke sie zu dicken Scheiben flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare die Arepas: Backe sie auf einer Grillplatte oder in einer Pfanne bei mittlerer Hitze 2–3 Minuten pro Seite, bis sie goldbraun sind. Wenn du sie knuspriger magst, kannst du sie danach noch einige Minuten im Ofen backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Arepas: Schneide jede Arepa an einer Seite auf, fülle sie mit dem heißen zerpflückten Rindfleisch und bestreue sie mit geriebenem Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
