      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine gusseiserne Pfanne bei hoher Hitze und brate gewürfeltes Lendensteak etwa 3-4 Minuten an, bis es gebräunt ist. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle 4 Eier mit Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass 1 tbsp Butter in der Pfanne bei mittlerer bis hoher Hitze schmelzen und dünste gewürfelte Paprika und Zwiebel 2 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe das Gemüse an den Rand und gieße die Hälfte der verquirlten Eier in die Pfanne. Schwenke sie, damit sie sich gleichmäßig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn das Ei am Rand zu stocken beginnt, gib die Hälfte des gegarten Steaks und des Käses auf eine Hälfte des Omeletts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe das Omelett zusammen und lass es auf einen Teller gleiten. Wiederhole den Vorgang mit den übrigen Zutaten für das zweite Omelett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
