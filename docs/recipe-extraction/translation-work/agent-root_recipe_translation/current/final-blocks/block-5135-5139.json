      "steps": [
        {
          "position": 0,
          "text": "Spüle die roten Linsen unter kaltem Wasser ab, bis das Wasser klar bleibt, und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einem großen Topf bei mittlerer Hitze und gib Kreuzkümmelsamen dazu. Lass sie 30 Sekunden aufknistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die Zwiebel und gib sie in den Topf. Brate sie etwa 4-5 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gehackten Knoblauch und geriebenen Ingwer ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle die Tomate und gib sie zusammen mit Kurkumapulver in den Topf. Rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die abgespülten Linsen und den Reis zusammen mit 5 cups Wasser in den Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lass alles 25-30 Minuten köcheln, bis sowohl Linsen als auch Reis ganz weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre gut um, schmecke das Dal mit Salz ab und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
