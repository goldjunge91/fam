      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf mit gesalzenem Wasser bei hoher Hitze zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Eiernudeln dazu und koche sie nach Packungsanleitung bissfest, etwa 8-10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass währenddessen Butter in einer kleinen Pfanne bei niedriger Hitze schmelzen. Gib gehackten Knoblauch dazu und dünste ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Nudeln abtropfen und bewahre 1/4 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Nudeln zurück in den Topf und gieße die Knoblauchbutter darüber. Vermenge alles, bis die Nudeln gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib einen Schuss Nudelwasser dazu, falls die Nudeln trocken wirken, und würze großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Nudeln in Schüsseln und bestreue sie nach Wunsch mit geriebenem Parmesan und frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
