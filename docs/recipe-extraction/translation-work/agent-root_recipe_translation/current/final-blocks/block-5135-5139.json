      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl, Zucker, Salz und Hefe in einer großen Schüssel. Gib warme Milch und verquirltes Ei dazu und rühre, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 5 Minuten von Hand oder in einer Küchenmaschine glatt. Stelle ihn dann 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig auf einer bemehlten Fläche zu einem 1/4-inch dicken Rechteck aus und lege kalte Butterwürfel auf eine Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe den Teig über die Butter und drücke die Ränder fest zusammen. Rolle ihn erneut auf 1/4-inch Dicke aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falte den Teig in Drittel wie einen Brief, wickle ihn in Frischhaltefolie und stelle ihn 20 Minuten kalt. Wiederhole diesen Faltvorgang noch zwei weitere Male.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig nach der letzten Faltung und einer Ruhezeit von 20 Minuten auf 1/4-inch Dicke aus. Schneide mit einem Donut-Ausstecher oder zwei runden Ausstechern Donutformen aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die ausgestochenen Teigstücke auf Backpapier 30-45 Minuten gehen, bis sie aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere jeden Cronut vorsichtig pro Seite 1-2 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm die Cronuts mit einer Schaumkelle heraus, lass sie auf Küchenpapier abtropfen, bestäube sie mit Puderzucker und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
