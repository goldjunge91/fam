      "steps": [
        {
          "position": 0,
          "text": "Lege die Schweineschnitzel zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 1/4-inch Dicke flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Fleisch mit Salz und Pfeffer. Stelle drei flache Schüsseln bereit und fülle Mehl, verquirlte Eier und Panko-Semmelbrösel jeweils in eine davon.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Schnitzel erst in Mehl, dann in Ei und zuletzt in Panko. Drücke die Panade leicht an, damit sie gut haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und brate die panierten Schnitzel 3-4 Minuten pro Seite goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass sie auf Küchenpapier abtropfen und schneide das Katsu in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Milchbrotscheiben leicht mit Butter und röste sie nach Wunsch. Verteile anschließend Tonkatsu-Sauce auf beiden Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die untere Scheibe mit geriebenem Kohl und Katsu-Streifen, lege die zweite Scheibe darauf, schneide das Sandwich diagonal durch und serviere es mit zusätzlicher Tonkatsu-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
