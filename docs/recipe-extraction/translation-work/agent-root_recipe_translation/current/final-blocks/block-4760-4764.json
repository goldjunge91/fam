      "steps": [
        {
          "position": 0,
          "text": "Lass den Dosen-Thunfisch abtropfen und gib ihn zusammen mit Mayonnaise, Sardellen, Zitronensaft, Kapern, Essig und Knoblauch in einen Mixer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere alles zu einer glatten, cremigen Sauce. Gib bei Bedarf einen Schuss Wasser dazu, falls sie zu dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmecke die Sauce mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile aufgeschnittenes Kalbfleisch oder Hähnchen auf einer Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Tonnato-Sauce über das Fleisch und stelle die Platte mindestens 1 Stunde kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere das Gericht vor dem Servieren mit frischer Petersilie und zusätzlichen Kapern.",
          "timerMinutes": null,
