      "steps": [
        {
          "position": 0,
          "text": "Holzspieße vor dem Grillen 30 Minuten in Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fleisch in 1½ Zoll große Würfel und Zwiebeln in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für die Marinade Knoblauch und Ingwer fein hacken und mit Currypulver, Kurkuma, Kokosmilch, Öl und Salz verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fleisch mit der Marinade vermengen und mindestens 20 Minuten im Kühlschrank ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mariniertes Fleisch und Zwiebelstücke abwechselnd auf die Spieße stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grill oder Barbecue auf mittlere bis hohe Hitze vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Spieße 12–15 Minuten grillen, gelegentlich wenden, bis das Fleisch durchgegart und gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis und Chutney servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
