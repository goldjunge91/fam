      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver, Salz und Ei in einer großen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Joghurt und Wasser nach und nach einrühren, bis ein glatter, dünnflüssiger Teig entsteht, der langsam vom Löffel läuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine beschichtete Pfanne oder Crêpepfanne auf mittlerer Hitze erwärmen und leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig mit einer Kelle kreisförmig hineingießen, sodass ein Pfannkuchen mit Wabenstruktur entsteht. Garen, bis der Boden fest ist und die Oberfläche voller Löcher ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vorsichtig wenden und die andere Seite 30 Sekunden hellgolden backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einen Teller geben und mit dem restlichen Teig wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Honig und Butter zusammen erwärmen und vor dem Servieren über die warmen Baghrire träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
