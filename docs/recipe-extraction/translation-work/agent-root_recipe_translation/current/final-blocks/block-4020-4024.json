      "steps": [
        {
          "position": 0,
          "text": "Hackfleisch, Petersilie, gehackte Zwiebel, Knoblauch, Ei, Semmelbrösel, Kreuzkümmel, Salz und Pfeffer in einer Schüssel vermengen, bis alles gerade verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Mischung zu ovalen oder wurstförmigen Frikadellen von etwa 3 Zoll Länge formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kefta in die Pfanne geben und pro Seite 3–4 Minuten anbraten, bis sie gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatensauce über die Kefta gießen, die Hitze auf mittlere bis niedrige Stufe reduzieren und 8–10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiß mit Brot zum Auftunken oder auf Couscous servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
