      "steps": [
        {
          "position": 0,
          "text": "Gekochte weiße Erbsen mit Tamarinden-Chutney und Salz zu einer Ragda-Sauce vermengen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gestampfte Kartoffeln, zerdrückte grüne Erbsen, Mehl, grüne Chili, Ingwer, Chaat Masala und Salz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aus der Mischung 6-8 kleine, flache ovale Bratlinge formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer flachen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bratlinge 2-3 Minuten pro Seite goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bratlinge auf einem Teller anrichten und warme Ragda-Sauce darübergeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Minz-Chutney und zusätzlichem Chaat Masala garnieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
