      "steps": [
        {
          "position": 0,
          "text": "Jowar-Mehl, Salz und Kreuzkümmelsamen in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach warmes Wasser und Öl hinzufügen und rühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1-2 Minuten kneten, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 4-6 gleiche Portionen teilen und jeweils zu einer Kugel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine gusseiserne Platte oder Tawa bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine Teigportion auf die Platte legen und mit dem Handballen leicht zu einem dicken, runden Fladen drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "2-3 Minuten garen, bis die Unterseite braun ist, vorsichtig wenden und die andere Seite 2-3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Noch einmal wenden und leicht andrücken; garen, bis dunkle Stellen entstehen und die Bhakri leicht knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß mit Dal oder Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
