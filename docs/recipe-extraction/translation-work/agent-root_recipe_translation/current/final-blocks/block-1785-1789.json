      "steps": [
        {
          "position": 0,
          "text": "Hähnchen locker zwischen Frischhaltefolie legen und mit der flachen Seite eines Fleischklopfers vorsichtig klopfen, bis es überall etwa 1/2 Zoll dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In möglichst gleich große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "30 Minuten bis eine Stunde in Gurkenlake marinieren. Für ein scharfes Sandwich jetzt einen Teelöffel Tabascosauce dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ei und Milch in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mehl, Zucker und Gewürze in einer anderen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hähnchenstücke beidseitig in Ei tauchen, dann auf beiden Seiten mit Mehlmischung panieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer Pfanne etwa 1/2 Zoll hoch auf 345-350 erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Jedes Schnitzel auf jeder Seite 2 Minuten goldbraun und gar braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Küchenpapier abtropfen lassen und auf getoasteten Brötchen mit Gurkenscheiben servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
