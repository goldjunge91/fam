              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in eine große Schüssel sieben. In der Mitte eine Mulde formen und Hefe hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Inzwischen Milch und Butter in einem Topf erwärmen, bis die Butter geschmolzen und die Mischung lauwarm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Milchmischung und Ei zur Mehlmischung geben und verrühren, bis ein weicher Teig entsteht. Eventuell etwas zusätzliches Mehl einarbeiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig auf eine großzügig bemehlte Arbeitsfläche geben und fünf Minuten kneten. Bei Bedarf mehr Mehl hinzufügen, bis der Teig glatt, elastisch und nicht mehr klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine Schüssel mit etwas Pflanzenöl leicht einfetten. Teig hineingeben und wenden, bis er rundum mit Öl bedeckt ist. Mit Frischhaltefolie abdecken und eine Stunde an einem warmen Ort gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backblech leicht einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für die Füllung Teig auf seine ursprüngliche Größe zurückdrücken und auf eine leicht bemehlte Arbeitsfläche geben. Zu einem 0.5cm/¼in dicken Rechteck ausrollen. Mit geschmolzener Butter bestreichen und braunen Zucker, Zimt und Trockenfrüchte darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Teig fest aufrollen, zehn 4cm/1½in dicke Scheiben schneiden und mit etwas Abstand auf ein leicht gefettetes Backblech legen. Mit einem Geschirrtuch abdecken und 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backofen auf 190C/375F/Gasstufe 5 vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Brötchen 20-25 Minuten backen, bis sie aufgegangen und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Für die Glasur Milch und Zucker in einem Topf aufkochen. Hitze reduzieren und 2-3 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Brötchen aus dem Ofen nehmen, mit Glasur bestreichen und auf einem Gitter abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
