      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln in Salzwasser etwa 20 Minuten, bis sie ganz weich sind. Gieße sie ab und schäle sie, solange sie noch warm sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Ají-Amarillo-Paste, Walnüsse, Zwiebel, Knoblauch und Limettensaft glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und brate die pürierte Mischung bei mittlerer Hitze 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre nach und nach Kondensmilch ein, bis die Sauce eine gießfähige Konsistenz hat. Lasse sie 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze die Sauce nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte die warmen ganzen Kartoffeln auf einer Servierplatte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Huancaína-Sauce großzügig über die Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere mit schwarzen Oliven und halbierten hart gekochten Eiern. Serviere das Gericht bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
