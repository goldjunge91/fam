      "steps": [
        {
          "position": 0,
          "text": "Gib gewürfelten Thunfisch in eine Glas- oder Keramikschüssel, gieße Limettensaft darüber und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittene rote Zwiebel, Koriander und Ají-Pfeffer dazu und vermische alles vorsichtig.",
