      "steps": [
        {
          "position": 0,
          "text": "Vermische Ají-Mirasol-Paste, Essig, Knoblauch, Kreuzkümmel, Olivenöl, Salz und Pfeffer in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rindfleischwürfel in die Marinade und wende sie gründlich darin. Stelle sie mindestens 2 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke das marinierte Rindfleisch abwechselnd mit Zwiebelringen auf eingeweichte Holzspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze einen Grill oder eine Grillpfanne auf hohe Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Spieße 8-10 Minuten und wende sie gelegentlich, bis das Fleisch gar und leicht angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche sie während des Grillens mit der übrigen Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß, garniert mit frischem Koriander und Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reiche gekochte Kartoffeln und Maiskolben dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
