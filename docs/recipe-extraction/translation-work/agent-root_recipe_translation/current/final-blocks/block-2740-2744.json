          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze mit Salz und Pfeffer und lasse alles 15 Minuten bei Raumtemperatur ziehen (die Säure gart den Fisch).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Süßkartoffel, Mais und Sellerie dazu und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile das Ceviche auf Servierschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege jede Schale mit Avocadoscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sofort in gekühlten Schalen mit Limettenspalten und Crackern dazu.",
          "timerMinutes": null,
