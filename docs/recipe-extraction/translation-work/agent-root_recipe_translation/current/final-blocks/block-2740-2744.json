      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und brate Zwiebel und Knoblauch etwa 3 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Ají-Amarillo-Paste ein und gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Gemüsebrühe dazu und bringe sie zum Kochen. Füge gewürfelte Kartoffeln hinzu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Garnelen und Mais dazu und gare alles 5 Minuten, bis die Garnelen anfangen, rosa zu werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und rühre langsam Kondensmilch ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Eier leicht in einer kleinen Schüssel und träufle sie unter Rühren langsam in die Suppe, sodass Eierflocken entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und lasse alles weitere 2 Minuten sanft köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schöpfe die Suppe in Schalen, garniere sie mit frischem Koriander und serviere sie heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
