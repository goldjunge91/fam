      "steps": [
        {
          "position": 0,
          "text": "Schmilz die Butter in einem Topf bei mittlerer Hitze und rühre das Mehl ein, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach unter ständigem Rühren die Milch dazu, bis eine dicke Béchamelsauce entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gewürfelten Schinken, Salz, weißen Pfeffer und Muskatnuss ein und nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Masse auf einem mit Backpapier ausgelegten Backblech und stelle sie 1 Stunde kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme die gekühlte Masse zu Zylindern und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle Schüsseln mit verquirlten Eiern und Panko-Semmelbröseln bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende jede Krokette zuerst in Ei und dann in Panko. Drücke die Panade leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze das Öl auf 350°F und frittiere die Kroketten vorsichtig 2-3 Minuten rundum goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
