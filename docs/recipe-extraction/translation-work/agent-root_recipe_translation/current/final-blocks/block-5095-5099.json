          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tauche jeden Hotdog vollständig in den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib ihn vorsichtig ins heiße Öl und frittiere ihn 3-4 Minuten goldbraun. Wende ihn einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
