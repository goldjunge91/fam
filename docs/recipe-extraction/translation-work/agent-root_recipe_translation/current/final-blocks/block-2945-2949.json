      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Reisnudeln 3-4 Minuten in kochendem Wasser, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Tofu in Würfel und zerdrücke das Zitronengras mit der Messerseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle rote Currypaste, Kokosmilch und Brühe in einem großen Topf, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib zerdrücktes Zitronengras, gehackte Schalotten und Knoblauch hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Garnelen und Tofuwürfel hinzu und gare alles 5-7 Minuten, bis die Garnelen rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Fischsauce und Limettensaft und schmecke ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die gekochten Nudeln auf Schalen und schöpfe die heiße Laksa-Brühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere nach Wunsch mit geschnittenen Frühlingszwiebeln und zusätzlichem Koriander.",
