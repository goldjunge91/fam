      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gare die Makkaroni nach Packungsanleitung bissfest. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz im selben Topf 3 Esslöffel Butter bei mittlerer Hitze und rühre Mehl ein. Gare die Mischung unter ständigem Rühren 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße unter ständigem Rühren langsam Milch hinzu, damit sich keine Klumpen bilden. Koche die Sauce unter Rühren etwa 5 Minuten, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Topf vom Herd und rühre geriebenen Cheddar und Gruyère ein, bis alles geschmolzen und glatt ist. Würze mit Salz, Pfeffer und Cayennepfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gekochte Pasta zurück in den Topf und rühre um, bis alle Nudeln mit Käsesauce bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Mischung in eine Auflaufform und stelle sie beiseite oder serviere sie sofort als cremige Variante.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für eine überbackene Variante heize den Ofen auf 350°F vor und vermische Panko-Semmelbrösel mit 2 Esslöffeln geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue die gebutterten Semmelbrösel über die Makkaroni und backe sie 15-20 Minuten, bis die Oberfläche goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
