      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und stelle eine 9-Zoll-Gusseisenpfanne zum Erhitzen 5 Minuten in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Maismehl, Mehl, Zucker, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle in einer anderen Schüssel das verquirlte Ei mit Milch und Pflanzenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die feuchten Zutaten zu den trockenen und rühre nur so lange, bis alles vermischt ist. Rühre nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die heiße Pfanne aus dem Ofen, gib geschmolzene Butter hinein und schwenke sie, um den Boden zu bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Teig rasch in die gebutterte Pfanne und stelle sie sofort zurück in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe das Maisbrot 20-25 Minuten, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt und die Oberseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse es 5 Minuten in der Pfanne abkühlen und stürze es dann auf ein Kuchengitter oder serviere es direkt aus der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
