      "steps": [
        {
          "position": 0,
          "text": "Hacke Schalotten, Knoblauch und Ingwer fein und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle den Reis unter kaltem Wasser ab, bis das Wasser klar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Topf und dünste die gehackten Aromaten 1-2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kurkumapulver hinzu und rühre 30 Sekunden ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Reis hinein und rühre 2 Minuten, damit er mit Öl und Gewürzen überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kokosmilch, Wasser, Zitronengras und Salz in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze, decke den Topf ab und lasse den Reis 18-20 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
