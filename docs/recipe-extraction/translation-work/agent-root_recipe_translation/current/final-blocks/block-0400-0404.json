      "steps": [
        {
          "position": 0,
          "text": "Bestreue das Hähnchen mit Currypulver und Salz, wende es darin und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Erdnussbutter, süße Chilisauce, Sojasoße, Essig und Knoblauch mit 2-3 EL Wasser in einer kleinen Schüssel, bis die Soße glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne auf hoher Stufe. Gib die Zwiebel dazu und brate sie 1-2 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hähnchen dazu und brate es 5-6 Minuten, bis es gebräunt und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schalte den Herd aus und rühre die Erdnusssoße ein. Gib bei Bedarf weitere 2-3 EL Wasser dazu, um sie zu verdünnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere das Hähnchen mit Reis, Gurke, Koriander, frischer Chili, gehackten Erdnüssen und Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
