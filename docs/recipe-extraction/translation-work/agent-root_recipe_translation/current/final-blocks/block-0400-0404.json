      "steps": [
        {
          "position": 0,
          "text": "Bereite die Soße zu: Verrühre Hoisinsoße, Sojasoße, dunkle Sojasoße, Reisweinessig, braunen Zucker und nach Wunsch Fünf-Gewürze-Pulver in einer kleinen Schüssel oder einem Messbecher. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einer großen, schweren Pfanne auf hoher Stufe. Gib das Rindfleisch hinein und verteile es durch Zerkleinern über die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass das Rindfleisch 5-6 Minuten unberührt braten, damit es bräunt und knusprige Ränder bekommt. Wende es, zerkleinere es weiter und brate es noch 1-2 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre den gehackten Knoblauch und geriebenen Ingwer ein und brate beides etwa 30 Sekunden, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Soße über das Rindfleisch und lass alles unter Rühren 1-2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die angerührte Mischung aus Speisestärke und Wasser ein und gare alles 30-60 Sekunden, bis die Soße eindickt und am Rindfleisch haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile das Rindfleisch auf gedämpftem Jasminreis. Gib Gurkenstreifen, geschnittene Frühlingszwiebeln und geröstete Sesamsamen darauf, träufle Sesamöl darüber und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
