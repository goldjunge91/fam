      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze und brate das Hähnchen etwa 6-8 Minuten goldbraun und gar. Nimm es anschließend aus der Pfanne und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Sojasauce, Reisessig, Sesamöl, gehackten Knoblauch, Chiliflocken und Honig in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide den Römersalat und gib ihn zusammen mit gewürfelter Paprika und Gurke in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das gegarte Hähnchen und die Erdnüsse zum Salat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Dressing darüber, vermenge alles gut und bestreue den Salat vor dem Servieren mit geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
