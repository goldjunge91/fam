      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln etwa 12 Minuten, bis sie weich sind, und schneide sie anschließend in Viertel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Putze die grünen Bohnen und koche sie 4 Minuten, bis sie gar, aber noch bissfest sind. Lass sie anschließend abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche die Eier 10 Minuten, lass sie abkühlen und halbiere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Olivenöl, Rotweinessig und Dijon-Senf zu einem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den Salat auf zwei Tellern und richte Kartoffeln, grüne Bohnen, halbierte Eier, Tomaten und Zwiebel in einzelnen Bereichen darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass den Thunfisch abtropfen und gib ihn auf die Salate. Träufle das Dressing darüber und verteile die Oliven darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
