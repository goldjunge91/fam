      "steps": [
        {
          "position": 0,
          "text": "Löse 2 Esslöffel Salz in 4 Tassen Wasser auf und stelle eine Lake her. Lege den Schellfisch 30 Minuten hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Schellfisch aus der Lake und tupfe ihn trocken. Schneide jeden Fisch entlang der Mittelgräte auf, ohne die Hälften zu trennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fixiere jeden aufgeschnittenen Fisch mit Holzspießen an den Seiten, damit er aufgeklappt bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Räucherofen auf 80°C (175°F) vor und gib eingeweichte Eichenholzchips hinein, damit dichter, kühler Rauch entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege den Schellfisch mit der Hautseite nach unten auf den Räucherrost und räuchere ihn 30-40 Minuten, bis das Fleisch fest und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Spieße und lege den geräucherten Fisch noch warm auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Butter darauf, presse frischen Zitronensaft darüber und würze ihn vor dem Servieren mit Meersalz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
