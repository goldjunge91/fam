      "steps": [
        {
          "position": 0,
          "text": "Vermische Salz, braunen Zucker und Pfeffer und reibe die Mischung auf die Fleischseite der Makrele.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Makrele mit der Hautseite nach unten auf ein Gitter und stelle sie 30 Minuten unbedeckt in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe die Makrele trocken und lege sie mit der Hautseite nach unten auf den mit Thymianzweigen belegten Räucherrost.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Räuchere sie bei 160°F 25-30 Minuten, bis das Fleisch undurchsichtig ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle die fertige Makrele mit Olivenöl und presse frischen Zitronensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie warm oder bei Zimmertemperatur mit knusprigem Brot und Meerrettichcreme.",
