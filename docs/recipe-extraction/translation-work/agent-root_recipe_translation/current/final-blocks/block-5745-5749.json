      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 450°F vor und stelle eine ofenfeste Pfanne mit 1 Esslöffel Öl für 10 Minuten zum Vorheizen hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze den Rinderbraten mit Salz, Pfeffer, Thymian und Knoblauch und brate ihn in der heißen Pfanne 8 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle die Pfanne in den Ofen und brate das Fleisch 60-75 Minuten, bis es für den Gargrad medium-rare eine Kerntemperatur von 130°F erreicht. Nimm den Braten heraus und lasse ihn ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle während der Ruhezeit Mehl, Eier, Milch, Salz und Pfeffer in einer Schüssel zu einem Teig für Yorkshire Pudding.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 2 Esslöffel Öl in eine Backform und stelle sie in den 425°F heißen Ofen. Erhitze das Öl 5 Minuten, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Teig in die heiße Ölform und backe ihn 20-25 Minuten goldbraun und aufgegangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide den Rinderbraten auf und serviere ihn mit Yorkshire Pudding. Vermische den Bratensatz mit Rinderbrühe und verwende ihn als Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
