      "steps": [
        {
          "position": 0,
          "text": "Schneide die Fettschicht der Rinderbrust auf ¼-inch Dicke zu und tupfe das Fleisch mit Küchenpapier vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Pfeffer, Knoblauchpulver, Paprikapulver und Zwiebelpulver und reibe die Mischung großzügig auf die Rinderbrust.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Rinderbrust mit der Fettseite nach oben in den auf 225°F vorgeheizten Räucherofen mit Hickory- oder Eichenholz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Räuchere das Fleisch 6-7 Stunden, bis es eine Kerntemperatur von 165°F erreicht. Besprühe es jede Stunde mit Apfelessig und Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wickle die Rinderbrust mit etwas Rinderbrühe fest in Metzgerpapier und räuchere sie weiter, bis sie eine Kerntemperatur von 203°F erreicht (weitere 3-4 Stunden).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Rinderbrust aus dem Räucherofen und lasse sie 30-45 Minuten eingewickelt ruhen, bevor du sie auspackst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide das Fleisch quer zur Faser in ¼-inch dicke Scheiben und serviere es mit Bratensaft als Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
