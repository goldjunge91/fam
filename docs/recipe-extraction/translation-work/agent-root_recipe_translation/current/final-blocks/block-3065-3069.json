      "steps": [
        {
          "position": 0,
          "text": "Auberginen direkt über einer Gasflamme oder unter dem Grill etwa 15 Minuten rösten und gelegentlich wenden, bis die Haut schwarz und das Fruchtfleisch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Auberginen leicht abkühlen lassen, die schwarze Haut unter kaltem fließendem Wasser abziehen und das Fruchtfleisch in kleine Stücke hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer Pfanne erhitzen und gehackten Knoblauch 30 Sekunden dünsten, dann gewürfelte Tomaten und Kurkuma hinzufügen und 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackte Aubergine in die Pfanne geben, gut umrühren und 3 Minuten garen, bis sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zwei Mulden in die Mischung drücken, je ein Ei hineinschlagen, abdecken und 4 Minuten garen, bis die Eier gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer würzen, auf einen Teller geben und mit warmem Brot zum Auftunken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
