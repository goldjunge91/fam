      "steps": [
        {
          "position": 0,
          "text": "Hühnerbrühe in einem großen Topf zum Kochen bringen, gehackten Ingwer hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brühe mit Sojasauce und Salz abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Saimin-Nudeln in einem separaten Topf mit kochendem Salzwasser nach Packungsanweisung kochen und gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während die Nudeln kochen, Eier 6 Minuten weich kochen, schälen und halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchenwürfel direkt in der Brühe 8 Minuten pochieren, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Nudeln auf vier Schalen verteilen und heiße Brühe mit Hähnchen darüber schöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Schale mit Fischkuchenscheiben, halben gekochten Eiern und gehackten Frühlingszwiebeln belegen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
