      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebel goldbraun dünsten, dann Rindfleisch hinzufügen und von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomatenmark und Kurkuma einrühren und 2 Minuten garen, dann Wasser, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Getrocknete Limetten mit einem Messer einstechen und in den Topf geben; zugedeckt 45 Minuten köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis 10 Minuten in kochendem Salzwasser garen, bis er teilweise gekocht ist, dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einem separaten Topf Butter erhitzen und die Hälfte des Reises auf dem Boden verteilen, dann Rindfleischeintopf mit Limetten daraufgeben und mit dem restlichen Reis bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fest abdecken, Hitze auf mittelniedrig reduzieren und 15 Minuten garen, bis sich unten eine goldene Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reis vorsichtig mit einer Gabel auflockern und servieren; knuspriges Tahdig auf jeden Teller schöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
