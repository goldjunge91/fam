      "steps": [
        {
          "position": 0,
          "text": "Auberginen in dicke Scheiben schneiden, großzügig salzen und 15 Minuten ruhen lassen, damit Feuchtigkeit austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne erhitzen und Auberginenscheiben insgesamt etwa 8 Minuten von beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Auberginen herausnehmen und beiseitestellen, dann geschnittene Zwiebeln im restlichen Öl etwa 10 Minuten stark karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute garen, dann Auberginen zurück in die Pfanne geben und vorsichtig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auberginenmischung auf einer Servierplatte anrichten, großzügig mit Kashk beträufeln und getrocknete Minze darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Granatapfelmelasse dekorativ darüberträufeln und warm oder bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
