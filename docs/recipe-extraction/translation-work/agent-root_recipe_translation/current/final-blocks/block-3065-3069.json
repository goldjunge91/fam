          "position": 0,
          "text": "Hähnchenoberkeulen mit Salz, Pfeffer, gehacktem Knoblauch und Ingwer würzen und 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen bei 425°F 25-30 Minuten backen, bis die Haut knusprig ist und das Fleisch innen 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Während das Hähnchen gart, Makkaronisalat zubereiten, indem gekochte Pasta mit Mayonnaise cremig vermengt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis in der Mikrowelle oder auf dem Herd erwärmen und auf zwei Tellern jeweils an einer Seite anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gegarte Hähnchenoberkeulen neben dem Reis auf jeden Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Makkaronisalat als dritte Portion auf jeden Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hähnchen leicht mit Sojasauce beträufeln und heiß servieren.",
