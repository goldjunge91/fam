      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch mit Sojasauce und gehacktem Knoblauch in einer Pfanne bei mittelhoher Hitze 5–6 Minuten braten. Dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In derselben Pfanne den Spinat mit 1 TL Sesamöl 2 Minuten dünsten, bis er zusammengefallen ist. Dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die geschnittenen Pilze mit 1 TL Sesamöl 3–4 Minuten goldbraun braten. Dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die geriebenen Karotten 2 Minuten in der Pfanne leicht garen und dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drei Eier als Spiegeleier mit weichem Eigelb oder nach Wunsch braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Tortillas in einer trockenen Pfanne je Seite 20 Sekunden erwärmen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gochujang mit dem restlichen Sesamöl zu einer Sauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Tacos schichten: Reis, Rindfleisch, Spinat, Pilze, Karotten und je ein Spiegelei auf jede Tortilla geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit der Gochujang-Sauce beträufeln, mit Frühlingszwiebeln bestreuen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
