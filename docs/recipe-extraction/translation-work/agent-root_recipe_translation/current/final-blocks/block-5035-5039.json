      "steps": [
        {
          "position": 0,
          "text": "1/2 EL Gochujang-Mayonnaise auf jede der vier Tortillas streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Käse, koreanisches BBQ-Rindfleisch und karamellisierte Zwiebeln auf zwei Tortillas verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sesamsamen über die Füllungen streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit den übrigen Tortillas mit der Mayonnaise-Seite nach unten abdecken und vorsichtig andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1 EL Butter in einer großen Pfanne bei mittlerer Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Quesadillas je Seite 3–4 Minuten braten, bis der Käse geschmolzen und die Tortillas goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Viertel schneiden und heiß mit saurer Sahne und Koriander garnieren und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
