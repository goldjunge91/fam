      "steps": [
        {
          "position": 0,
          "text": "Das Rindfleisch in dünne Scheiben schneiden und mit Maisstärke sowie 1 TL Sojasauce vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 EL Öl in einem Wok oder einer großen Pfanne bei starker Hitze erhitzen, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Rindfleisch portionsweise je Seite 2–3 Minuten anbraten, bis es gebräunt ist. Dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das restliche 1 EL Öl in den Wok geben und Knoblauch sowie Ingwer 1 Minute braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sojasauce, Austernsauce, Essig, braunen Zucker und Wasser in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Sauce in den Wok gießen und 1 Minute rühren, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Rindfleisch zurück in den Wok geben und 2 Minuten vermengen, bis es gleichmäßig mit Sauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und sofort auf Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
