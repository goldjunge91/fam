      "steps": [
        {
          "position": 0,
          "text": "Weiche Stockfisch 24 Stunden in kaltem Wasser ein und wechsle das Wasser mehrmals. Schneide ihn dann in Portionsstücke und tupfe ihn trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle Kartoffeln, schneide sie in 1 Zoll große Würfel und koche sie 8 Minuten in Salzwasser. Gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Auflaufform oder einem flachen Topf bei mittlerer Hitze und dünste dünn geschnittene Zwiebel und gehackten Knoblauch 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 1 Minute, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib vorgekochte Kartoffeln in die Form und wende sie vorsichtig in der Ölmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Stockfischstücke auf die Kartoffeln, gib Lorbeerblatt hinzu und würze mit schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Form ab und gare alles bei mittlerer bis niedriger Hitze 12-15 Minuten oder backe es zugedeckt bei 400°F 15 Minuten, bis sich der Fisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne das Lorbeerblatt, probiere das Gericht, passe die Würzung an und serviere es direkt aus der Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
