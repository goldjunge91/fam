      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Hähnchenschenkel auf beiden Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In derselben Pfanne gewürfelte Zwiebeln und gehackten Knoblauch anbraten, bis sie weich sind, etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Paprika, Salz und Pfeffer zur Zwiebelmischung hinzufügen und 1 Minute rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Huhn wieder in die Pfanne, fügen Sie Wasser hinzu, decken Sie es ab und lassen Sie es 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Kartoffeln hinzufügen und zugedeckt 15 Minuten weitergaren, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Machen Sie 4 Vertiefungen in der Mischung und schlagen Sie ein Ei in jede Vertiefung, dann decken Sie es ab und kochen Sie es 4-5 Minuten lang, bis die Eier fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß direkt aus der Pfanne servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
