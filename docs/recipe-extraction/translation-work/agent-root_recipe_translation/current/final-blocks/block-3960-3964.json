      "steps": [
        {
          "position": 0,
          "text": "Ghee in einem großen Topf erhitzen und die Fleischstücke von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im gleichen Topf die gewürfelten Zwiebeln anbraten, bis sie weich sind, dann den gehackten Knoblauch hinzufügen und 1 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kreuzkümmel und Koriander hinzufügen und 30 Sekunden lang rühren, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Fleisch wieder in den Topf, fügen Sie Tomatensauce und Wasser hinzu und lassen Sie es köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und 35 Minuten kochen lassen, dabei gelegentlich umrühren, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in Schüsseln als dicke Suppe oder Eintopf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Traditionell serviert mit Brot zum Dippen oder über Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
