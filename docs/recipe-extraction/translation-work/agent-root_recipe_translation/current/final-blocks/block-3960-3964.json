      "steps": [
        {
          "position": 0,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Abgetropften Thunfisch, gehackte Zwiebeln, gehackte Petersilie, Salz und Pfeffer in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie ein Phyllo-Blatt auf eine saubere Oberfläche und löffeln Sie die Thunfischmischung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlagen Sie ein Ei in die Mitte der Füllung und falten Sie das Phyllo zu einem Dreieck, wobei Sie die Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie den gefalteten Brik vorsichtig in heißes Öl und braten Sie ihn 2-3 Minuten pro Seite, bis er goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem Schaumlöffel herausnehmen und auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Harissa oder Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
