        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und Fischfilets auf beiden Seiten je 2 Minuten anbräunen, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
