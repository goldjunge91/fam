        {
          "position": 1,
          "text": "Im selben Topf Zwiebeln und Knoblauch etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 2 Minuten unter ständigem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe angießen und zum Kochen bringen, dann Karotten, Kartoffeln und ganze scharfe Chilis hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "15 Minuten köcheln lassen, bis das Gemüse langsam weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reis hinzufügen und gut umrühren, dann den Fisch wieder in den Topf legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren, abdecken und 20 Minuten köcheln lassen, bis der Reis weich und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
