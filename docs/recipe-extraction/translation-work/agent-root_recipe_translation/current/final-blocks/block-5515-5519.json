          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere die Nori-Blätter und lege sie auf eine saubere Arbeitsfläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile den gewürzten Reis gleichmäßig auf jedem Nori-Streifen und lasse einen schmalen Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Surimi, Gurke, Avocado und Frischkäse als Streifen auf den Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle das Nori fest zu einer Rolle. Forme sie anschließend zu einem Donutring und drücke die Enden zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Sriracha und Sojasauce in einer kleinen Schüssel zu einer Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue die Sushi-Donuts mit Sesam und serviere sie mit der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
