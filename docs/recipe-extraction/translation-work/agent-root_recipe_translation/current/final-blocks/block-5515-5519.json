      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz, Zucker und Hefe in einer Schüssel. Gib warmes Wasser dazu und knete alles zu einem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Touriere den Teig: Rolle ihn aus, verteile kalte Butterstücke darauf, falte ihn und wiederhole dies 6-mal innerhalb von 30 Minuten mit Ruhepausen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den tourierten Teig 0.5 inch dick aus und stich mit einem Donut-Ausstecher Formen aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Cronut-Teigstücke 1-2 Stunden gehen, bis sie aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne auf 350°F und frittiere jeden Cronut pro Seite 1-2 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die frittierten Cronuts auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verrühre Nutella mit 1 Esslöffel warmer Milch zu einer streichfähigen Füllung und fülle sie in einen Spritzbeutel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verrühre Puderzucker mit 1 Esslöffel Milch zu einer Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Fülle jeden warmen Cronut mit Nutella und tauche die Oberseite in die Puderzuckerglasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
