      "steps": [
        {
          "position": 0,
          "text": "Verquirle Schlagsahne, Vollmilch und Eigelb in einem Topf bei mittlerer bis niedriger Hitze. Rühre ständig, bis die Mischung 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Topf vom Herd und rühre die schwarze Sesampaste glatt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gezuckerte Kondensmilch, Vanilleextrakt und Salz dazu und rühre alles zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung durch ein feines Sieb, um Klümpchen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kühle die Mischung mindestens 2 Stunden vollständig im Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße sie in eine Eismaschine und rühre sie nach Herstellerangaben, meist 20-25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle das Softeis in einen gefriergeeigneten Behälter und friere es mindestens 4 Stunden ein, bis es fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
