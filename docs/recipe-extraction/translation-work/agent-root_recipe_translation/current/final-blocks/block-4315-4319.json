      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen und zwei runde Kuchenformen von 9-inch einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "0.5 cup Butter und 1 cup Zucker cremig schlagen, dann Eier einzeln einrühren und 1 tsp Vanille hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Backpulver und Salz vermengen und dann die trockenen Zutaten sowie Milch abwechselnd zur Buttermischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig auf die Formen verteilen und 25-30 Minuten backen, bis ein Zahnstocher sauber herauskommt; dann abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Gebäckcreme 0.75 cup Milch mit 0.5 cup Zucker und Maisstärke erhitzen, dann Eigelb und 1 tsp Vanille einrühren und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlagsahne steif schlagen und unter die abgekühlte Gebäckcreme heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gebäckcreme zwischen den beiden abgekühlten Kuchenböden verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "4 oz Zartbitterschokolade mit 2 tbsp Butter schmelzen und als Ganache auf dem Kuchen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Vor dem Servieren mindestens 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
