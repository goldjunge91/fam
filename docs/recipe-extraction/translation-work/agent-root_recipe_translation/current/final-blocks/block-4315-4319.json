      "steps": [
        {
          "position": 0,
          "text": "Gegartes Hummerfleisch in mundgerechte Stücke schneiden und in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mayonnaise, Zitronensaft, gewürfelten Sellerie, Salz, Pfeffer und Paprikapulver in einer separaten Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mayonnaise-Mischung vorsichtig unter das Hummerfleisch heben, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Innenseiten der Hotdog-Brötchen mit Butter bestreichen und in einer Pfanne bei mittlerer Hitze leicht goldbraun toasten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jedes getoastete Brötchen großzügig mit Hummersalat füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort mit Zitronenspalten und zusätzlichem Paprikapulver zum Garnieren servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
