      "steps": [
        {
          "position": 0,
          "text": "Leber und Darm gründlich reinigen und dann in kleine mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze erhitzen und Zwiebel, Knoblauch sowie Paprika 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Leber- und Darmstücke hinzufügen und unter häufigem Rühren 8 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprikapulver über das Fleisch streuen und gut umrühren, dann gewürfelte Tomaten und Rinderbrühe hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze auf mittelniedrig reduzieren, abdecken und 35 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gewürfelte Kartoffeln hinzufügen und weitere 20 Minuten köcheln lassen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken, mit frischer Petersilie garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
