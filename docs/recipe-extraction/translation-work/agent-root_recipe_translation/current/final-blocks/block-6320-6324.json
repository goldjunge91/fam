      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebeln, Sellerie und Karotten 5 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute kochen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brühe angießen und zum Kochen bringen, dann Zucchini, grüne Bohnen und Tomaten mit ihrem Saft hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "10 Minuten köcheln lassen, dann abgetropfte Cannellini-Bohnen und Nudeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "8–10 Minuten kochen, bis die Nudeln weich sind und die Bohnen durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nach Belieben frisches Basilikum, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schüsseln füllen und heiß mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
