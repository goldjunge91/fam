      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie frische Sardellen vorsichtig, indem Sie sie abspülen und das Rückgrat entfernen, indem Sie es mit der Bauchseite nach oben aufschneiden und das Rückgrat vorsichtig abtrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Semmelbrösel, Parmigiano, gehackte Petersilie, gehackten Knoblauch und Ei in einer Schüssel zu einer Füllung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie einen kleinen Löffel der Füllung zwischen zwei Sardellenfilets, um daraus Sandwiches zu machen, und drücken Sie sie leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die gefüllten Sardellen in der Pfanne anrichten und auf jeder Seite 3–4 Minuten braten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tomatensauce in einem separaten Topf erwärmen und Zitronensaft hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sardellen anrichten und warme Tomatensauce darüber geben, mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
