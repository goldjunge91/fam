      "steps": [
        {
          "position": 0,
          "text": "Stockfisch 12–24 Stunden in kaltem Wasser einweichen und das Wasser mehrmals wechseln, damit überschüssiges Salz entfernt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln schälen und würfeln, in Salzwasser 15 Minuten kochen, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den eingeweichten Kabeljau 8–10 Minuten in kochendem Wasser kochen, dann abgießen, Gräten entfernen und in kleine Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gekochte Kartoffeln in einer Schüssel zerdrücken, dann Kabeljauflocken und gehackten Knoblauch hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie langsam abwechselnd Olivenöl und Milch hinzu und schlagen Sie die Mischung, bis sie leicht und locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Zitronensaft, Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf eine Servierplatte geben, mit Petersilie garnieren und warm oder bei Zimmertemperatur mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
