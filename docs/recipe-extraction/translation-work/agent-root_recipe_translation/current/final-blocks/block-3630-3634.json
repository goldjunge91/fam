      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Backpulver in einer Schüssel. Arbeite Backfett mit den Fingern ein, bis die Mischung grobem Sand ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Ei und nach und nach Wasser unter Rühren dazu, bis ein weicher Teig entsteht. Lasse ihn zugedeckt 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Rinderhackfleisch mit Zwiebel, Knoblauch und Oregano in einer Pfanne bei mittlerer Hitze 8 Minuten an und lasse es dann abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 gleich große Stücke und rolle jedes zwischen zwei Lagen Frischhaltefolie zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege 2 tablespoons Füllung auf eine Hälfte jedes Kreises, klappe ihn zusammen und drücke die Ränder zu. Verziere sie mit einer Gabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F (175°C) und frittiere jeweils 2-3 Empanadas gleichzeitig 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm, nach Wunsch mit Salsa oder scharfer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
