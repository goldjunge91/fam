      "steps": [
        {
          "position": 0,
          "text": "Koche Kartoffeln und zerdrücke sie glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Hähnchenhackfleisch mit gehacktem Knoblauch und Zwiebel in einer Pfanne bei mittlerer Hitze an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische zerdrückte Kartoffeln mit gegartem Hähnchen, würze mit Salz und Pfeffer und lasse die Füllung abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Mehl, Wasser, Ei und Salz zu einem Teig und knete ihn glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig dünn aus und schneide ihn in 3-inch große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege einen Löffel Füllung auf jedes Quadrat, falte es zu einem Dreieck und verschließe die Ränder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere Pastel, bis sie auf beiden Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
