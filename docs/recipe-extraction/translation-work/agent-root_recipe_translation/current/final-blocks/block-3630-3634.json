      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Chilischoten in einer trockenen Pfanne 1 Minute pro Seite. Entferne Stiele und Kerne und weiche sie dann in 2 cups heißem Wasser 15 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Kreuzkümmelsamen, Zimtstange, Nelken und Pfefferkörner 1 Minute in einer trockenen Pfanne, bis sie duften. Mahle sie dann in einer Gewürzmühle oder einem Molcajete.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere weiche Chilischoten samt Einweichwasser mit Knoblauch, Zwiebel und gemahlenen Gewürzen vollständig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einem großen Topf, seihe die Chilimischung ins heiße Öl und rühre 3 Minuten ständig, damit rohe Aromen verschwinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Hühnerbrühe dazu und bringe alles zum Köcheln. Gib Hähnchenschenkel dazu und gare sie 35 Minuten, bis sie zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz, Pfeffer und Limettensaft und lasse alles vor dem Servieren weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
