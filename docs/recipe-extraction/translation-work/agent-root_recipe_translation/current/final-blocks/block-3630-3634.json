      "steps": [
        {
          "position": 0,
          "text": "Vermische Masa Harina mit 1 cup kalter Milch in einer Schüssel und rühre glatt und klümpchenfrei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die übrigen 3 cups Milch mit Zimtstangen, Zucker und Salz in einem Topf, bis sie dampft, aber nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Masa-Mischung langsam unter ständigem Rühren in die heiße Milch, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche und rühre weitere 5 Minuten, bis die Mischung leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reibe oder hacke die Schokoladentafel und gib sie mit Vanilleextrakt in den Topf. Rühre, bis sie geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Getränk in Tassen und serviere es heiß, jeweils mit einer Zimtstange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
