      "steps": [
        {
          "position": 0,
          "text": "Basmatireis abspülen, 5 Minuten vorgaren und abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis mit den gehackten Kräutern vermischen. Butter im Topf schmelzen, den Reis hineingeben und mit dem Stiel eines Kochlöffels Löcher hineinstechen.",
