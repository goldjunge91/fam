      "steps": [
        {
          "position": 0,
          "text": "Gehackten Chinakohl in einer großen Schüssel mit koscherem Salz vermengen und 30 Minuten stehen lassen. Gelegentlich umrühren, bis der Kohl weich wird und Flüssigkeit abgibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den gesalzenen Kohl 2–3 Mal unter kaltem Wasser abspülen und überschüssiges Wasser ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch, Ingwer, Gochugaru, Fischsauce und Zucker in einer kleinen Schüssel zu einer Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Paste zusammen mit den gehackten Frühlingszwiebeln und Sesamsamen zum abgetropften Kohl geben und alles gründlich vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Kimchi in ein sauberes Glas geben und fest nach unten drücken, damit das Gemüse von eigener Flüssigkeit bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Glas locker abdecken und 2–7 Tage bei Zimmertemperatur fermentieren lassen. Täglich probieren, bis die gewünschte Schärfe erreicht ist, dann kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
