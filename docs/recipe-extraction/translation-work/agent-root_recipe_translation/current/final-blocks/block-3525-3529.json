      "steps": [
        {
          "position": 0,
          "text": "Weiche Wurstdärme 30 Minuten in warmem Wasser ein, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch, Zitronengras und Chilischoten fein und vermische sie mit Schweinehackfleisch, Fischsauce, Sojasauce und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die Füllung gründlich und stelle sie mindestens 1 Stunde kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Därme mit einem Wurstfüller oder einem improvisierten Trichter und binde 4-inch lange Würste ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille oder brate die Würste bei mittlerer Hitze 15-20 Minuten und wende sie häufig, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie heiß mit Klebreis und Dipsaucen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
