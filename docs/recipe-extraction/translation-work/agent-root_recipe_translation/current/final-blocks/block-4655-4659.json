      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf mit gesalzenem Wasser zum Kochen bringen und die Spaghetti nach Packungsanleitung bissfest garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauchzehen in dünne Scheiben schneiden und das Olivenöl in einer großen Pfanne bei mittlerer bis niedriger Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch und Chiliflocken in das Öl geben und 3-4 Minuten sanft erhitzen, bis sie duften, aber nicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 cup Nudelwasser auffangen, dann die Spaghetti abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die heißen Spaghetti zum Knoblauchöl in die Pfanne geben und gut durchschwenken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1/4 cup des aufgefangenen Nudelwassers nach und nach hinzufügen, um eine leichte Sauce zu erhalten, dabei ständig durchschwenken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer würzen, dann vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Teller verteilen und mit frischer Petersilie und Zitronensaft garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
