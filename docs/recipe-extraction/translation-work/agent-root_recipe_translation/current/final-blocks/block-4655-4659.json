      "steps": [
        {
          "position": 0,
          "text": "Mehl, Butter und Salz mit einer Gabel krümelig vermengen, dann Eiswasser hinzufügen und zu einem Teig verkneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 20 Minuten kalt stellen, dann ausrollen und in eine Tarteform drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teigboden mit einer Gabel einstechen und bei 375°F 10 Minuten backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Zwiebeln in dünne Scheiben schneiden und 30 Minuten langsam in Butter braten, bis sie sehr weich und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlagsahne, Eigelb, Käse, Pfeffer und Thymian in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die karamellisierten Zwiebeln auf dem vorgebackenen Teigboden verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sahnemischung gleichmäßig über die Zwiebeln gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 375°F 25-30 Minuten backen, bis die Eiermasse fest und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
