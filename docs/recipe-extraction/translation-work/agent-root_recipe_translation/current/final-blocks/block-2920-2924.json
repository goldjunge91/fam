      "steps": [
        {
          "position": 0,
          "text": "Paprika und Zwiebel fein würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 tbsp Butter in einer Pfanne bei mittlerer Hitze schmelzen und Paprika sowie Zwiebel 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerpflücktes Hähnchen in die Pfanne geben, 1 Minute erwärmen und dann vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine Tortilla in eine saubere Pfanne bei mittlerer Hitze legen und eine Hälfte mit Käse, Hähnchenmischung und nochmals Käse belegen, dann die Tortilla zuklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2-3 Minuten goldbraun und knusprig braten, vorsichtig wenden und die andere Seite weitere 2 Minuten garen, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf ein Schneidebrett legen und in Dreiecke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der zweiten Tortilla und der restlichen Füllung wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salsa und saurer Sahne zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
