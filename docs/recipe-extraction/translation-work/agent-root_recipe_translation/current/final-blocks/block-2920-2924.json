          "images": []
        },
        {
          "position": 4,
          "text": "Flautas mit der Nahtseite nach unten 2-3 Minuten goldbraun und knusprig frittieren, einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittierte Flautas auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Saure Sahne mit Salsa Verde zu einer Crema-Sauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Flautas auf Tellern servieren, mit Crema-Sauce beträufeln und mit dem restlichen Käse bestreuen.",
