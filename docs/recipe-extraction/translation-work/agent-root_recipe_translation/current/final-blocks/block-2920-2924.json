      "steps": [
        {
          "position": 0,
          "text": "Poblano-Chilis über offener Flamme rösten, bis sie auf allen Seiten vollständig schwarz sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geröstete Chilis in einer abgedeckten Schüssel 5 Minuten dämpfen, dann vorsichtig die verkohlte Haut abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen senkrechten Schlitz einschneiden und Kerne sowie Stiel vorsichtig entfernen, ohne die Chili einzureißen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Chili mit 2 oz Käse füllen und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und Eier schaumig schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Chilis leicht mit Mehl bestäuben, in das verquirlte Ei tauchen und von beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl mit der Eihülle in einen Topf abseihen, gehackten Knoblauch und Zwiebel anbraten, dann Hühnerbrühe und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brühesauce auf Servierteller gießen und gebratene Chilis darauf anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
