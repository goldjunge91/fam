      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch in 1-inch-Würfel schneiden und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf bei mittelhoher Hitze erhitzen und Rindfleisch portionsweise etwa 3-4 Minuten pro Portion von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rindfleisch herausnehmen und beiseitestellen, dann gewürfelte Zwiebel und gehackten Knoblauch im selben Topf 3 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark einrühren und 1 Minute garen, dann Rinderbrühe angießen und Rindfleisch zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kreuzkümmel hinzufügen, leicht köcheln lassen und teilweise abgedeckt 30 Minuten garen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffel schälen und würfeln, dann zusammen mit gewürfelter Jalapeño in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 15-20 Minuten köcheln lassen, bis die Kartoffeln mit einer Gabel leicht einzustechen sind und der Eintopf eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit Weizentortillas oder Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
