      ],
      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum sprudelnden Kochen. Koche die Pasta nach Packungsanweisung bissfest, gieße sie ab und stelle 2 Tassen Nudelwasser beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste schwarzen Pfeffer 1 Minute in einer großen Pfanne bei mittlerer Hitze, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 1 Tasse des Nudelwassers mit dem gerösteten Pfeffer in die Pfanne und lasse es sanft köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die abgetropfte Pasta dazu und vermische sie ständig. Gieße nach Bedarf weiteres Nudelwasser an, bis eine cremige Sauce entsteht. Das dauert etwa 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und rühre Butter ein, bis sie geschmolzen und vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue die Hälfte des geriebenen Pecorino über die Pasta und rühre ständig, bis der Käse schmilzt und die Pasta gleichmäßig überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Pasta auf zwei Schüsseln und garniere sie mit dem restlichen Käse und Aonori-Pulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
