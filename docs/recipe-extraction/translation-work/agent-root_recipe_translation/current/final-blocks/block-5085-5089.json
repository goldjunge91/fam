      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf oder Schmortopf bei mittelhoher Hitze. Bräune das Rindfleisch portionsweise von allen Seiten an, insgesamt etwa 12 Minuten. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln in den Topf und gare sie etwa 5 Minuten, bis sie weich und glasig sind. Gib gehackten Knoblauch dazu und gare ihn 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre ungarisches Paprikapulver und Tomatenmark ein und gare alles unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Rindfleisch zurück in den Topf. Füge Rinderbrühe und Kümmelsamen hinzu, bringe alles zum Köcheln, decke den Topf ab und gare das Gulasch 45 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gewürfelten Kartoffeln dazu und lasse das Gulasch zugedeckt weitere 25-30 Minuten köcheln, bis die Kartoffeln zart und das Fleisch sehr weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke das Gulasch mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse es die letzten 10 Minuten ohne Deckel köcheln, damit die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß in Schüsseln und gib nach Wunsch einen Klecks saure Sahne darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
