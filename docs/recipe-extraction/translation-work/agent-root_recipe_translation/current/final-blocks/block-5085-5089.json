      "steps": [
        {
          "position": 0,
          "text": "Lege die Schweineschulter in einen Schongarer und würze sie rundum großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Barbecuesauce, Apfelessig, braunen Zucker und Worcestersauce in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Hälfte der Saucenmischung über die Schweineschulter im Schongarer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Schongarer ab und gare das Fleisch 8 Stunden auf niedriger Stufe, bis es sehr zart ist und sich leicht mit einer Gabel zerzupfen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch aus dem Schongarer und zerzupfe es mit zwei Gabeln. Entferne überschüssiges Fett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das zerzupfte Fleisch zurück in den Schongarer und rühre die restliche Sauce ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare es auf niedriger Stufe weitere 30 Minuten, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Röste die Brötchen leicht an und belege sie mit Pulled Pork, Krautsalat und Gewürzgurken. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
