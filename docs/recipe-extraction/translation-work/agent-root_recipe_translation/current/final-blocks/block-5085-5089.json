      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 400°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere Kichererbsen, Zwiebel, Petersilie und Knoblauch in einer Küchenmaschine fein, aber nicht zu Püree.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die Kichererbsenmischung mit Mehl, Kreuzkümmel, Koriander, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Mischung 16 Kugeln und drücke sie leicht zu Bratlingen flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische die Bratlinge mit Olivenöl und verteile sie auf dem vorbereiteten Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie 20-25 Minuten und wende sie nach der Hälfte der Zeit, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
