      "steps": [
        {
          "position": 0,
          "text": "Verrühre warmes Wasser, Hefe und Zucker in einer Schüssel und lasse die Mischung 5 Minuten stehen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mehl, Salz und Olivenöl zur Hefemischung und knete den Teig 8-10 Minuten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege den Teig in eine geölte Schüssel, decke ihn mit einem feuchten Tuch ab und lasse ihn 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 gleich große Stücke und forme jedes zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Kugeln 15 Minuten ruhen und rolle jede anschließend zu einem 1/4 Zoll dicken Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze eine gusseiserne Pfanne oder Grillplatte 2 Minuten bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe jedes Pitabrot 3-4 Minuten pro Seite, bis es aufgeht und hellbraune Flecken bekommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wickle die fertigen Pitas in ein sauberes Tuch, damit sie weich bleiben, und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
