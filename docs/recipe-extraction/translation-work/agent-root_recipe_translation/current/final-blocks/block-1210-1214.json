      "steps": [
        {
          "position": 0,
          "text": "Frittiere 1/4 der Nudeln in Öl, bis sie knusprig sind. Stelle sie als Topping beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Currypaste und Kurkuma 2 Minuten in Öl an. Gib Kokosmilch und Brühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Hähnchenschenkel hinein und lass alles 15 Minuten köcheln, bis das Fleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die übrigen Nudeln. Richte Nudeln und Currybrühe mit Hähnchen in Schalen an und gib knusprige Nudeln, frittierte Schalotten, Limette und Koriander darauf.",
