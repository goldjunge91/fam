      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und fette eine 9-inch Pastetenform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Schweinehack bei mittlerer bis hoher Hitze etwa 5 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebel dazu und gare sie etwa 3 Minuten weich. Rühre dann Kartoffel und Apfel ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze mit Salz, Pfeffer und Salbei. Gieße Brühe an und lasse die Füllung 5 Minuten köcheln, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Füllung 10 Minuten abkühlen und lege dann einen Pastetenteig in die Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Füllung darauf. Decke sie mit dem zweiten Teigboden ab und drücke die Ränder mit einer Gabel fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide kleine Dampfschlitze in den Deckel und bestreiche ihn mit verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Pastete 40-45 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
