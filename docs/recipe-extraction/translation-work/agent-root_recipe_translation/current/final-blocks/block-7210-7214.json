          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Butter und Zucker etwa 2 Minuten hell und luftig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre das Ei vollständig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Mehl, Backpulver und Salz in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die trockenen Zutaten unter die Buttermasse und rühre anschließend Johannisbeeren und Milch ein, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Setze mit einem Löffel Teighäufchen mit 2 inches Abstand auf das Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Küchlein 15-18 Minuten, bis sie oben goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie vor dem Servieren 5 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
