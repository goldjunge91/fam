      "steps": [
        {
          "position": 0,
          "text": "Vermenge Rinderhack mit Ei, Paniermehl, Parmesan, Knoblauch, Zwiebel, italienischer Gewürzmischung und Salz. Forme Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Fleischbällchen in Öl von allen Seiten 4 min an und nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib stückige Tomaten und Chiliflocken dazu und lass alles 10 min köcheln. Gib die Fleischbällchen zurück und lass sie weitere 8 min köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Brötchen auf und röste sie. Fülle sie mit Fleischbällchen und Sauce und belege sie mit Mozzarella.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Überbacke sie 2–3 min, bis der Käse blubbert und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
