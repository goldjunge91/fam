      "steps": [
        {
          "position": 0,
          "text": "Vermische Hefe mit warmem Wasser und lasse sie 5 Minuten stehen. Gib dann Salz und 1 EL Olivenöl dazu, um den Vorteig herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre nach und nach Mehl ein und knete den Teig 8 Minuten glatt. Lasse ihn anschließend zugedeckt in einer geölten Schüssel 1.5 hours gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in zwei Hälften und ziehe jede auf einem leicht geölten Backblech zu einem dünnen Kreis von 12-inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Tomaten aus der Dose mit gehacktem Knoblauch und lasse sie 5 Minuten stehen. Verstreiche die Mischung dann dünn auf jedem Pizzaboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zupfe frischen Mozzarella in kleine Stücke, verteile ihn gleichmäßig auf der Tomatensauce und beträufle alles mit dem restlichen Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Pizzen bei 500°F 12-15 Minuten, bis der Rand goldbraun und der Käse geschmolzen und blubbernd ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pizzen aus dem Ofen, belege sie mit frischen Basilikumblättern und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
