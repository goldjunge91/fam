      "steps": [
        {
          "position": 0,
          "text": "Vermische Hefe mit warmem Wasser und lasse sie 5 Minuten stehen, bis sie schaumig ist. Gib dann Salz und Zucker dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Mehl dazu und knete dann 2 tablespoons Olivenöl und Anissamen 8 Minuten ein, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig zugedeckt mit einem feuchten Tuch in einer geölten Schüssel 2 Stunden gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke den Teig zusammen und ziehe ihn in einer gefetteten 9x13 inch großen Backform auseinander. Beträufle ihn mit dem restlichen 1 EL Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Teig ab und lasse ihn 1 Stunde gehen, bis er luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heize den Ofen auf 400°F vor und backe den Teig 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestäube ihn noch warm großzügig mit Puderzucker und serviere ihn warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
