      "steps": [
        {
          "position": 0,
          "text": "Vermische warme Milch mit Hefe und lasse sie 5 Minuten stehen, bis sie schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Butter und Zucker etwa 3 Minuten hell und schaumig und rühre dann die Eier einzeln mit Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl und Salz und hebe sie abwechselnd mit der Hefemischung in drei Portionen vorsichtig unter die Buttermischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe Rosinen und kandierte Zitrusschale unter und fülle den Teig in eine gefettete Panettone-Form oder hohe runde Kuchenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Form mit einem feuchten Tuch ab und lasse den Teig 6-8 Stunden bei Raumtemperatur gehen, bis er die Form fast ausfüllt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heize den Ofen auf 375°F vor und backe den Kuchen 45-50 Minuten, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm ihn aus dem Ofen und lasse ihn 10 Minuten in der Form abkühlen. Stürze ihn dann auf ein Kuchengitter und lasse ihn vollständig auskühlen.",
