      "steps": [
        {
          "position": 0,
          "text": "Tupfe Kaninchenstücke trocken und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher bis hoher Hitze und bräune das Fleisch etwa 10 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und dünste gewürfelte Zwiebel, Knoblauch, Karotten und Sellerie etwa 6 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein dazu, löse die Röstspuren vom Topfboden und lasse alles etwa 2 Minuten leicht einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatensauce und Hühnerbrühe ein und gib das Fleisch mit Salbeiblättern zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 1.5 hours sanft köcheln, bis das Kaninchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne Salbeiblätter, würze mit Salz und Pfeffer und serviere das Gericht mit weicher Polenta oder breiten Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
