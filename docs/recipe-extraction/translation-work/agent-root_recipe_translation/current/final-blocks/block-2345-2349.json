      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gare Linguine bissfest. Gieße sie ab und bewahre 1 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher Hitze und dünste Knoblauch und Chiliflocken 30 Sekunden an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib zerkleinerte Tomaten und Weißwein dazu. Bringe alles zum Köcheln und gare es 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Garnelen in die Sauce und gare sie 2 Minuten. Füge dann Venusmuscheln und Miesmuscheln hinzu und rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne ab und gare alles 6-8 Minuten, bis sich Venusmuscheln und Miesmuscheln öffnen. Wirf alle Muscheln weg, die geschlossen bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gekochte Linguine zu Meeresfrüchten und Sauce. Vermische alles vorsichtig und gib nach Bedarf Nudelwasser hinzu, bis die gewünschte Konsistenz erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere großzügig mit frischer Petersilie und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
