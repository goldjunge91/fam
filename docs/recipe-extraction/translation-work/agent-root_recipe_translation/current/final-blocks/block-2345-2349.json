      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gare die Pasta nach Packungsanweisung bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke währenddessen die Pilze fein und dünste sie in Olivenöl bei mittelhoher Hitze 5 Minuten, bis die Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Schweinehackfleisch zu den Pilzen und zerteile es beim Garen. Brate es 4-5 Minuten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gewürfelte Zwiebel und gehackten Knoblauch ein und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein hinein und lass ihn 2 Minuten einkochen. Gib dann zerkleinerte Tomaten dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Sauce 8 Minuten köcheln, rühre dann Sahne ein und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer, gieße die Pasta ab und gib sie zur Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische alles gut und serviere es mit Parmesan und frischer Petersilie bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
