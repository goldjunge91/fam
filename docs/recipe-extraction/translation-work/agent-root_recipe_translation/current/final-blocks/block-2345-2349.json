      "steps": [
        {
          "position": 0,
          "text": "Wenn du Spinat verwendest, gare ihn in einer Pfanne, bis er zusammenfällt. Drücke überschüssige Flüssigkeit heraus und hacke ihn fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Ricotta, Mehl, Ei, 0.5 cup Parmesan, Spinat, Muskatnuss, Salz und Pfeffer vorsichtig in einer Schüssel, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Ricottamischung kleine Kugeln von etwa 1.5 inches Durchmesser und gib sie vorsichtig ins kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Gnocchi, bis sie an die Oberfläche steigen, und gare sie danach weitere 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmilz währenddessen Butter in einer Pfanne bei mittlerer Hitze und gib Salbei und gehackten Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare Salbei und Knoblauch 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Gnocchi mit einer Schaumkelle heraus und gib sie zur Salbeibutter. Wende sie vorsichtig darin und serviere sie mit dem restlichen Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
