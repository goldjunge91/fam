      "steps": [
        {
          "position": 0,
          "text": "Erhitze Brühe in einem separaten Topf und halte sie während des Kochens bei niedriger Hitze warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl und 1 Esslöffel Butter in einer großen Pfanne bei mittlerer Hitze. Dünste gewürfelte Zwiebel und Knoblauch etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Reis dazu und rühre 1 Minute ständig um, bis er leicht geröstet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein hinein und rühre, bis er vollständig aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib warme Brühe schöpflöffelweise hinzu. Rühre häufig um und warte jeweils, bis die Flüssigkeit aufgenommen ist, bevor du mehr Brühe zugibst. Das dauert insgesamt etwa 18 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe den Reis in den letzten 5 Minuten an den Rand und gib Garnelen und Venusmuscheln in die Mitte der Pfanne. Gare sie, bis die Garnelen rosa und die Muscheln geöffnet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
