      "steps": [
        {
          "position": 0,
          "text": "Vermenge die Schweinefleischstreifen mit 0.5 Esslöffel Maisstärke und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 Esslöffel Pflanzenöl in einem Wok oder einer großen Pfanne bei starker Hitze, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Schweinefleisch dazu und brate es unter Rühren etwa 5-6 Minuten durch. Nimm es anschließend auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl in die Pfanne und brate die Blumenkohlröschen 4-5 Minuten, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Zwiebel, Paprika, Knoblauch und Ingwer hinzu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Schweinefleisch zurück in den Wok und füge Sojasauce, Essig, Sesamöl und Chiliflocken hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schwenke alles 1-2 Minuten durch, bis es vollständig erhitzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort auf gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
