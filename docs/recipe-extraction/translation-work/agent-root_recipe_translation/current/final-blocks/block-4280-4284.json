      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermengen und kalte Butter einarbeiten, bis die Mischung groben Krümeln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eiswasser esslöffelweise hinzufügen, bis der Teig gerade zusammenkommt, dann 20 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig ausrollen, in eine Tarteform von 9-inch drücken und bei 375°F 10 Minuten blindbacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Braunen Zucker, Sahne, Butter und Vanille in einem Topf vermengen und unter ständigem Rühren erhitzen, bis sich der Zucker auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Warme Füllung in den vorgebackenen Boden gießen und bei 375°F 15-18 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Schneiden und Servieren vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
