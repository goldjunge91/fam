      "steps": [
        {
          "position": 0,
          "text": "Gewürfelten Pökelspeck in einem großen Topf bei mittlerer Hitze etwa 5 Minuten braten, bis das Fett austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfeltes Schweine- und Rindfleisch hinzufügen und insgesamt etwa 10 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel hinzufügen und etwa 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe angießen, Lorbeerblätter und Thymian hinzufügen und 30 Minuten köcheln lassen, bis das Fleisch teilweise zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Kartoffeln hinzufügen und weitere 20 Minuten köcheln lassen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer würzen und die Fleischmischung zwischen zwei Schichten Tarteboden in eine tiefe Tarteform von 9-inch geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem letzten Tarteboden bedecken, Ränder verschließen, Dampfschlitze einschneiden, mit verquirltem Ei bestreichen und bei 375°F 40 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
