      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen flachen Pfanne oder einem Tontopf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittene Zwiebel dazu und brate sie etwa 4 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geschnittene Paprika, gehackten Knoblauch und gewürfelte Tomate dazu und gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Fischfilets vorsichtig auf die Gemüsemischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch über den Fisch und würze mit Salz, Pfeffer und Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und lasse alles 15-20 Minuten sanft köcheln, bis der Fisch undurchsichtig und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue das Gericht mit frischem Koriander und serviere es direkt aus der Pfanne mit weißem Reis oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
