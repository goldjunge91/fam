      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und brate gewürfelte Zwiebel etwa 4 Minuten glasig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Kartoffeln und Gemüsebrühe dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze und lasse die Suppe 15 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerdrücke die Kartoffeln teilweise mit einem Stampfer, damit die Brühe etwas eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre dünn geschnittenen Blattkohl ein und gare ihn 5-7 Minuten, bis er zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer, schöpfe die Suppe in Schalen und serviere sie mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
