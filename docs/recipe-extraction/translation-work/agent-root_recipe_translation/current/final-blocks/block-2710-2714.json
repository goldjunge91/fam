      "steps": [
        {
          "position": 0,
          "text": "Vermische Kondensmilch, Kakaopulver und Butter in einem Topf mit schwerem Boden bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre 8-10 Minuten ständig, während die Masse eindickt und dunkler wird. Schabe dabei die Seiten und den Boden des Topfs ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Topf vom Herd, sobald sich die Masse vom Rand löst und ein Holzlöffel eine Spur hinterlässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Masse etwa 5 Minuten abkühlen, bis sie sich gefahrlos anfassen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schokostreusel auf einen flachen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme mit einem kleinen Löffel oder Portionierer kleine Kugeln und wälze sie in den Schokostreuseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Setze jedes Brigadeiro in ein Pralinenförmchen aus Papier und serviere es bei Raumtemperatur.",
