      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und bestreiche ein Muffinblech mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Kondensmilch, Eigelb, Butter und Vanilleextrakt in einer Schüssel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Blätterteigplatten in 3-inch große Quadrate und drücke jedes vorsichtig in eine Muffinmulde, sodass die Ränder etwas hochstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib etwa 1 EL Füllung in jede Teigmulde und lasse oben 0.5 inch frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Teilchen 20-25 Minuten, bis der Teig goldbraun und die Füllung fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Zimt und Zucker in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Teilchen aus dem Ofen, bestreue sie noch warm mit der Zimtzuckermischung, lasse sie etwas abkühlen und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
