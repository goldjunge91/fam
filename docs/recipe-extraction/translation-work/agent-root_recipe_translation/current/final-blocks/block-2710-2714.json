      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und fette ein Mini-Muffinblech ein oder lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Milch und Öl in einem Topf, bis Dampf aufsteigt, und nimm den Topf dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, Salz und schwarzen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die heiße Milchmischung unter ständigem Rühren zu den Eiern, um sie an die Hitze zu gewöhnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Maniokmehl und Parmesan ein, bis ein klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle den Teig etwa zu zwei Dritteln in die vorbereiteten Muffinförmchen oder forme 12-15 golfballgroße Portionen auf dem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Brötchen 20-25 Minuten, bis sie aufgegangen und goldbraun sind, und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
