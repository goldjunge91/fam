      ],
      "steps": [
        {
          "position": 0,
          "text": "Koche die Makkaroni nach Packungsanleitung, aber 1 Minute kürzer. Gieße sie ab und spüle sie sofort mit kaltem Wasser ab, damit sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmelze währenddessen die Butter in einer großen, tiefen Pfanne bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach dem Schmelzen das Mehl dazu und rühre etwa 30 Sekunden, bis eine glatte Paste entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße etwa ein Viertel der Milch dazu und schlage die Mischung 30 Sekunden mit dem Schneebesen, bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die restliche Milch dazu und rühre sie bei niedriger Hitze etwa 5 Minuten mit dem Schneebesen, bis die Sauce so dick ist, dass sie einen Löffelrücken überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Hühnerbrühepulver und geriebenen Cheddar ein, bis der Käse geschmolzen ist. Schalte die Hitze aus und rühre die gegarte Pasta unter. Sofort servieren oder für eine knusprige Oberfläche weitergaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heize den Ofengrill vor. Gib die Pasta bei Bedarf in eine Auflaufform, bestreue sie mit Panko-Semmelbröseln und sprühe Olivenöl darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Grille sie 2-3 Minuten, bis die Oberfläche goldbraun ist. Beobachte sie gut, denn sie bräunt schnell.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
