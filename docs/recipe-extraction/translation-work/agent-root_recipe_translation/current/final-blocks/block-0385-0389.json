      "steps": [
        {
          "position": 0,
          "text": "Bestreue die Hähnchensteaks rundherum mit Meersalz, schwarzem Pfeffer, Paprikapulver und getrocknetem Thymian. Reibe die Gewürze mit den Händen ein, damit das Fleisch gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen, schweren Pfanne bei mittlerer Hitze und gib dann die Butter dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sobald die Butter geschmolzen ist, gib das Hähnchen in die Pfanne und gare es 3 Minuten. Wende es, decke die Pfanne ab und gare es weitere 3 Minuten oder bis es durch ist. Lege es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch in dieselbe Pfanne und gare ihn unter Rühren 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Zitronensaft, Hühnerbrühe und Sahne dazu. Sobald die Flüssigkeit köchelt, rühre Parmesan und Gnocchi ein und gare alles 2 Minuten, bis die Sauce eindickt und die Gnocchi weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Babyspinat ein, bis er zusammengefallen ist. Lege das gegarte Hähnchen darauf und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
