    {
      "externalId": "waivy:she-macaroni-and-cheese",
      "slug": "she-macaroni-and-cheese",
      "title": "Makkaroni mit Käse (Simple Home Edit)",
      "instructions": "Cremige Makkaroni mit seidiger Cheddar-Sauce, unter dem Ofengrill mit goldbraunem Panko-Knusper überbacken. Wohlfühlessen in 20 Minuten auf dem Tisch. Rezept von Simple Home Edit: https://simplehomeedit.com/recipe/macaroni-and-cheese/",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Kaufe ein Stück Cheddar und reibe ihn selbst. Er schmilzt glatter als fertig geriebener Käse und ist pro Unze günstiger.",
        "Makkaroni in Ellbogenform und Vollmilch von der Hausmarke schmecken hier genauso gut und sparen bei einer Familienportion am meisten.",
        "Lass Hühnerbrühepulver weg, falls du keines hast. Eine gute Prise Salz würzt die Sauce ebenfalls."
      ],
      "substitutions": [
        {
          "forIngredientId": "shredded-cheddar",
          "swap": "Kräftiger Cheddar oder weißer Cheddar für einen würzigeren, etwas raffinierteren Geschmack",
          "savings": "ähnlicher Preis"
        },
        {
          "forIngredientId": "whole-milk",
          "swap": "Milch mit zwei Prozent Fett eignet sich gut und ist etwas leichter",
          "savings": "spart a little"
        },
        {
          "forIngredientId": "panko",
          "swap": "Normales Paniermehl sorgt für denselben goldbraunen Knusper",
          "savings": "Slightly günstiger"
        }
      ],
