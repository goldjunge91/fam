      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Knoblauch, Schalotten, Ingwer, Kurkuma und Koriander zusammen zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Hähnchenschenkel mit der Paste, Salz und Palmzucker ein und überziehe sie gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem tiefen Topf oder Wok auf 325°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hähnchen vorsichtig ins heiße Öl und frittiere es 5 Minuten, bis es leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Hähnchen heraus und stelle es beiseite. Lass 3 tablespoons Öl im Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die restliche Gewürzpaste ins Öl und gare sie 2-3 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Kokosmilch dazu, gib das Hähnchen zurück in den Topf und lass es 20-25 Minuten köcheln, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm das Hähnchen heraus und lege es auf ein Gitter. Erhöhe die Hitze und frittiere es nochmals 3-5 Minuten, bis die Haut knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib zum Schluss Limettensaft darüber und serviere das Hähnchen mit Reis und Sambal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
