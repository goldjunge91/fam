      "steps": [
        {
          "position": 0,
          "text": "Hacke Schalotten und Knoblauch fein und brate sie in 2 tablespoons Öl an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehackfleisch dazu, zerteile es beim Braten und gare es 5-7 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge gewürfelte Karotten und geraspelten Kohl hinzu und gare das Gemüse 3-4 Minuten, bis es leicht weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Sojasauce, Salz und Pfeffer ein und lass die Füllung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ein Lumpia-Teigblatt auf eine ebene Fläche und gib 2 tablespoons Füllung nahe einer Ecke darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle es fest auf und klappe dabei die Seiten ein. Verschließe den Rand mit einem Tropfen Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere die Lumpia portionsweise 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie mit süßer Chilisauce oder Sojasauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
