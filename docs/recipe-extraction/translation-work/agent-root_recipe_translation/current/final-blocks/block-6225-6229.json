      "steps": [
        {
          "position": 0,
          "text": "Röste Chilis, Schalotten und Knoblauch unter dem Grill oder über einer Flamme 3-5 Minuten, bis sie leicht geschwärzt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass alles etwas abkühlen und zerstoße es dann in einem Mörser zu einer stückigen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne, gib die zerstoßene Mischung dazu und rühre 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Garnelenpaste dazu und verrühre alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und rühre Fischsauce, Limettensaft und Palmzucker ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib ganze Kirschtomaten dazu und rühre sie vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Mischung in eine Servierschüssel und serviere sie mit frischem Gemüse und Klebreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
