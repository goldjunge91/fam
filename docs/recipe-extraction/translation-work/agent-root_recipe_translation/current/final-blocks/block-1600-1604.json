        {
          "position": 0,
          "text": "Kalten Reis vom Vortag verwenden. Frischer Reis wird matschig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauch und Zwiebel 2 Minuten in heißem Öl braten. Garnelenpaste dazugeben und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen dazugeben und 3 Minuten garen. Garnelen hinzufügen und 1 Minute braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis dazugeben, flach ausbreiten und 2 Minuten ungestört braten, dann umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kecap Manis und Sojasauce dazugeben und bei starker Hitze vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier separat braten, bis die Ränder knusprig sind. Reis damit und mit Gurkenscheiben servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
