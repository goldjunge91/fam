      "steps": [
        {
          "position": 0,
          "text": "Schweineknochen 2 Minuten in kochendem Wasser blanchieren, dann gründlich abspülen und reinigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "8 Tassen frisches Wasser mit gereinigten Knochen und gehacktem Knoblauch zum Kochen bringen, dann 50 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinehack oder gewürfelten Schweinebauch in einer separaten Pfanne etwa 5 Minuten durchbraten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen in die Brühe geben und etwa 3–4 Minuten rosa garen. Herausnehmen und hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brühe abseihen und zurück in den Topf geben. Gegartes Schweinefleisch und Garnelen dazugeben und mit Fischsauce sowie schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tapiokanudeln nach Packungsanleitung kochen und auf Schalen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiße Brühe und Fleischmischung über die Nudeln schöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Sojasprossen, geschnittenen Frühlingszwiebeln und Koriander belegen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
