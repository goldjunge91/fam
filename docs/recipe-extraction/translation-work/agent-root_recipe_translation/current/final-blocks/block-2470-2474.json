      "steps": [
        {
          "position": 0,
          "text": "Dünne Schweinefleischscheiben mindestens 20 Minuten in Fischsauce, gehacktem Knoblauch und braunem Zucker marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer Pfanne bei starker Hitze erhitzen und mariniertes Schweinefleisch portionsweise etwa 4–5 Minuten karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "4 Tassen Wasser in einem Topf zum Köcheln bringen und Nudeln weich garen; frische Nudeln benötigen etwa 4–5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nudeln abgießen und mit etwas Öl vermengen, damit sie nicht kleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Salat und frische Kräuter auf Serviertellern anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warme Nudeln und karamellisiertes Schweinefleisch darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit zerstoßenen Erdnüssen und gerösteten Sesamsamen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Limette und zusätzlicher Fischsauce als Dip servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
