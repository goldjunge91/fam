      "steps": [
        {
          "position": 0,
          "text": "Fischsauce, gehackten Knoblauch und braunen Zucker vermengen, dann dünne Schweinefleischscheiben mindestens 30 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Währenddessen Karotte und Gurke in feine Streifen schneiden, mit Essig und einer Prise Zucker vermengen und einlegen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Pfanne bei starker Hitze erhitzen und mariniertes Schweinefleisch portionsweise etwa 3–4 Minuten braten, bis es karamellisiert und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Baguettes längs aufschneiden und beide Seiten mit Mayonnaise bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eingelegtes Gemüse, gegartes Schweinefleisch, frischen Koriander und Jalapeñoscheiben in jedes Baguette schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort servieren, solange das Schweinefleisch noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
