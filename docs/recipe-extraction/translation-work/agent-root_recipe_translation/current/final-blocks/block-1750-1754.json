              "source_note": null
            },
            {
              "key": "30426c00-989b-539b-ac0b-99b778a26cb6",
              "ingredientName": "Eier",
              "grams": 50,
              "quantity": 1,
              "unit": "piece",
              "position": 6,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 180°C/350˚F (Ober-/Unterhitze) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib weiche Butter und Zucker in die Schüssel einer Küchenmaschine und schlage sie cremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Mehl und Salz hinzu und knete alles von Hand zu einem glatten Teig. Teile den Teig in zwei Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege eine quadratische oder runde Kuchenform (keine Springform) mit Backpapier aus. Gib die erste Teighälfte hinein und drücke sie mit Fingern und einem Löffel flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile mit einem Teelöffel kleine Kleckse Dulce de leche auf dem Boden. Streue gehackte Schokolade darüber und bedecke alles mit der zweiten Teighälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das ist etwas kniffliger; wenn es nicht perfekt gelingt, keine Sorge, nach dem Backen passt es. Bestreiche den Teig mit verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Kuchen etwa 30 Minuten, bis er goldbraun ist. Er bleibt zunächst weich und wackelig, denn Butterkuchen wird erst beim Abkühlen fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide ihn erst in kleine Stücke, wenn er vollständig abgekühlt ist!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Hinweise",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Aufbewahrung: In einem luftdichten Behälter außerhalb des Kühlschranks etwa 2-3 days, im Kühlschrank 5 days lagern. Bis zu three months einfrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
