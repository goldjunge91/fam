      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200C/fan 180C/gas 6 vor. Brate Zwiebeln und Thymianzweige in Öl etwa 5 mins an, bis sie weich und leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile eine Schicht Kartoffeln auf dem Boden einer geölten 1.5-litre-Gratinform. Streue einige Zwiebeln darüber und schichte weiter, mit einer Kartoffelschicht abschließen. Gieße Brühe darüber und backe den Auflauf 50-60 mins, bis die Kartoffeln gar und die Oberfläche goldbraun und knusprig ist.",
          "timerMinutes": null,
