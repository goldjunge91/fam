      "steps": [
        {
          "position": 0,
          "text": "Legen Sie die Hähnchenbrüste zwischen Plastikfolie und klopfen Sie sie auf eine Dicke von 1 cm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das zerstoßene Hähnchen in Buttermilch und 1 Teelöffel Salz 4 Stunden lang marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Cayennepfeffer, Paprika, schwarzen Pfeffer und Knoblauchpulver in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitzen Sie das Öl in einem Topf mit starkem Boden auf 325 °F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauchen Sie jede Hähnchenbrust in die Mehlmischung und bestreichen Sie sie von allen Seiten gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hähnchen 10-12 Minuten braten, bis es tief goldbraun und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Butter schmelzen und mit der restlichen Gewürzmischung zu einer Glasur verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streichen Sie die heiße Glasur sofort über das Brathähnchen, nachdem Sie es aus dem Öl genommen haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Butterbrötchen mit Krautsalat und Gurken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
