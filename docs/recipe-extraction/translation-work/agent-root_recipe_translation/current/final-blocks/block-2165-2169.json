      ],
      "steps": [
        {
          "position": 0,
          "text": "Vorbereitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Eier, Zucker und abgekühlte geschmolzene Butter in einer Schüssel cremig. Gib dann Honig und Natron hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Hälfte des Mehls und die Walnüsse dazu (du kannst sie ganz oder gemahlen verwenden) und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Mehl hinzu und knete die Mischung mit den Händen, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fette ein großes Backblech mit Olivenöl ein (traditionell wird eine runde Form mit etwa 30cm Durchmesser und 2 - 3 inch Höhe verwendet). Gib den Teig hinein und drücke ihn so an, dass er die gesamte Form ausfüllt. Achte darauf, dass er überall gleichmäßig dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Form auf die unterste Schiene in den kalten Ofen und stelle die Temperatur auf 180 Grad. Backe den Kuchen 35 Minuten, bis der Teig dunkelbraun und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Kuchen aus dem Ofen und lasse ihn abkühlen, während du den Sirup zubereitest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sirup hinzufügen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gib Zucker und Wasser in einen Topf und bringe alles zum Kochen. Lasse es 10 Minuten kochen und rühre gelegentlich um. Nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Schneide Shendetlie in Quadrate oder Rauten und gieße den heißen Sirup darüber. Verwende so viel Sirup, dass der Kuchen bedeckt ist und etwa 1 cm überläuft und oben aufliegt. Er zieht in den Kuchen ein, während dieser vor dem Servieren mindestens 1 hour abkühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
