        },
        {
          "position": 12,
          "text": "Gib Sherry zum Kochen, Austernsoße, Zucker, Essig, Sesamöl, 1 Prise weißen Pfeffer und Sojasoße hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Gib die Garnelen wieder dazu.",
          "timerMinutes": null,
