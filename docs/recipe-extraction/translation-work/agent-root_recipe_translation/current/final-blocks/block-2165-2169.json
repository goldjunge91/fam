      "steps": [
        {
          "position": 0,
          "text": "– REISNUDELN EINWEICHEN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die Reisnudeln über Nacht ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "– REISNUDELN KOCHEN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Nudeln 10-15 Minuten und spüle sie dann mit kaltem Wasser ab, um den Garvorgang zu stoppen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "– GARNELEN MARINIEREN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Garnelen, Ei, 1 Prise weißen Pfeffer, 1 Teelöffel Sesamöl, 1 Esslöffel Maisstärke und 1 Esslöffel Öl in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "– IM WOK BRATEN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib 2 Esslöffel Öl und die Garnelen in einen Wok und brate sie unter Rühren goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Stelle die Garnelen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib 1 Esslöffel Öl in den Wok und anschließend gehackten Knoblauch, Ingwer und das gesamte Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Gib die Nudeln in den Wok.",
