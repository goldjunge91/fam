      "steps": [
        {
          "position": 0,
          "text": "Gib alle Gewürze, Rinderbrühe und Zitronensaft in einen Schmortopf oder Slow Cooker. Verrühre alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Rindfleisch hinzu, wende es darin und löffle etwas Soße darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Topf ab und gare das Fleisch 8-10 hours auf niedriger Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch nach dem Garen heraus und zerteile es mit zwei Gabeln. Entferne überschüssiges Fett.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schöpfe das Fett von der Oberfläche der verbliebenen Flüssigkeit ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische das zerteilte Rindfleisch mit der Soße. Halte es bis zum Servieren warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für den Wrap bestreiche das Pitabrot mit Knoblauchsoße. Belege es mit Rindfleisch und den gewünschten Garnituren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Falte den Wrap wie einen Burrito.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Erhitze eine Grillpfanne und grille den Wrap.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
