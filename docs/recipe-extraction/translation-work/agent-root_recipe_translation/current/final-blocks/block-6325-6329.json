      "steps": [
        {
          "position": 0,
          "text": "Kichererbsenmehl mit 1 Tasse Wasser in einer Schüssel verquirlen, bis eine glatte Masse ohne Klümpchen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die restlichen 2 Tassen Wasser in einem großen Topf mit Salz und Rosmarin zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie die Mehlmischung langsam und unter ständigem Rühren in kochendes Wasser, um Klumpenbildung zu vermeiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze reduzieren und unter häufigem Rühren 20 Minuten köcheln lassen, bis eine sehr dicke Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Masse in eine mit Backpapier ausgelegte 8 × 8 Zoll große Form gießen, auf Zimmertemperatur abkühlen lassen und anschließend 1 Stunde kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die abgekühlte Panissa in Quadrate oder Dreiecke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und gehackten Knoblauch und Zwiebeln 2 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Panissa-Stücke auf beiden Seiten goldbraun und knusprig braten, etwa 3 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit schwarzem Pfeffer würzen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
