          "images": []
        },
        {
          "position": 2,
          "text": "Brühe angießen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelten Fisch, grüne Oliven und Kapern in die Pfanne geben und 8–10 Minuten leicht köcheln lassen, bis der Fisch gar ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
