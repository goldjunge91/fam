      "steps": [
        {
          "position": 0,
          "text": "Getrockneten Kabeljau 24–48 Stunden lang in kaltem Wasser einweichen, dabei alle 8 Stunden das Wasser wechseln, bis er rehydriert und entsalzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Fisch abtropfen lassen und abspülen, dann in Stücke schneiden und alle Gräten entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Schmortopf erhitzen. Geschnittene Zwiebeln und gehackten Knoblauch 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomaten mit Saft dazugeben und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln in 1 Zoll große Würfel schneiden und zusammen mit der Brühe in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fischstücke in die Flüssigkeit geben und Oliven und Kapern hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Leicht köcheln lassen, abdecken und 45–60 Minuten unter gelegentlichem Rühren kochen, bis der Fisch zart und die Kartoffeln sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit frischer Petersilie garnieren und in Schüsseln mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
