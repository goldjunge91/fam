      "steps": [
        {
          "position": 0,
          "text": "Mehl, Anis und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Butter mit Zucker etwa 3 Minuten lang cremig rühren, bis sie leicht und locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eigelb, Weißwein und Vanilleextrakt unterrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Buttermischung unter die Mehlmischung heben, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf einer leicht bemehlten Oberfläche 5 Minuten lang kneten, bis er glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig zwischen Backpapier 0.25 Zoll dick ausrollen und mit einem Glas oder einer Ringform münzförmige Stücke ausstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Drücken Sie dekorative Muster mit einer Gabel oder einem traditionellen Corzetti-Stempel, falls verfügbar, auf Münzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Eiweiß schlagen und leicht auf die Kekse streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf mit Backpapier ausgelegten Blechen bei 350 °F 12–15 Minuten backen, bis die Kekse goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
