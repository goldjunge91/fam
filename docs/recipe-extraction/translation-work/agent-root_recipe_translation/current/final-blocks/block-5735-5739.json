      "steps": [
        {
          "position": 0,
          "text": "Würze die Lammhaxen von allen Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und bräune die Haxen 8 Minuten von allen Seiten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch in den Topf und dünste alles 3 Minuten an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rotwein dazu und löse die Bratrückstände. Gib dann Hühnerbrühe, Tomaten aus der Dose samt Saft und Rosmarinzweige hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Lammhaxen zurück in den Topf und bringe alles zum Kochen. Reduziere die Hitze auf niedrige Stufe, decke den Topf ab und lass das Fleisch 2 Stunden köcheln, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Rosmarinzweige, presse Zitronensaft in den Topf und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Haxen mit der darübergelöffelten Schmorflüssigkeit und Polenta oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
