      ],
      "steps": [
        {
          "position": 0,
          "text": "Schneide die Rinderschulter in 2 Zoll große Würfel und tupfe sie mit Küchenpapier trocken. Würze sie anschließend großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Schmortopf bei mittlerer bis hoher Hitze und bräune das Fleisch portionsweise etwa 4 Minuten pro Seite an. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Zwiebeln in Scheiben und hacke den Knoblauch. Dünste beides im selben Topf 4 Minuten an, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomatenmark und scharfen Senf dazu und rühre 1 Minute ständig um, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Bier und Rinderbrühe dazu und löse die Bratrückstände vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in den Topf und füge Lorbeerblätter und Thymian hinzu. Bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf ab und gare das Gericht bei 325°F im Ofen 60-75 Minuten, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Topf aus dem Ofen, entferne die Lorbeerblätter, schmecke ab und würze nach. Serviere das Gericht auf Eiernudeln oder mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
