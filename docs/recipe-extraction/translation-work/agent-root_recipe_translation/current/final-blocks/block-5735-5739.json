      "steps": [
        {
          "position": 0,
          "text": "Würze die Short Ribs mit Salz und Pfeffer und wende sie leicht in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Schmortopf bei mittlerer bis hoher Hitze und brate die Rippchen rundherum an, bis sie gebräunt sind. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Zwiebel, Karotten und Sellerie in den Topf und dünste alles 5 Minuten an, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Gib dann Wein und Rinderbrühe dazu und löse die Bratrückstände vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Rippchen zurück in den Topf, setze den Deckel auf und stelle den Topf in den auf 325°F vorgeheizten Ofen. Schmore das Fleisch 2.5-3 Stunden, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf aus dem Ofen und schöpfe das Fett von der Oberfläche der Schmorflüssigkeit ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Rippchen mit Gemüse und Schmorflüssigkeit auf Kartoffelpüree oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
