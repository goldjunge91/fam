      "steps": [
        {
          "position": 0,
          "text": "Vermische braunen Zucker, Paprikapulver, Knoblauchpulver, Salz, Pfeffer und Zwiebelpulver in einer Schüssel zu einer Trockenmarinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Schweineschulter großzügig von allen Seiten mit der Gewürzmischung ein und lass sie 1 Stunde bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche die Holzchips 30 Minuten in Wasser ein, gib sie dann in den Räucherofen und heize ihn auf 225°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Schweineschulter auf den Rost und räuchere sie 6-8 Stunden. Halte die Temperatur konstant und gib jede Stunde Holzchips nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wickle die Schulter fest in Folie und lege sie für die letzten 2 Stunden zurück in den Räucherofen, bis die Kerntemperatur 190°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Fleisch aus dem Räucherofen und lass es 20 Minuten ruhen, bevor du es mit zwei Gabeln zerpflückst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische das zerpflückte Fleisch zum Servieren mit Apfelessig und Hühnerbrühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
