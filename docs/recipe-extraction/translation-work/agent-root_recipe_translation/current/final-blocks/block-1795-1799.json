          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Sahne, Brühe und Hörnchennudeln dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gare alles bei niedriger Hitze 20 Minuten. Gib den Käse dazu und rühre um, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit gerösteter Paprika und Petersilie bestreuen.",
