      "steps": [
        {
          "position": 0,
          "text": "Erhitze Hühnerbrühe in einem Topf mit Deckel. Gib Hähnchenbrust dazu und bringe die Brühe zum sanften Köcheln. Decke den Topf ab und gare das Fleisch 10 Minuten. Nimm die Hähnchenbrüste mit einer Zange heraus und lege sie auf einen Teller. Gieße die Kochflüssigkeit in einen großen Messbecher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmelze 25g/1oz Butter in einem großen Topf mit schwerem Boden bei niedriger Hitze. Rühre Lauch ein und brate ihn zwei Minuten sanft unter gelegentlichem Rühren, bis er weich ist. Gib Knoblauch dazu und gare ihn eine weitere Minute. Füge die restliche Butter hinzu und rühre Mehl ein, sobald die Butter geschmolzen ist. Gare alles 30 seconds unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Milch langsam portionsweise hinzu und rühre nach jeder Zugabe gut um. Gib nach und nach 250ml/10fl oz der beiseitegestellten Brühe und Wein nach Wunsch hinzu und rühre, bis die Sauce glatt und leicht eingedickt ist. Sanft köcheln und 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze nach Geschmack mit Salz und frisch gemahlenem schwarzem Pfeffer. Nimm den Topf vom Herd und rühre Sahne ein. Gieße die Sauce in eine große Schüssel und decke die Oberfläche mit Frischhaltefolie ab, damit sich keine Haut bildet. Lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 200C/400F/Gas 6 vor. Stelle ein Backblech zum Aufheizen hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für den Teig Mehl und Butter in einer Küchenmaschine zu feinen Streuseln verarbeiten. Bei laufendem Gerät verquirltes Ei und Wasser hinzufügen und mixen, bis sich eine Teigkugel bildet. 250g/10oz Teig für den Deckel beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rolle den restlichen Teig auf leicht bemehlter Fläche unter häufigem Drehen auf etwa 5mm/¼in Dicke und 4cm/1½in größer als die Pieform aus. Hebe ihn über das Nudelholz in die Form und drücke ihn fest an den Rand, ohne Luftblasen zu lassen. Teig über den Rand hängen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide die Hähnchenbrüste in 3cm/1¼in große Stücke. Rühre Hähnchen, Schinken und Lauch unter die abgekühlte Sauce. Fülle die Mischung in die Pieform und bestreiche den Rand mit verquirltem Ei. Rolle den beiseitegelegten Teig für den Deckel aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Decke den Pie mit dem Teigdeckel ab und drücke die Ränder fest zusammen. Schneide überschüssigen Teig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schneide mit einem Messer ein kleines Loch in die Mitte. Bestreiche die Oberfläche mit verquirltem Ei. Backe den Pie auf dem vorgeheizten Blech mittig im Ofen 35-40 Minuten, bis er rundum goldbraun und die Füllung sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
