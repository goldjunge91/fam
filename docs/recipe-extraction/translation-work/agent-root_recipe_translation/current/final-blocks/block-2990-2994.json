      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 450°F vor und verteile Steinsalz auf einem Backblech als Unterlage für die Austern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 EL Butter in einer Pfanne bei mittlerer Hitze und dünste Spinat, Petersilie, Frühlingszwiebeln und Knoblauch 3 Minuten, bis alles zusammenfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Pfanne vom Herd, rühre Semmelbrösel und Parmesan ein und lasse die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ordne die Austernschalen auf dem Steinsalz an und gib auf jede Auster etwa 1 EL Spinatmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Setze auf jede Auster ein kleines Stück der übrigen Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Austern 10-12 Minuten, bis der Belag goldbraun und die Austern durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß direkt auf dem Steinsalz mit Zitronenspalten als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
