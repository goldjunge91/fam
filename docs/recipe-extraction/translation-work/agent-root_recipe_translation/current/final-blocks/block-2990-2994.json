      "steps": [
        {
          "position": 0,
          "text": "Schmilz 4 EL Butter in einer großen Pfanne bei mittlerer Hitze und dünste gewürfelte Zwiebel, Sellerie und Paprika 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch hinzu und gare ihn 1 Minute, bis er duftet. Rühre dann Tomatensauce und Cayennepfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe hinzu und bringe alles zum Köcheln. Koche die Sauce ohne Deckel 15 Minuten, damit sie leicht reduziert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Flusskrebsschwanzfleisch und die übrigen 2 EL Butter hinzu und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles 5 Minuten köcheln, bis die Flusskrebse durchgewärmt sind und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre den Großteil der Frühlingszwiebeln ein und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht auf gekochtem Reis und garniere es mit den übrigen Frühlingszwiebeln.",
