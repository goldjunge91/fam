      ],
      "steps": [
        {
          "position": 0,
          "text": "Löse die Flusskrebse aus und lege Schwänze und Schalen getrennt beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 EL Butter in einem großen Topf bei mittlerer Hitze und gare die Flusskrebsschalen 5 Minuten unter gelegentlichem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel, Sellerie und Knoblauch hinzu und dünste alles 5 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Gieße dann Hühnerbrühe hinzu und gib das Lorbeerblatt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lasse die Brühe 30 Minuten köcheln, damit sie den Geschmack der Flusskrebse aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seihe die Brühe durch ein feinmaschiges Sieb ab und entsorge Schalen und Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmilz im selben Topf die übrigen 3 EL Butter und rühre Mehl zu einer Mehlschwitze ein. Gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die abgeseihte Brühe unter Rühren langsam hinzu, damit sich keine Klumpen bilden. Gib Flusskrebsschwänze, Sahne und Cayennepfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse alles 10 Minuten köcheln, bis die Schwänze durchgewärmt und die Bisque eingedickt ist. Serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
