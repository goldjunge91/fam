      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Paprikapulver, Cayennepfeffer, Knoblauchpulver, Zwiebelpulver, getrockneten Thymian, schwarzen Pfeffer und Salz in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe die Lachsfilets mit Küchenpapier trocken und bestreiche beide Seiten großzügig mit der Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Butter in einer gusseisernen Pfanne bei mittlerer bis hoher Hitze, bis sie gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Lachsfilets vorsichtig in die Pfanne und gare die erste Seite 3-4 Minuten, ohne sie zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende die Filets und gare die zweite Seite weitere 3-4 Minuten, bis die Haut angekohlt und das Fleisch undurchsichtig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den Lachs auf einen Servierteller und serviere ihn sofort mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
