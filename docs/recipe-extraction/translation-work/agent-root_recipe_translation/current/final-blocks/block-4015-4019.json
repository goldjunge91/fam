      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch in 1½-inch große Würfel schneiden und Kartoffeln, Karotten sowie Zwiebeln grob würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen großen Eisentopf oder schweren Schmortopf bei mittelhoher bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rindfleisch portionsweise anbräunen, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Im selben Topf Zwiebeln und Knoblauch 3 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rindfleisch zurück in den Topf geben und Rinderbrühe, Salz, Pfeffer und Lorbeerblätter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann abdecken, Hitze reduzieren und 45 Minuten köcheln lassen, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kartoffeln und Karotten hinzufügen und 20 Minuten köcheln lassen; dann Kohl dazugeben und weitere 10 Minuten garen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß direkt aus dem Topf oder in Schüsseln servieren.",
