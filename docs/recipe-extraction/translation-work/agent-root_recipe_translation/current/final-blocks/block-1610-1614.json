          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stecke das Hähnchen auf Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für die Erdnusssauce: Verrühre Erdnussbutter, Kokosmilch, Sojasauce, Limette, Knoblauch, Palmzucker und Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille die Spieße oder brate sie auf jeder Seite 3 Minuten an, bis sie leicht angekohlt sind.",
