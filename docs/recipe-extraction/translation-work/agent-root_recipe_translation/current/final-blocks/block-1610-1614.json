      "steps": [
        {
          "position": 0,
          "text": "Verrühre trockene Zutaten in einer Schüssel und flüssige Zutaten in einer anderen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die flüssigen Zutaten zu den trockenen und rühre nur, bis sie sich verbinden. Klümpchen sind in Ordnung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass den Teig 5 Minuten ruhen. Erhitze eine Grillplatte auf mittlerer Hitze und bestreiche sie mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib je ¼ Tasse Teig für einen Pancake auf die Grillplatte. Backe ihn, bis Blasen entstehen und die Ränder fest aussehen (2–3 Minuten). Wende ihn einmal und backe ihn 1 Minute weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Pancakes sofort – sie fallen schnell zusammen. Mit Ahornsirup und zusätzlicher Butter servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
