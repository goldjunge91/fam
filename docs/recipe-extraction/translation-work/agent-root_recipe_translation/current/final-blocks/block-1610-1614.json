      "steps": [
        {
          "position": 0,
          "text": "Würfle die Kartoffel klein und gare sie 12 Minuten in Öl, bis sie knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Wurst in derselben Pfanne und nimm sie heraus. Dünste Zwiebel und Paprika 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kartoffeln und Wurst zurück in die Pfanne. Rühre die Eier unter und gare sie, bis sie gerade gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die Tortillas. Fülle sie mit der Eiermischung und gib Käse und Salsa darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle die Burritos fest auf und brate sie auf jeder Seite 1 Minute in der Pfanne an, damit sie sich schließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
