      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und brate die gewürfelte Zwiebel etwa 6 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und rühre 1 Minute ständig, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Currypulver und Tomatenmark ein und röste die Gewürze 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Hähnchenwürfel in den Topf und vermenge sie mit der Currymischung. Gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Kokosmilch in den Topf und bringe alles sanft zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf mittelniedrig und lasse das Curry ohne Deckel 30–35 Minuten köcheln, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre frischen Spinat und Salz ein und gare alles 2–3 Minuten, bis der Spinat zusammenfällt. Serviere das Curry mit Basmatireis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
