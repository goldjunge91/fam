      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl auf einer großen flachen Grillplatte oder in einer Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Chorizoscheiben in einer Lage auf die Grillplatte und brate sie auf jeder Seite 2–3 Minuten, bis sie gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe die Chorizo zur Seite, gib gehackten Knoblauch in die Mitte und rühre 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein über die Chorizo und lasse alles 3–4 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Brotscheiben auf der Grillplatte auf jeder Seite 1 Minute goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze die Chorizomischung mit Salz, Pfeffer und geräuchertem Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere Chorizo und Sauce auf geröstetem Brot und garniere alles mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
