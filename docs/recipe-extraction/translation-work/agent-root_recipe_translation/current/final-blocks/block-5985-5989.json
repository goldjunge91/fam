      "steps": [
        {
          "position": 0,
          "text": "Röste die getrockneten Chilis 1–2 Minuten in einer trockenen Pfanne. Weiche sie anschließend 15 Minuten in heißem Wasser ein und püriere sie zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und bräune die Rindfleischwürfel portionsweise auf jeder Seite 3–4 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und dünste die gewürfelte Zwiebel und den Knoblauch etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Fleisch zurück in den Topf und füge Chilipaste, Kreuzkümmel, Oregano, Salz und schwarzen Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Rinderbrühe in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse das Chili 1.5-2 Stunden köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und passe die Würzung bei Bedarf an. Serviere das Chili heiß in Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
