      "steps": [
        {
          "position": 0,
          "text": "Schneide die Zwiebeln in dünne Scheiben. Gare sie mit einer Prise Zucker bei mittelniedriger Hitze 40 Minuten in Butter und rühre alle 5 Minuten um, bis sie dunkelgolden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den Wein dazu und lass ihn 2 Minuten einkochen. Rühre Mehl ein und gare es 1 Minute. Gib Brühe, Thymian und Lorbeerblatt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass die Suppe 10 Minuten köcheln und würze sie kräftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schöpfe die Suppe in ofenfeste Schalen, belege sie mit Brot und Gruyère und grille sie 3-4 Minuten, bis der Käse blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
