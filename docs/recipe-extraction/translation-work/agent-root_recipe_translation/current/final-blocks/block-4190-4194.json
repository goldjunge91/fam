      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und bräune die Rindfleischwürfel von allen Seiten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste im selben Topf Zwiebel und Knoblauch weich. Gib Sofrito hinzu und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch zurück in den Topf. Füge Tomatensauce, Salz, Kreuzkümmel und 1 Tasse Wasser hinzu. Lasse alles 45 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Oliven und Rosinen unter und gare alles weitere 5 Minuten. Lasse die Füllung vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erweiche die Kochbananenblätter, indem du sie kurz über eine Flamme hältst oder in heißes Wasser tauchst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege ein Kochbananenblatt flach hin, gib 2 Esslöffel Teig in die Mitte und darauf 2 Esslöffel Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klappe die Ränder des Blatts über die Füllung zu einem Päckchen und wickle es anschließend in ein zweites Blatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Binde die Päckchen mit Küchengarn oder dünnen Streifen von Kochbananenblättern zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Koche die Hallacas 40 Minuten in einem großen Topf mit Salzwasser und halte sie dabei unter Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Nimm sie mit einer Schaumkelle heraus, lasse sie abtropfen und serviere sie heiß mit zusätzlicher Brühe oder Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
