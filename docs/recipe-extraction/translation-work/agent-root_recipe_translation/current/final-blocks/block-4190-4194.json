      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Butter in kleine Würfel und arbeite sie in das Mehl ein, bis die Mischung Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eigelb und Wasser, gib sie zur Mehlmischung und verrühre alles zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knete den Teig 2 Minuten, wickle ihn in Folie und stelle ihn 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig zwischen Folien sehr dünn, etwa 1/16-inch dick, aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide den Teig in 2-inch by 4-inch große Rechtecke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege einen Käsestick an den Rand jedes Rechtecks und rolle ihn fest ein. Versiegle den Rand mit etwas Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze Öl auf 350°F und frittiere die Tequeños pro Seite etwa 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit Pfeffersauce oder scharfer Sauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
