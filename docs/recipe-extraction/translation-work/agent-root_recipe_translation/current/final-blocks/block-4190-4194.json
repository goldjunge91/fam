          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Sofrito, Tomatensauce, Oliven und Rosinen hinzu. Lasse alles 10 Minuten köcheln und dann leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Fleischmischung gleichmäßig in der vorbereiteten Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eier, Milch, Mehl, Salz und schwarzen Pfeffer zu einer glatten Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Eiermischung über die Fleischschicht und verteile sie gleichmäßig bis zum Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue geriebenen Käse darüber.",
