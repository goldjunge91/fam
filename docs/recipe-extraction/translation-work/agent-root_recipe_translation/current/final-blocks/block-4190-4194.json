      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste Zwiebel, Knoblauch und rote Paprika 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Sofrito hinzu und gare es 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre den Reis ein und gare ihn unter häufigem Rühren 2 Minuten, damit er mit Öl überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe hinzu und gib abgetropfte Taubenerbsen, Oliven, Salz und Pfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze auf niedrig, decke den Topf ab und lasse es 18-20 Minuten köcheln, bis der Reis gar und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lockere den Reis mit einer Gabel auf und serviere ihn heiß.",
          "timerMinutes": null,
