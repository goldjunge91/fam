      "steps": [
        {
          "position": 0,
          "text": "Koche Kartoffeln weich, schäle und zerdrücke sie in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die zerdrückten Kartoffeln mit Joghurt, gehackten grünen Chilischoten, Koriander, Ingwer-Knoblauch-Paste, Kreuzkümmel, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle die Mischung 15 Minuten kalt, bis sie fest genug zum Formen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme daraus ovale Kebabs und wälze sie in Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher bis hoher Hitze und brate die Kebabs flach, bis sie rundherum goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Minz-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
