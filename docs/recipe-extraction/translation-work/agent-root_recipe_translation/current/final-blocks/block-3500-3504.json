      "steps": [
        {
          "position": 0,
          "text": "Vermische Hackfleisch, fein gehackte Zwiebeln, Ingwer-Knoblauch-Paste, grüne Chilischote, Koriander, Minze und Garam Masala in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib verquirltes Ei und Salz dazu und knete die Mischung zu einer klebrigen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Mischung in 6-8 gleich große Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Befeuchte deine Hände und forme jede Portion fest um einen Metallspieß zu einer länglichen Rolle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen Pfanne oder Tawa bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Spieße vorsichtig ins heiße Öl und wende sie gelegentlich. Brate sie 10-12 Minuten, bis alle Seiten goldbraun und das Fleisch gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schiebe die Kebabs von den Spießen auf eine Servierplatte und serviere sie heiß mit Zwiebelscheiben, Zitronenspalten und Minz-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
