      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste gewürfelte Zwiebel und Knoblauch etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittene Jalapeño, Kreuzkümmel und Lorbeerblatt dazu und gare alles 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Dosentomaten samt Saft hinein und bringe alles zum Köcheln. Gib Oliven und Kapern dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Fischfilets in die Sauce und reduziere die Hitze auf mittelniedrig. Decke die Pfanne ab und lass alles 10-12 Minuten köcheln, bis der Fisch undurchsichtig ist und leicht auseinanderfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Presse frischen Limettensaft über den Fisch und probiere die Sauce. Passe Salz nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere den Fisch mit warmer Tomaten-Oliven-Sauce und Bratensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
