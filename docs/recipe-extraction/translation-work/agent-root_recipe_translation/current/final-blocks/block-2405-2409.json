      "steps": [
        {
          "position": 0,
          "text": "Schäle Kochbananen, indem du die Enden abschneidest und die Schale längs einritzt. Schneide sie dann in 1-inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer Pfanne bei mittelhoher Hitze und brate die Kochbananenstücke 3-4 Minuten pro Seite goldbraun und weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Kochbananen mit einer Schaumkelle heraus und lass sie auf Küchenpapier abtropfen. Bewahre das Öl auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerstoße Knoblauch und Salz in einem Mörser zu einer Paste. Gib die gebratenen Kochbananen dazu und zerdrücke sie, bis die Mischung stückig, aber verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das beiseitegestellte Knoblauchöl in einem kleinen Topf und gieße es unter vorsichtigem Unterheben über die Mofongo-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Hühnerbrühe separat und serviere den Mofongo-Hügel in einer Schüssel mit warmer Brühe zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
