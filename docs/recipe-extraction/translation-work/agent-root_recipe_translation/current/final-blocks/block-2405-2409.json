      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne von Guajillo- und Ancho-Chilis und röste sie 1 Minute in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die gerösteten Chilis in 1 cup Wasser 5 Minuten, bis sie weich sind. Püriere sie dann mit Knoblauch, Essig, Kreuzkümmel und Oregano zu einer glatten Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Schweineschulter in 1/4-inch dicke Scheiben und bedecke sie vollständig mit der Chilisauce. Stelle sie mindestens 30 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze und brate das marinierte Schweinefleisch portionsweise 3-4 Minuten pro Seite, bis es gebräunt und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide frische Ananas in kleine Stücke und erwärme sie während der letzten 2 Minuten Garzeit mit dem Fleisch in derselben Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle jede Tortilla mit Schweinefleisch-Ananas-Mischung, gewürfelter Zwiebel und frischem Koriander.",
