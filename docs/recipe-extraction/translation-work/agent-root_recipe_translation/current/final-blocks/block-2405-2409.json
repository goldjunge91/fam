      "steps": [
        {
          "position": 0,
          "text": "Bringe einen kleinen Topf Wasser zum Kochen und gib die Eier vorsichtig hinein. Lass sie 6-7 Minuten köcheln, wenn sie weichgekocht sein sollen. Schrecke sie in Eiswasser ab und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Brühe in einem großen Topf bis zum Köcheln. Gib Knoblauch, Ingwer, Sojasauce, Mirin und Sake dazu und gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche Ramen-Nudeln nach Packungsanweisung in einem separaten Topf. Gieße sie ab und verteile sie auf Servierschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße heiße Brühe über die Nudeln in den Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jede Schale mit einem halbierten weichgekochten Ei, Frühlingszwiebeln, Sojasprossen und Nori-Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort servieren, solange die Brühe heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
