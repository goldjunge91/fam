      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in kleine Würfel und grüne Bohnen in 1 Zoll lange Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salzwasser in einem großen Topf aufkochen, Kartoffeln hinzufügen und 3 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grüne Bohnen mit den Kartoffeln in den Topf geben und weitere 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trofie-Nudeln in denselben Topf geben und nach Packungsanweisung al dente kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während die Nudeln kochen, bereiten Sie Pesto zu, indem Sie Basilikum, Knoblauch und Pinienkerne vermischen, langsam Olivenöl hinzufügen und dann den Käse unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Abgießen 1 Tasse Nudelwasser aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die abgetropften Nudeln und das Gemüse wieder in den Topf geben, Pesto und 1/2 Tasse Nudelwasser hinzufügen und vorsichtig umrühren.",
          "timerMinutes": null,
