      "steps": [
        {
          "position": 0,
          "text": "Darm und Leber unter fließendem Wasser gründlich reinigen. Den Darm 3 Minuten blanchieren und in 2 Zoll lange Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Leber fein würfeln und mit gehackter Petersilie, Knoblauch, Pecorino Romano, Salz und schwarzem Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aus der Mischung kleine Kugeln formen, jedes mit Darmstücken umwickeln und mit Fleischergarn fixieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einem großen Topf erhitzen und Cordula-Bündel darin von allen Seiten 5–7 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Cordula herausnehmen und die gewürfelten Zwiebeln im selben Topf anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Cordula zurück in den Topf geben, Weißwein und Tomatensauce hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Unter gelegentlichem Rühren zugedeckt 1.5 bis 2 Stunden köcheln lassen, bis Cordula sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entfernen Sie das Garn und servieren Sie es heiß mit knusprigem Brot und zusätzlichem geriebenem Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
