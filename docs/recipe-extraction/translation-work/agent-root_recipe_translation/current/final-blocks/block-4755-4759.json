          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege 4 Scheiben Jamón Ibérico auf die untere Brothälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geschnittenen Manchego und geröstete rote Paprika auf den Schinken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze mit einer Prise Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe die obere Baguettehälfte darauf und drücke das Sandwich leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide es in zwei Portionen und serviere es sofort.",
