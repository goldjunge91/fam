      "steps": [
        {
          "position": 0,
          "text": "Lass die Butter in einem Topf bei niedriger Hitze schmelzen und gib den gehackten Knoblauch dazu. Dünste ihn etwa 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Sahne dazu und lass sie sanft köcheln. Rühre langsam den geriebenen Pecorino Romano und grob gemahlenen schwarzen Pfeffer ein, bis die Sauce glatt und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmecke die Sauce mit Salz ab und nimm sie vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide das Focaccia-Brot waagerecht auf und lege Prosciutto auf die untere Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die warme Cacio-e-Pepe-Sauce über den Prosciutto und lege die obere Brothälfte darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze eine Panini-Presse oder Pfanne auf mittelhohe Hitze und grille das Sandwich 3-4 Minuten pro Seite, bis das Brot goldbraun und der Käse heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
