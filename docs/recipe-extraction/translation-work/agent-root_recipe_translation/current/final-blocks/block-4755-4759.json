      "steps": [
        {
          "position": 0,
          "text": "Ritze die Schwarte des Schweinefleischs kreuzweise ein und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Rosmarin, Salbei und Knoblauch zusammen und vermenge sie mit 2 tbsp Olivenöl, Fenchelsamen, Salz und Pfeffer zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Kräutermischung unter und auf die Schwarte. Rolle das Fleisch fest auf und binde es in Abständen von 2-inch mit Küchengarn zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Braten in eine Bratform, reibe die Schwarte mit dem übrigen 1 tbsp Olivenöl und Salz ein und röste ihn bei 450°F 30 Minuten, bis die Schwarte zu knuspern beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf 325°F und röste den Braten weitere 3.5-4 Stunden, bis eine Kerntemperatur von 190°F erreicht ist und die Schwarte sehr knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass den Braten 15 Minuten ruhen, schneide ihn dann dünn auf und serviere ihn auf gerösteten Ciabatta-Brötchen mit frischem Fenchelgrün.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse vor dem Servieren Zitronensaft über das Fleisch.",
