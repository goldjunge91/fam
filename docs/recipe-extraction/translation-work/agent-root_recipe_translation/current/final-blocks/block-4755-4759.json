      "steps": [
        {
          "position": 0,
          "text": "Lege die Hähnchenbrustfilets zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 1/4-inch Dicke flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: Fülle Mehl in die erste, verquirlte Eier in die zweite und Panko-Semmelbrösel mit Salz und Pfeffer in die dritte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Hähnchenfilet zuerst in Mehl, tauche es dann in Ei und überziehe es anschließend vollständig mit den gewürzten Panko-Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und brate das panierte Hähnchen 3-4 Minuten pro Seite, bis es goldbraun und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass es auf Küchenpapier abtropfen und schneide jedes Milanesa nach Wunsch in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide die Brötchen auf und bestreiche beide Hälften mit Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege Salat und Tomate auf die untere Hälfte, gib das Milanesa darauf und klappe die obere Hälfte zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
