              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Koche rote Linsen in 1.5 Tassen Wasser 12 Minuten, bis sie gerade weich sind. Gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Kartoffeln in 1 inch große Stücke. Erhitze Öl, gib Kreuzkümmelsamen (oder gemahlenen Kreuzkümmel) dazu und röste sie 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Zwiebel, Knoblauch und Ingwer dazu und gare alles 5 Minuten. Gib die übrigen Gewürze und gewürfelten Tomaten dazu und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kartoffelwürfel und ¼ Tasse Wasser dazu. Decke die Pfanne ab und dünste alles 12 Minuten, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die gekochten Linsen unter und erhitze alles 2 Minuten. Garniere das Gericht mit Koriander und serviere es mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
