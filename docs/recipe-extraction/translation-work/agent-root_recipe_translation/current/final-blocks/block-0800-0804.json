      "steps": [
        {
          "position": 0,
          "text": "Brate fein gewürfelte Zwiebel 8 Minuten in Olivenöl an, bis sie kräftig goldbraun ist. Sie bildet die Grundlage des Aromas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch und Ingwer dazu und gare alles 2 Minuten. Gib alle gemahlenen Gewürze und das Tomatenmark dazu und röste alles 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die gehackten Tomaten dazu und lass sie 5 Minuten köcheln. Gieße die Kidneybohnen ab und gib sie dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass alles 15 Minuten köcheln. Zerdrücke etwa ¼ der Bohnen am Topfrand, damit die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre zum Schluss Garam Masala und Koriander ein. Serviere das Curry auf Basmatireis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
