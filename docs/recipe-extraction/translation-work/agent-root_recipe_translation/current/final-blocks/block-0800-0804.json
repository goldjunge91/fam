      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in große Stücke. Verrühre Joghurt, Garam Masala, Kreuzkümmel, Paprikapulver, Kurkuma, Knoblauch, Ingwer und Zitronensaft zu einer Tikka-Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bedecke das Hähnchen vollständig mit der Marinade. Lass es 10 Minuten (oder über Nacht für ein intensiveres Aroma) marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke das Fleisch auf Spieße oder verteile es auf einem mit Backpapier ausgelegten Blech. Grille es 8–10 Minuten und wende es nach der Hälfte der Zeit, bis die Ränder gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite die Raita zu: Verrühre den übrigen Joghurt mit gewürfelter Gurke, einer Prise Kreuzkümmel und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere das Tikka auf Reis mit Raita und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
