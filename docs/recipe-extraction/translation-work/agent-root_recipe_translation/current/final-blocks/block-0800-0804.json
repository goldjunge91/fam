      "steps": [
        {
          "position": 0,
          "text": "Schneide Hähnchenoberkeulen in Stücke. Würze sie mit Salz, einer Prise Kurkuma und Garam Masala.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Hähnchen 5–6 Minuten in Olivenöl an. Nimm es aus der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Zwiebel 5 Minuten an. Gib Knoblauch, Ingwer, Kreuzkümmel und die übrigen Gewürze dazu und gare alles 2 Minuten. Gib Tomaten dazu und gare alles 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib aufgetauten Spinat dazu und püriere die gesamte Soße mit einem Stabmixer, bis sie glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in die Pfanne. Lass es 10 Minuten in der Saag-Soße köcheln. Serviere das Gericht auf Reis mit Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
