      "steps": [
        {
          "position": 0,
          "text": "Spüle den Jasminreis unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Reis, Kokosmilch, Wasser, Salz und Zucker in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze, decke den Topf ab und lass den Reis 18-20 Minuten köcheln, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide währenddessen die Gurke in dünne Scheiben und halbiere die Kirschtomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hacke den Koriander und die Frühlingszwiebeln und schneide die Limette in Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lockere den gekochten Reis mit einer Gabel auf und verteile ihn auf Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Bowl mit Gurkenscheiben, Tomaten, Koriander und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Bowls mit Limettenspalten zum Darüberpressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
