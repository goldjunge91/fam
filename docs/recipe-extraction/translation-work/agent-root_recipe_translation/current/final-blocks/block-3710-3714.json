      "steps": [
        {
          "position": 0,
          "text": "Erhitze 3 tablespoons Olivenöl in einem großen Topf bei mittlerer Hitze und dünste geschnittenen Knoblauch etwa 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Tomaten aus der Dose samt Saft und rote Chiliflocken dazu und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Gemüsebrühe dazu und bringe alles zum sanften Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Brotwürfel in den Topf und rühre häufig um. Gare sie 10 Minuten, bis das Brot weich ist und Flüssigkeit aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerdrücke etwas Brot und Tomaten mit der Löffelrückseite, sodass eine dicke, breiartige Konsistenz entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die übrigen 2 tablespoons Olivenöl und gezupftes Basilikum ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe heiß oder bei Raumtemperatur und bestreue sie mit geriebenem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
