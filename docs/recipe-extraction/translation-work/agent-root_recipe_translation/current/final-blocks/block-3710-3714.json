      "steps": [
        {
          "position": 0,
          "text": "Röste Brotscheiben goldbraun, reibe sie mit Knoblauch ein und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 4 tablespoons Olivenöl in einem großen Topf bei mittlerer Hitze und dünste gehackten Knoblauch 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Tomaten dazu und gare sie unter gelegentlichem Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Brühe dazu und bringe alles zum Kochen. Gib dann Spinat und frische Kräuter hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme vier Mulden in der Brühe und schlage je ein Ei hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles sanft 4 Minuten köcheln, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege je eine geröstete Brotscheibe in eine Schüssel, gieße Suppe darüber, beträufle sie mit dem restlichen Olivenöl, würze mit Salz und Pfeffer und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
