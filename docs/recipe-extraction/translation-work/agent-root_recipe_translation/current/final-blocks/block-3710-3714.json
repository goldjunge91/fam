      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste gewürfelte Zwiebel, Karotten, Sellerie und Knoblauch 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zucchini, gehackten Kohl und Tomaten aus der Dose dazu und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Gemüsebrühe dazu und bringe alles zum Kochen. Reduziere die Hitze und lasse es 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib abgespülte, abgetropfte weiße Bohnen dazu und lasse alles weitere 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre frisches Basilikum ein, probiere die Suppe und würze sie nach Bedarf mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie heiß in Schalen, mit geriebenem Parmesan und etwas Olivenöl darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
