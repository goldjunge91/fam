      "steps": [
        {
          "position": 0,
          "text": "Schneide das Schweinefleisch in 2-inch große Stücke und würze es großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Schmortopf bei mittelhoher bis hoher Hitze und bräune das Fleisch portionsweise insgesamt etwa 12 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und dünste gewürfelte Zwiebel, Karotten und Sellerie etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche dann mit Rotwein ab und löse die Röstspuren vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Fleisch zurück in den Topf und füge Rinderbrühe, Lorbeerblätter und Rosmarinzweige hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Köcheln, decke den Topf ab und schmoren es im Ofen bei 325°F 2 Stunden. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf aus dem Ofen, entferne Lorbeerblätter und Rosmarin und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß mit knusprigem Brot oder Polenta.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
