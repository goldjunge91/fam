      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 400 °F vor und legen Sie den Tortenboden in eine 9-Zoll-Kuchenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne schmelzen und gewürfelte Zwiebeln und Sellerie 4 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wenn die Jakobsmuscheln groß sind, halbieren Sie sie, geben Sie sie in die Pfanne und braten Sie sie auf jeder Seite 2 Minuten lang, bis sie glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl über die Jakobsmuschelmischung streuen und umrühren, dann 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fischbrühe und Weißwein hinzufügen und 3 Minuten köcheln lassen, bis die Flüssigkeit leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und Sahne, gefrorene Erbsen und Dill unterrühren, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gießen Sie die Jakobsmuschelmischung in den Tortenboden und bedecken Sie ihn dann mit dem zweiten Boden oder formen Sie einen Gitterboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreichen Sie die obere Kruste mit Eigelb, schneiden Sie Löcher hinein und backen Sie sie dann 25 bis 30 Minuten lang, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
