      "steps": [
        {
          "position": 0,
          "text": "2 Esslöffel Butter in einem großen Topf schmelzen und gewürfelte Zwiebeln, Sellerie und Karotten 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomatenmark hinzufügen und unter ständigem Rühren 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hummerschalen hinzufügen und 3 Minuten lang rösten, dann Brandy hinzufügen und vorsichtig anzünden, um den Alkohol zu verbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischbrühe und Lorbeerblatt hinzufügen und dann 20 Minuten köcheln lassen, um den Schalengeschmack zu entziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Mischung durch ein feinmaschiges Sieb passieren und dabei auf die Feststoffe drücken, um die gesamte Flüssigkeit zu extrahieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie die abgesiebte Flüssigkeit zurück in den Topf, fügen Sie Sahne hinzu und erhitzen Sie sie dann sanft, ohne zu kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einer separaten Pfanne die restliche Butter schmelzen und das Hummerfleisch 3 Minuten lang anbraten, bis es gerade gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gekochtes Hummerfleisch zum Biskuit geben, mit Salz und Cayennepfeffer würzen und heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
