      "steps": [
        {
          "position": 0,
          "text": "Garen Sie die Makkaroni nach Packungsanweisung, lassen Sie sie dann abtropfen und spülen Sie sie mit kaltem Wasser ab, bis sie abgekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Karotte und Sellerie fein würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer großen Schüssel Mayonnaise, Zucker und Reisessig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abgekühlte Makkaroni, gewürfelte Karotten und gewürfelten Sellerie zum Dressing geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vorsichtig umrühren, bis alle Zutaten gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren mindestens 30 Minuten in den Kühlschrank stellen, damit sich die Aromen vermischen können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
