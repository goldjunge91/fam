      "steps": [
        {
          "position": 0,
          "text": "Würfle die Hälfte der Zwiebel fein und vermische sie mit Rinderhackfleisch, Ingwer-Knoblauch-Paste, grüner Chili, Koriander, Semmelbröseln, Ei und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme aus der Mischung 12-16 ovale Bällchen und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und brate die restlichen geschnittenen Zwiebeln goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Ingwer-Knoblauch-Paste dazu und brate sie 1 Minute an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomatenpüree dazu und gare es 5 Minuten unter gelegentlichem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Joghurt ein und lass die Sauce 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Koftas vorsichtig in die Sauce, damit sie nicht zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass alles 15-20 Minuten köcheln, bis die Koftas gar sind. Rühre dann Sahne und Garam Masala ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lass das Curry weitere 2 Minuten köcheln und serviere es heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
