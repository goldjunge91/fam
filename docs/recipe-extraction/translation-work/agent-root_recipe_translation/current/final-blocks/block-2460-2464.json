      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Grieß und Salz. Gib Wasser dazu, bis ein fester Teig entsteht, und knete ihn 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Teig in kleine Kugeln und rolle jede zu einer dünnen Puri.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl auf 350°F und frittiere jede Puri etwa 1-2 Minuten, bis sie hell und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Füllung zerdrücke gekochte Kartoffeln und vermische sie mit gekochten Kichererbsen und gewürfelter Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für das Pani püriere Minzblätter, Tamarindenpaste, Kreuzkümmel, Chaat Masala und Wasser. Seihe die Mischung durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mache zum Servieren ein kleines Loch in jede Puri, fülle sie mit Kartoffel-Kichererbsen-Mischung, tauche sie in Pani und iss sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
