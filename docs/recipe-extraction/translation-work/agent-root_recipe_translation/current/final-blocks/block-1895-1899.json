      "steps": [
        {
          "position": 0,
          "text": "1 Tasse Milch in eine kleine Schüssel gießen, Maisstärke dazugeben und glatt verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Restliche Milch in einen beschichteten Topf gießen. Zucker und Kardamom (und nach Wunsch Rosenwasser) dazugeben und bei mittlerer Hitze kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bevor die Milch zu kochen beginnt, die Milch-Stärke-Mischung langsam unter ständigem Rühren zugießen, damit sich keine Klumpen bilden. Weiterrühren, bis die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Topf vom Herd nehmen und die Mischung in eine große, flache Servierschüssel gießen. Bei Raumtemperatur abkühlen lassen und anschließend etwa 1–2 Stunden in den Kühlschrank stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Schluss Firni mit gehobelten Mandeln und Pistazien bestreuen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
