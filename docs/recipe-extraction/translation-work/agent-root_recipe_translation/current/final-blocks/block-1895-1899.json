      "steps": [
        {
          "position": 0,
          "text": "Pasta nach Packungsanleitung in einem großen Topf mit kochendem Salzwasser kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sahne und Butter in einer großen Pfanne bei mittlerer Hitze erwärmen, bis die Sahne blubbert und die Butter geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Parmesan einrühren und mit Salz und schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sauce leicht eindicken lassen, Pasta dazugeben und schwenken, bis sie mit Sauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Petersilie garnieren und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
