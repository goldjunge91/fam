          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatensauce, Hühnerbrühe und Cayennepfeffer einrühren und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
