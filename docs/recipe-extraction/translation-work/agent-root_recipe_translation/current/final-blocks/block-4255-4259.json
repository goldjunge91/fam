          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl langsam unter ständigem Rühren einstreuen, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze reduzieren und weitere 10 Minuten häufig umrühren, während die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zucker, Butter, Salz, Vanille und Zimt hinzufügen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 3 Minuten köcheln lassen und gelegentlich umrühren, bis der Brei cremig und glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Schüsseln füllen und heiß servieren, nach Wunsch mit zusätzlichem Zimt oder einem Schuss Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
