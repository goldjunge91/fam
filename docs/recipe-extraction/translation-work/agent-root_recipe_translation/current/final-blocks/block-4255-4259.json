      "steps": [
        {
          "position": 0,
          "text": "Öl in einem Topf erhitzen und Rindfleischstücke bei mittelhoher bis hoher Hitze etwa 8 Minuten von allen Seiten anbräunen; herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf gewürfelte Zwiebeln und gehackten Knoblauch etwa 3 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark und Kreuzkümmel einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rindfleisch zurück in den Topf geben, Rinderbrühe angießen und abgedeckt 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln klein würfeln und hinzufügen; weitere 15 Minuten garen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erdnussbutter mit einer Tasse warmer Brühe glatt rühren, dann in den Topf geben und gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 5 Minuten köcheln lassen, mit Salz und Pfeffer würzen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
