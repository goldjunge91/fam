      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und weiche Butter krümelig vermengen, dann nach und nach Wasser hinzufügen und zu einem Teig verarbeiten; 15 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhack in einer Pfanne anbraten, gewürfelte Zwiebel hinzufügen und dann gehackte hart gekochte Eier, Oliven sowie Rosinen einrühren; würzen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 8 Stücke teilen und jedes zu einem dünnen Kreis von etwa 4 inches Breite ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2 Esslöffel Füllung auf eine Hälfte jedes Teigkreises geben, halbmondförmig zuklappen und die Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne oder Fritteuse auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tucumanas portionsweise je Seite 2-3 Minuten goldbraun frittieren und dann auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm servieren, nach Wunsch mit scharfer Sauce oder Chimichurri dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
