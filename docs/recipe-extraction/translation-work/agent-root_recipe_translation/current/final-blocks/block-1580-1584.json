    {
      "externalId": "waivy:mfr-ind2-saag-tofu",
      "slug": "mfr-ind2-saag-tofu",
      "title": "Saag Tofu (veganes Spinatcurry)",
      "instructions": "Eine pflanzliche Variante von Saag Paneer: Würfel aus extra festem Tofu werden goldbraun gebraten und dann in ein samtiges Spinatpüree mit Ingwer, Knoblauch, Kreuzkümmel und Garam Masala gegeben. Cremig, kräftig grün und vollständig pflanzlich, ohne an aromatischer Tiefe einzubüßen.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 25,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Fester Tofu ist günstig und wird durch das Pressen so knusprig wie Paneer.",
        "Tiefgekühlter Spinat funktioniert gut. Taue ihn auf und drücke vor dem Pürieren das Wasser heraus.",
        "Kokoscreme aus der Dose ist lange haltbar und macht das Gericht wunderbar reichhaltig."
      ],
      "substitutions": [
        {
          "forIngredientId": "firm-tofu",
          "swap": "Paneer für eine nicht-vegane Variante"
        },
        {
          "forIngredientId": "coconut-cream",
          "swap": "Cashewcreme oder Hafercreme"
        }
      ],
