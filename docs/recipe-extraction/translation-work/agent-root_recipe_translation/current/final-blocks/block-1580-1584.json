      "steps": [
        {
          "position": 0,
          "text": "Presse den Tofu aus, würfle ihn und brate ihn in der Pfanne von allen Seiten 8 Minuten goldbraun an. Stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass den Spinat in der Pfanne zusammenfallen und püriere ihn mit einem Schuss Wasser glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl und gib Kreuzkümmelsamen dazu. Füge die Zwiebel hinzu und gare sie 5 Minuten. Gib Knoblauch und Ingwer dazu und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Gewürze dazu und gare sie 1 Minute. Gieße das Spinatpüree hinein und lass alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Kokoscreme und Tofu unter und lass alles 3 Minuten köcheln. Verfeinere das Gericht mit Zitrone.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
