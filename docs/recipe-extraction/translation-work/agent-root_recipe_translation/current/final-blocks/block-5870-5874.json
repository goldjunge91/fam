      "steps": [
        {
          "position": 0,
          "text": "Wenn du getrocknete Morcheln verwendest, weiche sie 10 Minuten in warmem Wasser ein, gieße sie ab und hacke sie. Frische Morcheln längs halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Brotscheiben goldbraun und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmelze Butter in einer Pfanne bei mittlerer Hitze und dünste gehackte Schalotte und Knoblauch 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Morcheln dazu und gare sie 3-4 Minuten, bis sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche mit Weißwein ab, löse die Bratrückstände vom Pfannenboden und lasse alles 1 Minute köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, gieße die Sahne dazu, gib Thymian hinzu und lasse alles 5 Minuten köcheln, bis die Soße leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer, entferne den Thymianzweig und verteile die cremigen Morcheln auf dem Toast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischem Schnittlauch und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
