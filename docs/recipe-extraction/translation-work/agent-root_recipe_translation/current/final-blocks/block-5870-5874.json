      "steps": [
        {
          "position": 0,
          "text": "Hacke alle Pilze, Zwiebel, Karotte, Sellerie und Knoblauch grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Brühe in einem Topf. Gib die Pilzmischung und Thymian dazu und lasse alles 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Topf vom Herd und lasse die Brühe 5 Minuten abkühlen. Rühre dann das verquirlte Eiweiß langsam und vorsichtig ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze die Brühe bei niedriger Hitze erneut und lasse sie ohne Rühren 30 Minuten köcheln, während sich aus dem Eiweiß eine Klärdecke bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schöpfe die klare Consommé vorsichtig durch ein feines, mit Mulltuch ausgelegtes Sieb ab und lasse die Klärdecke dabei unberührt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die abgesiebte Consommé zurück in den Topf, füge Sherry hinzu und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze die Suppe sanft und serviere sie in warmen Schüsseln, nach Wunsch mit dünnen Pilzscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
