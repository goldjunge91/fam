      "steps": [
        {
          "position": 0,
          "text": "Erhitze die Brühe in einem separaten Topf und halte sie während des Kochens leicht köchelnd warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Zwiebel und Knoblauch fein und dünste sie in Butter in einer großen, breiten Pfanne bei mittlerer Hitze 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Arborio-Reis dazu und rühre 2 Minuten ständig, bis die Körner am Rand leicht glasig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den Weißwein dazu und rühre, bis er aufgenommen ist. Gib dann schöpflöffelweise warme Brühe dazu und rühre häufig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Pilze in dünne Scheiben und brate sie separat in einer kleinen Pfanne bei mittlerer bis hoher Hitze 4-5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib weiter Brühe dazu und rühre insgesamt etwa 18-20 Minuten, bis der Reis cremig und bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd. Rühre Butter, Parmesan, Trüffelöl und gebratene Pilze ein und würze mit Salz und weißem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile das Risotto auf Schüsseln und serviere es sofort mit zusätzlichem Parmesan und etwas Trüffelöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
