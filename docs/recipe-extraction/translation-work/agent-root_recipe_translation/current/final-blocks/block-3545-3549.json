      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage in einer anderen Schüssel das Ei auf und vermische es mit Milch und 1 EL geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die flüssigen und trockenen Zutaten und rühre nur so lange, bis sie gerade vermengt sind. Einige Klümpchen dürfen bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze 1 EL Butter in einer Pfanne bei mittlerer Hitze und gare die Pfannkuchen etwa 3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Löse Jaggery mit Kokosmilch in einem Topf bei mittlerer Hitze auf und rühre ständig, bis ein sirupartiger Sirup entsteht, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Staple die fertigen Pfannkuchen auf einem Teller und beträufle sie großzügig mit Jaggery-Sirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
