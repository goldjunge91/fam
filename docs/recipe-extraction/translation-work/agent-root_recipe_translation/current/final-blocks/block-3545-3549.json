      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl mit 1 cup Wasser zu einer glatten Paste und gib unter Rühren nach und nach die übrigen 3 cups Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Seihe die Mischung durch ein feinmaschiges Sieb in einen großen Topf, um Klümpchen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salz und Kurkuma zur abgesiebten Mischung und bringe alles bei mittlerer Hitze zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre 15-20 Minuten ständig, während die Mischung stark eindickt und cremig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald sie sehr dick ist, gieße sie in eine geölte 8x8 inch große Backform und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie vollständig abkühlen und stelle sie dann mindestens 1 Stunde kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide sie in Würfel oder Rechtecke und serviere sie bei Raumtemperatur mit sautierten Zwiebeln, Knoblauch, Ingwer und Chilipulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Alternativ kannst du die Stücke in der Pfanne von beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
