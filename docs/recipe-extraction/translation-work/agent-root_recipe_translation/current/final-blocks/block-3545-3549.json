      "steps": [
        {
          "position": 0,
          "text": "Schneide Rindfleisch in 1.5-inch große Würfel, würfle die Zwiebeln und hacke Knoblauch und Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem schweren Topf bei mittelhoher bis hoher Hitze und bräune das Rindfleisch portionsweise insgesamt etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Zwiebel, Knoblauch und Ingwer dazu und gare alles etwa 4 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Currypulver und Kurkuma ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomatenmark dazu und verrühre es, sodass das Rindfleisch damit überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Rinderbrühe und Fischsauce dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 40-45 Minuten köcheln, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht, würze es nach Bedarf nach und serviere es auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
