          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach die Milch unter ständigem Rühren dazu, bis die Mischung glatt und klümpchenfrei ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die Mischung bei mittlerer Hitze unter häufigem Rühren etwa 8 Minuten, bis sie eindickt und aufkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse sie unter ständigem Rühren 1 Minute kochen und nimm den Topf dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Butter und Vanilleextrakt ein, bis die Butter vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den Pudding auf Dessertschälchen und stelle ihn vor dem Servieren mindestens 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
