      "steps": [
        {
          "position": 0,
          "text": "Bringe Salzwasser in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Kohl und Kartoffeln dazu und gare sie etwa 30-40 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Wasser sehr gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Gemüse zurück in den Topf und stelle den Herd auf niedrige Hitze. Lass es dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate währenddessen den Speck und bewahre das Fett zum Braten des Stampfs auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide den Speck in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zerdrücke Kartoffeln und Kohl mit einem Kartoffelstampfer und gib gehackten Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Drücke die Stampfmischung mithilfe einer Form für Einzelportionen hinein und lege Speck darauf. Brate sie im aufgehobenen Speckfett goldbraun, wende sie und bräune die andere Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Nimm die Form ab und garniere mit gehackter Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Für einen großen Kartoffel-Kohl-Stampf verwende eine Pfanne. Drücke die Mischung mit Speckstücken und dem beiseitegestellten Fett hinein und wende sie, sobald sie goldbraun ist. Schneide sie in Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Garniere mit gehackter Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
