      "steps": [
        {
          "position": 0,
          "text": "Gib das Lamm in einen Schmortopf und brate es bei hoher Hitze. Sobald es gebräunt ist, nimm es vom Herd und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass einen Esslöffel Fett im Schmortopf und gieße den Rest weg. Reduziere die Hitze auf mittlere Stufe, gib Knoblauch, Zwiebel und Spinat dazu und gare alles etwa 5 Minuten, bis die Zwiebel glasig und der Spinat zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Lamm mit der Zwiebel-Spinat-Mischung zurück in den Topf. Füge Tomatenpüree, Kreuzkümmel, Harissa, Hähnchen, Kichererbsen, Zitronensaft, Salz und Pfeffer hinzu. Lass alles bei niedriger Hitze etwa 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Pasta dazu und gare sie 15 Minuten oder bis sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
