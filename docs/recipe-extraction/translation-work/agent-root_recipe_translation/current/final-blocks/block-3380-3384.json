          "images": []
        },
        {
          "position": 4,
          "text": "Lasse ihn sofort auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wiederhole den Vorgang mit den übrigen Fladen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie als knusprigen Snack oder Beilage zu indischen Gerichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bewahre abgekühlte Papadums bis zu 2 Wochen in einem luftdichten Behälter auf.",
