      "steps": [
        {
          "position": 0,
          "text": "Halbiere die Bittermelone der Länge nach, entferne die Kerne und schneide sie in dünne Halbmonde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe den Tofu mit Küchenpapier trocken und schneide ihn in 1-inch große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Spam in kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze und brate die Bittermelone 3-4 Minuten unter Rühren, bis sie weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tofuwürfel und Spam dazu und gare alles 2 Minuten unter vorsichtigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe die Zutaten an den Rand, schlage die Eier in die Pfanne, verrühre sie leicht und vermische dann alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Sojasauce und Mirin über die Mischung, vermenge alles und würze mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gare alles weitere 1-2 Minuten, bis die Eier gerade gestockt sind, und serviere das Gericht sofort nach Wunsch mit Bonitoflocken bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
