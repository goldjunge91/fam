      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen, schweren Topf und bräune das Fleisch 8-10 Minuten von allen Seiten. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare im selben Topf geschnittene Zwiebeln etwa 8 Minuten, bis sie tief goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwer-Knoblauch-Paste dazu und gare sie 2 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Fleisch zurück in den Topf und füge Nihari-Masala hinzu. Rühre alles 2 Minuten gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser dazu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse alles zugedeckt 90 Minuten köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Zitronensaft dazu und schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht in Schalen und garniere es mit in feine Streifen geschnittenem Ingwer, frischem Koriander und Minze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reiche Naan-Brot oder Reis dazu, um die reichhaltige Sauce aufzunehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
