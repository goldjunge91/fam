      "steps": [
        {
          "position": 0,
          "text": "Bereite die Marinade zu: Gib Balsamicoessig, Basilikum, Olivenöl, gehackten Knoblauch und Salz in einen Mixer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Viertle 4 Tomaten, gib sie in den Mixer und püriere alles glatt. Halbiere die übrigen 4 Tomaten und stelle sie zum Grillen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen mit etwa zwei Dritteln cup Marinade in eine Schüssel, decke sie ab und stelle sie 1 Stunde in den Kühlschrank. Wende das Hähnchen gelegentlich. Stelle die restliche Marinade zum Servieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass das Hähnchen abtropfen und entsorge die verwendete Marinade. Erhitze den Grill auf mittlere Hitze und öle den Rost leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille das Hähnchen zugedeckt 4-6 Minuten pro Seite, bis die Innentemperatur 165F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die halbierten Tomaten zugedeckt 2-4 Minuten pro Seite, bis sie leicht angeröstet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere Hähnchen und Tomaten mit der beiseitegelegten frischen Marinade beträufelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
