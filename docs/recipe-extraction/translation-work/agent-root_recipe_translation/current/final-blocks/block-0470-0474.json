      "steps": [
        {
          "position": 0,
          "text": "Verrühre braunen Zucker, Ketchup, Sojasauce, Sherry, Ingwer und Knoblauch in einer Schüssel, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle etwa 1 1/3 cups der Mischung zum Bestreichen beiseite und decke sie separat ab. Kühle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die übrige Marinade auf zwei flache Schüsseln. Gib jeweils 12 Hähnchenschenkel dazu und wende sie, bis sie vollständig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke das Hähnchen ab und mariniere es im Kühlschrank, am besten über Nacht, aber nicht länger. Auch ein kurzes Marinieren während der Grill aufheizt gibt Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Hähnchen aus der Marinade und entsorge die verwendete Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille das Hähnchen zugedeckt bei mittlerer Hitze auf einem geölten Rost 6 bis 8 Minuten pro Seite, bis die Innentemperatur 170°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche es während der letzten 5 Minuten mit der beiseitegelegten Marinade, damit eine glänzende, karamellisierte Glasur entsteht. Dann servieren.",
          "timerMinutes": null,
