      "steps": [
        {
          "position": 0,
          "text": "Koche die Penne in Salzwasser bissfest. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmelze währenddessen Butter in einer großen ofenfesten Pfanne bei mittelhoher Hitze und brate die gehackte Zwiebel darin weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Mehl darüber und rühre um, bis die Zwiebel damit bedeckt ist. Gieße dann langsam Hühnerbrühe dazu und rühre sie mit dem Schneebesen glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bring die Sauce zum Kochen und gare sie unter Rühren etwa 2 Minuten, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre zerzupftes Hähnchen, abgetropfte Artischockenherzen, Feta, sonnengetrocknete Tomaten und Oliven ein, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die abgetropfte Pasta unter die Sauce in der Pfanne und wende alles, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schiebe die Pfanne 3-4 inches unter den Ofengrill und grille sie 5-7 Minuten, bis die Oberfläche blubbert und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue gehackte frische Petersilie darüber und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
