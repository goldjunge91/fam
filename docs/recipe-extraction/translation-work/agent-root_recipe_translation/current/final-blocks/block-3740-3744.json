      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und lege ein großes Backblech mit Alufolie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Aubergine, Paprika, Zucchini, Zwiebel und Tomaten in 1 Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle Knoblauchzehen und lasse sie ganz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische alles Gemüse auf dem Backblech mit Olivenöl, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile es in einer Lage und röste es 40-45 Minuten. Rühre nach der Hälfte der Zeit um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Gemüse sollte sehr weich und an den Rändern leicht angeröstet sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib es auf eine Servierplatte und streue frisches Basilikum darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm oder bei Raumtemperatur als Beilage oder leichte Hauptmahlzeit servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
