      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Hefe, Zucker und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme Milch auf 110°F und vermische sie mit geschmolzener Butter und Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge die flüssigen und trockenen Zutaten und knete 8-10 Minuten, bis der Teig glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Teig in einer gefetteten Schüssel 45 Minuten gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 4 Portionen und forme auf einem Backblech ovale Brötchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie weitere 20 Minuten gehen und backe sie dann bei 375°F 12-15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie vollständig abkühlen und schlage dann Sahne mit Puderzucker steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide die Brötchen waagerecht auf und fülle sie großzügig mit der gesüßten Schlagsahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
