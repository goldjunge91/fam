      "steps": [
        {
          "position": 0,
          "text": "Erhitze Brühe in einem separaten Topf und halte sie während der gesamten Risottozubereitung leicht köchelnd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Zwiebel in Butter an, gib Reis hinzu und röste ihn 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Brühe kellenweise hinzu und rühre ständig. Warte jeweils, bis die Flüssigkeit aufgenommen ist; insgesamt etwa 18 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Parmesan und Tomatensauce ein und verteile das Risotto zum vollständigen Abkühlen auf einem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme 2 Zoll große ovale Risottoportionen und stecke einen Mozzarellawürfel in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verschließe die Ränder sorgfältig. Verquirle Ei, tauche jedes Supplì hinein und wende es dann in Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einem tiefen Topf oder einer Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frittiere die Supplì etwa 3-4 Minuten goldbraun und lasse sie auf Küchenpapier abtropfen.",
