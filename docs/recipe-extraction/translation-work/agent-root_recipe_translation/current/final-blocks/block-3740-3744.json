      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 Esslöffel Olivenöl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittene Zwiebeln hinzu und gare sie unter häufigem Rühren 15-18 Minuten, bis sie sehr weich und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebeln auf einen Teller und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Leber trocken und bestäube beide Seiten leicht mit Mehl. Schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhöhe die Hitze auf hoch und gib das restliche Olivenöl und Butter in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate Leberscheiben rasch je Seite 1-2 Minuten an, bis sie gebräunt, innen aber noch leicht rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Zwiebeln zurück in die Pfanne, gieße Wein hinzu und lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz, Pfeffer und Petersilie und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
