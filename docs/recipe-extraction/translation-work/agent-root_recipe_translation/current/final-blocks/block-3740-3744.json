      "steps": [
        {
          "position": 0,
          "text": "Weiche Stockfisch 24 Stunden in kaltem Wasser ein und wechsle das Wasser alle 6 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe einen Topf Wasser zum Kochen und pochierte den rehydrierten Fisch 8-10 Minuten, bis er zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Fisch heraus, lasse ihn abkühlen und zupfe ihn in mundgerechte Flocken. Entferne Haut und Gräten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle Tomaten und rote Zwiebel fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Fisch, Tomaten, Zwiebel und Oliven in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Olivenöl und Essig und beträufle den Salat damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer, vermenge alles vorsichtig und garniere es vor dem Servieren mit Petersilie.",
          "timerMinutes": null,
