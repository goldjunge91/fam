      "steps": [
        {
          "position": 0,
          "text": "Mariniere die Hähnchenstreifen 5 Minuten in Joghurt, Kreuzkümmel, Koriander, Kurkuma, Knoblauch und Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Hähnchen in der Pfanne. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Eierhülle zu: Schlage ein Ei direkt auf die Tortilla in der Pfanne. Gare es, bis es gestockt ist, und wende die Tortilla kurz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Tortilla auf der Seite mit Ei mit Hähnchen, karamellisierter Zwiebel, Minz-Chutney und Zitrone.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
