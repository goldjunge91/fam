          "savings": "spart etwa $0.50"
        },
        {
          "forIngredientId": "lemon-juice-bottled",
          "swap": "Ein Schuss Weißweinessig und zusätzliche Zitronenschale",
          "savings": "Essig ist günstiger und lange haltbar"
        }
      ],
