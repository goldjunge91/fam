      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 450F vor. Fette eine tiefe, 9 Zoll große Pastetenform leicht ein und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme das Rapsöl in einem großen Topf bei mittelhoher Hitze. Gib die gehackte Zwiebel dazu und gare sie unter Rühren, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Mehl und Geflügelgewürz darüber und rühre, bis die Zwiebeln damit überzogen sind und kein trockenes Mehl mehr übrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Hühnerbrühe und Milch langsam mit dem Schneebesen ein. Bringe die Sauce unter ständigem Rühren zum Kochen und gare sie weitere 2 bis 3 Minuten, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre das gewürfelte, gegarte Hähnchen und das aufgetaute Mischgemüse ein, bis alles gleichmäßig mit Sauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Füllung in die vorbereitete Pastetenform und lege den Teigboden darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Ränder passend zu und drücke sie zum Verschließen fest. Schneide dann einige Schlitze in den Teig, damit Dampf entweichen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Pastete 15 bis 20 Minuten, bis die Kruste goldbraun ist und die Füllung blubbert. Lass sie vor dem Servieren einige Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
