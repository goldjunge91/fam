      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400 Grad F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare das Rinderhack in einem großen Topf bei mittlerer Hitze, bis es nicht mehr rosa ist. Gieße anschließend das Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die geschnittenen Hotdogs, gebackenen Bohnen, Ketchup, braunen Zucker, Senf und gewürfelten Schmelzkäse ein. Rühre weiter, bis der Käse geschmolzen ist und eine glatte, würzige Füllung entsteht.",
