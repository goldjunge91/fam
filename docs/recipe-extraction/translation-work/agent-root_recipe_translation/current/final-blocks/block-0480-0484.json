      "steps": [
        {
          "position": 0,
          "text": "Stelle einen großen Topf oder Schmortopf bei mittlerer Hitze auf den Herd. Zerteile die italienische Wurst darin zusammen mit der gehackten Zwiebel und rühre, bis das Fleisch nicht mehr rosa ist, etwa 6 bis 7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den geschnittenen Knoblauch dazu und gare ihn etwa eine Minute, bis er duftet. Gieße anschließend überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe dazu und gib Bohnen, Tomaten samt Flüssigkeit, Perlgraupen, Karotte, Staudensellerie, Salbei und Rosmarin hinein. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze, decke den Topf ab und lass die Suppe 45 Minuten sanft köcheln, damit die Graupen weich werden und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre den gehackten Grünkohl ein und bringe die Suppe wieder zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze erneut, decke den Topf ab und lass die Suppe weitere 25 bis 30 Minuten köcheln, bis das Gemüse weich ist. Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hinweis: Graupen nehmen beim Stehen weiterhin Brühe auf. Koche sie separat und gib sie erst in die jeweilige Schüssel, wenn Reste suppig bleiben sollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
