    {
      "externalId": "waivy:toh-homemade-chicken-potpie",
      "slug": "toh-homemade-chicken-potpie",
      "title": "Hausgemachte Hähnchen-Pastete",
      "instructions": "Eine herzhafte Hähnchen-Pastete für den Abend unter der Woche: zartes Hähnchen und Gemüse in cremiger, mit Geflügelgewürz abgeschmeckter Sauce, bedeckt von einer einzigen goldbraunen, blättrigen Teigkruste. Wohlfühlessen, das in einer halben Stunde fertig ist. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/homemade-chicken-potpie/",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Verwende übrig gebliebenes oder fertig gegrilltes Hähnchen statt es frisch zu garen. Das spart Geld und Zeit.",
        "Kaufe eine Tüte tiefgekühltes Mischgemüse statt frischem Gemüse. Es ist günstiger und verursacht weder Vorbereitungsarbeit noch Abfall.",
        "Ein gekühlter Teigboden der Hausmarke senkt die Kosten. Du kannst ihn auch selbst aus Mehl zubereiten, das du bereits zu Hause hast."
      ],
      "substitutions": [
        {
          "forIngredientId": "two-percent-milk",
          "swap": "Vollmilch oder für eine reichhaltigere Sauce auch halb Sahne, halb Milch",
          "savings": "Vergleichbare Kosten; Vollmilch ist oft günstiger"
        },
        {
          "forIngredientId": "pie-crust",
          "swap": "Tiefgekühlter Pastetenteig oder Blätterteig aus dem Kühlregal als Füllungsdecke",
          "savings": "Tiefgekühlter Boden ist etwa $0.50 günstiger"
        },
        {
          "forIngredientId": "rotisserie-chicken",
          "swap": "Gewürfelte, gegarte Hähnchenbrust oder abgetropftes Hähnchen aus der Dose",
          "savings": "Grillhähnchen ist meist die günstigste gegarte Option"
        }
      ],
