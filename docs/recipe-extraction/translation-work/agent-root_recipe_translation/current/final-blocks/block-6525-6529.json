          "position": 1,
          "text": "Würfle Zwiebel, Sellerie und Karotte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und brate Zwiebel, Sellerie und Karotte 5 Minuten an.",
