          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kartoffelwürfel und Gemüsebrühe dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lass die Suppe 20 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre saure Sahne und frischen Schnittlauch ein und erhitze die Suppe, ohne sie aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
