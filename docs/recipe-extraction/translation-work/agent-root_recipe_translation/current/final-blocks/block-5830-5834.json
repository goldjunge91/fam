      "steps": [
        {
          "position": 0,
          "text": "Separate eggs carefully, putting whites in one Schüssel und yolks in another.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Salz, white Pfeffer, chives, und half the cheese to egg yolks und whisk together.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib cream of tartar to egg whites und beat mit an electric mixer bis stiff peaks form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gently fold one-third of whites into yolk mixture, then fold in remaining whites bis just combined.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Melt butter in a 10-inch nonstick skillet over mittlerer Erhitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pour mixture into skillet und Koche without stirring für 4 Minuten bis bottom is set but top is still wet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sprinkle remaining cheese on top und Gib skillet to a preheated 375°F Ofen für 6-8 Minuten bis top is golden und puffed.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Slide onto a plate, fold in half, und Serviere immediately while still puffy.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
