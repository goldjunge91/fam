          "images": []
        },
        {
          "position": 3,
          "text": "Bring a separate Topf of Wasser to boil und Koche ramen noodles according to package directions, then drain.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Divide noodles between two bowls und ladle hot broth over them.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege one marinated egg in the center of each Schüssel, halved if desired.",
