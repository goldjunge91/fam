      "steps": [
        {
          "position": 0,
          "text": "Brate Auberginenscheiben goldbraun an und stelle sie beiseite. Brate den Blumenkohl leicht goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Hähnchenschenkel. Schichte Tomaten, Aubergine, Blumenkohl, Hähnchen und Reis in einen tiefen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße gewürzte Brühe darüber und koche alles bei mittlerer bis niedriger Hitze zugedeckt 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass das Gericht 10 Minuten ruhen. Stürze es auf eine große Platte und garniere es mit Pinienkernen und Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
