      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375 °F vor. Brate Rinderhack mit Zwiebel, Knoblauch, Kreuzkümmel und Chilipulver an. Gieße das Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre abgetropfte schwarze Bohnen und 2 Portionen Salsa ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile einen Löffel Salsa auf dem Boden einer 9×13-Zoll-Auflaufform. Schichte 3 Tortillas, die Hälfte der Fleischmischung und eine Lage Käse darauf. Wiederhole die Schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die übrige Salsa und den restlichen Käse obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Auflauf 25–30 Minuten, bis er blubbert und goldbraun ist. Lass ihn vor dem Anschneiden 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
