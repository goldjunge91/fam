          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die Garnelen mit Harissa und einer Prise Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Garnelen in einer sehr heißen Pfanne bei hoher Hitze 1–2 Minuten pro Seite, bis sie undurchsichtig und an den Rändern leicht verkohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate in derselben Pfanne Zwiebel und Knoblauch kurz an. Gib gehackte Tomaten dazu und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die Garnelen wieder unter die Tomatenmischung. Serviere sie auf Couscous mit Zitronensaft und Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
