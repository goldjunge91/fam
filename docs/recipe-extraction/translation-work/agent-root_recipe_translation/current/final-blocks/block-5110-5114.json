      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch und Zwiebel fein. Gib sie zusammen mit Putenhackfleisch, Semmelbröseln, Ei, Parmesan, Salz und Pfeffer in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge alles vorsichtig mit den Händen, bis es gerade verbunden ist. Knete die Masse nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme aus der Mischung 1.5-inch große Fleischbällchen und lege sie auf das vorbereitete Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle sie mit Olivenöl und backe sie 15-18 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze die Marinara-Sauce in einem Topf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die gegarten Fleischbällchen in die Sauce und lass sie 5 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
