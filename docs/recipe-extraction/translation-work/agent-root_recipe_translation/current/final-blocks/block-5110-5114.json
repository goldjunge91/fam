      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchenbrüste auf beiden Seiten mit Salz, Pfeffer und 1/2 Teelöffel Oregano.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Grille das Hähnchen oder brate es bei mittlerer bis hoher Hitze pro Seite 6-7 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Hähnchen vom Herd, lass es 5 Minuten ruhen und schneide es dann in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hacke den Römersalat und gib ihn in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle die Gurke, halbiere die Kirschtomaten und schneide die rote Zwiebel in dünne Scheiben. Gib alles zusammen mit den Oliven in die Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Olivenöl, Rotweinessig und den restlichen Oregano in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge den Salat mit dem Dressing, belege ihn mit Hähnchen und Feta und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
