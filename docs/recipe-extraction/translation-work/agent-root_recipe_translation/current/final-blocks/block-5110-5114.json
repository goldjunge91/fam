      "steps": [
        {
          "position": 0,
          "text": "Spüle den Vollkornreis ab und gib ihn mit Gemüsebrühe in einen Topf. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze, decke den Topf ab und lass den Reis 25-30 Minuten köcheln, bis er weich ist und die Flüssigkeit aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Grill oder eine Grillpfanne auf mittlere bis hohe Hitze vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Tilapiafilets trocken und bestreiche sie mit Olivenöl. Würze sie mit Knoblauchpulver, Thymian, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille den Tilapia pro Seite 3-4 Minuten, bis das Fleisch undurchsichtig ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Halbiere die Zitronen und grille sie mit der Schnittseite nach unten 2 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Reis mit dem Tilapia und den gegrillten Zitronenhälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
