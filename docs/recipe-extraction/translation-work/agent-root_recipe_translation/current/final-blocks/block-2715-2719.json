      "steps": [
        {
          "position": 0,
          "text": "Vermische Kartoffelstampf, Butter, Mehl und Brühe in einem Topf bei mittlerer Hitze zu einem Teig. Rühre 5 Minuten ständig, bis er sich vom Rand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fülle den Teig auf einen Teller und lasse ihn abkühlen, bis er sich anfassen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische zerpflücktes Hähnchen mit gehackter Zwiebel, Salz und Pfeffer für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme etwa 2 EL Teig um 1 EL Hähnchenfüllung zu einer Tropfenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Ei in einer Schüssel, tauche jede Coxinha hinein und wälze sie dann in Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere jeweils 3-4 Coxinhas 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit scharfer Sauce oder Limette.",
          "timerMinutes": null,
