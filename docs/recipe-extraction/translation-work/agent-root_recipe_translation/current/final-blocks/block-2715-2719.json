      "steps": [
        {
          "position": 0,
          "text": "Schneide die Rinderhüfte in dünne Streifen und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tbsp Öl in einer großen Pfanne bei mittelhoher Hitze und bräune das Fleisch portionsweise etwa 3-4 Minuten pro Seite an. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl in dieselbe Pfanne und brate gewürfelte Zwiebeln und gehackten Knoblauch etwa 3 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geschnittene Pilze dazu und gare sie 4-5 Minuten, bis sie Flüssigkeit abgeben und anfangen zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in die Pfanne, gieße Rinderbrühe dazu und lasse alles ohne Deckel 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd und rühre saure Sahne unter, bis alles vermischt ist. Achte darauf, die Sauce nicht aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht, passe die Würzung mit Salz und Pfeffer an und serviere es zu Reis oder Eiernudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
