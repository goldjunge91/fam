      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und stelle einen mit heißem Wasser gefüllten Bräter auf die unterste Schiene.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 3/4 cup Zucker bei mittlerer Hitze in einem Topf und rühre ständig, bis goldener Karamell entsteht. Gieße ihn sofort in eine Puddingform oder runde Auflaufform und bedecke den Boden damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Kondensmilch, Kondensmilch, Eier, Vanille und den übrigen 1/4 cup Zucker, bis die Mischung völlig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung in die karamellisierte Form und stelle diese ins Wasserbad im Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Pudding 25-30 Minuten, bis er fest ist, in der Mitte beim vorsichtigen Rütteln aber noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Form aus dem Ofen und Wasserbad und lasse den Pudding 1 Stunde bei Raumtemperatur vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle ihn mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fahre mit einem dünnen Messer am Rand entlang und stürze den Pudding auf eine Servierplatte, sodass die Karamellsauce darüberläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
