      "steps": [
        {
          "position": 0,
          "text": "Gieße die eingeweichten Augenbohnen ab und gib sie mit Zwiebel, Knoblauch, Salz und Pfeffer in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere die Mischung stoßweise, bis sie dick und etwas grob ist und feuchtem Sand ähnelt. Nicht zu fein pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre bei Verwendung die Garnelenpaste ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Pflanzenöl in einem tiefen Topf oder Schmortopf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib mit einem kleinen Eisportionierer vorsichtig Löffel der Masse ins heiße Öl und frittiere jeweils 3-4 Stück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie 3-4 Minuten und wende sie nach der Hälfte der Zeit, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit scharfer Sauce und Limette dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
