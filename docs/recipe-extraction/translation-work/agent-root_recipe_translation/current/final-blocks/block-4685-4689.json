      "steps": [
        {
          "position": 0,
          "text": "Würze die Fischfilets mit Salz, Pfeffer und 2 Esslöffeln Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und gib den gehackten Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege den Fisch in die Pfanne und brate ihn pro Seite 3-4 Minuten, bis er undurchsichtig ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Fisch heraus und stelle ihn beiseite. Brate dann die gewürfelte Zwiebel und die Jalapeños in derselben Pfanne 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Fisch zurück in die Pfanne, füge den restlichen Limettensaft und Koriander hinzu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere den Fisch auf warmen Tortillas mit angebratenen Zwiebeln, Jalapeños und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
