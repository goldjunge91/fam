      "steps": [
        {
          "position": 0,
          "text": "Vermische Knoblauch, Kreuzkümmel, Oregano, Paprikapulver, Essig, Limettensaft, Olivenöl, Salz und Pfeffer im Mixer, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe das Hähnchen trocken und reibe es innen und außen mit der Marinade ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse das Hähnchen mindestens 30 Minuten bei Raumtemperatur marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 425°F vor und lege das Hähnchen mit der Brustseite nach oben in einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate es 1 Stunde, bis die Haut goldbraun ist und ein Fleischthermometer an der dicksten Stelle der Keule 165°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse das Hähnchen 5 Minuten ruhen, tranchiere es und serviere es mit Limettenspalten und warmen Tortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
