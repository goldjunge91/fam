      "steps": [
        {
          "position": 0,
          "text": "Bitte den Metzger um vorgeschnittenes Rinderkopffleisch und lasse es gründlich reinigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Rinderkopffleisch mit Wasser, der Hälfte der Zwiebel, Knoblauch, Salz, Pfefferkörnern und Lorbeerblättern in einen großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe alles zum Kochen, schöpfe den Schaum von der Oberfläche ab und lasse es dann zugedeckt 4 Stunden köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch heraus und lasse es abkühlen. Zupfe es dann mit zwei Gabeln auseinander und entferne alle verbliebenen Knochen oder Knorpel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer Pfanne und brate die restliche Zwiebel und die Jalapeños an, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das gezupfte Fleisch dazu und brate es etwa 8 Minuten, bis die Ränder leicht knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es auf warmen Tortillas mit gewürfelter Zwiebel, Koriander, Jalapeños und frischem Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
