      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 325°F vor und lege eine Springform mit 6 inch Durchmesser mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Graham-Cracker-Brösel mit geschmolzener Butter und drücke die Mischung als Boden in die Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage weichen Frischkäse und Zucker glatt. Gib Matcha-Pulver dazu und verrühre alles klümpchenfrei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die Eier einzeln bei niedriger Geschwindigkeit ein. Rühre anschließend saure Sahne, Vanille und Salz unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Füllung auf den Boden und stelle die Springform in eine größere Form mit 1 inch heißem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Kuchen 40-45 Minuten, bis die Ränder fest sind, die Mitte aber noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schalte den Ofen aus, öffne die Tür etwa 4 inch und lasse den Käsekuchen 1 Stunde abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm ihn aus dem Ofen und lasse ihn vollständig bei Raumtemperatur abkühlen. Stelle ihn vor dem Servieren mindestens 4 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
