      "steps": [
        {
          "position": 0,
          "text": "Koche die Tapiokaperlen nach Packungsanleitung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Heize den Backofen auf 350°F vor und fette eine runde Kuchenform mit 7 inch Durchmesser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Mehl, Taropulver, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage Eier und Zucker hell und luftig auf. Gieße das Öl beim Rühren langsam dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre abwechselnd die Mehlmischung und Milch unter die Eiermasse. Beginne und ende mit Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die abgekühlten Tapiokaperlen unter und gieße den Teig in die vorbereitete Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Kuchen 35-40 Minuten, bis ein Zahnstocher aus der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse ihn 10 Minuten abkühlen und stürze ihn dann zum vollständigen Abkühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schlage Sahne mit Kondensmilch auf und verstreiche sie vor dem Servieren auf dem abgekühlten Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
