      "steps": [
        {
          "position": 0,
          "text": "Den Grill auf mittlere bis hohe Hitze vorheizen und den Rost leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forellenfilets trocken tupfen und auf beiden Seiten mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zitrone in Scheiben schneiden und Knoblauch hacken. Beides zusammen mit frischem Dill auf den Filets verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jedes Filet mit kleinen Butterstücken belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Filets mit der Hautseite nach oben 8–10 Minuten grillen, bis das Fleisch undurchsichtig ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vorsichtig auf Teller geben und sofort mit den übrigen Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
