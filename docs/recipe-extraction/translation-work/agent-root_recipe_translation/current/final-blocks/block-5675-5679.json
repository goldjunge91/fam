      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würstchen rundherum 8 Minuten anbraten, herausnehmen und in 2-Zoll-Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne geschnittene Paprika, Zwiebel und Knoblauch 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würstchen zurück in die Pfanne geben und Tomatensauce sowie Oregano hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze auf mittlere Stufe reduzieren und 15 Minuten köcheln lassen; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf knusprigem Brot oder mit Pasta servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
