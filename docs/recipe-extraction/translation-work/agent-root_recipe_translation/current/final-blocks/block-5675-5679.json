      "steps": [
        {
          "position": 0,
          "text": "Gemüsebrühe in einem separaten Topf erhitzen und während der gesamten Zubereitung leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl und 1 Esslöffel Butter in einem großen Topf mit schwerem Boden bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel und gehackten Knoblauch etwa 2–3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Arborio-Reis hinzufügen und 1–2 Minuten ständig rühren, bis die Ränder der Körner glasig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weißwein zugießen und rühren, bis der Reis ihn aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiße Brühe schöpflöffelweise hinzufügen und häufig rühren. Erst mehr Brühe zugeben, wenn die vorherige aufgenommen wurde; insgesamt etwa 18–20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn der Reis cremig und weich ist, vom Herd nehmen und übrige Butter sowie Parmesan einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer abschmecken und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
