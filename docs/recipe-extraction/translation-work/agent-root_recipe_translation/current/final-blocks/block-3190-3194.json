      "steps": [
        {
          "position": 0,
          "text": "Spüle Linsen unter kaltem Wasser ab und gib sie mit Gemüsebrühe in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lasse die Linsen 20-25 Minuten köcheln, bis sie weich, aber nicht matschig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle währenddessen Karotten, Sellerie, rote Zwiebel und Schalotten fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Senf, Essig und Olivenöl in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die gegarten Linsen ab und gib sie noch warm in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfeltes Gemüse und Petersilie zu den warmen Linsen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße das Dressing darüber und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und lasse den Salat vor dem Servieren 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
