      "steps": [
        {
          "position": 0,
          "text": "Koche Kartoffeln und Karotten 15 Minuten in Salzwasser, bis sie weich sind. Gieße sie ab und lasse sie vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Eier 10 Minuten hart, schäle sie und kühle sie in Eiswasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die abgekühlten Kartoffeln, Karotten und Eier in kleine 1/4 Zoll große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle Gewürzgurken und Schinken in ähnlich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Kartoffeln, Karotten, Eier, Gewürzgurken, Schinken und Erbsen in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Mayonnaise, Salz und Pfeffer hinzu und hebe alles vorsichtig unter, bis die Zutaten bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle den Salat vor dem Servieren mindestens 1 Stunde kalt, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
