      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und lege Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische gemahlene Mandeln, Zucker, Eigelb, Zitronenabrieb und Vanille gründlich in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle die Mischung zu Kugeln etwa in Walnussgröße (etwa 1 inch Durchmesser).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage Eiweiß in einer flachen Schüssel leicht auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauche jede Kugel kurz in Eiweiß und wälze sie dann gleichmäßig in Pinienkernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Kugeln auf die vorbereiteten Backbleche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie 12-15 Minuten, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie 5 Minuten auf dem Blech abkühlen, lege sie dann auf ein Kuchengitter und bestäube sie vor dem Servieren leicht mit Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
