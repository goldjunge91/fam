      "steps": [
        {
          "position": 0,
          "text": "Röste ganze rote Paprika über offener Flamme oder unter dem Grill, bis sie rundherum schwarz sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die heißen Paprika 10 Minuten in eine Plastiktüte zum Dämpfen und ziehe die verkohlte Haut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entferne Stiele und Kerne der Paprika.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geröstete Paprika, Mandeln, Haselnüsse, Knoblauch, Tomaten und Paprikapulver in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pulse die Zutaten zu einer groben Paste und gib dann Essig und Olivenöl dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verarbeite alles bis zur gewünschten Konsistenz; traditionell bleibt die Sauce leicht stückig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Sauce mit gegrilltem Brot oder Gemüse oder zu Fisch oder Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
