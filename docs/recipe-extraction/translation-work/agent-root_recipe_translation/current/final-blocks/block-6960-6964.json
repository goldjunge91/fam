      "steps": [
        {
          "position": 0,
          "text": "Muscheln unter kaltem Wasser abspülen und eventuelle Bärte mit einem scharfen Messer entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und den Knoblauch anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerkleinerte Tomaten, Weißwein, Salz, Pfeffer und rote Pfefferflocken in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Sauce 5 Minuten köcheln lassen, um die Aromen zu verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geputzte Muscheln in die Soße geben und den Topf abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "5-7 Minuten kochen lassen, bis sich die Muschelschalen vollständig öffnen, dabei alle verschlossenen Schalen wegwerfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fügen Sie frisches Basilikum hinzu und probieren Sie es ab, um die Gewürze anzupassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Muscheln und Soße zu den gekochten Nudeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
