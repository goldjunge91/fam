      "steps": [
        {
          "position": 0,
          "text": "Mehl, Zucker und Salz in einer Schüssel vermischen, dann Ei, Wein und 2 Esslöffel Öl hinzufügen, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt ist, dann einwickeln und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig auf einer bemehlten Fläche sehr dünn ausrollen und in 3 Zoll große Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitzen Sie 2 Liter Öl in einem tiefen Topf auf 375 °F und braten Sie die Teigquadrate, die um Cannoli-Röhrchen aus Metall gewickelt sind, goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nehmen Sie die frittierten Schalen heraus und kühlen Sie sie auf Papiertüchern ab, bevor Sie sie aus den Röhrchen schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für die Füllung Ricotta, Puderzucker, Schokoladenstückchen und Vanilleextrakt in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Spritzbeutel die Ricotta-Füllung in beide Enden der abgekühlten Cannoli-Schalen spritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gefüllte Cannoli mit Puderzucker bestäuben und innerhalb weniger Stunden servieren, um eine optimale Knusprigkeit zu erzielen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
