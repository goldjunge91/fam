      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf mit Wasser füllen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geben Sie das Crab Boil-Gewürzpaket, das Salz und die Zitronenhälften in das kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fügen Sie Babykartoffeln hinzu und kochen Sie sie 8 Minuten lang, bis sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mais und geschnittene geräucherte Wurst hinzufügen und weitere 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garnelen hinzufügen und 3-4 Minuten kochen lassen, bis sie rosa werden und sich kräuseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lassen Sie den gesamten Inhalt durch ein Sieb abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf eine große Servierplatte geben und mit Butter und Old Bay-Gewürzen vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren, mit zusätzlich geschmolzener Butter zum Dippen als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
