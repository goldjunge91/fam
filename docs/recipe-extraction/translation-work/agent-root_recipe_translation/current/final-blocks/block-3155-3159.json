      "steps": [
        {
          "position": 0,
          "text": "Reis und Mungbohnen zusammen unter kaltem Wasser abspülen, bis das Wasser klar ist, dann gut abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ghee in einem großen Topf bei mittlerer Hitze erhitzen und Kreuzkümmelsamen hinzufügen; etwa 30 Sekunden braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Ingwer hinzufügen und etwa 3 Minuten dünsten, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kurkumapulver einrühren und 30 Sekunden garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgespülten Reis und Mungbohnen hinzufügen, umrühren, sodass sie mit Ghee überzogen sind, und 1 Minute anrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brühe angießen und aufkochen, dann die Hitze reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 20 Minuten köcheln lassen, bis Reis und Bohnen sehr weich und cremig sind; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz würzen, Koriander unterheben und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
