      "steps": [
        {
          "position": 0,
          "text": "Sojasauce, Zucker, Mirin und Knoblauch in einer kleinen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pflanzenöl in einer großen Pfanne bei starker Hitze erhitzen und Rindfleischscheiben etwa 2 Minuten kurz anbraten, bis sie gebräunt sind; beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel in derselben Pfanne bei mittelhoher Hitze etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rindfleisch zurück in die Pfanne geben, Sauce angießen und 2 Minuten garen, bis das Fleisch durchgegart und mit Sauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reis auf Schalen verteilen und mit der Rindfleisch-Zwiebel-Mischung belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sesamöl über jede Schale träufeln und vorsichtig ein rohes oder leicht gegartes Ei darauf aufschlagen (die Hitze stockt es teilweise).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Sesamsamen und Frühlingszwiebeln garnieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
