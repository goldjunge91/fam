      "steps": [
        {
          "position": 0,
          "text": "Vermische Rinderhack, Schweinehack, Semmelbrösel, Ei, Parmesan, Knoblauch, Salz und Pfeffer in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rolle die Masse zu 1.5-inch großen Fleischbällchen; es sollten etwa 16-20 Stück werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine große Pfanne bei mittlerer bis hoher Hitze und brate die Fleischbällchen portionsweise 3-4 Minuten an, dabei gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Marinara-Sauce über die Fleischbällchen und bringe sie zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse alles unter gelegentlichem Rühren 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche inzwischen die Pasta nach Packungsangabe und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Pasta auf Schalen und gib Fleischbällchen und Sauce darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sofort und reiche zusätzlichen Parmesan dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
