        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und stelle eine 9-inch Pastetenform auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einer großen Pfanne und dünste Zwiebel, Sellerie und Karotte etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue Mehl über das Gemüse und brate es unter ständigem Rühren 1 Minute mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße nach und nach die Brühe dazu und rühre, bis die Sauce nach etwa 2-3 Minuten eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre gegartes Putenfleisch und Erbsen ein und fülle die Mischung in die Pastetenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den Teigboden über die Füllung, schneide überstehenden Teig ab und drücke den Rand mit einer Gabel fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide Dampfschlitze in den Deckel und bestreiche ihn mit verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Pastete 30-35 Minuten, bis der Teig goldbraun ist und die Füllung am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
