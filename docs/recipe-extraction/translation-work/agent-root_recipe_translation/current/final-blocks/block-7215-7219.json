      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in 1/4-inch dicke Stifte und lege sie 30 Minuten in kaltes Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem tiefen Topf oder einer Fritteuse auf 325°F. Frittiere die Kartoffeln portionsweise 5-7 Minuten goldbraun. Lasse sie auf Küchenpapier abtropfen und salze sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile das Hackfleisch in zwei 1/4-lb Patties. Würze beide Seiten mit Salz und Pfeffer und drücke mit dem Daumen eine kleine Mulde in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze und brate die Patties je Seite 3-4 Minuten bis zum gewünschten Gargrad. Gib in der letzten Minute den Käse darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Burgerbrötchen leicht in der Pfanne oder im Toasterofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Brötchen mit Ketchup und Senf. Belege sie mit Salat, Tomatenscheibe, Zwiebel und Patty mit geschmolzenem Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Burger sofort mit den heißen Pommes.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
