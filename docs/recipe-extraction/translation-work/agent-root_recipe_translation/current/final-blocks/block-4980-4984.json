      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine runde 9-inch Kuchenform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mehl, Zucker, Kakao, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, Öl und Vanille und vermische die Eiermischung anschließend mit den trockenen Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre heißes Wasser ein, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in die Form und backe ihn 30-35 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass den Kuchen vollständig abkühlen und bestreiche ihn dann mit blau gefärbtem Frischkäse-Frosting.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Forme das Frosting mit einem Spritzbeutel zu einer Toilettenschüssel auf dem Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
