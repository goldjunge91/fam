      "steps": [
        {
          "position": 0,
          "text": "Vermische Joghurt, Chilipulver, Kurkuma, Knoblauch, Ingwer, Zitronensaft, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rindfleischwürfel hinzu, bedecke sie vollständig mit der Marinade und stelle sie mindestens 30 Minuten oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke mariniertes Rindfleisch und Zwiebelstücke abwechselnd auf Metallspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne oder Grillpfanne bei hoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Spieße auf die heiße Fläche und gare das Fleisch je Seite 3-4 Minuten, bis es angebräunt und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Spieße portionsweise, damit die Pfanne nicht zu voll wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das gegarte Sekuwa auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Fladenbrot, Reis und frischen Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
