      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, 0.5 Teelöffel Salz und Öl in einer Schüssel und gib nach und nach Wasser hinzu, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 5 Minuten gut durch, decke ihn mit einem feuchten Tuch ab und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische geriebenen Paneer mit Zwiebel, Koriander, grüner Chili, Ingwer, Salz und Pfeffer zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig auf einer bemehlten Fläche dünn aus und stich mit einem 3 Zoll großen Ausstecher Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib einen Löffel Füllung in die Mitte jedes Kreises, falte die Ränder und forme sie mit Falten zu einem Säckchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gib die Momos portionsweise vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche sie, bis sie an die Oberfläche steigen, und lasse sie dann weitere 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und serviere sie heiß mit Chutney oder Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
