      "steps": [
        {
          "position": 0,
          "text": "Erhitze Milch bis zum Kochen und gib unter Rühren langsam Essig hinzu, bis sich der Käsebruch vollständig von der Molke trennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Seihe den Käsebruch durch ein Mulltuch ab und lasse ihn 10 Minuten aufgehängt, damit überschüssige Feuchtigkeit abläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete Paneer und Mehl zu einem glatten, weichen Teig und forme 12 gleich große Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche Wasser mit Zucker und zerstoßenem Kardamom zu Sirup und lasse ihn auf Raumtemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Paneer-Kugeln einzeln vorsichtig ins kochende Wasser und lasse sie an die Oberfläche steigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wenn alle Kugeln oben schwimmen, lasse sie 8-10 Minuten köcheln, bis sie um ein Drittel größer geworden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lege sie sofort in den abgekühlten Zuckersirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Rosenwasser zum Sirup und stelle die Rasgulla vor dem Servieren mindestens 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
