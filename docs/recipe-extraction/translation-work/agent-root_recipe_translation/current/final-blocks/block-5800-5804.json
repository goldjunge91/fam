      "steps": [
        {
          "position": 0,
          "text": "Gare die gewürfelte Hähnchenbrust mit Wasser, gewürfelter Zwiebel und Knoblauch in einem Topf etwa 15 Minuten, bis sie durchgegart ist. Zupfe das Fleisch auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische das gezupfte Hähnchen mit 1/2 Tasse Enchilada-Soße, saurer Sahne, der Hälfte des Käses, gehackter Jalapeño, Koriander und Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Tortillas in einer Pfanne bei mittlerer Hitze 30 Sekunden pro Seite, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile eine dünne Schicht Enchilada-Soße auf dem Boden einer 9x13-Zoll-Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle jede Tortilla mit 3 Esslöffel der Hähnchenmischung, rolle sie fest auf und lege sie mit der Naht nach unten in die Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die restliche Enchilada-Soße gleichmäßig über die Rollen und streue den übrigen Käse darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Enchiladas bei 350°F 25 Minuten, bis die Soße blubbert und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere sie mit zusätzlichem Koriander und serviere sie mit Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
