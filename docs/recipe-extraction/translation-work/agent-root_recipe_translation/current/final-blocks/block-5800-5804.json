      "steps": [
        {
          "position": 0,
          "text": "Weiche die Holzspieße 30 Minuten in Wasser ein, damit sie nicht verbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Hähnchenbrust in 1-Zoll große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Erdnussbutter, Sojasoße, Limettensaft, gehackten Knoblauch, Ingwer, braunen Zucker, Chiliflocken und Kokosmilch zu einer glatten Erdnusssoße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke je 4-5 Hähnchenwürfel auf die Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Hälfte der Erdnusssoße zum Dippen beiseite und vermenge die übrige Soße mit den Hähnchenspießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Spieße bei mittlerer bis hoher Hitze 10-12 Minuten. Wende sie alle 2-3 Minuten, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Spieße heiß mit der beiseitegestellten Erdnusssoße zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
