          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle die ganze Platte mit Olivenöl und Balsamicoessig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Streue Meersalz und frisch gemahlenen schwarzen Pfeffer darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zupfe die frischen Basilikumblätter ab und verteile sie darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht sofort bei Zimmertemperatur.",
