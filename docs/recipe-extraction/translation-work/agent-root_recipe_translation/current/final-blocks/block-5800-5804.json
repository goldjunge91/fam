      "steps": [
        {
          "position": 0,
          "text": "Lege die Hähnchenbrust zwischen Frischhaltefolie und klopfe sie auf 1/2-Zoll Dicke flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite drei Schüsseln zum Panieren vor: eine mit Mehl, eine mit verquirlten Eiern und eine mit Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze das Hähnchen mit Salz und Pfeffer und wende jedes Stück nacheinander in Mehl, Ei und Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate das panierte Hähnchen portionsweise 4-5 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile eine dünne Schicht Marinara-Soße auf dem Boden einer 9x13-Zoll-Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege paniertes Hähnchen, die restliche Marinara-Soße, Mozzarella und Parmesan schichtweise in die Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe das Gericht bei 400°F 20-25 Minuten, bis der Käse blubbert und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischem Basilikum und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
