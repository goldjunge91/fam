      "steps": [
        {
          "position": 0,
          "text": "Mahle getrocknete rote Chilischoten, Koriandersamen, schwarze Pfefferkörner und geraspelte Kokosnuss mit 0.5 Tasse Wasser zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Kokosöl in einem schweren Topf bei mittlerer bis hoher Hitze und brate geschnittene Zwiebeln etwa 5 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwer-Knoblauch-Paste dazu und gare sie 1 Minute. Füge dann Rind- oder Lammfleisch hinzu und brate es etwa 5-7 Minuten an, bis es rundherum versiegelt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gemahlene Gewürz-Kokos-Paste zum Fleisch und gare sie unter ständigem Rühren 2-3 Minuten, bis der rohe Geruch verschwunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte Tomaten und Tamarindenpaste dazu und gare alles 2-3 Minuten, bis die Tomaten weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Wasser dazu und würze mit Salz. Bringe alles zum Kochen, reduziere dann die Hitze auf niedrig, decke den Topf ab und lass das Fleisch 30-35 Minuten köcheln, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Deckel ab und lass alles weitere 5 Minuten köcheln, damit die Sauce etwas eindickt und das Fleisch überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke ab, würze mit Salz und Gewürzen nach und serviere das Gericht heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
