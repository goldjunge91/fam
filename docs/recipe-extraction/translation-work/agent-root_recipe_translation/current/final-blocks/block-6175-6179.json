      "steps": [
        {
          "position": 0,
          "text": "Streife die Murungai-Blätter vorsichtig mit den Fingern von den holzigen Stielen ab. Wirf die Stiele weg und spüle die Blätter gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Kokosöl in einer großen Pfanne bei mittlerer Hitze und gib schwarze Senfsamen dazu. Lass sie 20 Sekunden knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kichererbsenhälften und getrocknete rote Chilischoten dazu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gehackte Zwiebel ein und gare sie 2 Minuten, bis sie glasig ist. Gib dann Ingwer-Knoblauch-Paste und grüne Chilischoten dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kurkumapulver dazu und gare es 30 Sekunden. Füge dann Murungai-Blätter hinzu und rühre 4-5 Minuten ständig, bis sie vollständig zusammengefallen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Salze nach Geschmack und gare alles weitere 1-2 Minuten, bis die gesamte Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß als Beilage zu Reis, Dhal und Sambar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
