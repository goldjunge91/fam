      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 Esslöffel Ghee in einer Pfanne und brate Cashewkerne und Rosinen etwa 2 Minuten goldbraun an. Nimm sie heraus und stelle sie auf einem Teller beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das restliche Ghee in dieselbe Pfanne und röste Reismehl bei mittlerer Hitze 3-4 Minuten unter ständigem Rühren an, bis es hellbraun und aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geraspelte Kokosnuss zum gerösteten Mehl und gare alles unter Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße langsam und unter ständigem Rühren Wasser dazu, damit keine Klümpchen entstehen. Gare alles 2-3 Minuten, bis die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und gib geraspelten Palmzucker, zerstoßenen Kardamom, Salz sowie die gebratenen Cashewkerne und Rosinen dazu. Vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drücke die noch warme Masse in eine zylindrische Puttu-Form oder einen gefetteten Behälter und lass sie 5-10 Minuten abkühlen und fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stürze die Masse aus der Form, schneide sie in 1 Zoll dicke Scheiben und serviere sie bei Zimmertemperatur oder leicht erwärmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
