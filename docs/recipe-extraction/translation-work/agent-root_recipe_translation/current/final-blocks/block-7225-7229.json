      "steps": [
        {
          "position": 0,
          "text": "Halbiere jede Hähnchenbrust längs, sodass 4 dünne Schnitzel entstehen. Tupfe sie trocken, würze beide Seiten mit Salz und Pfeffer und wende sie leicht in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze. Brate das Hähnchen je Seite 4-5 Minuten goldbraun und gar. Lege es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf mittlere Stufe und gib Butter hinzu. Rühre gehackten Knoblauch und getrocknete Tomaten ein und brate sie 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe dazu und löse die Bratrückstände vom Pfannenboden. Rühre Sahne, italienische Kräuter und Chiliflocken ein. Lasse die Sauce 2-3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Parmesan ein, bis die Sauce glatt und leicht eingedickt ist. Probiere und passe Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Hähnchen zurück in die Sauce, löffle Sauce darüber und lasse es 3-4 Minuten köcheln, bis es heiß ist und die Sauce den Löffel überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere mit frischem Basilikum und serviere das Hähnchen zu Pasta, Reis oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": []
