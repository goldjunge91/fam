      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf oder Schmortopf bei mittlerer bis hoher Hitze. Brate den Rinderbraten auf jeder Seite 2-3 Minuten an, bis er gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Fleisch heraus. Dünste gewürfelte Zwiebel und gehackten Knoblauch im selben Topf 2-3 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Fleisch zurück in den Topf und gib Rinderbrühe, italienische Kräuter, Chiliflocken, Salz und Pfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass alles aufköcheln, decke den Topf ab und gare das Fleisch 30-35 Minuten, bis es sehr zart ist und sich mit zwei Gabeln leicht zerzupfen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch aus der Brühe und zerzupfe es mit zwei Gabeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das gezupfte Fleisch zurück in die Brühe, rühre Giardiniera samt Lake ein und lasse alles weitere 2-3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Röste die Sandwichbrötchen leicht. Fülle das Fleisch mit einer Schaumkelle hinein und serviere dazu eine kleine Schale Kochbrühe zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
