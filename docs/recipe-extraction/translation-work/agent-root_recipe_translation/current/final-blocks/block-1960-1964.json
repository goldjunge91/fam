      "steps": [
        {
          "position": 0,
          "text": "Gib alle Zutaten in eine große Pfanne bei mittlerer Hitze und decke sie mit einem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare alles bei mittlerer Hitze 10 Minuten und rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere nach 10 Minuten die Hitze auf niedrig und gare alles weitere 5 Minuten, bis der Kohl weich und zart ist. Nimm die Pfanne vom Herd und entferne vor dem Servieren die Thymianstängel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
