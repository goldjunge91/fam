      "steps": [
        {
          "position": 0,
          "text": "Ausrüstung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schwerer Schmortopf",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Reis, Kokosmilch, Kidneybohnen, Wasser, grobes Salz, Piment und schwarzen Pfeffer in einen großen Topf und verrühre alles. Lege Frühlingszwiebeln, Thymian und Scotch-Bonnet-Chili darauf. Bringe die Mischung zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sobald alles kocht, reduziere die Hitze auf niedrig und decke den Topf ab. Gare den Reis zugedeckt 18 Minuten bei niedriger Hitze und nimm den Topf dann vom Herd. Lass den Deckel weitere 5 Minuten geschlossen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öffne den Deckel und entferne Frühlingszwiebeln, Scotch-Bonnet-Chili und Thymian. Lockere Reis und Bohnen mit einer Gabel auf. Servieren und genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
