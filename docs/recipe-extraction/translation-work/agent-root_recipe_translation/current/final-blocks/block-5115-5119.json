      "steps": [
        {
          "position": 0,
          "text": "Koche die Eiernudeln nach Packungsanleitung, lass sie abtropfen und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Rinderlende quer zur Faser in dünne Streifen und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate das Rindfleisch portionsweise pro Seite 2-3 Minuten an. Lege es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste in derselben Pfanne gewürfelte Zwiebel weich an. Gib gehackten Knoblauch und geschnittene Pilze dazu und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in die Pfanne und gieße Rinderbrühe dazu. Bringe alles zum Köcheln und gare es 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd und rühre saure Sahne glatt ein. Erwärme die Sauce vorsichtig, ohne sie kochen zu lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Stroganoff über den gekochten Eiernudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
