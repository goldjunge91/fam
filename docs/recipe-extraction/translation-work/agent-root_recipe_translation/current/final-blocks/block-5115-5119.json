      "steps": [
        {
          "position": 0,
          "text": "Würfle Zwiebel, Sellerie und Karotte fein und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze. Gib Rind- und Schweinefleisch dazu und brate es unter Zerkrümeln etwa 8 Minuten an, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das gewürfelte Gemüse dazu und gare es etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre das Tomatenmark ein und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein dazu und lass ihn etwa 3 Minuten köcheln, bis die Flüssigkeit auf die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Dosentomaten dazu und bringe die Sauce zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze und lass die Sauce ohne Deckel 1.5 Stunden köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Milch ein, würze mit Salz und Pfeffer und lass die Sauce weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die Sauce mit frisch gekochter Pasta.",
