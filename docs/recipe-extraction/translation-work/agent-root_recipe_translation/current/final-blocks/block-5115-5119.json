      "steps": [
        {
          "position": 0,
          "text": "Reibe die Schweineschulter von allen Seiten mit Paprikapulver, braunem Zucker, Salz und Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Zwiebel in Stücke und lege sie zusammen mit zerdrückten Knoblauchzehen in den Schongarer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Schweineschulter auf die Zwiebeln und gieße Hühnerbrühe und Apfelessig darum herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Schongarer ab und gare das Fleisch 8 Stunden auf niedriger Stufe, bis es sehr zart ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Schweinefleisch aus dem Schongarer und lass es 10 Minuten ruhen. Zerpflücke es dann mit zwei Gabeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Garflüssigkeit aus dem Schongarer ab und entsorge die festen Bestandteile.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das zerrupfte Schweinefleisch zurück in den Schongarer und rühre Barbecue-Sauce ein. Gare es weitere 30 Minuten auf niedriger Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
