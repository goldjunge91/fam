      "steps": [
        {
          "position": 0,
          "text": "Schneide die Süßkartoffeln in Würfel und röste sie bei 425°F 20 Minuten, bis sie weich und leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass die Kichererbsen aus der Dose abtropfen und spüle sie ab. Vermenge sie mit 1/2 Teelöffel Salz und röste sie während der letzten 10 Minuten zusammen mit den Süßkartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite das Tahini-Dressing zu, indem du Tahini, Zitronensaft, gehackten Knoblauch, Olivenöl und Wasser glatt und gießbar verrührst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile Spinat als Grundlage auf Schüsseln und belege ihn mit gerösteten Süßkartoffeln und Kichererbsen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib halbierte Kirschtomaten, gewürfelte Gurke und dünn geschnittene rote Zwiebel auf jede Bowl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle jede Bowl großzügig mit Tahini-Dressing und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
