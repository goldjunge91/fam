      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchenschenkel mit Salz und Pfeffer, bräune sie in Butter in einem großen Schmortopf 4-5 Minuten pro Seite und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste im selben Topf Perlzwiebeln und in Scheiben geschnittene Pilze 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestäube das Gemüse mit Mehl, rühre 1 Minute um und lösche dann mit Weißwein ab. Kratze dabei die Bratrückstände vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hähnchen mit Brühe und Thymian zurück in den Topf, decke ihn ab und lasse alles 25-30 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd, rühre Sahne ein und schmecke das Gericht vor dem Servieren ab. Serviere es mit Reis oder Eiernudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
