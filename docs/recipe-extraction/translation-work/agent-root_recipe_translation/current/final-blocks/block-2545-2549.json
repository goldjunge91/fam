      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Seezungenfilets mit Küchenpapier trocken und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle das Ei in einer flachen Schüssel, wende jedes Filet darin und bestäube es leicht mit Mehl. Schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz 2 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Filets 3-4 Minuten pro Seite, bis sie goldbraun und flockig sind, und lege sie dann auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die übrigen 2 Esslöffel Butter in die Pfanne und lasse sie 1-2 Minuten bräunen. Gieße sie dann mit frischem Zitronensaft und gehackter Petersilie über den Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
