      "steps": [
        {
          "position": 0,
          "text": "Selbsttreibendes Mehl und Salz in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In der Mitte eine Mulde formen und geschmolzene Butter sowie den Großteil des Wassers hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit einem Holzlöffel zu einem weichen Teig verrühren. Bei Bedarf mehr Wasser hinzufügen; der Teig sollte leicht klebrig sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig auf eine bemehlte Fläche geben und 2–3 Mal vorsichtig kneten, bis er zusammenhält. Nicht zu lange kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zu einem runden Laib von etwa 2 Zoll Dicke formen und auf ein Stück Folie legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Direkt auf den Kohlen oder auf einem Rost 4–6 Zoll über mittlerer Hitze 25–30 Minuten garen und gelegentlich drehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Holzspieß prüfen: Kommt er sauber heraus, ist das Brot fertig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm aufschneiden und mit Honig oder Butter servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
