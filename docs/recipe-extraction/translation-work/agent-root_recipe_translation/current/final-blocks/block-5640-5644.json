          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter oder Schmalz hinzufügen und mit den Fingern ins Mehl einarbeiten, bis die Mischung groben Brotkrümeln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Unter Rühren nach und nach Wasser zugießen, bis ein weicher, klebriger Teig entsteht. Falls er zu feucht ist, weniger Wasser verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig auf einer bemehlten Fläche in 4 Portionen teilen. Jede zu einem etwa 1/2 Zoll dicken Fladen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bannock je Seite 3–4 Minuten goldbraun und gar braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm mit Honig, Marmelade oder Butter servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
