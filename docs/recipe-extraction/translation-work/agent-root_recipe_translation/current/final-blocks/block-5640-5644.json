      "steps": [
        {
          "position": 0,
          "text": "Die Maishüllblätter zurückziehen, aber nicht ganz entfernen. Möglichst viel Maisseide abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hüllblätter wieder über die Maiskörner klappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Mais mindestens 10 Minuten in Wasser einweichen, damit die Hüllblätter nicht verbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den eingeweichten Mais direkt auf einen Rost 4–6 Zoll über die Kohlen legen oder in Folie wickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "15–20 Minuten garen und gelegentlich mit einer Zange wenden, bis die Hüllblätter leicht verkohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Mais vorsichtig vom Feuer nehmen und die Hüllblätter abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Großzügig mit weicher Butter bestreichen und vor dem Servieren mit Salz, Pfeffer und Knoblauchpulver würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
