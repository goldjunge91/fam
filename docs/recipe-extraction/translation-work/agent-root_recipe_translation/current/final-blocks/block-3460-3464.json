      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln weich kochen, schälen und in einer großen Schüssel zerstampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch mit gehackter Zwiebel, Knoblauch und Currypulver in einer Pfanne anbraten; dabei zerteilen und 5-6 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das gegarte Fleisch mit Salz und Pfeffer nach Geschmack unter die Kartoffeln mischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung etwas abkühlen lassen und dann zu ovalen Bratlingen von etwa 2 inches Länge formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drei flache Schalen bereitstellen; in eine die verquirlten Eier und in eine andere die Semmelbrösel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jedes Cutlet erst in verquirltem Ei wenden und dann gründlich mit Semmelbröseln bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Cutlets portionsweise je Seite 2-3 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Limettenspalten oder Currysauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
