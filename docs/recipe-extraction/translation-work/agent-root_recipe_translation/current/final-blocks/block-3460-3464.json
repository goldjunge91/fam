      "steps": [
        {
          "position": 0,
          "text": "Mehl, 1 verquirltes Ei und Salz vermengen, dann nach und nach Wasser hinzufügen, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine beschichtete Pfanne oder einen Crêpe-Maker erhitzen und leicht mit Öl einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine dünne Teigschicht hineingießen und etwa 1 Minute pro Seite garen, bis sie fest, aber noch biegsam ist; so dünne Crêpe-Blätter herstellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffeln weich kochen, schälen und nach Geschmack mit Salz zerstampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hackfleisch mit Zwiebel, Currypulver und Knoblauch 5-6 Minuten in einer Pfanne anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das gegarte Fleisch unter die Kartoffeln mischen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eine dünne Schicht Füllung auf jedes Crêpe-Blatt streichen, fest aufrollen und wie eine Frühlingsrolle falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die übrigen 2 Eier in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rolle in das verquirlte Ei tauchen und in heißem Öl flach frittieren, bis alle Seiten goldbraun sind, insgesamt etwa 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Chutney oder Currysauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
