      "steps": [
        {
          "position": 0,
          "text": "Unreife Mangos schälen und in dünne Streifen oder mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rote Chilischoten schneiden und Knoblauch sowie Ingwer zusammen fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer Pfanne erhitzen und Senfkörner sowie Bockshornkleesamen hineingeben, bis sie knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch und Ingwer hinzufügen und 30 Sekunden anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mangostücke und gehackte Chilis hinzufügen, umrühren und 3-4 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Salz und Essig hinzufügen, gut vermischen und 5 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vollständig abkühlen lassen und zur Aufbewahrung in ein Glas füllen.",
          "timerMinutes": null,
