      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, eine Mulde formen und unter Rühren nach und nach Wasser hinzufügen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt und elastisch ist, dann 30 Minuten abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in 4 gleiche Portionen teilen und jeweils dünn ausrollen, dann großzügig mit Olivenöl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die geölten Teigblätter übereinander legen, vierteln und 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Ftira zu einem dünnen Kreis ausrollen, Olivenöl in einer Pfanne erhitzen und braten, bis sie auf beiden Seiten aufgebläht und hellbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für die Füllung abgetropften Thunfisch, gehackte Zwiebeln, Harissa und gehackte Petersilie vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schlagen Sie ein Ei in die Mitte jedes heißen Ftira, geben Sie die Thunfischmischung darauf, falten Sie die Ränder nach innen und kochen Sie, bis das Ei fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
