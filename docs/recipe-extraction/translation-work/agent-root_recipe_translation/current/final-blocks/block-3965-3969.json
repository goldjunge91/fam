      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und die Rindfleischstücke von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf gewürfelte Zwiebeln und gehackten Knoblauch 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Harissa-Paste einrühren und 1 Minuten kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomaten mit Saft, Rinderbrühe, Kümmel, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Fleisch wieder in den Topf geben, zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 25 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abgetropfte Kichererbsen hinzufügen und weitere 10 Minuten köcheln lassen, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und würzen, dann heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
