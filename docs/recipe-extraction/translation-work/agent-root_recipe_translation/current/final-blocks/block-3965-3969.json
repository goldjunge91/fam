      "steps": [
        {
          "position": 0,
          "text": "Die Wursthüllen 30 Minuten lang in warmem Wasser einweichen, um sie weicher zu machen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lammhackfleisch, Harissa, gehackten Knoblauch, Kümmel, Paprika, Salz und Pfeffer in einer Schüssel gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Setzen Sie eine Wursthülle auf eine Wurstfülldüse und füllen Sie sie langsam mit der Fleischmischung, wobei Sie dabei Lufteinschlüsse einstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drehen Sie die gefüllte Hülle in 4 Zoll-Glieder und befestigen Sie sie bei Bedarf mit Küchengarn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Olivenöl in einer Pfanne bei mittlerer Hitze erhitzen und Merguez-Würstchen 12-15 Minuten kochen, dabei gelegentlich wenden, bis sie braun und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiß mit Brot und Harissa oder in Couscous servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
