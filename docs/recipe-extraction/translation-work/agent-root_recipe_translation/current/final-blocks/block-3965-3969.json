      "steps": [
        {
          "position": 0,
          "text": "Auberginen und Zucchini würfeln und in einem großen Topf in Olivenöl anbraten, bis sie leicht gebräunt sind, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf gewürfelte Zwiebeln und gehackten Knoblauch 3 Minuten anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reis hinzufügen und umrühren, bis er mit Öl bedeckt ist, und 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gemüsebrühe, Paprika, Salz und Pfeffer hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das gekochte Gemüse wieder in den Topf geben und gewürfelte Tomaten unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe, decken Sie den Reis ab und lassen Sie ihn 20 Minuten köcheln, bis der Reis weich ist und die Flüssigkeit aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen und 5 Minuten ruhen lassen, dann auf eine Servierplatte stürzen und den Reiskuchen umdrehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
