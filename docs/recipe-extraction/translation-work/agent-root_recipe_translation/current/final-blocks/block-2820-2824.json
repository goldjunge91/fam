      "steps": [
        {
          "position": 0,
          "text": "Püriere Erdnussbutter, Kokosmilch, Knoblauch, Zwiebel, Sojasauce, Limettensaft, Zucker und Chili zu einer glatten Sauce. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stecke die Hähnchenstreifen auf eingeweichte Bambusspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und gare die Spieße 4-5 Minuten pro Seite, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die Erdnusssauce 2-3 Minuten in einem kleinen Topf bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die gegarten Satay-Spieße mit Erdnusssauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
