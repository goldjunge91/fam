      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einer Pfanne und brate das Schweinehackfleisch, bis es gebräunt ist. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch und Zwiebel zum Fleisch und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Kohl, Karotten, Sojasauce, Salz und Pfeffer ein und gare alles 3-4 Minuten, bis das Gemüse leicht weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd und lasse die Füllung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege 2 Esslöffel Füllung auf das untere Drittel jedes Lumpia-Blatts, klappe die Seiten ein und rolle es fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze 3 Tassen Öl in einem tiefen Topf auf 350°F und frittiere die Lumpia portionsweise 2-3 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit süßer Chilisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
