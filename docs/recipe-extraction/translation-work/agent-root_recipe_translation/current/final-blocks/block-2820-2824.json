      "steps": [
        {
          "position": 0,
          "text": "Vermische Rinderhackfleisch, Tapiokastärke, Ei, Zwiebel und Knoblauch in einer Schüssel, bis alles gerade eben vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Rinderbrühe mit Salz und Sojasauce in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme mit einem Löffel oder Eisportionierer 20-24 kleine Bällchen aus der Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Fleischbällchen vorsichtig in die kochende Brühe und lasse sie 8-10 Minuten köcheln, bis sie an die Oberfläche steigen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Reisnudeln separat nach Packungsanleitung, gieße sie ab und verteile sie auf Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Pak Choi in die Brühe und gare ihn 2-3 Minuten, bis er zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile Fleischbällchen, Gemüse und Brühe auf den Nudeln in den Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
