      "steps": [
        {
          "position": 0,
          "text": "Saganaki-Käse in 1 cm dicke Scheiben schneiden und leicht mit Mehl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer flachen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie die Käsescheiben vorsichtig in das heiße Öl und braten Sie sie 2 Minuten pro Seite, bis sie außen goldbraun und knusprig, aber innen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf einen hitzebeständigen Teller oder eine flache Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärmen Sie den Brandy in einem kleinen Löffel über einer Flamme und gießen Sie ihn dann vorsichtig über den Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zünden Sie den Alkohol mit einem langen Feuerzeug oder Streichholz an und lassen Sie ihn 30 Sekunden lang flammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Drücken Sie frischen Zitronensaft über den brennenden Käse und löschen Sie die Flamme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit knusprigem Brot zum Ausstechen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
