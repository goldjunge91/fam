      ],
      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch in einem großen Topf bei mittlerer bis hoher Hitze anbraten, während des Kochens zerkleinern und dann überschüssiges Fett abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch zum Rindfleisch geben und 3-4 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Chilipulver und Kreuzkümmel einrühren und 1 Minute kochen lassen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerkleinerte Tomaten, Tomatensauce, Kidneybohnen mit Flüssigkeit, Rinderbrühe und Worcestershire-Sauce hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Köcheln bringen und die Hitze auf eine niedrige Stufe reduzieren, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ohne Deckel 60–75 Minuten köcheln lassen, dabei alle 15 Minuten umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren, optional mit Toppings wie geriebenem Cheddar-Käse und gewürfelten Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
