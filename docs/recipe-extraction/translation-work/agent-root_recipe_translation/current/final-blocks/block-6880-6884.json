      "steps": [
        {
          "position": 0,
          "text": "Hähnchenschenkel trocken tupfen und großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und das Hähnchen mit der Hautseite nach unten 4–5 Minuten anbraten, dann umdrehen und auf der anderen Seite anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hähnchen auf einen Teller legen und die Kartoffeln in die gleiche Pfanne geben und 3–4 Minuten leicht bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch in die Pfanne geben und 1 Minute kochen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das Huhn wieder in die Pfanne, fügen Sie Weißwein und Hühnerbrühe hinzu und bestreuen Sie es mit Oregano.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, abdecken und 25–30 Minuten schmoren, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gefrorene Erbsen unterrühren und weitere 5 Minuten ohne Deckel köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit frischem Zitronensaft abschließen und vor dem Servieren nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
