      "steps": [
        {
          "position": 0,
          "text": "Lassen Sie die Gelatineblätter 5 Minuten lang in kaltem Wasser einweichen, erhitzen Sie dann den Rübensaft vorsichtig und rühren Sie die Gelatine unter, bis sie sich auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In eine flache Pfanne gießen und kühl stellen, bis es fest ist, dann in kleine Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erstellen Sie Apfelsaftkügelchen, indem Sie den Saft mithilfe einer Sphärifizierungstechnik mit einer Spritze in ein Natriumalginatbad tropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereiten Sie eine Dashi-Soja-Reduktion zu, indem Sie Dashi-Brühe mit Sojasauce 10 Minuten lang köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teller, indem Sie Mikrogrün, essbare Blumen und vorbereitete Elemente auf einem weißen Teller in kunstvollen Mustern anordnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das reduzierte Dashi und das Olivenöl strategisch auf dem Teller verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fügen Sie kurz vor dem Servieren vorsichtig flüssigen Stickstoff hinzu, um einen visuellen Raucheffekt zu erzielen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Fleur de Sel abschließen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
