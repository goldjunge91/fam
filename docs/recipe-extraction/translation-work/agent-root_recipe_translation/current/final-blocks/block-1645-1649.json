      "steps": [
        {
          "position": 0,
          "text": "Daikon reiben und mit dem eigenen Saft 5 Minuten in der Pfanne garen. Eingeweichte Shiitake, rehydrierte Garnelen und geschnittene Wurst dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reismehl mit Wasser zu einem dickflüssigen Teig verrühren. Daikon-Mischung dazugeben und würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In eine geölte Form füllen und 45 Minuten dämpfen, bis die Masse fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vollständig abkühlen lassen und in ½ Zoll dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In Öl auf beiden Seiten knusprig goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Hoisin- oder Chilisauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
