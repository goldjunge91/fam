      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch, Zwiebeln, Knoblauch, Semmelbrösel, Ei, Petersilie, Salz, schwarzen Pfeffer und Cayenne in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mit den Händen vorsichtig vermischen, bis alles gerade verbunden ist, und in 16 Fleischbällchen teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Fleischbällchen insgesamt etwa 10 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatensauce zugießen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze auf mittlere bis niedrige Stufe reduzieren, abdecken und 20 Minuten köcheln lassen, bis die Fleischbällchen durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und bei Bedarf nachwürzen, dann heiß über Reis oder mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
