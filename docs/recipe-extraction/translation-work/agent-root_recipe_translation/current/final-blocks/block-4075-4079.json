      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und Zwiebeln sowie Knoblauch bei mittlerer Hitze etwa 5 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomatenmark hinzufügen und unter ständigem Rühren 2 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brühe zugießen und zum Kochen bringen. Kartoffeln und Karotten hinzufügen und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den ganzen Fisch vorsichtig in den Topf legen, mit Salz, Pfeffer und Thymian würzen und 15 Minuten köcheln lassen, bis er fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch vorsichtig herausnehmen und beiseitelegen. Brühe in einen anderen Topf abseihen und das Gemüse zurückbehalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brühe zurück in den Topf geben und zum Kochen bringen. Reis einrühren, abdecken, Hitze reduzieren und 18 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reis mit einer Gabel auflockern, auf einer Servierplatte anrichten, mit dem gegarten Gemüse und zerpflücktem Fisch belegen und mit Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
