      "steps": [
        {
          "position": 0,
          "text": "Würze das Flankensteak mit Salz und Pfeffer. Grille es oder brate es bei hoher Hitze pro Seite 3-4 Minuten für eine eher blutige Garstufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass das Steak 5 Minuten ruhen und schneide es dann quer zur Faser in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Fischsauce, Limettensaft, gehackten Knoblauch, Zucker und Chiliflocken zu einem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die rote Zwiebel in dünne Scheiben und lege sie 5 Minuten in kaltes Wasser, damit ihr scharfer Geschmack milder wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge den Blattsalat mit dem Dressing und verteile ihn auf Tellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte die warmen Rindfleischscheiben, abgetropfte Zwiebel und Jalapeño-Scheiben darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere den Salat mit frischem Koriander und Minze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn sofort mit zusätzlichen Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
