      "steps": [
        {
          "position": 0,
          "text": "Bringe einen Topf Wasser zum Kochen und gib vorsichtig 8 Eier hinein. Koche sie 6 Minuten weich, kühle sie in Eiswasser ab und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die gemahlene Wurst in einer Schüssel mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Wurstmasse in 8 Portionen und drücke jede auf Frischhaltefolie zu einem dünnen Fladen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege jeweils ein geschältes Ei in die Mitte eines Fladens und umhülle es vollständig mit der Wurstmasse. Drücke die Nahtstellen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle drei flache Schüsseln mit Mehl, verquirltem Ei und Semmelbröseln bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende jedes wurstumhüllte Ei zuerst in Mehl, dann im Ei und anschließend in den Semmelbröseln. Drücke die Panade leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Topf auf 350°F und frittiere die Eier vorsichtig 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und lass sie auf Küchenpapier abtropfen.",
