      "steps": [
        {
          "position": 0,
          "text": "Brühe in einem separaten Topf erhitzen und während des Garens leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl und Butter in einer großen Pfanne erhitzen und gewürfelte Zwiebeln und gehackten Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In Scheiben geschnittene Pilze hinzufügen und etwa 5 Minuten lang goldbraun braten, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gerste in derselben Pfanne 2 Minuten rösten, dann mit Weißwein ablöschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die warme Brühe unter häufigem Rühren jeweils Tasse für Tasse zugießen. Erst mehr hinzufügen, wenn die Flüssigkeit größtenteils aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fahren Sie etwa 30–35 Minuten fort, bis die Gerste zart und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Butter, Parmesan und gekochte Pilze unterrühren und vor dem Servieren mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
