      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 325 °F vor und bestreichen Sie 4 Auflaufförmchen oder Tortenformen gründlich mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Milch und Sahne zusammen erhitzen, bis sie dampfen, dann vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier mit geriebenem Parmesan, Salz, weißem Pfeffer und Muskatnuss verquirlen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Temperieren Sie die Eier langsam, indem Sie die heiße Milchmischung unter ständigem Rühren hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trüffelöl einrühren und die Mischung durch ein feines Sieb passieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Masse in die vorbereiteten Förmchen gießen und in ein Wasserbad stellen, das bis zur halben Höhe der Förmchen reicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "25–30 Minuten backen, bis die Mitte gerade fest, aber noch leicht wackelig ist, dann abkühlen lassen und vor dem Servieren kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
