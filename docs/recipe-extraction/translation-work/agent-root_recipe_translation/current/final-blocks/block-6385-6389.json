      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen, dann nach und nach Wasser und 1 Esslöffel Olivenöl hinzufügen, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt und elastisch ist, dann einwickeln und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 4 Stücke und rollen Sie jedes zu einem dünnen Strang, dann schneiden Sie es in unregelmäßig geformte Nudelstücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringen Sie einen großen Topf mit Salzwasser zum Kochen und kochen Sie die Nudeln etwa 4–5 Minuten lang al dente.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter in einer großen Pfanne mit gehacktem Knoblauch und frischem Thymian bei schwacher Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Nudeln abtropfen lassen und unter vorsichtigem Rühren zur Buttermischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Trüffelöl beträufeln, geriebenen Parmesan dazugeben, mit Pfeffer würzen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
