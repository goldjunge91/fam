      "steps": [
        {
          "position": 0,
          "text": "Bringen Sie einen großen Topf mit Salzwasser zum Kochen und kochen Sie die Nudeln nach Packungsanweisung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne erhitzen und den gehackten Knoblauch etwa 30 Sekunden lang anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinehackfleisch hinzufügen und unter Zerteilen vollständig anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Pfanne mit Weißwein ablöschen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren, Schlagsahne einrühren und 5 Minuten leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Nudeln abtropfen lassen und zur Soße geben und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Parmesankäse und frische Petersilie unterrühren und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
