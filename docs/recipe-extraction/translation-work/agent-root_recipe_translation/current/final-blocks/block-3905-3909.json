      "steps": [
        {
          "position": 0,
          "text": "Wasser in einem Topf zum Kochen bringen und gefrorene Beeren, Zucker und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Beeren 5 Minuten köcheln lassen, bis sie weich werden und ihren Saft freisetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischen Sie Kartoffelstärke mit 3 Esslöffeln kaltem Wasser, um eine Aufschlämmung zu bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie die Stärkeaufschlämmung langsam unter ständigem Rühren in die köchelnde Beerenmischung, um Klumpen zu vermeiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2-3 Minuten köcheln lassen, bis die Flüssigkeit eindickt und durchscheinend wird, dann Zitronensaft einrühren und warm oder gekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
