        {
          "position": 3,
          "text": "Rinderbrühe, Kuttelstreifen, Kartoffelwürfel und Karotte hinzufügen, zum Kochen bringen und dann 90 Minuten köcheln lassen, bis die Kutteln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Essig einrühren und mit Salz und Pfeffer würzen, dann vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Saure Sahne einrühren und mit frischer Petersilie belegen, bevor es heiß serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
