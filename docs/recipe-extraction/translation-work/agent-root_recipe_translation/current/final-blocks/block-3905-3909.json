      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch, Schweinehackfleisch, gehackten Knoblauch, Paprika, Salz und Pfeffer in einer Schüssel vermischen und mit der Brühe verrühren, bis es klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Befeuchten Sie Ihre Hände und formen Sie aus der Mischung 8-10 czylindrische Würstchen mit einer Länge von etwa 3 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und Mici in einer einzigen Schicht anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "12-15 Minuten kochen lassen, dabei häufig mit einer Zange wenden, um alle Seiten gleichmäßig zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heiß servieren, mit Senf als Beilage oder darüber träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
