      "steps": [
        {
          "position": 0,
          "text": "Erhitze Ghee in einem Topf mit schwerem Boden bei mittlerer Hitze und röste Kichererbsenmehl 5-7 Minuten unter ständigem Rühren, bis es duftet und hellbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Löse Zucker in Wasser auf und stelle die Mischung beiseite. Zerdrücke Kardamomkapseln und entferne die Samen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Zuckerwasser langsam unter ständigem Rühren in das geröstete Mehl, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre 5-8 Minuten weiter, bis die Mischung eindickt und sich vom Pfannenrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kardamomsamen und Muskatnusspulver dazu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste Cashews und Rosinen getrennt in etwas Ghee und hebe sie dann unter die Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Masse auf einen gefetteten Teller und lasse sie 15 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide sie in Quadrate und serviere sie, sobald sie vollständig abgekühlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
