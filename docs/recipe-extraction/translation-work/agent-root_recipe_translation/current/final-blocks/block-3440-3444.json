      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Joghurt und 2 tablespoons Öl in einer Schüssel und schlage alles glatt. Gib Natron dazu und lasse den Teig 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Zucker und Wasser in einer Pfanne und rühre, bis sich der Zucker vollständig aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Zitronensaft, Kardamom, Safran und Lebensmittelfarbe zum Sirup. Lasse ihn 5 Minuten köcheln und halte ihn warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze 3 cups Öl in einem tiefen Topf auf 350°F und fülle den Teig in eine Spritzflasche oder einen Jalebi-Maker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spritze den Teig vorsichtig spiralförmig ins heiße Öl und forme Kreise von 3-4 inches Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie 1-2 Minuten pro Seite, bis sie hellgolden sind, und nimm sie vorsichtig mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tauche die heißen Jalebi sofort 5 Sekunden in warmen Zuckersirup und lege sie dann zum Festwerden auf ein Gitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie bei Raumtemperatur oder warm zu Tee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
