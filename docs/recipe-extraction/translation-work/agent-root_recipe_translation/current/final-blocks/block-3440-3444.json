      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl, Salz, Kurkuma, Asant und Ajowan in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser dazu und verquirle alles zu einem glatten, klümpchenfreien Teig, ähnlich wie Pfannkuchenteig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig 15 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F; teste die Temperatur mit einem kleinen Teigstück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig durch ein Metallsieb oder einen Fafda-Maker direkt ins heiße Öl, sodass dünne nudelartige Streifen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie 2-3 Minuten goldbraun und knusprig und rühre vorsichtig um, damit sie gleichmäßig garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit Jaggery-Sauce oder als Beilage zu gedämpftem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
