      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 tablespoons Öl in einer großen Pfanne und brate gewürfelte Kartoffeln und Yamswurzel an, bis sie teilweise gar sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Auberginenwürfel im selben Öl goldbraun und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl dazu und brate die Zwiebeln tief goldbraun. Gib Ingwer, Knoblauch und grüne Chilischoten hinzu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Kichererbsenmehl mit 1/4 cup Wasser zu einer glatten Paste, gib sie in die Pfanne und rühre 2 Minuten ständig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das gesamte gebratene Gemüse zusammen mit Erdnüssen und grünen Erbsen zurück in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue Salz, Kurkuma und Gujarati-Gewürzpulver darüber und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Tamarindenpaste dazu und rühre alles 3-4 Minuten um, bis es gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die Mischung in einen Topf mit schwerem Boden, decke ihn mit Alufolie und dem Deckel ab und gare alles bei niedriger Hitze 30-40 Minuten. Rühre gelegentlich um, bis das Gemüse vollständig zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht heiß mit warmem Brot oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
