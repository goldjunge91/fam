      "steps": [
        {
          "position": 0,
          "text": "Taue Blätterteig nach Packungsanleitung auf und heize den Ofen auf 400°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe Blätterteigplatten auf belegten Backblechen 15-20 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Milch in einem Topf, bis sie dampft, und verquirle Eigelb, Zucker und Speisestärke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße langsam heiße Milch unter ständigem Rühren zur Eiermischung. Gib alles zurück in den Topf und koche es bei mittlerer Hitze unter ständigem Rühren, bis die Creme eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd, rühre Butter und Vanille ein, lege Frischhaltefolie direkt auf die Creme und lasse sie vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Puderzucker und Wasser zu einer dünnen Glasur und verstreiche sie auf den abgekühlten Blätterteigplatten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte Blätterteigplatte, Creme, Blätterteigplatte, Creme und zum Abschluss die letzte Blätterteigplatte aufeinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kühle den Kuchen mindestens 1 Stunde und schneide ihn dann mit einem scharfen Sägemesser in Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
