      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 300°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Eiweiß mit einem elektrischen Mixer auf hoher Stufe, bis sich weiche Spitzen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach 1 Esslöffel Kristallzucker hinzu, während du weiterschlägst, bis steife, glänzende Spitzen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe Essig, Speisestärke und Vanilleextrakt vorsichtig mit einem Teigschaber unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verstreiche oder spritze die Baisermasse als 9-Zoll-Kreis auf das vorbereitete Blech und forme in der Mitte eine leichte Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Pavlova 50-60 Minuten, bis sie außen blassgolden und knusprig, innen aber noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schalte den Ofen aus und lasse die Pavlova 30 Minuten bei angelehnter Ofentür darin abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schlage Sahne mit Puderzucker steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Belege die abgekühlte Pavlova kurz vor dem Servieren mit Schlagsahne und frischen Beeren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
