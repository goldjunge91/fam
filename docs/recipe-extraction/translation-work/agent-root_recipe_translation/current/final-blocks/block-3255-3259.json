      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Zucker und Salz in einer Schüssel und arbeite kalte Butter ein, bis eine Semmelbrösel-Textur entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Eigelb hinzu und vermische alles, bis ein Teig entsteht. Knete ihn kurz und kühle ihn 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig auf einer bemehlten Fläche dünn aus und schneide ihn in 3-Zoll-Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wickle jedes Quadrat um eine Metall-Cannoli-Form und verschließe die Ränder mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl auf 375°F und frittiere die umwickelten Formen etwa 2 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abkühlen und ziehe die Teigröhrchen dann vorsichtig von den Formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Ricotta, Puderzucker, Vanille und Schokotropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die abgekühlten Hüllen kurz vor dem Servieren mit der Ricottacreme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
