      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und lege Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser und Butter in einem Topf zum Kochen, nimm ihn vom Herd und rühre Mehl ein, bis sich ein Teigball bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig leicht abkühlen und schlage dann die Eier einzeln unter. Vermische nach jeder Zugabe gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Teig in einen Spritzbeutel und spritze kleine Häufchen auf die vorbereiteten Bleche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Windbeutel 25-30 Minuten, bis sie aufgegangen und goldbraun sind. Lasse sie auf Kuchengittern vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide die Deckel der Windbeutel ab und fülle jeden mit einer Kugel Vanilleeis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmilz Schokotropfen mit Sahne und Butter bei niedriger Hitze und rühre, bis die Sauce glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Setze die Deckel wieder auf und beträufle die Windbeutel kurz vor dem Servieren mit warmer Schokoladensauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
