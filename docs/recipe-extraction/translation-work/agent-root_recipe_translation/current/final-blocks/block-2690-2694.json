      "steps": [
        {
          "position": 0,
          "text": "Schälerbsen unter kaltem Wasser abspülen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Topf bei mittlerer Hitze erhitzen und Zwiebeln etwa 6 Minuten weich dünsten.",
