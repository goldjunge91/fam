          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass sie auf Küchenpapier abtropfen und zerteile sie mit einer Gabel in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerstoße Knoblauch, Chilis und Schalotten in einem Mörser grob zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den zerteilten Wels in den Mörser und zerstoße ihn vorsichtig, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Limettensaft und Fischsauce hinzu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Mischung in eine Servierschüssel und garniere sie mit Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie mit rohem Gemüse wie Kohl, Gurke und langen Bohnen zum Dippen.",
          "timerMinutes": null,
