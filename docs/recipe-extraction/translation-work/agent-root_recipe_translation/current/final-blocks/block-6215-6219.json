          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke Knoblauch, Chilis und Schalotten zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem Wok bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gehackten aromatischen Zutaten hinein und brate sie etwa 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gekochten Mägen dazu und brate alles 3-4 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge Fischsauce und Limettensaft hinzu und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit Koriander und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
