      "steps": [
        {
          "position": 0,
          "text": "Dünste die gewürfelte Zwiebel und den Knoblauch in Butter weich an. Gib den frischen Spinat dazu und gare ihn, bis er zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge den gegarten Spinat in einer Schüssel mit Ricotta, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche ein Backblech mit Olivenöl und lege 3 Filoteigblätter darauf. Bestreiche jedes Blatt dazwischen mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Spinat-Käse-Mischung gleichmäßig auf dem Filoteigboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die übrigen 3 Filoteigblätter darauf und bestreiche auch sie jeweils dazwischen mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die oberste Teigschicht mit der restlichen Butter und ritze mit einem scharfen Messer Quadrate ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Soparnik bei 375°F 25–30 Minuten, bis er goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
