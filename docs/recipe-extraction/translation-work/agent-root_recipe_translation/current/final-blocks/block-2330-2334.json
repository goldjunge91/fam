      "steps": [
        {
          "position": 0,
          "text": "Häufe Mehl auf einer sauberen Arbeitsfläche und forme in der Mitte eine Mulde. Schlage Eier hinein und vermische sie mit einer Gabel. Knete den Teig etwa 10 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wickle den Teig in Frischhaltefolie und lasse ihn 30 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite währenddessen die Füllung zu: Vermische gehackten Spinat, Ricotta, Parmesan, Muskatnuss, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 4 Stücke und rolle jedes Stück durch eine Nudelmaschine immer dünner aus, bis Licht hindurchscheint.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Setze kleine Löffelportionen Füllung mit 2 inches Abstand auf ein Nudelblatt. Lege ein weiteres Nudelblatt darüber und drücke es um die Füllung herum fest, um die Ravioli zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide mit einem Teigrädchen oder Messer Ravioli-Quadrate aus und lege sie auf ein mit Backpapier ausgelegtes Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gib die Ravioli vorsichtig hinein. Koche sie, bis sie an die Oberfläche steigen, und dann noch 2 Minuten weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmilz währenddessen Butter mit Salbeiblättern in einer Pfanne. Wende die abgetropften Ravioli vorsichtig in der Salbeibutter und bestreue sie mit Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
