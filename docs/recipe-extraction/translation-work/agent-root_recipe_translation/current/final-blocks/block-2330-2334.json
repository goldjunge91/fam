      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Kalbshaxen trocken und würze sie mit Salz und Pfeffer. Wende sie im Mehl und klopfe überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen schweren Topf oder Schmortopf bei mittlerer bis hoher Hitze. Bräune die Kalbshaxen rundum etwa 4 Minuten pro Seite und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste im selben Topf gewürfelte Zwiebel, Karotte und Sellerie etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche mit Weißwein ab und kratze die angebräunten Reste vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kalbfleisch, Rinderbrühe, Lorbeerblatt und Thymian zurück in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und gare das Fleisch bei 325°F im Ofen 2-2.5 hours, bis es sehr zart ist und sich vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Kalbfleisch heraus und seihe die Schmorflüssigkeit ab. Drücke das Gemüse durch ein Sieb, damit die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Kalbfleisch und passierte Soße zurück in den Topf und lasse alles vor dem Servieren 5 Minuten sanft köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
