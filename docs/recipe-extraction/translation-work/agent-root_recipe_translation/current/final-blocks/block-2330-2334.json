      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf. Dünste gehackte Zwiebel, Karotte und Sellerie etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rinder- und Schweinehackfleisch hinzu und brate es unter Zerteilen etwa 10-12 Minuten kräftig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche mit Weißwein ab und kratze die angebräunten Reste vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib stückige Tomaten hinzu und bringe alles zum Köcheln. Reduziere dann die Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Soße ohne Deckel 45 Minuten bis 1 Stunde unter gelegentlichem Rühren köcheln, bis sie dick und aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Milch ein und lasse die Soße weitere 5 Minuten köcheln, damit der Geschmack milder wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und gare die Tagliatelle al dente.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Nudeln ab, vermenge sie mit der Ragù-Soße und serviere sie mit Parmesan bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
