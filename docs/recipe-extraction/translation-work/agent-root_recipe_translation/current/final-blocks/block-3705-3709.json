      "steps": [
        {
          "position": 0,
          "text": "Schneide Tortillas in Viertel und frittiere sie in 2 Esslöffeln Öl in einer Pfanne knusprig. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Poblano-Chilis über Flamme oder unter dem Grill, bis sie verkohlt sind. Lege sie 5 Minuten in eine Tüte, ziehe die Haut ab und schneide sie in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste gewürfelte Zwiebel und Knoblauch 2 Minuten im restlichen Öl, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere Poblano-Streifen, saure Sahne und Brühe glatt und gieße die Mischung mit der Zwiebel in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Sauce 5 Minuten köcheln, probiere sie und passe das Salz an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib frittierte Tortillastücke zur Sauce, rühre vorsichtig um und lasse sie 3 Minuten köcheln, bis sie leicht weich sind, aber noch Struktur haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate Eier in einer separaten Pfanne, bis das Eiweiß gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib die Chilaquiles auf eine Servierplatte, belege sie mit Spiegeleiern und Queso Fresco und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
