      "steps": [
        {
          "position": 0,
          "text": "Püriere Tomaten mit der Hälfte der Zwiebel, 1 Knoblauchzehe und Salz zu einer roten Sauce; seihe sie nach Wunsch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Tomatillos oder die Salsa-Verde-Basis mit Jalapeño, restlicher Zwiebel und Knoblauch zur grünen Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die rote Sauce in einer kleinen Pfanne und die grüne in einer zweiten Pfanne bei mittlerer Hitze. Lasse beide je 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer dritten Pfanne und brate die Eier jeweils zu zweit, bis das Eiweiß gestockt und das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege je Portion ein Spiegelei in jede Sauce und lasse es 1 Minute köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Tortillas in einer trockenen Pfanne, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte je ein Ei mit roter Sauce auf der einen und grüner Sauce auf der anderen Seite an, garniere mit Koriander und serviere warme Tortillas dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
