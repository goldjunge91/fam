      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier und Milch und rühre sie unter die trockenen Zutaten, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib mit zwei Löffeln Teigportionen ins heiße Öl und frittiere sie je Seite 2 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Buñuelos auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Piloncillo und Wasser in einem kleinen Topf bei mittlerer Hitze und rühre, bis sich alles zu Sirup aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Zucker und Zimt in einer flachen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wende die warmen Buñuelos in der Zimt-Zucker-Mischung, beträufle sie dann mit Piloncillo-Sirup und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
