      "steps": [
        {
          "position": 0,
          "text": "Löse Hefe in warmem Wasser auf und lasse sie 5 Minuten stehen, bis sie schaumig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Butter und Zucker cremig und luftig und rühre dann die Eier einzeln ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl und Salz und gib sie abwechselnd mit der Hefemischung zur Buttermasse. Rühre, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knete den Teig auf einer bemehlten Fläche 8 Minuten glatt und elastisch und arbeite dabei Orangenschale und Anissamen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege den Teig in eine geölte Schüssel, decke ihn mit einem feuchten Tuch ab und lasse ihn an einem warmen Ort 1.5 Stunden gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drücke die Luft aus dem Teig, forme einen runden Laib, lege ihn auf Backpapier, decke ihn ab und lasse ihn 45 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe ihn bei 350°F 45 Minuten goldbraun, bis er beim Klopfen hohl klingt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse das Brot vor dem Servieren auf einem Gitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
