      "steps": [
        {
          "position": 0,
          "text": "Hacke Knoblauch und Schalotten fein und vermische sie mit Sojasoße, Fischsoße, Honig, Limettensaft und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Schweinefleisch in 0.5-inch dicke Streifen, bestreiche sie mit der Marinade und lasse sie mindestens 15 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate das marinierte Schweinefleisch portionsweise 3-4 Minuten pro Seite, bis es karamellisiert und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das gegarte Fleisch auf einen Teller und gieße die übrige Marinade in die Pfanne. Lasse sie 1 Minute köcheln, damit sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte Salatblätter auf einer Servierplatte an und lege Reis und Schweinefleisch darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die eingedickte Soße über das Fleisch und serviere es sofort, nach Wunsch mit eingelegtem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
