      "steps": [
        {
          "position": 0,
          "text": "Vermische Salz, braunen Zucker und Pfefferkörner zu einer Pökelmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Säubere die Forellen innen und außen und reibe die Pökelmischung auf die gesamte Innen- und Außenseite des Fisches.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Bauchhöhle jeder Forelle mit Dillzweigen und Zitronenscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Forellen 1 Stunde in den Kühlschrank, damit das Salz einziehen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Räucherofen mit Erlenholzspänen auf 175°F vor und stelle eine Wasserschale mit Lorbeerblättern hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Forellen auf den Rost und räuchere sie 45 bis 60 Minuten, bis das Fleisch undurchsichtig ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
