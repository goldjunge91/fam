      "steps": [
        {
          "position": 0,
          "text": "Heize den Räucherofen mit Hickory- oder Apfelholzspänen auf 225°F vor. Die Späne sollten zuvor 30 Minuten eingeweicht werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ritze die Schinkenschwarte rautenförmig ein und stecke ganze Gewürznelken in die Einschnitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle braunen Zucker, Senf, Essig, Honig und Pfeffer zu einer Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Schinken auf den Rost des Räucherofens und räuchere ihn 2.5 bis 3 Stunden, bis die Kerntemperatur 140°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche den Schinken während des Räucherns alle 45 Minuten mit der Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Schinken aus dem Räucherofen, decke ihn locker mit Folie ab und lasse ihn vor dem Tranchieren 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
