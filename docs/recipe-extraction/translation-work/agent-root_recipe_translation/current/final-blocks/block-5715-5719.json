      "steps": [
        {
          "position": 0,
          "text": "Vermische Paprikapulver, braunen Zucker, Knoblauchpulver und schwarzen Pfeffer zu einer Trockenmarinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Schweineschulter damit ein und lasse sie 1 Stunde bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Räucherofen mit Hickoryholzspänen auf 250°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Schweineschulter in den Räucherofen und räuchere sie 5 bis 6 Stunden, bis die Kerntemperatur 190°F erreicht und sich das Fleisch leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch heraus, wickle es in Folie und lasse es 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerteile das Schweinefleisch mit zwei Gabeln und vermische es mit einer Soße aus Essig und Senf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Röste die Brötchen und serviere das Pulled Pork mit Krautsalat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
