      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Rinderhackfleisch an, rühre die Taco-Gewürzmischung mit 2 tablespoons Wasser ein und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die zerbröselten Doritos in eine flache Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke eine Seite jeder warmen Tortilla vorsichtig in die zerbröselten Doritos, damit die Chips daran haften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Tortillas mit der Doritos-Seite nach unten 1-2 Minuten im Öl, bis sie knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende sie und brate die andere Seite eine weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die Tacos mit gewürztem Rinderhackfleisch, Käse, Salat, Tomaten und saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
