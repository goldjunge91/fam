      "steps": [
        {
          "position": 0,
          "text": "Brate den Speck in einer Pfanne bei mittlerer Hitze etwa 7-8 Minuten knusprig und zerbrich ihn dann in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme das Rinderhackfleisch zu 4 dünnen Bratlingen von etwa 0.5 inches Dicke und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine Pfanne oder Grillplatte bei mittelhoher Hitze und brate die Bratlinge 2-3 Minuten pro Seite, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belege jeden Bratling in der letzten Minute mit 2 Scheiben amerikanischem Schmelzkäse und decke die Pfanne kurz ab, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Hamburgerbrötchen leicht in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die untere Brötchenhälfte mit Mayonnaise und schichte darauf die Bratlinge mit Käse, Speck, Salat, Tomate und Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Ketchup und Senf und bestreiche damit die obere Brötchenhälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schließe das Sandwich und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
