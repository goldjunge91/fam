      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine große Pfanne bei mittelhoher Hitze und brate die Rinderschulter rundherum etwa 8 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Fleisch heraus, gib Zwiebel und Knoblauch in die Pfanne und brate sie 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Fleisch zurück in die Pfanne und füge Rinderbrühe, Thymian, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf niedrig, decke die Pfanne ab und lasse alles 2-3 Stunden köcheln, bis das Fleisch sehr zart ist und sich leicht zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch heraus und lass es abkühlen, bis du es anfassen kannst; schneide es dann in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Sesambrötchen in einer Pfanne oder im Toaster.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die untere Brötchenhälfte mit Meerrettichsauce und lege das zerpflückte Rindfleisch darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege es mit frischem Rucola und schließe das Sandwich mit der oberen Brötchenhälfte.",
