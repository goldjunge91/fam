          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Alles gut verrühren, bis die Zutaten gleichmäßig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Folie abdecken und 1 Stunde backen. Gelegentlich umrühren und Wasser hinzufügen, falls die Mischung austrocknet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Folie entfernen und weitere 15–20 Minuten backen, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und als Beilage heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
