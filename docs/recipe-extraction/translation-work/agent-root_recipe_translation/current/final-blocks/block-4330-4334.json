      "steps": [
        {
          "position": 0,
          "text": "Mehl, Hefe, Zucker und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Warmes Wasser und Öl hinzufügen und 8 Minuten kneten, bis der Teig glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig abgedeckt 45 Minuten gehen lassen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebel in einer Pfanne anbräunen, dann Schweinefleisch aus der Dose, Sojasauce und braunen Zucker für die Füllung hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in 8 Kugeln teilen und jede zu einem Kreis von 4 Zoll flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jeweils 2 Esslöffel Füllung in die Mitte geben, den Teig darum herum schließen und die Naht versiegeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der Naht nach unten auf Backpapier legen und 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 375 °F 20–25 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
