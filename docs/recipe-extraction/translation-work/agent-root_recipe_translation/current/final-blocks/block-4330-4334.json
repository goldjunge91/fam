      "steps": [
        {
          "position": 0,
          "text": "Warme Milch, 2 Esslöffel geschmolzene Butter, Ei, Zucker und Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hefe hinzufügen und 5 Minuten stehen lassen, dann Mehl einrühren, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig auf einer bemehlten Fläche 8–10 Minuten kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in eine gebutterte Schüssel legen, abdecken und an einem warmen Ort 45 Minuten gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig zusammendrücken, 1/4 Zoll dick ausrollen, Kreise von 4 Zoll ausstechen und jeden mit geschmolzener Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jeden Kreis halbieren und auf ein gebuttertes Backblech legen. Abdecken und 30–40 Minuten gehen lassen, bis die Brötchen luftig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ofen auf 400 °F vorheizen, Brötchen mit Eiweiß bestreichen und 12–15 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
