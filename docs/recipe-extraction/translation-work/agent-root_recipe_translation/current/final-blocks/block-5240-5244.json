      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und stelle eine gusseiserne Pfanne mit 10 inch Durchmesser zum Aufheizen hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Butter, braunen Zucker und weißen Zucker in einer Schüssel hell und schaumig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre das Eigelb und den Vanilleextrakt unter, bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre in einer zweiten Schüssel Mehl, Natron und Salz und hebe die Mischung anschließend unter die feuchten Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die Schokoladenstückchen unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Teig vorsichtig in die heiße Pfanne und streiche ihn gleichmäßig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Keks 12–15 Minuten, bis der Rand fest ist, die Mitte aber noch leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Pfanne aus dem Ofen und lass den Keks 5 Minuten abkühlen. Serviere ihn warm, nach Wunsch mit Eis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
