      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Butter in einer Pfanne bei mittlerer Hitze und dünste Sellerie, Zwiebel und Paprika 3 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den gehackten Knoblauch dazu und brate ihn 1 Minute mit. Nimm dann das Gemüse aus der Pfanne und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze das Fischfilet mit Salz, schwarzem Pfeffer und Cayennepfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die restliche Butter in die Pfanne und brate den Fisch je Seite 4–5 Minuten, bis er gar ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste das Brot goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Gemüse zum Fisch zurück in die Pfanne und erwärme alles. Presse anschließend Zitronensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die Toastscheiben mit Fisch und der kreolischen Gemüsemischung und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
