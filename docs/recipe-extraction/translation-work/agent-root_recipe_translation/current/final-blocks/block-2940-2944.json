      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 450°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische 2 Tassen Mehl, Backpulver und 1/2 Teelöffel Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Arbeite kalte Butterwürfel mit einem Teigmischer oder einer Gabel ein, bis die Mischung groben Krümeln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Buttermilch ein, bis gerade ein grober Teig entsteht. Rühre nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Teig auf eine bemehlte Arbeitsfläche, drücke ihn vorsichtig 1 Zoll dick und schneide mit einem Ausstecher oder Glas 8 Brötchen aus. Lege sie auf das Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Brötchen 12-15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bräune währenddessen die gemahlene Wurst in einer großen Pfanne bei mittlerer bis hoher Hitze und zerteile sie dabei. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue 3 Esslöffel Mehl über die Wurst und rühre 1 Minute. Gieße dann langsam unter Rühren Milch hinzu und lasse die Sauce 5 Minuten köcheln, bis sie eindickt. Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Halbiere die warmen Brötchen und serviere sie mit der Wurstsauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
