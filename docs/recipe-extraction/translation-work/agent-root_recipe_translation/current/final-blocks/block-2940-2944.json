      "steps": [
        {
          "position": 0,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und dünste gewürfelte Zwiebel, Sellerie und Karotte 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestäube das Gemüse mit Mehl, rühre um und gare es 1 Minute, damit der rohe Mehlgeschmack verschwindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße unter Rühren langsam Hühnerbrühe hinzu, damit sich keine Klumpen bilden, und gib dann Thymian, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchenstücke hinzu und bringe alles zum Kochen. Reduziere dann die Hitze auf mittel und lasse alles 15 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bereite währenddessen die Klöße zu: Vermische Backmischung und Milch zu einem dickflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhöhe die Hitze bis zum sanften Kochen und gib vorsichtig löffelweise Teig in die Brühe, sodass 12-16 Klöße entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles 10-15 Minuten köcheln, bis die Klöße gar und innen nicht mehr teigig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht, passe die Würzung an und serviere es in Schalen mit Brühe und Klößen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
