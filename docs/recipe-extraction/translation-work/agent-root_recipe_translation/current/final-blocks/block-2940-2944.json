      "steps": [
        {
          "position": 0,
          "text": "Fülle einen großen Topf mit 6 Gallonen Wasser und bringe es bei hoher Hitze sprudelnd zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Salz und Crawfish-Boil-Gewürz ins kochende Wasser und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geviertelte Zwiebel, halbierte Knoblauchknollen und halbierte Zitronen ins Wasser und lasse alles 5 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Babykartoffeln und Wurststücke hinzu und koche alles 10 Minuten, bis die Kartoffeln fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Maisstücke hinzu und koche alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die lebenden Flusskrebse vorsichtig portionsweise hinzu und bringe alles wieder zum Kochen. Gare sie 5-7 Minuten, bis sie leuchtend rot sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schalte die Hitze aus und lasse die Flusskrebse 5-10 Minuten im gewürzten Wasser ziehen, damit sie Geschmack aufnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Hebe Flusskrebse und Gemüse mit einer Schaumkelle auf einen großen Tisch oder in ein Sieb und lasse sie vor dem Servieren abtropfen und leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
