      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 400 °F vor, legen Sie den Tortenboden in eine Tarteform und stechen Sie ihn mit einer Gabel ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Äpfel schälen, entkernen und in dünne Halbmonde schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter und Zucker in einer großen Pfanne bei mittlerer Hitze erhitzen und rühren, bis sich der Zucker auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Äpfel, Vanille und Zimt hinzufügen und 10 Minuten kochen und umrühren, bis die Äpfel leicht weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und unter leichtem Rühren vorsichtig Calvados hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ordnen Sie die Apfelscheiben in überlappenden Kreisen auf der Kruste an und gießen Sie dann die restliche Flüssigkeit darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "25–30 Minuten backen, bis die Kruste goldbraun und die Äpfel zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aprikosenmarmelade mit 1 Esslöffel Wasser erhitzen und die warme Tarte vor dem Servieren damit glasieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
