      "steps": [
        {
          "position": 0,
          "text": "Schweinekoteletts trocken tupfen und großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen. Schweinekoteletts pro Seite 3–4 Minuten anbraten, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne die gewürfelten Zwiebeln 3 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Äpfel schälen, entkernen und in dicke Ringe schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie Apfelwein und Senf in die Pfanne, kratzen Sie die gebräunten Stücke heraus, geben Sie dann die Schweinekoteletts zurück und fügen Sie Thymian hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Apfelscheiben über und um die Koteletts legen, dann abdecken und 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schweinekoteletts und Äpfel auf einen Teller legen, Sahne in die Soße rühren und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schweinekoteletts und Äpfel mit Sauce übergießen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
