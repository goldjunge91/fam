      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker schaumig schlagen, dann Eier und Vanille unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Backpulver, Salz und Anissamen in einer separaten Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trockene Zutaten unter die feuchten Zutaten heben, dann ganze Mandeln unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teilen Sie den Teig in zwei Hälften und formen Sie jede Hälfte auf dem Backblech zu einer langen Rolle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Teigrollen 20–25 Minuten backen, bis sie goldbraun und fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Etwas abkühlen lassen, dann diagonal in 0.75 Zoll dicke Scheiben schneiden und mit der Schnittseite nach unten weitere 8 Minuten backen, damit sie knusprig werden.",
          "timerMinutes": null,
