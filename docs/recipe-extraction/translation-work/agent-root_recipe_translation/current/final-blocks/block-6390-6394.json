      "steps": [
        {
          "position": 0,
          "text": "Grüne, unreife Walnüsse mit Handschuhen vierteln und in ein sauberes Glas geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gießen Sie Wodka oder Getreidealkohol über die Walnüsse, bis sie vollständig eingetaucht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Glas locker abdecken und 2 Wochen an einem kühlen, dunklen Ort ziehen lassen. Gelegentlich schütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zucker und Wasser zusammen erhitzen, um einen einfachen Sirup herzustellen, dann vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Walnussstücke abseihen und Zimtstange, Nelken und Sternanis zur aufgegossenen Flüssigkeit hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abgekühlten Sirup einrühren und weitere 1–2 Wochen ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nochmals abseihen und in Flaschen abfüllen, um einen verdauungsfördernden Likör zu erhalten, der mit zunehmendem Alter besser wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
