      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz, Öl und warmes Wasser in einer Schüssel vermischen und kneten, bis ein weicher Teig entsteht, dann 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spinat und Zwiebel fein hacken, dann mit Zitronensaft, Sumach, Pinienkernen, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 12 gleiche Kugeln und rollen Sie jede zu einem dünnen Kreis von etwa 4 Zoll Breite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie einen Löffel Spinatfüllung auf jeden Kreis, falten Sie ihn dann zu einem Dreieck und drücken Sie die Ränder zusammen, um ihn zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gefüllte Dreiecke auf ein geöltes Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 375°F 20-25 Minuten backen, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
