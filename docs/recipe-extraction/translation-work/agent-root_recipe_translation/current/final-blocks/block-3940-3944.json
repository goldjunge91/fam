      "steps": [
        {
          "position": 0,
          "text": "Hackfleisch, ungekochten Reis, Zwiebelwürfel, Tomatenmark, 2 Esslöffel Olivenöl, Zitronensaft, Salz, Pfeffer und Zimt in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weinblätter unter kaltem Wasser abspülen und mit Papiertüchern trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie ein Weinblatt flach hin und geben Sie 1 Esslöffel Füllung in die Nähe des Stielendes.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Falten Sie das Stielende über die Füllung, falten Sie dann die Seiten ein und rollen Sie es fest zur Spitze hin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ordnen Sie die Brötchen mit der Naht nach unten in einem Topf mit zusätzlichen Weinblättern an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gießen Sie Gemüsebrühe und restliches Olivenöl über die Brötchen und decken Sie sie dann mit einem Teller ab, damit sie zusammengedrückt bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zum Kochen bringen, Hitze reduzieren, abdecken und 30 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm mit extra Zitronensaft als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
