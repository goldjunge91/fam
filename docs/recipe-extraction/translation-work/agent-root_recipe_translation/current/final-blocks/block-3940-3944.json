      ],
      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und das Hähnchen mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hähnchenwürfel von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und Knoblauch im selben Topf anbraten, bis sie weich sind und duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Freekeh und Piment hinzufügen und 2 Minuten lang unter ständigem Rühren leicht rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Gemüsebrühe aufgießen, das Huhn wieder in den Topf geben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe, decken Sie das Ganze ab und lassen Sie es 20 Minuten köcheln, bis das Freekeh weich ist und die Flüssigkeit aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten ohne Hitze ruhen lassen, dann mit einer Gabel auflockern und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
