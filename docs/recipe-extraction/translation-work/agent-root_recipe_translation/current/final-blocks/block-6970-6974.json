      "steps": [
        {
          "position": 0,
          "text": "Hoagie-Brötchen der Länge nach halbieren und bei Bedarf leicht unter dem Grill rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Auf die untere Hälfte jedes Brötchens Capicola, Mortadella und Provolone-Käse schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie Salat, Tomatenscheiben, rote Zwiebeln und geröstete rote Paprika darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer kleinen Schüssel Olivenöl, Essig, Oregano, Salz und Pfeffer verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Vinaigrette über das Gemüse und das Fleisch träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hoagie-Brötchen verschließen und 5 Minuten lang fest in Folie oder Pergamentpapier einwickeln, damit sich die Aromen vermischen können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auspacken, bei Bedarf halbieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
