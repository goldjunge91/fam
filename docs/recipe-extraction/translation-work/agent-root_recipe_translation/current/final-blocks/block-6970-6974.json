      "steps": [
        {
          "position": 0,
          "text": "Poblanos direkt über einer Gasflamme oder unter dem Grill ca. 5 Minuten rösten, bis sie überall verkohlt sind, und dann zum Dämpfen 5 Minuten in eine Plastiktüte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ziehen Sie vorsichtig die verkohlte Haut ab, machen Sie einen Längsschlitz und entfernen Sie vorsichtig die Kerne, sodass die Paprika ganz bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füllen Sie jede Paprika mit etwa 1/3 Tasse geriebenem Käse und legen Sie sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einem Topf 1 Esslöffel Öl bei mittlerer Hitze erhitzen, gehackten Knoblauch und gewürfelte Zwiebeln 2 Minuten anbraten, dann Tomatensauce und Brühe hinzufügen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier trennen; Schlagen Sie das Eiweiß, bis sich steife Spitzen bilden, und heben Sie dann vorsichtig das Eigelb unter. Gefüllte Paprika leicht mit Mehl bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitzen Sie 2 Esslöffel Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und tauchen Sie jede Paprika vorsichtig in die Eimischung, um sie vollständig zu bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Paprika auf jeder Seite 2–3 Minuten goldbraun braten und dann in eine Auflaufform geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gießen Sie warme rote Soße über die Paprika und backen Sie sie 350 Minuten lang bei 10 °F, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
