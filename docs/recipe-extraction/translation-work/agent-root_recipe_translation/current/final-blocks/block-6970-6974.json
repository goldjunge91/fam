      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und tupfen Sie die Schweineschulter mit Papiertüchern trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Machen Sie kleine Schlitze in das Schweinefleisch und stecken Sie darin Knoblauchzehen und Kräuterzweige hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Alles mit Olivenöl, Salz und Pfeffer einreiben und in einen Bräter geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie Hühnerbrühe auf den Boden der Pfanne und braten Sie es 1.5 bis 2 Stunden lang, bis das Fleisch eine Innentemperatur von 190 °F erreicht und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aus dem Ofen nehmen und 10 Minuten ruhen lassen, dann das Schweinefleisch mit zwei Gabeln zerkleinern und mit dem Bratenfett vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rotweinessig einrühren und mit zusätzlichem Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rösten Sie die Hoagie-Brötchen leicht an, füllen Sie sie großzügig mit zerkleinertem Schweinefleisch und dem Bratensaft und servieren Sie sie dann mit zusätzlicher Soße zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
