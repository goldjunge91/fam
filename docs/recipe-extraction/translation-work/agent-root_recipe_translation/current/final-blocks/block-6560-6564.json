      "steps": [
        {
          "position": 0,
          "text": "Spüle den Reis unter kaltem Wasser, bis es klar abläuft, und gieße ihn gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einem großen Topf bei mittlerer Hitze und dünste Zwiebel und Knoblauch 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Reis dazu und rühre um, sodass er mit Butter überzogen ist. Röste ihn 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wasser und Kokosmilch hinein und gib abgetropfte Taubenerbsen, Thymian, Salz und Pfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse den Reis 15-18 Minuten köcheln, bis er weich und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und lasse ihn zugedeckt 5 Minuten stehen. Lockere den Reis mit einer Gabel auf und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
