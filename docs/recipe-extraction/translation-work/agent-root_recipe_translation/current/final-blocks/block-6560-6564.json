      "steps": [
        {
          "position": 0,
          "text": "Vermische Grieß, Mehl, Joghurt, Öl, 1/2 Tasse Zucker, Backpulver und Salz. Gieße den Teig in eine gefettete 8x8 Backform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streiche den Teig glatt, schneide 12 Quadrate ein und lege eine Mandel auf jedes Quadrat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe den Kuchen bei 350°F 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische währenddessen Wasser, übrigen Zucker und Zitronensaft in einem Topf und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den heißen Sirup sofort nach dem Herausnehmen über den heißen Kuchen und lasse ihn vor dem Servieren vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
