      "steps": [
        {
          "position": 0,
          "text": "Weiche Stockfisch 12-24 Stunden in Wasser ein und wechsle das Wasser alle 6 Stunden, damit überschüssiges Salz entfernt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße den Fisch ab, zerpflücke ihn mit einer Gabel und entferne Gräten und Haut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl, Backpulver, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische in einer anderen Schüssel den zerpflückten Fisch mit Zwiebel, Knoblauch, scharfer Chili und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die trockenen Zutaten zu den feuchten und rühre nach und nach Wasser ein, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und gib löffelweise Teig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Küchlein auf jeder Seite 2-3 Minuten goldbraun und knusprig. Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
