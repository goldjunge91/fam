          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "hinzufügen Hähnchen Stücke und garen bis browned auf all sides, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "hinzufügen gewürfelt Zwiebeln und bell peppers, cooking für 3 Minuten bis weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "umrühren in Kreuzkümmel, garam masala, und Kurkuma, cooking für 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "hinzufügen canned tomatoes mit their juice und bring zu ein köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren und garen für 15-20 Minuten bis Hähnchen is gegart through und Sauce thickens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Season mit Salz und Pfeffer nach Geschmack und servieren mit Reis oder naan.",
          "timerMinutes": null,
