      "steps": [
        {
          "position": 0,
          "text": "schneiden Hähnchen in bite-sized Stücke und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "erhitzen Öl in ein groß Pfanne und hinzufügen fein gehackt Knoblauch und Ingwer, stirring für 30 seconds bis es duftet.",
