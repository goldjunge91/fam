      "steps": [
        {
          "position": 0,
          "text": "Gare jedes Gemüse einzeln mit etwas Sojasoße und einer Prise Sesamöl 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das gewürzte Hähnchenhack an, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Eier mit der Eigelbseite nach oben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle Reis in eine Schüssel und verteile Hähnchen und jedes Gemüse separat darauf. Belege alles mit Ei und gib Gochujang dazu. Vermenge das Gericht vor dem Essen.",
