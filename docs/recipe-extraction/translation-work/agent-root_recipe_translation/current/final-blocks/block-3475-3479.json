        {
          "position": 0,
          "text": "Entferne überschüssiges Fett vom Rindfleisch und schneide es in dünne, 4-5 inches lange Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Kurkuma, Chilipulver, Ingwer-Knoblauch-Paste und Zitronensaft in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche die Rindfleischstreifen gründlich mit der Gewürzmischung und lasse sie 30 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Streifen auf ein sauberes Tuch oder Trockengestell in direktes Sonnenlicht oder in einen Dörrautomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trockne sie 6-8 Stunden und wende sie gelegentlich, bis sie vollständig trocken und lederartig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer Pfanne, gib Kreuzkümmelsamen dazu und brate die getrockneten Fleischstreifen etwa 3-4 Minuten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bewahre sie bis zu 2 Wochen in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
