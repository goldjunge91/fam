      "steps": [
        {
          "position": 0,
          "text": "Weiche geschälte schwarze Linsen 4 Stunden in Wasser ein und gieße sie vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle die eingeweichten Linsen mit möglichst wenig Wasser in einer Küchenmaschine, bis sie luftig und leicht aufgeschlagen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die gemahlenen Linsen mit Zwiebel, grüner Chilischote, Ingwer, Koriander und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf bei mittelhoher bis hoher Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib löffelweise Teig ins heiße Öl und drücke ihn mit der Löffelrückseite leicht flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Fladen insgesamt etwa 3-4 Minuten, bis sie auf beiden Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit Chutney oder Curry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
