      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen. Die Ente trocken tupfen und innen wie außen mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Entenhaut überall mit einer Gabel einstechen, damit das Fett austritt. Anschließend 1 Stunde und 15 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Währenddessen zwei Orangen abreiben und die Schale beiseitelegen. Alle drei Orangen auspressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Schalotten fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die gegarte Ente auf ein Schneidebrett legen und 10 Minuten ruhen lassen, dann in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bis auf 2 Esslöffel Fett alles aus dem Bräter abgießen und die Schalotten darin weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Orangensaft, nach Wunsch Likör, Essig, Honig und Fond in den Bräter geben und aufkochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Speisestärke mit 1 Esslöffel Wasser verrühren, in die Sauce geben und 2 Minuten kochen, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Die Sauce in einen Topf abseihen und Butter sowie die beiseitegelegte Orangenschale einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Die Sauce über die Entenstücke gießen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
