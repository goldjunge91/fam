      "steps": [
        {
          "position": 0,
          "text": "Für die Béarnaise Schalotten hacken, mit Estragonessig in einem Topf auf die Hälfte einkochen, dann abseihen und leicht abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eigelb in einer hitzefesten Schüssel über köchelndem Wasser dick und hell aufschlagen. Die Schüssel darf das Wasser nicht berühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vom Herd nehmen und weiche Butter nach und nach langsam einrühren, bis eine Emulsion entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die abgekühlte Essigmischung und gehackten frischen Estragon unterheben. Mit Salz und Pfeffer würzen und warm halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Fleisch 45 Minuten vor dem Garen aus dem Kühlschrank nehmen, damit es Raumtemperatur annimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Fleisch trocken tupfen und großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer schweren Pfanne bei hoher Hitze erhitzen, bis es fast raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Das Fleisch auf jeder Seite 3–4 Minuten scharf anbraten. Hitze reduzieren, 2 Esslöffel Butter und Thymianzweige zugeben und 10–12 Minuten für medium-rare garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Das Fleisch auf einem warmen Teller 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Das Fleisch in Scheiben schneiden und mit Béarnaise darüber servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
