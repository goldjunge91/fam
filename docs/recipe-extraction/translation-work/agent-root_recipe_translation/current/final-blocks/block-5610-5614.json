      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen und eine runde Kuchenform (9 Zoll) einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker etwa 3 Minuten cremig und luftig aufschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Eier einzeln vollständig unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl und Backpulver in einer separaten Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mehlmischung und Milch abwechselnd zur Buttermasse geben, dabei mit Mehl beginnen und enden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Orangenschale und Brandy einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Teig in die vorbereitete Form füllen und die Oberfläche glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mandeln und Sesam darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "50–60 Minuten backen, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Den Kuchen 10 Minuten in der Form abkühlen lassen und dann herauslösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
