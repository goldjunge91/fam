      "steps": [
        {
          "position": 0,
          "text": "Das Fleisch 45 Minuten vor dem Garen aus dem Kühlschrank nehmen, damit es Raumtemperatur annimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Fleisch mit Küchenpapier trocken tupfen und großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer schweren Pfanne bei hoher Hitze erhitzen, bis es fast raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Fleisch auf allen Seiten je 3–4 Minuten scharf anbraten, bis es kräftig gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hitze auf mittlere Stufe reduzieren, Butter, Schalotten und Thymian dazugeben und für medium-rare 8–12 Minuten garen (Kerntemperatur 125°F).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Fleisch auf einen warmen Teller legen und 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Überschüssiges Fett abgießen und die Pfanne mit Rotwein ablöschen; dabei die Bratrückstände lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rinderfond hinzufügen und 3 Minuten köcheln lassen, bis die Sauce leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Die Sauce abseihen und Dijon-Senf sowie ein Stück Butter einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Das Fleisch in Scheiben schneiden und mit der Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
