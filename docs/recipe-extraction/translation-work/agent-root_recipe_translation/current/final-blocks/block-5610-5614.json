      "steps": [
        {
          "position": 0,
          "text": "Die Hummer kopfüber in kochendes Salzwasser geben und 15 Minuten garen, bis die Schalen rot werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Abkühlen lassen, längs halbieren, das Fleisch herauslösen und hacken. Die Schalen aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einem Topf schmelzen und Schalotten sowie Champignons darin weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Weißwein ablöschen, Fischfond hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eigelb und Sahne in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Topf vom Herd nehmen und die Sahnemischung langsam einrühren, damit sie nicht gerinnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hummerfleisch und Estragon vorsichtig unterheben und abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Mischung zurück in die Hummerschalen füllen und mit Parmesan bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bei 375°F 12–15 Minuten backen, bis die Oberfläche goldbraun und alles durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
