      "steps": [
        {
          "position": 0,
          "text": "Hefe in warmem Wasser mit einer Prise Zucker auflösen und 5 Minuten stehen lassen, bis sich Schaum bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, dann die Hefemischung und 1 Esslöffel Olivenöl hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 8 Minuten kneten, bis er glatt und elastisch ist. Bei Bedarf Wasser hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig abdecken und bei Raumtemperatur 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 3 Kugeln teilen und jede zu einem flachen, runden Brot von etwa 0.5 Zoll Dicke ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittlerer bis hoher Hitze erwärmen und mit dem restlichen Olivenöl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Brot in die heiße Pfanne legen und pro Seite 3–4 Minuten backen, bis es aufgeht und goldene Stellen bekommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nach Wunsch während des Backens mit Koriander- und Anissamen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
