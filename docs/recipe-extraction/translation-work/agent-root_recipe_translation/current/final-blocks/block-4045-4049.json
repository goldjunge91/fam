      "steps": [
        {
          "position": 0,
          "text": "Lamm in 2 Zoll große Stücke schneiden und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf oder einer Tajine erhitzen und die Lammstücke portionsweise jeweils 3–4 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lamm herausnehmen und gewürfelte Zwiebel sowie gehackten Knoblauch etwa 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lamm zurück in den Topf geben, Ingwer, Zimtstange und Kreuzkümmel hinzufügen und gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rinderbrühe über das Lamm gießen und zum Kochen bringen, dann Hitze reduzieren und abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "45 Minuten köcheln lassen, bis das Lamm zart ist, dann Aprikosen und Mandeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ohne Deckel weitere 15 Minuten köcheln lassen, damit die Sauce etwas eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren abschmecken und nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
