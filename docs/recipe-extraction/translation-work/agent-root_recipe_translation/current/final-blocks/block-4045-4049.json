      "steps": [
        {
          "position": 0,
          "text": "Kichererbsenmehl mit Wasser glatt verquirlen und anschließend durch ein feines Sieb streichen, um Klümpchen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hälfte des Olivenöls in einem Topf bei mittlerer Hitze erhitzen und gewürfelte Zwiebel etwa 4 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Kichererbsenmischung zu den Zwiebeln in die Pfanne gießen und 5–7 Minuten ständig rühren, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Salz, Pfeffer und Harissa hinzufügen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den dicken Teig in eine geölte 8x8 Zoll große Form geben und 10 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald die Masse abgekühlt und fest ist, in Quadrate oder Dreiecke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das restliche Olivenöl in einer Pfanne erhitzen und die Calentica-Stücke pro Seite etwa 2 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm servieren und nach Wunsch Harissa zum Dippen dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
