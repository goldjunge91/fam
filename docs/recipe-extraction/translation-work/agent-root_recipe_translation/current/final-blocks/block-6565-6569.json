      "steps": [
        {
          "position": 0,
          "text": "Weiche Kichererbsen und Bohnen über Nacht ein und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib eingeweichte Hülsenfrüchte, Weizenkörner und Wasser in einen großen Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze und lasse alles 60 Minuten unter gelegentlichem Rühren köcheln, bis Hülsenfrüchte und Weizen sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Zucker, Rosinen, Walnüsse, Haselnüsse, Zimt und Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles weitere 10 Minuten köcheln, damit sich die Aromen verbinden. Verteile die Aschure auf Schalen und serviere sie warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
