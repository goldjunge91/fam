      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und wickle die Rote Bete in Alufolie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste sie 35-40 Minuten, bis sie sich leicht mit einer Gabel einstechen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Rote Bete aus dem Ofen und lass sie leicht abkühlen. Schäle sie dann und schneide sie in Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre währenddessen Olivenöl, Apfelessig, Senf, Honig, Salz und Pfeffer zu einer Vinaigrette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste gehackte Walnüsse 3 Minuten in einer trockenen Pfanne bei mittlerer Hitze, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den Blattsalat auf zwei Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die Bowls mit gerösteter Roter Bete, Walnüssen, zerbröseltem Ziegenkäse und frischem Thymian.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle alles mit der Vinaigrette und serviere die Bowls.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
