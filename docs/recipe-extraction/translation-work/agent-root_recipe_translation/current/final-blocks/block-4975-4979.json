      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und lege eine 9-inch Kuchenform mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Graham-Cracker-Brösel mit geschmolzener Butter und Salz und drücke die Mischung fest auf den Boden der Kuchenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe den Boden 8 Minuten leicht goldbraun. Nimm ihn heraus und lass ihn vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile Dulce de Leche gleichmäßig auf dem abgekühlten Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Bananen in Scheiben und lege sie in einer Lage auf die Dulce de Leche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage Sahne mit Puderzucker und Vanilleextrakt steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Schlagsahne auf der Bananenschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reibe dunkle Schokolade mit einer feinen Reibe darüber und stelle den Kuchen bis zum Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
