      "steps": [
        {
          "position": 0,
          "text": "Zerdrücke etwa die Hälfte der Kichererbsen grob mit einer Gabel. Dadurch dickt die Brühe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Knoblauch 2 Minuten in Olivenöl an. Gib Rosmarin und Tomatenmark dazu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib alle Kichererbsen und die Brühe dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Pasta direkt in den Topf und koche sie 10-12 Minuten unter häufigem Rühren, bis sie weich und die Brühe dick ist. Gib bei Bedarf Wasser dazu. Garniere das Gericht mit Parmesan.",
          "timerMinutes": null,
