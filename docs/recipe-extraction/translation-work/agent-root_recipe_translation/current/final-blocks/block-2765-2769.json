      "steps": [
        {
          "position": 0,
          "text": "Püriere Scotch-Bonnet-Chilis, Knoblauch, Ingwer, Thymian, Frühlingszwiebeln, Piment, Sojasauce, Limettensaft und Olivenöl in einer Küchenmaschine glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Jerk-Marinade gründlich rundherum auf die Hähnchenstücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Hähnchen in einen großen Behälter oder Gefrierbeutel und stelle es 4-8 Stunden oder über Nacht in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Grill oder Ofen auf 400°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beim Grillen: Lege das Hähnchen auf den Grill bei mittlerer bis hoher Hitze und gare es 25-30 Minuten. Wende es alle 5-7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beim Backen: Lege das Hähnchen auf ein mit Backpapier belegtes Blech und backe es 40-45 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse es vor dem Servieren 5 Minuten ruhen und serviere es mit Reis und Erbsen oder Festival-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
