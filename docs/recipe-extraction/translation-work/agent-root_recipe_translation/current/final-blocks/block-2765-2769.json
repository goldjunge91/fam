          "position": 2,
          "text": "Erhitze eine große gusseiserne Pfanne oder einen Grill auf mittlere bis hohe Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das marinierte Schweinefleisch 2-3 Minuten pro Seite goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege es in einen abgedeckten Bräter und backe es bei 350°F 2 Stunden. Rühre gelegentlich um, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Deckel ab und backe das Fleisch weitere 15 Minuten, damit die Außenseite karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
