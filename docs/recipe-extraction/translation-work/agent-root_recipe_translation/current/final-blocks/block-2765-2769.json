          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kartoffeln und Karotten hinzu und lasse alles weitere 40 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Eintopf heiß in tiefen Schalen mit der kräftigen Sauce.",
