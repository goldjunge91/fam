      "steps": [
        {
          "position": 0,
          "text": "Koche den Korianderreis. Röste den Mais 5 min in einer heißen, trockenen Pfanne, bis er angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge den Mais mit Mayonnaise, der Hälfte des Cotija, Limette, Chilipulver und Knoblauchpulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze und grille oder brate das Hähnchen scharf an. Schneide es in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die schwarzen Bohnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte Reis, Bohnen, Mais, Hähnchen und Avocado in Schalen. Gib den restlichen Cotija und Koriander darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
