      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchenschenkel und brate sie in Öl je Seite 4 min an. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste die Zwiebel im selben Topf 3 min an. Gib Knoblauch dazu und gare ihn 1 min.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die Tomate und gib sie mit Kreuzkümmel, geräuchertem Paprikapulver und Safran in den Topf. Gare alles 2 min.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis dazu und röste ihn 1 min an. Gieße die Brühe hinein und bringe sie zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Hähnchen darauf, decke den Topf ab und gare alles bei niedriger Hitze 25 min.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Erbsen für die letzten 5 min dazu. Lockere den Reis auf und serviere das Gericht mit Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
