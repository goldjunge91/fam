      "steps": [
        {
          "position": 0,
          "text": "Röste die Poblano-Chilis direkt über einer Flamme. Lege sie 10 min in einen Beutel, ziehe die Haut ab, schlitze sie auf und entferne die Kerne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Rindfleisch mit Zwiebel, Knoblauch, Kreuzkümmel, Zimt, Rosinen und Mandeln 8 min an. Würze es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Chilis vorsichtig mit der Fleischmischung und verschließe sie mit einem Zahnstocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trenne die Eier. Schlage das Eiweiß steif und hebe das Eigelb unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende die gefüllten Chilis in Mehl, tauche sie in den Eierteig und brate sie in heißem Öl je Seite 2 min.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Tomaten mit Knoblauch köcheln und gib die Sauce über die angerichteten Chilis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
