        {
          "position": 0,
          "text": "Sucuk in dünne Scheiben und Zwiebel sowie Paprika in Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sucuk-Scheiben hinzufügen und 2–3 Minuten braten, bis sich die Ränder wellen und Fett austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebel und Paprika hinzufügen und 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier mit Abstand direkt zwischen die Sucuk-Scheiben in die Pfanne schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwa 3–4 Minuten garen, bis das Eiweiß gestockt und das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer würzen und mit frischer Petersilie bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Direkt aus der Pfanne mit warmem Pitabrot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
