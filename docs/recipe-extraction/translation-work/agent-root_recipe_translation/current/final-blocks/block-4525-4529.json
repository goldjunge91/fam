      "steps": [
        {
          "position": 0,
          "text": "Spinat und Zwiebel fein hacken und in 1 EL Butter anbraten, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Feta in eine Schüssel bröckeln, Eier einrühren und dann die gegarte Spinatmischung mit Dill unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füllung nach Geschmack mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Restliche Butter schmelzen und ein Filoteigblatt auf ein Backblech legen, leicht mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drei weitere Filoteigblätter darauflegen und jedes mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hälfte der Füllung gleichmäßig auf dem Filoteig verteilen, dann vier weitere gebutterte Blätter darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Restliche Füllung darauf verteilen und mit dem letzten mit Butter bestrichenen Filoteigblatt abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einem scharfen Messer in Quadrate schneiden und bei 375 °F 25–30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
