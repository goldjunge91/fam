      "steps": [
        {
          "position": 0,
          "text": "Ofen auf 375°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweine- und Rindfleisch in einer großen Pfanne bei mittlerer bis hoher Hitze anbraten und dabei das Fleisch zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Knoblauch hinzufügen; 3 Minuten kochen, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffeln, Rinderbrühe, Zimt, Nelken, Salz und Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ohne Deckel 20 Minuten köcheln lassen, bis die Kartoffeln weich sind und sich die Flüssigkeit auf die Hälfte reduziert hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Füllung etwa 10 Minuten lang auf Raumtemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Legen Sie einen Tortenboden in eine 9-Zoll-Kuchenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die abgekühlte Fleischfüllung in die Kruste gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Den zweiten Tortenboden darauflegen, die Ränder verschließen und mit geschlagenem Ei bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "30–35 Minuten backen, bis die Kruste goldbraun und die Füllung heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
