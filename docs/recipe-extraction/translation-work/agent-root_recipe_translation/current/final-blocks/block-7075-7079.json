      "steps": [
        {
          "position": 0,
          "text": "Erhitzen Sie eine große Pfanne bei mittlerer bis hoher Hitze und bräunen Sie das Schweinehackfleisch darin an. Brechen Sie es beim Kochen auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel und Knoblauch hinzufügen; 3 Minuten kochen, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Semmelbrösel, Salz, Pfeffer und Salbei unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser hinzufügen und die Hitze auf einen niedrigen Wert reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ohne Deckel 25–30 Minuten unter gelegentlichem Rühren köcheln lassen, bis die Mischung sehr dickflüssig ist und die Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einem Teller vollständig abkühlen lassen; es wird beim Abkühlen fester.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei Zimmertemperatur servieren oder aufgewärmt auf Toast oder Brot verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
