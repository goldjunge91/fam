      "steps": [
        {
          "position": 0,
          "text": "Wenn Sie vorgeschnittenes Räucherfleisch in einem Feinkostladen kaufen, bitten Sie darum, es hoch auf den Allesschneider zu stapeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Roggenbrotscheiben außen leicht mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Pfanne bei mittlerer Hitze erhitzen und das Butterbrot leicht goldbraun rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das geräucherte Fleisch in derselben Pfanne unter leichtem Rühren 1-2 Minuten lang schnell erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das geröstete Brot mit gelbem Senf bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warmes Räucherfleisch großzügig auf eine Brotscheibe legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der zweiten Scheibe belegen und sofort mit eingelegten Gurken als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
