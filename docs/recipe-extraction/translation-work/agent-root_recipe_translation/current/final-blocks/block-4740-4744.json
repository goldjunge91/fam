      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und lege ein großes Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile den geputzten Spargel und die Kirschtomaten auf dem Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass die Butter in einem kleinen Topf bei mittlerer Hitze schmelzen. Gib den gehackten Knoblauch und die Chiliflocken dazu und dünste alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre den Weißwein und den Zitronensaft ein und nimm den Topf anschließend vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Garnelen zum Gemüse auf das Blech. Gieße die Knoblauch-Butter-Mischung darüber und würze alles mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe alles 12-15 Minuten, bis die Garnelen rosa und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue das Gericht mit frischer Petersilie und serviere es zu Pasta oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
