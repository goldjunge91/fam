      "steps": [
        {
          "position": 0,
          "text": "Bringe einen Topf Salzwasser zum Kochen und blanchiere den Kohl 2 Minuten. Gieße ihn anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blanchiere die Karotten 2-3 Minuten bissfest und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Blanchiere den Spinat 1 Minute, drücke ihn trocken und hacke ihn grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Blanchiere die Sojasprossen 1 Minute und lass sie gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerstoße geröstete Erdnüsse, Knoblauch und Chilis zusammen zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Palmzucker, Limettensaft, Salz und Kokosmilch zu einer Sauce ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte das blanchierte Gemüse auf einem Teller an und beträufle es mit Erdnusssauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht bei Zimmertemperatur mit gedämpftem Reis und hartgekochten Eiern als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
