      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und brate die Rindfleischwürfel insgesamt etwa 8 Minuten von allen Seiten braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch, Schalotten, Ingwer und Galgant dazu und rühre etwa 2 Minuten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Kurkuma und gemahlene schwarze Nüsse hinzu und rühre 1 Minute ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe dazu, bringe sie zum Kochen, reduziere dann die Hitze und lass alles zugedeckt 60 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Salz, Pfeffer und Limettensaft dazu und schmecke das Gericht ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass alles weitere 5 Minuten köcheln und serviere es heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
