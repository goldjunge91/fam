      "steps": [
        {
          "position": 0,
          "text": "Hacke Schalotten, Knoblauch und Ingwer zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Hähnchenbrust in kleine Stücke und schäle die Garnelen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gehackten aromatischen Zutaten hinein und brate sie 1-2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Hähnchen und Garnelen hinzu und brate alles unter ständigem Rühren 4-5 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib kalten Reis dazu, löse Klümpchen auf und brate ihn 3-4 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Sojasauce und süße Sojasauce dazu und schwenke alles, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schiebe den Reis an den Pfannenrand, rühre die Eier in der freien Fläche und vermenge sie dann mit dem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rühre zum Schluss Limettensaft und geschnittene Frühlingszwiebeln ein und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
