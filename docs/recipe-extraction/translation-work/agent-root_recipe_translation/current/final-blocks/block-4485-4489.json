      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 300°F vorheizen und Backbleche mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Eiweiß mit einer Prise Salz schlagen, bis weiche Spitzen entstehen. Dann nach und nach den Puderzucker einrieseln lassen und weiterschlagen, bis die Masse fest und glänzend ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Mandelmehl in 3 Portionen vorsichtig unter die Baisermasse heben, dann die Portionen teilen und nach Belieben mit Lebensmittelfarbe einfärben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig mit einem Spritzbeutel mit runder Tülle als 0.75 Zoll große Tupfen auf die Backbleche spritzen, mit 1 Zoll Abstand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "20-25 Minuten backen, bis sie fest, aber nicht gebräunt sind. Dann 5 Minuten auf den Backblechen abkühlen lassen und anschließend auf ein Gitter setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Schlagsahne mit Butter und Vanille schlagen, bis sie luftig ist, und so die Buttercremefüllung herstellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Plätzchen nach Größe zusammenstellen und jeweils 2 Gebäckhälften mit Buttercreme zusammensetzen, dabei leicht andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren oder bis zum Servieren im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
