      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 325°F vorheizen und zwei runde Kuchenformen mit 8 Zoll Durchmesser einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Eiweiß steif schlagen und nach und nach 0.75 Tasse Zucker einrieseln lassen, bis eine glänzende Baisermasse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer anderen Schüssel die Eigelbe mit dem restlichen Zucker hellcremig schlagen und vorsichtig unter die Baisermasse heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gemahlene Mandeln und Mehl unter die Eimasse heben, auf die Formen verteilen und 35-40 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Kuchen vollständig abkühlen lassen, dann jede Schicht vorsichtig waagerecht teilen, sodass 4 dünne Böden entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "0.25 Tasse Kirschwasser mit 0.25 Tasse Wasser vermischen und auf jeden Kuchenboden streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Schlagsahne mit Puderzucker steif schlagen, die halbierten Kirschen und das restliche Kirschwasser unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Böden mit der Kirschsahne schichten, vorsichtig stapeln, die Außenseite mit Sahne bestreichen und mit Schokoladenraspeln und ganzen Kirschen garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
