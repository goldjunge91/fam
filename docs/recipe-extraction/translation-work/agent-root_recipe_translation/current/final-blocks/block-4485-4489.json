      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 375°F vorheizen und eine runde Backform mit 9 Zoll Durchmesser einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Backpulver, Salz und Kümmelsamen in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter und Zucker cremig schlagen, bis die Masse hell und luftig ist, dann die Eier nacheinander einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mehlmischung unter die Eiermasse heben, anschließend den geriebenen Käse und die saure Sahne unterheben, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in die vorbereitete Form geben und die Oberfläche glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "35-40 Minuten backen, bis der Kuchen goldbraun ist und ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "10 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
