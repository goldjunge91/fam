      "steps": [
        {
          "position": 0,
          "text": "Honig und Butter zusammen erhitzen, bis sie geschmolzen sind, dann leicht abkühlen lassen und Eier und braunen Zucker einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Zimt, Nelken und Muskatnuss in einer separaten Schüssel vermischen und anschließend unter die Honigmischung heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kandierte Zitrusschale und Mandeln unterrühren, bis alles gleichmäßig verteilt ist, dann den Teig 1 Stunde kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Backofen auf 350°F vorheizen und Backbleche mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig zwischen Backpapier auf 0.5 Zoll Dicke ausrollen und in 1.5 Zoll große Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf die Backbleche legen und 12-15 Minuten backen, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Puderzucker und Wasser zu einem dünnen Guss verrühren und auf die warmen Plätzchen streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vollständig abkühlen lassen und anschließend mindestens 1 Woche in einem luftdichten Behälter aufbewahren, damit sich das Aroma entwickelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
