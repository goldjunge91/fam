      "steps": [
        {
          "position": 0,
          "text": "Speck hacken und in einem großen Topf knusprig braten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleisch und Chorizo in 1 cm große Stücke schneiden und anschließend 5 Minuten im Speckfett anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch dazugeben und 2 Minuten anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Rinderbrühe aufgießen und Lorbeerblätter, Kartoffelwürfel und Karotten dazugeben; 45 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kichererbsen abgießen und abspülen, dann mit gehacktem Kohl und gekochtem Speck in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 20 Minuten köcheln lassen, bis das gesamte Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln als herzhafter Eintopf mit knusprigem Brot als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
