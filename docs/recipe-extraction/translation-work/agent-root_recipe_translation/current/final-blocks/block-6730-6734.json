      "steps": [
        {
          "position": 0,
          "text": "Lammleber, -herz, -lunge und -schulter 60 Minuten lang in Wasser kochen, bis sie weich sind, dabei 1 Tasse Kochflüssigkeit auffangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Alles gekochte Fleisch mit gehackten Zwiebeln und Knoblauch fein hacken oder mahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Haferflocken in einer trockenen Pfanne 3 Minuten unter ständigem Rühren rösten, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hackfleisch mit Talg, gerösteten Haferflocken, Salz, Pfeffer, Cayennepfeffer und Thymian in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fügen Sie nach und nach die zurückbehaltene Kochflüssigkeit hinzu, bis die Mischung feucht, aber nicht nass ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hülle gründlich abspülen und mit der Fleischmischung füllen, dann beide Enden festbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Haggis in kochendes Wasser geben und 90 Minuten köcheln lassen, dabei leicht kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vorsichtig herausnehmen, 5 Minuten ruhen lassen, dann in Scheiben schneiden und mit Kartoffelpüree und Steckrüben servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
