      "steps": [
        {
          "position": 0,
          "text": "Vermenge Putenhack, Semmelbrösel, Ei, Muskat, Piment, geriebene Zwiebel und Salz. Forme daraus Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Fleischbällchen 5-6 Minuten in Butter an, bis sie gebräunt sind. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Rahmsoße zu: Verrühre Butter und Mehl zu einer Mehlschwitze, gib Brühe dazu und lass alles 3 Minuten köcheln. Rühre den griechischen Joghurt abseits der Hitze ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Fleischbällchen zurück in die Soße. Serviere sie auf Eiernudeln mit Preiselbeermarmelade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
