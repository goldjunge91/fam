      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln etwa 15 Minuten, bis sie gerade weich sind, und schneide sie dann in Viertel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Putze die grünen Bohnen und koche sie 4-5 Minuten, bis sie gar, aber noch bissfest sind. Lass sie abtropfen und abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche die Eier nach einem einfachen Rezept hart und schneide sie in Viertel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass den Thunfisch abtropfen und zerteile ihn mit einer Gabel in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Olivenöl, Rotweinessig und Dijon-Senf in einer kleinen Schüssel zu einem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Blattsalat auf zwei Tellern an und verteile Kartoffeln, grüne Bohnen, Thunfisch, Eier, Tomaten und Oliven darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle den Salat mit dem Dressing, würze mit Salz und Pfeffer und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
