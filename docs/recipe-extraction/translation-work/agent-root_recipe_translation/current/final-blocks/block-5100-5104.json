      "steps": [
        {
          "position": 0,
          "text": "Koche die Reisfadennudeln nach Packungsanleitung, gieße sie ab und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite eine flache Schüssel mit warmem Wasser zum Einweichen der Reispapierblätter vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle die gegarten Garnelen und halbiere sie längs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Gurke in dünne Stifte und zupfe den Salat in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bereite den Dip zu, indem du Erdnussbutter, Sojasauce, Limettensaft, Wasser und gehackten Knoblauch glatt verrührst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tauche ein Reispapierblatt 3-4 Sekunden in warmes Wasser, bis es biegsam ist, und lege es auf eine saubere Fläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege Salat, Minze, Koriander, Nudeln, Gurke und Garnelen auf das untere Drittel des Reispapiers.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Klappe die Seiten ein und rolle das Papier fest von dir weg auf, sodass die Naht unten liegt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die Sommerrollen sofort mit dem Erdnuss-Dip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
