    {
      "externalId": "waivy:mfr-nafr2-couscous-royale",
      "slug": "mfr-nafr2-couscous-royale",
      "title": "Couscous Royale (marokkanischer Festtags-Couscous)",
      "instructions": "Die Königin der marokkanischen Küche: Lockerer, gedämpfter Couscous wird hoch aufgeschichtet und mit langsam geschmortem Hähnchen und Merguez-Wurst, geröstetem Gemüse, einer kräftigen Ras-el-Hanout-Brühe und Harissa als Beilage serviert. Das ultimative Freitagsgericht, das viele satt macht und den ganzen Raum mit seinem Duft erfüllt.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 60,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Merguez vom Halal-Metzger ist sehr erschwinglich und authentisch.",
        "Bereite die Brühe besonders aromatisch zu. Sie kommt über alle Zutaten, und die Brühe ist das Herzstück des Gerichts.",
        "Reste von Couscous Royale ergeben für 3 Tage ausgezeichnete Mittagessen."
      ],
      "substitutions": [
        {
          "forIngredientId": "merguez",
          "swap": "Italienische Wurst mit geräuchertem Paprikapulver und Kreuzkümmel"
        },
