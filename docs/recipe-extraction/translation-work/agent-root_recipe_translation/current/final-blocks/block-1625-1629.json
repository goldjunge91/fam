      "steps": [
        {
          "position": 0,
          "text": "Vermische Lammfleisch mit der Hälfte der Gewürze, geriebener Zwiebel und Petersilie. Forme kleine Bällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Fleischbällchen 5 Minuten von allen Seiten in Öl an und nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die restliche Zwiebel an. Gib Knoblauch und die übrigen Gewürze dazu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Tomaten hinzu und lass alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Fleischbällchen zurück in die Sauce und lass sie 10 Minuten köcheln. Drücke Mulden hinein, schlage Eier hinein, decke die Pfanne ab und gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
