      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen und eine runde Kuchenform von 8-inch mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker luftig aufschlagen, dann die Eier einzeln einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl und Backpulver zusammen sieben und unter die feuchten Zutaten heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in die vorbereitete Form gießen und 25-30 Minuten backen, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kuchen vollständig abkühlen lassen und waagerecht in zwei Böden schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dulce de Leche auf dem unteren Boden verstreichen und den zweiten Boden daraufsetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Puderzucker und Kakaopulver vermengen und großzügig über den Kuchen stäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mindestens 1 Stunde kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
