      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem mittelgroßen Topf bei mittelhoher Hitze erhitzen. Zwiebeln dazugeben und unter gelegentlichem Rühren garen, bis sie zu karamellisieren beginnen. Karotten dazugeben und etwa 4 Minuten weitergaren, bis sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brühe, Wasser, Kartoffeln, Lorbeerblätter und schwarze Pfefferkörner dazugeben. Salzen und aufkochen. Hitze reduzieren, abdecken und 10 Minuten kochen. Hirse dazugeben und weitere 15 Minuten garen, bis Hirse und Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischwürfel vorsichtig dazugeben. Umrühren und Suppe zum Köcheln bringen. Der Fisch gart sehr schnell, also nicht übergaren. Er ist fertig, wenn das Fleisch undurchsichtig ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vor dem Servieren mit gehacktem frischem Dill oder Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
