      "steps": [
        {
          "position": 0,
          "text": "Scheibe Zwiebeln thinly und beiseitestellen in ein Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "mischen chickpea Mehl, Kreuzkümmel, Koriander, Kurkuma, cayenne, und Salz in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "hinzufügen Wasser zu der Mehl Mischung gradually, stirring bis du get ein dick Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "unterheben in der in Scheiben geschnitten Zwiebeln und frisch Koriandergrün.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "erhitzen Öl in ein deep Pfanne zu 350°F oder bis ein drop von Teig sizzles immediately.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drop spoonfuls von der Teig in der heiß Öl und fry für 3-4 Minuten bis goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
