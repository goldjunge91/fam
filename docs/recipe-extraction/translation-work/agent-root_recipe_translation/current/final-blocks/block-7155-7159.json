      "steps": [
        {
          "position": 0,
          "text": "erhitzen Öl in ein groß Topf bei mittlerer bis hoher Hitze und brown Rindfleisch chunks in batches, etwa 3 Minuten per side, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sauté gewürfelt Zwiebeln im selben Topf für 3-4 Minuten bis weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "umrühren in Tomate Paste und garen für 1 Minute zu caramelize slightly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "zurückgeben Rindfleisch zu Topf, hinzufügen Brühe und Thymian, und bring zu köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "schneiden carrots und potatoes in chunks und hinzufügen zu Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "köcheln für 60 Minuten, covered, bis Rindfleisch is very tender und vegetables are gegart through.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer würzen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
