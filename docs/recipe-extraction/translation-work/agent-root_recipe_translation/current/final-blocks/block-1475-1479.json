      "steps": [
        {
          "position": 0,
          "text": "Würze das Hähnchen mit Kreuzkümmel, Oregano, Salz und Pfeffer. Brate es in Öl rundherum braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Orangensaft, Knoblauch, Lorbeerblatt und so viel Wasser hinzu, dass das Fleisch halb bedeckt ist. Gare es zugedeckt bei 325°F 45 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Deckel ab, erhöhe die Hitze und gare alles 15 Minuten, bis die Flüssigkeit reduziert ist und das Hähnchen beginnt, im eigenen Fett zu braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerpflücke das Fleisch, verteile es auf einem Blech und grille es 5 Minuten, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere das Fleisch auf warmen Tortillas mit eingelegter Zwiebel aus Essig und Zwiebel, Koriander und Salsa Verde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
