      "steps": [
        {
          "position": 0,
          "text": "Röste den tiefgekühlten Mais 5–6 Minuten bei starker Hitze in einer trockenen gusseisernen Pfanne, bis er leicht geschwärzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Butter und Knoblauch unter und gare alles 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Pfanne vom Herd und vermische den Mais mit Mayonnaise, Limettensaft, Chilipulver und der Hälfte des Käses.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Mais in Becher und garniere ihn mit dem restlichen Cotija, Paprika und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
