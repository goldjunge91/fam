    {
      "externalId": "waivy:mfr-mex2-esquites",
      "slug": "mfr-mex2-esquites",
      "title": "Esquites (mexikanischer Straßenmais im Becher)",
      "instructions": "In Butter angebratene Maiskörner, vermischt mit Mayonnaise, Limettensaft und Chilipulver, im Becher mit Cotija-Käse und frischem Koriander bestreut. Die praktische Variante von Elote zum Mitnehmen, die zu Hause schneller gelingt als am Straßenstand.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 10,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Tiefgekühlter Mais ist günstiger als frische Maiskolben und lässt sich genauso gut rösten.",
        "Feta ist ein idealer Ersatz für Cotija und hat dieselbe salzige, krümelige Konsistenz.",
        "Das Rezept lässt sich leicht für eine Party vervielfachen. Bereite einfach eine größere Menge zu."
      ],
      "substitutions": [
        {
          "forIngredientId": "feta",
          "swap": "Cotija oder Parmesan, jeder trockene salzige Käse"
        },
        {
          "forIngredientId": "mayonnaise",
          "swap": "Griechischer Joghurt für eine leichtere Variante"
        }
      ],
      "crispinessLevel": null,
