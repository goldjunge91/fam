          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Pandanblätter entfernen und Süße sowie Konsistenz nach Wunsch anpassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm in Schüsseln servieren und nach Belieben mit braunem Zuckersirup beträufeln.",
