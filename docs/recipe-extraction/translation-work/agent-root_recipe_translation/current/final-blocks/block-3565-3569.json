      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch in dünne, mundgerechte Stücke und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke den Knoblauch fein.",
