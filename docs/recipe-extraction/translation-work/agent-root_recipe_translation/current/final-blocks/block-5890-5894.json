      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate die gewürfelte Aubergine 5 Minuten, bis sie weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gewürfelte Zwiebel hinzu und brate sie weitere 3 Minuten. Rühre dann den gehackten Knoblauch ein und brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib stückige Tomaten, Paprikapulver, Kreuzkümmel, Salz und Pfeffer dazu. Lass die Sauce 10 Minuten köcheln, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme vier kleine Mulden in der Tomatensauce und schlage jeweils ein Ei hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne ab und gare alles bei mittlerer Hitze 6–8 Minuten, bis das Eiweiß gestockt ist und das Eigelb noch flüssig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere das Gericht mit frischem Koriander und serviere es direkt aus der Pfanne mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
