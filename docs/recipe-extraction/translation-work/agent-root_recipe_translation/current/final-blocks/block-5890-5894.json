      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer Hitze. Gib die Kreuzkümmelsamen hinein und röste sie 30 Sekunden, bis sie knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gewürfelte Zwiebel hinzu und brate sie etwa 4 Minuten weich. Rühre Ingwer und Knoblauch ein und brate alles 1 Minute weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kurkuma, gemahlenen Koriander und Chilipulver hinzu. Rühre 30 Sekunden ständig, bis die Gewürze duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Kartoffelwürfel dazu und brate sie unter gelegentlichem Rühren 10 Minuten, bis sie langsam weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Auberginenwürfel und Salz ein. Decke die Pfanne ab und gare alles unter gelegentlichem Rühren 10–12 Minuten, bis beide Gemüse weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke das Gericht ab, garniere es mit frischem Koriander und serviere es heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
