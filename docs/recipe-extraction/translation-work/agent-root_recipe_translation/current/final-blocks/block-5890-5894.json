      "steps": [
        {
          "position": 0,
          "text": "Schäle die Auberginen, würfle sie und brate sie in Öl bei mittlerer bis hoher Hitze etwa 12 Minuten goldbraun und weich. Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Karamellisiere die geschnittenen Zwiebeln im selben Öl bei mittlerer Hitze 8–10 Minuten, bis sie dunkelbraun sind. Gib den gehackten Knoblauch dazu und brate ihn 1 Minute mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Auberginen zurück in die Pfanne, würze mit Salz und Pfeffer und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Auberginenmischung auf eine Servierplatte und beträufle sie mit Kaschk-Molke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile Minze, Petersilie, Dill und Walnüsse darauf, beträufle alles mit Granatapfelsirup und serviere es bei Zimmertemperatur mit Lavash-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte frische Kräuter (Minze, Petersilie und Dillzweige), Radieschen und Frühlingszwiebeln als traditionelle Beilage zu Sabzi Khordan auf einer Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
