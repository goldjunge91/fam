          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Salz, weißen Pfeffer und gegartes Schweinefleisch hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In Schalen anrichten und mit Frühlingszwiebeln, Ingwer und gewürfeltem Tausendjährigem Ei garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nach Geschmack mit Sojasauce oder Sesamöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
