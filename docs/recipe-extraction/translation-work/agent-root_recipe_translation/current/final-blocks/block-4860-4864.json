      "steps": [
        {
          "position": 0,
          "text": "Brühe und Wasser in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Reis abspülen und in die kochende Brühe geben. Gelegentlich umrühren, damit er nicht am Topfboden klebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hitze reduzieren und 40 Minuten köcheln lassen. Häufig umrühren, bis der Reis zerfällt und ein cremiger Brei entsteht.",
