      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 400 °F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wurstbrät, Semmelbrösel, Ei, Zwiebelpulver, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Blätterteig ausrollen und der Länge nach halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Wurstmischung zu 2 langen Rollen formen und jeweils eine auf einen Blätterteigstreifen legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Blätterteig um die Wurst wickeln und die Naht mit Wasser verschließen. Jede Rolle in 4 Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Rollen mit der Naht nach unten auf das Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eigelb mit 1 EL Wasser verquirlen und die Rollen damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 400 °F 20 Minuten backen, bis sie goldbraun sind. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
