      "steps": [
        {
          "position": 0,
          "text": "Maiskörner mit Milch pürieren, bis die Masse größtenteils glatt ist, aber noch kleine Maisstücke enthält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischung durch ein feines Sieb passieren und grobe Stücke vorsichtig herausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier mit Zucker und Salz verquirlen und dann unter die Maismischung heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter auf einer Grillplatte oder in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Je Cachapa 0.25 cup Teig auf die heiße Grillplatte geben und 3-4 Minuten garen, bis die Ränder fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Einen Streifen Käse in die Mitte legen und Cachapa wie einen Pfannkuchen halb zusammenklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 1-2 Minuten garen, bis beide Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm servieren und nach Wunsch zusätzlichen Käse oder Avocado dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
