      "steps": [
        {
          "position": 0,
          "text": "Kochbananen und Yuca schälen und separat etwa 20 Minuten weich kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Beides abgießen und zusammen glatt zerstampfen, mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer Pfanne erhitzen und Rinderhack mit Zwiebel, Knoblauch und Sofrito gar braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Oliven einrühren und weitere 2 Minuten garen, dann Füllung herausnehmen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit feuchten Händen einen Löffel Kochbananen-Yuca-Mischung nehmen und auf einem Plastikbeutel zu einer Scheibe flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Einen Löffel Fleischfüllung in die Mitte geben, Ränder hochklappen und zu einer ovalen Kugel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl auf 350°F erhitzen und Alcapurrias portionsweise insgesamt etwa 5-6 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Essig oder scharfer Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
