      "steps": [
        {
          "position": 0,
          "text": "Reis und schwarze Bohnen jeweils nach Packungsanleitung kochen oder zubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen und Zwiebeln sowie Knoblauch weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerpflücktes Rindfleisch, Sofrito, Kreuzkümmel und Salz hinzufügen und unter Rühren 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatensauce und Rinderbrühe angießen und 15-20 Minuten köcheln lassen, bis sich die Aromen verbinden und Flüssigkeit reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reife Kochbananen schälen und schräg in dünne Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer separaten Pfanne erhitzen und Kochbananenscheiben insgesamt etwa 3-4 Minuten von beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schwarze Bohnen in einem separaten Topf mit etwas Wasser erwärmen, falls nötig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reis als Grundlage servieren, die Rindfleischmischung daraufgeben und gebratene Kochbananen sowie schwarze Bohnen dazu anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
