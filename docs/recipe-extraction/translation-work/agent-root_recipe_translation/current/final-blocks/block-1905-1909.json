      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf bei mittlerer Hitze erwärmen und Öl hineingeben. Sobald es heiß ist, gehacktes Gemüse dazugeben und 5 bis 10 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "6 Tassen Wasser, Linsen, Thymian, Lorbeerblätter und Salz hinzufügen. Zum Kochen bringen und dann rasch köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Linsen 20 bis 25 Minuten köcheln lassen, bis sie weich sind und den Großteil des Wassers aufgenommen haben. Bei Bedarf nach dem Garen überschüssiges Wasser abgießen. Sofort servieren oder abkühlen lassen und später aufwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für einen kräftigeren Geschmack etwas Hühnerbrühe verwenden und die Wassermenge entsprechend reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
