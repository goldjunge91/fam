      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350˚F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Alle Zutaten für den Boden (Graham-Cracker-Krümel, geschmolzene Butter, Kristallzucker und gemahlenen Zimt) in einer mittelgroßen Schüssel vermischen. Etwa 2 Tbsp (30 mL) für später beiseitelegen und die restliche Mischung in den Boden und an die Seiten einer tiefen Pieform von 9-inch drücken. Boden 10 Minuten backen. Er bräunt nur leicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zutaten für die Vanillepuddingfüllung (Milch, Kristallzucker, Maisstärke, Eigelb, Vanilleextrakt und Salz) verrühren und bei mittlerer Hitze unter ständigem Rühren kochen, bis die Mischung blubbert und puddingartig eindickt. Zum Abkühlen beiseitestellen, während das Baiser zubereitet wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Baiserzutaten (Eiweiß, Kristallzucker, Weinstein) in einer Küchenmaschine mit Schneebesen oder in einer großen Schüssel mit elektrischem Mixer steif und glänzend schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füllung in den Boden gießen und dick mit Baiser bedecken. Kleine Spitzen formen, die oben bräunen. Zurückbehaltene Krümel darüberstreuen und in den vorgeheizten Ofen stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwa 10 Minuten backen, bis das Baiser bräunt. Gut beobachten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Im Kühlschrank kühlen und innerhalb weniger Stunden nach dem Backen essen. Dieser Pie schmeckt am selben Tag am besten, weil das Baiser weich und flüssig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
