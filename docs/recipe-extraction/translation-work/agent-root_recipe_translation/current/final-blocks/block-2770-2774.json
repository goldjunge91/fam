      "steps": [
        {
          "position": 0,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und brate Knoblauch und Frühlingszwiebeln 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Reis dazu und rühre 2 Minuten ständig, bis er leicht geröstet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Kokosmilch und Brühe dazu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib rote Kidneybohnen und Thymian dazu und würze mit Salz, schwarzem Pfeffer und Cayennepfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze auf niedrig und decke den Topf fest ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse den Reis 20 Minuten köcheln, ohne den Deckel abzunehmen, bis er weich und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lockere den Reis mit einer Gabel auf und entferne vor dem Servieren die Thymianzweige.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
