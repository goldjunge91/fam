      "steps": [
        {
          "position": 0,
          "text": "Weiche den gesalzenen Kabeljau über Nacht ein, um Salz zu entfernen. Koche ihn dann 15 Minuten, gieße ihn ab, lasse ihn abkühlen und zerpflücke ihn fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Backpulver in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre zerpflückten Kabeljau, Zwiebel, Knoblauch, Thymianblätter und gehackte Scotch-Bonnet-Chilischote ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße unter Rühren nach und nach Wasser dazu, bis ein dicker, klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze nach Geschmack mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Löffel des Teigs ins heiße Öl und frittiere sie 2-3 Minuten goldbraun. Wende sie und frittiere sie weitere 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse die Küchlein auf Küchenpapier abtropfen und serviere sie heiß mit scharfer Sauce oder Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
