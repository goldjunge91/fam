      "steps": [
        {
          "position": 0,
          "text": "Erwärme die Milch, bis sie lauwarm ist. Gib die Hefe hinzu und löse sie auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zucker, Kardamom, Vanille und etwa 2/3 des Mehls hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig von Hand oder mit dem Knethaken einer Küchenmaschine und gib langsam das restliche Mehl dazu. Möglicherweise brauchst du etwas mehr oder weniger Mehl, bis ein Teig entsteht, der nicht zu klebrig zum Kneten ist. Wenn der Teig eine schöne Kugel bildet, gib die weiche Butter hinzu und knete ihn etwa zehn Minuten weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig zu einer Rolle und schneide ihn in sechs gleich große Stücke. Forme jedes Stück zu einem runden Brötchen und setze sie in ein gefettetes Muffin- oder Kuchenblech. Decke sie ab und lasse sie etwa eine Stunde gehen, bis sich ihr Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
