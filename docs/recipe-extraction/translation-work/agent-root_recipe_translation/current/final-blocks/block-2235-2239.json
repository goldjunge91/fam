      "steps": [
        {
          "position": 0,
          "text": "– RINDFLEISCH MARINIEREN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rindfleisch, Salz, Sesamöl, weißen Pfeffer, Eiweiß, 2 Esslöffel Maisstärke und 1 Esslöffel Öl in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "– IM WOK BRATEN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate zuerst das Rindfleisch in 2 Esslöffeln Öl, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle das Rindfleisch beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1 Esslöffel Öl, gehackten Ingwer und gehackten Knoblauch in einen Wok und brate alles einige Sekunden unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das gesamte Gemüse sowie Sherry zum Kochen und 1 cup Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Für die Soße Austernsoße, scharfe Pfeffersoße und Zucker hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib das gegarte Rindfleisch und 1 Löffel Sojasoße dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Verrühre zum Andicken der Soße 1 Esslöffel Maisstärke mit 2 Esslöffeln Wasser in einer Schüssel und gib die Mischung langsam unter Rühren in den Wok, bis die Soße die gewünschte Konsistenz hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
