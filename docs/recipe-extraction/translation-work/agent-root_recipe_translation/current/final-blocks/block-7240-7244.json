      ],
      "steps": [
        {
          "position": 0,
          "text": "Koche die Pasta in gut gesalzenem Wasser knapp über al dente. Gieße sie ab, spüle sie kalt ab, um den Garprozess zu stoppen, und lasse sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einer großen Pfanne bei hoher Hitze und gib den Mais in einer Lage hinein. Lasse ihn einige Minuten ungestört braten, bis er stellenweise schwarz wird. Rühre gelegentlich um und stelle ihn zum Abkühlen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Mayonnaise, Sauerrahm, Limettensaft, geriebenen Knoblauch, Chilipulver, 1 tsp Tajín und Salz in einer großen Schüssel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib abgekühlte Pasta, angekohlten Mais, zerbröselten Cotija, gewürfelte Jalapeño und den Großteil des Korianders dazu. Vermenge alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Probiere den Salat und schmecke ihn mit mehr Limettensaft oder Salz ab. Stelle ihn mindestens 30 Minuten kalt, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue ihn kurz vor dem Servieren mit dem übrigen Cotija, Koriander und dem letzten Teelöffel Tajín.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": []
