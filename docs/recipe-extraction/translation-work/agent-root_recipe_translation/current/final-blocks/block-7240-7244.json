      "steps": [
        {
          "position": 0,
          "text": "Koche den Sushi-Reis und rühre Reisessig, Zucker und Salz unter, solange er warm ist. Drücke ihn etwa 3/4-inch dick in eine mit Backpapier ausgelegte Form und stelle ihn 20-30 Minuten kalt, bis er fest ist. Kalter Reis wird besonders knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den festen Reis in Quadrate oder Rechtecke. Erhitze Pflanzenöl in einer beschichteten oder gusseisernen Pfanne bei mittlerer bis hoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Reisküchlein je Seite 3-4 Minuten, ohne sie zu bewegen, bis sie dunkelgolden und knusprig sind. Lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würfle den Lachs fein und vermenge ihn mit Kewpie-Mayonnaise, Sriracha, Sojasauce und Sesamöl, bis er gleichmäßig cremig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die angegarte Variante den scharfen Lachs 1-2 Minuten kurz grillen oder anbraten. Für die Tatar-Variante roh lassen und nur Sushi-Qualität verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege jedes knusprige Reisküchlein mit Avocado und Gurke und gib den scharfen Lachs darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere mit Frühlingszwiebeln, Furikake, Sesam und Nori-Streifen. Sofort servieren, solange der Reis heiß und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
