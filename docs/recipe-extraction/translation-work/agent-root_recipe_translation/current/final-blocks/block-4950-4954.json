      "steps": [
        {
          "position": 0,
          "text": "Röste Zwiebel und Ingwer 5 Minuten unter dem Ofengrill, bis sie geschwärzt sind. Gib sie dann mit Wasser und den Knochen in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe die Brühe zum Kochen, reduziere dann die Hitze und lass sie 2-3 Stunden köcheln. Schöpfe dabei Verunreinigungen von der Oberfläche ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste Zimt, Sternanis, Nelken und Koriander 1 Minute in einer trockenen Pfanne und gib die Gewürze anschließend in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Rinderschulter und Fischsauce dazu und lass die Brühe weitere 1 Stunde köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Rindfleisch heraus, schneide es dünn auf und gieße die Brühe durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Reisnudeln nach Packungsanleitung und verteile sie auf Servierschüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße heiße Brühe über die Nudeln und richte die Rindfleischscheiben darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe mit frischer Chili, Basilikum, Limettenspalten und zusätzlicher Fischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
