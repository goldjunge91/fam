      "steps": [
        {
          "position": 0,
          "text": "Verrühre Sojasauce, Reisessig, Zucker, Chilipaste und Wasser in einer kleinen Schüssel zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwer dazu und rühre 30 Sekunden ständig, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Garnelen dazu und brate sie pro Seite 2 Minuten, bis sie rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Sauce in den Wok und wende die Garnelen 1-2 Minuten darin, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib geschnittene Frühlingszwiebeln dazu und beträufle alles mit Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte das Gericht auf einer Servierplatte an und serviere es sofort mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
