          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen und Gemüse abwechselnd auf Spieße stecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Spieße 12-15 Minuten grillen, alle 3 Minuten wenden, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren 2 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Reis, Salat und Pitabrot servieren.",
