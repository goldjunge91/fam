      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in Stücke schneiden und mit gewürfelten Zwiebeln, Knoblauch, Zimt, Ingwer und Safran in Olivenöl bei mittlerer Hitze 25 Minuten garen, bis es durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen aus der Pfanne nehmen, fein zerpflücken und zurück in die Pfanne geben; etwa 10 Minuten einkochen lassen, bis die Flüssigkeit fast vollständig verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer separaten Pfanne Eier stocken lassen, vorsichtig unter die Hähnchenmischung heben und vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mandelblättchen in einer trockenen Pfanne 3 Minuten rösten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein Filoteigblatt auf die Arbeitsfläche legen und großzügig mit geschmolzener Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine dünne Schicht Hähnchenmischung und einige Mandeln auf ein Viertel des Filoteigblatts geben, zu einem Dreieck falten und mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem übrigen Filoteig und der Füllung wiederholen, sodass 4 Pastillas entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 375°F 25-30 Minuten backen, bis der Filoteig goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit Puderzucker bestäuben und warm servieren.",
