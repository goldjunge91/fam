      "steps": [
        {
          "position": 0,
          "text": "Weiche Bambusspieße 15 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Hähnchenbrust in mundgerechte Würfel und stecke sie auf die Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Erdnussbutter, Kokosmilch, Limettensaft, Sojasauce, gehackten Knoblauch, Ingwer, braunen Zucker und Currypaste in einer Schüssel zu einer glatten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Hälfte der Sauce zum Servieren beiseite und bestreiche die Spieße mit der restlichen Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Spieße bei mittlerer bis hoher Hitze 8-10 Minuten und wende sie gelegentlich, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie heiß mit der beiseitegestellten Erdnusssauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
