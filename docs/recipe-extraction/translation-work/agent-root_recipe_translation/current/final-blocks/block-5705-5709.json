      "steps": [
        {
          "position": 0,
          "text": "Vermische Joghurt, Limettensaft, gehackten Knoblauch, Ingwer, Garam Masala, Paprikapulver, Cayennepfeffer und Kurkuma in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ritze die Hähnchenoberkeulen flach ein und überziehe sie gründlich mit der Marinade. Decke sie ab und stelle sie mindestens 2 Stunden oder über Nacht in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 450°F vor und lege ein Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das marinierte Hähnchen auf das Backblech und backe es 25-30 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Zwiebel in Scheiben und grille oder röste sie nach Wunsch kurz für die Beilage an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere das Hähnchen heiß mit Limettenspalten und geschnittener Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
