      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in dünne, mundgerechte Stücke und würze sie leicht mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tablespoons Öl in einer großen Pfanne oder einem Wok bei hoher Hitze und brate das Hähnchen etwa 5-6 Minuten goldbraun und gar. Gib es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl in die Pfanne und füge gehackten Knoblauch und Ingwer hinzu. Rühre 30 Sekunden um, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sellerie, Karotten, Kohl und grüne Bohnen dazu. Brate alles unter Rühren 4-5 Minuten, bis das Gemüse gar, aber noch bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in die Pfanne und füge Sojasauce und Hühnerbrühe hinzu. Bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Speisestärke mit 2 tablespoons kaltem Wasser zu einer glatten Mischung. Rühre sie in die Pfanne und lass alles 2 Minuten köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und würze bei Bedarf mit Sojasauce oder Salz nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht auf gedämpftem Reis und garniere es für zusätzlichen Biss mit knusprigen Chow-Mein-Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
