      "steps": [
        {
          "position": 0,
          "text": "Verrühre Joghurt, Zitronensaft, gehackten Knoblauch, Paprikapulver, Kreuzkümmel und schwarzen Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Hähnchenbrust in dünne Streifen und wende sie in der Marinade. Stelle sie mindestens 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate die Hähnchenstreifen 8-10 Minuten goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme das Pitabrot in einer trockenen Pfanne oder über einer Flamme pro Seite 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle Tomaten und Gurken und gib sie in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche das warme Pitabrot mit Tahini, fülle es mit Hähnchen, Gemüse und zusätzlicher Sauce, rolle es fest auf und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
