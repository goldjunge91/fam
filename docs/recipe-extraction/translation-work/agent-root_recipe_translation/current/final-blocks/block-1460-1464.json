    {
      "externalId": "waivy:mfr-ind-pav-bhaji",
      "slug": "mfr-ind-pav-bhaji",
      "title": "Pav-Bhaji-Bowl (Mumbai-Streetfood-Gemüsebrei)",
      "instructions": "Mumbais berühmtestes Streetfood: Ein dicker, buttriger Brei aus Kartoffeln, gemischtem Gemüse, Tomaten und Pav-Bhaji-Gewürz, auf der Tawa gebraten, bis sich am Boden eine Kruste bildet. Serviert auf Reis mit Butter, gewürfelter Zwiebel und Zitrone. Kräftig, wärmend und unwiderstehlich.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 25,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Dieses Gericht verwertet jedes Gemüse im Kühlschrank – ideal zum Aufbrauchen der Wochenvorräte.",
        "Butter ist traditionell und authentisch – ersetze sie hier nicht durch Öl.",
        "Das Geheimnis sind die Schichten und das Andrücken des Breis – die Kruste ist das Beste daran."
      ],
      "substitutions": [
        {
          "forIngredientId": "butter",
          "swap": "Vegane Butter oder Ghee"
        },
        {
          "forIngredientId": "frozen-peas",
          "swap": "Beliebiges Tiefkühlgemüse, zum Beispiel Mais, Karotten oder Gemüsemischung"
        }
      ],
