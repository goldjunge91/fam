      "steps": [
        {
          "position": 0,
          "text": "Koche und zerdrücke die Kartoffeln. Dämpfe Erbsen und Paprika oder gare sie in der Mikrowelle, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare das Gemüse mit Butter, Knoblauch, Ingwer und Gewürzen in einer breiten Pfanne, bis alles sehr weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tomaten dazu und koche sie 10 Minuten ein. Füge das übrige Gemüse hinzu und zerdrücke alles grob miteinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke den Brei auf die heiße Pfannenfläche, damit sich eine Kruste bildet. Wende portionsweise, damit weitere Stellen karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere den Brei auf Reis und gib rohe gewürfelte Zwiebel, Koriander und Zitronensaft darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
