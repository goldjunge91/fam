      "steps": [
        {
          "position": 0,
          "text": "Für die Marinade: Verrühre Joghurt, Zitrone, Knoblauch, Ingwer und alle Gewürze. Schneide das Hähnchen tief ein und bedecke es vollständig mit der Marinade. Lass es mindestens 30 Minuten, am besten über Nacht, marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche den Reis mit einer Prise Kreuzkümmel im Wasser als Jeera-Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grille oder überbacke das Hähnchen bei hoher Hitze 8–10 Minuten pro Seite, bis es angekohlt und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide das Hähnchen auf und lege es fächerförmig auf den Reis. Gib rohe, mit Zitronensaft vermischte Zwiebel darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere das Gericht mit grüner Chutney aus püriertem Koriander, Limette und Chili.",
