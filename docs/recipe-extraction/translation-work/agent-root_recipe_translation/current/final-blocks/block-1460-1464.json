      "steps": [
        {
          "position": 0,
          "text": "Spüle die roten Linsen ab. Gib sie mit Brühe, Zwiebel, Knoblauch, Ingwer, Tomaten und allen Gewürzen in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lass die Suppe 20 Minuten köcheln, bis die Linsen vollständig zerfallen sind. Pürieren ist nicht nötig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für das Tadka: Erhitze Öl, bis es schimmert. Gib Kreuzkümmelsamen dazu und lass sie aufspringen. Gieße das Tadka über die Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verfeinere die Suppe mit Zitronensaft, Koriander und Garam Masala.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere sie mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
