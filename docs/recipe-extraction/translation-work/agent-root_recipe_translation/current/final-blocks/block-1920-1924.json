      "steps": [
        {
          "position": 0,
          "text": "Schlage die kalte Sahne in einer großen Schüssel mit dem Handmixer steif. Hebe vorsichtig die gezuckerte Kondensmilch und den Vanilleextrakt unter, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe das Müsli unter und rühre, bis es gleichmäßig in der Masse verteilt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Masse in einen gefriergeeigneten Behälter, zum Beispiel eine Kastenform. Lege Frischhaltefolie direkt auf die Eiscreme, damit sie keinen Gefrierbrand bekommt. Decke den Behälter ab und friere die Masse mindestens 6 Stunden oder bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die gefrorene Eiscreme vor dem Portionieren und Servieren einige Minuten bei Raumtemperatur stehen, damit sie leicht weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
