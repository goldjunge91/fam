      "steps": [
        {
          "position": 0,
          "text": "ZUBEREITUNG:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "– SOẞE",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib in einer Schüssel 2 Cups Wasser, 2 Esslöffel Sojasoße, 2 Esslöffel weißen Essig, Sherry zum Kochen, 1/4 Teelöffel weißen Pfeffer, gehackten Ingwer, gehackten Knoblauch, scharfe Paprika, Ketchup, Hoisin-Soße und Zucker zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gut vermischen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "– HÄHNCHEN MARINIEREN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Hähnchen in eine Schüssel und füge 1 Prise Salz, 1 Prise weißen Pfeffer, 2 Eiweiße und 3 Esslöffel Maisstärke hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "– HÄHNCHEN FRIEREN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frittiere das Hähnchen bei 350 Grad für 3-4 Minuten oder bis es goldbraun ist. Lockere die Stücke dabei, damit sie nicht zusammenkleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Stelle das Hähnchen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "– IM WOK BRATEN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib die Soße in den Wok, füge den Brokkoli hinzu und warte, bis alles kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Zum Andicken der Soße 2 Esslöffel Maisstärke und 4 Esslöffel Wasser in einer Schüssel verrühren und langsam zum Wokgericht geben, bis die Soße die gewünschte Dicke hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Gib anschließend das Hähnchen dazu, brate alles eine Minute unter Rühren und serviere es auf einem Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
