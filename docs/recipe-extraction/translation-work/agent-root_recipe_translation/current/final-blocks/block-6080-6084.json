      "steps": [
        {
          "position": 0,
          "text": "Weiche die getrockneten Garnelen 5-10 Minuten in warmem Wasser ein, bis sie weich sind. Gieße sie anschließend gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
