        {
          "position": 2,
          "text": "Gib Knoblauch und getrocknete Garnelen hinein und brate sie unter Rühren 30 Sekunden an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Lauchringe dazu und brate sie 3-4 Minuten unter häufigem Rühren, damit sie nicht anbrennen.",
