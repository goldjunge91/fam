      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Schweinebauchwürfel 5 Minuten in kochendem Wasser. Gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf oder Schmortopf bei mittlerer bis hoher Hitze und brate den blanchierten Schweinebauch kurz an, bis er leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwerscheiben dazu und rühre 30 Sekunden um, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Sojasauce und Wasser dazu und gib dann Sternanis und eine Zimtstange hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze auf niedrige Stufe, decke den Topf ab und lass alles 45 Minuten köcheln, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Taro und Kandiszucker dazu, rühre gut um und lass alles weitere 20-25 Minuten köcheln, bis der Taro weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und gib bei Bedarf zusätzliche Sojasauce dazu. Serviere das Gericht heiß mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
