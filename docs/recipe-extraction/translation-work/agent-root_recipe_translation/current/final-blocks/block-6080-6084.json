          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Filets aus der Pfanne und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate die geschnittenen Zwiebeln im selben Öl etwa 3 Minuten weich und goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
