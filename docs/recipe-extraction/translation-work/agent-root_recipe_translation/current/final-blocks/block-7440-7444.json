    {
      "externalId": "waivy:bake-linzer-cookies",
      "slug": "bake-linzer-cookies",
      "title": "Linzer Cookies (deutsche Fassung)",
      "instructions": "Buttery almond shortbread sandwich cookies scented mit Zimt und Zitronenschale, filled mit raspberry Marmelade und finished mit ein snowfall von powdered Zucker around ein peekaboo window. ein klassisch Austrian holiday cookie that tastes like ein tiny Linzer torte.",
      "prepTimeMinutes": 35,
      "cookTimeMinutes": 12,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "kaufen whole raw Mandeln und grind them in ein blender mit ein spoonful von der Rezept's Mehl zu machen dein own almond Mehl für ein fraction von der bagged price.",
        "machen ein double batch von Teig und freeze der extra disks für up zu 3 months; Scheibe-und-backen holiday cookies anytime.",
        "Re-ausrollen every scrap von Teig in natur rounds und backen them as garen's-treat shortbread so nothing goes zu waste."
      ],
      "substitutions": [
        {
          "forIngredientId": "almond-flour",
          "swap": "Grind 1 cup whole Mandeln (oder verwenden walnut/hazelnut Mehl) zu ein fine meal",
          "savings": "~$2 gegenüber abgepacktem Mandelmehl"
        },
        {
          "forIngredientId": "jam",
          "swap": "Any seedless preserves du have auf hand (apricot oder blackcurrant are traditional too)",
          "savings": "~$1 mit vorhandener Marmelade"
        },
        {
          "forIngredientId": "lemon-zest",
          "swap": "1/4 tsp almond extract für ein deeper marzipan note",
          "savings": "den Kauf einer frischen Zitrone sparen"
        }
      ],
