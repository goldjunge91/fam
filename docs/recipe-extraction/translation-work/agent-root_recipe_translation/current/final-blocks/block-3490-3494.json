      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Kichererbsen über Nacht oder mindestens 8 Stunden einweichen und dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kichererbsen mit Wasser und Kurkuma etwa 30 Minuten kochen, bis sie ganz weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ghee in einem separaten Topf erhitzen und Kreuzkümmelsamen darin anrösten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Ingwer und grüne Chilis hinzufügen und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Zwiebel hinzufügen und etwa 3 Minuten glasig dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geriebene Kokosnuss einrühren und 2 Minuten anbraten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Kichererbsen samt Kochflüssigkeit zur Gewürzmischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "8-10 Minuten köcheln lassen und dabei einige Kichererbsen zerdrücken, damit das Dal leicht eindickt; heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
