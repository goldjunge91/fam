      "steps": [
        {
          "position": 0,
          "text": "Flaschenkürbis schälen und in 0.25-inch dicke runde Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kichererbsenmehl, Reismehl, Kurkuma und Salz in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackte grüne Chili und Zwiebel zur Mehlmischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nach und nach Wasser einrühren, bis ein dicker, klümpchenfreier Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen, bis ein kleiner Teigtropfen sofort zischt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Kürbisscheibe in den Teig tauchen und von beiden Seiten vollständig überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Portionsweise je 4-5 Scheiben frittieren, bis sie von beiden Seiten goldbraun sind, etwa 3-4 Minuten pro Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einer Schaumkelle herausnehmen, auf Küchenpapier abtropfen lassen und heiß mit Chutney servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
