      "steps": [
        {
          "position": 0,
          "text": "Mehl mit Wasser und Salz zu einem weichen Teig vermengen, 5 Minuten kneten und abgedeckt 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer Pfanne erhitzen und Zwiebeln, Knoblauch sowie Ingwer anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhack hinzufügen und bräunen, dann Sojasauce, Salz, Pfeffer und Koriander einrühren und 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 12 gleiche Stücke teilen und jedes zu einem dünnen Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1 Esslöffel Füllung in die Mitte jedes Kreises geben, zu einer Tasche falten und oben zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wasser in einem Topf zum Kochen bringen und Momos in einem Bambusdämpfer oder Siebeinsatz 10 Minuten dämpfen, bis sie gar sind und an die Oberfläche steigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Sojasauce oder Chili-Öl-Dip servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
