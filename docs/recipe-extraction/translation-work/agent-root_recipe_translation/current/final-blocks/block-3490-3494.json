      "steps": [
        {
          "position": 0,
          "text": "Reis 20 Minuten einweichen und dann mit möglichst wenig Wasser zu einer glatten, feinen Paste mahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ghee in einem Topf mit schwerem Boden erhitzen und die Reispaste unter ständigem Rühren 5-7 Minuten anbraten, bis sie leicht goldbraun und aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Milch separat erhitzen und unter Rühren langsam zur Reispaste geben, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bei mittlerer Hitze unter häufigem Rühren etwa 15 Minuten kochen, bis die Mischung eindickt und cremig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerstoßenes Kardamompulver und Mandelpulver hinzufügen und gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zucker hinzufügen und unter Rühren weitere 2-3 Minuten kochen, bis er sich vollständig aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die warme Phirni in Tonschalen oder Dessertbecher füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Pistazien, den übrigen Mandeln und Rosenwasser garnieren und vor dem gekühlten Servieren mindestens 2 Stunden kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
