      "steps": [
        {
          "position": 0,
          "text": "Nehmen Sie das Steak 15 Minuten vor dem Garen aus dem Kühlschrank und tupfen Sie es trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Steak auf beiden Seiten großzügig mit Salz, Pfeffer und Knoblauchpulver würzen.",
