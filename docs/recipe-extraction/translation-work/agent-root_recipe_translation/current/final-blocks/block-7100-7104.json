          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Steak 4-5 Minuten pro Seite anbraten, wenn es mittel-selten ist (Innentemperatur 135 °F); 5 Minuten ruhen lassen und dann gegen die Faser aufschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gefrorene Pommes Frites goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitzen Sie die Rindersoße in einem Topf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Pommes auf einen Teller schichten und mit geschnittenem Steak, Käsebruch und heißer Soße belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
