      "steps": [
        {
          "position": 0,
          "text": "Spaghetti nach Packungsanweisung kochen; abtropfen lassen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl auf 350 °F erhitzen und gefrorene Pommes frittieren, bis sie knusprig sind; Auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch in einer großen Pfanne bei mittlerer bis hoher Hitze anbraten und beim Kochen auseinanderbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch zum Rindfleisch geben und 2 Minuten kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Marinara-Sauce einrühren und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Spaghetti mit der Fleischsauce vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Pommes auf einen Teller schichten, mit der Mischung aus Spaghetti und Fleischsoße belegen und dann Käsequark und Parmesan hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange die Pommes noch warm und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
