      "steps": [
        {
          "position": 0,
          "text": "Zum Frittieren von Pommes Frites Öl in einem tiefen Topf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Aus dem Hackfleisch zwei Patties formen, mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Braten Sie die Pastetchen in einer Pfanne bei mittlerer bis hoher Hitze 3–4 Minuten pro Seite, um einen mittleren Gargrad zu erreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belegen Sie jedes Pastetchen mit einer Käsescheibe und lassen Sie es zugedeckt etwa 1 Minute lang schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gefrorene Pommes Frites goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hamburgerbrötchen in einer Pfanne oder einem Toaster leicht rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einem Topf die Rindersoße erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stellen Sie die Burger mit Salat, Tomaten und gekochtem Patty auf gerösteten Brötchen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf einem separaten Teller die Pommes frites schichten, mit Käsebruch und heißer Soße belegen; Zum Burger servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
