      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und fein reiben; In ein sauberes Küchentuch legen und überschüssige Feuchtigkeit über einer Schüssel ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch mit Zwiebelwürfeln in einer Pfanne bei mittlerer bis hoher Hitze anbraten; abgießen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geriebene Kartoffeln mit Mehl, Salz und Pfeffer vermischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Aus der Kartoffelmasse eine kleine Kugel formen, eine Vertiefung hineindrücken, mit einem Löffel der gekochten Fleischmischung füllen und zu einer Kugel mit etwa 2.5 Zoll Durchmesser verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einem tiefen Topf oder Schmortopf auf 325 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffelbällchen vorsichtig in heißes Öl legen und unter gelegentlichem Wenden 6-8 Minuten braten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Schaumlöffel herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren, wahlweise mit Soße oder Sauerrahm zum Dippen.",
