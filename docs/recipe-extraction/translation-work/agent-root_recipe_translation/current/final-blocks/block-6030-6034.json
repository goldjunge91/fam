      "steps": [
        {
          "position": 0,
          "text": "Weiche die Glasnudeln 5 Minuten in warmem Wasser ein. Gieße sie ab und schneide sie in 2-inch-Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tbsp Öl in einem Wok und brate das Schweinehackfleisch etwa 5 Minuten durch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geraspelten Kohl, Karotten und Ingwer dazu und gare alles 3 Minuten, bis es weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die eingeweichten Glasnudeln, Sojasauce und Sesamöl ein. Nimm die Pfanne vom Herd und lass die Füllung etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1 tbsp Füllung auf jedes Teigblatt für Frühlingsrollen. Klappe die Seiten ein, rolle es fest auf und bestreiche den Rand zum Verschließen mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze 3 cups Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Frühlingsrollen portionsweise vorsichtig 3-4 Minuten rundherum goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie heiß mit süß-saurer Sauce oder Chiliöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
