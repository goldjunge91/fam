      ],
      "steps": [
        {
          "position": 0,
          "text": "Bitte den Fischhändler, den Fisch auszunehmen und ihn von Kopf bis Schwanz auf einer Seite längs einzuschneiden. So entsteht eine Tasche, ohne den Fisch ganz durchzuschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die getrockneten Chilis 10 Minuten in warmem Wasser ein. Püriere sie dann mit Knoblauch, Ingwer, Zwiebel und Kreuzkümmel zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 Esslöffel Öl und brate die Gewürzpaste 2-3 Minuten an, bis sie duftet. Lass sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge die gegarte Paste mit Tamarindenpaste, Salz und Essig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Bauchhöhle des Fischs großzügig durch den Einschnitt mit der Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze die übrigen 3 tablespoons Öl in einer flachen Pfanne und lege den gefüllten Fisch vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate ihn bei mittlerer Hitze auf der ersten Seite 8-10 Minuten, ohne ihn zu bewegen. Wende ihn vorsichtig und gare ihn weitere 8-10 Minuten, bis er durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere den Fisch heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
