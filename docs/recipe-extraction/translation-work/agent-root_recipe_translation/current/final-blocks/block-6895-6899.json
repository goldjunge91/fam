      "steps": [
        {
          "position": 0,
          "text": "Popcorn-Körner mit einem Herd-Popper, einem Air-Popper oder einer Mikrowelle zerplatzen lassen, bis die Körner nicht mehr platzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem kleinen Topf bei schwacher Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie geschmolzene Butter über das Popcorn in einer großen Schüssel und rühren Sie es ständig um, damit es gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mischen Sie in einer kleinen Schüssel Cheddar-Käsepulver, Salz, Nährhefe (falls verwendet) und Cayennepfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Streuen Sie die Käsemischung über das gebutterte Popcorn und rühren Sie dabei ständig um, um die Gewürze gleichmäßig zu verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2 Minuten abkühlen lassen und in Schüsseln oder Papiertüten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
