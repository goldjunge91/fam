      "steps": [
        {
          "position": 0,
          "text": "Gemüsebrühe zum Kochen bringen. Gehackten Knoblauch und geschnittene Zwiebel dazugeben und 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tamarindenpaste, Fischsauce und Zucker einrühren, dann Ananasstücke und Tomaten dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischfilets vorsichtig in die Brühe legen und 5 Minuten köcheln lassen, bis der Fisch fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Okrascheiben und gehackte Chilis dazugeben und weitere 3–4 Minuten köcheln lassen, bis die Okra weich und der Fisch vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abschmecken und nach Wunsch mit Fischsauce oder Tamarinde nachwürzen. Mit Koriander garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
