      "steps": [
        {
          "position": 0,
          "text": "Tapiokastärke, Weizenstärke und Salz in einer Schüssel vermischen. Langsam kochendes Wasser unter Rühren dazugeben, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig mit eingeölten Händen 2 Minuten kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelten Schweinebauch in einer Pfanne etwa 4 Minuten knusprig braten und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ein Stück Teig nehmen und zu einer dünnen Scheibe flach drücken. 1 Garnele und eine Prise Schweinefleisch mittig darauflegen, dann halbmondförmig zusammenklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jedes Bánh Bột Lọc auf ein Stück Bananenblatt legen und in einem Bambusdämpfer 5 Minuten dämpfen, bis der Teig durchscheinend wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fischsauce mit Limettensaft als Dip vermengen und heiß mit der Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
