      "steps": [
        {
          "position": 0,
          "text": "Krabbenfleisch, gehackte Garnelen, gekochte Reisnudeln, gehackten Knoblauch, Fischsauce, Zucker und schwarzen Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ei in einer kleinen Schüssel verquirlen und zur Füllung geben. Gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Füllung auf das untere Drittel jedes Frühlingsrollenblatts geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seiten einklappen und fest zu einem Zylinder aufrollen. Rand mit einem angefeuchteten Finger verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einem schweren Topf auf 350°F erhitzen und Rollen portionsweise auf jeder Seite 2–3 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Dip-Sauce aus Fischsauce, Limettensaft, Zucker, Wasser und gehacktem Knoblauch servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
