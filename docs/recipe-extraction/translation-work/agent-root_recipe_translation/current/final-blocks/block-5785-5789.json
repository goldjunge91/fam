      "steps": [
        {
          "position": 0,
          "text": "Rote Chilischoten, Knoblauch, Zitronensaft, Olivenöl, Paprikapulver, Salz und schwarzen Pfeffer glatt pürieren, um die Piri-Piri-Marinade zuzubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchenschenkel in eine große Schüssel legen und gründlich mit der Marinade bedecken. 2 Esslöffel zum Bestreichen zurückbehalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hähnchen mindestens 30 Minuten bei Zimmertemperatur oder bis zu 8 Stunden im Kühlschrank marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Backofen auf 425°F vorheizen und das Hähnchen mit der Hautseite nach oben auf ein Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Hähnchen 30-35 Minuten braten, bis die Haut goldbraun ist und die Kerntemperatur 165°F erreicht. Nach der Hälfte der Zeit mit der zurückbehaltenen Marinade bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
