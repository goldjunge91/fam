      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Öl in einem großen Topf. Gib die Zwiebel hinzu und gare sie, bis sie glasig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die eingeweichten Kichererbsen ab und gib sie zusammen mit der Gemüsebrühe in den Topf. Bringe alles zum Kochen, reduziere die Hitze und decke den Topf ab. Lasse die Suppe 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste währenddessen den Kreuzkümmel in einer kleinen Pfanne ohne Öl und mahle ihn anschließend in einem Mörser. Gib Knoblauch und Salz hinzu und zerstoße alles zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Paste und Harissa in die Suppe und lasse sie etwa 30 Minuten köcheln, bis die Kichererbsen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz, Pfeffer und Zitronensaft abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
