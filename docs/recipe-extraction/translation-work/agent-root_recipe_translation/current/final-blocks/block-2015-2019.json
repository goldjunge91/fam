              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Einweichen: Weiche Mais und Bohnen über Nacht in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fleisch garen: Bräune Rind- und Schweinefleisch in einem großen Topf. Gib Zwiebeln und Gewürze hinzu und gare sie, bis sie glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eintopf köcheln lassen: Gib den eingeweichten Mais und die Bohnen, Kürbis, Kartoffel sowie so viel Wasser hinzu, dass alles bedeckt ist. Lasse den Eintopf 2-3 hours köcheln, bis er dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Servieren: Heiß mit Brot als Beilage genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Profi-Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste den Mais leicht an, bevor du ihn zum Eintopf gibst, um sein Aroma zu verstärken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib einen Löffel Paprika oder etwas Kreuzkümmel hinzu, um eine zusätzliche würzige, warme Note zu erzielen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
