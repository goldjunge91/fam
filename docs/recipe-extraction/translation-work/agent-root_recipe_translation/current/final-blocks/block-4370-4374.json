      "steps": [
        {
          "position": 0,
          "text": "Haut und Gräten vom Lachs entfernen und ihn fein hacken oder in der Küchenmaschine pulsieren, bis die Masse grobem Schrot ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lachs, Panko, Ei, Senf, Zitronensaft, Dill, Salz und Pfeffer in einer Schüssel gerade eben vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mischung zu 4 Bratlingen von etwa 3/4 Zoll Dicke formen und 10 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und Bratlinge pro Seite 3–4 Minuten goldbraun und gar braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brötchen in derselben Pfanne oder im Toaster leicht rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Burger nach Wunsch mit Belägen wie Salat, Tomate und Aioli zusammensetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
