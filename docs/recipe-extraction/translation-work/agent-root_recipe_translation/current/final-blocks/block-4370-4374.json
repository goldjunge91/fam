      "steps": [
        {
          "position": 0,
          "text": "Blätterteig nach Packungsanweisung auftauen und den Ofen auf 400 °F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pilze mit einem feuchten Tuch säubern und in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze schmelzen und Schalotten sowie Knoblauch 1 Minute anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pilze und Thymian hinzufügen und 5–7 Minuten garen, bis Flüssigkeit austritt und verdampft. Dann Sahne und Käse einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und Pfeffer würzen und 2 Minuten köcheln lassen, bis die Mischung leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Blätterteig auf ein Backblech legen und die Pilzmischung gleichmäßig darauf verteilen, dabei einen halben Zoll Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15–18 Minuten backen, bis der Teig goldbraun und aufgegangen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "2 Minuten abkühlen lassen, in Portionen schneiden und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
