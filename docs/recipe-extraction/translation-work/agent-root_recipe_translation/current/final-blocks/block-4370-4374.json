      "steps": [
        {
          "position": 0,
          "text": "Hummerschwänze längs halbieren, den Darm entfernen und die Schale intakt lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 Tasse Butter in einem Topf mit schwerem Boden bei niedriger Hitze schmelzen. 2 gehackte Knoblauchzehen, 0.5 gehackte Schalotte und Thymianzweige hinzufügen und 2 Minuten vorsichtig rühren, ohne sie zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "0.25 Tasse Weißwein zugießen und sanft köcheln lassen, dann Hitze auf die niedrigste Stufe reduzieren, sodass 160–170 °F gehalten werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hummerschwänze mit der Fleischseite nach unten in das Butterbad legen und 1 TL Salz sowie 0.25 TL Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "12–15 Minuten sanft pochieren, bis das Fleisch undurchsichtig ist und 140 °F erreicht. Gelegentlich mit Butter übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hummer mit einer Schaumkelle aus der Butter nehmen und mit der Schale nach oben auf Serviertellern anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Butter durch ein Seihtuch in eine Servierschüssel abseihen, mit Fleur de Sel würzen und zusammen mit frischen Zitronenspalten zum Hummer reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
