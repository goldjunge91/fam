      "steps": [
        {
          "position": 0,
          "text": "Elchsteaks 20 Minuten vor dem Garen aus dem Kühlschrank nehmen und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Beide Seiten großzügig mit 0.75 TL Salz und 0.5 TL schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 EL Olivenöl in einer gusseisernen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Elchsteaks pro Seite 3 Minuten medium-rare braten und dann auf einen warmen Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze auf mittlere Stufe reduzieren, 3 EL Butter, gehackte Schalotte, 2 gehackte Knoblauchzehen und 3 Thymianzweige hinzufügen und 1 Minute ständig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "0.25 Tasse Rotwein und 0.25 Tasse Rinderbrühe zugießen, Bratrückstände lösen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Steaks 30 Sekunden zurück in die Pfanne geben und mit Sauce überziehen, dann anrichten und mit der Pfannensauce beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
