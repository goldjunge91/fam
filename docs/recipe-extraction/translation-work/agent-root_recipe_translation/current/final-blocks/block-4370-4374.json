      "steps": [
        {
          "position": 0,
          "text": "Ein Backblech mit Backpapier auslegen und in die Nähe des Herdes stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "0.75 Tasse Butter, 1 Tasse Zucker und 1 EL Wasser in einem Topf mit schwerem Boden bei mittlerer Hitze verrühren, bis sich der Zucker auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nicht mehr rühren. Zuckerthermometer am Topf befestigen und unter gelegentlichem Schwenken auf 300 °F (Hartbruchstufe) erhitzen, etwa 8–10 Minuten.",
