      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Bajra-Mehl und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach warmes Wasser hinzu und knete einen weichen Teig. Verwende bei Bedarf mehr Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 6-8 gleich große Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine gusseiserne Platte oder Tawa bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege eine Teigkugel zwischen zwei Stücke Frischhaltefolie und drücke sie mit der Handfläche zu einem dünnen Kreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Roti auf die heiße Platte und backe sie 1-2 Minuten, bis hellbraune Flecken entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende sie und backe die andere Seite 1-2 Minuten. Drücke sie vorsichtig mit einem Tuch an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche beide Seiten mit Ghee, falte die Roti und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
