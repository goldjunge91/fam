      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl, Weizenmehl, Zwiebel, grüne Chili, Koriander, Salz und Ajowan in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser hinzu und knete einen weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile ihn in 6-8 gleich große Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine Tawa oder Grillplatte bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drücke jede Kugel zwischen Frischhaltefolie zu einem dünnen Kreis und lege ihn auf die heiße Platte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe ihn 1-2 Minuten, bis hellbraune Flecken entstehen. Wende ihn und backe die andere Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche beide Seiten mit Öl und serviere die Roti heiß mit Pickles oder Joghurt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
