      "steps": [
        {
          "position": 0,
          "text": "Weiche Mung-Dal 30 Minuten in Wasser ein und gieße ihn vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle den eingeweichten Dal zu einer dicken Paste. Sie sollte nicht zu glatt sein und noch etwas Struktur haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib zerstoßene schwarze Pfefferkörner, Kreuzkümmelsamen, grüne Chili, Ingwer und Salz zur Paste und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Mischung in einen Spritzbeutel mit kleiner runder Tülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Spritze kleine, etwa murmelgroße Kugeln direkt ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere sie 3-4 Minuten goldbraun und knusprig. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse die Mangodi vollständig abkühlen; dabei werden sie knusprig. Bewahre sie bis zu 2 Wochen in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Verwende sie in Currys oder serviere sie als Snack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
