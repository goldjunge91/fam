      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Ker-Beeren und Sangri-Schoten 30 Minuten in warmem Wasser ein und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne, gib Kreuzkümmelsamen hinein und röste sie, bis sie aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Zwiebeln dazu und brate sie etwa 4 Minuten hellgolden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge eingeweichte Ker-Beeren und Sangri hinzu, rühre gut um und gare sie 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte Tomaten, Kurkuma und Chilipulver dazu und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare das Gemüse bei mittlerer Hitze 10-12 Minuten unter gelegentlichem Rühren, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge Amchur-Pulver und Salz hinzu, rühre um und gare alles 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß als Beilage zu Brot oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
