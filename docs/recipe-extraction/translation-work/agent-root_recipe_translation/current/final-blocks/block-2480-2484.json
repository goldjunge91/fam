      "steps": [
        {
          "position": 0,
          "text": "Weiche Reis, Urad Dal und Bockshornkleesamen 4-6 Stunden getrennt in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle den Reis mit möglichst wenig Wasser zu einer glatten, aber dickflüssigen Paste und fülle sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mahle Urad Dal mit Bockshornklee und etwas Wasser vollständig glatt und luftig, etwa 10-15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Reis- und Dal-Paste mit Salz und lasse den Teig 8-12 Stunden bei Raumtemperatur fermentieren, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Wasser in einem Dämpftopf und fette Idli-Förmchen oder Tassen leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den fermentierten Teig vorsichtig in die gefetteten Förmchen und fülle sie etwa zu drei Vierteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Förmchen in den Dämpfeinsatz und dämpfe die Idli 5-7 Minuten, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie 1 Minute abkühlen und löse die Idli vorsichtig durch Klopfen auf einen Teller. Warm mit Sambar und Chutney servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
