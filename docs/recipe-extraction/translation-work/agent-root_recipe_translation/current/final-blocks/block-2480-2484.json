      "steps": [
        {
          "position": 0,
          "text": "Weiche Rajma-Bohnen über Nacht in Wasser ein. Gieße sie ab und koche sie 45 Minuten in frischem Wasser, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasche währenddessen den Reis gründlich und koche ihn in 4 Tassen kochendem Salzwasser etwa 18 Minuten, bis er locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und gib Kreuzkümmelsamen hinzu. Lasse sie 10 Sekunden aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zwiebeln hinzu und gare sie etwa 4 Minuten weich. Füge dann Ingwer-Knoblauch-Paste hinzu und brate sie 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelte Tomaten dazu und gare sie 3 Minuten, bis sie zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Füge gegarte Rajma-Bohnen, Kurkuma, Garam Masala und Chilipulver hinzu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Rajma-Curry 10 Minuten köcheln, damit sich die Aromen verbinden. Dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Curry und passe Salz und Gewürze an. Serviere das Rajma auf gedämpftem Reis mit geschnittenen Zwiebeln und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
