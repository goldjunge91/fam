      "steps": [
        {
          "position": 0,
          "text": "Salzfisch 2–4 Stunden in Wasser einweichen, nach der Hälfte der Zeit das Wasser wechseln, dann abtropfen lassen und in kleine Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln in Salzwasser 15 Minuten kochen, bis sie weich sind, dann abgießen und zerstampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffelpüree mit Salzfischflocken, gehacktem Knoblauch, gewürfelten Zwiebeln und gehacktem Koriander vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer separaten Schüssel Mehl und Backpulver vermischen und dann zur Fischmischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier verquirlen und unter Rühren zur Mischung geben, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pflanzenöl in einer tiefen Pfanne auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Geben Sie einen Löffel Teig in das heiße Öl und braten Sie ihn 3–4 Minuten pro Seite, bis er goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Limettenspalten oder scharfer Soße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
