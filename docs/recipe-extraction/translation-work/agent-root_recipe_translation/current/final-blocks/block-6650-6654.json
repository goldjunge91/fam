      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie die Krabben gründlich, indem Sie sie unter fließendem kaltem Wasser schrubben und die Oberschale vorsichtig entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nehmen Sie das braune Fleisch aus der Schale und legen Sie es beiseite. Behalten Sie dabei die Schalenhälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entfernen Sie die Beine und Krallen vom Krabbenkörper und legen Sie sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einem großen Topf erhitzen und gehackten Knoblauch und gewürfelte Zwiebeln etwa 3 Minuten lang goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fügen Sie die Krabbenkörperteile und -beine hinzu, rühren Sie um, bis sie mit dem Öl bedeckt sind, und kochen Sie sie dann 5 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gießen Sie Kokosmilch und Wasser hinzu und fügen Sie dann das zurückbehaltene braune Fleisch, den ganzen Scotch Bonnet Pepper und den Koriander hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 25–30 Minuten köcheln lassen, bis die Krabben vollständig gekocht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entfernen Sie den Scotch Bonnet Pepper und würzen Sie ihn mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nach Belieben die Krabben in die Muscheln geben, die Soße darübergießen und mit Limettenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
