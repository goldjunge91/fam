      "steps": [
        {
          "position": 0,
          "text": "Schäle die Orangen mit einem scharfen Messer und entferne dabei die gesamte weiße Haut. Schneide sie möglichst dünn und richte sie auf einem Teller an. Streue Demerara-Zucker darüber, gib Grand Marnier dazu und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerbrösele den Weihnachtspudding in große Stücke und verteile sie auf dem Boden einer Trifle-Schüssel. Lege die Orangen darauf und gieße den Saft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Mascarpone glatt und rühre Vanillecreme ein. Verteile die Masse über den Orangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage die Sahne leicht auf und gib sie über die Creme. Streue gehobelte Mandeln und geriebene Schokolade darüber. Nach Wunsch einen Tag vorher zubereiten und bis zum Servieren kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
