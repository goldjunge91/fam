      "steps": [
        {
          "position": 0,
          "text": "Erhitze Butter, Milch und Salz in einem kleinen Topf, bis die Butter schmilzt. Lass die Mischung abkühlen, bis sie lauwarm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mehle, Hefe, Kardamom und Zucker in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mache eine Mulde, schlage die Eier hinein, gieße die lauwarme Milchmischung dazu und verrühre alles zu einem klebrigen Teig. Wenn der Teig fester wird, knete ihn mit den Händen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öle die Arbeitsfläche mit einem Teelöffel Olivenöl ein. Knete den Teig darauf kräftig 5–8 Minuten und löse ihn bei Bedarf mit einem Teigschaber. Gib kein zusätzliches Mehl hinzu, sonst werden die Schnecken trocken und fest. Knete weiter, bis der Teig glatter, elastischer und weniger klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme eine Kugel und lege sie in eine große gefettete Schüssel. Decke sie mit einem sauberen Geschirrtuch ab und lass den Teig an einem warmen Ort eine Stunde gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für Füllung und Topping die weiche Butter in einer Schüssel mit der Hälfte des Zuckers und 1 Esslöffel Zimt verrühren, bis alles gut vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge den restlichen Zucker und Zimt in einer separaten Schüssel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rolle den aufgegangenen Teig auf einer bemehlten Arbeitsfläche vorsichtig zu einem Rechteck von 36x24cm/14x9½in aus. Verteile die Zimt-Zucker-Butter gleichmäßig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rolle den Teig von der langen Seite her zu einer Rolle auf und schneide ihn in 12 gleich große Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Lege die Scheiben in flache Papierförmchen auf ein Backblech oder in eine gefettete Muffinform. In der Muffinform werden die Zimtschnecken höher und kuppelförmig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Decke sie mit einem sauberen Geschirrtuch ab und lass sie weitere 30–45 Minuten gehen, bis sie aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Heize den Ofen auf 200C/180C Fan/Gas 6 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Bestreiche die Oberseiten mit verquirltem Ei und bestäube sie großzügig mit Zimtzucker. Backe die Schnecken 12 Minuten, bis sie dunkelgoldbraun sind. Warm mit Kaffee genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
