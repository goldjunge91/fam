      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer Fritteuse oder einer tiefen, schweren Pfanne auf 365°F (185°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme die Bratensoße in einem Topf oder in der Mikrowelle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Pommes ins heiße Öl und frittiere sie etwa 5 Minuten, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm sie heraus und lasse sie auf einem mit Küchenpapier ausgelegten Teller abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte die Pommes auf einer Servierplatte an und streue den Käse darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Bratensoße über Pommes und Käse und serviere alles sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
