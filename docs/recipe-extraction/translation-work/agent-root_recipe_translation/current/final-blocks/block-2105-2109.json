      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350 Grad F (175 Grad C) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Wasser, Zwiebel, Olivenöl, Balsamicoessig, Dijon-Senf, Knoblauch, schwarzen Pfeffer, Cayennepfeffer und Salz in einem Bräter. Gib das Hähnchen dazu und wende es, bis es rundum mit der Mischung bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe es im vorgeheizten Ofen, bis ein sofort ablesbares Thermometer an der dicksten Stelle des Schenkels nahe dem Knochen 165 Grad F (74 Grad C) anzeigt, etwa 1 Stunde 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
