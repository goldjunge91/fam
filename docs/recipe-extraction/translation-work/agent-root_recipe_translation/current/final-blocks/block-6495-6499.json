      "steps": [
        {
          "position": 0,
          "text": "Löse Hefe in warmem Wasser mit Zucker auf und lass sie 5 Minuten stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mehl und Salz in einer großen Schüssel. Gib die Hefemischung und geschmolzene Butter dazu und knete den Teig 10 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig ab und lass ihn 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 gleich große Stücke, rolle jedes zu einem Strang und forme daraus eine Brezel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Brezeln auf Backpapier und lass sie 30 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe 4 cups Wasser zum Kochen, löse Natron darin auf (als Ersatz für ein Laugenbad) und tauche jede Brezel 15 Sekunden hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Brezeln auf ein Backblech, bestreiche sie mit Eistreiche und bestreue sie mit grobem Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe sie bei 425°F 15-18 Minuten, bis sie tief goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
