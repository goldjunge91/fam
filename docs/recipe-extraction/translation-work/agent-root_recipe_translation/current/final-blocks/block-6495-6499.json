      "steps": [
        {
          "position": 0,
          "text": "Kühle das gesamte Fleisch und die Teile des Fleischwolfs 30 Minuten im Tiefkühlfach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drehe Schweineschulter, Fett und Leber mit einer feinen Scheibe in eine kalte Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge Salz, Pfeffer, Majoran, Knoblauch und Eiswasser, bis die Masse klebrig und gut verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weiche die Naturdärme 10 Minuten in warmem Wasser ein, damit sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Därme mithilfe eines Wurstfüllers mit der Fleischmischung und forme etwa 4 inches lange Würste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Brühe sanft köcheln und gib die Würste vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche sie 20-25 Minuten, bis sie aufsteigen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Würste heraus und serviere sie heiß mit Senf und Brot oder brate sie in der Pfanne goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
