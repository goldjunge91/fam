      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln 15-18 Minuten in Salzwasser, bis sie gerade weich sind. Gieße sie ab und lass sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle die warmen Kartoffeln und schneide sie in 1/4 inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge Rinderbrühe, Essig und Zucker in einem Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Kartoffelscheiben in eine große Schüssel, gieße die warme Brühe darüber und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Öl, Senf, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Senf-Vinaigrette über die Kartoffeln und hebe sie vorsichtig unter, bis alles überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gewürfelte Zwiebel, Schnittlauch und Petersilie dazu und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Salat vor dem Servieren 10 Minuten ruhen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
