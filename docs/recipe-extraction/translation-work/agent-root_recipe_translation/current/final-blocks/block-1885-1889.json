      "steps": [
        {
          "position": 0,
          "text": "Teig anrühren: Verquirle Kichererbsenmehl, Wasser, Salz und Pfeffer. Lass den Teig mindestens 4 Stunden ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backen: Heize den Ofen auf 220°C (430°F) vor. Gieße Olivenöl in eine runde Backform und erhitze es im Ofen. Gieße den Teig hinein und backe ihn 25–30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Servieren: Schneide die Fainá in Stücke und serviere sie heiß. Nach Wunsch mit schwarzem Pfeffer bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Profi-Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass den Teig mindestens 2 Stunden oder über Nacht im Kühlschrank ruhen, damit das Kichererbsenmehl vollständig Wasser aufnehmen kann und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Für einen knusprigen Rand heize die Backform mit Öl im Ofen vor, bevor du den Teig hineingibst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
