      "steps": [
        {
          "position": 0,
          "text": "Püriere die Hälfte der Erdbeeren im Mixer. Hacke die übrigen Erdbeeren und stelle vier davon zum Garnieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage die Schlagsahne steif und hebe dann Erdbeerpüree und zerbröseltes Baiser unter. Hebe die gehackten Erdbeeren und, falls verwendet, Ingwersirup unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die Mischung gleichmäßig auf vier gekühlte Weingläser. Garniere sie mit den übrigen Erdbeeren und einem Zweig Minze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
