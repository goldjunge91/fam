      "steps": [
        {
          "position": 0,
          "text": "Milch in einem großen Topf bei mittlerer Hitze erwärmen, bis sie zu dampfen beginnt, aber nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl langsam unter ständigem Rühren in die heiße Milch einstreuen, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter, Salz, Zucker und Zimt hinzufügen und weiterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze reduzieren und 15-20 Minuten köcheln lassen; häufig umrühren, damit nichts ansetzt oder anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Der Brei wird deutlich eindicken und sich beim Fertigwerden leicht vom Topfrand lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Schüsseln füllen und heiß servieren, nach Wunsch mit zusätzlicher Butter oder Zimt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
