      "steps": [
        {
          "position": 0,
          "text": "Gurken in Stangen oder Ringe schneiden und Zwiebeln in dünne Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einem Topf Essig, Zucker, Wasser und Salz vermischen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Senfkörner, schwarze Pfefferkörner und frischen Dill in die kochende Salzlake geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gurken und Zwiebelscheiben in saubere Gläser schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gießen Sie die heiße Salzlake über die Gurken, bis sie vollständig eingetaucht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Raumtemperatur abkühlen lassen, dann verschließen und im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Pickles vor dem Servieren mindestens 24 Stunden durchziehen lassen. Sie passen zu Sandwiches oder gepökeltem Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
