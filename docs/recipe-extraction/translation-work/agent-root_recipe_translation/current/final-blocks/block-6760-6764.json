      "steps": [
        {
          "position": 0,
          "text": "Grüne Mangos waschen und in dünne Scheiben oder Streifen schneiden, dabei den Kern entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mangostücke mit Salz in einem sauberen Glas vermischen und 2 Stunden bei Zimmertemperatur ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer kleinen Pfanne Öl erhitzen und Senf- und Bockshornkleesamen hinzufügen, bis sie platzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Ingwer, zerdrückten Knoblauch und Asafetida zur Ölmischung hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rotes Chilipulver und Kurkumapulver einrühren und 1 Minute kochen lassen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Gewürzöl über die gesalzenen Mangoscheiben gießen und gründlich vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In saubere Gläser füllen, fest verschließen und vor dem Servieren 7–10 Tage bei Raumtemperatur ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Im Kühlschrank aufbewahren und das Glas gelegentlich schütteln, um die Öle zu verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
