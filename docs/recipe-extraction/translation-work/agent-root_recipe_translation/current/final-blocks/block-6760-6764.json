      "steps": [
        {
          "position": 0,
          "text": "Wasser in einem mittelgroßen Topf bei mittlerer bis hoher Hitze zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Reisbrei unter ständigem Rühren langsam ins Wasser einrühren, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hitze reduzieren und den Brei 5 Minuten bei niedriger Hitze unter häufigem Rühren köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter, Milch, braunen Zucker, Salz und Zimt einrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 2–3 Minuten köcheln lassen, bis die Masse dick und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Schüsseln füllen und sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
