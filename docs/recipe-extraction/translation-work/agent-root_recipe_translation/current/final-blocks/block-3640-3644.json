          "images": []
        },
        {
          "position": 3,
          "text": "Dünste den Knoblauch in derselben Pfanne mit dem restlichen Öl 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomatenwürfel und Chiliflocken hinzu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe währenddessen einen großen Topf Salzwasser zum Kochen und koche Spaghetti al dente.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe gebratene Aubergine und frisches Basilikum unter die Tomatensauce und erwärme alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische die abgetropfte Pasta mit der Sauce und garniere sie mit Ricotta salata und zusätzlichem Basilikum.",
