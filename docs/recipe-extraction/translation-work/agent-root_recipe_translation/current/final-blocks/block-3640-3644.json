      "steps": [
        {
          "position": 0,
          "text": "Erhitze Wasser und Zucker in einem Topf bei mittlerer Hitze und rühre, bis sich der Zucker vollständig aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Topf vom Herd und rühre Zitronensaft und Zitronenschale ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Sirup auf Raumtemperatur abkühlen und fülle ihn in einen flachen gefriergeeigneten Behälter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Friere ihn 30 Minuten ein und kratze die Eiskristalle mit einer Gabel auf. Wiederhole dies alle 30 Minuten für 4-5 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald die Granita eine halbgefrorene Konsistenz hat, ist sie servierfertig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Brioche-Brötchen leicht mit Butter goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Granita in gekühlte Schalen und serviere sie sofort mit der gerösteten Brioche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tunke Brioche-Stücke in die Granita und genieße sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
