      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einem großen Topf und dünste gewürfelte Zwiebel weich. Bräune dann das Hackfleisch und zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Gib 1 Tasse Brühe hinzu, reduziere die Hitze und lasse alles ohne Deckel 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die übrigen 4 Tassen Brühe in einem anderen Topf, gib Reis hinzu, rühre häufig und gare ihn etwa 18 Minuten, bis die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den gekochten Reis auf einem Backblech, lasse ihn 15 Minuten abkühlen und rühre dann Parmesan ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Befeuchte deine Hände, sobald der Reis kühl genug ist. Nimm eine faustgroße Portion, drücke einen Mozzarellawürfel in die Mitte, forme eine Kugel und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Eier in einer Schüssel und gib Paniermehl in eine andere. Wende jeden Arancino zuerst im Ei und dann im Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze 3 Tassen Öl in einer tiefen Pfanne auf 350°F. Frittiere die Arancini portionsweise vorsichtig 3–4 Minuten goldbraun und wende sie einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit darübergelöffeltem Ragù.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
