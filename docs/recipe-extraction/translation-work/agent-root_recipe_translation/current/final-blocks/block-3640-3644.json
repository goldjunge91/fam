      "steps": [
        {
          "position": 0,
          "text": "Säubere die Sardinen, entferne Köpfe und Innereien und spüle sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Filetiere jede Sardine vorsichtig, indem du sie wie ein Buch aufklappst und die Gräte entfernst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste Semmelbrösel 2 Minuten in einer trockenen Pfanne und vermische sie dann mit Pinienkernen, Rosinen, gehacktem Knoblauch, Petersilie und Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle die Bröselmischung mit 3 Esslöffeln Olivenöl und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib einen Löffel Füllung auf jedes Sardinenfilet und rolle es vom Schwanz zum Kopf fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Sardinenröllchen mit der Naht nach unten in eine geölte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle sie mit dem restlichen Olivenöl und Zitronensaft und würze leicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe sie bei 375°F 15 Minuten, bis die Sardinen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
