      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350 °F vorheizen und den Rhabarber in 1 Zoll große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rhabarber mit Zucker und Vanilleextrakt vermischen und dann in einer 9-Zoll-Auflaufform verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer separaten Schüssel Mehl, Haferflocken, braunen Zucker und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter in kleine Würfel schneiden und in die Mehlmischung einarbeiten, bis sie wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Streuselmischung gleichmäßig auf dem Rhabarber verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "35–40 Minuten backen, bis der Belag goldbraun und der Rhabarber zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
