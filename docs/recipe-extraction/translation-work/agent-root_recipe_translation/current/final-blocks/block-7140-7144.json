      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in dicke Chips schneiden und 30 Minuten in kaltem Wasser einweichen, dann trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Öl auf 325 °F erhitzen und die Kartoffelstäbchen portionsweise 5–7 Minuten frittieren, bis sie weich, aber noch nicht gebräunt sind. Abtropfen lassen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Maisstärke, Backpulver, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kaltes Wasser einrühren, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhöhen Sie die Öltemperatur auf 350 °F, tupfen Sie den Fisch trocken und bestreichen Sie ihn dann mit Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den panierten Fisch 6-8 Minuten lang goldbraun braten, dabei einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhöhen Sie die Öltemperatur auf 375 °F und braten Sie die Chips erneut 2–3 Minuten lang, bis sie knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fish and Chips auf Küchenpapier abtropfen lassen und mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
