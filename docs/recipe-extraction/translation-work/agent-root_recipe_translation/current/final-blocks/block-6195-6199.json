      "steps": [
        {
          "position": 0,
          "text": "Bringe Hühnerbrühe mit Ingwerscheiben zum Kochen. Gib die Hähnchenbrust hinein und lass sie 15 Minuten köcheln, bis sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen heraus und lass es leicht abkühlen. Zerpflücke oder schneide es dann in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche den Jasminreis in derselben Brühe etwa 15-18 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Fischsauce, Sojasauce und Limettensaft zu einem Dip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den Reis auf Schüsseln, gib Hähnchen darauf und beträufle es mit der Sauce. Garniere mit Koriander und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
