      "steps": [
        {
          "position": 0,
          "text": "Verrühre Sojasauce, Fischsauce, Zucker und gehackten Knoblauch zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Schweinefleisch dünn auf und mariniere es mindestens 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Karotten und Daikon in feine Streifen. Lege sie mit Essig und einer Prise Salz in eine Schüssel und lasse sie einlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei starker Hitze und brate das marinierte Schweinefleisch etwa 5 Minuten an, bis die Ränder karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Gurke in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den gekochten Reis auf Schüsseln und bestreiche ihn dünn mit Pastete.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege den Reis mit Schweinefleisch, eingelegtem Gemüse, Gurkenscheiben und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle nach Wunsch mit zusätzlicher Fischsauce oder Limettensaft und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
