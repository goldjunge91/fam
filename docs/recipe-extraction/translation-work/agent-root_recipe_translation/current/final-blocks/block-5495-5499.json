      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einer großen Pfanne oder einem Wok bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Schalotten in Scheiben und gib sie mit gehacktem Knoblauch und geschnittenen Chilischoten in die Pfanne. Brate alles unter Rühren an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Schweinehack hinzu und brate es unter Zerkrümeln etwa 5 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Sojasauce, Fischsauce und Zucker ein und brate alles 1 Minute weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zupfe die Basilikumblätter ab und rühre sie nur so lange unter die Schweinefleischmischung, bis sie zusammenfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den gekochten Reis auf Schüsseln und forme in der Mitte jeder Portion eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate Eier in einer separaten Pfanne als Spiegeleier, sodass das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Pad-Khrapow-Schweinefleisch auf den Reis und setze je ein Spiegelei darauf. Serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
