      "steps": [
        {
          "position": 0,
          "text": "Rühre die Eier in einer separaten Pfanne, bis sie gerade gar sind, und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 Esslöffel Öl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und Ingwer hinzu und brate sie unter Rühren an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchenhack hinzu und brate es unter Zerkrümeln etwa 6 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Sojasauce, Mirin, Zucker und Wasser in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Sauce über das Hähnchen, gib Erbsen hinzu und lasse alles 3-4 Minuten köcheln, bis die Erbsen heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile den gekochten Reis auf Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Hähnchen-Soboro auf eine Seite des Reises und das Rührei auf die andere. Serviere es warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
