      "steps": [
        {
          "position": 0,
          "text": "Von jeder Tomate den Deckel abschneiden, das Innere mit einem Löffel herauslösen, das Fruchtfleisch aufbewahren und die ausgehöhlten Tomaten beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne erhitzen und die gewürfelte Zwiebel sowie den fein gehackten Knoblauch anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Rinderhackfleisch in die Pfanne geben, beim Anbraten zerkrümeln, dann Tomatenmark und Kreuzkümmel einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den ungekochten Reis und das beiseitegelegte Tomatenfruchtfleisch unter ständigem Rühren 2 Minuten vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Tomate großzügig mit der Fleisch-Reis-Mischung füllen und aufrecht in eine Auflaufform stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gemüsebrühe um die Tomaten gießen, mit Salz und Pfeffer würzen, mit Alufolie abdecken und bei 375°F 35-40 Minuten backen, bis die Tomaten weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit frischer Petersilie garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
