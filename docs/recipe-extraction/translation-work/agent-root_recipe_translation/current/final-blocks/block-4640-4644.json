      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen Pfanne erhitzen und die gewürfelte Zwiebel anbraten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rinderhackfleisch dazugeben, beim Garen zerkrümeln und braten, bis es gebräunt ist, dann mit Mehl bestäuben und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderbrühe und Tomatensoße angießen, Worcestershiresauce dazugeben und 15 Minuten köcheln lassen, bis die Masse eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Salz und Pfeffer würzen, die Füllung in eine Pastetenform geben und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Füllung mit dem oberen Teigboden bedecken, die Ränder zum Verschließen andrücken und oben Dampfschlitze einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Ei verquirlen und den Teig damit bestreichen, damit er goldbraun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400°F 25-30 Minuten backen, bis der Teig goldbraun ist und die Füllung an den Rändern blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
