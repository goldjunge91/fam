      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Tomaten oben ab und höhle sie mit einem Löffel aus. Stelle das Fruchtfleisch beiseite und streue Salz in die Tomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die Zwiebel und hacke den Knoblauch. Dünste beides im Olivenöl, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Rinderhackfleisch dazu und brate es, bis es gebräunt ist. Zerteile es dabei in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mische Paniermehl, Käse, Ei, das beiseitegestellte Tomatenfruchtfleisch, Salz und Pfeffer unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Füllung gleichmäßig auf die ausgehöhlten Tomaten und setze sie in eine gefettete Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie 25-30 Minuten, bis die Tomaten weich und die Füllung durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm und garniere sie nach Belieben mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
