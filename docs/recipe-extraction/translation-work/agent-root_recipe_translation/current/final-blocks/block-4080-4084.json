          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe angießen, Thymian hinzufügen und aufkochen; Hitze reduzieren und 25 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rüben und Karotten hinzufügen und 15 Minuten köcheln lassen, bis das Gemüse fast weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hirse einrühren, wieder zum Köcheln bringen, abdecken und 15 Minuten garen, bis die Hirse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, 5 Minuten ruhen lassen, auflockern, mit Salz und Pfeffer abschmecken und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
