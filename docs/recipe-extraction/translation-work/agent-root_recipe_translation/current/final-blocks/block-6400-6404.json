      "steps": [
        {
          "position": 0,
          "text": "Die Schnitzel zwischen Frischhaltefolie legen und mit einem Fleischklopfer auf 1/4 Zoll Dicke flach klopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drei Panierstationen vorbereiten: Mehl in eine Schüssel, verquirlte Eier in eine zweite und Semmelbrösel in eine dritte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jedes Schnitzel in Mehl wenden, überschüssiges Mehl abschütteln, dann in Ei tauchen und gründlich mit Semmelbröseln bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze schmelzen. Die panierten Schnitzel pro Seite 3–4 Minuten goldbraun und gar braten. Auf einem warmen Teller beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In derselben Pfanne geschnittene Champignons und gehackte Schalotten in der restlichen Butter 4 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Pfanne mit Weißwein ablöschen, die gebräunten Stücke herauskratzen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schlagsahne einrühren und 2–3 Minuten sanft köcheln lassen, bis die Sauce leicht eindickt. Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Schnitzel auf Serviertellern anrichten und die Champignon-Sahnesauce darüber geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
