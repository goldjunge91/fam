      "steps": [
        {
          "position": 0,
          "text": "Mehl, Wasser, 2 Esslöffel Olivenöl und Salz zu einem weichen Teig verrühren. 5 Minuten kneten, dann zugedeckt 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 Esslöffel Olivenöl in einer großen Pfanne erhitzen. Gewürfelte Zwiebel und gehackten Knoblauch darin weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch hinzufügen und anbraten, bis es braun ist, dann Tomatensauce, Paprika, Lorbeerblatt und Salz hinzufügen; 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teilen Sie den Teig in zwei Hälften und rollen Sie jede Portion auf einer bemehlten Oberfläche zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie einen Teigkreis auf ein Backblech, verteilen Sie die Füllung gleichmäßig darauf und bedecken Sie ihn dann mit dem zweiten Teigkreis. Versiegeln Sie die Kanten, indem Sie sie mit einer Gabel andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Oberfläche mit Olivenöl bestreichen und bei 375 °F 30–35 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Schneiden und Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
