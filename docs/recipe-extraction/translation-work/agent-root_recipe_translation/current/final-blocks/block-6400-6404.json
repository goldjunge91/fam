      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, in der Mitte eine Mulde formen und Eier und die Hälfte der Milch hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eier und Milch verquirlen, dabei nach und nach Mehl von den Seiten einziehen lassen, dann die restliche Milch und das Wasser hinzufügen und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 30 Minuten bei Zimmertemperatur ruhen lassen und dann die geschmolzene Butter unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine leicht gebutterte beschichtete 8 Zoll große Pfanne bei mittlerer bis hoher Hitze erhitzen. 1/4 Tasse Teig hineingießen und die Pfanne sofort schwenken, damit er sich dünn und gleichmäßig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Crêpe ca. 1 Minute backen, bis die Unterseite hellgolden ist, dann umdrehen, auf der anderen Seite 30 Sekunden backen und auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Äpfel schälen, entkernen und in dünne Scheiben schneiden, dann in Butter mit Zucker und Zimt 5 Minuten kochen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Falls gewünscht, Calvados hinzufügen und noch 1 Minute köcheln lassen, dann vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Füllen Sie jeden warmen Crêpe mit der Apfelmischung, falten Sie ihn in Viertel und servieren Sie ihn sofort mit einem Klecks Crème fraîche oder Schlagsahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
