      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und Zucker in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer anderen Schüssel Eier verquirlen und unter Rühren nach und nach Milch hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die feuchten Zutaten in die Mehlmischung geben und verquirlen, bis ein glatter Teig entsteht. 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 Esslöffel Butter in einer beschichteten Pfanne bei mittlerer bis hoher Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1/4 Tasse Teig in die Mitte der Pfanne gießen. Die Pfanne sofort kippen und drehen, damit sich der Teig dünn über den gesamten Boden verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1-2 Minuten braten, bis die Unterseite hellgolden ist, dann umdrehen und die andere Seite 30 Sekunden braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einen Teller geben und mit dem restlichen Teig wiederholen, nach Bedarf Butter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm servieren, mit Honig beträufeln und geschmolzener Butter als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
