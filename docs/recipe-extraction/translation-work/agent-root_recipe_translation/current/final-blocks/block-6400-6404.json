      "steps": [
        {
          "position": 0,
          "text": "Schinkenhaxe in einen großen Topf geben, mit Wasser bedecken und zum Kochen bringen; Gießen Sie das erste Wasser weg und spülen Sie das Fleisch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Fleisch mit frischem Wasser zurück in den Topf geben. Zwiebel, Knoblauch und Lorbeerblatt hinzufügen, aufkochen und anschließend 90 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln schälen, vierteln und nach 90 Minuten in den Topf geben; 20 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rübengrün gründlich waschen, harte Stiele entfernen und grob hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das Gemüse in den Topf und kochen Sie es 10–15 Minuten lang, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fleisch aus dem Topf nehmen und zerkleinern oder in Stücke schneiden; Brühe mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Geben Sie das Fleisch wieder in den Topf und servieren Sie es heiß in Schüsseln mit Kartoffeln, Gemüse und Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
