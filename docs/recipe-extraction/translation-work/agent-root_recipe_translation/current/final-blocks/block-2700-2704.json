      "steps": [
        {
          "position": 0,
          "text": "Spüle die getrockneten Schälerbsen unter kaltem Wasser ab und gieße sie vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel fein und hacke Knoblauch und frischen Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste die Zwiebel 5 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und Ingwer hinzu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Paprikapulver und Kurkuma ein und gare sie 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Schälerbsen, Wasser, Salz und Cayennepfeffer hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 25-30 Minuten köcheln, bis die Erbsen vollständig weich und zerfallen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre gelegentlich um. Die Mischung sollte dick und cremig sein. Serviere sie heiß mit Injera.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
