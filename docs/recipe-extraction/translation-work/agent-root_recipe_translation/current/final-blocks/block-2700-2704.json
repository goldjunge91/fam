            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Teffmehl, Salz, Hefe und Wasser in einer großen Schüssel zu einem glatten, klumpenfreien Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke die Schüssel locker mit einem Tuch ab und lasse den Teig 3-5 Tage bei Raumtemperatur fermentieren, bis er säuerlich riecht und schmeckt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre den Teig während der Fermentation einmal täglich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze nach der Fermentation eine beschichtete Pfanne oder Injera-Pfanne bei mittlerer bis hoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße etwa 3/4 Tasse Teig auf die heiße Fläche und neige und drehe die Pfanne rasch, damit sich der Teig zu einem dünnen, gleichmäßigen Kreis von etwa 10 Zoll Durchmesser verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und gare den Teig etwa 2-3 Minuten, bis die Oberfläche fest ist und kleine Löcher erscheinen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd und löse das Injera vorsichtig auf einen sauberen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wiederhole den Vorgang mit dem restlichen Teig und serviere das Injera als Grundlage für Eintöpfe und Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
