      "steps": [
        {
          "position": 0,
          "text": "Spüle die roten Linsen gründlich unter kaltem Wasser ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebeln fein und hacke Knoblauch und Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und bräune das Rinderhackfleisch etwa 5 Minuten. Zerteile es dabei mit einem Löffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zwiebel, Knoblauch und Ingwer hinzu und dünste alles 5 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Paprikapulver ein und gare es 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Linsen, Wasser, Salz und schwarzen Pfeffer hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 30-35 Minuten köcheln, bis die Linsen vollständig zerfallen und den Eintopf andicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre gelegentlich um und gib mehr Wasser hinzu, falls der Eintopf zu dick wird. Serviere ihn heiß mit Injera.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
