      "steps": [
        {
          "position": 0,
          "text": "Schneide die Rinderlende in dünne Streifen und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Paprika, Zwiebel und Tomaten und hacke Knoblauch und Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne oder einem Wok bei hoher Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Rindfleischstreifen in einer Lage hinein und gare sie 2 Minuten ohne Rühren, bis sie gebräunt sind. Rühre dann um und gare sie weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch heraus und stelle es beiseite. Gib Zwiebel und Paprika in die Pfanne und brate sie unter Rühren 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Knoblauch und Ingwer hinzu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Fleisch zurück in die Pfanne, füge Tomaten, Salz, schwarzen Pfeffer und trockenen Senf hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gare alles bei hoher Hitze 3-4 Minuten, bis das Gemüse bissfest und das Fleisch gar ist. Serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
