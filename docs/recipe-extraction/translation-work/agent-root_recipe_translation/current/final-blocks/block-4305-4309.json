      ],
      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer Pfanne erhitzen und gewürfelte Zwiebel sowie Knoblauch weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch hinzufügen und unter Zerteilen braten, bis es gebräunt ist, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Crêpes flach auslegen und die Rindfleischmischung gleichmäßig darauf verteilen, dabei die Füllung an einem Ende platzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Crêpe fest aufrollen und mit der Naht nach unten in eine gebutterte Auflaufform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Béchamelsauce über die Canelones gießen und anschließend Tomatensauce darüberträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das ganze Gericht großzügig mit Parmesan bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375 °F 25–30 Minuten backen, bis die Oberfläche goldbraun ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen und vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
