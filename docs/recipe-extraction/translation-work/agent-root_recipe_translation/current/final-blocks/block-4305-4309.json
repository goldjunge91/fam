      ],
      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350 °F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zucker und Wasser in einem kleinen Topf bei mittlerer Hitze unter Rühren erwärmen, bis sich der Zucker auflöst und ein hell bernsteinfarbenes Karamell entsteht. Schnell in eine runde Auflaufform gießen und den Boden bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vollmilch, Kondensmilch, Eier und Vanilleextrakt glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Milchmischung über das Dulce de Leche in der karamellisierten Form gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Auflaufform in eine größere Bratform stellen, die bis zur halben Höhe der Form mit heißem Wasser gefüllt ist (Wasserbad).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "35–40 Minuten backen, bis der Flan fest, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vollständig abkühlen lassen und mindestens 4 Stunden kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einem dünnen Messer am Rand entlangfahren und zum Stürzen auf eine Servierplatte wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
