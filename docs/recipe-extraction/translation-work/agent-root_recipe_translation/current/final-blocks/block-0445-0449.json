      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375 F vor. Verrühre in einer großen Schüssel die Füllungsmischung oder gewürzte Semmelbrösel mit Wasser und Barbecuesoße, bis die Brösel die Flüssigkeit aufgenommen haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Rinderhack dazu und vermenge alles vorsichtig mit den Händen, bis die Zutaten gerade eben verbunden sind. Höre auf zu mischen, sobald die Masse zusammenhält, damit das Fleisch nicht zäh wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib etwa 1/3 Tasse der Mischung in jede der 12 ungefetteten Muffinmulden und drücke sie vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe die Hackbraten ohne Abdeckung 18 bis 22 Minuten, bis ein Thermometer in der Mitte eines Stücks 160 F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den Cheddar darüber und schiebe die Form für weitere 2 bis 4 Minuten zurück in den Ofen, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warm servieren, nach Wunsch mit zusätzlicher Barbecuesoße dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
