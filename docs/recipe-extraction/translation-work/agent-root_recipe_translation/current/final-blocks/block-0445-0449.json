      "steps": [
        {
          "position": 0,
          "text": "Verrühre das Bohnenmus mit der Hälfte der Salsa, bis die Mischung glatt und gleichmäßig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Tortillas auf eine Grillplatte oder in eine große Pfanne bei mittlerer Hitze. Erwärme sie etwa 1 Minute und wende sie dann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Bohnenmischung in die Mitte jeder Tortilla und belege sie mit zerbröseltem Cotija und gehacktem Speck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Tortillas weitere 1 bis 2 Minuten, bis sie goldbraun und knusprig werden und die Füllung durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Burritos vom Herd und verteile sofort gezupften Salat und die restliche Salsa über der Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe den unteren Rand und beide Seiten jeder Tortilla über die Füllung und serviere die Burritos sofort.",
          "timerMinutes": null,
