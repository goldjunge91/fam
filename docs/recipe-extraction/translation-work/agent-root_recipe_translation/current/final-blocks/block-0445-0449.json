      "steps": [
        {
          "position": 0,
          "text": "Vermische Oregano, Kreuzkümmel, Paprikapulver, 2 Teelöffel Pfeffer und 1/2 Teelöffel Salz zu einer Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Welsfilets rundherum mit der Gewürzmischung ein und stelle sie mindestens 30 Minuten in den Kühlschrank, damit die Würzung einziehen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge währenddessen die gewürfelte Mango und Avocado mit roter Zwiebel, Koriander, Limettensaft sowie dem restlichen Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Salsa ab und stelle sie kalt, bis du sie anrichten möchtest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das Öl in einer großen gusseisernen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Filets 5 bis 7 Minuten pro Seite, bis der Fisch undurchsichtig ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte den Cajun-Wels auf Tellern an und verteile die Mango-Avocado-Salsa mit einem Löffel darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
