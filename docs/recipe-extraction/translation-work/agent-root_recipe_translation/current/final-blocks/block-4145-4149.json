      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350 °F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "3/4 Tasse Zucker und Wasser in einem Topf bei mittlerer Hitze verrühren, bis sich der Zucker auflöst und nach etwa 5–7 Minuten goldbraun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Karamell schnell in eine runde Auflaufform gießen und durch Neigen gleichmäßig auf dem Boden verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gezuckerte Kondensmilch, Kondensmilch, Eier und Vanille in einem Mixer glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Puddingmischung in die karamellisierte Auflaufform gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Form in eine größere Bratform stellen und diese bis zur halben Höhe der Auflaufform mit heißem Wasser füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "35–40 Minuten backen, bis der Pudding gestockt, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vollständig abkühlen lassen und anschließend mindestens 4 Stunden kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit einem Messer am Rand entlangfahren und auf eine Servierplatte stürzen, sodass das Karamell über den Pudding läuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
