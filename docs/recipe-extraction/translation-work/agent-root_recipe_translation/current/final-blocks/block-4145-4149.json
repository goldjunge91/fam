      "steps": [
        {
          "position": 0,
          "text": "Das kubanische Brot längs halbieren und wie ein Buch aufklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Senf auf beide Innenseiten des Brots streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinebraten, Schinken, Schweizer Käse und Gewürzgurkenscheiben auf der unteren Hälfte schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Sandwich schließen und diagonal in zwei Portionen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Außenseiten des Sandwichs beidseitig mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine Pfanne oder Panini-Presse bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Sandwich pro Seite 3–4 Minuten toasten, bis es goldbraun und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren und sofort genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
