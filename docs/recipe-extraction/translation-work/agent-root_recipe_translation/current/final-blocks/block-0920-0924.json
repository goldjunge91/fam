      "steps": [
        {
          "position": 0,
          "text": "Bereite den Couscous zu: Koche 1 Tasse Wasser auf, gieße es über den Couscous, decke die Schüssel ab und lass alles 5 Minuten quellen. Lockere den Couscous mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Thunfisch und Kichererbsen ab. Würfle Gurke und Tomate. Hacke die Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze den Couscous mit Olivenöl, Zitronensaft, Essig, Knoblauch und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe Thunfisch, Kichererbsen, Gurke, Tomate, Spinat und Petersilie unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Bowl bei Zimmertemperatur oder bewahre sie bis zu 2 Tage im Kühlschrank auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
