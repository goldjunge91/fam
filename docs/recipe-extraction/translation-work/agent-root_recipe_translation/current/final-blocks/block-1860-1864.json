      "steps": [
        {
          "position": 0,
          "text": "Vorbereitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln in eine Bratpfanne geben und 5 Minuten in Olivenöl braten, bis sie anfangen zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze ausschalten. Fleisch, Reis, Pfeffer, Paprikapulver, getrocknete Gemüsebrühe, Petersilie und Basilikum dazugeben. Alle Zutaten vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weinblätter vorsichtig auseinanderfalten. Ein Blatt so auf die Hand legen, dass die Basis unten an der Handfläche und die Spitze nach oben zeigt. Ein zweites Blatt mit der Spitze nach unten und seiner Basis oben an die Finger legen. Die Blätter sollten sich gut überlappen. Nach Wunsch kann dies auch auf einer ebenen Fläche geschehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Löffel der Fleisch-Reis-Mischung in die Mitte der Blätter geben. Unterseite über die Füllung klappen, beide Seiten einschlagen und das Blatt dann nach oben aufrollen, sodass ein festes Päckchen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Boden eines tiefen Topfes mit einer Lage Weinblättern bedecken und die Päckchen darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "So viele Päckchen wie möglich aus der Fleisch-Reis-Mischung formen und nebeneinander in den Topf setzen, bis der Boden bedeckt ist. Dann eine weitere Lage daraufsetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Genug kochendes Wasser in den Topf gießen, sodass die Weinblätter gerade bedeckt sind. Zum Kochen bringen und mit Deckel 1.5 Stunden köcheln lassen. Das Wasser sollte vollständig aufgenommen werden. Falls es vorher verdampft ist, etwas kochendes Wasser nachgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Aus dem Topf nehmen und vor dem Servieren 10 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
