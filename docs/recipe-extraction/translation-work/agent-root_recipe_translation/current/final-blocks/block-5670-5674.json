          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den aufgetauten Blätterteig ausrollen und längs in zwei lange Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Brätmischung halbieren, zu zwei langen Rollen formen und jeweils auf einen Teigstreifen legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig um das Brät rollen, die Kante mit Wasser verschließen und jede Rolle in 6 Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ei mit 1 Esslöffel Wasser verquirlen und die Teigrollen damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "25–30 Minuten backen, bis der Teig goldbraun und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
