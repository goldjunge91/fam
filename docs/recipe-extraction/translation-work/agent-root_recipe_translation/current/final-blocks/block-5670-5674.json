      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 400°F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würstchenbrät mit Paniermehl, gehacktem Salbei, Senfpulver, Salz und Pfeffer in einer Schüssel vermengen.",
