      "steps": [
        {
          "position": 0,
          "text": "Schäle Kartoffeln und schneide sie in 1/4 Zoll dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel und vermische sie mit Schweinehackfleisch, Eiern, in Milch eingeweichten Semmelbröseln, Petersilie, Salz und Pfeffer zu einer Fleischmasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fette eine Auflaufform mit Butter ein und schichte die Hälfte der Kartoffelscheiben auf den Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Schweinefleischmischung gleichmäßig auf der Kartoffelschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege sie mit den übrigen Kartoffelscheiben in überlappenden Reihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Hühnerbrühe um und über die Kartoffeln, decke die Form mit Folie ab und backe sie bei 375°F 50 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne die Folie und backe weitere 15 Minuten, bis die Kartoffeln goldbraun und zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse den Auflauf vor dem direkten Servieren aus der Form 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
