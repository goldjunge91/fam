      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine Kastenform mit 8x4 Zoll ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier mit Honig und braunem Zucker, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle in einer separaten Schüssel Mehl, Backpulver, Zimt, Nelken, Anis, Ingwer und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe die trockenen Zutaten unter die flüssigen, bis sie gerade vermischt sind, und rühre dann geschmolzene Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in die vorbereitete Form und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Kuchen 35-40 Minuten, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse ihn 15 Minuten in der Form abkühlen und stürze ihn dann zum vollständigen Abkühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide ihn auf und serviere ihn mit Butter oder bewahre ihn bis zu einer Woche in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
