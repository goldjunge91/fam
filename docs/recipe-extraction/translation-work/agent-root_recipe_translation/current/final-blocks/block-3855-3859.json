      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweineschulter in 2 Zoll große Würfel und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Schmortopf bei mittelhoher Hitze und bräune das Schweinefleisch portionsweise etwa 4 Minuten pro Portion. Stelle es dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste im selben Topf gewürfelte Zwiebel und Knoblauch etwa 3 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Viertle die Pilze und gib sie in den Topf. Gare sie etwa 5 Minuten, bis sie Flüssigkeit abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Weißwein und Brühe hinzu, löse die Röststoffe und gib Schweinefleisch mit Thymian und Lorbeerblatt zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Köcheln, decke den Topf ab und gare es 60 Minuten, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löse Speisestärke in 2 Esslöffeln kaltem Wasser auf und rühre sie in die Sauce, um sie einzudicken. Lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne Thymian und Lorbeerblatt, würze mit Salz und Pfeffer und serviere das Gericht mit Eiernudeln oder Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
