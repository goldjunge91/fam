      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Schweinekopffleisch, Füße und Leber 2 Stunden in Salzwasser mit Zwiebel, Knoblauch, Thymian und Lorbeerblättern, bis alles sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Fleisch aus der Brühe und lasse es leicht abkühlen. Zupfe oder würfle es in mundgerechte Stücke und entferne Knochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Seihe die Kochbrühe durch ein Mulltuch und reduziere sie auf 2 Tassen, indem du sie ohne Deckel 30 Minuten köcheln lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische zerkleinertes Fleisch mit abgekühlter Brühe, gehackter Petersilie, Pistazien, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Mischung in eine Terrinen- oder Kastenform und lasse sie auf Raumtemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form mit Frischhaltefolie ab und stelle sie mindestens 12 Stunden kalt, bis die Masse geliert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stürze die Terrine auf ein Schneidebrett und schneide sie in 1/2 Zoll dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gekühlt oder bei Raumtemperatur mit Senf und knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
