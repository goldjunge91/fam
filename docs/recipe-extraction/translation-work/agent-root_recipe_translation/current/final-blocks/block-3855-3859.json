          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Senf ein und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit knusprigem Brot und zusätzlichem Senf als Beilage servieren.",
