          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Sauerkraut, Apfel, Kümmelsamen, Weißwein und Brühe hinzu und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Knackwürste in die Sauerkrautmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, decke die Pfanne ab und gare die Würste 15 Minuten, bis sie durchgewärmt sind.",
