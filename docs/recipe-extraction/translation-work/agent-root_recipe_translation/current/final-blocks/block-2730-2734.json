      "steps": [
        {
          "position": 0,
          "text": "Koche Maniokwürfel 15 Minuten in Salzwasser, bis sie sehr weich sind. Gieße sie ab und zerdrücke sie zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und dünste Zwiebel, Knoblauch und Ingwer 3 Minuten, bis sie weich sind und duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib zerdrückten Maniok, Kokosmilch und Dosentomaten samt Saft hinzu und rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse alles aufkochen und koche es unter gelegentlichem Rühren 10 Minuten, bis es eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Garnelen hinzu und gare sie unter vorsichtigem Rühren 5 Minuten, bis sie rosa und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Chiliflocken, garniere mit Koriander und serviere das Gericht mit weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
