        {
          "position": 0,
          "text": "Vermische Kartoffelpüree, Rinderhackfleisch, Zwiebel, Knoblauch, 1 Ei, Salz, Pfeffer und Parmesan in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile die Mischung in 8 Portionen und forme jede zu einem Oval. Lege eine halbe Olive in die Mitte und umschließe sie mit der Fleischmasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite eine Panierstation mit verquirltem Ei in einer flachen Schüssel und Semmelbröseln in einer anderen vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende jede Rissole im verquirlten Ei, rolle sie dann in Semmelbröseln, bis sie vollständig bedeckt ist, und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und gib die Rissoles portionsweise vorsichtig hinein, ohne die Pfanne zu überfüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie 3-4 Minuten pro Seite goldbraun und lege sie dann zum Abtropfen auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
