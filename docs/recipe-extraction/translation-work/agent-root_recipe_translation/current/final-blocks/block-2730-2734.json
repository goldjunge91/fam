      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 EL Öl in einem großen Topf, dünste die Hälfte der gewürfelten Zwiebel und 1 Knoblauchzehe 2 Minuten, gib dann Bohnen und 1 Tasse Wasser hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Bohnen 10 Minuten und zerdrücke dabei gelegentlich einige an der Topfwand, damit die Brühe eindickt. Würze dann mit Salz, Pfeffer und Kreuzkümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze in einem zweiten großen Topf 2 EL Öl und dünste die übrige Zwiebel und den Knoblauch 2 Minuten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis hinzu und rühre 2 Minuten ständig um, damit die Körner leicht angeröstet werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 3 Tassen Wasser zum Reis, gib Lorbeerblatt und Salz hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf mit einem dicht schließenden Deckel ab und gare den Reis 18 Minuten, bis er weich ist und die Flüssigkeit aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd und lasse den Reis 5 Minuten ruhen. Lockere ihn mit einer Gabel auf, vermische ihn mit den Bohnen, garniere mit Frühlingszwiebeln und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
