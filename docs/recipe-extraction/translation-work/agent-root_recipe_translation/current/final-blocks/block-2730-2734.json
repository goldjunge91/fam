      "steps": [
        {
          "position": 0,
          "text": "Würze beide Steaks auf beiden Seiten großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 EL Öl in einer großen Pfanne bei hoher Hitze, bis sie sehr heiß ist. Brate die Steaks 2 Minuten pro Seite scharf an und lege sie dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 1 EL Öl in dieselbe Pfanne und dünste Zwiebel und Knoblauch bei mittlerer Hitze 5 Minuten, bis sie weich und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe, Tomatensauce und Essig hinzu und gib das Lorbeerblatt dazu. Kratze die Bratrückstände vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Steaks zurück in die Pfanne und bringe die Sauce zum Köcheln. Gare sie 3-4 Minuten pro Seite bis zum gewünschten Gargrad.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Steaks auf Servierteller, garniere die Sauce mit Koriander, gieße sie über das Fleisch und serviere es mit Reis und Bohnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
