      "steps": [
        {
          "position": 0,
          "text": "Erhitze Butter in einer beschichteten Pfanne oder Tapiokapfanne bei mittlerer Hitze, bis sie geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile 1/2 Tasse Tapiokaperlen gleichmäßig in der Pfanne und gare sie 1 Minute, ohne umzurühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue 2 EL Kokosraspeln und eine Prise Salz darüber und träufle dann 2 EL Kondensmilch und 2 EL Wasser auf die Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse alles 2-3 Minuten ungestört garen, bis die Unterseite fest und leicht goldbraun ist. Wende die Tapioka vorsichtig und gare die andere Seite 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege sie auf einen Teller und wiederhole den Vorgang mit den übrigen Tapiokaperlen, Kokosraspeln, Kondensmilch und Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege die fertigen Tapiokas mit Bananenscheiben, beträufle sie mit Honig, bestreue sie mit Zimt und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
