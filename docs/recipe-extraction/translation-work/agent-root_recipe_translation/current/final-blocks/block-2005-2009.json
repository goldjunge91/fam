      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem Topf mit schwerem Boden erhitzen und Zwiebel sowie Karotte dazugeben. 3–4 Minuten garen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfeltes Lamm dazugeben und rundherum anbräunen. Knoblauch und alle Gewürze einrühren und einige Minuten weitergaren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Honig und Aprikosen dazugeben, den Brühwürfel hineinbröseln und etwa 500 ml kochendes Wasser oder so viel, dass das Fleisch bedeckt ist, angießen. Gut umrühren und zum Kochen bringen. Hitze reduzieren, Deckel auflegen und 1 Stunde garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Deckel abnehmen und weitere 30 Minuten garen, dann Kürbis einrühren. Weitere 20–30 Minuten garen, bis der Kürbis weich und das Lamm zart ist. Mit Reis oder Couscous servieren und nach Wunsch mit Petersilie und Pinienkernen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
