      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermengen, nach und nach Wasser einrühren und zu einem festen Teig verarbeiten; 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 tbsp Öl in einer Pfanne erhitzen und Zwiebeln goldbraun braten, dann Ingwer-Knoblauch-Paste und grüne Chili hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhack und Currypulver hinzufügen und garen, bis das Fleisch durch ist; Koriander und Zitronensaft einrühren und vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 12 Kugeln teilen und jede mit den Händen oder einem Nudelholz zu einem dünnen Quadrat flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jedes Quadrat diagonal halbieren, sodass zwei Dreiecke entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 tbsp Füllung auf jedes Dreieck geben, zu einem kleineren Dreieck falten und die Ränder fest zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "3 cups Öl in einer tiefen Pfanne auf 350°F erhitzen und Samosas portionsweise etwa 2-3 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Chutney servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
