      "steps": [
        {
          "position": 0,
          "text": "Maisblätter oder Bananenblätter 10 Minuten in warmem Wasser einweichen, damit sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "3 cups Wasser mit Salz zum Kochen bringen und Maismehl unter ständigem Rühren langsam hineingießen, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze reduzieren und 15 Minuten rühren, bis die Mischung eindickt und sich nur schwer rühren lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Maismischung in 4 Portionen teilen und jede fest in ein eingeweichtes Mais- oder Bananenblatt wickeln, sodass ein rechteckiges Päckchen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kenkey in einen Topf mit etwa 2 inches Wasser legen und 30 Minuten dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Währenddessen Öl in einer Pfanne erhitzen und Zwiebel, Tomate, Ingwer sowie Chili für eine einfache Sauce anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kenkey aus den Blättern wickeln und heiß mit der Tomatensauce dazu oder darüber servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
