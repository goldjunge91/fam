      "steps": [
        {
          "position": 0,
          "text": "Törtchenböden",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Puderzucker in einer Küchenmaschine. Gib Butter dazu und mixe alles pulsierend, bis sie gleichmäßig verteilt ist. Gib das Ei dazu und pulse, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig auf einer bemehlten Fläche aus. Schneide mit einer großen Tasse Kreise aus. Drücke die Kreise in eine gefettete Muffinform. Stelle die Form mit den Böden in den Kühlschrank, während du die Mandelfüllung zubereitest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mandelfüllung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 355°F (180°C) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Ei und Puderzucker, bis die Mischung dick und luftig ist. Schmilz die Butter und rühre sie in die Eiermischung. Rühre Vanille, Mehl und Mandelextrakt ein. Hebe das Mandelmehl unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Mandelfüllung mit einem Spritzbeutel oder Löffel in die Törtchenböden, etwa zu 3/4.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Mazariner 20 – 25 Minuten, bis sie hellgoldbraun sind. Lass sie auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Glasur",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Vermische Puderzucker und Flüssigkeit zu einer streichfähigen Glasur. Verteile sie auf den Mazariner und verziere sie nach Wunsch mit Streuseln oder anderem Belag.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
