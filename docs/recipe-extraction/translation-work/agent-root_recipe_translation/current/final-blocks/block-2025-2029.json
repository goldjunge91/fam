      "steps": [
        {
          "position": 0,
          "text": "Steak vorbereiten: Würze das Steak mit Salz und Pfeffer. Grille eine Seite, bis sie halb gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Belag hinzufügen: Verteile Tomatensauce auf der gegrillten Seite und gib dann Käse, Oregano und Oliven darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fertig grillen: Grille das Steak weiter, bis der Käse geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Servieren: Schneide das Steak auf und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Profi-Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zart mache das Matambre, indem du es auf beiden Seiten leicht einschneidest. So gart es gleichmäßiger und nimmt die Aromen besser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare das Matambre auf dem Grill vor, bevor du den Belag darauf gibst. So wird es vollständig gar, ohne dass der Käse anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
