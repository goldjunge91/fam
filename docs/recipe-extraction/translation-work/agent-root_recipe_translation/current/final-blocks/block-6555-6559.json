      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen schweren Topf und bräune Rindfleischwürfel portionsweise von allen Seiten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Zwiebel und Knoblauch im selben Topf 5 Minuten an und gib dann scharfe Chilis hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch zurück in den Topf und rühre Cassareep gut unter, sodass das Fleisch vollständig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe hinein und gib Zimtstange, Nelken und Thymian dazu. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 60 Minuten köcheln, bis das Rindfleisch zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kartoffeln dazu und lasse alles weitere 25-30 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer, entferne die Zimtstange und serviere den Eintopf heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
