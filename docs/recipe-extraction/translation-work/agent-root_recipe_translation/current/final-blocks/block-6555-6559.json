      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Arbeite die Butter mit einer Gabel oder den Fingern ein, bis die Mischung wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach warmes Wasser unter Rühren dazu, bis ein weicher Teig entsteht. Knete ihn nicht zu stark.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Teig auf eine bemehlte Fläche und knete ihn 2-3 Minuten vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 6 Stücke und rolle jedes zu einem etwa 1/4 Zoll dicken Oval aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere die Bakes vorsichtig auf beiden Seiten etwa 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit Käse, Salzfisch oder Marmelade.",
