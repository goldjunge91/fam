      "steps": [
        {
          "position": 0,
          "text": "Lege gehackte Meeresschnecke in eine Schüssel und mariniere sie 15 Minuten mit Limettensaft, damit sie zart wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Meeresschnecke ab, spüle sie unter kaltem Wasser gut ab und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste Zwiebel, Knoblauch und Paprika 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomatenmark hinzu und gare es unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge das Schneckenfleisch hinzu und bräune es unter gelegentlichem Rühren 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Gemüsebrühe hinein, gib Thymian, scharfe Chili, Salz und Pfeffer hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze und lasse alles 45-50 Minuten köcheln, bis das Schneckenfleisch zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke ab und serviere heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
