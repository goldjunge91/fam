      "steps": [
        {
          "position": 0,
          "text": "Erhitze Butter in einem großen Topf und dünste Zwiebel und Knoblauch etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittene Okraschoten dazu und gare sie 5 Minuten unter gelegentlichem Rühren, bis sie Stärke abgeben und leicht andicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Gemüsebrühe hinzu und bringe sie zum Kochen. Gib Thymian, Salz und Pfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Maisgrieß langsam und in gleichmäßigem Strahl ein, damit keine Klümpchen entstehen. Rühre ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und rühre 10-15 Minuten ununterbrochen, bis die Masse dick ist und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Cou-Cou auf eine Servierplatte oder forme es auf einem Teller an und serviere heiß, traditionell mit Tomatensauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
