    {
      "externalId": "waivy:rice-cooker-bibimbap-bowl",
      "slug": "rice-cooker-bibimbap-bowl",
      "title": "Bibimbap-Reisschale aus dem Reiskocher",
      "instructions": "Eine gemütliche koreanische Reisschale, bei der der Reis am Boden goldbraun und knusprig wird. Darauf kommen schnell gegartes Gemüse, ein weich gekochtes Ei und Gochujang.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 40,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Tiefgekühltes Mischgemüse eignet sich genauso gut wie frisches. Gib es für den zweiten Kochzyklus direkt auf den Reis, ganz ohne Schneiden.",
        "Ein Becher Gochujang kostet nur ein paar Dollar und hält sich monatelang. Die Schärfe kostet pro Schüssel nur wenige Cent.",
        "Lass teure Shiitake weg und verwende Champignons oder Cremini-Pilze aus dem Angebot. Jeder Pilz wird in der Schüssel zart."
      ],
      "substitutions": [
        {
          "forIngredientId": "sushi-rice",
          "swap": "Beliebiger Rundkornreis oder sogar normaler Langkornreis",
          "savings": "Weißer Reis ist pro Pfund günstiger und wird am Topfboden trotzdem knusprig"
        },
        {
          "forIngredientId": "gochujang",
          "swap": "Sriracha mit etwas zusätzlicher Sojasauce und Zucker",
          "savings": "Verwendet eine Flasche, die du wahrscheinlich schon hast, statt eine neue Paste zu kaufen"
        },
        {
          "forIngredientId": "mushroom",
          "swap": "Tiefgekühlte Wok-Gemüsemischung",
          "savings": "Kostet weniger und verhindert Abfall durch frisches Gemüse, das nicht aufgebraucht wird"
        }
      ],
