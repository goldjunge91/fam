      "steps": [
        {
          "position": 0,
          "text": "Forme das Rinderhackfleisch zu 2 Bratlingen, die etwas größer als die Brötchen sind; drücke jeweils eine kleine Vertiefung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Grillplatte oder Pfanne bei mittelhoher Hitze und brate die Bratlinge 3-4 Minuten pro Seite, bis die Kerntemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege in der letzten Minute der Garzeit je eine Scheibe Käse auf die Bratlinge und decke sie ab, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die Brötchen leicht mit Butter und röste sie mit der Schnittseite nach unten in einer separaten Pfanne, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche die untere Brötchenhälfte mit Mayonnaise und die obere mit Senf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte Salat, einen Bratling mit Käse, Tomate und Zwiebel auf die untere Brötchenhälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schließe das Sandwich mit der oberen Brötchenhälfte und wickle es in Folie, damit es warm bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
