      "steps": [
        {
          "position": 0,
          "text": "Halbiere den Spaghettikürbis der Länge nach und entferne die Kerne mit einem Löffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege den Kürbis mit der Schnittseite nach unten auf ein Backblech und röste ihn bei 400°F 35-40 Minuten, bis er mit einer Gabel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und brate das Rinderhackfleisch unter Zerkrümeln 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gewürfelte Zwiebel und den Knoblauch hinzu und dünste alles 3 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre das Tomatenmark ein und koche es 1 Minute mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die stückigen Tomaten dazu, würze mit Salz, Pfeffer und Basilikum und lasse die Sauce 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ziehe das geröstete Kürbisfleisch mit einer Gabel in nudelartige Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Kürbisstreifen auf Tellern, gib die Fleischsauce darauf und garniere mit Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
