    {
      "externalId": "waivy:cur-crispy-hash-browns",
      "slug": "cur-crispy-hash-browns",
      "title": "Knusprige Rösti aus der Pfanne",
      "instructions": "Goldbraun gebratene, besonders knusprige Kartoffelrösti aus frisch geriebenen Kartoffeln. Die Kartoffeln werden gründlich ausgedrückt und anschließend in Butter und Öl gebraten, bis sie außen knusprig und innen locker sind.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Kartoffeln der Sorte Russet sind im 5-Pfund-Beutel oft besonders günstig. Übrige Kartoffeln für Püree oder Pommes verwenden.",
        "Das stärkehaltige Wasser der ausgedrückten Kartoffeln stehen lassen; die abgesetzte Stärke kann kostenlos Soßen binden.",
        "Gewürzpulver weglassen und stattdessen etwas frische Zwiebel hineinreiben, wenn sie gerade zur Hand ist."
      ],
      "substitutions": [
        {
          "forIngredientId": "potato",
          "swap": "gefroren shredded hash-browns, thawed und squeezed dry",
          "savings": "Spart Vorbereitungszeit und vermeidet Reste; meist nur wenige Cent Unterschied pro Portion"
        },
        {
          "forIngredientId": "butter",
          "swap": "All Pflanzenöl (verwenden 3 tbsp total)",
          "savings": "Spart ~$0.20/Portion und ergibt eine milchfreie Variante"
        },
        {
          "forIngredientId": "vegetable-oil",
          "swap": "Bacon fat oder any neutral Öl du have",
          "savings": "Kostenlos bei vorhandenem ausgelassenem Speckfett und sorgt für herzhaftes Aroma"
        }
      ],
      "crispinessLevel": null,
      "airFryerTimeMinutes": null,
