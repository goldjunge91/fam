    {
      "externalId": "waivy:cur-classic-meatloaf",
      "slug": "cur-classic-meatloaf",
      "title": "Klassischer Hackbraten",
      "instructions": "Saftiger Hackbraten nach amerikanischer Art: In Milch eingeweichtes Brot hält das Fleisch zart, während angebratene Zwiebeln und Knoblauch für Würze sorgen. Eine Glasur aus Ketchup und braunem Zucker karamellisiert im Ofen.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 70,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "80/20-Rinderhackfleisch im Angebot kaufen und einfrieren; der höhere Fettanteil hält den günstigen Hackbraten saftig.",
        "Mit einer zusätzlichen Scheibe Brot oder schnellkochenden Haferflocken lässt sich die Fleischmenge strecken.",
        "Übrige Scheiben am nächsten Tag als Hackbraten-Sandwich servieren."
      ],
      "substitutions": [
        {
          "forIngredientId": "ground-beef",
          "swap": "verwenden half gemahlen Rindfleisch und half gemahlen Schweinefleisch oder gemahlen turkey für ein klassisch meatloaf mixen",
          "savings": "Putenhackfleisch kann die Kosten um 20-30% senken"
        },
        {
          "forIngredientId": "bread",
          "swap": "Swap der Brot panade für 1/2 cup natur breadcrumbs oder schnell Haferflocken",
          "savings": "Verwendet vorhandene Grundzutaten, nahezu keine zusätzlichen Kosten"
        },
        {
          "forIngredientId": "parsley-fresh",
          "swap": "verwenden 2 tsp getrocknet Petersilie anstatt frisch",
          "savings": "Spart etwa $1 gegenüber dem Kauf eines frischen Bunds"
        }
      ],
