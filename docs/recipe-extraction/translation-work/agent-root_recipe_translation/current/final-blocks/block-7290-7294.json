      "steps": [
        {
          "position": 0,
          "text": "Die Kartoffeln schälen und auf der groben Seite einer Reibe in eine Schüssel mit kaltem Wasser raspeln. Umrühren, damit sich Stärke löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Abgießen und die geriebenen Kartoffeln auf ein sauberes Küchentuch geben. Über dem Spülbecken kräftig ausdrücken, bis möglichst kein Wasser mehr austritt. Auflockern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die ausgedrückten Kartoffeln mit Salz, Pfeffer und nach Wunsch Zwiebel- und Knoblauchpulver vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine schwere beschichtete oder gusseiserne Pfanne bei mittelhoher Hitze erwärmen. Pflanzenöl und die Hälfte der Butter hineingeben und aufschäumen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln hineingeben und mit einem Pfannenwender gleichmäßig zu einer 1/2 Zoll dicken Schicht drücken. Kleine Lücken lassen, damit Dampf entweichen kann. Nicht umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "5–7 Minuten ungestört braten, bis die Unterseite dunkel goldbraun und knusprig ist. Nicht zu früh wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die übrige Butter am Rand verteilen. Die Rösti in Stücken oder am Stück wenden und weitere 4–6 Minuten braten, bis auch die zweite Seite gebräunt und die Mitte gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kurz auf Küchenpapier abtropfen lassen, eine Prise Salz darübergeben und sofort knusprig servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
