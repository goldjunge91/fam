      "steps": [
        {
          "position": 0,
          "text": "Eine 10 Zoll große Gusseisenpfanne auf die mittlere Ofenschiene stellen. Den Ofen mit der Pfanne darin auf 425 °F (220 °C) vorheizen und die Pfanne mindestens 15 Minuten erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl, Weizenmehl, Backpulver, Natron und Salz in einer großen Schüssel gleichmäßig vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer zweiten Schüssel Eier, Buttermilch, nach Wunsch Honig und 4 EL geschmolzene Butter glatt verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die flüssigen Zutaten zu den trockenen geben und mit einem Teigschaber nur so lange rühren, bis kein trockenes Mehl mehr zu sehen ist. Nicht zu lange rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die heiße Pfanne herausnehmen. Die übrigen 1 EL Butter hineingeben und schwenken, bis sie schäumt und Boden sowie Seiten bedeckt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig sofort in die Pfanne gießen. Er sollte beim Eingießen zischen. Oberfläche glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20–25 Minuten backen, bis die Oberfläche dunkel goldbraun ist und ein Zahnstocher in der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten in der Pfanne ruhen lassen. Mit einem Messer am Rand entlangfahren, das Brot auf ein Brett stürzen oder in Stücke schneiden und warm mit Butter servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
