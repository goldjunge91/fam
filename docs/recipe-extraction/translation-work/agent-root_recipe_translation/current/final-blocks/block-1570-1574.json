      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis. Schneide das Hähnchen in mundgerechte Stücke und die Zwiebel in dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Dashi, Sojasauce, Mirin und Zucker in einer flachen Pfanne und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebel dazu und gare sie 3 Minuten. Füge das Hähnchen hinzu und gare es 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle die Eier leicht, sodass sie noch etwas Schlieren haben. Gieße sie kreisförmig über das Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne ab und gare alles 1–2 Minuten, bis das Ei gerade eben stockt und cremig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Mischung auf Reis und garniere sie mit Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
