    {
      "externalId": "waivy:mfr-jp-oyakodon",
      "slug": "mfr-jp-oyakodon",
      "title": "Oyakodon – Reisschale mit Hähnchen und Ei",
      "instructions": "Donburi als „Elternteil und Kind“: mundgerechte Stücke Hähnchenschenkel mit Zwiebel in süßer Dashi-Brühe geschmort, bis das ganz zum Schluss zugegebene Ei zu einer seidigen, leicht durchscheinenden Creme stockt und über den heißen weißen Reis läuft. Ein typisches japanisches Hausmannsgericht.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Hähnchenschenkel sind günstiger als Brustfleisch und bleiben in der Brühe zart.",
        "Das nur halb gestockte Ei ist entscheidend – nimm die Pfanne früh vom Herd.",
        "Eine einzelne Oyakodon-Pfanne kostet $15, aber jede breite, flache Pfanne funktioniert."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-thighs",
          "swap": "Hähnchenbrust – 1 Minute kürzer garen"
        },
        {
          "forIngredientId": "dashi",
          "swap": "Hühnerbrühe und ein Schuss Sojasauce für mehr Aroma"
        }
      ],
      "crispinessLevel": null,
