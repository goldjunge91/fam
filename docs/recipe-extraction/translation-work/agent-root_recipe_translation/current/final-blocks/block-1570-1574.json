      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Presse den Tofu mindestens 15 Minuten – so wird er knusprig.",
        "Tiefgekühlte Brokkoliröschen funktionieren perfekt und sparen Geld.",
        "Hausgemachte Teriyaki-Sauce schmeckt viel besser als gekaufte und kostet etwa $0.10 pro Menge."
      ],
      "substitutions": [
