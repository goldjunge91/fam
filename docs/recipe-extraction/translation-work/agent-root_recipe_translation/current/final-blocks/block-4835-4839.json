      "steps": [
        {
          "position": 0,
          "text": "Spüle den Reis gründlich unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe das Wasser in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den gewaschenen Reis dazu und rühre gut um. Reduziere dann die Hitze auf niedrige Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Reis ohne Deckel 30-35 Minuten unter gelegentlichem Rühren köcheln, bis er vollständig zu Brei zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre den gehackten Ingwer und Knoblauch ein und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz, weißem Pfeffer und Fischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle den Reisbrei in Schalen und garniere ihn mit gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib mehr Wasser dazu, wenn der Brei zu dick ist, oder lasse ihn länger köcheln, wenn er zu dünn ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
