      "steps": [
        {
          "position": 0,
          "text": "1 Esslöffel Butter in einer Pfanne bei mittelhoher Hitze erhitzen und Rinderhackfleisch mit Zwiebel 8 Minuten bräunen; dabei das Fleisch zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleisch mit Salz und Pfeffer würzen, aus der Pfanne nehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne Rinderbrühe und Maisstärke glatt verquirlen und in die Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sauce leicht köcheln lassen und 3 Minuten eindicken, dann Rindfleisch zurück in die Pfanne geben und warm halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zwei Eier in der restlichen Butter in einer anderen Pfanne als Spiegeleier oder mit teilweise gestocktem Eigelb braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochten Reis auf zwei Teller verteilen und jeden mit einem aus der Mischung geformten Rindfleisch-Patty belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jedes Patty mit einem Spiegelei belegen und großzügig Sauce über den ganzen Teller gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
