      "steps": [
        {
          "position": 0,
          "text": "Safran 10 Minuten in heißem Wasser einweichen und Reis gründlich abspülen, dann 20 Minuten einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchenteile mit Salz und Pfeffer würzen, dann in einem Topf mit 2 tablespoons Butter pro Seite 8 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen herausnehmen und geschnittene Zwiebel im selben Topf etwa 10 Minuten karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Salzwasser zum Kochen bringen und abgetropften Reis hinzufügen; 8 Minuten garen, bis er teilweise weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reis abgießen und mit den Hähnchenteilen im Topf schichten; Safranwasser darüber gießen, restliche Butter darauf verteilen und dicht abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei mittlerer Hitze 25 Minuten garen, bis der Reis vollständig gekocht ist und sich eine goldene Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten ruhen lassen und dann mit knusprigem Tahdig vom Topfboden servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
