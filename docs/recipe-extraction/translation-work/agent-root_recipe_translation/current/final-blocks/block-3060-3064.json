          "position": 2,
          "text": "Schweinefleischwürfel, Butternusskürbiswürfel und Pökelspeck auf die Taro-Blätter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Salz und Pfeffer würzen, dann fest in die Taro-Blätter einwickeln und bei Bedarf mit Küchengarn fixieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Päckchen mit der Nahtseite nach unten in einen Topf mit Wasser legen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze reduzieren, abdecken und 90 Minuten köcheln lassen, bis Schweinefleisch und Kürbis weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Päckchen vorsichtig öffnen und heiß servieren; Kochflüssigkeit darüberlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
