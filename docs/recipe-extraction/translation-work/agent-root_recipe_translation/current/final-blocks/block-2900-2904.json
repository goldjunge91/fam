      "steps": [
        {
          "position": 0,
          "text": "Bereite Hollandaise zu, indem du Eigelb und Zitronensaft über siedendem Wasser im Wasserbad blass aufschlägst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre langsam geschmolzene Butter ein, bis die Sauce dick und cremig ist. Würze mit Salz und Cayennepfeffer und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme Scheiben kanadischen Specks in einer Pfanne bei mittlerer Hitze 1 Minute pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die englischen Muffins goldbraun und lege jeweils zwei Hälften auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege jede Muffinhälfte mit einer Scheibe kanadischem Speck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pochiere Eier 3-4 Minuten in siedendem Wasser mit einem Schuss Essig, bis das Eiweiß gestockt und das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege vorsichtig je ein pochiertes Ei auf jede Scheibe kanadischen Specks und gieße großzügig warme Hollandaise darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
