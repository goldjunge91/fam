      "steps": [
        {
          "position": 0,
          "text": "Brate Speck in einem großen Topf bei mittlerer Hitze knusprig an. Nimm ihn heraus und hacke ihn in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Topf Zwiebel, Sellerie und Knoblauch im Speckfett etwa 5 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Augenbohnen und Hühnerbrühe dazu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse es 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gekochten Reis und Blattkohl ein und lasse alles 8-10 Minuten köcheln, bis der Kohl zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gegarten Speckstücke, scharfe Sauce, Salz und Pfeffer nach Geschmack dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel weitere 5 Minuten köcheln und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
