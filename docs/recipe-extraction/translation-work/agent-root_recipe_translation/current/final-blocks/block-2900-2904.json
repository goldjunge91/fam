      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Zucker, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Milch, Ei, geschmolzene Butter und Vanille in einer anderen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die flüssigen Zutaten zu den trockenen und rühre nur, bis alles gerade vermischt ist. Der Teig sollte leicht klumpig bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine Grillplatte oder beschichtete Pfanne bei mittlerer Hitze und fette sie leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße für jeden Pfannkuchen 1/4 cup Teig auf die Grillplatte und gare ihn, bis sich an der Oberfläche Blasen bilden und die Ränder fest aussehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende die Pfannkuchen und gare die andere Seite etwa 1-2 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie auf Teller und serviere sie sofort mit warmem Ahornsirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
