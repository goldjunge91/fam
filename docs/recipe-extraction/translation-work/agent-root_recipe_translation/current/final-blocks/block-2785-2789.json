      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermengen, dann Wasser und 1 Esslöffel Butter einkneten, bis ein glatter Teig entsteht; 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Währenddessen das Curry zubereiten: Öl in einer Pfanne erhitzen, gewürfeltes Hähnchen anbräunen und herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf gewürfelte Zwiebel und gehackten Knoblauch duftend dünsten, dann Currypulver hinzufügen und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackte Tomaten, gewürfelte Kartoffel, Hähnchen und Kokosmilch hinzufügen und 20 Minuten köcheln lassen, bis alles gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in 3 Kugeln teilen und jede auf einer bemehlten Fläche zu einem dünnen Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jedes Roti auf einer heißen Pfanne oder Grillplatte 1-2 Minuten pro Seite garen, bis sich leichte Blasen bilden; dabei mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Roti heiß als Beilage oder um das Curryhähnchen gewickelt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
