          "position": 0,
          "text": "Backe die Kartoffeln bei 400°F 35 Minuten, bis sie gerade weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl und dünste Zwiebel, Knoblauch und rote Paprika an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hackfleisch und Chorizo in die Pfanne und brate alles etwa 8 Minuten, bis das Schweinefleisch gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre geräuchertes Paprikapulver, Salz und Pfeffer ein. Nimm die Pfanne vom Herd und rühre den Manchego unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Halbiere die Kartoffeln und höhle sie aus. Bewahre die Schalen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Kartoffelschale mit der Fleischmischung und lege sie auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 375°F 12 Minuten, bis die Füllung durchgewärmt und die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie sofort und gib nach Wunsch zusätzlichen Käse darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
