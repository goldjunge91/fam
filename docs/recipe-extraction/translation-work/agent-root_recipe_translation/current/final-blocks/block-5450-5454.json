      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und schneide sie mit einem Hobel gleichmäßig in 1/8-inch dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 8 tbsp Butter bei niedriger Hitze und schöpfe die Milchbestandteile ab, um sie zu klären.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schichte die Kartoffelscheiben in eine gut gebutterte 9-inch Pfanne. Würze jede Lage mit Salz, Pfeffer und Thymian.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke die Schichten beim Aufbauen vorsichtig mit einem Pfannenwender an und verwende etwa die Hälfte der geklärten Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate sie bei mittlerer Hitze 15 Minuten, ohne umzurühren, bis sich unten eine goldbraune Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle die Pfanne in den auf 375°F vorgeheizten Ofen und backe die Kartoffeln 25-30 Minuten, bis sie innen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stürze die Pommes Anna auf eine Servierplatte, sodass die knusprige goldbraune Seite oben liegt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle sie mit der übrigen geschmolzenen Butter und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
