          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie bei 375°F 12-15 Minuten, bis sie goldbraun und durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue sie mit frischem Schnittlauch und serviere sie sofort.",
