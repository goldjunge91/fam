      "steps": [
        {
          "position": 0,
          "text": "Koche die ganzen Kartoffeln in Salzwasser 20-25 Minuten, bis sie gerade weich sind. Gieße sie ab und lasse sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Rinderhackfleisch mit der gewürfelten Zwiebel in einer Pfanne bei mittlerer bis hoher Hitze krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark, Worcestershiresauce und Rinderbrühe ein. Würze mit Salz und Pfeffer und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite eine Mehlschwitze zu, indem du Butter schmilzt und Mehl einrührst. Rühre sie unter die Fleischmischung, bis diese eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide von jeder abgekühlten Kartoffel oben einen Deckel ab und höhle sie aus, sodass eine dünne Schale bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Kartoffeln mit der Fleischmischung und setze die Deckel wieder auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die gefüllten Kartoffeln in eine Auflaufform, decke sie mit Folie ab und backe sie bei 375°F 20 Minuten, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere sie mit frischer Petersilie und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
