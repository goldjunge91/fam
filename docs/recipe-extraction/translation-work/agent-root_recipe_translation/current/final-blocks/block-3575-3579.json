      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Zucker in einer Schüssel. Gib warmes Wasser hinzu und knete einen weichen Teig. Decke ihn ab und lasse ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Teig in 4 gleich große Portionen und forme Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine gusseiserne oder beschichtete Pfanne bei mittelhoher Hitze und bestreiche sie mit Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ziehe eine Teigkugel vorsichtig auf der geölten Pfanne zu einem dünnen Rechteck und bestreiche sie dann mit Ghee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falte den Teig zu Schichten, indem du die Ränder zur Mitte führst und ein quadratisches Päckchen formst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den gefalteten Teig in die heiße Pfanne und brate ihn je Seite 2-3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Drücke ihn beim Garen vorsichtig mit einem Pfannenwender an, damit er gleichmäßig bräunt und knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Curry, Dhal oder Kondensmilch und Zucker servieren.",
