      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Wasser mit Ingwerscheiben und Salz zum Kochen und pochierte ein ganzes Hähnchen 30 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen heraus und stelle es beiseite. Bewahre 3 Tassen Pochierflüssigkeit als Brühe auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Ingwer und Knoblauch und brate beides in 2 Esslöffeln Öl, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Jasminreis hinzu und brate ihn 2 Minuten unter Rühren, bis er bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die zurückbehaltene Brühe hinzu, bringe sie zum Kochen, reduziere die Hitze und gare den Reis zugedeckt 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zupfe währenddessen das abgekühlte Hähnchen in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hacke Frühlingszwiebeln und Koriander und vermische Sojasauce und Sesamöl als Dip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lockere den Reis mit einer Gabel auf und gib ihn auf eine Servierplatte. Belege ihn mit Hähnchen, Frühlingszwiebeln und Koriander und serviere den Dip dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
