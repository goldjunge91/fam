      "steps": [
        {
          "position": 0,
          "text": "Säubere die Fischköpfe gründlich unter fließendem Wasser und schneide sie in handliche Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Zwiebeln, Knoblauch und Ingwer zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und brate Curryblätter 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Zwiebelpaste hinzu und brate sie 5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Kurkuma, rotes Chilipulver und Korianderpulver ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Fischköpfe hinzu und brate sie 3-4 Minuten, bis sie mit den Gewürzen bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Kokosmilch hinzu, bringe alles zum Köcheln und gare es ohne Deckel 20 Minuten, bis der Fisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz ab und serviere das Curry heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
