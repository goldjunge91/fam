      "steps": [
        {
          "position": 0,
          "text": "Säubere die Krabben und schneide sie in Viertel. Knacke die Scheren mit einem Holzhammer, damit sie sich leichter essen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Knoblauch, schneide rote Chilis und reibe Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne und brate Knoblauch, Chilis und Ingwer 1 Minute unter Rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Krabbenstücke hinzu und brate sie 3 Minuten unter Rühren, bis sie sich rötlich färben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatensauce, Sojasauce, Reisessig und Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und lasse alles 12-15 Minuten köcheln, bis die Krabben vollständig gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Speisestärke mit 2 Esslöffeln Wasser und rühre sie in die Sauce, damit sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gare alles 1 weitere Minute und serviere es heiß mit gedämpftem Reis und zusätzlicher Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
