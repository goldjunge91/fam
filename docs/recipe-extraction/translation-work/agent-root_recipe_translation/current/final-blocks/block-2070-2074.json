              "grams": 15,
              "quantity": 15,
              "unit": "g",
              "position": 5,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Gelatine und ¼ Tasse zimmerwarmes Wasser in einer kleinen Schüssel vermengen und etwa 5 Minuten stehen lassen, bis die Gelatine weich wird. Passionsfruchtmark, Zucker und Gelatinemischung in einem mittelgroßen Topf bei mittelhoher Hitze verrühren. Unter gelegentlichem Rühren erhitzen, bis alles gut vermengt und glatt ist (die Mischung darf nicht kochen). Vom Herd nehmen und vollständig abkühlen lassen. Kondensmilch einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Währenddessen Eiweiß in einer sauberen Rührschüssel mit einem Handmixer steif schlagen (die Spitzen sollten nicht herunterhängen und das Eiweiß sollte sich beim Neigen der Schüssel nicht bewegen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1/3 des Eiweißes unter die abgekühlte Passionsfruchtmischung rühren. Mit einem Teigschaber das übrige Eiweiß vorsichtig unterheben. Mousse gleichmäßig auf klare Glasschälchen verteilen und abdecken. Mindestens 2 Stunden im Kühlschrank gut durchkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gekühlt servieren. Nach Wunsch mit Minze garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
