      ],
      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 160C/140C Umluft/Gasstufe 3 erhitzen. Eine tiefe quadratische Kuchenform von 22cm/9in einfetten und mit Backpapier auslegen. Ei und Milch mit einer Gabel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sirup, Melasse, Zucker und Butter in einem großen Topf vorsichtig schmelzen, bis sich der Zucker aufgelöst hat. Vom Herd nehmen. Haferflocken, Mehl und Ingwer vermischen und in die Sirupmischung rühren, anschließend Ei und Milch einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung in die Form gießen und 50 Minuten bis 1 Stunde backen, bis der Kuchen fest und oben leicht knusprig ist. In der Form abkühlen lassen, dann in weiteres Backpapier und Folie wickeln und vor dem Essen, wenn möglich, 3–5 Tage aufbewahren. Je länger du ihn lagerst, desto weicher und klebriger wird er, bis zu 2 Wochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
