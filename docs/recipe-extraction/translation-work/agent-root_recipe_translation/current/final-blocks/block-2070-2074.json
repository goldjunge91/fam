            },
            {
              "key": "a674054d-26d4-5aa6-b16d-2030e0fe2faf",
              "ingredientName": "Flüssiges Eiweiß",
              "grams": 360,
              "quantity": 360,
              "unit": "g",
              "position": 4,
              "optional": false,
              "source_note": null
            },
            {
              "key": "4858152e-dfc6-53cc-8ffc-02ffbdc5d661",
