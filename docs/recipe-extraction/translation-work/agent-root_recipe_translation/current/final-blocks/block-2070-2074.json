      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in eine große Rührschüssel sieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mit einem Löffel das Eigelb durch ein feines Sieb in das Mehl drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rohes Ei dazugeben und gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter 1 Esslöffel auf einmal einarbeiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig auf eine bemehlte Fläche geben und kneten, bis er glatt und elastisch ist. In Wachspapier wickeln und mindestens 30 Minuten im Kühlschrank fest werden lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einer schweren Pfanne 2 Esslöffel Butter bei mittlerer Hitze schmelzen. Zwiebel und Steckrübe etwa 5 Minuten anbraten, bis die Zwiebel weich und glasig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zwiebeln, Steckrübe und Rindfleisch zweimal durch einen Fleischwolf drehen, falls vorhanden; andernfalls möglichst fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Übrige 4 Esslöffel Butter bei mittlerer Hitze schmelzen und die Fleischmischung dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bei niedriger Hitze unter gelegentlichem Rühren garen, bis die gesamte Flüssigkeit verdampft ist und die Mischung ihre Form hält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Vom Herd nehmen und abkühlen lassen, dann 1 Ei einrühren und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Backofen auf 350°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Teig auf einer leicht bemehlten Fläche zu einem Rechteck von 13x8 inch (1/8 inch dick) ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Füllung längs mittig auf dem Rechteck verteilen und an beiden Enden etwa einen inch frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Lange Seiten leicht mit kaltem Wasser bestreichen, dann eine Seite über die Füllung und die andere darüberklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
