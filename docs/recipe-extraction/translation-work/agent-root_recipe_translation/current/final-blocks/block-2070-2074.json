      "steps": [
        {
          "position": 0,
          "text": "Erdnüsse, Zucker und Wasser in einem großen Topf mit schwerem Boden vermengen. Zum Kochen bringen und etwa 10 Minuten kochen, bis der Sirup verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erdnüsse in einer Lage auf einem eingefetteten Backblech von 15x10x1 inch verteilen und mit Salz bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bei 300° 30–35 Minuten backen oder bis sie trocken und leicht gebräunt sind. Vollständig abkühlen lassen. In einem luftdichten Behälter aufbewahren.",
          "timerMinutes": null,
