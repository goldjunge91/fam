      "steps": [
        {
          "position": 0,
          "text": "Vermenge warmes Wasser, Hefe und eine Prise Zucker in einer Schüssel. Lass die Mischung 5 Minuten stehen, bis sie schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mehl und Salz in einer großen Schüssel, forme eine Mulde und gieße die Hefemischung und 2 Esslöffel Olivenöl hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge alles und knete den Teig 8 Minuten glatt und elastisch. Gib bei Bedarf Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Teig ab und lass ihn 20 Minuten gehen, bis er luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 8 Stücke und drücke jedes zu einem dünnen Oval von etwa 8 inches Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge Zaatar mit Zitronensaft und 1 Esslöffel Olivenöl und verteile die Mischung großzügig auf jedem Teigstück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Fladen auf einem auf 425°F vorgeheizten Backblech 12-15 Minuten, bis sie goldbraun und am Rand knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
