      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 Esslöffel Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze. Brate die Hähnchenbrust pro Seite 5-6 Minuten goldbraun an, nimm sie heraus und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Topf gewürfelte Zwiebel und gehackten Knoblauch im restlichen Öl etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Maftoul dazu und röste es unter Rühren 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe dazu und gib das Hähnchen mit Zimt und Piment zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lass es 15 Minuten köcheln, bis Maftoul weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste Pinienkerne in einer kleinen Pfanne bei mittlerer Hitze 2-3 Minuten leicht goldbraun und duftend an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer, bestreue das Gericht mit gerösteten Pinienkernen und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
