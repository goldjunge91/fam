      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Bohnen über Nacht in Wasser ein. Gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und brate Schweinefleischwürfel rundherum braun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Zwiebel, Karotten und Knoblauch im selben Topf etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinefleisch, Bohnen, Rinderbrühe und Lorbeerblatt zurück in den Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lass alles 60 Minuten köcheln, bis die Bohnen weich und das Schweinefleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Apfelessig für den typischen säuerlichen Geschmack ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere den Eintopf heiß in Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
