      "steps": [
        {
          "position": 0,
          "text": "Orangensaft, Limettensaft, gehackten Knoblauch, Kreuzkümmel, Chilipulver, Oregano und Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Legen Sie die Hähnchenschenkel in einen großen Beutel mit Reißverschluss und gießen Sie die Marinade darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Beutel verschließen und mindestens 30 Minuten oder bis zu 4 Stunden im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Grill auf mittlere bis hohe Hitze vorheizen oder den Ofen auf 425 °F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beim Grillen das Hähnchen 6 bis 8 Minuten pro Seite garen, bis die Innentemperatur 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Backen legen Sie das Hähnchen auf ein mit Backpapier ausgelegtes Backblech und backen es 25 bis 30 Minuten lang, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lassen Sie das Hähnchen 5 Minuten ruhen und zerkleinern Sie es dann mit zwei Gabeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tortillas erwärmen und mit zerkleinertem Hähnchenfleisch, Zwiebelwürfeln und Koriander füllen.",
