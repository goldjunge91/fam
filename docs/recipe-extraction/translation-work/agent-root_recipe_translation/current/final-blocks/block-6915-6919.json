      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie die Kutteln gründlich unter kaltem Wasser und entfernen Sie dabei alle Verunreinigungen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kutteln in mundgerechte Stücke schneiden und in einen Topf mit kaltem Wasser geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geviertelte Zwiebel, Knoblauch, Lorbeerblätter und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 1.5 bis 2 Stunden köcheln lassen, bis die Kutteln zart, aber noch leicht zäh sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kutteln abtropfen lassen und trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und die Kutteln etwa 5 bis 8 Minuten lang leicht knusprig und goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tortillas über einer Flamme oder in einer Pfanne erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tortillas mit frittierten Kutteln füllen und mit gewürfelten Zwiebeln, Koriander und Limettensaft belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
