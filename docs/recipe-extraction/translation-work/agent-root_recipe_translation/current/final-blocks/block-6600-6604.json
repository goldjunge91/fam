      "steps": [
        {
          "position": 0,
          "text": "Salz, Zucker, Pökelsalz, Pfeffer, Wacholder, Knoblauch und Rosmarin in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reiben Sie die Pökelmischung gründlich über alle Seiten des Schweinebauchs und massieren Sie sie in das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einen Glasbehälter geben, mit Plastikfolie abdecken und 3 Wochen im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wenden Sie das Fleisch in der ersten Woche täglich und in der restlichen Zeit jeden zweiten Tag.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spülen Sie das Fleisch nach 3 Wochen unter kaltem Wasser ab und tupfen Sie es mit Papiertüchern trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Fleisch bei 50–60 °F an einem kühlen, gut belüfteten Ort 2–4 Wochen zum Trocknen aufhängen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem scharfen Messer in dünne Scheiben schneiden und bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Papier wickeln und bis zu 3 Monate kühl und trocken lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
