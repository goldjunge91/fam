      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser mit Hefe vermischen und 5 Minuten schaumig rühren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Salz, Fenchelsamen und Kümmel in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hefemischung und Öl zum Mehl hinzufügen; 10 Minuten lang kneten, bis ein glatter, elastischer Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in eine geölte Schüssel geben, mit einem Handtuch abdecken und 1 Stunde gehen lassen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 8 gleich große Stücke teilen und jedes zu einem langen Oval formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die geformten Brote auf ein geöltes Backblech legen, mit einem Handtuch abdecken und 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heizen Sie den Ofen auf 425 °F vor und machen Sie Längsschlitze in die Oberseite jedes Laibs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "25–30 Minuten backen, bis es goldbraun mit knuspriger Kruste ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Vor dem Servieren mit Butter, Käse oder Wurstwaren auf einem Gitter abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
