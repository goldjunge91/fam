      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl bei mittlerer Hitze. Brate Zwiebel, Karotte und Sellerie 6 Minuten an, bis sie weich sind. Gib Knoblauch und italienische Gewürzmischung dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib abgespülte Linsen, gehackte Tomaten und Gemüsebrühe dazu. Lass die Suppe 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Pasta, gewürfelte Zucchini und gehackten Grünkohl dazu. Koche alles etwa 10 Minuten, bis die Pasta bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze kräftig. Die Suppe dickt beim Stehen ein. Gib beim Aufwärmen nach Bedarf mehr Brühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
