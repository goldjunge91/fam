      "steps": [
        {
          "position": 0,
          "text": "Brate die Zwiebel an, bis sie weich ist. Gib Knoblauch, Kreuzkümmel und Chilipulver dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib rohes Hähnchen, gehackte Tomaten, schwarze Bohnen, Mais und Brühe dazu. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze und lass die Suppe 20 Minuten köcheln, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Hähnchen heraus und zerteile es mit zwei Gabeln. Gib es zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmecke die Suppe ab. Serviere sie mit zerdrückten Tortillachips, Limette und Koriander.",
          "timerMinutes": null,
