      "steps": [
        {
          "position": 0,
          "text": "Koche die Eier 6½ Minuten, kühle sie in Eiswasser ab und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die zerbröselte Wurst in einem Topf bei mittlerer bis hoher Hitze an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Knoblauch und Ingwer im selben Topf 30 Sekunden an. Gib Hühnerbrühe dazu und bringe sie zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre das Miso abseits der Hitze in die Brühe ein. Die Miso-Brühe nicht kochen. Gib Sojasauce und Sesamöl dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Nudeln separat nach Packungsanleitung und wirf das Gewürzpäckchen weg. Die Brühe ist bereits kräftig gewürzt. Gieße die Nudeln ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte die Schüsseln an: Nudeln hineingeben, Brühe darüber schöpfen und mit Schweinefleisch, halbiertem Ei, zusammengefallenem Spinat und geschnittenen Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
