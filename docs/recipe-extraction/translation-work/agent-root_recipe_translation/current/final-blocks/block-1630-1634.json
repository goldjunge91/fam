      "steps": [
        {
          "position": 0,
          "text": "Lege das Steak 20 min ins Gefrierfach und schneide es quer zur Faser hauchdünn auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Zwiebel, Paprika und Pilze in Öl bei hoher Hitze 6 min an, bis sie weich und leicht gebräunt sind.",
