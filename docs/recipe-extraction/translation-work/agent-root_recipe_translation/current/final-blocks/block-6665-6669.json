      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz in einer Schüssel vermischen und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während des Knetens langsam Wasser hinzufügen, bis ein weicher, glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig abdecken und 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 8 gleich große Portionen teilen und jede zwischen Frischhaltefolie etwa 1/4 Zoll dick ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und jedes Teigstück vorsichtig 2-3 Minuten pro Seite braten, bis es aufgebläht und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittierte Jacks auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Honig beträufelt, mit Käse bestreut und mit warmem Bohnenmus als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
