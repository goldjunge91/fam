      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und Rindfleischwürfel portionsweise jeweils etwa 3–4 Minuten von allen Seiten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rindfleisch herausnehmen und beiseite stellen, dann Zwiebeln und Knoblauch im selben Topf 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 2 Minuten kochen lassen, dabei alle gebräunten Stücke vom Boden abkratzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Rindfleisch wieder in den Topf geben und mit Rinderbrühe aufgießen, dann ganze Habanero-Pfeffer dazugeben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren, abdecken und 45 Minuten köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln und Karotten hinzufügen und 25 Minuten weiter köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Habanero-Pfeffer entfernen, Koriander unterrühren und mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Weitere 5 Minuten köcheln lassen und heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
