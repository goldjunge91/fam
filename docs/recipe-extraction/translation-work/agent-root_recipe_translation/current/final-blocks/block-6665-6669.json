      "steps": [
        {
          "position": 0,
          "text": "Bringen Sie einen großen Topf Wasser zum Kochen und fügen Sie Salz, den ganzen Habanero-Pfeffer und eine geschnittene Zwiebel hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln und grüne Kochbanane ins kochende Wasser geben und 15 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maiskolben und Karotten in den Topf geben und 10 Minuten weitergaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen und die restlichen Zwiebelscheiben in den Topf geben und 5 Minuten kochen lassen, bis die Garnelen rosa werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Habanero-Pfeffer entfernen und Butter, Koriander und Limettensaft unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei Bedarf abtropfen lassen und heiß in Schüsseln mit der Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
