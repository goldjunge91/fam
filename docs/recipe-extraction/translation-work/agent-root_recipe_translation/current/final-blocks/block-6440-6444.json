      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweineschulter in 2-inch Stücke und die Wurst in 2-inch Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bring die Brühe in einem großen Topf zum Kochen. Gib Schweineschulter, Wurst, Zwiebel und Lorbeerblatt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass alles 45 Minuten köcheln, gib dann Karotten, Kartoffeln und gehackten Kohl dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Köchele weitere 30 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Buchweizenmehl, Weizenmehl und 2 Esslöffel geschmolzene Butter mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme die Mehlmischung in einem Mulltuch zu einer Kugel und binde das Tuch fest zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Knödelkugel in die Brühe und köchele sie 25 Minuten, bis sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Knödel heraus, schneide ihn in Scheiben und richte ihn mit Fleisch und Gemüse auf Tellern an. Übergieße alles mit Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
