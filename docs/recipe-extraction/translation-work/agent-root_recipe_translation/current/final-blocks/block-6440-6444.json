      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Eiweiß und Salz in einer sauberen Schüssel etwa 3 Minuten steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach den Zucker unter ständigem Rühren dazu, bis eine glänzende Baisermasse entsteht, die Spitzen hält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe Mandelmehl, Vanille und Mandelextrakt vorsichtig unter, bis alles gerade vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Setze mit einem Löffel kleine Häufchen mit etwa 1.5 inches Abstand auf das vorbereitete Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Kekse 20-25 Minuten, bis sie goldbraun und außen fest, innen aber noch leicht weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie 5 Minuten auf dem Blech abkühlen und lege sie anschließend zum vollständigen Auskühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
