      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 300°F vor und fette sechs Förmchen oder eine 6-cup Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Milch und Sahne in einem Topf, bis sie dampfen, und nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Eigelb und Zucker etwa 3 Minuten hell und dicklich auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerbrösele die Amaretti-Kekse und gib sie zur Eiermasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Siebe Kakaopulver dazu und verrühre alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die heiße Milch langsam unter ständigem Rühren zur Eiermasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Masse durch ein feines Sieb, um Eiklumpen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Rum und Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Fülle die Masse in die Förmchen und stelle sie in eine mit heißem Wasser gefüllte Bratform, sodass das Wasser bis zur halben Förmchenhöhe reicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Backe die Creme 25-30 Minuten, bis sie gestockt ist, in der Mitte aber noch leicht wackelt. Kühle sie vor dem Servieren mindestens 4 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
