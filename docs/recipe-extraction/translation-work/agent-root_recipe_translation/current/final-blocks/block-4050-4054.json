      "steps": [
        {
          "position": 0,
          "text": "Kutteln unter fließendem Wasser gründlich reinigen, Verunreinigungen abkratzen und dann in 1-inch große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kutteln 15 Minuten in einem Topf mit kochendem Salzwasser blanchieren, dann abgießen und abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebel sowie gehackten Knoblauch 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark, Kreuzkümmel und Paprika hinzufügen und 1 Minute anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Blanchierte Kutteln und Rinderbrühe hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze reduzieren, abdecken und 90 Minuten köcheln lassen, bis die Kutteln sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kichererbsen hinzufügen und weitere 15 Minuten ohne Deckel köcheln lassen, damit die Sauce etwas eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
