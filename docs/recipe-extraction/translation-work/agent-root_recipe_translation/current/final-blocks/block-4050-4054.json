      "steps": [
        {
          "position": 0,
          "text": "4 cups Wasser mit Salz in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl langsam unter ständigem Rühren ins kochende Wasser streuen, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze reduzieren und 15-20 Minuten häufig umrühren, bis die Mischung eindickt und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer separaten Pfanne erhitzen und Zwiebeln weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatenmark, getrockneten Fisch und Pfeffer zu den Zwiebeln geben und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fischmischung unter das Maismehl heben, bis alles gut vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf eine Servierplatte geben und heiß mit Suppe oder Eintopf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
