          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gelegentlich umrühren und mehr Brühe hinzufügen, falls die Mischung zu dick wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
