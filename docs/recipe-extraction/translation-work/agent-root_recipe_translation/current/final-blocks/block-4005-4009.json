          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Currypulver und Chilipulver hinzufügen und 1 Minute rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenwürfel hinzufügen und leicht anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch und Brühe zugießen, aufkochen und anschließend 25–30 Minuten köcheln lassen, bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Deckel vom Brotlaib abschneiden und das Innere aushöhlen. Das herausgenommene Brot aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das beiseitegelegte Brot in Stücke reißen und zum Curry geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten köcheln lassen, bis das Brot in der Sauce weich wird, dann Koriander einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die ausgehöhlten Brote mit dem Curry füllen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
