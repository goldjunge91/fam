      "steps": [
        {
          "position": 0,
          "text": "Grüne Bohnen in kochendem Salzwasser 3-4 Minuten blanchieren, bis sie bissfest sind. Anschließend in Eiswasser abschrecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Karotten und Sellerie in etwa 3-4 inches lange Stifte schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gurke in Stifte schneiden, Paprika in Streifen schneiden und Radieschen vierteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Blumenkohl in kleine Röschen teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das ganze Gemüse zusammen mit den Kirschtomaten auf einer großen Platte oder einem Brett anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mayonnaise, fein gehackten Knoblauch, Dijon-Senf und Zitronensaft zu einem einfachen Dip verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Gemüse mit dem Dip servieren.",
          "timerMinutes": null,
