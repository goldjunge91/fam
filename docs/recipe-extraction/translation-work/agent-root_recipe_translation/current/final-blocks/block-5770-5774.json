      "steps": [
        {
          "position": 0,
          "text": "Das Kalbfleisch mit Salz und Pfeffer würzen und in einer heißen Pfanne von allen Seiten anbraten, etwa 3 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weißwein und Rinderbrühe in die Pfanne geben, abdecken und 20-25 Minuten köcheln lassen, bis das Fleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Fleisch herausnehmen, vollständig abkühlen lassen und anschließend kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Thunfisch aus der Dose, Sardellen, Eigelb und Zitronensaft in einer Küchenmaschine pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bei laufender Maschine das Olivenöl langsam einfließen lassen, bis eine glatte, cremige Sauce entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Sauce mit etwas aufgehobener Garflüssigkeit verdünnen, bis die gewünschte Konsistenz erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das gekühlte Kalbfleisch dünn aufschneiden und auf einer Platte anrichten. Mit der Thunfischsauce übergießen und kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Kapern garnieren und gekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
