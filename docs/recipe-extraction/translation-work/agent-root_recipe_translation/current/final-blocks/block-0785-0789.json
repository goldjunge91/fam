      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor. Brate die Zwiebel 4 Minuten in Olivenöl an. Gib Knoblauch, Chilipulver, Kreuzkümmel und Paprikapulver dazu und röste alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Putenhack dazu und gare es 6–8 Minuten. Füge zerkleinerte Tomaten und Bohnen hinzu. Lass das Chili 10 Minuten köcheln und würze es kräftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite einen schnellen Maisbrotteig zu: Vermische Mehl, Mais, Zucker, Backpulver, Salz, Milch und Ei, bis alles gerade verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle das Chili in eine ofenfeste Form und verstreiche den Maisbrotteig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe das Gericht 20–22 Minuten, bis das Maisbrot goldbraun und durchgegart ist. Lass es vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
