      "steps": [
        {
          "position": 0,
          "text": "Verwende kalten Reis vom Vortag oder verteile frisch gegarten Reis auf einem Teller und trockne ihn kurz in der Mikrowelle. Taue die Edamame auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sesamöl in einem großen Wok oder einer Pfanne bei hoher Hitze. Gib Knoblauch und Ingwer dazu und brate sie 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Garnelen dazu und gare sie 1–2 Minuten, bis sie rosa sind. Schiebe sie an den Rand und rühre die Eier in der freien Fläche zu Rührei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Reis, Edamame, Erbsen und Sojasauce dazu. Brate alles unter Rühren 3–4 Minuten, bis der Reis leicht knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte den Reis an und streue geschnittene Frühlingszwiebeln darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
