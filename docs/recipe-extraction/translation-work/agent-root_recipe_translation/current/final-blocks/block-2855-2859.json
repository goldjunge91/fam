      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen ofenfesten Topf oder Schmortopf bei mittlerer bis hoher Hitze und bräune das Schweinefleisch insgesamt etwa 4 Minuten rasch auf beiden Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und stelle es beiseite. Gib gehackte Zwiebeln, Karotten und Sellerie in den Topf und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Fleisch zurück in den Topf und füge Brühe, Lorbeerblätter und schwarzen Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und stelle ihn 1-1.5 Stunden in den Ofen, bis das Schweinefleisch zart und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Schweinefleisch aus der Schmorflüssigkeit und halte es auf einer Servierplatte warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Seihe die Schmorflüssigkeit ab und drücke das Gemüse aus, um Flüssigkeit zu gewinnen. Entsorge die festen Bestandteile.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Senf in die Schmorflüssigkeit ein und serviere sie als Sauce zum Schweinefleisch mit Sauerkraut und Salzkartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
