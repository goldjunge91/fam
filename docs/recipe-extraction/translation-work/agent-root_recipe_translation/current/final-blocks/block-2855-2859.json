      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen schweren Topf bei mittlerer bis hoher Hitze und bräune das Rindfleisch portionsweise ohne den Topf zu überfüllen, insgesamt etwa 12 Minuten. Würze es mit Salz und Pfeffer und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze auf mittel und gib gewürfelte Zwiebeln in den Topf. Gare sie etwa 12 Minuten, bis sie karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib zerdrückten Knoblauch hinzu und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Paprikapulver und Tomatenmark ein und gare alles unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Rindfleisch zurück in den Topf, füge Rinderbrühe und Kümmel hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 1.5-2 Stunden köcheln, bis das Rindfleisch sehr zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und würze es bei Bedarf mit Salz, Pfeffer oder Paprikapulver nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gulasch heiß mit Eiernudeln, Spätzle oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
