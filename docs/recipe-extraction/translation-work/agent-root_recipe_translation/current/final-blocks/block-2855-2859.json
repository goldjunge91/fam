      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittlerer bis hoher Hitze und bräune das Rinderhackfleisch 5 Minuten. Zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel und Knoblauch hinzu und dünste alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sauerkraut, frischen Kohl, Rinderbrühe, Kümmel und Lorbeerblatt hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, reduziere die Hitze und gare den Eintopf zugedeckt 45 Minuten. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Eintopf heiß mit knusprigem Brot oder zu Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
