      "steps": [
        {
          "position": 0,
          "text": "Bereite Nudelteig aus 2.5 Tassen Mehl, 2 Eiern und 0.5 Tasse Wasser zu. Knete ihn 10 Minuten glatt und lasse ihn dann 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel 3 Minuten in Butter, gib Spinat hinzu und gare ihn, bis er zusammenfällt. Lasse alles vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Schweinehackfleisch, die gegarte Spinatmischung, Semmelbrösel, 1 Ei, Salz, Pfeffer und Muskatnuss in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig zwischen zwei Bögen Backpapier sehr dünn aus, bis er etwa 1/16 Zoll dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide den Teig in 3 Zoll große Quadrate und gib je 1 EL Füllung auf jedes Quadrat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe die Ecken zur Mitte und drücke die Ränder fest zusammen, sodass kleine Päckchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Maultaschen 4-5 Minuten in Salzwasser, bis sie an die Oberfläche steigen, und lasse sie dann noch 1 Minute köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brate die gegarten Maultaschen in Butter goldbraun oder serviere sie in warmer Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
