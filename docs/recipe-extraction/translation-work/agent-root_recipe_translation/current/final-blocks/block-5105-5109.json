      "steps": [
        {
          "position": 0,
          "text": "Spüle die Quinoa unter kaltem Wasser ab und gib sie mit Hühnerbrühe in einen Topf. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze, decke den Topf ab und lass die Quinoa 15 Minuten köcheln, bis die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe die Hähnchenbrüste trocken und würze beide Seiten mit Knoblauchpulver, Paprikapulver, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche einen Grill oder eine Grillpfanne mit Olivenöl und erhitze ihn bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Hähnchenbrüste pro Seite 6-7 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen vom Grill und beträufle es mit Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lockere die gekochte Quinoa mit einer Gabel auf und verteile sie zusammen mit dem Hähnchen auf Tellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
