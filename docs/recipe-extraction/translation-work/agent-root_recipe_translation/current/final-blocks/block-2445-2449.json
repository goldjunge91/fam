      "steps": [
        {
          "position": 0,
          "text": "Basmatireis 30 Minuten in Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen in 2-inch-Stücke schneiden und in Joghurt, 2 EL gehacktem Knoblauch, 0.5 EL Ingwer und 0.5 TL Salz 30 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebeln sehr dünn schneiden und in 3 EL Ghee dunkelgolden braten. Die Hälfte als Garnitur beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Übrige 3 EL Ghee erhitzen und Hähnchen mit den restlichen Zwiebeln braten, bis es zu 75% gar ist, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gesalzenes Wasser in einem großen Topf mit Lorbeerblättern, Zimt und Kardamom zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eingeweichten und abgetropften Reis ins kochende Wasser geben und kochen, bis er zu 70% gar ist, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den halbgegarten Reis über das Hähnchen schichten, dann beiseitegestellte Röstzwiebeln, Garam Masala, Koriander und Minze dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Topf mit Folie und einem gut schließenden Deckel abdecken und bei niedriger Hitze 30 Minuten garen, bis der Reis vollständig weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "5 Minuten ruhen lassen, dann Biryani vorsichtig mit einer Gabel auflockern und vermengen. Servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
