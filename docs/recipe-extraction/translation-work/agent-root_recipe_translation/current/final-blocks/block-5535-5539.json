      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen. Blanchiere Hähnchenschenkel, Schweineschulter und Rinderhaxe 5 Minuten, gieße sie ab und spüle sie kalt ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das blanchierte Fleisch mit frischer Hühnerbrühe, halbierter Zwiebel und Thymianzweigen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe die Brühe leicht zum Kochen und schöpfe den Schaum ab. Reduziere die Hitze und lasse das Fleisch 1.5 Stunden köcheln, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Chorizo auf, gib sie in die Brühe und lasse sie 10 Minuten mitkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide den Kohl in Spalten, hacke Karotten, schäle und viertle Kartoffeln und würfle die Rüben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Gemüse in den Topf und lasse es 30-40 Minuten köcheln, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löse das Fleisch nach Wunsch von den Knochen und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere Fleisch und Gemüse in tiefen Schüsseln mit Brühe. Reiche knuspriges Brot dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
