      "steps": [
        {
          "position": 0,
          "text": "Erhitze einen großen Topf bei mittlerer bis hoher Hitze und bräune die Rinderschulter rundum kräftig an, insgesamt etwa 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Entferne Stiele und Kerne von Guajillo- und Ancho-Chilis. Weiche sie 10 Minuten in heißem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die weichen Chilis mit Knoblauch, Zwiebel, Tomatenmark, Essig, Oregano und Kreuzkümmel glatt. Seihe die Sauce durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das angebratene Rindfleisch zurück in den Topf und gieße Chilisauce und Rinderbrühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze auf niedrig und lasse das Fleisch zugedeckt 2.5 Stunden köcheln, bis es sich leicht zupfen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zupfe das Rindfleisch mit zwei Gabeln auseinander und gib es zurück in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Birria mit Brühe in Schüsseln, bestreue sie mit gewürfelter Zwiebel und Koriander und reiche warme Tortillas zum Dippen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Für Birria-Tacos tauche Tortillas in die heiße Brühe, fülle sie mit gezupftem Fleisch und brate sie in der Pfanne knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
