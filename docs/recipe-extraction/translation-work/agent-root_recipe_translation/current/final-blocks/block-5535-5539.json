      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Schmortopf bei mittlerer bis hoher Hitze. Bräune Schweinerippchen und Wurst rundum etwa 12 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Fleisch heraus und stelle es beiseite. Dünste gewürfelte Zwiebel, Karotten und Sellerie im selben Topf etwa 8 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und Tomatenmark dazu und rühre 2 Minuten ständig, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lösche den Topf mit Weißwein ab, löse die angebratenen Reste vom Boden und lasse die Flüssigkeit auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Fleisch zurück in den Topf. Füge Tomaten aus der Dose samt Saft und Rinderbrühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere die Hitze auf niedrig und lasse es zugedeckt 1 Stunde köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hacke den Kohl grob, rühre ihn unter und lasse den Eintopf ohne Deckel weitere 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere heiß in Schüsseln mit knusprigem Brot zum Auftunken der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
