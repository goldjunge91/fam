      "steps": [
        {
          "position": 0,
          "text": "Schneide das Baguette schräg in 1/2 inch dicke Scheiben und röste sie leicht goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Butter in einer Pfanne bei mittlerer bis hoher Hitze und dünste Schalotten und Knoblauch 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geschnittene Pilze dazu und brate sie unter gelegentlichem Rühren 5-6 Minuten, bis sie Flüssigkeit abgeben und leicht bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittlere Stufe. Gib Sahne, Dijon-Senf und Thymian dazu und lasse alles 2-3 Minuten köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche jede geröstete Brotscheibe mit der übrigen 1 Esslöffel Butter. Gib die Pilzcremesauce darauf und garniere mit frischem Schnittlauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
