      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf oder einer Tajine bei mittlerer bis hoher Hitze. Bräune die Lammwürfel portionsweise rundum etwa 10 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Lamm heraus und stelle es beiseite. Dünste gewürfelte Zwiebeln und Knoblauch im selben Topf etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gehackten Ingwer, Kreuzkümmel, Zimt und Kurkuma ein und brate alles 1 Minute an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Lamm zurück in den Topf und füge Hühnerbrühe hinzu. Bringe alles zum Kochen und schöpfe den Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf ab und lasse das Lamm 1.5 Stunden köcheln, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib getrocknete Aprikosen, Datteln und Honig dazu und lasse alles ohne Deckel weitere 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und passe Salz und Pfeffer nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Tajine mit Couscous oder knusprigem Brot. Garniere nach Wunsch mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
