      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Topf mit schwerem Boden und brate Zwiebelscheiben goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Ingwer und grüne Chilis hinzu und rühre 1 Minute, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Kurkuma und gehackte Tomaten hinzu und gare sie weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wasser dazu, bringe alles zum Kochen, reduziere die Hitze und lasse es 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tamarindenmark und Salz nach Geschmack hinzu und rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Fischfilets vorsichtig in die Brühe und lasse sie 10-12 Minuten köcheln, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere heiß mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
