      "steps": [
        {
          "position": 0,
          "text": "Vermische Weizenmehl, Vollkornmehl und Salz in einer Schüssel. Gib Öl hinzu und knete mit Wasser einen weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Jaggery und Kokosraspeln in einer Schüssel für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 6 Portionen, rolle jede dünn aus und gib Füllung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Ränder zur Mitte ein und verschließe sie zu einem Täschchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Milch in einer Pfanne zum Kochen und lege die Täschchen vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche sie 8-10 Minuten, bis sie an die Oberfläche steigen und der Teig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm in der gesüßten Milch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
