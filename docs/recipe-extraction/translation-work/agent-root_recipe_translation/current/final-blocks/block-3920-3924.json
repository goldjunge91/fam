      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch in 1.5 Zoll Würfel schneiden und mit Papiertüchern trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und das Rindfleisch portionsweise anbraten, etwa 3 Minuten pro Seite, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im gleichen Topf gewürfelte Zwiebeln und gehackten Knoblauch anbraten, bis sie weich sind, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark und Paprikapulver einrühren und 2 Minuten kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das Rindfleisch wieder in den Topf und fügen Sie Rotwein, Rinderbrühe und Lorbeerblätter hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren, abdecken und 60-75 Minuten köcheln lassen, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit knusprigem Brot oder Polenta servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
