      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen, schweren Topf bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfeltes Fleisch von allen Seiten anbraten, etwa 5-7 Minuten; herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel- und Karottenscheiben im selben Topf 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch und Kreuzkümmel einrühren und 1 Minuten kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das Fleisch wieder in den Topf und fügen Sie Reis hinzu. umrühren, um es mit Öl zu überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Brühe aufgießen, Lorbeerblatt, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren, abdecken und 25-30 Minuten köcheln lassen, bis der Reis weich ist und die Flüssigkeit aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zugedeckt 5 Minuten stehen lassen, dann mit einer Gabel auflockern und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
