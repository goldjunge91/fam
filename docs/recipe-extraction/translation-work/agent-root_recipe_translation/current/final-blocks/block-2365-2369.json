      "steps": [
        {
          "position": 0,
          "text": "Sushireis nach Packungsanleitung kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reisessig, Zucker und Salz vermischen und dann unter den warmen gekochten Reis heben, bis alles vermengt ist.",
