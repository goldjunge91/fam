      "steps": [
        {
          "position": 0,
          "text": "Joghurt, gehackten Knoblauch, geriebenen Ingwer, Garam Masala, Kurkuma, Paprika, Zitronensaft und Salz zu einer glatten Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lammfleischwürfel gründlich mit der Joghurtmarinade bestreichen und mindestens 30 Minuten, am besten über Nacht, in den Kühlschrank stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 425 °F vor und legen Sie ein Backblech mit Folie aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mariniertes Lammfleisch auf Holzspieße stecken (30 Minuten in Wasser einweichen) und auf das vorbereitete Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spieße leicht mit Pflanzenöl bestreichen und 18–22 Minuten backen, bis das Lamm gar ist und an den Rändern leicht verkohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alternativ können Sie die Spieße bei mittlerer bis hoher Hitze 12–15 Minuten lang grillen und dabei gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Zitronenschnitzen und geschnittenen Zwiebeln servieren.",
