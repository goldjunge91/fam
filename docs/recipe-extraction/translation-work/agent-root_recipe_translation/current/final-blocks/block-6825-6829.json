      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie die Schweinehaut mit etwas Fett in 1 x 1 cm große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringen Sie 6 Tassen Wasser mit 1 Teelöffel Salz und zerdrückten Knoblauchzehen zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinehautstücke hinzufügen und 20–25 Minuten kochen lassen, bis die Haut weich wird und das Fett leicht austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Schweinehaut vollständig abtropfen lassen und zum Trocknen 10 Minuten auf Papiertüchern ausbreiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einer tiefen Pfanne oder einem Topf auf 375 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie die getrockneten Schweinehautstücke vorsichtig portionsweise hinzu und braten Sie sie jeweils 3–4 Minuten lang unter ständigem Rühren, bis sie aufgehen und goldbraun werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Schaumlöffel herausnehmen und auf frischen Papiertüchern abtropfen lassen, dann sofort heiß mit dem restlichen Salz und schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
