      "steps": [
        {
          "position": 0,
          "text": "Holzspieße vor dem Grillen mindestens 30 Minuten in Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel, Minze, Petersilie und Knoblauch mit einer Küchenmaschine oder einem Messer fein zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lammhackfleisch mit gehackter Kräutermischung, Piment, Kreuzkümmel, Salz und schwarzem Pfeffer in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vorsichtig mit den Händen vermischen, bis alles gut vermischt ist, dabei darauf achten, dass das Fleisch nicht zu stark beansprucht wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teilen Sie die Mischung in 8 gleiche Portionen und formen Sie jede Portion fest auf einem eingeweichten Spieß, sodass eine lange, dünne Form entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kofta mit Olivenöl bestreichen und bei mittlerer bis hoher Hitze auf einen vorgeheizten Grill legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "10–12 Minuten grillen, dabei alle 2–3 Minuten wenden, bis es durchgegart ist und leicht verkohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vom Grill nehmen und sofort mit Zitronenspalten und Fladenbrot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
