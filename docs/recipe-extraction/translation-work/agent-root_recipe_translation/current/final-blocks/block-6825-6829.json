      "steps": [
        {
          "position": 0,
          "text": "Gehackte Zwiebeln und Knoblauch in einer Küchenmaschine zerkleinern, bis sie sehr fein gehackt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lammhackfleisch, Rinderhackfleisch, gehackte Zwiebelmischung, Oregano, Paprika, Kreuzkümmel, Salz und schwarzen Pfeffer in einer Schüssel vermengen und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mischung auf einem mit Folie ausgelegten Blech zu einem Laib formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bei 400 °F 25–30 Minuten backen, bis die Innentemperatur 160 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aus dem Ofen nehmen und 5 Minuten ruhen lassen, dann mit einem scharfen Messer in dünne Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fladenbrot im Ofen oder über der Flamme 1-2 Minuten lang erwärmen, bis es geschmeidig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füllen Sie jedes Pita mit geschnittenem Gyros-Fleisch, gewürfelten Tomaten, geschnittenen roten Zwiebeln und einem großzügigen Klecks Tzatziki-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
