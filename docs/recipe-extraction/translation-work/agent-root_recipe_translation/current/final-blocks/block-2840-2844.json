          "images": []
        },
        {
          "position": 5,
          "text": "Lasse den Salat 10 Minuten ziehen, damit er Geschmack aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe zerbröselten Speck und frischen Dill unter und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
