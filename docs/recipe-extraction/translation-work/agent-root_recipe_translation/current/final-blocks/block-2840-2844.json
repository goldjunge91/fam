      "steps": [
        {
          "position": 0,
          "text": "Erwärme Milch auf 110°F, vermische sie dann mit Hefe und Zucker und lasse alles 5 Minuten stehen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Salz, gib die Hefemischung und geschmolzene Butter dazu und knete 8 Minuten, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig in einer gefetteten Schüssel 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 Stücke, rolle jedes zu einem 20-inch langen Strang und forme eine Brezel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe 2 quarts Wasser mit Natron zum Kochen und tauche jede Brezel kurz 30 Sekunden hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Brezeln auf ein mit Backpapier ausgelegtes Blech, bestreiche sie mit verquirltem Eigelb und bestreue sie mit grobem Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 425°F 15-18 Minuten tief goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vor dem Servieren 10 Minuten auf einem Gitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
