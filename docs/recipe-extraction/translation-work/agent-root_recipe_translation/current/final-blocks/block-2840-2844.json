          "position": 0,
          "text": "Schäle und reibe Kartoffeln und Zwiebel. Drücke dann mit einem sauberen Küchentuch überschüssige Flüssigkeit aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die geriebene Masse mit Eiern, Mehl, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 0.25 cup Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib portionsweise Löffel der Kartoffelmischung hinein, drücke sie zu 3-inch großen Puffern flach und brate sie 3-4 Minuten pro Seite knusprig und goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Puffer auf Küchenpapier abtropfen und gib zwischen den Portionen bei Bedarf weiteres Öl hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Sauerkraut in einem separaten Topf 10 Minuten bei mittlerer Hitze mit Kümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Kartoffelpuffer mit warmem Sauerkraut und einem Klecks saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
