      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebel fein und vermische sie mit Schweine- und Rinderhackfleisch, Semmelbröseln, Ei, Worcestershiresauce, Salz und Pfeffer, bis alles gerade vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme 12 ovale Frikadellen von etwa 2 inches Länge und 0.5 inches Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Frikadellen 3-4 Minuten pro Seite goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege sie auf einen mit Küchenpapier ausgelegten Teller, damit überschüssiges Öl abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie warm mit Senf, Gewürzgurken und frischem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
