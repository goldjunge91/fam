      "steps": [
        {
          "position": 0,
          "text": "Vermische Hefe, Zucker und warmes Wasser und lasse alles 5 Minuten stehen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Salz, gib dann Hefemischung und 2 tablespoons Olivenöl dazu und verrühre alles zu einem klebrigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig auf einer bemehlten Fläche 8 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege ihn in eine geölte Schüssel, decke sie mit einem Tuch ab und lasse den Teig 45 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme den Teig oval und schneide mit einem Messer diagonale Schlitze in die Oberfläche, ohne ihn ganz zu durchtrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den Teig auf ein geöltes Backblech, bestreiche ihn mit dem restlichen Olivenöl, bestreue ihn mit Rosmarin und Meersalz und lasse ihn 15 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe ihn bei 400°F 20-25 Minuten goldbraun und hohl klingend, wenn du darauf klopfst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse das Brot vor dem Servieren 10 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
