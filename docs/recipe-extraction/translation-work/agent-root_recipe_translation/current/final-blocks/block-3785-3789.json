      "steps": [
        {
          "position": 0,
          "text": "Schneide Zwiebeln dünn und gare sie in Butter bei mittlerer Hitze 30 Minuten unter gelegentlichem Rühren, bis sie tief karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Wein dazu und löse die Röstspuren vom Topfboden. Gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Brühe, Lorbeerblatt und Thymian dazu und lasse die Suppe 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze mit Salz und Pfeffer und entferne Lorbeerblatt und Thymianzweige.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Toaste Baguettescheiben im auf 400°F vorgeheizten Ofen 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe Suppe in ofenfeste Schalen, lege je eine Toastscheibe darauf und bedecke sie großzügig mit Gruyère.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Schalen bei 400°F 8 Minuten, bis der Käse geschmolzen und blubbernd ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sofort und sei vorsichtig, da die Schalen sehr heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
