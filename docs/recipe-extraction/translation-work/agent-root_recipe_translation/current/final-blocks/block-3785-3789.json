      "steps": [
        {
          "position": 0,
          "text": "Zerdrücke Knoblauchzehen mit Salz in einem Mörser oder einer Schüssel zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Eigelb zum Knoblauch und verquirle es. Träufle dann unter ständigem Rühren zunächst tropfenweise, dann in dünnem Strahl Olivenöl dazu, bis die Masse emulgiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Zitronensaft ein und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche Kartoffeln, Karotten und grüne Bohnen getrennt etwa 15 Minuten, bis sie gerade zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pochiere Kabeljaufilets sanft 8 Minuten in köchelndem Wasser, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Gemüse und Fisch auf einer Servierplatte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere Aïoli zum Dippen und reiche Brot dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
