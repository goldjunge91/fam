      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser, Salz und Olivenöl in einem Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Kichererbsenmehl nach und nach ins kochende Wasser und rühre ständig, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze und koche alles 15-20 Minuten unter häufigem Rühren mit einem Holzlöffel, bis die Masse sehr dick ist und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung in eine geölte 8x8 inch große Form und lasse sie auf Raumtemperatur abkühlen. Stelle sie dann 2 Stunden kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide sie in dicke Pommes oder Rechtecke und bestäube sie mit Pfeffer und gehacktem Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer Pfanne auf 350°F und brate Panisse-Stücke 2 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
