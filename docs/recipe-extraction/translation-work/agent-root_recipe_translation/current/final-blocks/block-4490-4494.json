      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und bräune die Lammstücke von allen Seiten, insgesamt etwa 8 Minuten. Nimm sie dann heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Topf die gewürfelten Zwiebeln und den gehackten Knoblauch etwa 4 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lösche den Topf mit Weißwein ab, kratze die Röststoffe vom Boden und lass den Wein 2 Minuten einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Lamm zurück in den Topf, füge Rinderbrühe, Lorbeerblätter und Rosmarin hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und gare alles bei niedriger Hitze 60 Minuten, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gewürfelten Kartoffeln in den Topf und gare alles zugedeckt weitere 30 Minuten, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer nach Geschmack und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
