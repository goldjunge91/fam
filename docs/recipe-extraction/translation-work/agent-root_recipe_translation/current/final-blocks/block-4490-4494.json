      "steps": [
        {
          "position": 0,
          "text": "Die Milch auf 90°F erhitzen, dann Lipasepulver und Starterkultur einstreuen, 1 Minute rühren und 10 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Lab in kaltem Wasser verdünnen und zur Milch geben, 1 Minute vorsichtig rühren und anschließend 30 Minuten ungestört stehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Käsebruch mit einem Käsemesser in reiskorngroße Stücke schneiden, dabei Schnitte in drei Richtungen machen, und 5 Minuten setzen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Käsebruch langsam auf 102°F erhitzen, dies dauert 30 Minuten. Dabei gelegentlich umrühren und anschließend 5 Minuten auf dieser Temperatur halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein Sieb mit Käsetuch auslegen, Käsebruch und Molke hineingießen, dann die Ecken des Tuchs zusammennehmen und 15 Minuten zum Abtropfen aufhängen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Käsebruchmasse in eine mit Käsetuch ausgelegte Form geben und 12 Stunden unter zunehmendem Gewicht pressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Käse aus der Form nehmen, mit Salz einreiben und auf einem Regal bei 60°F und 85% Luftfeuchtigkeit 3-4 Wochen an der Luft trocknen lassen, dabei täglich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Käse in ein Tuch wickeln und in einem kühlen Keller bei 55°F 3-6 Monate reifen lassen, dabei gelegentlich wenden, bis er verzehrfertig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
