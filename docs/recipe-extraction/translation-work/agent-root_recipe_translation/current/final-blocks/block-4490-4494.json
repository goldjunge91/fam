      "steps": [
        {
          "position": 0,
          "text": "Erhitze die Milch auf 90°F, streue die Starterkultur hinein, rühre gut um und lass sie 30 Minuten reifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verdünne das Lab in kaltem Wasser, gib es unter langsamem Rühren 1 Minute lang zur Milch und lass sie anschließend 40 Minuten ungestört stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Bruch mit einem Messer mit langer Klinge in kleine Stücke von der Größe einer Erbse und lass ihn anschließend 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze den Bruch langsam auf 104°F über 40 Minuten, rühre dabei sanft und ständig um und halte die Temperatur anschließend 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ein Sieb mit Käsetuch aus, seihe den Bruch ab und hänge das Tuch anschließend 12 Stunden zum Abtropfen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle den abgetropften Bruch in eine mit Tuch ausgelegte Form und presse ihn 16 Stunden unter Gewicht, wobei du ihn nach der Hälfte der Zeit einmal wendest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm ihn aus der Form, salze die Oberfläche und trockne ihn bei 55°F 2 Wochen lang an der Luft, dabei täglich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Käse in einer kühlen Höhle bei 50-55°F 6-12 Monate reifen und wende ihn wöchentlich, bis sich der gewünschte Geschmack entwickelt und die Rinde hart wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
