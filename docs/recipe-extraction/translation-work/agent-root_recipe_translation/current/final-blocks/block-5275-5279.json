      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in dünne Pommes und weiche sie mindestens 30 Minuten in kaltem Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem schweren Topf auf 325°F und frittiere die Pommes 4-5 Minuten, bis sie gerade gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhöhe die Hitze auf 375°F und frittiere sie erneut 2-3 Minuten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Pommes auf Küchenpapier gut abtropfen und würze sie sofort mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die heißen Pommes in einer Schüssel mit Trüffelöl, gehacktem Knoblauch und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib sie in eine Servierschüssel und bestreue sie großzügig mit geriebenem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere sie nach Wunsch mit frisch gehackter Petersilie und serviere sie sofort heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
