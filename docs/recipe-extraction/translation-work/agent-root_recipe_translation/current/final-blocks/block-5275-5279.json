      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in dünne Pommes, weiche sie 30 Minuten in kaltem Wasser ein und tupfe sie dann trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer gusseisernen Pfanne bei hoher Hitze, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme zwei dünne Rindfleischbratlinge und lege sie in die Pfanne. Drücke sie sofort mit einem Pfannenwender 30 Sekunden flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate sie 2 Minuten, ohne sie zu bewegen. Wende sie, gib Käse darauf und brate sie 1 weitere Minute, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Kartoffeln portionsweise 8-10 Minuten goldbraun und knusprig und salze sie sofort danach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Brötchen leicht an und belege sie mit Salat, Tomate und den Bratlingen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Burger mit den Pommes als Beilage und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
