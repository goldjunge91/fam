    {
      "externalId": "waivy:drink-espresso-martini",
      "slug": "drink-espresso-martini",
      "title": "Espresso Martini",
      "instructions": "Der elegante Muntermacher mit anschließendem Schlummer: Wodka, Kaffeelikör und frischer Espresso werden eiskalt geschüttelt und mit einer typischen Crema gekrönt. Herb-süß, kräftig und samtig.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 5,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Bereite einfachen Sirup aus gleichen Teilen Zucker und Wasser selbst zu; 30s in der Mikrowelle erhitzen und umrühren. Das kostet nur wenige Cent pro Drink.",
        "Verwende starken Filterkaffee oder Cold Brew, falls du keine Espressomaschine hast. Das ist günstiger und schmeckt ebenfalls gut.",
        "Wodka aus dem mittleren Preissegment genügt; mit Kaffeelikör und Espresso geschüttelt erkennt niemand den Unterschied."
      ],
      "substitutions": [
        {
          "forIngredientId": "espresso",
          "swap": "1 oz strong kalt brew oder double-strength instant coffee",
          "savings": "Spart gegenüber einem Shot aus dem Café ~$0.50 pro Getränk und benötigt keine Maschine."
        },
        {
          "forIngredientId": "simple-syrup",
          "swap": "ein klein drizzle von agave-syrup oder ein pinch von Zucker dissolved in der warm espresso",
          "savings": "Verwendet Grundzutaten aus dem Vorrat und spart den Kauf einer Flasche"
        },
        {
          "forIngredientId": "coffee-liqueur",
          "swap": "hausgemacht coffee syrup mit ein splash mehr vodka",
          "savings": "Spart gegenüber gekauftem Kahlua ~$1.50 pro Getränk."
