      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser, Honig und Hefe in einer Schüssel vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Salz und Öl untermischen, bis ein steifer Teig entsteht, dann 8–10 Minuten von Hand kneten, bis ein glatter und elastischer Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in 8 gleich große Stücke teilen, jedes zu einer Kugel rollen, in die Mitte ein Loch drücken und zu einem Bagel mit einer 2 Zoll großen Öffnung formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bagels auf ein mit Backpapier ausgelegtes Backblech legen, mit einem feuchten Tuch abdecken und 30 Minuten bei Zimmertemperatur gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Ofen auf 425 °F vorheizen und einen großen Topf Wasser mit 2 Esslöffeln Honig zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bagels 1-2 Minuten pro Seite kochen, bis sie schwimmen und wieder aufgehen, dann mit einem Schaumlöffel herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Bagels auf ein Backblech legen, mit Wasser bestreichen und mit Sesam oder Mohn bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "25–30 Minuten backen, bis es außen goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
