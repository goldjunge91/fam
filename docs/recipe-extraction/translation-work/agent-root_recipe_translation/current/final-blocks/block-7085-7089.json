      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in Pommes schneiden und 30 Minuten in kaltem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch mit Zwiebelwürfeln in einer Pfanne bei mittlerer bis hoher Hitze anbraten und dabei das Fleisch auseinanderbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hot Dogs in Scheiben schneiden, zum Rindfleisch geben und weitere 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einem separaten Topf Rinderbrühe erhitzen und die Fleischmischung einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Maisstärke mit Wasser vermischen und etwa 2 Minuten lang in die Soße einrühren, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittieröl auf 325 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kartoffeln abgießen, trocken tupfen und portionsweise goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiße Pommes Frites in einen Servierbehälter schichten, mit Käsequark und Fleisch belegen und alles mit heißer Soße übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
