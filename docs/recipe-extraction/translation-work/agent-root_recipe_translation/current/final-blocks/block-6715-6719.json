      "steps": [
        {
          "position": 0,
          "text": "Verquirle Zuckersirup, alkalisches Wasser und Pflanzenöl, bis alles gut verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Mondkuchen-Mehlmischung zu den feuchten Zutaten und verrühre alles zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wickle den Teig in Frischhaltefolie und lasse ihn 2 Stunden bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 Portionen und die rote Bohnenpaste in 8 gleich große Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke eine Teigportion flach, lege eine Portion Bohnenpaste und ein Eigelb in die Mitte. Ziehe die Teigränder vorsichtig hoch und um die Füllung, um sie zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die gefüllte Teigkugel in eine Mondkuchenform und drücke sie fest, um ein Muster einzuprägen. Löse den Kuchen aus der Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Mondkuchen auf ein Backblech und backe sie bei 350°F 15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vollständig abkühlen und bewahre sie vor dem Servieren 3-5 Tage luftdicht auf, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
