      "steps": [
        {
          "position": 0,
          "text": "Schlage weiche Butter und Zucker etwa 3 Minuten hell und luftig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Ei und Vanilleextrakt ein, bis alles gut verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl, Backpulver und Salz in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die trockenen Zutaten unter die feuchten, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig 0.25 Zoll dick aus und stich mit einem Ausstecher Kreise von 3 Zoll aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1 Teelöffel Mohnfüllung in die Mitte jedes Kreises und klappe drei Ränder zu einem Dreieck hoch. Drücke die Ecken zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Plätzchen auf ein mit Backpapier ausgelegtes Blech und backe sie bei 375°F 12-15 Minuten, bis die Ränder leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
