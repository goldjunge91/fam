      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz, Zucker und Hefe in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib warmes Wasser und geschmolzene Butter hinzu und rühre, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke die Schüssel mit Frischhaltefolie ab und lasse den Teig 30 Minuten bei Zimmertemperatur gehen, bis er Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Natron kurz vor dem Backen unter den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine beschichtete Grillplatte oder Pfanne bei mittelniedriger Hitze und fette sie leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Teig in Crumpet-Ringe oder eine 2 Zoll hohe Metallform und fülle sie bis zur Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Crumpets 5-7 Minuten, bis die Oberseiten trocken und blass aussehen. Wende sie und backe sie weitere 2 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie aus den Ringen und serviere sie warm mit Marmelade, Honig oder Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
