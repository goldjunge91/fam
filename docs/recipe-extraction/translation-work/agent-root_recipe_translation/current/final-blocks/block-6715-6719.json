      "steps": [
        {
          "position": 0,
          "text": "Lege ein feinmaschiges Sieb mit Seihtuch aus und stelle es über eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Joghurt und Salz in einer Schüssel und gib die Mischung in das ausgelegte Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage das Seihtuch über dem Joghurt zusammen und lasse ihn 12-24 Stunden im Kühlschrank vollständig abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm Labneh aus dem Seihtuch und gib es in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke mit dem Löffelrücken eine Mulde in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Olivenöl in die Mulde und streue großzügig Za’atar darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere mit frischem Thymian und Zitronensaft und serviere dazu warmes Pitabrot zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
