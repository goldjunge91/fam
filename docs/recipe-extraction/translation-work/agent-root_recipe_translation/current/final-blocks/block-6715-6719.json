              "quantity": 240,
              "unit": "g",
              "position": 6,
              "optional": false,
              "source_note": "nach Bedarf"
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Bambusblätter 30 Minuten in heißem Wasser ein, bis sie weich und biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle Klebreis ab und koche ihn mit Salz und Öl, bis er gerade weich, aber noch leicht fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege zwei Bambusblätter über Kreuz auf eine Arbeitsfläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib einen Löffel Reis in die Mitte, etwas rote Bohnenpaste, ein Stück Enteneigelb und gewürfelte Wurst darauf. Bedecke alles mit weiterem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Bambusblätter über der Füllung zu einer Pyramide oder einem Tetraeder zusammen und stecke die Enden fest ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege alle Zongzi in einen großen Topf mit kochendem Wasser und lasse sie 45 Minuten köcheln, bis der Reis gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Zongzi mit einer Schaumkelle heraus und lasse sie vor dem Servieren leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
