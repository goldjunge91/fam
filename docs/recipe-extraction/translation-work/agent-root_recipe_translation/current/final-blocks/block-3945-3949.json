      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen, Rinderhackfleisch mit gehackten Zwiebeln anbraten und beim Kochen auseinanderbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fügen Sie gehackten Knoblauch hinzu und kochen Sie ihn 1 Minuten lang, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatensauce, Sahawiq, Wasser, Salz und Pfeffer einrühren und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bockshornkleeblätter und Koriander hinzufügen, gut umrühren und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Machen Sie 4 Vertiefungen in der Mischung und schlagen Sie in jede Vertiefung ein Ei auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Topf abdecken und 8 Minuten köcheln lassen, bis das Eiweiß fest wird, das Eigelb jedoch flüssig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß direkt aus dem Topf mit Brot zum Schöpfen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
