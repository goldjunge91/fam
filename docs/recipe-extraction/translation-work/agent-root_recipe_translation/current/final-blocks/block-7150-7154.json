          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Huhn innen und außen mit 2 EL weicher Butter, Salz und Pfeffer einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Hohlraum mit Zitronenhälften, Thymianzweigen und Knoblauchzehen füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Binden Sie die Beine mit Küchengarn zusammen und legen Sie sie mit der Brust nach oben auf einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Außenseite mit der restlichen Butter einreiben und 45–50 Minuten rösten, bis der Saft klar wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Anschneiden und Servieren 5 Minuten ruhen lassen.",
