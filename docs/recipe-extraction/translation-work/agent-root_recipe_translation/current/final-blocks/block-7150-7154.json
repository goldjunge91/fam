      "steps": [
        {
          "position": 0,
          "text": "Steep saffron in warm Milch für 10 Minuten bis goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "mischen Hefe mit warm saffron Milch und lassen sit für 5 Minuten bis foamy.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "in einer großen Schüssel, vermengen Mehl, Salz, und Zucker, dann rub in Butter bis breadcrumb texture.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "gießen Hefe Mischung und verquirlt Ei in Mehl und kneten bis glatt elastic Teig forms, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "unterheben in currants, cover mit plastic wrap, und lassen rise in warm legen für 1 Stunde bis doubled.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Punch down Teig und divide in 4 gleich Stücke, formen in round buns, und legen auf greased Backen sheet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 45 Minuten gehen lassen, bis die Masse geschwollen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "backen at 375°F für 20-25 Minuten bis goldbraun.",
