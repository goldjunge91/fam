      "steps": [
        {
          "position": 0,
          "text": "Eier in eine Schüssel geben und mit Milch, Salz und Pfeffer verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer beschichteten Pfanne bei mittlerer Hitze erhitzen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie die Eiermischung in die Pfanne und lassen Sie sie 30 Sekunden lang ohne Rühren ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schieben Sie die gekochten Eier vorsichtig vom Rand zur Mitte und kippen Sie dabei die Pfanne, damit das ungekochte Ei an den Rand fließen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn die Eier fast fest, aber oben noch leicht feucht sind, mit Schnittlauch bestreuen und in zwei Hälften falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einen Teller gleiten lassen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
