      "steps": [
        {
          "position": 0,
          "text": "Koche die Hähnchenbrust in Salzwasser vollständig gar. Zupfe sie auseinander und stelle 1 Tasse Brühe beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die Bananenblätter auf, indem du sie 30 Sekunden unter warmes Wasser hältst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Schweineschmalz mit Salz und Backpulver etwa 3 Minuten luftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre nach und nach Masa Harina und Hühnerbrühe unter das Schmalz, bis ein dickflüssiger, streichfähiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische für die Füllung gezupftes Hähnchen, gewürfelte Kartoffeln, Mais und gewürfelte Paprika.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile 2 EL Teig auf einem Bananenblatt, gib 1 EL Füllung in die Mitte und falte das Blatt darum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Tamales aufrecht in einen Topf mit 2 Zoll Wasser und dämpfe sie 45 Minuten, bis der Teig durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren und die Bananenblätter am Tisch vorsichtig öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
