      "steps": [
        {
          "position": 0,
          "text": "Wasche die Kutteln unter fließendem Wasser gründlich und schneide sie in 1-Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Kutteln in Salzwasser 90 Minuten, bis sie sehr zart sind. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und brate gewürfelte Zwiebel und gehackten Knoblauch an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomatenmark dazu und brate es 1 minute. Füge die gekochten Kutteln und Rinderbrühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, gib Kreuzkümmel, Salz und Pfeffer hinzu und lasse es 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfelte Kartoffeln und abgetropfte Kichererbsen dazu. Lasse alles weitere 20 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere und passe die Würzung an. Heiß servieren und mit frischem Koriander bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
