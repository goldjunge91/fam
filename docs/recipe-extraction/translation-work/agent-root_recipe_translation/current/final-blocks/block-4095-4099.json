              "unit": "g",
              "position": 9,
              "optional": false,
              "source_note": "2 EL"
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und bräune die Rindfleischstücke von allen Seiten. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die gewürfelte Zwiebel und den gehackten Knoblauch etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Fleisch zurück in den Topf. Füge Rinderbrühe, Kreuzkümmel, Salz und Pfeffer hinzu und lasse alles 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die geschälten Kochbananenstücke und gewürfelten Kartoffeln dazu und lasse alles weitere 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den in 2-Zoll große Stücke geschnittenen Mais dazu und koche weitere 15 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere und passe die Würzung nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Eintopf heiß in Schalen und bestreue ihn mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
