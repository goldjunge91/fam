      "steps": [
        {
          "position": 0,
          "text": "Brotstücke und Hühnerbrühe in einer großen Schüssel vermischen und 10 Minuten einweichen lassen, bis das Brot sehr weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wurst und Pute in einer Pfanne bei mittlerer Hitze 5 Minuten braten, dann Zwiebel und Knoblauch hinzufügen und 3 weitere Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die gegarte Fleischmischung zusammen mit Petersilie und Salz zum eingeweichten Brot geben und gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung auf Raumtemperatur abkühlen lassen, dann die verquirlten Eier unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit feuchten Händen die Mischung zu 12 etwa 3 Zoll langen, länglichen Bällchen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und die Alheiras portionsweise 4-5 Minuten vorsichtig frittieren, bis sie rundum goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit knusprigem Brot und Senf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
