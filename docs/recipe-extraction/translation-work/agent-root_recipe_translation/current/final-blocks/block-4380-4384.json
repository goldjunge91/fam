      "steps": [
        {
          "position": 0,
          "text": "Den Grill oder die Grillpfanne auf hohe Hitze vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sardinen abspülen und trocken tupfen, dann mit einer Schere die Innereien durch den Bauch entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl, Knoblauch, Petersilie, koscheres Salz, Pfeffer und Chiliflocken in einer kleinen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Sardinen auf einen geölten Grillrost legen und leicht mit der Ölmischung bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3-4 Minuten pro Seite grillen, bis die Haut leicht verkohlt und das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sardinen auf eine Servierplatte legen und mit der restlichen Ölmischung beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Meersalz bestreuen und sofort mit frischen Zitronenspalten und knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
