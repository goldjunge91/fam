      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer Cataplana oder einer großen abgedeckten Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute anbraten, bis er duftet, dann Tomatenmark einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Venusmuscheln, Miesmuscheln und Tintenfischstücke hinzufügen, dann den Weißwein angießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abdecken und 5 Minuten garen, dabei die Pfanne gelegentlich schütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garnelen hinzufügen, erneut abdecken und 3-4 Minuten garen, bis die Garnelen rosa sind und sich die Schalen geöffnet haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nicht geöffnetes Schalentier wegwerfen, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Direkt aus der Cataplana servieren oder in eine große Schüssel geben und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
