      "steps": [
        {
          "position": 0,
          "text": "Den gesalzenen Kabeljau 24 Stunden in kaltem Wasser einweichen und das Wasser alle 8 Stunden wechseln, um ihn zu entsalzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den entsalzten Kabeljau 15 Minuten kochen, bis er blättrig zerfällt, dann in mundgerechte Stücke zupfen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln in dünne Stifte schneiden und in Olivenöl goldbraun und knusprig frittieren, dann auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebeln in dünne Scheiben schneiden und mit gehacktem Knoblauch in Olivenöl anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den zerpflückten Kabeljau, die frittierten Kartoffeln, die angebratenen Zwiebeln und die Oliven in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit dem restlichen Olivenöl, frischer Petersilie, Salz und Pfeffer anmachen und vorsichtig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In eine Servierschüssel geben und mit in Scheiben geschnittenen hart gekochten Eiern und zusätzlicher Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
