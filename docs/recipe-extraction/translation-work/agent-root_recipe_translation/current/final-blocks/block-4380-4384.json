      "steps": [
        {
          "position": 0,
          "text": "Entenkeulen trocken tupfen und mit Salz und Pfeffer würzen, dann Olivenöl in einem breiten Topf oder einer Paellapfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Entenkeulen insgesamt 5-7 Minuten von beiden Seiten anbraten, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf Zwiebel und Knoblauch 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark einrühren und 1 Minute braten, dann Reis hinzufügen und 2 Minuten anrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Rotwein ablöschen und auf die Hälfte einkochen lassen, dann Lorbeerblätter hinzufügen und die Ente zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brühe angießen, zum Köcheln bringen, abdecken und 30-35 Minuten garen, bis der Reis weich und die Ente sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Oliven einrühren, Lorbeerblätter entfernen und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Großzügig mit frischer Petersilie garnieren und direkt aus dem Topf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
