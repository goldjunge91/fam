      "steps": [
        {
          "position": 0,
          "text": "Chorizo aus der Hülle drücken und in einer großen Pfanne bei mittlerer Hitze 5-6 Minuten krümelig braten, bis sie gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Chorizo herausnehmen und beiseitestellen; etwa 1 tbsp Fett in der Pfanne lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier in einer Schüssel mit Salz und Pfeffer verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirlte Eier in die Pfanne geben und 3-4 Minuten ständig rühren, bis sie gestockt, aber noch saftig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gegarte Chorizo, gewürfelte Jalapeño und Zwiebel einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tortillas in einer trockenen Pfanne 20 Sekunden pro Seite erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Tortilla mit der Chorizo-Ei-Mischung füllen und mit geriebenem Käse sowie Koriander belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit Salsa als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
