          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "verquirlen together Mehl, Backpulver, Zimt, und Salz in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Alternately hinzufügen Mehl Mischung und Milch zu der Butter Mischung, stirring bis gerade verbunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "unterheben gewürfelt apples gently in der Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "gießen Teig in vorbereitet Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "backen für 45-50 Minuten bis ein toothpick inserted in der center comes out clean.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "15 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
