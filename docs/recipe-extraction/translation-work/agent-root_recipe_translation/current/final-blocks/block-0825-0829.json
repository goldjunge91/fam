        {
          "position": 0,
          "text": "Für das Sofrito Zwiebel, Knoblauch und grüne Paprika fein würfeln. Brate sie 6 Minuten in Olivenöl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Kreuzkümmel, Oregano und Tomatenmark dazu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib abgetropfte schwarze Bohnen und 1 Tasse Wasser dazu. Gib das Lorbeerblatt hinein und lass alles 15 Minuten köcheln. Zerdrücke einige Bohnen, damit die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verfeinere die Bohnen mit Rotweinessig und Koriander. Würze großzügig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere sie auf weißem Reis. Kubanische Bohnen sollen schön saucig sein – verwende eine Schöpfkelle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
