      "externalId": "waivy:mfr-greek-avgolemono",
      "slug": "mfr-greek-avgolemono",
      "title": "Griechische Avgolemono-Hühnersuppe",
      "instructions": "Griechenlands samtige Hühnersuppe mit Ei, Zitrone und Orzo. Frisch und wohltuend und mit einer einfachen Abkürzungsmethode besonders leicht zuzubereiten.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 25,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Avgolemono ist einfache Vorratsküchenmagie: Hähnchen, Eier, Zitrone und Brühe.",
        "Das Temperieren des Eis sorgt für die samtige Konsistenz. Nimm dir dafür Zeit."
      ],
      "substitutions": [
        {
          "forIngredientId": "rice",
          "swap": "Orzo oder beliebige kleine Pasta für eine andere Konsistenz"
        },
        {
          "forIngredientId": "chicken-breast",
          "swap": "Gezupftes Grillhähnchen zum Schluss einrühren und so 15 Minuten Garzeit sparen"
        }
      ],
