      "steps": [
        {
          "position": 0,
          "text": "Pochiere Hähnchenbrüste 15 Minuten in Brühe mit Zwiebel und Knoblauch. Nimm sie heraus und zupfe sie auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Reis in die köchelnde Brühe und gare ihn 15 Minuten, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle 3 Eier in einer Schüssel kräftig mit Zitronensaft. Schöpfe langsam 1 Tasse heiße Brühe dazu und rühre dabei ständig, um die Eier zu temperieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die temperierte Ei-Zitronen-Mischung langsam unter Rühren zurück in den Topf. Erhitze die Suppe vorsichtig und lass sie nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe das gezupfte Hähnchen unter. Würze die Suppe und serviere sie mit Petersilie und zusätzlicher Zitrone.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
