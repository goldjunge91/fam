      "steps": [
        {
          "position": 0,
          "text": "Püriere zerkleinerte Tomaten, 1 Zwiebel und Paprika zu einer glatten roten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Hähnchen mit geräuchertem Paprikapulver, Kreuzkümmel, Salz und Pfeffer. Brate es in Olivenöl 4 Minuten pro Seite an. Nimm es heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die übrige gewürfelte Zwiebel im selben Topf 5 Minuten an. Gib Knoblauch und Tomatenmark dazu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die pürierte Paprika-Tomaten-Paste dazu. Brate sie bei mittelhoher Hitze 10–12 Minuten unter häufigem Rühren, bis sie stark eingekocht ist und sich das Öl absetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Reis, Brühe, Thymian, Lorbeerblatt und Cayennepfeffer dazu. Lege das Hähnchen hinein. Decke den Topf dicht ab und gare alles bei niedriger Hitze 25 Minuten, bis der Reis gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
