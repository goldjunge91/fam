      "steps": [
        {
          "position": 0,
          "text": "Lauwarmes Wasser, Hefe und Salz verrühren und 5 Minuten stehen lassen, bis die Mischung schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Olivenöl zur Hefemischung geben und 8 Minuten zu einem glatten Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in einer geölten Schüssel 20 Minuten gehen lassen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig auf Backpapier zu einem Rechteck von 12 × 10 Zoll ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ricotta gleichmäßig auf dem Teig verstreichen, dabei am Rand 1 Zoll frei lassen. Wurst und Mozzarella darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig von der langen Seite her fest aufrollen, die Naht durch Zusammendrücken verschließen und den Stromboli mit der Naht nach unten legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit verquirltem Ei bestreichen, italienische Kräuter darüberstreuen und bei 400 °F 25 Minuten backen, bis er goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten abkühlen lassen, dann in Scheiben schneiden und mit Marinara-Sauce zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
