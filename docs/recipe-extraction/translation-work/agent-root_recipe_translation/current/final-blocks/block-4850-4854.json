      "steps": [
        {
          "position": 0,
          "text": "Wasser in einem großen Topf zum Kochen bringen. Salz und Ingwer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hähnchenbrust im Ganzen hinzufügen und 15 Minuten köcheln lassen, bis sie durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hähnchen herausnehmen und kurz abkühlen lassen. Das Fleisch zerpflücken und beiseitestellen; die Kochflüssigkeit im Topf lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Reis unter kaltem Wasser abspülen, bis das Wasser klar abläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Reis in die Hühnerbrühe geben, zum Kochen bringen und anschließend die Hitze reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "35–40 Minuten köcheln lassen und gelegentlich umrühren, bis der Reis zerfällt und ein cremiger Brei entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das zerpflückte Hähnchen zurück in den Topf geben, Fischsauce und weißen Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Noch 2 Minuten köcheln lassen, dann mit Sesamöl beträufeln und mit Röstschalotten und geschnittenen Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
