      "steps": [
        {
          "position": 0,
          "text": "Spüle Quinoa ab und koche sie nach Packungsanweisung in Wasser. Lasse sie anschließend abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Kichererbsen ab, spüle sie ab und vermische sie mit der Hälfte des Olivenöls.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Kirschtomaten, Gurke und Paprika in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle das restliche Olivenöl mit Zitronensaft, gehacktem Knoblauch und Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die abgekühlte Quinoa, Kichererbsen und das gesamte geschnittene Gemüse in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Dressing darüber und vermische alles, bis die Zutaten gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab, verteile den Salat auf zwei Schüsseln und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
