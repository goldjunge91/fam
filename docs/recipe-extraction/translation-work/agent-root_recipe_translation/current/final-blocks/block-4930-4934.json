      "steps": [
        {
          "position": 0,
          "text": "Weiche die Trockenfrüchte 2 Stunden oder über Nacht in Brandy ein, damit sie aufquellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Semmelbrösel, Natron, gemischte Gewürze und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Butter und braunen Zucker cremig und rühre die Eier einzeln unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die Buttermischung abwechselnd mit der Milch unter die trockenen Zutaten. Hebe anschließend die eingeweichten Früchte samt Flüssigkeit unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fette eine 2-Quart-Puddingform ein und fülle sie zu drei Vierteln mit Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form mit Folie ab und stelle sie in einen Dämpftopf mit 2 Zoll kochendem Wasser. Dämpfe den Pudding 3-4 Stunden und fülle bei Bedarf Wasser nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse den Pudding 10 Minuten abkühlen und stürze ihn dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
