      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, 0.25 Tasse Zucker und Salz. Arbeite kalte Butter ein, bis eine krümelige Masse entsteht, und knete das Eigelb ein, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke den Teig in eine 9-Zoll-Tarteform und backe ihn bei 375°F 12-15 Minuten, bis er hellgolden ist. Lasse den Boden vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die Milch mit glatt gerührter Maisstärke unter ständigem Rühren, bis die Creme eindickt. Nimm sie vom Herd und rühre Vanille und 1 Esslöffel Zucker ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die warme Konditorcreme in den abgekühlten Tarteboden und stelle ihn 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege Erdbeeren und Heidelbeeren dekorativ auf die Creme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Aprikosenkonfitüre mit 1 Esslöffel Wasser und bestreiche das Obst vorsichtig damit, damit es glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Tarte vor dem Servieren mindestens 1 Stunde kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
