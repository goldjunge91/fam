      "steps": [
        {
          "position": 0,
          "text": "Vorbereitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1. Schlage das Ei in eine Schüssel. Trenne Eiweiß und Eigelb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Süß-saures Schweinefleisch",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2. Schneide das Schweinefilet in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3. Bereite die Marinade aus einer Prise Salz, einem Teelöffel Stärke, zwei Teelöffeln heller Sojasoße und einem Eiweiß zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "4. Lasse die Schweinefleischstreifen etwa 20 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5. Gib die restliche Stärke in eine Schüssel. Füge Wasser und Essig hinzu und verrühre alles zu einer Stärkesauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Süß-saures Schweinefleisch",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Zubereitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "1. Gieße das Öl in einen Wok und erhitze es auf 190°C (375°F). Gib die marinierten Schweinefleischstreifen hinein und frittiere sie, bis sie braun sind. Nimm das gegarte Fleisch heraus und lege es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "2. Lasse etwas Öl im Wok. Gib Tomatensoße und weißen Zucker hinein und erhitze alles, bis Öl und Soße vollständig vermischt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "3. Gib etwas Wasser in den Wok und erhitze die süß-saure Soße gründlich, bevor du die Schweinefleischstreifen hineingibst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "4. Gieße die Stärkesauce dazu. Brate alle Zutaten unter Rühren, bis Schweinefleisch und Soße gut vermischt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "5. Auf einem Teller anrichten und mit Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
