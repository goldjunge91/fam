      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200C/180C Umluft/Gasstufe 6 vor. Vermenge die Süßkartoffelstücke mit Olivenöl und Gewürzen und verteile sie auf einem mit Backpapier ausgelegten Blech. Röste sie 30 - 35 mins, bis sie weich und goldbraun sind. Bei Raumtemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sobald sie fast abgekühlt sind, verrühre alle Zutaten für das Dressing mit etwas zusätzlicher Würze und hebe es vorsichtig unter die Kartoffelstücke. Verwende dazu die Hände, damit die Stücke nicht zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
