      "steps": [
        {
          "position": 0,
          "text": "Gib die Zutaten in der vom Hersteller empfohlenen Reihenfolge in die Backform des Brotbackautomaten. Wähle den Teigzyklus und drücke Start.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wenn der Teigzyklus fast abgeschlossen ist, heize den Ofen auf 475 Grad F (245 Grad C) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Teig auf eine leicht bemehlte Arbeitsfläche. Teile ihn in acht gleich große Stücke und forme Kugeln. Decke sie mit einem feuchten Tuch ab und lasse sie ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle die Teigstücke zu dünnen, flachen Kreisen von etwa 8 inches Durchmesser aus. Backe jeweils zwei auf vorgeheizten Blechen oder einem Backstein, bis sie aufgehen und goldbraun sind, etwa 5 Minuten. Wiederhole dies mit den übrigen Fladen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
