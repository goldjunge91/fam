      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf bei mittlerer Hitze erhitzen und langsam Mehl einrühren, bis eine dunkle Mehlschwitze entsteht. Unter ständigem Rühren 8–10 Minuten lang schokoladenbraun rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln, Sellerie und Paprika (die heilige Dreifaltigkeit) zur Mehlschwitze geben und 5 Minuten kochen lassen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe und Dosentomaten mit Saft dazugeben und umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kreolische Gewürze und scharfe Soße hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gumbo 15 Minuten köcheln lassen, um die Aromen zu vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garnelen und Okra in den Topf geben und 5 Minuten kochen lassen, bis die Garnelen rosa werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nach Bedarf nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln mit weißem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
