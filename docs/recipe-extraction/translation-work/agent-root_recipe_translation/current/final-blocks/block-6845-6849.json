      "steps": [
        {
          "position": 0,
          "text": "Milch erwärmen und Butter darin auflösen, dann etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Kristallzucker und eine Prise Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ei verquirlen und zur warmen Milchmischung geben, dann mit der Mehlmischung zu einem Teig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2 Minuten kneten, abdecken und 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie den Teig auf einer bemehlten Oberfläche 0.25 Zoll dick aus und schneiden Sie ihn in 2 Zoll große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl auf 375 °F erhitzen und Beignets portionsweise auf beiden Seiten goldbraun braten (ca. 1 Minute pro Seite).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Schaumlöffel herausnehmen und großzügig mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brühen Sie starken Kaffee auf, mischen Sie ihn im Verhältnis 1:1 mit heißer Milch und servieren Sie ihn zusammen mit warmen Beignets.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
