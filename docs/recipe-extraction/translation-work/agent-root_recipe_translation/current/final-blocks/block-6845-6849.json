      "steps": [
        {
          "position": 0,
          "text": "Hähnchenschenkel mindestens 2 Stunden oder über Nacht in Buttermilch marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Cayennepfeffer, Paprika, Knoblauchpulver, Salz und schwarzen Pfeffer in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pflanzenöl in einem tiefen Topf oder Schmortopf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nehmen Sie das Hähnchen aus der Buttermilch und tauchen Sie es gründlich in die gewürzte Mehlmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie das Hähnchen vorsichtig in heißes Öl und braten Sie es 12–15 Minuten lang, bis es goldbraun ist und die Innentemperatur 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hähnchen herausnehmen und auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Scharfe Soße mit restlichem Gewürzmehl zu einer Paste vermischen und auf das heiße Hähnchen streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort auf Weißbrot mit Gurken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
