      "steps": [
        {
          "position": 0,
          "text": "Entfernen Sie mit einem scharfen Messer die Membran von der Unterseite der Rippchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischen Sie braunen Zucker, Paprika, schwarzen Pfeffer, Knoblauchpulver, Zwiebelpulver und Cayennepfeffer in einer Schüssel, um eine Trockenreibe herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tragen Sie die Trockenmasse großzügig und gleichmäßig auf beide Seiten der Rippen auf und klopfen Sie sie fest ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lassen Sie die Rippchen 30 Minuten lang bei Zimmertemperatur einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stellen Sie den Räucherofen auf 250 °F ein und fügen Sie eingeweichte Hickory-Chips hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Legen Sie die Rippchen auf den Rost und räuchern Sie sie 4–5 Stunden lang. Besprühen Sie sie dabei alle 30 Minuten mit einer Apfelessiglösung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rippchen sind gar, wenn sich das Fleisch von den Knochen löst und sich leicht biegen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Herausnehmen und sofort ohne Sauce servieren, um den Dry-Rub-Geschmack hervorzuheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
