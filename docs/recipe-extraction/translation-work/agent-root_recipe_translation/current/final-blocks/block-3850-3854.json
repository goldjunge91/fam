      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eier mit Milch, Zucker und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Mehl zur flüssigen Mischung und rühre, bis ein dicker, glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Topf auf 350°F und prüfe die Temperatur mit einem Holzlöffelstiel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Teig in einen Spritzbeutel mit großer Sterntülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spritze 4 Zoll lange Teigstreifen direkt ins heiße Öl und frittiere sie portionsweise, damit der Topf nicht überfüllt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie insgesamt etwa 3 Minuten goldbraun, wende sie einmal mit einer Zange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Schenkele mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische Puderzucker mit Kirsch oder Rum und bestäube die warmen Küchlein großzügig damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
