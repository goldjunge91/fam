      ],
      "steps": [
        {
          "position": 0,
          "text": "Würze Hähnchenschenkel mit Salz und Pfeffer und erhitze Olivenöl in einem großen Schmortopf oder schweren Topf bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune die Hähnchenschenkel je Seite 5-6 Minuten goldbraun. Nimm sie heraus und stelle sie auf einem Teller beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle Zwiebeln, hacke Knoblauch und dünste beides im selben Topf 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Paprikapulver ein und gare es 1 Minute, bis es duftet. Gib dann Hühnerbrühe hinzu und lege das Hähnchen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, decke den Topf ab und gare das Hähnchen 40 Minuten, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und rühre saure Sahne ein, bis die Sauce glatt und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht, passe die Würzung an und serviere es mit Eiernudeln oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
