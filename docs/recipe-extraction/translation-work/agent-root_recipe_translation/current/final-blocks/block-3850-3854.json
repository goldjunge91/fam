      "steps": [
        {
          "position": 0,
          "text": "Schneide Speck in Streifen und lasse ihn in einem großen Schmortopf bei mittlerer Hitze knusprig aus. Nimm ihn heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze Hähnchenstücke mit Salz und Pfeffer und bräune sie portionsweise im Speckfett rundherum goldbraun, etwa 8 Minuten pro Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Hähnchen heraus und dünste Perlzwiebeln und Pilze im selben Topf etwa 5 Minuten leicht gebräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Streue Mehl über das Gemüse, rühre gut um und gare es 2 Minuten zu einer Mehlschwitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Riesling und Hühnerbrühe hinzu, löse die Röststoffe vom Boden und gib Hähnchen und Speck zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Knoblauchzehen und Thymian hinzu, bringe alles zum Köcheln, decke den Topf ab und gare es 45 Minuten, bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne Thymianzweige und schmecke vor dem Servieren mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Eiernudeln oder Salzkartoffeln und knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
