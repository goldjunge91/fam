      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und löse vorsichtig ganze Kohlblätter ab. Blanchiere sie 2 Minuten weich und lasse sie dann auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Schweinehackfleisch mit gewürfelter Zwiebel und gehacktem Knoblauch 5 Minuten in einer Pfanne bei mittelhoher Hitze und zerteile dabei das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gekochten Reis, Paprikapulver, Salz und Pfeffer ein. Nimm die Pfanne vom Herd und lasse die Füllung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 2-3 Esslöffel Füllung auf jedes Kohlblatt, klappe die Seiten ein und rolle es fest zu einem Päckchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Rouladen mit der Naht nach unten in eine 9x13 Zoll große Auflaufform und gieße Tomatensauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form mit Folie ab und backe die Rouladen bei 350°F 45 Minuten, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle sie vor dem warmen Servieren mit saurer Sahne und reiche zusätzliche Sauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
