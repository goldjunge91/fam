      "steps": [
        {
          "position": 0,
          "text": "Trenne Eiweiß und Eigelb und schlage das Eiweiß steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eigelb mit Milch, Mehl, Salz und Zucker zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe das Eiweiß in zwei Portionen vorsichtig unter den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze 2 Esslöffel Butter in einer großen beschichteten Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in die Pfanne und gare ihn 3-4 Minuten goldbraun. Wende ihn und gare ihn weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerreiße den Pfannkuchen mit zwei Holzlöffeln in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze die restliche Butter und schwenke die Pfannkuchenstücke 2 Minuten in der Pfanne, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib sie auf einen Teller, bestäube sie mit Puderzucker und serviere sie mit warmer Pflaumenmarmelade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
