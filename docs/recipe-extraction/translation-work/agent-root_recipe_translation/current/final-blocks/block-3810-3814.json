      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste gewürfelte Zwiebel etwa 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und gewürfelten Jamón hinzu und gare alles 2 Minuten, bis der Jamón sein Fett abgibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1-2 Minuten, damit sich der Geschmack vertieft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein hinzu, löse die gebräunten Röststoffe und lasse die Flüssigkeit auf die Hälfte reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Saubohnen, Hühnerbrühe und Lorbeerblatt hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche alles ohne Deckel 20-25 Minuten, bis die Bohnen weich und die Flüssigkeit leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer (vorsichtig mit Salz, da Jamón bereits salzig ist), garniere mit frischer Petersilie und serviere warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
