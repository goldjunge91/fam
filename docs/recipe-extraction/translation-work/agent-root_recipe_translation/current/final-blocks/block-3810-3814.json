      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinehackfleisch, gemahlenes Schweinefett, Milch, Petersilie, Schnittlauch, Salz, weißen Pfeffer, Ingwer und Muskatblüte in einer Schüssel. Stelle die Mischung 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Schweinedärme 10 Minuten in warmem Wasser ein, damit sie weich werden. Spüle sie vorsichtig ab und lasse das Wasser ablaufen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle einen Wurstfüller mit der Fleischmischung und fülle die Därme vorsichtig. Binde beide Enden zu und überfülle sie nicht, damit sie nicht platzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stich jede Wurst vorsichtig mit einer sterilisierten Nadel ein, damit sie beim Garen nicht platzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Rinderbrühe oder Wasser in einem großen Topf auf 160-170°F, ohne es vollständig aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Würste vorsichtig in die heiße Flüssigkeit und poche sie 15 Minuten. Halte die Wassertemperatur konstant und lasse sie nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Würste mit einer Schaumkelle heraus und serviere sie sofort warm mit süßem Senf und frischen Brezeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
