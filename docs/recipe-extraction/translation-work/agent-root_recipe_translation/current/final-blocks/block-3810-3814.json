      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und gib gehackten Knoblauch hinzu. Gare ihn 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Pinienkerne hinzu und röste sie 1-2 Minuten unter ständigem Rühren, damit sie nicht anbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Rosinen und Kreuzkümmel hinzu und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Spinat portionsweise hinzu und rühre nach jeder Zugabe um, bis er zusammenfällt (insgesamt etwa 3-4 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz und Pfeffer und presse frischen Zitronensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre vorsichtig um und serviere das Gericht warm als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
