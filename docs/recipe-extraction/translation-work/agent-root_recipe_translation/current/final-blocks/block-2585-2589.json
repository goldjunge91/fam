      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und bräune die Ochsenschwanzstücke etwa 8 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Ochsenschwanz heraus und dünste gehackte Zwiebel, Karotten, Sellerie und Knoblauch, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tomaten und Rotwein hinzu und kratze die Bratrückstände vom Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Ochsenschwanz zurück in den Topf, füge Rinderbrühe und Lorbeerblätter hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse alles zugedeckt 2.5 Stunden köcheln, bis der Ochsenschwanz sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Ochsenschwanzstücke heraus und zupfe das Fleisch von den Knochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das gezupfte Fleisch zurück in den Topf, lasse alles weitere 10 Minuten köcheln und würze dann mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
