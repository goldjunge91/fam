      "steps": [
        {
          "position": 0,
          "text": "Entferne Bindegewebe und Adern von den Hühnerlebern, weiche sie 1 Stunde in kaltem Wasser ein und tupfe sie dann trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke die Schalotten fein und gare sie in 2 Esslöffeln Butter bei mittlerer bis niedriger Hitze 3 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Lebern mit Thymian und Lorbeerblatt in die Pfanne und gare sie 4-5 Minuten, bis sie gerade gar, innen aber noch leicht rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Entferne Thymian und Lorbeerblatt und gib die Lebermischung in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die restliche, gewürfelte Butter und Cognac hinzu und püriere alles vollständig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer und streiche die Mischung für eine besonders glatte Textur durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Mischung in eine Terrinenform oder einen kleinen Topf, streiche die Oberfläche glatt, decke sie mit Frischhaltefolie ab und stelle sie 24 Stunden in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Pastete gekühlt mit knusprigen Toastspitzen und Cornichons.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
