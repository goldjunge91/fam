      "steps": [
        {
          "position": 0,
          "text": "Bringe einen kleinen Topf Wasser zum Köcheln, senke die Eier vorsichtig hinein und gare sie 4-5 Minuten. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Speck in Streifen und brate ihn bei mittlerer Hitze knusprig. Lege ihn dann auf Küchenpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke die Schalotte fein und verquirle sie mit Essig, Senf, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Träufle unter Rühren langsam Olivenöl hinein, bis eine Emulsion entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zupfe den Friséesalat in mundgerechte Stücke und gib ihn in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die warme Vinaigrette über den Salat, gib den knusprigen Speck hinzu und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile den Salat auf zwei Teller und schlage vorsichtig je ein weich gekochtes Ei darüber auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort, solange das Eigelb noch warm und flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
