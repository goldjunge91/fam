      ],
      "steps": [
        {
          "position": 0,
          "text": "Löse Hefe und Zucker in warmem Wasser auf und lasse die Mischung 5 Minuten stehen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Salz in einer Schüssel. Gieße dann die Hefemischung und die geschmolzene Butter dazu und rühre, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke die Schüssel mit einem feuchten Tuch ab und lasse den Teig bei Raumtemperatur 20 Minuten gehen, bis er Blasen wirft und luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine beschichtete Pfanne bei mittlerer Hitze und fette sie leicht ein. Lege dann eingefettete Crumpet-Ringe auf die Oberfläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1/4 Tasse Teig in jeden Ring und brate ihn 4-5 Minuten, bis die Oberfläche fest und die Unterseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Ringe vorsichtig und wende die Crumpets. Brate sie weitere 1-2 Minuten, bis auch die andere Seite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Crumpets auf einen Teller und serviere sie warm mit Butter und Marmelade oder Honig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
