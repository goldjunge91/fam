              "grams": 22.5,
              "quantity": 22.5,
              "unit": "g",
              "position": 1,
              "optional": false,
              "source_note": "1.5 Tassen zum Frittieren"
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und die Temperatur mit einem einzelnen Papadum prüfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein Papadum vorsichtig in das heiße Öl geben; es geht sofort auf und vergrößert sich innerhalb von 1-2 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit einer Zange oder einem Schaumlöffel wenden, eine weitere Sekunde frittieren und dann sofort auf einen mit Küchenpapier ausgelegten Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit jedem Papadum wiederholen und das Öl zwischen den Portionen wieder auf Temperatur kommen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vor dem Servieren vollständig abkühlen lassen, da sie beim Abkühlen noch knuspriger werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pur oder mit indischen Pickles und Chutneys als Beilage zu Mahlzeiten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
