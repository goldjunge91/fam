      "steps": [
        {
          "position": 0,
          "text": "Schneide das Fleisch in 1-Zoll große Würfel und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke die Zwiebel und den Knoblauch fein. Gib beides zusammen mit den Rosmarinnadeln, Olivenöl, Salz und Pfeffer zum Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse das Fleisch bei Raumtemperatur mindestens 15 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fädle das Fleisch abwechselnd mit Zwiebelstücken auf die Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Grill oder die Grillpfanne auf hohe Hitze vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Spieße 2-3 Minuten pro Seite für den Gargrad medium-rare und wende sie gelegentlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse sofort nach dem Braten frischen Zitronensaft über die Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
