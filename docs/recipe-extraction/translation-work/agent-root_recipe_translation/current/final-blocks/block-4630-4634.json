      "steps": [
        {
          "position": 0,
          "text": "Weiche Bambusspieße 30 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Schweinefilet in dünne Streifen und fädle sie auf die Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Kokosmilch, Erdnussbutter, Sojasauce, Limettensaft, gehackten Knoblauch, Ingwer und braunen Zucker in einer Schüssel zur Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Hälfte der Sauce zum Servieren beiseite und bestreiche die Spieße großzügig mit der anderen Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Spieße 3-4 Minuten pro Seite, bis das Schweinefleisch durchgegart und leicht angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie auf einen Servierteller und beträufle sie mit der beiseitegestellten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm mit der übrigen Sauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
