      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in 1.5-Zoll große Würfel und die Zwiebeln in dicke Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Öl, Essig, Wasser, gehackten Knoblauch, Salz, Pfeffer und Lorbeerblatt zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge Hähnchen und Zwiebel in einer Schüssel mit der Marinade und stelle alles für 2-4 Stunden oder über Nacht in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke Hähnchen und Zwiebel abwechselnd auf Metall- oder Holzspieße (Holzspieße zuvor 30 Minuten einweichen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze einen Grill oder eine Grillpfanne stark und grille die Spieße 8-10 Minuten. Wende sie alle 2 Minuten, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Hähnchen sollte eine Kerntemperatur von 165°F erreicht und leichte Röstspuren haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es heiß mit der restlichen Marinade als Dip und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
