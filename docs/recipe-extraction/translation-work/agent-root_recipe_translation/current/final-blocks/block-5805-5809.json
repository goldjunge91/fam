      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche die Holzspieße 30 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasoße, Mirin, Sake, braunen Zucker und gehackten Knoblauch in einem kleinen Topf zu einer Glasur und lasse sie 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Hähnchenkeulen in 1.5-Zoll große Würfel und die Frühlingszwiebeln in 2-Zoll lange Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke Hähnchen und Frühlingszwiebeln abwechselnd auf die Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Spieße bei mittlerer bis hoher Hitze 8-10 Minuten und wende sie häufig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche in den letzten 2 Minuten der Garzeit beide Seiten der Spieße mit der Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue Sesamsamen und Shichimi-Gewürz darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie sofort mit einer kleinen Schale der übrigen Glasur zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
