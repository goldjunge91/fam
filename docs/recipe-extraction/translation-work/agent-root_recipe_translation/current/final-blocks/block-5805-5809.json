      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in mundgerechte Stücke, wende sie in Ei und dann in Speisestärke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok oder einer tiefen Pfanne auf 350°F und frittiere das Hähnchen portionsweise etwa 3-4 Minuten, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das frittierte Hähnchen heraus und lasse es auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Zucker, Zitronensaft, Wasser, Sojasoße und gehackten Knoblauch in einem Topf und bringe die Soße zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Soße 5 Minuten köcheln, bis sie leicht eingedickt ist, und gieße sie dann über das frittierte Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge alles vorsichtig, damit die Soße das Hähnchen überzieht. Garniere es mit geschnittener Frühlingszwiebel und Zitronenscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es sofort auf gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
