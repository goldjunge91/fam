      "steps": [
        {
          "position": 0,
          "text": "Mariniere das Hähnchen 30 Minuten in Joghurt, gehacktem Knoblauch und Ingwer, Garam Masala und Kurkuma.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einem großen Topf und brate die geschnittenen Zwiebeln goldbraun. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das marinierte Hähnchen im selben Ghee 5 Minuten an und nimm es dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche Wasser mit Lorbeerblatt und Kreuzkümmelsamen auf. Gib den abgespülten Basmatireis hinzu und gare ihn, bis er zu 70% gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte im selben Topf die Hälfte des Reises, dann das ganze Hähnchen und darüber den restlichen Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue die gebratenen Zwiebeln darüber und decke den Topf fest mit Folie und einem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles bei hoher Hitze 2 Minuten, bis Dampf entsteht. Reduziere dann die Hitze und gare es 30 Minuten auf niedriger Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse das Gericht 10 Minuten ruhen, ohne den Deckel zu öffnen. Lockere den Reis anschließend vorsichtig mit einer Gabel auf und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
