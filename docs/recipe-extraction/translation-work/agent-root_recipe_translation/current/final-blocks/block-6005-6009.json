      "steps": [
        {
          "position": 0,
          "text": "Vermische Matzenmehl, Salz und Pfeffer in einer mittelgroßen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier und Wasser und gieße die Mischung zum Matzenmehl. Rühre alles zu einem dickflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig 5-10 Minuten bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze, bis ein Tropfen Teig sofort brutzelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Löffelportionen des Teigs ins heiße Öl und drücke sie mit dem Löffelrücken leicht flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate sie 3-4 Minuten, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende sie vorsichtig und brate die andere Seite 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus, lasse sie auf Küchenpapier abtropfen und serviere sie warm mit Apfelmus oder saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
