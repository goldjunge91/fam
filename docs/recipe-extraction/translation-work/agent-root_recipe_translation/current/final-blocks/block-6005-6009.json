      "steps": [
        {
          "position": 0,
          "text": "Brich die Matzen in mundgerechte Stücke und gib sie in eine flache Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße warmes Wasser über die Matzenstücke, bis sie feucht, aber nicht matschig sind. Gieße überschüssiges Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier mit Salz und Pfeffer in einer weiteren Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die eingeweichten Matzen zu den Eiern und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Butter oder Öl in einer großen Pfanne bei mittlerer Hitze, bis es schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Matzen-Ei-Mischung in die Pfanne und rühre häufig um. Zerteile dabei größere Klumpen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare die Mischung 5-7 Minuten unter gelegentlichem Rühren, bis sie goldbraun und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort mit Apfelmus, saurer Sahne oder Zimtzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
