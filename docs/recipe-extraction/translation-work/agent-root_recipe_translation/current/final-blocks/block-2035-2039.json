      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200C/400F/Gasstufe 6 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einer tiefen Pfanne und brate das Hackfleisch 4-5 Minuten. Zerteile es beim Bräunen mit einem Holzlöffel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebel hinzu und gare sie 2-3 Minuten. Rühre dann Tomatenpüree ein und gare es weitere 2-3 Minuten. Rühre das Mehl ein und gare es eine weitere Minute. Gib gehackte Pilze, Stout oder Rinderbrühe und ein paar Spritzer Worcestershire-Soße dazu. Bringe alles zum Kochen, reduziere die Hitze, decke die Pfanne ab und lasse es 20 Minuten köcheln. Beiseitestellen und abkühlen lassen, dann die Fleischmischung in eine one litre Pastetenform füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig auf einer bemehlten Arbeitsfläche etwas größer als die Form aus. Lege ihn vorsichtig über die Form und drücke ihn fest an den Rändern an. Schneide den Überstand ab und forme die Ränder wellig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide aus den Teigresten Blätter aus und verziere die Pastete damit. Klebe sie mit verquirltem Eigelb auf den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide drei or four Schlitze in den Teig, damit Dampf entweichen kann. Bestreiche die Pastete mit dem restlichen verquirlten Eigelb und backe sie 20-25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zum Servieren in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
