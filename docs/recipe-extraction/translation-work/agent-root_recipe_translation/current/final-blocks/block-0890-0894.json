      "steps": [
        {
          "position": 0,
          "text": "Taue tiefgekühlte Garnelen auf. Tupfe sie trocken und würze sie mit Salz, Pfeffer und gehacktem Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Garnelen in 1 EL Olivenöl bei mittlerer bis hoher Hitze pro Seite 2 Minuten, bis sie rosa und eingerollt sind. Lass sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite das Dressing zu: Verrühre übriges Olivenöl, Limettensaft, gehackten Koriander und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Filetiere die Orange. Würfle die Avocado und schneide die Tomate in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische den Spinat mit dem Dressing. Belege den Salat mit Garnelen, Avocado, Orange und Tomate. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
