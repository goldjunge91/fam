          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke die Schüssel ab und stelle sie mindestens 3 Stunden, am besten über Nacht, in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Hähnchen samt Marinade in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe alles ohne Abdeckung 45–50 Minuten, bis die Haut karamellisiert ist und die Kerntemperatur 165°F erreicht hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Hähnchen mit geschnittenen Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
