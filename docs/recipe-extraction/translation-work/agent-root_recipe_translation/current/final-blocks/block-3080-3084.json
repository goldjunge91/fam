      ],
      "steps": [
        {
          "position": 0,
          "text": "Gieße Kokosmilch in einen Topf und erhitze sie bei mittlerer Hitze, bis Dampf aufsteigt. Nicht kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Speisestärke, Zucker, Salz und Wasser in einer kleinen Schüssel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Stärkemischung unter ständigem Rühren langsam zur heißen Kokosmilch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre 8-10 Minuten häufig weiter, bis die Mischung eindickt und undurchsichtig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die heiße Mischung in eine 8x8 inch große Auflaufform und verteile sie gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Raumtemperatur abkühlen und stelle sie dann mindestens 2 Stunden kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Masse in neun Quadrate und serviere sie gekühlt oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
