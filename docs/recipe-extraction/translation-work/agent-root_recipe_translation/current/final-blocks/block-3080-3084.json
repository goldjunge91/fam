      "steps": [
        {
          "position": 0,
          "text": "Schäle Taro und reibe ihn in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische geriebenen Taro mit Kokosmilch, braunem Zucker und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die Mischung gleichmäßig auf acht Stücke Ti-Blätter oder Folienquadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wickle jede Portion fest zu einem quadratischen Päckchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Päckchen mit der Naht nach oben in einen Dämpftopf mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe sie 30-40 Minuten, bis die Taro-Mischung fest und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Päckchen aus dem Dämpfer und lasse sie vor dem Auswickeln 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm oder bei Raumtemperatur als traditionelle hawaiianische Süßspeise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
