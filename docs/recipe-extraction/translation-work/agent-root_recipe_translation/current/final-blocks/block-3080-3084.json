      "steps": [
        {
          "position": 0,
          "text": "Koche Eiernudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Wok oder einer Pfanne bei hoher Hitze und brate gehackten Knoblauch etwa 30 Sekunden an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hähnchenstreifen dazu und brate sie unter Rühren 3-4 Minuten gar. Füge dann Garnelen hinzu und gare sie weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Karotten und Kohl dazu und brate das Gemüse 3-4 Minuten unter Rühren an, bis es weich zu werden beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochte Nudeln in die Pfanne und vermenge alles. Löse dabei Klümpchen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Sojasauce und Hühnerbrühe dazu und vermische alles 2-3 Minuten, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue das Gericht mit Frühlingszwiebeln und serviere es heiß mit Zitronenspalten dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
