      "steps": [
        {
          "position": 0,
          "text": "Schneide frischen Weißfisch in kleine Würfel und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Essig oder Zitronensaft über den Fisch und vermenge alles vorsichtig, damit die Stücke gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Fisch 10 Minuten ziehen, damit die Säure ihn leicht beizt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Ingwer und Knoblauch, gewürfelte rote Zwiebel und geschnittene grüne Chilischoten dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch hinein und rühre vorsichtig um, damit sich alles verbindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht sofort zu Reis oder mit Crackern als erfrischende Vorspeise.",
