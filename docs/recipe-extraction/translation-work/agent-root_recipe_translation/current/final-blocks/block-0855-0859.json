      "steps": [
        {
          "position": 0,
          "text": "Brate gewürfelte Zwiebel 5 Minuten in Olivenöl an. Gib Knoblauch, Ingwer, Currypulver, Garam Masala und Kurkuma dazu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib zerkleinerte Tomaten dazu und gare sie 3 Minuten. Gib Linsen und 4 Tassen Wasser hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass alles 20 Minuten köcheln, bis die Linsen vollständig weich sind. Rühre Kokosmilch ein und lass das Curry weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche den Reis. Würze das Curry großzügig mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass alles vollständig abkühlen. Verteile Curry und Reis auf 5 Behälter und gib Koriander dazu. Im Kühlschrank bis zu 5 Tage haltbar; bis zu 3 Monate tiefgekühlt haltbar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
