      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor. Lass die Kichererbsen abtropfen, spüle sie ab und verteile sie auf einem sauberen Tuch. Tupfe sie SEHR trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die trockenen Kichererbsen mit Olivenöl, geräuchertem Paprikapulver, Kreuzkümmel, Cayennepfeffer, Knoblauchpulver und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile sie mit etwas Abstand in einer einzigen Schicht auf einem Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste sie 28–32 Minuten. Schüttle das Blech nach der Hälfte der Zeit, bis die Kichererbsen goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass sie vollständig auf dem Backblech abkühlen. Beim Abkühlen werden sie noch knuspriger. In einem offenen Behälter aufbewahren. Ein Deckel hält Dampf zurück und macht sie weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
