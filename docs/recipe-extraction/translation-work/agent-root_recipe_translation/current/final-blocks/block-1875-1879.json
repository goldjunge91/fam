        },
        {
          "position": 1,
          "text": "Gib Salz, Zucker, weißen Pfeffer und Sesamöl dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wenn die Brühe kocht, gib das Gemüse in den Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zum Andicken 1 Esslöffel Speisestärke und 2 Esslöffel Wasser in einer Schüssel verquirlen. Langsam in die Suppe rühren, bis sie die gewünschte Dicke erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle 1 Ei leicht mit Messer oder Gabel, gib es langsam in die Suppe und rühre 8 seconds um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Suppe in einer Schüssel und gib Frühlingszwiebeln darüber.",
