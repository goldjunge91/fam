      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200C/180C fan/gas 6 vor. Erhitze Olivenöl in einer großen ofenfesten Pfanne bei mittlerer Hitze. Brate Zwiebel, Chorizo und Paprika mit einer Prise Salz und Pfeffer 15 mins, bis das Gemüse weich ist und die Chorizo Öl abgegeben hat. Gib Paprika und Knoblauch dazu und gare sie noch ein paar Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Tomaten, Oliven und Butterbohnen dazu, vermenge alles und würze. Lege die Hähnchenschenkel hinein und würze sie gut. Stelle die Pfanne in den Ofen und backe alles 40 mins, bis die Hähnchenhaut knusprig und das Fleisch gar und zart ist. Mit Petersilie bestreuen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nach der Werbung ansehen (0.04):",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3 Ideen für günstige Eier",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
