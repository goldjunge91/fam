      "steps": [
        {
          "position": 0,
          "text": "Fette eine 20 x 20cm/8\" x 8\" große Backform ein und lege sie mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mars-Riegel und Butter in eine hitzebeständige Schüssel und stelle sie über einen Topf mit leicht köchelndem Wasser. Schmilz die Mischung unter Rühren mit dem Schneebesen, bis sie glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Mischung über die Rice Krispies in einer Rührschüssel und verrühre alles gleichmäßig. Drücke die Masse gleichmäßig in die vorbereitete Backform und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz die Milchschokolade in der Mikrowelle oder über einem Topf mit leicht köchelndem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die geschmolzene Schokolade auf der Rice-Krispies-Mischung und lass sie an einem kühlen Ort fest werden. Schneide sie anschließend in Quadrate und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
