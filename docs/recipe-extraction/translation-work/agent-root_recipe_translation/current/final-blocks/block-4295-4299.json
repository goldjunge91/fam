      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor und ritze die Oberfläche des Schinkens kreuzweise ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege den Schinken mit der Schnittfläche nach unten in einen Bräter und gib Wasser auf den Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Schinken mit Alufolie ab und backe ihn 2.5-3 Stunden, etwa 20 Minuten pro pound.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während der Schinken gart, verquirle Ahornsirup, Senf, Essig und braunen Zucker in einem kleinen Topf bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Schinken aus dem Ofen und spicke die Oberfläche dekorativ mit ganzen Nelken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche ihn großzügig mit Ahornsirupglasur und backe ihn ohne Abdeckung weitere 30 Minuten. Bestreiche ihn dabei alle 10 Minuten mit Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Schinken aus dem Ofen und lasse ihn vor dem Tranchieren 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn mit der restlichen warmen Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
