      "steps": [
        {
          "position": 0,
          "text": "Vermische warmes Wasser, Honig und Hefe und lasse alles 5 Minuten stehen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mehl, Salz und Öl zur Hefemischung und knete den Teig 8-10 Minuten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig mit einem feuchten Tuch ab und lasse ihn 30 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 4 gleich große Stücke und forme sie zu Kugeln. Drücke jeweils ein Loch in die Mitte und ziehe den Teig zu einem Bagel mit einem 2-inch Loch auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe einen großen Topf Wasser zum Kochen und gib 2 Esslöffel Honig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Bagels pro Seite 1-2 Minuten, bis sie schwimmen und wieder absinken. Nimm sie mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Bagels auf ein mit Backpapier ausgelegtes Backblech, bestreiche sie mit verquirltem Eigelb und bestreue sie mit Körnern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe sie bei 425°F 20-25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
