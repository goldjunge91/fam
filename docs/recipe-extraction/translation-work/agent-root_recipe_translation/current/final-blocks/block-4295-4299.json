          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Weiß- und Rotkohl mit einem Messer oder einer Mandoline in feine Streifen und gib sie in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle die Karotte, reibe sie und gib sie zum Kohl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Mayonnaise, weißen Essig, Zucker, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße das Dressing über die Kohlmischung und vermische alles gründlich, bis der Kohl gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse den Salat vor dem Servieren mindestens 30 Minuten ziehen, damit sich die Aromen entwickeln.",
