      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und fette eine quadratische 9-inch Backform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Maismehl, Mehl, Backpulver, Salz und Zucker in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage in einer weiteren Schüssel die Eier auf und vermische sie mit Milch und geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die feuchten Zutaten zu den trockenen und hebe sie vorsichtig unter, bis alles gerade vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die Maiskörner unter und gieße den Teig in die vorbereitete Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe das Brot 25-30 Minuten, bis ein hineingesteckter Zahnstocher sauber herauskommt und die Oberfläche goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse es 5 Minuten in der Form abkühlen und stürze es dann auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
