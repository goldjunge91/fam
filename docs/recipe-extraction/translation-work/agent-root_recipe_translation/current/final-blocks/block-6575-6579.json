      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in dünne Stifte von etwa 1/4 Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 3 Esslöffel Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Kartoffelstifte hinein und brate sie unter häufigem Rühren etwa 8-10 Minuten goldbraun und knusprig. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe die Kartoffeln an den Rand der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das übrige Öl in die Mitte und dünste gewürfelte Zwiebel 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage Eier in die Pfannenmitte und rühre sie leicht durch. Vermische sie nach und nach mit den Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sobald die Eier teilweise gestockt sind, hebe die Kartoffeln unter und gare weiter, bis die Eier vollständig gestockt sind, etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Chilisauce, Salz und Pfeffer und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
