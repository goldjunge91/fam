      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer Hitze und dünste gewürfelte Zwiebeln, gehackten Knoblauch und Ingwer an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Tomaten dazu und gare sie unter häufigem Rühren 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Kokosmilch hinein und bringe alles sanft zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Fischfilets vorsichtig in die köchelnde Sauce und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare den Fisch 8-10 Minuten, bis er durch ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Zitronensaft ein und passe die Würzung bei Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe kurz vor dem Servieren vorsichtig frischen Koriander unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere den Fisch mit Reis oder Fladenbrot und einer Gemüsebeilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
