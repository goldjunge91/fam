      "steps": [
        {
          "position": 0,
          "text": "Spüle den Reis unter kaltem Wasser, bis es klar abläuft, und gieße ihn gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und gib Kreuzkümmelsamen, Kardamomkapseln und Lorbeerblatt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste die Gewürze etwa 1 Minute unter vorsichtigem Rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zwiebel hinzu und gare sie etwa 2 Minuten glasig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge den gewaschenen Reis hinzu und rühre ihn 2 Minuten in der Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kokosmilch und Wasser dazu, gib Salz hinzu und rühre einmal um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse den Reis 18-20 Minuten köcheln, ohne den Deckel abzunehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Topf vom Herd und lasse den Reis zugedeckt 5 Minuten stehen. Lockere ihn mit einer Gabel auf und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
