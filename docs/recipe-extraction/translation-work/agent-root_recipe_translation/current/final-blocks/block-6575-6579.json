      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel und Tomate etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehacktes Fleisch oder Thunfisch dazu und gare es unter häufigem Rühren, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze die Mischung mit Salz, Pfeffer und Chiliflocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schiebe die gegarte Mischung an den Rand der Pfanne und schlage die Eier in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die Eier leicht durch und vermische sie teilweise gestockt mit der Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das Naan-Brot direkt auf die Ei-Fleisch-Mischung und gare es 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wende das Naan und backe die andere Seite goldbraun. Serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
