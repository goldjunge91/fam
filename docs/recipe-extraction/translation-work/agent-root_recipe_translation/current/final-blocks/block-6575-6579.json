          "images": []
        },
        {
          "position": 3,
          "text": "Stecke mariniertes Rindfleisch abwechselnd mit Gemüsestücken auf Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine Grillpfanne oder den Grill auf mittelhohe bis hohe Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Spieße auf den heißen Grill und gare sie auf jeder Seite 3-4 Minuten. Wende sie gelegentlich für gleichmäßiges Garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Grille weiter, bis das Fleisch gar und das Gemüse leicht angekohlt ist, insgesamt etwa 12-15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere heiß mit Limettenspalten und Reis oder Salat als Beilage.",
