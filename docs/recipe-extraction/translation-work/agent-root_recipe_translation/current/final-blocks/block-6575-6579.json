      "steps": [
        {
          "position": 0,
          "text": "Vermische gehackten Knoblauch, Ingwer, Limettensaft, Öl, Salz, Pfeffer und Kreuzkümmelpulver in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rindfleischwürfel hinein und vermenge sie, bis sie gleichmäßig bedeckt sind. Lasse sie 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Zwiebeln, Paprika und Tomaten in grobe Stücke.",
