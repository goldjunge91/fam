      ],
      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und reibe sie grob. Drücke dann mit einem sauberen Küchentuch überschüssige Flüssigkeit heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel fein und vermische sie mit den geriebenen Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze mit Salz, Pfeffer und Knoblauchpulver und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Kartoffelmischung gleichmäßig in der Pfanne und drücke sie mit einem Pfannenwender leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate sie 5-7 Minuten ungestört, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zerteile die Masse, rühre vorsichtig um und gare sie weitere 3-5 Minuten, bis alle Kartoffeln weich und goldbraun sind. Serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
