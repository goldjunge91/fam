      "steps": [
        {
          "position": 0,
          "text": "Lege Speckscheiben flach in eine große Pfanne und brate sie bei mittlerer Hitze 5-7 Minuten. Wende sie gelegentlich, bis sie knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege den gegarten Speck auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße den größten Teil des Speckfetts ab und lasse etwa 1 EL in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Butter in die Pfanne und schlage die Eier direkt hinein. Lasse zwischen ihnen etwas Platz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Eier bei mittlerer Hitze 3-4 Minuten für Spiegeleier mit flüssigem Eigelb oder länger, wenn du das Eigelb fester möchtest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze die Eier mit Salz und Pfeffer und serviere sie heiß neben dem Speck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
