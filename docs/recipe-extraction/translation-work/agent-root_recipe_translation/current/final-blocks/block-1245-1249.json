      "steps": [
        {
          "position": 0,
          "text": "Klopfe das Hähnchen flach. Wende es in verquirltem Ei und anschließend in mit Paprika und Salz gewürztem Panko.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Hähnchen in wenig Öl auf jeder Seite 4 Minuten knusprig und goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für die scharfe Paste: Verrühre geschmolzene Butter mit Cayennepfeffer, geräuchertem Paprikapulver und braunem Zucker. Bestreiche das Hähnchen damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für den Krautsalat: Vermische Kohl, Essig und griechischen Joghurt. Richte Reis und scharfes Hähnchen in einer Schale an und gib Krautsalat und Gewürzgurken darauf.",
          "timerMinutes": null,
