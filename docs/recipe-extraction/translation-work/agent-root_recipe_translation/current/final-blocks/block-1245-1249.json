      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis. Röste den Mais 4 Minuten in einer heißen, trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze den Lachs mit geräuchertem Paprikapulver. Brate ihn mit der Hautseite nach unten 4 Minuten an und wende ihn. Brate ihn weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche den Lachs mit BBQ-Sauce und brate ihn 1 Minute weiter, bis die Sauce karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte Reis und Lachs in einer Schale an und gib gerösteten Mais, Avocado, Koriander, Limette und Frühlingszwiebel darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
