      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und bestreichen Sie eine 9 x 13 Zoll große Auflaufform mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Garnelen in einer einzigen Schicht in der vorbereiteten Auflaufform anrichten und mit Salz, Pfeffer und Paprika würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einem kleinen Topf schmelzen und gehackten Knoblauch 1 Minute lang anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Panko-Semmelbrösel und frische Petersilie unterrühren, bis alles gut vermischt und geröstet ist (ca. 2 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Semmelbröselmischung gleichmäßig über die Garnelen streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kombinieren Sie in einem Messbecher Sherry und Hühnerbrühe und gießen Sie sie dann um die Garnelen in der Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15–20 Minuten backen, bis die Garnelen rosa und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Drücken Sie frischen Zitronensaft über das Gericht und servieren Sie es heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
