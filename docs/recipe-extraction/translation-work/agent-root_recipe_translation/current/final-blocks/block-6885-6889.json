      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie zwei runde 9-Zoll-Kuchenformen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Kakaopulver, Natron, Backpulver und Salz in einer mittelgroßen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer großen Schüssel weiche Butter und Kristallzucker cremig rühren, bis die Masse leicht und locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier einzeln unterrühren, dann Vanilleextrakt unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abwechselnd Mehlmischung und heißes Wasser zur Buttermischung geben, dabei mit Mehl beginnen und enden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig auf die vorbereiteten Formen verteilen und 30–35 Minuten backen, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Pfannen 10 Minuten abkühlen lassen, dann zum vollständigen Abkühlen auf Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zum Zuckerguss weiche Butter, Kakaopulver, Puderzucker und Milch glatt und schaumig schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Legen Sie einen Kuchenboden auf einen Teller und verteilen Sie den Zuckerguss darauf. Legen Sie dann den zweiten Boden darauf und bestreichen Sie die Oberseite und die Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
