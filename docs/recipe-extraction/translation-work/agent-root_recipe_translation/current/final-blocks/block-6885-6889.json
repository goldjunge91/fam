      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser und Hefe in einer Schüssel vermischen und 5 Minuten schaumig rühren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Salz und Olivenöl zur Hefemischung geben und verrühren, bis ein zottiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig auf einer bemehlten Arbeitsfläche 8-10 Minuten lang kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in eine geölte Schüssel geben, mit einem feuchten Tuch abdecken und 30–40 Minuten gehen lassen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heizen Sie den Ofen auf 450 °F vor und bestreichen Sie eine rechteckige 10 x 14 cm große Pfanne großzügig mit Pflanzenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig so ausdehnen, dass er in die Form passt, alle Ecken andrücken und 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteilen Sie die Marinara-Sauce gleichmäßig auf dem Teig und lassen Sie einen dünnen Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Peperoni und Mozzarella-Käse gleichmäßig über die Sauce verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "18–22 Minuten backen, bis der Käse geschmolzen ist und Blasen entstehen und die Krustenränder goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "2 Minuten abkühlen lassen, in Quadrate schneiden und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
