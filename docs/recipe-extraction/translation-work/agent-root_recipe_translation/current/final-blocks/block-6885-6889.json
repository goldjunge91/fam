      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser, Hefe und eine Prise Zucker in einer Schüssel vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz vermischen, dann Hefemischung und Olivenöl hinzufügen und verrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 8 Minuten lang kneten, bis er glatt ist, dann abgedeckt in einer geölten Schüssel 1 Stunde lang gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heizen Sie den Ofen auf 475 °F vor und ölen Sie eine 9-Zoll-Pizzaform mit tiefer Form mit Maismehl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dehnen Sie den Teig so, dass er in die Form passt, und bilden Sie an den Rändern einen 0.5-Zoll-Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerkleinerte Tomaten mit Oregano und Knoblauchpulver auf dem Teig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mozzarella-Käse und Peperoni über die Sauce schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "25–30 Minuten backen, bis die Kruste goldbraun ist und der Käse an den Rändern Blasen bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
