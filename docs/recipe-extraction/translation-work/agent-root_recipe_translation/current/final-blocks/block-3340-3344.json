      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer Hitze, gib Kreuzkümmelsamen hinzu und lasse sie 30 Sekunden aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Urad-Dal und Erdnüsse hinzu und rühre ständig, bis sie goldbraun sind, etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel, grüne Chili und Ingwer hinzu und dünste alles etwa 3 Minuten, bis die Zwiebel glasig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Grieß dazu und rühre 2 Minuten ständig, damit er leicht angeröstet wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße vorsichtig unter Rühren Wasser hinzu, damit keine Klümpchen entstehen, und salze nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf niedrig und lasse alles 8-10 Minuten köcheln; rühre gelegentlich um, bis der Grieß das Wasser aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Gericht auf eine Servierplatte und garniere es vor dem Servieren mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
