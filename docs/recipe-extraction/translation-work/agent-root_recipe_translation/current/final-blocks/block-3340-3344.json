      "steps": [
        {
          "position": 0,
          "text": "Säubere und schuppe den Fisch und ritze beide Seiten flach diagonal ein, damit er gleichmäßig gart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Öl in einer großen Pfanne und brate den Fisch bei mittelhoher Hitze je Seite 4-5 Minuten goldbraun. Lege ihn dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze in einem kleinen Wok oder einer Pfanne die übrigen 2 Esslöffel Öl bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste Sichuan-Pfefferkörner und getrocknete Chilis 1 Minute, gib dann gehackten Knoblauch und Ingwer hinzu und rühre 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Sojasauce, Essig und Zucker und gib die Mischung in den Wok.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Sauce über den gegarten Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue die gerösteten Pfefferkörner und Chilis darüber und garniere mit geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
