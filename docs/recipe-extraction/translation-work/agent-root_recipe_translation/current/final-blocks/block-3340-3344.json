      "steps": [
        {
          "position": 0,
          "text": "Koche die Eier 10 Minuten in Wasser, bis sie hart sind, und kühle sie dann in Eiswasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage die Schale vorsichtig rundherum an, ohne sie zu entfernen, sodass ein Netz aus Rissen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe 2 Tassen Wasser mit Sojasauce, Salz, Zucker, Sternanis, Zimt und Ingwer zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib schwarze Teeblätter hinzu und lasse sie 5 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die angeritzten Eier in den aufgebrühten Sud.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles 30-40 Minuten köcheln, damit die Flüssigkeit durch die Risse einzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd und lasse die Eier mindestens 2 Stunden oder für eine kräftigere Farbe über Nacht im Sud ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schäle die Eier und serviere sie kalt oder bei Raumtemperatur mit Ingwerscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
