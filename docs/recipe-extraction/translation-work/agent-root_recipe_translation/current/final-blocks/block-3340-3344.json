      "steps": [
        {
          "position": 0,
          "text": "Pochiere die Hähnchenbrüste 12-15 Minuten in kochendem Salzwasser, bis sie vollständig gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen heraus und lasse es leicht abkühlen, dann zupfe es von Hand in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste Sichuan-Pfefferkörner und getrocknete Chilis 1 Minute in einer trockenen Pfanne und zerstoße sie anschließend grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Sojasauce, Essig, Sesamöl und Zucker in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hacke Knoblauch und Ingwer fein und rühre beides in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das gezupfte Hähnchen auf eine Servierplatte und gieße die Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue geröstete Pfefferkörner, Chilis, zerstoßene Erdnüsse und geschnittene Frühlingszwiebeln über das Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse alles 5 Minuten ziehen, damit sich die Aromen entfalten, und serviere es bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
