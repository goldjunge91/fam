      "steps": [
        {
          "position": 0,
          "text": "Die Hähnchenbrust in dünne, mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauch fein hacken. Maisstärke und Wasser in einer kleinen Schüssel zu einer glatten Mischung verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 EL Öl in einem Wok oder einer großen Pfanne bei starker Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Hähnchen hinzufügen und 4 Minuten unter Rühren braten, bis es fast gar ist. Dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das restliche Öl und den gehackten Knoblauch in den Wok geben. 30 Sekunden unter Rühren braten, bis der Knoblauch duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brokkoliröschen hinzufügen und 3 Minuten unter Rühren braten, bis sie leuchtend grün sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Hähnchen zurück in den Wok geben und Sojasauce, Austernsauce, braunen Zucker und Hühnerbrühe hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Maisstärkemischung einrühren und 1 Minute garen, bis die Sauce eindickt. Dann auf Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
