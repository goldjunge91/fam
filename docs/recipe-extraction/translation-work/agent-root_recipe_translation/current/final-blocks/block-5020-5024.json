      "steps": [
        {
          "position": 0,
          "text": "Die Glasnudeln 10 Minuten in heißem Wasser einweichen, bis sie weich sind. Dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Hähnchen in mundgerechte Stücke und die Garnelen längs halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem Wok oder einer großen Pfanne bei starker Hitze erhitzen. Gehackten Knoblauch und Chilis hinzufügen und 30 Sekunden unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hähnchen und Garnelen hinzufügen und 3–4 Minuten garen, bis sie durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Zwiebel und Paprika hinzufügen und 2 Minuten unter Rühren braten, bis sie leicht weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die abgetropften Nudeln hinzufügen und alles 1 Minute vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sojasauce und Limettensaft über die Mischung gießen, gut vermengen und weitere 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Serviertellern anrichten und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
