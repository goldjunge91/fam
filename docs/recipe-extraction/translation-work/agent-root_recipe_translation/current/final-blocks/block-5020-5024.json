      "steps": [
        {
          "position": 0,
          "text": "Den Tofu zwischen Küchenpapier 10 Minuten pressen, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den gepressten Tofu in 1-Zoll-Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maisstärke, Salz und schwarzen Pfeffer in einer flachen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Tofuwürfel in der Maisstärkemischung wenden, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einer großen Pfanne bei mittelhoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Tofuwürfel portionsweise je Seite 3–4 Minuten goldbraun und knusprig braten. Dann auf einen mit Küchenpapier ausgelegten Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sojasauce, Limettensaft, gehackten Knoblauch, gehackte Chili und Wasser in einer kleinen Schüssel zu einer Dip-Sauce verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den knusprigen Tofu mit der Dip-Sauce und Gemüse oder Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
