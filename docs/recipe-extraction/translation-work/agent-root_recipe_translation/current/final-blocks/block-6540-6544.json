          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ziehe die Kubideh von den Spießen auf warmes Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege sie mit gewürfelten Tomaten und Zwiebeln sowie frischen Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie sofort mit Naturjoghurt als Beilage.",
          "timerMinutes": null,
