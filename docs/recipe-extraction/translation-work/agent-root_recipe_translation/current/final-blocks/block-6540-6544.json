      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und bräune das Rindfleisch rundherum an. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Zwiebeln und Knoblauch etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kreuzkümmel, Paprikapulver, Salz und Pfeffer dazu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Rindfleisch mit der Brühe zurück in den Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 35-40 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Kichererbsen hinzu und lasse alles weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke ab und serviere die Suppe heiß in Schalen mit Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
