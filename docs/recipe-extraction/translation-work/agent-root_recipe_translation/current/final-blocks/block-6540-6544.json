      "steps": [
        {
          "position": 0,
          "text": "Vermische Rinderhackfleisch, Zwiebel, Knoblauch, Semmelbrösel, Ei, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge alles vorsichtig mit den Händen, ohne das Fleisch zu stark zu kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme 12-16 ovale Fleischbällchen von etwa 2 Zoll Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Fleischbällchen hinein und brate sie auf jeder Seite 3-4 Minuten, bis sie gebräunt und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege sie auf einen mit Küchenpapier ausgelegten Teller und serviere sie warm mit frischem Brot oder Joghurt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
