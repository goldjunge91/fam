      "steps": [
        {
          "position": 0,
          "text": "Poblanos direkt über einer Gasflamme oder unter einem Grill rösten, bis sie ganz schwarz sind, dann für 10 Minuten in eine Plastiktüte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verkohlte Haut abziehen, der Länge nach vorsichtig einen Schlitz einschneiden und die Kerne entfernen, dabei den Pfeffer intakt lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füllen Sie jede Paprika mit 2 Unzen Oaxaca-Käse und legen Sie sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2 EL Öl in einem Topf erhitzen, gehackten Knoblauch anbraten, dann Tomatensauce, Zwiebelpulver, Salz und Pfeffer hinzufügen; 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier mit 1/4 TL Salz schaumig schlagen, dann jede gefüllte Paprika leicht in Mehl wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den restlichen 1 EL Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und die Paprikaschoten auf jeder Seite 2 Minuten braten, bis die Eischicht fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Paprikaschoten auf Servierteller verteilen, mit warmer Tomatensoße übergießen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
