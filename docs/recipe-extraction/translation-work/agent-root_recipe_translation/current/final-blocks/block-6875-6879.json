      "steps": [
        {
          "position": 0,
          "text": "5 Poblanos über einer Flamme rösten, bis sie schwarz sind, 10 Minuten lang in eine Plastiktüte legen und dann schälen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 geröstete Poblanos in Streifen (Rajas) schneiden und mit geschnittenen Zwiebeln und gehacktem Knoblauch in 1 EL Öl 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mais und Sahne einrühren, mit 1/2 TL Salz und Pfeffer würzen, dann 5 Minuten köcheln lassen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneiden Sie die restlichen 3 gerösteten Poblanos auf und entfernen Sie vorsichtig die Kerne, sodass die Paprika intakt bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füllen Sie jede Paprika mit 2 Unzen Oaxaca-Käse und 2 EL Rajas-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier mit 1/4 TL Salz schaumig schlagen und gefüllte Paprika leicht in Mehl wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "3 EL Öl in einer Pfanne erhitzen und die Paprika pro Seite 2 Minuten braten, bis die Eischicht fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Paprikaschoten mit den restlichen Rajas und der Sahnesoße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
