      "steps": [
        {
          "position": 0,
          "text": "Kochen Sie Wasser in einem großen Topf und kochen Sie den Mais 8–10 Minuten lang, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während der Mais kocht, Mayonnaise, Butter, gehackten Knoblauch und Chilipulver in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mais abtropfen lassen und mit Papiertüchern trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreichen Sie jedes Ohr großzügig mit der Mayonnaise-Butter-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie jedes Ohr in einem Teller mit zerbröckeltem Cotija-Käse, bis es gut bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Chilipulver und frischem Koriander bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Drücken Sie frischen Limettensaft über jedes Ohr und servieren Sie es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
