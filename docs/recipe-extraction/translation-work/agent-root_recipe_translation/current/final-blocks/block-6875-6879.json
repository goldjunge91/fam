      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneiden Sie die Poblanos der Länge nach auf, entfernen Sie die Kerne und lassen Sie den Stiel intakt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Paprika in heißem Öl auf jeder Seite 2-3 Minuten braten, bis sie verkohlt und zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprika herausnehmen und auf einem Teller anrichten, dann den gehackten Knoblauch im restlichen Öl anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Knoblauchöl über die Paprika träufeln und mit Queso Fresco, Koriander, Salz und Pfeffer bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Limettensaft abschließen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
