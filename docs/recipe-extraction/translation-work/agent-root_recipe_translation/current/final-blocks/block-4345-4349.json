      "steps": [
        {
          "position": 0,
          "text": "Das Öl in einem großen Topf erhitzen und die Rindfleischstücke von allen Seiten anbräunen, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In demselben Topf Zwiebel, Sellerie und Knoblauch etwa 5 Minuten glasig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Tomatenmark einrühren und 1 Minute leicht karamellisieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Rindfleisch wieder in den Topf geben und Brühe, Lorbeerblätter, Thymian und Worcestersauce hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 60-90 Minuten köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sherry hinzufügen und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Suppe in Schalen schöpfen und vor dem Servieren mit gehackten hart gekochten Eiern garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
