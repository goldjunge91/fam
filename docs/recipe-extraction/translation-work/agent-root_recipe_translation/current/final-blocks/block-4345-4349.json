      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 325°F vorheizen und den Truthahn 1 Stunde vor dem Garen aus dem Kühlschrank nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Truthahn mit Küchenpapier trocken tupfen und mit der Brustseite nach oben in einen Bräter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die weiche Butter mit gehacktem Thymian und Salbei vermischen und unter sowie auf der Haut des Truthahns verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Innen und außen mit Salz und Pfeffer würzen und die Höhle mit Zitronen- und Zwiebelhälften füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Brühe auf den Boden des Bräters gießen und den Truthahn locker mit Alufolie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwa 13-15 Minuten pro Pfund braten und die Folie in den letzten 45 Minuten entfernen, damit die Haut bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Garprobe machen, wenn ein Thermometer im dicksten Teil der Keule 165°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Truthahn vor dem Tranchieren und Servieren 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
