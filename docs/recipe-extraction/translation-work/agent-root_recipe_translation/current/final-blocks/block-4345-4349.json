      "steps": [
        {
          "position": 0,
          "text": "Ein Backblech mit Wachspapier auslegen und die Eisstiele mit Abstand darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Ahornsirup in einen Topf mit schwerem Boden gießen und bei mittlerer bis hoher Hitze aufkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Zuckerthermometer am Topf befestigen und den Sirup auf 235°F (Soft-Ball-Stufe) erhitzen und dabei etwa 15-20 Minuten nicht rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vom Herd nehmen und Butter und Salz einrühren, bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den heißen Sirup streifenförmig auf das Wachspapier und jeweils über einen Eisstiel löffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Bonbons vollständig abkühlen lassen, bis sie fest sind, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jedes Bonbon in Wachspapier wickeln und bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
