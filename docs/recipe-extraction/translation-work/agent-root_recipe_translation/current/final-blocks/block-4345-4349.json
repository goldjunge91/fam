          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zügig löffelweise Portionen der Masse auf das vorbereitete Backblech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Pralinen bei Raumtemperatur etwa 20 Minuten abkühlen und fest werden lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
