      "steps": [
        {
          "position": 0,
          "text": "Krabbenfleisch, 1/4 Tasse Semmelbrösel, Mayonnaise, Ei, Old-Bay-Gewürz, Senf und Worcestersauce in einer Schüssel vorsichtig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Masse zu 4 etwa 3 Zoll breiten Frikadellen formen und 15 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die übrigen Semmelbrösel in eine flache Schale geben und jede Frikadelle gleichmäßig darin wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Krabbenküchlein pro Seite 3-4 Minuten braten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf einen mit Küchenpapier ausgelegten Teller geben, damit überschüssiges Öl abtropfen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit Zitronenspalten und Remouladensauce oder Tartarsauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
