          "position": 0,
          "text": "Vermenge Mehl, Wasser und Salz, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 3 Minuten und lass ihn dann 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig auf einer bemehlten Fläche zu einem dünnen Rechteck aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche den Teig mit 3 tablespoons Öl und bestreue ihn mit Salz, schwarzem Pfeffer und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig von einem Ende her fest zu einer Spirale auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wickle die Teigrolle zu einer flachen Spirale und lass sie 3 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze 1 cup Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib die Teigspirale vorsichtig ins heiße Öl und frittiere sie pro Seite 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Hebe den Kuchen mit einer Schaumkelle heraus, lass ihn auf Küchenpapier abtropfen und bestreue ihn mit Sesam.",
