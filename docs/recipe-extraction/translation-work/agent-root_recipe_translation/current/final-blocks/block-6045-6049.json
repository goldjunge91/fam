      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und gib Kreuzkümmelsamen, Zimt und Kardamom hinein. Brate alles an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gemahlene Zwiebeln dazu und gare sie 5 Minuten, bis sie weich und leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Ingwer und Knoblauch hinzu und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Lammwürfel dazu und brate sie 5-7 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre rotes Chilipulver ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Joghurt unter ständigem Rühren langsam dazu, damit er nicht gerinnt. Gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füge Wasser und Salz hinzu, bringe alles zum Kochen und reduziere dann die Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf ab und lass das Gericht 1 hour köcheln, bis das Lamm zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere es heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
