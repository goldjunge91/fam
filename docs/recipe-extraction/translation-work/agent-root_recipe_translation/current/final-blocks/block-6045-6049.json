      "steps": [
        {
          "position": 0,
          "text": "Vermenge das Lammhackfleisch mit der Hälfte der gehackten Zwiebeln, Ingwer, Knoblauch und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme aus der Mischung 12-16 Fleischbällchen und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und brate die übrigen Zwiebeln goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Fenchelsamen dazu und gare sie 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Joghurt und rotes Chilipulver hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Fleischbällchen vorsichtig in die Sauce und wende sie behutsam darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Wasser dazu und bringe alles zum Kochen. Reduziere die Hitze, decke den Topf ab und lass alles 45 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre gelegentlich um und prüfe, ob die Fleischbällchen durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht heiß mit Reis.",
