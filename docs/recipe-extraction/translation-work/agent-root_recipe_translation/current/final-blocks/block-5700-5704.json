      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf mit schwerem Boden bei mittlerer bis hoher Hitze. Brate Rinder- und Schweinehackfleisch etwa 8 Minuten an und zerteile es dabei mit einem Löffel, bis es gebräunt ist. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel, Karotte und Sellerie dazu und gare alles etwa 6 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre den gehackten Knoblauch ein und gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomatenmark dazu und gare es unter ständigem Rühren 2 Minuten, damit sich das Aroma entfaltet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße gehackte Tomaten und Rinderbrühe dazu, bringe alles zum Köcheln und reduziere die Hitze auf niedrige Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Sauce ohne Deckel 60-90 Minuten köcheln und rühre gelegentlich um, bis sie eindickt und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Milch und Oregano ein und lass alles weitere 10 Minuten köcheln. Schmecke anschließend mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Sauce zu frisch gekochter Pasta wie Tagliatelle oder Pappardelle und geriebenem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
