      "steps": [
        {
          "position": 0,
          "text": "Häufe das Mehl auf einer sauberen Arbeitsfläche und forme in der Mitte eine Mulde. Gib die Eier hinein und verrühre sie mit einer Gabel mit dem Mehl, bis ein grober Teig entsteht. Knete ihn 10 Minuten glatt und elastisch, wickle ihn ein und lass ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste frischen Spinat mit gehacktem Knoblauch bei mittlerer Hitze etwa 4 Minuten, bis er zusammenfällt und überschüssige Flüssigkeit verdampft ist. Lass ihn leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Ricotta, gekochten Spinat, die Hälfte des Parmesans, Zitronenschale, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig mit einer Nudelmaschine oder einem Nudelholz etwa 1/16-inch dünn aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide den Teig in 2-inch große Quadrate und gib jeweils 1 Teelöffel Ricottafüllung in die Mitte jedes zweiten Quadrats.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Ränder der gefüllten Quadrate mit Wasser, lege leere Quadrate darauf und drücke die Ränder fest zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen. Koche die Ravioli portionsweise, bis sie an die Oberfläche steigen, und dann noch 30 Sekunden, insgesamt etwa 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass Butter mit Salbeiblättern in einer kleinen Pfanne bei mittlerer Hitze schmelzen und schwenke die abgetropften Ravioli vorsichtig darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die Ravioli sofort mit dem restlichen Parmesan und frisch gemahlenem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
