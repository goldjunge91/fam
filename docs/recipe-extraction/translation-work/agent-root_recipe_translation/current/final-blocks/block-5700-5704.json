      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenoberkeulen in 1.5-inch große Würfel und die Zwiebel und Paprika in 1.5-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Olivenöl, Zitronensaft, gehackten Knoblauch, Paprikapulver, Oregano, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende die Hähnchenstücke in der Marinade und lass sie bei Zimmertemperatur 15-20 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke Hähnchen abwechselnd mit Zwiebel- und Paprikastücken auf die Metallspieße und verteile alles gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Grill auf mittlere bis hohe Hitze vor und öle den Rost leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Spieße 12-15 Minuten und wende sie alle 3 Minuten, bis das Hähnchen gar und das Gemüse leicht angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Spieße 2 Minuten ruhen und serviere sie mit Fladenbrot, Gurke, Tomate und Tzatziki.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
