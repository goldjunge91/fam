      "steps": [
        {
          "position": 0,
          "text": "Öl in einem holländischen Ofen erhitzen und die Rindfleischstücke portionsweise anbraten, bis sich eine tiefe Farbe entwickelt, etwa 8 Minuten pro Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rindfleisch herausnehmen und die gewürfelten Zwiebeln und Karotten etwa 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streuen Sie Mehl über das Gemüse und rühren Sie es 1 Minute lang um, sodass eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie Guinness und Rinderbrühe hinzu, kratzen Sie die gebräunten Stücke ab und fügen Sie dann das Rindfleisch mit Tomatenmark und Thymian hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und bei schwacher Hitze 90 Minuten köcheln lassen, bis das Rindfleisch zart ist, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln in Stücke schneiden und in den letzten 20 Minuten des Garvorgangs in den Topf geben; nach Belieben würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Füllung in eine Kuchenform geben, mit dem Kuchenboden bedecken, mit verquirltem Ei bestreichen und bei 400 °C 20–25 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
