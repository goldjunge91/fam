      "steps": [
        {
          "position": 0,
          "text": "Knoblauch, Korianderwurzeln und schwarzen Pfeffer mit Mörser und Stößel zu einer Paste zerstoßen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischen Sie die Paste mit Fischsauce, Sojasauce, Palmzucker, Limettensaft und Kokosmilch, um eine Marinade herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenschenkel gründlich mit Marinade bestreichen und mindestens 1 Stunde im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hähnchen über Holzkohle oder Gas 20–25 Minuten grillen, dabei häufig wenden, bis die Haut verkohlt ist und das Fleisch eine Innentemperatur von 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während der letzten 5 Minuten des Garvorgangs mit der restlichen Marinade bestreichen und mit Klebreis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
