      "steps": [
        {
          "position": 0,
          "text": "Reis nach Packungsanweisung kochen und in Servierschüsseln beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch in einer Pfanne mit 1 Esslöffel Sojasauce und 1 gehackten Knoblauchzehe anbraten und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spinat in kochendem Salzwasser 1 Minute blanchieren, gut abtropfen lassen und mit 0.5 Teelöffel Sesamöl und Salz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Julienne-Karotten und Zucchini jeweils einzeln in einer heißen Pfanne mit 0.5 Teelöffel Sesamöl und gehacktem Knoblauch jeweils 2-3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier mit der Sonnenseite nach oben in einer separaten Pfanne mit etwas Öl braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochtes Gemüse und Rindfleisch abschnittsweise auf dem Reis anrichten, Spiegelei in die Mitte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gochujang mit 1 Esslöffel Sesamöl und den restlichen 2 Esslöffeln Sojasauce zu einer Soße vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Sauce über Bibimbap träufeln und vor dem Essen gründlich vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
