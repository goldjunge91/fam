      "steps": [
        {
          "position": 0,
          "text": "Spüle den Reis unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe das Wasser zum Kochen und gib den Reis dazu. Rühre um, damit er nicht am Topfboden klebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf mittelniedrige Stufe und lasse den Reis 35-40 Minuten unter gelegentlichem Rühren köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spüle das eingelegte Senfgemüse ab und hacke es fein, um überschüssiges Salz zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate das Schweinehackfleisch in einer separaten Pfanne bei mittlerer Hitze krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Ingwer und eingelegtes Senfgemüse zum Schweinefleisch und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre die Schweinefleischmischung unter den Reisbrei und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und weißem Pfeffer, beträufle den Brei mit Sesamöl und garniere ihn mit Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
