      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Backpulver. Gib nach und nach Wasser dazu und knete alles zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 5 Minuten, decke ihn mit Frischhaltefolie ab und lasse ihn 30 Minuten bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spüle währenddessen den Reis ab. Bringe 8 Tassen Wasser zum Kochen, gib den Reis dazu und lasse ihn 40 Minuten köcheln, bis er cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig auf einer geölten Fläche zu einem dünnen Rechteck von etwa 1/4 Zoll Dicke aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide den Teig der Länge nach in Streifen von etwa 1 Zoll Breite und 8 Zoll Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F. Frittiere die Teigstreifen vorsichtig 2-3 Minuten pro Seite, bis sie goldbraun und aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die frittierten Youtiao auf Küchenpapier abtropfen und schneide sie schräg in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze den Reisbrei mit weißem Pfeffer, Salz und Sesamöl. Belege ihn mit Youtiao-Stücken und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
