      "steps": [
        {
          "position": 0,
          "text": "Entferne die dünne Silberhaut auf der Rückseite der Rippchen, indem du ein Messer darunter schiebst und sie abziehst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische braunen Zucker, Paprikapulver, schwarzen Pfeffer, Knoblauchpulver, Zwiebelpulver, Chilipulver, Salz und Cayennepfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Gewürzmischung großzügig auf beide Seiten der Rippchen und drücke sie gut an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 275 °F vor und lege die Rippchen mit der Fleischseite nach oben auf ein mit Folie ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie 4.5-5 Stunden, bis das Fleisch sehr zart ist und sich leicht vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Rippchen 5 Minuten ruhen, schneide sie zwischen den Knochen auseinander und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
