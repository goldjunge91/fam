      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln 20 Minuten in Salzwasser, bis sie weich sind. Pelle sie und schneide sie in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Entferne die Stiele der Ají-Chilis und weiche sie 10 Minuten in heißem Wasser ein. Gieße sie anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die eingeweichten Chilis mit Käse, Milch, Erdnüssen, Knoblauch und Crackern glatt. Schmecke die Soße mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer kleinen Pfanne und brate die Soße 2–3 Minuten leicht an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte die warmen Kartoffelscheiben auf einer Servierplatte an und gieße die Soße darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege sie mit Scheiben hart gekochter Eier und Oliven und serviere das Gericht bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
