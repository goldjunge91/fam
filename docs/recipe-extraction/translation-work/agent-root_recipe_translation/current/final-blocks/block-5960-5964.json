      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350 °F vor und fette eine 9 x 13 Zoll große Auflaufform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Nudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, saure Sahne, Hüttenkäse, 2 Esslöffel geschmolzene Butter, Zucker, Zimt, Salz und Vanille.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische die Nudeln mit der Eiermasse und gib alles in die vorbereitete Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die Cornflakes mit den übrigen 2 Esslöffeln geschmolzener Butter und streue sie gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Auflauf 35–40 Minuten, bis er goldbraun und in der Mitte fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse ihn vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
