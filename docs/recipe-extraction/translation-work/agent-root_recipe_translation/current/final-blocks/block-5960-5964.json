      "steps": [
        {
          "position": 0,
          "text": "Schäle die Karotten und schneide sie in dünne Scheiben. Schäle die Kartoffeln und schneide sie ebenfalls in gleich große dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter in einer großen, flachen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Karotten- und Kartoffelscheiben, Salz, Zucker und Wasser hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Pfanne ab und lasse alles 15–20 Minuten köcheln. Rühre gelegentlich um, bis das Gemüse weich und die Flüssigkeit größtenteils aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Deckel ab und gare das Gemüse weitere 2–3 Minuten, damit es leicht bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit schwarzem Pfeffer und garniere das Gericht vor dem Servieren mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
