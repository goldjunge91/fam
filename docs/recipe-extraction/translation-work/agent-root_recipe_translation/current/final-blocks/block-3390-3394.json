          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lachsstücke und Tofuwürfel hinzufügen und 8-10 Minuten köcheln lassen, bis der Lachs gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Sake und Sojasauce abschmecken.",
