      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle die Eier, bis sie gar sind. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl dazu und brate gehackten Knoblauch und gewürfelte Zwiebel 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib kalten Reis dazu, löse Klumpen und brate ihn 2 Minuten unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre gefrorene Erbsen ein und erhitze sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe das Krabbenfleisch vorsichtig unter, damit es nicht zu sehr zerfällt, und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Eier zurück in die Pfanne, füge Sojasoße hinzu und vermenge alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer, garniere mit Frühlingszwiebeln und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
