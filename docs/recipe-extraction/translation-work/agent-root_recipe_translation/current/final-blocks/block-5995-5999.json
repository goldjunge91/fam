      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und verquirle die Eier darin. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das restliche Öl in die Pfanne und brate gehackten Knoblauch und gewürfelte Zwiebel etwa 2 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelten Schinken hinzu und erhitze ihn 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib kalten Reis dazu, löse Klumpen und brate ihn 2 Minuten unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre gefrorene Erbsen ein und erhitze sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die verquirlten Eier zurück in die Pfanne und hebe alles vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz, Pfeffer und Limettensaft und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß als Hauptgericht oder Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
