      "steps": [
        {
          "position": 0,
          "text": "Am Vortag Brühe mit Gelatine erhitzen, in eine Form gießen und kalt stellen, bis ein fester Aspik entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Aspik in kleine Würfel schneiden. Schweinefleisch mit Soja, Sesamöl, Ingwer, Wein und Zucker vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Aspikwürfel unter die Schweinefleischmischung heben und 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig aus Mehl und heißem Wasser mischen, 10 Minuten kneten, 30 Minuten ruhen lassen und sehr dünn ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füllen und jede Teigtasche mit mindestens 18 Falten verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf geöltem Backpapier 8–10 Minuten dämpfen. Mit Ingwer-Reisessig-Dip servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
