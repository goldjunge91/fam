          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Füllung: Gewürfeltes Char Siu mit Austernsauce und angerührter Maisstärke andicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig: Mehl, Zucker, Hefe, Backpulver, Öl und Wasser vermengen. 8 Minuten kneten und 1 Stunde ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in Kugeln teilen, flach drücken, mit Char Siu füllen und zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "15 Minuten ruhen lassen, dann 12 Minuten dämpfen. Warm servieren.",
