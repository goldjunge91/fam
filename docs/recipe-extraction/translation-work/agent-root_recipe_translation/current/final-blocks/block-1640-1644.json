    {
      "externalId": "waivy:mfr-dim-xiao-long-bao",
      "slug": "mfr-dim-xiao-long-bao",
      "title": "Xiao Long Bao – Suppen-Teigtaschen",
      "instructions": "Shanghais zauberhafteste Kreation: gedämpfte Teigtaschen mit dünnem Teig, die einen Fleischklops in heißer, herzhafter Brühe umschließen. Die Brühe entsteht aus Aspik, das unter die Füllung gemischt wird und beim Dämpfen schmilzt. Erst seitlich anbeißen und die Suppe schlürfen, dann essen.",
      "prepTimeMinutes": 90,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Die Aspik-Technik klingt kompliziert, besteht aber nur aus Gelatine und Brühe. Eine Packung pro Portion reicht.",
        "Eine große Menge zubereiten und einfrieren. Gefroren 12 Minuten dämpfen.",
        "Der dünne Teig braucht etwas Übung. Mach dir keine Sorgen, wenn die ersten nicht perfekt werden."
      ],
      "substitutions": [
        {
          "forIngredientId": "gelatin",
          "swap": "Agar-Agar als vegetarische Variante"
        },
        {
          "forIngredientId": "ground-pork",
          "swap": "Die klassische Shanghaier Variante kombiniert Schweinefleisch und Krabben."
        }
