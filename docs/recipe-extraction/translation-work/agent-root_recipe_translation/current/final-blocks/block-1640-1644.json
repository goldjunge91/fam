    {
      "externalId": "waivy:mfr-dim-siu-mai",
      "slug": "mfr-dim-siu-mai",
      "title": "Siu Mai – offene Schweinefleisch-Garnelen-Teigtaschen",
      "instructions": "Die berühmte offene Dim-Sum-Teigtasche: ein gefältelter Korb mit Füllung aus Schweinefleisch, Garnelen und Wasserkastanien, garniert mit Karotte oder Rogen. Gedämpft, bis die Füllung gerade fest und der Teig weich ist. Viel einfacher als Har Gow und genauso köstlich.",
      "prepTimeMinutes": 35,
      "cookTimeMinutes": 12,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Wantanblätter sind sehr günstig und leicht erhältlich.",
        "Wasserkastanien aus der Dose sind günstig und sorgen für den nötigen Biss.",
        "Siu Mai lassen sich ungegart gut einfrieren. Gefroren 14 Minuten dämpfen."
      ],
      "substitutions": [
        {
          "forIngredientId": "water-chestnuts",
          "swap": "Jicama für eine ähnliche Knusprigkeit"
        },
        {
