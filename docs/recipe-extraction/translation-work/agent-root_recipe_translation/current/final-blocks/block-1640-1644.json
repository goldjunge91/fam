      "steps": [
        {
          "position": 0,
          "text": "Kohl fein hacken, salzen und alles Wasser ausdrücken. Das sorgt für eine saftige Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinefleisch mit Ingwer, Knoblauch, Soja, Sesamöl, Reiswein, Frühlingszwiebel und ausgedrücktem Kohl vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 TL Füllung auf ein Teigblatt geben, Ränder befeuchten, falten und zum Verschließen kräuseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer Pfanne mit flachem Boden erhitzen. Teigtaschen mit der flachen Seite nach unten hineinsetzen und 2 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "¼ Tasse Wasser angießen, sofort abdecken und 6 Minuten dämpfen, bis die Füllung gar ist. Ohne Deckel 1 Minute knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Dip aus Sojasauce und Reisessig servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
