      "steps": [
        {
          "position": 0,
          "text": "1 tbsp Öl in einem Wok oder einer großen Pfanne bei starker Hitze erhitzen und Eier unter Rühren stocken lassen; in kleine Stücke teilen, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Restliches Öl hinzufügen und gehackten Knoblauch sowie geschnittene Chili 30 Sekunden anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen oder Hähnchen hinzufügen und etwa 3-4 Minuten garen, bis alles durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebel hinzufügen und 1 Minute pfannenrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reis hinzufügen, Klumpen zerteilen und 3-4 Minuten unter ständigem Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasauce angießen und gründlich vermischen, bis der Reis gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Eier und geschnittene Frühlingszwiebeln zurück in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Alles 1 Minute vermengen und mit einem Spritzer Limettensaft abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort auf Tellern servieren, nach Wunsch mit Röstschalotten und einem Spiegelei garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
