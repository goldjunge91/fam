      "steps": [
        {
          "position": 0,
          "text": "Hühnerbrühe mit Kurkuma, gehacktem Knoblauch, Ingwer, Zwiebel und Zitronengras zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchenbrust hinzufügen und 20 Minuten köcheln lassen, bis sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen herausnehmen, zerpflücken und beiseitestellen; Brühe abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe zurück in den Topf geben und erneut leicht köcheln lassen; mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reisnudeln separat nach Packungsanweisung kochen, abgießen und auf Schalen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerpflücktes Hähnchen und je ein halbes gekochtes Ei auf die Nudeln in jede Schale legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiße Brühe darüber gießen und mit Röstschalotten sowie frischem Limettensaft garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
