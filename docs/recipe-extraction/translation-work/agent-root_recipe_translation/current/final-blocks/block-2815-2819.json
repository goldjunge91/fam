      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter würfeln, 10 Minuten in Wasser kochen, dann abgießen und abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Topf erhitzen und gehackten Knoblauch sowie gewürfelte Zwiebel etwa 2 Minuten anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vorgekochte Schweineschulter hinzufügen und 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser und Essig angießen, Lorbeerblatt hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren und 15 Minuten köcheln lassen, bis das Schweinefleisch fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schweineleber in Stücke schneiden und in den Topf geben; 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schweineblut nach und nach unter ständigem Rühren hinzufügen, damit keine Klumpen entstehen; mit Sojasauce würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Ganze rote Chilis hinzufügen und 10-15 Minuten köcheln lassen, bis das Blut gar ist und die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Abschmecken und heiß mit weißem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
