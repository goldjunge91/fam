      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermenge Trockenhefe mit etwas lauwarmer Milch und rühre, bis sie sich aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Buchweizen und Mehl in eine Schüssel und forme in der Mitte eine Mulde. Füge die Hefemischung und Milch hinzu und verrühre alles zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Eier, Salz und Vanillezucker unter. Lass den Teig etwa 45 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze die Poffertjespfanne und gib in jede Vertiefung etwas Butter. Fülle sie halb mit Teig und backe die Poffertjes, bis die Oberfläche leicht trocken wird. Wende sie mit einer kleinen Gabel und backe die andere Seite goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Poffertjes mit Butter und Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
