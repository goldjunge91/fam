      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 160˚C (320˚F) vor. Lege eine Kuchenform mit Backpapier aus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge alle trockenen Zutaten in einer großen Schüssel. Erhitze die Milch in einem kleinen Topf, bis sie fast kocht, aber nicht ganz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Milch unter Rühren langsam zu den trockenen Zutaten. Nicht zu lange rühren! Sobald ein glatter Teig entstanden ist, gieße ihn in die Form. Streue Hagelzucker darüber und backe den Kuchen etwa 1 hour.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Prüfe nach etwa 50 Minuten den Kuchen. Wenn ein Holzstäbchen sauber herauskommt, ist er gar. Falls nicht, noch etwas länger backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
