      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Maishüllblätter 30 Minuten in warmem Wasser ein, damit sie weich werden. Gieße sie ab und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Butter oder Schmalz mit einem elektrischen Mixer etwa 5 Minuten hell und luftig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach Masa Harina dazu und wechsle dabei mit Hühnerbrühe ab. Schlage ständig, damit Luft eingearbeitet wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe Backpulver und Salz unter. Die Masse sollte luftig und streichfähig sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile etwa 2 tbsp Masa auf jedem Maishüllblatt und lasse die Ränder frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische gekochtes Hähnchen mit gewürfeltem Ají-Pfeffer, Oliven und Zwiebel für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib 1 tbsp Füllung in die Mitte jedes Masa-Rechtecks und lege eine Eischeibe darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schlage die Seiten der Maishülle über die Füllung und klappe das untere Ende hoch. Lege die Tamales mit der Naht nach unten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Stelle die Tamales aufrecht in einen Dämpfeinsatz über Wasser und dämpfe sie zugedeckt 45 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere sie heiß mit Ají-Sauce oder frischer Salsa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
