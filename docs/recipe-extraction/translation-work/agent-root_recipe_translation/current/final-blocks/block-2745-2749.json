      "steps": [
        {
          "position": 0,
          "text": "Wasche die Kutteln gründlich unter kaltem Wasser und schneide sie in 1-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Kutteln 45 Minuten in Salzwasser, bis sie zart sind, und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf und brate gewürfelte Zwiebel, Knoblauch und Ají-Pfeffer an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gekochten Kutteln in den Topf, gieße Hühnerbrühe dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Kartoffeln in Würfel, gib sie in die Brühe und lasse alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Kreuzkümmel, Essig, Salz und Pfeffer.",
