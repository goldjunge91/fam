          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerbrösele Frischkäse in die Suppe und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schlage die Eier einzeln vorsichtig in die köchelnde Suppe und pochieren sie 3-4 Minuten, bis das Eiweiß gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe heiß mit einem Ei pro Schale.",
