      "steps": [
        {
          "position": 0,
          "text": "Schneide von jeder Rocoto-Paprika den oberen Teil ab und entferne Kerne und Häute vorsichtig mit einem kleinen Löffel. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne und brate Zwiebel und Knoblauch weich an. Gib Rinderhackfleisch dazu und brate es krümelig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Rosinen, Oliven, hart gekochte Eier und gekochte Kartoffeln ein. Würze mit Salz und Pfeffer und gare alles 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede Rocoto-Paprika großzügig mit der Fleischmischung und lege sie in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 350°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Kondensmilch mit Salz und Pfeffer und gieße sie in der Auflaufform um die Rocotos herum, nicht darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue jede gefüllte Paprika mit geriebenem Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe alles 30-35 Minuten, bis die Paprika weich und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht heiß und löffle die cremige Sauce über die Paprika.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
