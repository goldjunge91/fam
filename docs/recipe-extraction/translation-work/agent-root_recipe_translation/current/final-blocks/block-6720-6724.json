      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und braunen Zucker cremig rühren, bis sie leicht und locker sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Ei unterrühren, bis es vollständig eingearbeitet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl, schwarzen Pfeffer, Zimt, Backpulver und Salz in einer separaten Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trockene Zutaten unter die feuchte Masse mischen, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kleine Teigportionen zu erbsengroßen Kugeln rollen und auf Backbleche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "12-15 Minuten lang backen, bis es fest, aber nicht braun ist, dann auf Backblechen abkühlen lassen, bevor es in einen luftdichten Behälter gegeben wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
