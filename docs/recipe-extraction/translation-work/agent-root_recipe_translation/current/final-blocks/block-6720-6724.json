      "steps": [
        {
          "position": 0,
          "text": "Mehl mit warmem Wasser vermischen und 8 Minuten lang kneten, bis ein glatter Teig entsteht, dann 10 Minuten abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühreier mit 1 Esslöffel Öl verrühren, in kleine Stücke brechen, dann mit gehacktem Schnittlauch und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 12 gleiche Stücke und rollen Sie jedes zu einem dünnen 4 cm großen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie 2 Esslöffel Füllung in die Mitte jeder Hülle und falten Sie dann die Ränder, um sie halbmondförmig zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringen Sie 6 Tassen Wasser in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Knödel in kochendes Wasser geben und vorsichtig umrühren; 5 Minuten kochen, bis sie schwimmen, dann weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Schaumlöffel herausnehmen und in Schüsseln füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit einem Dip aus Sojasauce und Sesamöl servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
