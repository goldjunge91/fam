      "steps": [
        {
          "position": 0,
          "text": "Kochbananen und Süßkartoffeln schälen und in 2 cm große Stücke schneiden, dann in Salzwasser 15 Minuten kochen, bis sie teilweise weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebeln und gehackten Knoblauch etwa 2 Minuten lang anbraten, bis ein angenehmer Duft entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die teilweise gekochten Kochbananen und Süßkartoffeln mit 2 Tassen Wasser in den Topf geben und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Kokosmilch dazugeben und gut umrühren, dann leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die in Stücke geschnittenen Fischfilets, dann die Garnelen und die Krabbenbeine unter leichtem Rühren dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "8–10 Minuten köcheln lassen, bis die Meeresfrüchte gar und undurchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frischen Koriander und Limettensaft unterrühren und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Gemüse und Brühe in Schüsseln füllen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
