      "steps": [
        {
          "position": 0,
          "text": "Garnelen fein hacken und mit Schweinehackfleisch, gehackten Frühlingszwiebeln, gehacktem Knoblauch, Sojasauce und Sesamöl vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geben Sie 1 Teelöffel Füllung in die Mitte jeder Wan-Tan-Hülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchten Sie die Kanten mit Wasser, falten Sie sie zu einem Dreieck, fügen Sie dann die Ecken zusammen und verschließen Sie sie, um die traditionelle Wan-Tan-Form zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "8 Tassen Wasser in einem großen Topf mit einer Prise Salz zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie die Wontons vorsichtig in kochendes Wasser und rühren Sie vorsichtig um, damit sie nicht kleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "4–5 Minuten kochen, bis die Wontons schwimmen, und 1 Minute lang in dieser Position bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wontons und Brühe in Schüsseln füllen und mit Chiliöl und Reisessig beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
