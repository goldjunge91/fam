      "steps": [
        {
          "position": 0,
          "text": "Den Grill auf hohe Hitze vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Austern vorsichtig schälen, in der unteren Schale belassen und auf einem Backblech anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Speck in einer Pfanne knusprig braten, dann fein hacken und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne Butter schmelzen und gehackte Zwiebeln etwa 2 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochten Speck, Semmelbrösel, Worcestershire-Sauce, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belegen Sie jede Auster mit einem Löffel der Speckmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "3-4 Minuten braten, bis der Belag goldbraun ist und die Austern durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Zitronenspalten servieren.",
          "timerMinutes": null,
