      "steps": [
        {
          "position": 0,
          "text": "Bringen Sie einen großen Topf mit Salzwasser zum Kochen und kochen Sie die Hummerschwänze 10 Minuten lang, bis sie gar sind. abgießen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Fleisch aus der Schale nehmen und in 1 cm große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hummerstücke dazugeben und 1 Minute kochen lassen, damit es warm wird, dann vorsichtig Whisky hinzufügen und mit einem langen Feuerzeug anzünden; Lass die Flammen erlöschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduzieren Sie die Hitze auf mittlere Stufe und rühren Sie die restlichen 2 Esslöffel Butter und Sahne ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2 Minuten köcheln lassen, dann mit Zitronensaft, Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf zwei Teller verteilen und mit frischer Petersilie garnieren; sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
