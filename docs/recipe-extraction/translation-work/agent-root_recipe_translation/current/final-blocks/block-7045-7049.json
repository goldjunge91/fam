      "steps": [
        {
          "position": 0,
          "text": "Speck in einer Pfanne bei mittlerer Hitze knusprig braten, dann herausnehmen und in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gießen Sie bis auf 1 Esslöffel alles Speckfett aus der Pfanne und braten Sie die gewürfelten Zwiebeln an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Austern abtropfen lassen und zusammen mit der Zwiebel in die Pfanne geben und 1 Minute kochen lassen, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier in einer Schüssel mit Salz und Pfeffer verquirlen und dann in die Pfanne über die Austernmischung gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit einem Spatel vorsichtig umrühren und die Eier etwa 2 Minuten lang verrühren, bis sie fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie den gehackten Speck zurück in die Pfanne und rühren Sie weiter, bis die Eier gerade gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, mit Parmesankäse bestreuen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
