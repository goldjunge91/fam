      "steps": [
        {
          "position": 0,
          "text": "Koche Somen-Nudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 EL Öl in einer großen Pfanne bei mittelhoher Hitze und brate das Schweinefleisch etwa 4 Minuten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfeltes Gemüse dazu und brate es 3 Minuten unter Rühren, bis es leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe die Zutaten an den Rand, gib das restliche Öl in die freie Stelle und rühre die Eier etwa 2 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gekochten Nudeln in die Pfanne und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Sojasauce darüber, vermische alles gut und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit geschnittenen Frühlingszwiebeln und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
