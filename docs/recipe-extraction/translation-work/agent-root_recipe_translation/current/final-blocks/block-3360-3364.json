            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Schneide das Schweinefleisch in Stücke, blanchiere es 5 Minuten in kochendem Wasser, gieße es ab und spüle es ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Wasser und Kombu in einen Topf und bringe alles zum Kochen. Nimm dann den Kombu heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das blanchierte Schweinefleisch und geschnittenen Ingwer in die Brühe, reduziere die Hitze auf mittlere Stufe und lasse alles 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Wintermelone dazu und lasse alles weitere 15 Minuten köcheln, bis die Melone zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Sojasauce und Salz und schmecke das Gericht ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle es in Schalen und garniere es mit geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
