      "steps": [
        {
          "position": 0,
          "text": "Koche den Schweinedarm 25 Minuten in Salzwasser, bis er zart ist, und schneide ihn dann in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok bei starker Hitze und röste Sichuan-Pfefferkörner und getrocknete Chilischoten 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwer dazu und brate sie 30 Sekunden unter Rühren, bis sie aromatisch duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Darmstücke dazu und brate sie 2 Minuten unter Rühren, damit sie mit den Gewürzen überzogen werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Sojasauce und Hühnerbrühe dazu, gib Zucker hinzu und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht und schmecke es bei Bedarf mit zusätzlicher Sojasauce ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle es in eine Servierschüssel und garniere es vor dem Servieren mit frischen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
