      "steps": [
        {
          "position": 0,
          "text": "Das Innere des Fonduetopfs mit der angeschnittenen Knoblauchzehe ausreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wein im Topf bei mittlerer Hitze erhitzen, bis er dampft, aber nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geriebenen Käse in einer Schüssel mit Maisstärke vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Käsemischung nach und nach zum Wein geben und unter ständigem Rühren in einem 8er-Muster schmelzen lassen, bis sie glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kirsch, Muskatnuss und schwarzen Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Topf auf ein Fondue-Rechaud mit niedriger Hitze stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brotwürfel, Apfelspalten und weitere Beilagen auf einer Servierplatte anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Gäste spießen Brot mit Fonduegabeln auf, tauchen es in den Käse und essen es; gelegentlich umrühren, damit nichts anklebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
