      "steps": [
        {
          "position": 0,
          "text": "Eier, Mehl, Milch, Butter, Salz, Pfeffer und Muskatnuss glatt verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine beschichtete Pfanne bei mittlerer Hitze erhitzen und leicht mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine dünne Teigschicht in die heiße Pfanne gießen und pro Seite 2 Minuten backen, bis sie gestockt und hellgoldbraun ist; wiederholen, um 3-4 dünne Palatschinken zu backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jeden Palatschinken aufrollen und in dünne Streifen von etwa 0.5 Zoll Breite schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rinderbrühe in einem großen Topf erhitzen, bis sie köchelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Palatschinkenstreifen in die köchelnde Brühe geben und 2-3 Minuten kochen, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nachwürzen, dann in Schüsseln schöpfen und mit frischer Petersilie garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
