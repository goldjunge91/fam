      "steps": [
        {
          "position": 0,
          "text": "Röste die getrockneten Chilis kurz an, weiche sie 15 min in heißem Wasser ein und gieße sie ab. Püriere sie mit Knoblauch, Tomate und Gewürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Rindfleischstücke im Topf rundum an. Gib Chilisauce und Brühe dazu und schmorte alles 2.5–3 hours bei 325°F, bis das Fleisch zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und zerpflücke es. Schöpfe das Fett vom Schmorsaft ab oder hebe es zum Dippen der Tortillas auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tauche Tortillas in Fett und Schmorsaft und brate sie in einer heißen Pfanne 1 min. Gib Käse und Rindfleisch darauf, klappe sie zusammen und brate sie knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Tacos mit Schmorsaft zum Dippen, Koriander, Zwiebel und Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
