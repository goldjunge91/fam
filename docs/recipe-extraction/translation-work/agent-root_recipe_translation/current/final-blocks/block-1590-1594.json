          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die restliche Salsa Verde darüber und bedecke alles mit Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe die Enchiladas bei 375°F 20 min, bis die Sauce blubbert und die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib saure Sahne und Koriander darüber.",
