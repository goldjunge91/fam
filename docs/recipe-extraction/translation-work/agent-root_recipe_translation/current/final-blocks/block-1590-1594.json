      "steps": [
        {
          "position": 0,
          "text": "Röste Ingwer und Zwiebel direkt über einer Flamme oder unter dem Grill, bis sie geschwärzt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass Brühe mit Ingwer, Zwiebel, Sternanis und Zimt 25 min köcheln. Seihe sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Brühe mit Fischsauce und Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weiche die Reisnudeln nach Packungsanleitung ein und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Steak 15 Minuten ins Gefrierfach und schneide es quer zur Faser hauchdünn auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte Nudeln in Schalen, gieße kochend heiße Brühe darüber und lege die rohen Rindfleischscheiben hinein; sie garen in der Brühe. Mit Kräutern, Sprossen, Limette und Sriracha garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
