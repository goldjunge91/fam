        {
          "position": 3,
          "text": "Verteile das Gemüse rund um die Würstchen auf dem Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste alles 20-25 Minuten. Wende das Gemüse nach der Hälfte der Zeit, bis die Würstchen gebräunt und das Gemüse weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue alles mit geriebenem Parmesan und röste es weitere 2 Minuten, bis der Käse schmilzt.",
