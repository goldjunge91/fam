      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und brate die Rinderschulter rundherum an, bis sie gebräunt ist; das dauert insgesamt etwa 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch, Oregano und Chiliflocken in den Topf und dünste alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Rinderbrühe dazu, würze mit Salz und Pfeffer und bringe die Flüssigkeit zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Topf ab und lass das Fleisch 2.5 Stunden köcheln, bis es sehr zart ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch heraus und zupfe es fein auseinander. Gib es anschließend zurück in den Schmorsud und lass es 15 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Sandwichbrötchen leicht an und belege jedes mit einer Scheibe Provolone.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle das zerrupfte Rindfleisch mit einer Schaumkelle in die Brötchen, damit überschüssige Flüssigkeit abtropft, und serviere die Sandwiches sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
