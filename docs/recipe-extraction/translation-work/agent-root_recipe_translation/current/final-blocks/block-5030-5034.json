      "steps": [
        {
          "position": 0,
          "text": "Penne nach Packungsanweisung in gesalzenem kochendem Wasser garen, abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen und die gewürfelte Zwiebel etwa 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gebackene Bohnen samt Sauce und Worcestershiresauce hinzufügen und gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die gekochten Nudeln unterheben, bis sie gleichmäßig mit der Bohnensauce überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drei Viertel des Cheddars einrühren, bis er geschmolzen ist. Dann mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In eine Auflaufform geben, mit dem restlichen Käse belegen und bei 375 °F 10 Minuten backen, bis der Käse goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
