      "steps": [
        {
          "position": 0,
          "text": "Die Kartoffeln schälen, in 1-Zoll-Würfel schneiden und in gesalzenem Wasser 12–15 Minuten kochen, bis sie sich leicht mit einer Gabel einstechen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Kartoffeln gründlich abgießen und zurück in den Topf geben. Vorsichtig schütteln, damit überschüssige Feuchtigkeit verdampft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter, Milch, saure Sahne, Salz, Pfeffer und Knoblauchpulver zu den Kartoffeln geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zu einem glatten Püree stampfen oder nach Wunsch leicht stückig lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Kartoffelpüree dünn und gleichmäßig auf einem mit Backpapier ausgelegten Backblech verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gleichmäßig mit Pflanzenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 425 °F 15–20 Minuten backen, nach der Hälfte der Zeit wenden, bis die Ränder goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf eine Servierschüssel geben und mit frischem Schnittlauch garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
