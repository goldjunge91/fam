      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch in einer Pfanne bei mittelhoher Hitze anbraten und dabei zerkleinern. Überschüssiges Fett abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel und gehackten Knoblauch zum Fleisch geben und 3 Minuten garen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gochujang-Paste und Sojasauce einrühren und gut mit dem Fleisch vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer separaten Schüssel Gochujang-Paste mit Rinderbrühe zu einer Sauce verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine dünne Schicht Gochujang-Sauce auf dem Boden einer Auflaufform verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Tortillas in einer trockenen Pfanne erwärmen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Tortilla mit der Fleischmischung füllen, fest aufrollen und mit der Naht nach unten in die Auflaufform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die restliche Sauce über die Enchiladas gießen und mit geriebenem Cheddar belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bei 350 °F 20–25 Minuten backen, bis der Käse blubbert und goldbraun ist. Dann mit Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
