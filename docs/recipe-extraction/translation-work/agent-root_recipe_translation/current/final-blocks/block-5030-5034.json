      "steps": [
        {
          "position": 0,
          "text": "Sojasauce, braunen Zucker, Sesamöl, Knoblauch und Ingwer in einer Schüssel zu einer Marinade verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das dünn geschnittene Rindfleisch zur Marinade geben und mindestens 15 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Pfanne bei starker Hitze erhitzen und das marinierte Rindfleisch 3–4 Minuten unter häufigem Rühren durchgaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Weizentortillas in einer trockenen Pfanne oder über einer Flamme je Seite 20 Sekunden erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine Tortilla auslegen und 1/2 Tasse Reis in der Mitte als Grundlage verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit gegartem Bulgogi, Kimchi, Salat und Frühlingszwiebeln belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Seiten der Tortilla einschlagen, fest aufrollen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
