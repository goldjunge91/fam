      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 EL Öl in einem großen Topf und dünste gewürfelte Zwiebeln goldbraun. Gib dann Rinderhackfleisch hinzu und bräune es, während du es in kleine Stücke zerteilst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Tomatenmark und Kurkuma ein und gare alles 2 Minuten. Gieße Kidneybohnen ab, spüle sie ab und gib sie in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze nach Geschmack mit Salz und Pfeffer, nimm dann die Fleisch-Bohnen-Mischung heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze im selben Topf das restliche Öl und Butter, gib den Reis hinein und rühre 2 Minuten, bis er leicht angeröstet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser hinzu und bringe es zum Kochen. Reduziere dann die Hitze, decke den Topf ab und gare den Reis 15 Minuten, bis er teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die Fleisch-Bohnen-Mischung vorsichtig unter den Reis, decke den Topf wieder ab und gare alles weitere 10 Minuten, bis der Reis weich und locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lockere den Reis vorsichtig mit einer Gabel auf und serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
