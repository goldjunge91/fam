      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebel und frische Kräuter sehr fein und vermische sie in einer großen Schüssel mit Rinder- und Lammhackfleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Ei, Semmelbrösel, Salz, Pfeffer und Kurkuma hinzu und vermische alles vorsichtig, bis sich die Zutaten gerade verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Mischung in 8 Portionen und forme jede zu einem ovalen Bratling, der etwas breiter als ein Spieß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und gare die Kebabs 10 Minuten. Wende sie alle 2-3 Minuten, bis sie gebräunt und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste das Fladenbrot in der Pfanne oder über einer Flamme 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege jeden Kebab auf Fladenbrot, wickle es fest darum und serviere ihn mit geschnittenen Tomaten, Zwiebeln und eingelegtem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
