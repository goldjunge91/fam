      ],
      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mehl, Salz und 1 Esslöffel Zucker in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier mit Milch und Vanille und gieße die Mischung unter Rühren zum Mehl, bis der Teig glatt ist. Rühre dann 1 Esslöffel geschmolzene Butter ein und lasse den Teig 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine beschichtete 8-Zoll-Pfanne bei mittlerer bis hoher Hitze und fette sie leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 0.25 Tasse Teig in die Pfanne und neige sie sofort, damit sich der Teig gleichmäßig verteilt. Gare ihn 1 Minute, bis er leicht goldbraun ist, wende ihn und gare die andere Seite 30 Sekunden. Lege ihn auf einen Teller und wiederhole dies mit dem restlichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reibe die Schale beider Orangen ab und presse den Saft in einen kleinen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 4 Esslöffel Butter und 2 Esslöffel Zucker zum Orangensaft und erhitze alles bei mittlerer Hitze unter Rühren, bis sich der Zucker aufgelöst hat und die Sauce leicht eindickt, etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd und rühre vorsichtig Grand Marnier ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Falte jede Crêpe zweimal zu einem Viertel, richte sie auf Serviertellern an, gieße die warme Sauce darüber und bestreue sie mit Orangenschale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
