      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Salz, zerdrückten Knoblauch, Thymian, Lorbeerblätter, Pfeffer und Rosmarin in einer Schüssel zu einer Pökelmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Entenkeulen rundherum mit der Pökelmischung ein, lege sie in eine Glasschale, decke sie ab und stelle sie 24 Stunden in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 250°F vor, spüle das Pökelsalz unter kaltem Wasser von den Entenkeulen ab und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Entenfett in einem großen Topf, bis es warm ist. Lege die Entenkeulen vorsichtig hinein und gib frischen Thymian und ein Lorbeerblatt hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und stelle ihn 10-12 Stunden in den Ofen, bis die Ente sehr zart ist und sich das Fleisch leicht vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Ente aus dem Fett und lasse sie abkühlen. Zupfe das Fleisch von den Knochen und gib es in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Seihe das Garfett durch ein Passiertuch und gieße eine dünne Schicht über das gezupfte Entenfleisch, um es haltbar zu machen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es warm, sanft in einem 300°F heißen Ofen 20 Minuten aufgewärmt, mit knusprigem Brot und eingelegtem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
