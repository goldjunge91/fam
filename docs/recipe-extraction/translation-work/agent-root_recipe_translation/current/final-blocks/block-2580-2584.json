      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 475°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rolle den Pizzateig oder Blätterteig zu einem dünnen Rechteck von etwa 12 mal 8 Zoll aus und lege es auf das Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Speck in kleine Stücke, brate ihn in einer Pfanne knusprig und lege ihn dann auf Küchenpapier beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Zwiebel in dünne Scheiben und brate sie im Speckfett bei mittlerer Hitze 5 Minuten, bis sie weich und hellgolden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische saure Sahne mit Salz, Pfeffer und Muskatnuss in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Sauerrahmmischung gleichmäßig auf dem Teig und lasse einen schmalen Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile Speckstücke und gegarte Zwiebel auf der Sauerrahmcreme und bestreue alles mit geriebenem Gruyère.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Flammkuchen 15-18 Minuten, bis der Rand goldbraun und der Käse blubbernd und leicht gebräunt ist. Serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
