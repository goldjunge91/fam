      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Fischfilets trocken und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Mandeln in einer trockenen Pfanne bei mittlerer Hitze 3 Minuten unter ständigem Rühren, bis sie duften. Stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl mit Salz und Pfeffer auf einem Teller und wende jedes Filet leicht darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz 3 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze und gare den Fisch 3 Minuten pro Seite, bis er undurchsichtig ist und leicht zerfällt. Lege ihn dann auf Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmilz in derselben Pfanne die übrigen 3 Esslöffel Butter und gib die gerösteten Mandeln hinzu. Gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Milch in die Mandelmischung und rühre 30 Sekunden, damit eine leichte Sauce entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse frischen Zitronensaft über den Fisch und gib die Mandelsauce mit einem Löffel darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischer Petersilie und serviere es mit geröstetem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
