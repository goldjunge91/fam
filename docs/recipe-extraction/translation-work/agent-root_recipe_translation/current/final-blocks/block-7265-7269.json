    {
      "externalId": "waivy:drink-green-smoothie",
      "slug": "drink-green-smoothie",
      "title": "Grüner Detox-Smoothie",
      "instructions": "Frischer Smoothie aus Spinat, reifer Banane und gefrorener Mango mit cremiger Hafermilch. Das süße Obst mildert den Gemüsegeschmack.",
      "prepTimeMinutes": 3,
      "cookTimeMinutes": 2,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Sehr reife Bananen im Angebot kaufen, schälen und einfrieren. Gefrorene Banane macht den Smoothie auch ohne Eis cremig und dick.",
        "Gefrorene Mango ist günstiger und gleichmäßiger gereift als frische und hält sich monatelang.",
        "Eine große Handvoll frischen Spinat verwenden, bevor er welk wird. Das Obst überdeckt leichte Welke und verhindert, dass Spinat weggeworfen wird."
      ],
      "substitutions": [
        {
          "forIngredientId": "oat-milk",
          "swap": "verwenden almond Milch oder natur Wasser plus ein splash von Orange juice",
          "savings": "Wasser ist praktisch kostenlos und spart ~$0.40 pro Drink"
        },
        {
          "forIngredientId": "frozen-mango",
          "swap": "Swap in gefroren pineapple oder gefroren mixed berries",
          "savings": "Im Angebot pro Beutel oft $1+ günstiger"
        },
        {
          "forIngredientId": "honey",
          "swap": "verwenden ein pitted Medjool date oder ein splash von maple syrup",
          "savings": "Bei reifem Obst ganz weglassen und die Kosten sparen"
        }
      ],
