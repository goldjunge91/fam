      "steps": [
        {
          "position": 0,
          "text": "Erhitze Butter in einem Schmortopf, bis sie schäumt. Brate die Schweinekoteletts je Seite 2-3 mins an, bis sie gebräunt sind. Nimm sie aus dem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Speck, Karotte, Kartoffeln und Steckrübe in den Topf und brate alles leicht an. Rühre Kohl ein, lege die Koteletts darauf und gib Lorbeerblatt, Apfelwein und Brühe dazu. Decke den Topf ab und lass alles 20 mins sanft köcheln, bis das Schweinefleisch gar und das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Serviere das Gericht direkt aus dem Topf.",
          "timerMinutes": null,
