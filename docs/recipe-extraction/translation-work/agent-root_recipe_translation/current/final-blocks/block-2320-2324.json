          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 230C/Umluft 210C/Gasstufe 8 erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Etwas Sonnenblumenöl gleichmäßig in zwei Yorkshire-Puddingformen mit je 4 Mulden oder zwei beschichtete Muffinformen mit je 12 Mulden träufeln und zum Erhitzen in den Ofen stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für den Teig 140g Weizenmehl in eine Schüssel geben und 4 Eier glatt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "200ml Milch nach und nach dazugeben und weiterschlagen, bis die Mischung völlig klümpchenfrei ist. Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in einen Krug gießen und heiße Formen vorsichtig aus dem Ofen nehmen. Teig sorgfältig und gleichmäßig in die Mulden gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Formen zurück in den Ofen stellen und 20–25 Minuten ungestört backen, bis die Puddings aufgegangen und gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort servieren. Anschließend abkühlen lassen und bis zu 1 Monat einfrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
