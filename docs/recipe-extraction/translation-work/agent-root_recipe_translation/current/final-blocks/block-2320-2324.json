      "steps": [
        {
          "position": 0,
          "text": "Schweinefleisch, Knoblauch, Ingwer, Sojasauce, Sesamöl und Gemüse in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wontonblätter voneinander trennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen gehäuften Teelöffel Füllung in die Mitte eines Wontonblatts geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser auf 2 Ränder des Teigblatts streichen, etwa 1/4 inch vom Rand entfernt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teigblatt zu einem Dreieck falten und Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die beiden langen äußeren Spitzen zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl auf 450 Grad erhitzen und 4 bis 5 Stück auf einmal goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abtropfen lassen und mit Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
