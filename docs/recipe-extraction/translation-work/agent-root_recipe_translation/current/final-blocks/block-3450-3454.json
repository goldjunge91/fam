      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, Salz und Jaggery in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Löse Hefe in warmem Wasser auf und lasse sie 5 Minuten stehen. Gib sie dann zur Reismehlmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Kokosmilch, Ei und Öl ein, bis der Teig glatt und klümpchenfrei ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Teig ab und lasse ihn bei Raumtemperatur 2-3 Stunden oder für ein optimales Ergebnis über Nacht fermentieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine Hopper-Pfanne (eine spezielle schüsselförmige Form) bei mittelhoher Hitze und fette jede Mulde leicht mit Öl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Teig bis zu drei Vierteln in jede Formmulde und decke die Pfanne mit dem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Hoppers 2-3 Minuten, bis die Ränder goldbraun und knusprig und die Mitte gestockt, aber noch leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Hoppers mit einem Löffel heraus und serviere sie warm mit Curry oder Honig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
