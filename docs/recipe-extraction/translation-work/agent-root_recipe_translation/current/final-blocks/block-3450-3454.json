      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Jaggery zu feinen Stücken oder reibe ihn, damit er sich gleichmäßig auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Reismehl, zerstoßenen Jaggery und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, gib sie zusammen mit Kokosmilch zur Reismehlmischung und rühre alles klümpchenfrei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerstoße die Kardamomkapseln, löse die Samen heraus und gib sie zum Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste Cashews und Rosinen leicht in Butter und hebe sie unter den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fette eine Wattappam-Form oder kleine Kuchenform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße den Teig in die Form und dämpfe ihn in einem abgedeckten Topf über kochendem Wasser 20-25 Minuten, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse den Kuchen 5 Minuten abkühlen, löse ihn aus der Form und serviere ihn warm mit Jaggery-Sirup oder pur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
