      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in 1 Zoll große Würfel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne und dünste fein gehackte Zwiebeln etwa 3 Minuten, bis sie weich und glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und grüne Chilis hinzu und gare alles eine weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Currypulver und Tomatenmark ein und gare die Mischung 2 Minuten, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Hähnchenstücke hinzu und gare sie bei hoher Hitze 5-7 Minuten, bis die Oberfläche versiegelt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Essig und Wasser hinzu, reduziere die Hitze auf mittel-niedrig und lasse alles zugedeckt 15-20 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und passe Salz, Pfeffer und Essig an, bis es würzig-säuerlich ausgewogen schmeckt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis oder Roti servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
