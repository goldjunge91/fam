        {
          "position": 0,
          "text": "Erhitze Sesamöl in einem großen Topf bei mittlerer bis hoher Hitze und bräune die Schweinefleischwürfel 5 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Zwiebel und Knoblauch hinzu und brate alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gehacktes Kimchi und Gochugaru unter und brate alles 3 Minuten, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Gemüsebrühe hinzu und bringe sie zum Kochen. Reduziere dann die Hitze und lasse alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Tofuwürfel hinzu und gare sie 10 Minuten, bis der Tofu die Aromen aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Sojasauce und Zucker und schmecke alles ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 5 Minuten köcheln, bestreue das Gericht mit gehackten Frühlingszwiebeln und serviere es heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
