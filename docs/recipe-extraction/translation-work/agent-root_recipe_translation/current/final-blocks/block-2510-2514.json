      "steps": [
        {
          "position": 0,
          "text": "Spüle das ganze Hähnchen innen und außen ab, blanchiere es kurz in kochendem Wasser und lasse es abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fülle die Hähnchenhöhlung mit Klebreis, 2-3 Jujuben, 1 Stück Ginseng und Knoblauchzehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das gefüllte Hähnchen in einen großen Topf und bedecke es mit Hühnerbrühe. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze und lasse alles 45 Minuten köcheln. Schöpfe dabei den entstehenden Schaum regelmäßig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Ingwerscheiben, die übrigen Jujuben und Ginkgonüsse hinzu und lasse alles weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke das Gericht mit Salz und Sesamöl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe das Hähnchen vorsichtig in eine Servierschüssel mit Brühe, garniere es mit gehackten Frühlingszwiebeln und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
