      "steps": [
        {
          "position": 0,
          "text": "Verrühre Sojasauce, braunen Zucker, Sesamöl, gehackten Knoblauch, Ingwer, Birne und Reisessig in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib schwarzen Pfeffer hinzu und rühre, bis sich der Zucker vollständig aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Rindfleischscheiben in einen großen Gefrierbeutel oder eine flache Schüssel und übergieße sie mit der Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Massiere die Marinade ins Fleisch ein, decke es ab und stelle es mindestens 4 Stunden oder über Nacht in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine gusseiserne Pfanne oder Grillpfanne bei mittlerer bis hoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Fleisch aus der Marinade, schüttle überschüssige Marinade ab und brate es portionsweise 2-3 Minuten pro Seite, bis es karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das gegarte Fleisch auf einen Teller und gib die Zwiebelscheiben in die Pfanne. Brate sie 2 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Fleisch zurück in die Pfanne, vermenge es mit den Zwiebeln und serviere es sofort mit Reis und Salatblättern zum Einwickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
