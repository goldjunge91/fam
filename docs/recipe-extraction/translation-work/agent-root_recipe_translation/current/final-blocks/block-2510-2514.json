      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Wasser zum Kochen und gare die Weizennudeln nach Packungsanleitung. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einem zweiten Topf und bräune das Hackfleisch bei mittlerer bis hoher Hitze, während du es zerteilst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch zum Fleisch und brate alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die gewürfelte Kartoffel hinzu und rühre um. Füge dann die schwarze Bohnenpaste hinzu und vermische alles gründlich, sodass Fleisch und Gemüse bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser hinzu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse die Sauce 8 Minuten köcheln, bis die Kartoffel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Speisestärke mit 2 EL Wasser zu einer glatten Mischung und rühre sie zum Andicken in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Sojasauce und Zucker hinzu und schmecke die Würzung ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Nudeln auf zwei Schalen, gib die schwarze Bohnensauce darüber, garniere mit Gurkenscheiben und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
