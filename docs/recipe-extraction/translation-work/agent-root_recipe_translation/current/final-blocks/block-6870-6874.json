      "steps": [
        {
          "position": 0,
          "text": "Schweinekoteletts mit Salz und Pfeffer würzen und dann auf beiden Seiten leicht in Mehl wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinekoteletts auf jeder Seite 4–5 Minuten goldbraun braten und durchgaren lassen, dann auf einem Teller beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduzieren Sie die Hitze auf mittlere Stufe und verquirlen Sie 2 EL Butter mit dem restlichen Mehl unter ständigem Rühren 1 Minute lang zu einer Mehlschwitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nach und nach Milch und Hühnerbrühe unter ständigem Rühren einrühren, bis die Soße eindickt (ca. 3–4 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zwiebelpulver einrühren und die Schweinekoteletts in der Soße wieder in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "3 Minuten köcheln lassen, dann die Schweinekoteletts mit der darüber gelöffelten Soße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
