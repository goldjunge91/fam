      "steps": [
        {
          "position": 0,
          "text": "Milch und Vanillepudding nach Packungsanweisung verrühren, bis die Masse eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein Drittel der Vanillewaffeln auf den Boden einer 9-Zoll-Auflaufform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Bananen in Scheiben schneiden und auf die Waffeln schichten, dann ein Drittel der Puddingmischung über die Bananen gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wiederholen Sie die Schichten noch zweimal und enden Sie mit dem Pudding obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eiweiß mit 1/2 Tasse Zucker und 1 TL Vanilleextrakt zu weichen Spitzen schlagen, bis sich steife Spitzen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "4 EL geschmolzene Butter unterheben und Baiser auf dem Pudding verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 350 °F 10–12 Minuten backen, bis das Baiser goldbraun ist, dann abkühlen lassen und vor dem Servieren in den Kühlschrank stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
