      "steps": [
        {
          "position": 0,
          "text": "Kombinieren Sie Paprika, braunen Zucker, Knoblauchpulver, schwarzen Pfeffer, Zwiebelpulver und Cayennepfeffer, um eine Gewürzmischung herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Fettkappe der Schweineschulter kreuzweise einschneiden und die gesamte Oberfläche großzügig trockenreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 250 °F vor und legen Sie das Schweinefleisch auf einen Bräter in einer großen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ohne Deckel 10–12 Stunden braten, bis die Innentemperatur 190 °F erreicht und das Fleisch leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nehmen Sie das Schweinefleisch heraus und lassen Sie es 20 Minuten ruhen. Zerkleinern Sie dann das gesamte Fleisch mit zwei Gabeln und entfernen Sie Fett und Knochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Apfelessig, Ketchup, Worcestershire, Honig und Senf verrühren, um Memphis-Sauce zuzubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das geschnetzelte Schweinefleisch mit der Soße vermengen und auf Brötchen oder mit Maisbrot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
