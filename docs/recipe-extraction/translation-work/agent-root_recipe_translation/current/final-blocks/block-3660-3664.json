      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Schweinerippchen 2 Minuten in kochendem Wasser, gieße sie ab, spüle sie kalt ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche getrocknete Pilze in 1/2 Tasse heißem Wasser 10 Minuten ein. Bewahre das Einweichwasser auf und hacke die Pilze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Topf bei mittlerer Hitze und brate zerdrückte Knoblauchzehen und Ingwerscheiben 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zimtstange, Sternanis und Nelken hinzu und röste sie 30 Sekunden, bis sie aromatisch duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 8 Tassen Wasser und das aufbewahrte Pilzeinweichwasser hinzu und gib die blanchierten Rippchen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen und gib dann Sojasauce, dunkle Sojasauce, Fischsauce und gehackte Pilze hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze auf niedrig und lasse alles zugedeckt 1 bis 1.5 Stunden köcheln, bis die Rippchen sehr zart und aromatisch sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht und passe es nach Bedarf mit Sojasauce oder Fischsauce an. Heiß mit der aromatischen Brühe in Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
