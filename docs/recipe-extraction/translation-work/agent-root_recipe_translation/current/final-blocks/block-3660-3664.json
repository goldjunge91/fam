      "steps": [
        {
          "position": 0,
          "text": "Erhitze Wasser und Palmzucker in einem kleinen Topf bei niedriger Hitze und rühre, bis sich der Zucker vollständig aufgelöst hat. Nimm den Topf vom Herd und lasse alles vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche frische Cendol-Nudeln 1-2 Minuten in kochendem Wasser und gieße sie ab; gefrorene Nudeln taue unter kaltem Wasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle Kokosmilch in ein separates Gefäß und rühre Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle vier hohe Gläser zur Hälfte mit zerstoßenem Eis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Cendol-Nudeln gleichmäßig auf die Gläser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den abgekühlten Palmzuckersirup über Nudeln und Eis in jedem Glas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib reichlich Kokosmilch darauf und rühre vor dem Servieren vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange das Eis noch kalt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
