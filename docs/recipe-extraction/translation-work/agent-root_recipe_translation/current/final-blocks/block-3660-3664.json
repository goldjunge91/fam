      "steps": [
        {
          "position": 0,
          "text": "Spüle Klebreis gründlich unter kaltem Wasser, bis es klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Kokosmilch mit 3 Tassen Wasser und Salz in einem großen Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib abgespülten Reis, Ingwer und Knoblauch in den Topf und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittel-niedrig und lasse alles zugedeckt 15 Minuten köcheln. Rühre gelegentlich um, bis der Reis fast gar ist und die Flüssigkeit größtenteils aufgenommen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Palmblätter oder Folie in 4 Zoll große Quadrate und forme sie zu Kegeln oder Rauten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Tasche zu drei Vierteln mit der gekochten Reismischung, falte das Blatt zu und befestige es bei Bedarf mit einem Zahnstocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die eingewickelten Ketupat in einen Topf mit kochendem Wasser und koche sie 45 Minuten, bis der Reis vollständig gar und sehr fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie aus dem Wasser, lasse sie leicht abkühlen, wickle sie vorsichtig aus und serviere sie warm oder bei Raumtemperatur mit Curry oder Sambal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
