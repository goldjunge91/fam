      "steps": [
        {
          "position": 0,
          "text": "Würfle Zwiebel und Knoblauch fein, brate beides in einer Pfanne weich an und lass es etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere die Hühnerleber und vermenge sie mit Schweinehackfleisch, der gegarten Zwiebel, Knoblauch, Pistazien und Weinbrand. Würze die Masse mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege eine Terrinenform mit dünnen Scheiben Schweinefett aus und fülle die Pastetenmasse hinein. Drücke sie fest an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bedecke die Oberfläche mit den übrigen Schweinefettscheiben und verschließe die Form fest mit Alufolie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Terrine in ein Wasserbad und backe sie bei 325°F 90 Minuten, bis ein Fleischthermometer im Inneren 160°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Terrine vollständig abkühlen und stelle sie vor dem Stürzen mindestens 12 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Pastete in Scheiben und serviere sie auf geröstetem Brot mit Cornichons und Dijon-Senf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
