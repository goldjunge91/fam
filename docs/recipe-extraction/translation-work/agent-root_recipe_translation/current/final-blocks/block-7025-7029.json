          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Bagels auf ein Backblech legen und bei 400 °C 20–25 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
