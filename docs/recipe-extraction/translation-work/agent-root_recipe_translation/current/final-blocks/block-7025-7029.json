      "steps": [
        {
          "position": 0,
          "text": "Entfernen Sie die Membran von der Rückseite der Rippen, indem Sie ein Messer darunter schieben und abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischen Sie braunen Zucker, Paprika, Salz, schwarzen Pfeffer und Knoblauchpulver in einer kleinen Schüssel, um eine Trockenreibe zu erzeugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tragen Sie die Trockenreibe großzügig auf beide Seiten der Rippen auf und drücken Sie leicht darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Legen Sie die Rippchen mit der Knochenseite nach unten auf ein mit Folie ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ohne Deckel 275 Stunden bei 2.5 °F backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Barbecue-Sauce und Apfelessig verrühren und die Rippchen damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 30 Minuten backen, bis die Sauce karamellisiert und die Rippchen zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten ruhen lassen, dann zwischen den Knochen aufschneiden und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
