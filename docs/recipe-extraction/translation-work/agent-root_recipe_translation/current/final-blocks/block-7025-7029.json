      "steps": [
        {
          "position": 0,
          "text": "Hähnchenschenkel in Buttermilch mit Paprika, Salz und Pfeffer mindestens 2 Stunden oder über Nacht marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Backpulver und Salz in einer Schüssel vermischen; Eier mit Milch verquirlen, dann feuchte und trockene Zutaten mit geschmolzener Butter vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitzen Sie Öl in einer tiefen Pfanne auf 350 °F und braten Sie die marinierten Hähnchenstücke etwa 165–12 Minuten lang goldbraun an, bis die Innentemperatur 15 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heizen Sie das Waffeleisen vor und gießen Sie den Teig in jeden Abschnitt, bis er goldbraun und knusprig ist, etwa 5 Minuten pro Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Warme Waffeln mit gebratenem Hähnchen servieren und mit Ahornsirup beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
