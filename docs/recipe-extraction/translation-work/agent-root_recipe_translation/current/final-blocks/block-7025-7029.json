      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie die Hähnchenbrust in dünne, etwa 1/4 Zoll dicke Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Paprika, Kreuzkümmel, Knoblauchpulver, Olivenöl und Zitronensaft in einer Schüssel zu einer Marinade verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenstreifen mit der Marinade bestreichen und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitzen Sie eine Pfanne bei mittlerer bis hoher Hitze und kochen Sie das marinierte Hähnchen etwa 8–10 Minuten lang, bis es goldbraun und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während das Hähnchen gart, Tomaten, Zwiebeln und Gurken in dünne Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Mehl-Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tahini in der Mitte jeder Tortilla verteilen und mit gekochtem Hähnchen, Tomaten, Zwiebeln und Gurken belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fest aufrollen, bei Bedarf in Folie einwickeln und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
