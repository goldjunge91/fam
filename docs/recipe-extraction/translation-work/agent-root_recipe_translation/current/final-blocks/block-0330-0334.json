      "steps": [
        {
          "position": 0,
          "text": "Optional: Wärme die Servierschüsseln vor. Im Backofen: Heize ihn auf 80C (175F) und stelle die Schüsseln für 10-15 Minuten hinein. In der Mikrowelle: Erwärme jede mikrowellengeeignete Schüssel 1-2 Minuten auf hoher Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe einen großen Topf mit Salzwasser zum Kochen. Gib die Fettuccine hinein und koche sie 1 Minute kürzer als auf der Packung angegeben; in der Soße gart sie fertig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schöpfe etwa 250 ml (1 Tasse) des stärkehaltigen Nudelwassers ab und gieße anschließend die Pasta ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz währenddessen die Butter in einer großen, tiefen, schweren Pfanne bei mittlerer bis niedriger Hitze. Schalte den Herd aus, sobald die Butter geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die abgetropfte Pasta zur geschmolzenen Butter und wende sie mit einer Zange, bis sie gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib nach und nach den geriebenen Parmesan dazu und wende die Pasta dabei ständig, bis der Käse schmilzt und mit der Butter eine cremige Soße bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das aufgefangene Nudelwasser esslöffelweise in Portionen von 1-2 EL dazu und wende die Pasta ständig, bis die Soße glänzend und cremig ist; gewöhnlich wird die ganze Tasse benötigt. Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Pasta sofort in den warmen Schüsseln, mit zusätzlichem Parmesan und frisch gemahlenem schwarzem Pfeffer. Reiche nach Wunsch gerösteten oder über Holzkohle gegrillten Spargel dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
