      "steps": [
        {
          "position": 0,
          "text": "Koche die Pasta nach Packungsanleitung, aber 1 Minute kürzer, da sie in der Soße fertig gart. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Olivenöl in einer großen, schweren Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das in Streifen geschnittene Hähnchen dazu und brate es 1-2 Minuten, bis es außen gerade eben angegart ist; innen ist es noch roh.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Knoblauch dazu und rühre etwa 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Pesto, Sahne und Gemüse ein. Decke die Pfanne ab und gare alles 2-4 Minuten bei frischem Gemüse oder 4-6 Minuten bei tiefgekühltem Gemüse, bis das Hähnchen vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und rühre die gekochte Pasta und den Parmesan unter. Schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht nach Wunsch mit zusätzlichem Parmesan und frischer Chili bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
