      "steps": [
        {
          "position": 0,
          "text": "Heize den Grill auf mittlere Hitze vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Grille den Mais in der Schale und wende ihn gelegentlich, bis die Schalen schwarz sind (einige Blätter lösen sich dabei), die Körner zart sind und gebräunte, geröstete Stellen haben; das dauert 25 bis 35 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite in der Zwischenzeit die Butter mit verkohlter Frühlingszwiebel und Sesam-Chili zu: Röste die Frühlingszwiebeln auf dem Grill, bis sie weich und stellenweise schwarz sind, und hacke sie anschließend fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerdrücke die weiche Butter mit den gerösteten Zwiebeln, dem gerösteten Sesamöl, den Sesamsamen, den Chiliflocken und einer Prise Salz, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass den gegrillten Mais kurz abkühlen und entferne dann die verkohlten Blätter und Fäden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere den Mais heiß und großzügig mit der Butter aus verkohlter Frühlingszwiebel, Sesam und Chili bestrichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
