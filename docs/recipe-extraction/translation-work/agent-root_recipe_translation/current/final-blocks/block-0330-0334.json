      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Olivenöl in einer schweren Pfanne mit Deckel bei mittlerer bis hoher Hitze. Gib die gewürfelte rote Zwiebel und den Knoblauch dazu und brate alles unter Rühren 2-3 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Tomaten dazu und gare sie unter Rühren 2 Minuten. Drücke sie mit der Rückseite des Löffels leicht an, damit ihr Saft austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Brühe und Tomatenmark ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sahne, geriebenen Parmesan und schwarzen Pfeffer dazu. Lass die Soße leicht köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Spinat dazu und rühre, bis er gerade zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Tortellini direkt aus der Packung in die Pfanne; sie müssen nicht vorgekocht werden. Rühre sie unter die Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke die Pfanne ab und gare alles bei niedriger Hitze 3-4 Minuten, bis die Pasta gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue das Gericht mit zusätzlichem Parmesan und träufle nach Wunsch etwas italienisches Chiliöl darüber. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
