      "steps": [
        {
          "position": 0,
          "text": "Eier in einer Schüssel mit Sojasauce, Mirin, Dashi und Zucker gründlich verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mischung durch ein feines Sieb abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer rechteckigen Tamagoyaki-Pfanne oder kleinen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine dünne Schicht Eiermischung in die Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn die Ränder gestockt, die Mitte aber noch flüssig ist, Omelett mit Essstäbchen oder Pfannenwender zu dir hin aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle an den hinteren Pfannenrand schieben und mehr Eiermischung hineingießen, dann wieder aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "3–4 Mal wiederholen, bis die gesamte Mischung aufgebraucht ist. In Stücke schneiden und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
