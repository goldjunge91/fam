      "steps": [
        {
          "position": 0,
          "text": "Soba-Nudeln nach Packungsanleitung kochen, abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pflanzenöl in einer großen Pfanne oder einem Wok bei starker Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen etwa 4–5 Minuten garen, bis es in der Mitte nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kohl und Karotten dazugeben und 3–4 Minuten pfannenrühren, bis sie leicht weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochte Nudeln und Knoblauch in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasauce und Mirin über alles gießen und 2 Minuten gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Servierteller verteilen, mit Frühlingszwiebeln und Bonitoflocken garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
