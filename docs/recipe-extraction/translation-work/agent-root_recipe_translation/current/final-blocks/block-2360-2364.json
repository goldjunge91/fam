      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver, Eier und Dashi-Brühe zu einem glatten Teig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Takoyaki-Pfanne bei mittelhoher Hitze erhitzen und jede Mulde mit Öl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in die Mulden gießen, etwa bis zur Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Je ein Stück Oktopus, Frühlingszwiebel und eingelegten Ingwer in jede Mulde geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mehr Teig darübergeben, sodass jede Mulde vollständig gefüllt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Takoyaki-Spießen oder Holzspießen jede Kugel ständig drehen, damit sie rund wird. Das dauert etwa 8–10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sobald sie goldbraun sind, herausnehmen und auf eine Servierplatte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Takoyaki-Sauce beträufeln, Bonitoflocken darüberstreuen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
