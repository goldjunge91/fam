      "steps": [
        {
          "position": 0,
          "text": "Schweineknochen und Hähnchen 3 Minuten in kochendem Wasser blanchieren, dann abgießen und gründlich abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gereinigte Knochen und Hähnchen mit 3 Quarts frischem Wasser und Kombu in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zum Kochen bringen, dann Hitze reduzieren und 2–3 Stunden köcheln lassen. Trübstoffe abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knochen und Hähnchen herausnehmen, Schweinebauch dazugeben und weitere 30 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brühe abseihen und mit Sojasauce und Mirin würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier 6–7 Minuten kochen, dann schälen und halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ramen-Nudeln nach Packungsanleitung kochen und abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nudeln auf Schalen verteilen, heiße Brühe darübergießen und mit Schweinebauch, Eihälften, Nori und Frühlingszwiebel belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
