      "steps": [
        {
          "position": 0,
          "text": "Übergieße Bulgur mit kochendem Wasser, sodass er gerade bedeckt ist, und lasse ihn 20 Minuten quellen, bis er weich ist und das Wasser aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lockere den Bulgur mit einer Gabel auf und fülle ihn in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Petersilie, Minze, Tomate, Gurke und rote Zwiebel zum Bulgur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Zitronensaft, Olivenöl, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße das Dressing über den Salat und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse den Salat vor dem Servieren 10 Minuten ziehen, damit sich die Aromen verbinden. Probiere ihn dann und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
