      "steps": [
        {
          "position": 0,
          "text": "Weiche Bulgur 15 Minuten in warmem Wasser ein, gieße ihn dann ab und drücke ihn trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die Hälfte des Lammhackfleischs mit dem eingeweichten Bulgur, der halben Zwiebel, der halben Minze, Salz und Piment zur äußeren Hülle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische in einer separaten Schüssel das übrige Lammfleisch mit Zwiebel, Minze, Petersilie und Pinienkernen für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Befeuchte deine Hände und forme eine kleine Kugel aus der Hüllenmasse. Drücke mit dem Daumen eine Mulde hinein, fülle sie mit der Fleischmischung und verschließe sie zu einer ovalen Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne auf 350°F und frittiere die Kibbeh portionsweise 3-4 Minuten pro Portion goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit Tahinisauce und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
