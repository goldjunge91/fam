      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und stich mehrmals mit einer Gabel in die Auberginen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Auberginen direkt auf den Ofenrost und röste sie 30-35 Minuten, bis die Schale schwarz wird und das Fruchtfleisch sehr weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse die Auberginen 5 Minuten abkühlen, löffle dann das weiche Fruchtfleisch in ein Sieb und lasse es 5 Minuten abtropfen, damit überschüssige Flüssigkeit entweicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Aubergine, Tahini, Zitronensaft, Knoblauch und Salz in eine Küchenmaschine und püriere alles glatt und cremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Masse in eine Servierschüssel, beträufle sie mit Olivenöl und bestreue sie mit Paprikapulver und Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie bei Raumtemperatur mit Pitabrot und frischem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
