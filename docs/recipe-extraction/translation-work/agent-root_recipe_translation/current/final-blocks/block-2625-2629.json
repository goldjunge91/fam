      "steps": [
        {
          "position": 0,
          "text": "Gieße die gerösteten roten Paprika ab und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Walnüsse 3 Minuten in einer trockenen Pfanne, bis sie duften, und lasse sie dann etwas abkühlen.",
