      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und bräune die Lammwürfel portionsweise an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die gewürfelte Zwiebel im selben Topf weich an. Rühre Tomatenmark ein und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Lamm zurück in den Topf, füge Kardamom, Lorbeerblatt, Salz und Pfeffer hinzu und gieße die Brühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und lasse es zugedeckt 40 Minuten köcheln, bis das Lamm zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Mandeln in einer trockenen Pfanne, bis sie duften, und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche den Reis in einem separaten Topf nach Packungsanweisung, verwende dabei die Kochflüssigkeit vom Lamm statt Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle den Reis auf eine Servierplatte, gib Lamm und Sauce darauf und garniere alles mit den gerösteten Mandeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
