      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Zucker in einer großen Rührschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme in der Mitte eine Mulde und schlage die Eier hinein. Verquirle dann langsam die Milch unter, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre geschmolzene Butter und Vanilleextrakt ein, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Teig 15 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine beschichtete 8-inch-Pfanne oder Crêpepfanne bei mittelhoher Hitze und fette sie leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße etwa 1/4 cup Teig in die Mitte und neige die Pfanne sofort kreisförmig, damit sich der Teig dünn und gleichmäßig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Crêpe etwa 1-2 Minuten, bis die Unterseite hellgolden ist. Wende ihn und gare die andere Seite weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege den Crêpe auf einen Teller und wiederhole den Vorgang mit dem restlichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
