          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hühnerbrühe und Lorbeerblatt dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze, gib Krabbenfleisch dazu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Schlagsahne und Cayennepfeffer ein und würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Suppe bei niedriger Hitze weitere 10 Minuten köcheln und rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne das Lorbeerblatt und serviere die Suppe heiß in Schalen, nach Wunsch mit frischer Petersilie garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
