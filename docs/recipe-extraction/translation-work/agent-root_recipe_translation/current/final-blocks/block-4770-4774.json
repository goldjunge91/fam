      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl, Salz und 6 tablespoons Butter, bis eine krümelige Masse entsteht. Gib warmes Wasser dazu, bis sich ein Teig bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 5 Minuten. Decke ihn ab und lass ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate gehackte Zwiebel und Knoblauch weich an. Gib das Rinderhackfleisch dazu und brate es, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gehackte Oliven, Rosinen, Paprikapulver und Salz ein. Lass die Füllung vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 6 Stücke und rolle jedes Stück dünn zu einem Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 2 tablespoons Füllung auf jeden Kreis, klappe ihn in der Mitte zusammen und drücke die Ränder mit einer Gabel fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die Teigtaschen mit verquirltem Ei und backe sie bei 375°F 20 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
