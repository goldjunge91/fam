      "steps": [
        {
          "position": 0,
          "text": "Bringe die Hühnerbrühe in einem großen Topf mit gewürfelter Zwiebel, Karotten, Sellerie und Knoblauch zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die ganzen Hähnchenbrüste dazu und lass sie 15 Minuten köcheln, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Hähnchen aus dem Topf, zerpflücke es mit zwei Gabeln und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Eiernudeln in die Brühe und koche sie 8 Minuten, bis sie bissfest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das zerpflückte Hähnchen zurück in den Topf und rühre Salz, Pfeffer und Thymian ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Suppe 2 Minuten köcheln, probiere sie und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Suppe heiß in Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
