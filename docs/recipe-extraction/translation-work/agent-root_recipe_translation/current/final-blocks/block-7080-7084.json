      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie die Kartoffeln in dicke, etwa 1/4 Zoll breite Pommes Frites.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Pommes 30 Minuten in kaltem Wasser einweichen, um überschüssige Stärke zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Machen Sie eine Soße, indem Sie Rinderbrühe in einem Topf bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Maisstärke und Wasser vermischen, dann in die heiße Brühe einrühren und etwa 2 Minuten köcheln lassen, bis die Masse eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einem tiefen Topf oder einer Fritteuse auf 325 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln abgießen und trocken tupfen, dann portionsweise braten, bis sie goldbraun und knusprig sind, etwa 5–7 Minuten pro Portion.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Pommes auf Küchenpapier abtropfen lassen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiße Pommes in einen Behälter geben, mit Käsebruch belegen, alles mit heißer Soße übergießen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
