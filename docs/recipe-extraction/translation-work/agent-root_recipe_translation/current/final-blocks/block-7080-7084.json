      "steps": [
        {
          "position": 0,
          "text": "Rinderfilet gegen die Faserrichtung in etwa 1/4 Zoll dicke dünne Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sojasauce, braunen Zucker, gehackten Knoblauch, Ingwer, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rindfleischstreifen mit der Marinade vermengen, bis sie gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für den besten Geschmack abdecken und mindestens 4 Stunden oder über Nacht im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Ofen auf 180 °F vorheizen und ein Backblech mit Folie auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Marinierte Rindfleischstreifen in einer Schicht ohne Überlappung auf dem Backblech anordnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5–6 Stunden backen, bis das Rindfleisch getrocknet, aber noch leicht zäh ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lassen Sie es vollständig abkühlen, bevor Sie es als Snack servieren oder in einem luftdichten Behälter aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
