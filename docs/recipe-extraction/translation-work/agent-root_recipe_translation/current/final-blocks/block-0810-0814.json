      "steps": [
        {
          "position": 0,
          "text": "Röste den halbierten Ingwer und Knoblauch 3 Minuten direkt über einer Gasflamme oder in einer trockenen Pfanne, bis sie leicht schwarz werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Hühnerbrühe, angerösteten Ingwer und Knoblauch, Zimt und eine Prise Nelken dazu. Lass alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pochiere die Hähnchenbrüste 12 Minuten in der Brühe. Nimm sie heraus, zerpflücke sie und gib sie zurück in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weiche Reisnudeln 15 Minuten in warmem Wasser ein und blanchiere sie dann 30 Sekunden in kochendem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
