      "steps": [
        {
          "position": 0,
          "text": "Vermische Putenhack mit gehacktem Knoblauch, Ingwer, einem Schuss Fischsauce und Sesamöl. Forme daraus 18 kleine Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Fleischbällchen in einer leicht geölten Pfanne pro Seite 3–4 Minuten, bis sie durchgegart und leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Dip-Brühe zu: Verrühre Fischsauce, braunen Zucker, Limettensaft und ½ Tasse warmes Wasser, bis sich der Zucker aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare die Reisnudeln und spüle sie mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die kalten Nudeln in Schüsseln, die Fleischbällchen daneben und gieße die Dip-Brühe darüber. Garniere mit Salat, Minze, Koriander und Gurke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
