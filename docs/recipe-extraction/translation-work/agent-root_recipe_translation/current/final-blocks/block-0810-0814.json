      "steps": [
        {
          "position": 0,
          "text": "Gare den Reis. Verrühre Austernsauce, Sojasauce, Fischsauce und braunen Zucker zu einer Woksauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sesamöl in einem Wok bei sehr hoher Hitze. Gib gehackten Knoblauch und Chilis dazu und brate sie 30 Sekunden unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rinderhack hinzu und brate es unter Rühren 4–5 Minuten, bis es durchgegart ist. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Sauce dazu und schwenke alles 1 Minute. Nimm die Pfanne vom Herd und hebe frische Basilikumblätter unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Eier mit flüssigem Eigelb. Serviere das Rinderhack auf Reis mit einem Spiegelei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
