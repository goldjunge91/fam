          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Maismischung gleichmäßig über der Fleischfüllung in der Auflaufform verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
