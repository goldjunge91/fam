      "steps": [
        {
          "position": 0,
          "text": "Steaks 15 Minuten vor dem Garen aus dem Kühlschrank nehmen und mit Küchenpapier vollständig trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine gusseiserne Pfanne bei hoher Hitze erhitzen, bis sie sehr heiß ist und raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Steaks auf beiden Seiten großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Steaks in die heiße Pfanne legen und für medium-rare pro Seite 3–4 Minuten braten, ohne sie zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Steaks auf einen Teller legen und mit zerdrücktem Knoblauch und gehackter Petersilie bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "5 Minuten ruhen lassen und mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
