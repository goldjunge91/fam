      "steps": [
        {
          "position": 0,
          "text": "Milch mit der Zimtstange in einem Topf bei mittlerer Hitze erwärmen, bis sie gerade zu dampfen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl in einer kleinen Schüssel mit 1/2 Tasse kaltem Wasser glatt verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Maismehlmischung langsam unter ständigem Rühren in die heiße Milch gießen, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Unter weiterem Rühren 5–7 Minuten kochen, bis die Mischung eindickt und das Maismehl gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und braunen Zucker, Salz, Vanilleextrakt und Butter einrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Tassen füllen und warm servieren. Gelegentlich umrühren, während die Mischung weiter eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
