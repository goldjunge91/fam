      "steps": [
        {
          "position": 0,
          "text": "Kidneybohnen 8 Stunden oder über Nacht in Wasser einweichen, dann abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und das Rinderfilet von allen Seiten etwa 8 Minuten lang anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch in den Topf geben und etwa 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprika, Salz und schwarzen Pfeffer einrühren, dann abgetropfte Bohnen, Gerste und 8 Tassen Wasser hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringen Sie die Mischung zum Kochen, reduzieren Sie dann die Hitze auf eine niedrige Stufe, decken Sie sie ab und lassen Sie sie 8 Stunden lang köcheln (oder kochen Sie sie 8–10 Stunden lang in einem Slow Cooker auf niedriger Stufe).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gelegentlich umrühren und Wasser hinzufügen, wenn die Flüssigkeit zu stark reduziert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Der Cholent ist fertig, wenn das Fleisch sehr zart und die Bohnen ganz weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
