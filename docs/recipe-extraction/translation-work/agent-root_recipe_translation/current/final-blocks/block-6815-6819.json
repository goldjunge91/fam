      "steps": [
        {
          "position": 0,
          "text": "Schrubben Sie die Muscheln unter kaltem Wasser, entfernen Sie die Bärte und entsorgen Sie offene oder rissige Muscheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln würfeln, Knoblauch fein hacken und Fischfilets in 2 cm große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und Zwiebel und Knoblauch 4 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weißwein hinzufügen und 2 Minuten köcheln lassen, um die Menge zu reduzieren, dann zerkleinerte Tomaten, Fischbrühe, Salz und Pfefferflocken hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen und Fischstücke hinzufügen, dann 4 Minuten kochen lassen, bevor Garnelen und Muscheln hinzugefügt werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 6–8 Minuten garen, bis die Garnelen rosa sind, sich die Muscheln öffnen und der Fisch undurchsichtig ist. Entfernen Sie alle Muscheln, die sich nicht öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frischen Basilikum unterrühren und heiß in Schüsseln mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
