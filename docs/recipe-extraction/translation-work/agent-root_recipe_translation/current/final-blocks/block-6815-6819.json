      "steps": [
        {
          "position": 0,
          "text": "Wenn Sie ganzen Fisch verwenden, reinigen und entkernen Sie ihn; Fisch mit Papiertüchern trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer tiefen Pfanne oder einem Wok auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie den Fisch vorsichtig in heißes Öl und braten Sie den ganzen Fisch 8–10 Minuten pro Seite bzw. die Filets 4–5 Minuten pro Seite, bis er goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Fisch herausnehmen und auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gießen Sie das meiste Öl ab und lassen Sie 2 Esslöffel in der Pfanne. Fügen Sie gehackten Knoblauch, geschnittene Schalotten und getrocknete Chilis hinzu und kochen Sie es 2 Minuten lang, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fischsauce, Limettensaft und braunen Zucker in einer kleinen Schüssel verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sauce über den knusprigen Fisch gießen, mit geschnittenen Frühlingszwiebeln und Koriander bestreuen und sofort mit Jasminreis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
