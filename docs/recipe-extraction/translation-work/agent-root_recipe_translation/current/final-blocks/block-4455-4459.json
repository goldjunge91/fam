      "steps": [
        {
          "position": 0,
          "text": "Die Blätterteigplatten bei 400°F 12 Minuten backen, bis sie goldbraun sind, dann abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Milch in einem Topf erhitzen, bis sie dampft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eigelb mit Zucker und Maisstärke verquirlen, bis die Masse hell ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die heiße Milch langsam unter ständigem Rühren in die Eiermasse gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Masse zurück in den Topf geben und bei mittlerer Hitze unter Rühren garen, bis sie eindickt (etwa 3 Minuten); Vanille dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Creme vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weiße Glasur mit rosa Lebensmittelfarbe vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Blätterteigplatten halbieren, die unteren Schichten mit Creme bestreichen, mit dem restlichen Blätterteig bedecken und mit rosa Glasur überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
