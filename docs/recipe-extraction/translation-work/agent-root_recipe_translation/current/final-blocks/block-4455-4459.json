          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Portionsweise Löffel der Masse in das heiße Öl geben und mit der Rückseite eines Pfannenwenders flach drücken, sodass Puffer entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3-4 Minuten braten, bis die Unterseite goldbraun und knusprig ist, dann wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 3 Minuten braten, bis die andere Seite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
