      "steps": [
        {
          "position": 0,
          "text": "Paprika und Tomaten in 1 Zoll große Stücke würfeln, Zwiebeln in Spalten schneiden und Knoblauch hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen und Zwiebel und Knoblauch 3 Minuten anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Paprika hinzufügen und 5 Minuten kochen lassen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brechen Sie die Wurst auf und geben Sie sie in die Pfanne, bis sie braun ist, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Paprika einrühren und 1 Minute kochen, bis die Farbe intensiver wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tomaten, Salz und Pfeffer hinzufügen und dann ohne Deckel 20 Minuten köcheln lassen, bis die Paprika weich sind und die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nachwürzen, dann heiß als Hauptgericht oder Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
