      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter und Leber zusammen in Salzwasser 45 Minuten kochen, bis sie vollständig gar sind, dann abkühlen lassen und mahlen oder fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Speck fein würfeln und mit dem gegarten Hackfleisch vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Knoblauch fein hacken, in einer Pfanne 2 Minuten anbraten, bis sie weich sind, dann abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hackfleisch mit der abgekühlten Zwiebel-Knoblauch-Mischung, Paprika, Salz und Pfeffer gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit einem Trichter und den Fingern oder einem Wurstfüller die Wursthüllen mit der Fleischmasse füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hüllen mit einer Nadel leicht einstechen, damit sie nicht platzen, und in einen Topf mit kochendem Wasser geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20-25 Minuten köcheln lassen, bis die Hüllen fest sind und Hurka an die Oberfläche schwimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abgießen und in Scheiben geschnitten mit Senf und Roggenbrot heiß oder kalt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
