      "steps": [
        {
          "position": 0,
          "text": "Mehl, Milch, Eier, geschmolzene Butter und Salz verrühren, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eine Kaminkuchenform (oder eine kegelförmige Form) bei mittlerer bis hoher Hitze vorheizen und gut einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tauchen Sie die heiße Form in den Teig, um alle Seiten gleichmäßig zu bedecken, und lassen Sie sie dann 1-2 Minuten lang erhitzen, bis die untere Schicht fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wiederholen Sie das Eintauchen und Erhitzen 5-6 Mal und bauen Sie dabei Schichten um die Form auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zimt, Zucker und fein gehackte Walnüsse in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den gebackenen Kuchen aus der Form nehmen, wenn er goldbraun ist, sofort wälzen oder noch warm in der Zimt-Walnuss-Mischung bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einem Kuchengitter 5 Minuten abkühlen lassen, bevor es warm oder bei Zimmertemperatur serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
