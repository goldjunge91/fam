      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz verquirlen, dann eine Mulde formen und nach und nach Eier und Milch hinzufügen und umrühren, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitzen Sie eine beschichtete Pfanne oder Crêpepfanne bei mittlerer bis hoher Hitze und bestreichen Sie sie leicht mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie 0.25 Tassen Teig in die Mitte und kippen Sie die Pfanne sofort in alle Richtungen, um sie zu einem dünnen Kreis zu verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf der ersten Seite etwa 1-2 Minuten braten, bis es hellgolden ist, dann umdrehen und weitere 30 Sekunden braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Crêpe auf einen Teller geben und mit dem restlichen Teig wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das untere Drittel jedes Crêpes mit 1 Esslöffel Marmelade bestreichen, fest aufrollen und mit der Nahtseite nach unten auf einer Platte anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Klecks Sauerrahm belegen, mit Puderzucker bestäuben und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
