      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermischen, eine Mulde formen, Eier und Wasser hinzufügen und verrühren, bis ein krümeliger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hühnerbrühe in einem großen Topf zum Kochen bringen, Butter und Zwiebelwürfel hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig über die kochende Brühe halten, kleine Stücke (etwa erbsengroß) abschneiden und direkt in die Brühe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücken Sie die Teigstücke weiter zusammen und lassen Sie sie fallen, bis der gesamte Teig aufgebraucht ist. Rühren Sie dabei gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nach der Zugabe aller Teigstücke 8-10 Minuten köcheln lassen, bis sie schwimmen und vollständig gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehackte Petersilie unterrühren und zum Würzen abschmecken, je nach Bedarf mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schüsseln füllen und heiß als Wohlfühlsuppe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
