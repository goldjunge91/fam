      "steps": [
        {
          "position": 0,
          "text": "Zitronengras, Ingwer, Knoblauch, Schalotten, Chilis, Galgant, Kurkuma und Koriander zu einer Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Paste 5 Minuten in Öl anbraten. Rindfleisch dazugeben und mit der Paste überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kokosmilch angießen und Kaffir-Limettenblätter sowie Zitronengrasstängel hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ohne Deckel 2 Stunden köcheln lassen und gelegentlich umrühren, während die Flüssigkeit reduziert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald sich die Kokosmilch trennt und das Fleisch in Kokosöl brät, 10 Minuten ständig rühren, bis es kräftig karamellisiert und trocken ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
