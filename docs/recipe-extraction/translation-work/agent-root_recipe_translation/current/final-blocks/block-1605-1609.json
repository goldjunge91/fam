      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Erdnussbuttersauce kostet nur wenige Cent und wirkt trotzdem besonders.",
        "Das Gericht eignet sich gut, um Gemüse aufzubrauchen. Verwende, was wegmuss.",
        "Hart gekochte Eier halten geschält in Wasser im Kühlschrank 1 Woche."
      ],
