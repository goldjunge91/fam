      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Tontopf oder einem Topf mit schwerem Boden bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch und gewürfelte Zwiebel 3 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatensauce und Weißwein hinzufügen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Meeresfrüchtebrühe zugießen und sanft zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zuerst Venusmuscheln und Miesmuscheln hinzufügen und 3 Minuten garen, bis sie sich zu öffnen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garnelen und Fischstücke hinzufügen und weitere 5–7 Minuten garen, bis die Garnelen rosa und der Fisch undurchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nicht geöffnete Muscheln entfernen, mit Salz und Pfeffer würzen und im selben Topf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
