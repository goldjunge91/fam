      "steps": [
        {
          "position": 0,
          "text": "Tiefgekühlte Maiskörner mit 1 Tasse Milch vollständig glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die pürierte Maismischung durch ein feines Sieb streichen, um größere Stücke zu entfernen, und dabei die gesamte Flüssigkeit herausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die restlichen 3 Tassen Milch in einem großen Topf bei mittlerer Hitze erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Maisstärke in 3 Esslöffeln Wasser auflösen und unter ständigem Rühren zur erwärmten Milch geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgeseihte Maisflüssigkeit, Zucker, Salz und Butter in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "10–12 Minuten köcheln lassen und häufig umrühren, bis die Mischung eindickt und sich das Maisaroma entfaltet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vanille und Zimt einrühren und heiß in Schalen als dickflüssiges warmes Getränk servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
