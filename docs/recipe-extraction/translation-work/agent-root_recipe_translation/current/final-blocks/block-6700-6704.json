      ],
      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln in dicke Ringe schneiden und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 EL Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würzen Sie die Steaks mit Salz und Pfeffer und braten Sie sie dann für 4 Minuten pro Seite an (Medium-Rare).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Steaks herausnehmen und auf einem Teller beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das restliche Öl in die Pfanne und kochen Sie die Zwiebeln und den gehackten Knoblauch etwa 12 Minuten lang unter häufigem Rühren, bis sie karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Steaks wieder in die Pfanne geben und mit karamellisierten Zwiebeln belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit frischer Petersilie garnieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
