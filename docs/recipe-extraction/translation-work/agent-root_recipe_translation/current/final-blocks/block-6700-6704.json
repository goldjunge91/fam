          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Kartoffeln und Maiskörner in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weiter köcheln lassen, bis die Kartoffeln zart und das Rindfleisch gabelzart sind, etwa 25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schüsseln mit der Brühe servieren.",
