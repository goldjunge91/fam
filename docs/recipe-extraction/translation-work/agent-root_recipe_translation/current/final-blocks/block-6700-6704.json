      "steps": [
        {
          "position": 0,
          "text": "Frische Ananas schälen, entkernen und in kleine Würfel schneiden, dabei den Kern entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zucker und Wasser in einem schweren Topf bei mittlerer Hitze vermischen und rühren, bis sich der Zucker vollständig aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zimtstange, Nelken und eine Prise Salz hinzufügen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ananaswürfel und Limettensaft hinzufügen und 12–15 Minuten köcheln lassen, bis die Ananas sehr weich ist und der Sirup leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zimtstange und Nelken mit einer Gabel oder einem Schaumlöffel entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vollständig abkühlen lassen und dann als Dessertbelag, Beilage oder Würzmittel zu Reis oder Brot servieren.",
