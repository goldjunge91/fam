      "steps": [
        {
          "position": 0,
          "text": "Schäle und schneide Kartoffeln und Karotten in gleich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Kartoffeln und Karotten gemeinsam 15 Minuten in Salzwasser, bis sie sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die Zwiebel und brate sie in einer separaten Pfanne etwa 6 Minuten in Butter, bis sie goldbraun und weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Rinderhackfleisch in einer weiteren Pfanne bei mittlerer bis hoher Hitze etwa 8 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kartoffeln und Karotten ab und stampfe sie mit Butter, Milch, der angebratenen Zwiebel, Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre das gegarte Rinderhackfleisch unter den Kartoffel-Karotten-Stampf, bis alles gleichmäßig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib den Stampf in eine Servierschüssel und serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
