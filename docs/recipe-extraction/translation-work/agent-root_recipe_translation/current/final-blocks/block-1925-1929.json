      "steps": [
        {
          "position": 0,
          "text": "Bestreiche jede Auberginenscheibe mit etwas Öl und würze sie. Erhitze eine Grillpfanne oder den Grill. Grille die Scheiben auf der heißen Fläche 2-3 mins pro Seite, bis sie goldbraun und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Joghurt mit Tahini, Knoblauch, Zitronensaft und Kräutern und würze die Mischung. Gib das Dressing auf die Auberginen und streue zusätzliche Kräuterblätter darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
