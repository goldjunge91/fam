      "steps": [
        {
          "position": 0,
          "text": "Spüle die Rinderzunge ab und gib sie mit Wasser, der Hälfte der Zwiebel, Knoblauch, Salz, Pfefferkörnern und Lorbeerblättern in einen großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und lasse die Zunge zugedeckt 3 Stunden köcheln, bis sie sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Zunge heraus und lasse sie kurz abkühlen. Ziehe dann die äußere Haut mit einem Messer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die geschälte Zunge in dünne Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die restliche Zwiebel und die Jalapeños in einer Pfanne an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die geschnittene Zunge in die Pfanne und brate sie etwa 5 Minuten, bis sie leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie auf warmen Tortillas mit Koriander, gewürfelter Zwiebel und Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
