      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrüste auf 1/2-inch Dicke klopfen und eine Panierstation mit Mehl, verquirlten Eiern und mit Parmesan vermischtem Panko einrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Jede Hähnchenbrust zuerst in Mehl, dann in Ei und anschließend in der Panko-Mischung wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer Pfanne erhitzen und das panierte Hähnchen pro Seite 2-3 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Hähnchen auf ein Blech legen und jedes Stück mit Marinara-Soße und Mozzarella belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bei 375°F 12-15 Minuten backen, bis der Käse geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Servieren 2 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
