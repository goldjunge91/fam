      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweineschulter in 2-Zoll-Würfel und würze sie großzügig mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Schmalz in einem großen, schweren Topf bei mittlerer Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Schweinefleischwürfel, Knoblauch, Oregano, Kreuzkümmel, Lorbeerblätter und Zwiebel in das heiße Schmalz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf niedrig und lasse alles zugedeckt 2 bis 2.5 Stunden köcheln, bis das Fleisch sehr zart ist und sich leicht zupfen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Deckel ab und erhöhe die Hitze auf mittelhoch. Rühre gelegentlich um, bis das Schweinefleisch bräunt und das Fett austritt (etwa 30 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße überschüssiges Fett ab, zupfe das Fleisch mit zwei Gabeln auseinander und rühre Limettensaft unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme die Tortillas und serviere die Carnitas mit gewürfelter Zwiebel, Koriander und Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
