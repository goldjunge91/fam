      "steps": [
        {
          "position": 0,
          "text": "Röste Koriandersamen und schwarze Pfefferkörner in einer Pfanne 2 Minuten trocken an, bis sie duften, und mahle sie anschließend zu Pulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Zwiebeln, Tomaten und Knoblauch klein und püriere sie mit Kokosraspeln, gemahlenen Gewürzen, Chilipulver und Kurkuma zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Pflanzenöl in einem großen Topf und brate die Hähnchenschenkel an, bis sie leicht gebräunt sind, dann stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate im selben Topf die gehackten Zwiebeln goldbraun an, gib dann die Kokos-Gewürzpaste dazu und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in den Topf und wende es in der Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles bei mittlerer Hitze 25-30 Minuten köcheln, bis das Hähnchen vollständig gar ist und die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre gelegentlich um, damit nichts ansetzt, und schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
