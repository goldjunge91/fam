          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste alles weitere 8-10 Minuten, bis das Rindfleisch gar und der Brokkoli zart ist und knusprige Ränder hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
