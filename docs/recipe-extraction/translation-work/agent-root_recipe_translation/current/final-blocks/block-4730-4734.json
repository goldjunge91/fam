      "steps": [
        {
          "position": 0,
          "text": "Trage Handschuhe und entferne Stiele und Kerne der scharfen Chilis. Hacke sie sehr fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher bis hoher Hitze und gare gewürfelte Zwiebeln etwa 12 Minuten dunkelgoldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und Ingwer hinzu und gare sie 1 Minute, bis sie stark duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre alle gehackten Chilis und Tomatenmark ein und gare alles unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfeltes Hähnchen hinzu, wende es gründlich in der Gewürzpaste und gare es 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kokosmilch hinzu, reduziere die Hitze auf mittlere Stufe und lasse alles ohne Deckel 20 Minuten köcheln, bis das Hähnchen zart und die Sauce dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre gelegentlich um, damit nichts ansetzt und alles gleichmäßig gart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und serviere mit Reis und Joghurt zum Mildern der Schärfe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
