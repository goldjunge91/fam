      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze. Gib Currypaste hinzu und rühre 1 Minute, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße langsam Kokosmilch dazu und verrühre sie mit der Currypaste zu einer glatten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zupfe das Hähnchen vom Grill in mundgerechte Stücke und gib sie in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Fischsauce und braunen Zucker ein und gib dann gewürfelte rote Paprika und Bambussprossen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles 8-10 Minuten köcheln, bis die Paprika zart und die Sauce leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und hebe kurz vor dem Servieren frisches Basilikum unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Jasminreis servieren.",
