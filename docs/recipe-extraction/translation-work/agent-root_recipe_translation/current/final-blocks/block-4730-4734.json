      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilis und weiche sie 10 Minuten in heißem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere die eingeweichten Chilis mit Knoblauch, Zwiebel, Kreuzkümmel, Oregano, Essig und 0.5 Tasse Einweichwasser zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streiche die Paste bei Bedarf durch ein feines Sieb, damit sie besonders glatt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische die Schweinefleischscheiben mit der Chilipaste, bis sie gut überzogen sind, und mariniere sie mindestens 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen Pfanne bei hoher Hitze und brate das marinierte Schweinefleisch portionsweise etwa 4-5 Minuten knusprig und karamellisiert an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib alles gegarte Fleisch zurück in die Pfanne und füge gewürfelte Ananas hinzu. Erhitze alles 3 Minuten, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne oder über einer Flamme pro Seite 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Al-Pastor-Schweinefleisch in Tortillas, garniert mit Koriander und Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
