      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in 1-Zoll Würfel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Erdnussbutter, Sojasauce, Limettensaft, gehackten Knoblauch, Chiliflocken, Kokosmilch und braunen Zucker in einer kleinen Schüssel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 Esslöffel Öl in einem großen Wok oder einer Pfanne bei hoher Hitze. Brate die Hähnchenwürfel etwa 8 Minuten rundum goldbraun an und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl in die Pfanne und brate Paprikastreifen und Zwiebel etwa 4 Minuten bissfest an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in die Pfanne und gieße die Erdnusssauce darüber. Vermenge alles, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare alles weitere 3-4 Minuten, bis die Sauce eindickt und das Hähnchen überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
