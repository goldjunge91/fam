      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher bis hoher Hitze und bräune die Schweinefleischwürfel etwa 8 Minuten rundum an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die rote Currypaste in denselben Topf und gare sie unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße langsam 1 Dose Kokosmilch ein und verrühre sie mit der Currypaste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Schweinefleisch und die zweite Dose Kokosmilch hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib geschnittenen Ingwer, gehackten Knoblauch, geschnittene Schalotten, Fischsauce und Palmzucker dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfelte Kartoffeln hinzu und lasse alles zugedeckt 30 Minuten köcheln, bis Schweinefleisch und Kartoffeln gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Limettensaft ein und schmecke bei Bedarf mit mehr Fischsauce oder Zucker ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere mit frischem Koriander und serviere mit Jasminreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
