      "externalId": "waivy:mfr-african-bkfst-mandazi",
      "slug": "mfr-african-bkfst-mandazi",
      "title": "Kenianische Mandazi mit Joghurt-Dip",
      "instructions": "Leicht süßes ostafrikanisches frittiertes Gebäck mit Kardamom und Kokosmilch, dazu griechischer Joghurt zum Dippen, der die Süße mit Protein ausgleicht.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Mandazi hält sich 2 Tage und lässt sich im Toaster aufwärmen.",
        "Kokosmilch aus der Dose lässt sich portionsweise einfrieren. Für eine Portion brauchst du eine halbe Dose.",
        "Der Joghurt-Dip liefert Protein und gleicht die Süße aus."
      ],
      "substitutions": [
        {
          "forIngredientId": "coconut-milk",
          "swap": "Kuhmilch und ¼ tsp Kokosnussextrakt"
        },
        {
          "forIngredientId": "cardamom",
          "swap": "Zimt für einen vertrauteren Geschmack"
        }
      ],
