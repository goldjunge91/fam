        {
          "position": 0,
          "text": "Vermenge Mehl, Zucker, Kardamom und Backpulver. Rühre Ei und Kokosmilch ein, bis der Teig glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass den Teig 10 Minuten ruhen. Rolle ihn ½-inch dick aus und schneide Dreiecke aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Frittiere die Dreiecke in heißem Öl 2–3 Minuten pro Seite, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Serviere die Mandazi warm mit Naturjoghurt zum Dippen.",
