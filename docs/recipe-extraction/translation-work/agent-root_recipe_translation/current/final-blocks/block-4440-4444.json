      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in etwa 1/4 inch dicke dünne Stifte und lege sie 15 Minuten in kaltes Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einem tiefen Topf oder einer Fritteuse auf 350°F und frittiere die Kartoffeln portionsweise 3-4 Minuten, bis sie hellgolden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Pommes heraus, erhöhe die Temperatur auf 375°F und frittiere sie anschließend weitere 2-3 Minuten, bis sie dunkelgolden und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Pommes auf Küchenpapier abtropfen und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würfle die Zwiebel sehr fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Pommes in eine Servierschale und beträufle sie mit Mayonnaise und Erdnusssauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue sie großzügig mit der gewürfelten rohen Zwiebel und serviere sie sofort heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
