      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhackfleisch mit gewürfelter Zwiebel in einer Pfanne bei mittlerer Hitze an und zerkleinere es während des Garens, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter in einem Topf und rühre das Mehl ein, um eine Mehlschwitze herzustellen. Gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Rinderbrühe langsam unter ständigem Rühren dazu, bis die Masse eindickt, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die gegarte Fleischmischung ein und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Streiche die Masse zum Abkühlen auf einen Teller und stelle sie 15 Minuten kalt. Stelle sie anschließend 20 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme 8-10 Zylinder mit einer Länge von etwa 3 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verquirle die Eier in einer flachen Schüssel und gib das Paniermehl in eine andere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wende jede Krokette im Ei und überziehe sie anschließend vollständig mit Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Erhitze das Öl auf 350°F und frittiere die Kroketten portionsweise 2-3 Minuten, bis sie goldbraun sind. Lasse sie anschließend auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
