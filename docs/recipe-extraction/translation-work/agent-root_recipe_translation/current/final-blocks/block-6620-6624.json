      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebel und Knoblauch fein und vermische beides mit Hackfleisch, Paprika, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile die Masse in 3 gleich große Portionen und forme daraus dicke, flache Frikadellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl in einer Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Frikadellen je Seite 4-5 Minuten, bis sie durchgegart und gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Burgerbrötchen leicht in der Pfanne oder unter dem Backofengrill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide die Tomate in Scheiben und trenne die Zwiebelscheiben voneinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Frikadelle auf die untere Brötchenhälfte und belege sie mit Tomate und Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Setze die obere Brötchenhälfte darauf und serviere den Burger sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
