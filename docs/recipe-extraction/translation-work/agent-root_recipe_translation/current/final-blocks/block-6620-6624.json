      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Öl in einem großen Topf und brate die Hähnchenteile rundherum an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste die gewürfelten Zwiebeln und den gehackten Knoblauch an, bis sie duften. Rühre das Colombo-Gewürzpulver ein und brate es 1 Minute mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen mit der Hühnerbrühe zurück in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Kartoffelwürfel dazu und köchele sie 20 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die abgetropften Kichererbsen und Kokosmilch ein und köchele alles weitere 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere das Gericht heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
