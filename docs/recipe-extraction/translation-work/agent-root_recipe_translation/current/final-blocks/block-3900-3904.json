      "steps": [
        {
          "position": 0,
          "text": "In einer großen Schüssel Bauernkäse, Eier, Mehl, Zucker, Salz und Vanilleextrakt vermischen; mischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie einen Löffel Käsemischung auf die heiße Pfanne und drücken Sie jeden Löffel mit der Rückseite eines Löffels leicht flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2-3 Minuten pro Seite braten, bis die Ränder goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochtes Sirniki auf einen mit Papiertüchern ausgelegten Teller geben, um überschüssiges Öl abtropfen zu lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warm mit Saure Sahne und Konfitüre oder Honig darüberträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
