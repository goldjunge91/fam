      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf oder Schmortopf bei mittlerer bis hoher Hitze erhitzen und die Fleischwürfel portionsweise anbraten, etwa 3 Minuten pro Seite; beiseite legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im gleichen Topf die gewürfelten Zwiebeln ca. 3 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fügen Sie gehackten Knoblauch hinzu und kochen Sie ihn 1 Minuten lang, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Fleisch wieder in den Topf und rühren Sie das Tomatenmark ein, sodass das Fleisch gut bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wasser und Lorbeerblätter hinzufügen, zum Kochen bringen, dann die Hitze reduzieren und teilweise abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "30 Minuten köcheln lassen, bis das Fleisch fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kartoffeln und Karotten hinzufügen, die Hitze auf mittlere Stufe erhöhen und ohne Deckel 25-30 Minuten köcheln lassen, bis das gesamte Gemüse weich und das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Großzügig mit Salz und schwarzem Pfeffer würzen und dann heiß in Schüsseln mit reichlich Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
