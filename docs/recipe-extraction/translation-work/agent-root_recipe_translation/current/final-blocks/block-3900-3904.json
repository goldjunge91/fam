      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz, Wasser und 2 Esslöffel Öl in einer Schüssel vermischen, bis ein weicher Teig entsteht; glatt kneten, dann abdecken und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während der Teig ruht, braten Sie die gewürfelten Zwiebeln in 1 Esslöffel Öl an, bis sie goldbraun sind, und vermischen Sie sie dann mit Kartoffelpüree, Käse, Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in 4 gleiche Stücke teilen und jedes zu einem dünnen Oval von etwa 8 Zoll Länge ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteilen Sie die Kartoffel-Käse-Füllung in der Mitte jedes Ovals und lassen Sie die Ränder frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie es fest auf wie eine Biskuitrolle, drücken Sie die Nähte zusammen, um es abzudichten, und wickeln Sie dann jede Rolle auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Restliches Öl und Butter in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Aufgerollte Kutup-Rollen 4-5 Minuten pro Seite braten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit saurer Sahne oder geschmolzener Butter darüber träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
