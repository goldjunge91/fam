      "steps": [
        {
          "position": 0,
          "text": "Bereite die schnell eingelegte rote Zwiebel zu: Schneide 1 rote Zwiebel in dünne Scheiben und gib sie in ein kleines Glas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1/4 Tasse Wasser, 1/4 Tasse Weißweinessig und 1 TL weißen Zucker in das Glas. Rühre um, bis sich der Zucker auflöst, und lass die Zwiebeln mindestens 15 Minuten ziehen. Für einen kräftigeren Geschmack kannst du sie länger ziehen lassen. Im Kühlschrank halten sie sich bis zu 1 Woche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Toaste die Bagels und schneide sie in zwei Hälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche jede Bagelhälfte großzügig mit dem Dip aus gerösteter Paprika und Zwiebel oder mit Frischkäse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Belege die Bagels mit dünn geschnittener Gurke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Räucherlachs darauf und lege ihn locker in Falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die kleinen Kapern und die eingelegten roten Zwiebeln darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verfeinere die Bagels mit frischem Dill und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
