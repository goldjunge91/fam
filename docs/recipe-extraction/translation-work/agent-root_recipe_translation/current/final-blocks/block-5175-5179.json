      "steps": [
        {
          "position": 0,
          "text": "Bringe 4 quarts gesalzenes Wasser zum Kochen und koche die Pasta nach Packungsanweisung bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle währenddessen die Pancetta und brate sie in einer großen Pfanne bei mittlerer Hitze etwa 5-7 Minuten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle in einer Schüssel die Eier mit geriebenem Pecorino Romano und frisch gemahlenem schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe 1 cup Nudelwasser auf und gieße die Pasta dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd, gib die heiße Pasta zur Pancetta und vermenge alles rasch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Eiermischung unter ständigem Rühren über die Pasta. Gib das aufgehobene Nudelwasser jeweils 2-3 tablespoons hinzu, bis die Sauce cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht sofort mit zusätzlichem Käse und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
