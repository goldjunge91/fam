      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 EL Butter in einem Topf bei mittlerer Hitze und dünste die geschnittene Zwiebel etwa 6 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den gehackten Knoblauch dazu und gare ihn 30 Sekunden. Gieße dann Rinderbrühe und Worcestersauce an, bringe alles zum Köcheln und lasse es 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wenn du rohen Braten verwendest, schneide das Rindfleisch dünn auf und gare es in der Brühe. Roastbeefaufschnitt gibst du nur dazu und erwärmst ihn darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Sandwichbrötchen auf und lege Provolone auf die untere Hälfte jedes Brötchens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile das heiße Fleisch gleichmäßig auf die beiden Brötchen. Lege es auf den Käse und beträufle es mit etwas heißer Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die obere Brötchenhälfte darauf und setze die Sandwiches auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 350°F 5 Minuten, bis die Brötchen warm und der Käse geschmolzen sind. Serviere sie sofort mit der übrigen heißen Brühe zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
