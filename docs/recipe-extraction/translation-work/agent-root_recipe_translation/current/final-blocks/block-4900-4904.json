      "steps": [
        {
          "position": 0,
          "text": "Weiche die Gelatine 5 Minuten in kaltem Wasser ein und löse sie anschließend bei niedriger Hitze auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Brühe mit Schalotten, Estragon und Wein, bis sie köchelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle das Eiweiß und rühre es zum Klären in die Brühe. Lasse alles 10 Minuten köcheln und seihe die Brühe anschließend durch ein Passiertuch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische die geklärte Brühe mit der aufgelösten Gelatine und würze sie mit Salz, Pfeffer und Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße eine dünne Schicht Aspik in eine Terrinen- oder Kastenform und stelle sie kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile gegartes Gemüse oder Fleisch auf der festen Aspikschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße das übrige Aspik vorsichtig darüber und stelle die Form mindestens 4 Stunden kalt, bis alles fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Löse das Aspik aus der Form, indem du den Boden kurz in heißes Wasser tauchst. Gekühlt in Scheiben servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
