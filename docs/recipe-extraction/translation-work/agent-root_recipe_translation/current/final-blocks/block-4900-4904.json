      ],
      "steps": [
        {
          "position": 0,
          "text": "Bestreiche die Innenseiten der Brotscheiben mit Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Belege 2 Brotscheiben jeweils mit 1/4 lb Truthahn, 2 Scheiben Käse, Tomatenscheiben und Salatblättern. Lege die übrigen Brotscheiben darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 EL Butter in einer Pfanne oder auf einer Grillplatte bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege ein Sandwich hinein und brate es 3-4 Minuten, bis das Brot goldbraun ist und der Käse zu schmelzen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende das Sandwich vorsichtig und brate die andere Seite weitere 3-4 Minuten, bis sie goldbraun und der Käse vollständig geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Sandwich aus der Pfanne und wiederhole den Vorgang mit dem zweiten Sandwich und der restlichen Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Sandwiches diagonal durch und serviere sie sofort heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
