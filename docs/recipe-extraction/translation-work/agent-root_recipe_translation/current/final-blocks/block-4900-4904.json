      "steps": [
        {
          "position": 0,
          "text": "Bringe Salzwasser in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Garnelen hinein und gare sie 3-4 Minuten, bis sie rosa und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Garnelen ab und lege sie in ein Eisbad, bis sie vollständig abgekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Ketchup, Meerrettich, Zitronensaft, Worcestersauce und Chilisauce in einer Schüssel zur Cocktailsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege je ein Salatblatt in ein Servierglas und hänge die gekühlten Garnelen am Glasrand ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Cocktailsauce in die Mitte und serviere sie mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
