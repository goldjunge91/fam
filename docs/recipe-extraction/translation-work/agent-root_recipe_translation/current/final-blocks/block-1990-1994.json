      ],
      "steps": [
        {
          "position": 0,
          "text": "Vorbereitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische auf einem großen Backblech oder einer sauberen Arbeitsfläche die trockenen Zutaten: Mehl, Natron und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme in der Mitte eine Mulde und gib den Joghurt hinein. Vermische die Zutaten langsam mit den Händen, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knete den Teig auf einer bemehlten Fläche und gib zusätzliches Mehl dazu, falls er zu klebrig ist. Er ist fertig, wenn er die Konsistenz von Pizzateig hat und noch ganz leicht klebt. Das dauert nur einige Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib etwas Öl auf ein Backblech und lege den Teig darauf. Forme und drücke ihn zu einem Kreis mit etwa 5cm Höhe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche den Teig vollständig mit etwas Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Du kannst Kulaç so backen oder Muster hineindrücken, was auch für gleichmäßiges Garen sorgt. Häufig werden mit der Rückseite einer Gabel Linien eingedrückt oder der Teig wird mit der Gabel eingestochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schiebe das Brot auf die untere Schiene des vorgeheizten Ofens. Backe es 40 Minuten oder bis der Teig goldbraun und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Abkühlen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Nimm Kulaç aus dem Ofen und stelle es aufrecht hin oder lege es auf ein Kuchengitter, damit es abkühlen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Schneide Kulaç wie einen Kuchen in 8 Stücke. Wenn du es warm servierst, kannst du das Brot stattdessen mit den Händen auseinanderbrechen und zupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
