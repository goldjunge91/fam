      "steps": [
        {
          "position": 0,
          "text": "Teig zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib alle Zutaten in eine große Rührschüssel und vermische sie zu einem Teig. Er sollte klebrig sein. Gib zusätzliches Mehl dazu, falls er sich zu klebrig anfühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe etwas von der zusätzlichen geschmolzenen Butter über deine Hände. Teile den Teig in 20 gleich große Stücke und forme jedes zu einer Kugel. Reibe vor dem Formen jeder Kugel erneut geschmolzene Butter über die Hände.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Teigkugeln mit 5cm Abstand auf ein gefettetes oder mit Backpapier belegtes Blech. Du musst sie in zwei Portionen backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche jede Kugel mit verquirltem Ei und backe sie bei 180 Grad 20 Minuten. Die Kurabie sollten hellgolden und in der Mitte noch leicht weich sein. Lege sie zum Abkühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
