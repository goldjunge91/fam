      "steps": [
        {
          "position": 0,
          "text": "Vermische Sake oder Reiswein, Sojasauce, Sesamöl und in Wasser aufgelöste Maisstärke. Teile die Mischung in zwei Hälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge in einer Glasschale oder Schüssel die Hälfte der Sake-Mischung mit den Hähnchenstücken. Decke die Schale ab und stelle sie etwa 30 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische in einer mittelgroßen Pfanne die restliche Sake-Mischung mit Chilis, Essig und Zucker. Rühre Frühlingszwiebel, Knoblauch, Wasserkastanien und Erdnüsse unter. Erhitze die Sauce bei mittlerer Hitze langsam, bis sie aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm währenddessen das Hähnchen aus der Marinade und brate es in einer großen Pfanne an, bis der Fleischsaft klar austritt. Wenn die Sauce aromatisch ist, gib das gebratene Hähnchen dazu und lass alles köcheln, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
