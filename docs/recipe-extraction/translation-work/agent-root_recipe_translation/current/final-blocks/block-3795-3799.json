      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste gewürfelte Zwiebel, gehackten Knoblauch und geschnittenen Fenchel etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Kartoffeln, Dosentomaten samt Saft und in warmer Brühe eingeweichten Safran hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze und lasse alles 15 Minuten köcheln, bis die Kartoffeln teilweise gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib weiße Fischfilets und Garnelen in den Topf, bette sie in die Brühe ein und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Miesmuscheln hinzu und lasse sie ohne Deckel weitere 5-8 Minuten köcheln, bis sich die Schalen öffnen. Entsorge geschlossene Muscheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht, passe die Würzung mit Salz und Pfeffer an und serviere es heiß in breiten Schalen mit Brühe und Meeresfrüchten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
