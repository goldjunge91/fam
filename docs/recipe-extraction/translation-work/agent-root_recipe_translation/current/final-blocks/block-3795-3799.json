      "steps": [
        {
          "position": 0,
          "text": "Säubere frische Sardellen, indem du Köpfe und Innereien entfernst. Spüle sie gründlich unter kaltem Wasser ab und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide jede Sardelle längs in zwei Hälften und entferne vorsichtig das Rückgrat, sodass die beiden Filets am Schwanz verbunden bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schichte die Sardellenfilets in eine Glasschüssel, streue Salz zwischen die Lagen, decke sie ab und stelle sie 1 Stunde kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spüle die gesalzenen Sardellen unter kaltem Wasser ab und ordne sie in einer Lage in einem sauberen Glasgefäß an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Essig mit Wasser und gehacktem Knoblauch und gieße die Mischung über die Sardellen. Lasse sie auf Raumtemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße nach dem Abkühlen Olivenöl über die Sardellen, streue Petersilie und Chiliflocken darüber und stelle sie vor dem Servieren mindestens 3 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
