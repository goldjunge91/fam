      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter in 1 Zoll Würfel schneiden und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem schweren Topf bei mittlerer bis hoher Hitze erhitzen und das Schweinefleisch portionsweise etwa 3 Minuten pro Seite anbraten, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In Scheiben geschnittene Zwiebeln und gehackten Knoblauch in den Topf geben und etwa 6 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprikapulver und Tomatenmark einrühren und 2 Minuten kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das Schweinefleisch wieder in den Topf und fügen Sie Brühe, Lorbeerblätter und Thymian hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren, abdecken und 90 Minuten köcheln lassen, bis das Schweinefleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lorbeerblätter entfernen, abschmecken und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß über Polenta, Reis oder mit frischem Brot servieren, um die Soße aufzusaugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
