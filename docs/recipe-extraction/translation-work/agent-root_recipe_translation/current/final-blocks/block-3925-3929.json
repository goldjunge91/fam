      "steps": [
        {
          "position": 0,
          "text": "Warme Milch mit Hefe und 1 EL Zucker vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer großen Schüssel Mehl, restlichen Zucker und Salz vermischen und dann eine Mulde in die Mitte drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hefemischung, Eier und weiche Butter in die Mulde geben und verrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt und elastisch ist, dann in einer geölten Schüssel 1 Stunden gehen lassen, bis sich der Teig verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Füllung gemahlene Walnüsse mit Kakaopulver und Vanilleextrakt vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig zu einem Rechteck ausrollen, die Walnuss-Kakao-Füllung gleichmäßig verteilen und dann fest wie einen Baumstamm aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wickeln Sie die Rolle spiralförmig auf und legen Sie sie in eine gebutterte Kastenform. Lassen Sie sie 45 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 350°F 40-45 Minuten backen, bis es goldbraun ist und ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "In der Form 10 Minuten abkühlen lassen, dann zum vollständigen Abkühlen auf ein Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
