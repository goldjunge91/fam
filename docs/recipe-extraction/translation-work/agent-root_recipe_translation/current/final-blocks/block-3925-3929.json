      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und Zucker in einer großen Rührschüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Machen Sie in der Mitte eine Mulde und schlagen Sie die Eier hinein. Gießen Sie dann Milch und Wasser hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Von der Mitte nach außen glatt rühren, dann geschmolzene Butter einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lassen Sie den Teig 10 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitzen Sie eine beschichtete Pfanne oder Crêpe-Pfanne bei mittlerer bis hoher Hitze und ölen Sie sie leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gießen Sie etwa 1/4 Tasse Teig in die Mitte und kippen Sie die Pfanne, um ihn gleichmäßig in einem dünnen Kreis zu verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Etwa 1-2 Minuten kochen, bis die Unterseite hellgolden ist, dann umdrehen und die andere Seite 30 Sekunden kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf einen Teller geben und mit dem restlichen Teig wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Warm servieren, je nach Vorliebe mit Konfitüre, Honig, Saure Sahne oder Nutella.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
