      "steps": [
        {
          "position": 0,
          "text": "Vermische warmes Wasser, Hefe und Zucker und lasse die Mischung 5 Minuten stehen, bis sie schäumt. Verknete sie anschließend mit Mehl und Salz zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 5 Minuten glatt, decke ihn mit einem feuchten Tuch ab und lasse ihn 30 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 6 gleich große Stücke, forme Kugeln daraus und drücke sie leicht zu 3-Zoll großen Fladen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Rinderhack in einer Pfanne bei mittlerer bis hoher Hitze an und würze es anschließend mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib etwas gegartes Rindfleisch und ein Viertel einer Käsescheibe in die Mitte von 3 Teigfladen. Lege die übrigen Fladen darauf und drücke die Ränder zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe die Brötchen auf Backpapier in einem Dämpfeinsatz 12-15 Minuten, bis sie aufgegangen und vollständig gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide jedes Brötchen auf und fülle es mit Salat, Tomate, Mayonnaise sowie weiterem gegartem Rindfleisch und Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
