      "steps": [
        {
          "position": 0,
          "text": "Weiche Bambusspieße 30 Minuten in Wasser ein und stecke dann die Lammwürfel darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasoße, Sesamöl, Reisessig, Knoblauch, Ingwer, Kreuzkümmel und Chiliflocken in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche die Lammspieße großzügig mit der Marinade und lasse sie 15 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze einen Grill oder eine Grillpfanne stark und grille die Spieße 8-10 Minuten. Wende sie alle 2-3 Minuten und bestreiche sie dabei mit der restlichen Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hacke Frühlingszwiebeln und streue sie zusammen mit zusätzlichem Kreuzkümmel über die gegarten Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Spieße sofort mit zusätzlicher Soße zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
