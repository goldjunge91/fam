      "steps": [
        {
          "position": 0,
          "text": "Nimm die Rippen 1 Stunde vor dem Räuchern aus dem Kühlschrank und ziehe die Haut an der Knochenseite mit einem Papiertuch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Pfeffer, Paprikapulver, Knoblauchpulver und Cayennepfeffer und verteile die Mischung großzügig auf allen Seiten der Rippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Rippen mit der Knochenseite nach unten auf den Rost des Räucherofens. Räuchere sie bei 225°F mit Eichen- oder Hickoryholz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Räuchere die Rippen 4-5 Stunden und besprühe sie alle 45 Minuten mit der Mischung aus Apfelessig und Rinderbrühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Prüfe die Rippen nach 4 Stunden. Sie sind gar, wenn sich das Fleisch ½-Zoll von den Knochenenden zurückgezogen hat und eine Kerntemperatur von 203°F erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Rippen aus dem Räucherofen, wickle sie locker mit Butter in Folie und lasse sie 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die Rippen zwischen den Knochen durch und serviere sie heiß mit etwas von der Sprühflüssigkeit oder einer leichten Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
