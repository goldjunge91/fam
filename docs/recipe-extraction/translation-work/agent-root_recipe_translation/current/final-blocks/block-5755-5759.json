      "steps": [
        {
          "position": 0,
          "text": "Ritze die Schwarte des Schweinebauchs mit einem scharfen Messer rautenförmig ein. Schneide dabei nur durch die Schwarte, nicht ins Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Rosmarin, Salbei, Knoblauch und Fenchelsamen fein. Vermische sie mit Salz, Pfeffer und Olivenöl zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Kräuterpaste auf die Fleischseite des Schweinebauchs. Rolle ihn mit der Schwarte nach außen fest auf und binde ihn alle 2 Zoll mit Küchengarn zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die gerollte Porchetta in einen Bräter, gieße Wein und Wasser darum und brate sie bei 350°F 3 Stunden. Übergieße sie alle 30 Minuten mit Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhöhe die Ofentemperatur auf 450°F und brate das Fleisch weitere 30 Minuten, bis die Schwarte goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Porchetta 15 Minuten ruhen, schneide sie in 1-Zoll dicke Scheiben und serviere sie mit dem Bratensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
