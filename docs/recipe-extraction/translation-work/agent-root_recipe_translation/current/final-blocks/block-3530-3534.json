      "steps": [
        {
          "position": 0,
          "text": "Reisnudeln 30 Minuten in Wasser bei Raumtemperatur einweichen, bis sie biegsam sind, dann abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch mit Öl etwa 1 Minute in einem Wok oder einer großen Pfanne bei hoher Hitze anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen oder Hähnchen hinzufügen und garen, bis sie gerade durch sind, bei Garnelen etwa 3-4 Minuten, bei Hähnchen 5-6 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Ei in der Pfanne zur Seite schieben und darin verrühren, dann alles vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weiche Nudeln, Tamarindenpaste, Fischsauce und Zucker hinzufügen und 2-3 Minuten ständig wenden, bis alles vermischt und heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bohnensprossen und Frühlingszwiebeln hinzufügen und eine weitere Minute wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit zerstoßenen Erdnüssen und einem Spritzer frischem Limettensaft servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
