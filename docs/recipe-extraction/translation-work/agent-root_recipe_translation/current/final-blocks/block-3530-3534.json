      "steps": [
        {
          "position": 0,
          "text": "Knoblauch, Schalotten und Kurkuma in einem Mörser zu einer glatten Paste zerstoßen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Topf bei mittlerer Hitze erhitzen und die Paste 2-3 Minuten anbraten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschnittenen Galgant und Zitronengras in den Topf geben und 1 Minute umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch und Wasser angießen und sanft zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch oder Garnelen und lange Bohnen hinzufügen und 8-12 Minuten köcheln lassen, bis der Fisch gar und die Bohnen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Fischsauce abschmecken und die Schärfe nach Wunsch mit zusätzlichem Knoblauch anpassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schüsseln über oder neben Klebreis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
