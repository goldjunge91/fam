      "steps": [
        {
          "position": 0,
          "text": "Klebreis 30 Minuten in Wasser einweichen und dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gekochten Klebreis mit Kokosmilch und Salz vermengen, bis alles gleichmäßig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bambusröhren längs einschneiden oder ein Stück Alufolie zu einer Röhre formen und ein Ende verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Röhre fest zu drei Vierteln mit der Reismischung füllen und Platz lassen, damit sich der Reis ausdehnen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das offene Ende mit Folie oder Bananenblatt verschließen und die Röhren aufrecht etwa 45-60 Minuten in einen Topf mit kochendem Wasser stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vorsichtig herausnehmen und 5 Minuten abkühlen lassen, dann den Reis aus der Röhre auf einen Teller drücken und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
