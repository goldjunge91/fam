      "steps": [
        {
          "position": 0,
          "text": "Wasche frische Bockshornkleeblätter, hacke sie fein und drücke überschüssige Feuchtigkeit heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Vollkornmehl, gehackte Bockshornkleeblätter, Kurkuma, rotes Chilipulver, Asant und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Joghurt und 2 Esslöffel Öl zur Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib nach und nach Wasser hinzu, knete einen weichen Teig und lasse ihn 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 8-10 Portionen und rolle jede dünn oval aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze eine Grillplatte oder beschichtete Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege den Thepla auf die Grillplatte und gare ihn 1-2 Minuten, bis Flecken entstehen. Wende ihn und gare die andere Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle ihn mit dem restlichen Öl und gare ihn goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort mit Pickles oder Joghurt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
