      "steps": [
        {
          "position": 0,
          "text": "Säubere die Taro-Blätter und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Kichererbsenmehl, Kokosnuss, Sesamsamen, Erdnüsse, grüne Chili, Ingwer, Jaggery, Öl, Salz, Kurkuma und Asant zu einer dicken Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege ein Taro-Blatt flach hin und verstreiche 2 Esslöffel der Mischung auf der glänzenden Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle es von einem Ende her fest zu einem langen Zylinder auf und fixiere es bei Bedarf mit einem Zahnstocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wiederhole den Vorgang mit den übrigen Blättern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die gerollten Blätter mit der Naht nach unten in einen Dämpfeinsatz und dämpfe sie 25-30 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie aus dem Dämpfer und lasse sie vor dem Servieren leicht abkühlen. Nach Wunsch in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
