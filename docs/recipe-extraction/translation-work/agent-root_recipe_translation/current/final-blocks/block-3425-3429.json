      "steps": [
        {
          "position": 0,
          "text": "Vermische Vollkornmehl, Kurkuma, rotes Chilipulver, Kreuzkümmelsamen und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Joghurt und 2 Esslöffel Öl zu den trockenen Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach Wasser hinzu und knete einen weichen Teig. Lasse ihn 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8-10 gleich große Portionen und rolle jede dünn oval aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine gusseiserne Grillplatte oder Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege einen Thepla auf die Grillplatte und gare ihn 1-2 Minuten, bis helle Stellen erscheinen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende ihn und gare die andere Seite eine weitere Minute; drücke ihn dabei vorsichtig mit einem Tuch an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle beide Seiten mit dem restlichen Öl und gare sie, bis goldbraune Stellen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß mit Pickles oder Joghurt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
