      "steps": [
        {
          "position": 0,
          "text": "Vermische Weizenmehl, Vollkornmehl, Salz und Kurkuma. Gib Wasser hinzu, forme einen weichen Teig und stelle ihn 15 Minuten beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche 5 Tassen Wasser mit Dal, bis das Dal halb gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne, gib Kreuzkümmelsamen hinzu und dann Ingwer-Knoblauch-Paste und grüne Chili. Dünste alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße diese Würzmischung in den Dal-Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig dünn aus und schneide ihn in 2 Zoll breite Streifen oder Rauten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Dhokli-Stücke in die kochende Dal-Mischung und rühre vorsichtig, damit sie nicht ansetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles 15-20 Minuten köcheln, bis Dal und Dhokli vollständig gar und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Zitronensaft hinzu, schmecke mit Salz ab und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
