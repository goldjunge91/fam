            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Schmilz die Butter in einem großen Topf bei mittlerer Hitze und rühre die zerbröselten Graham-Cracker ein, bis sie vollständig mit Butter überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke die Graham-Cracker-Mischung als Boden in eine Backform mit 9 x 13 inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische im selben Topf gezuckerte Kondensmilch, Kondensmilch, Ube-Extrakt, Vanilleextrakt und eine Prise Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze die Mischung bei mittlerer bis niedriger Hitze und rühre 8-10 Minuten ständig, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib bei Wunsch Lebensmittelfarbe dazu, um den Lilaton zu verstärken, und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Ube-Mischung auf den Graham-Cracker-Boden und verstreiche sie gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Raumtemperatur abkühlen und stelle sie dann mindestens 2 Stunden kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide sie in Quadrate und serviere sie gekühlt. Bewahre Reste abgedeckt bis zu 5 Tage im Kühlschrank auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
