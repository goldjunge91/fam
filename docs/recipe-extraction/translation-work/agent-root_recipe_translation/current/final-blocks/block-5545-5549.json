      ],
      "steps": [
        {
          "position": 0,
          "text": "Gib entsteinte schwarze Oliven, Kapern, Sardellenpaste und gehackten Knoblauch in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere alles stoßweise, bis es grob gehackt, aber noch leicht stückig ist. Es soll keine glatte Paste entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Zitronensaft, Thymian und Olivenöl dazu und zerkleinere alles noch 2-3-mal, bis es vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Brotscheiben goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche jeden warmen Toast großzügig mit Tapenade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Träufle etwas Olivenöl darüber und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
