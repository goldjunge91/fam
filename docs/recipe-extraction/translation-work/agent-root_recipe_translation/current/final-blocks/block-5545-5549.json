          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche beide Seiten leicht mit Olivenöl und röste sie bei 400°F pro Seite 3-4 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die warme Oberfläche jeder Scheibe mit der Schnittfläche einer Knoblauchzehe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Halbiere die Tomate und reibe sie über das geröstete Brot, sodass Saft und Fruchtfleisch darauf bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Träufle etwas Olivenöl darüber und streue Meersalz darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zupfe den Jamón in Stücke und verteile ihn auf den Tostas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sofort, solange das Brot noch warm ist.",
