      "steps": [
        {
          "position": 0,
          "text": "Schneide das Schweinefleisch in 1 inch große Würfel und gib es mit geviertelter Zwiebel, Knoblauch, Lorbeerblatt, Thymian und Salz in einen Topf. Bedecke alles mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe das Wasser zum Köcheln, decke den Topf ab und gare das Fleisch 25-30 Minuten, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Fleisch ab und fange ¼ cup Kochflüssigkeit auf. Entferne die Gewürze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zupfe das warme Schweinefleisch mit zwei Gabeln auseinander, bis es wie Pulled Pork aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Fleisch in eine Schüssel und vermenge es mit weicher Butter, Salz, Pfeffer und nach Wunsch Cornichons. Rühre die aufgefangene Kochflüssigkeit 1 tbsp (Esslöffel)weise ein, bis die Masse streichfähig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Brotscheiben goldbraun und bestreiche sie großzügig mit Rillettes.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm oder bei Raumtemperatur mit Cornichons dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
