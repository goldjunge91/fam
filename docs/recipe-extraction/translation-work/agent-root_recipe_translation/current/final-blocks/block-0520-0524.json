    {
      "externalId": "waivy:toh-turkey-gyros",
      "slug": "toh-turkey-gyros",
      "title": "Puten-Gyros",
      "instructions": "Mageres Putenfleisch wird mit griechischer Gewürzmischung kurz angebraten und dann mit knackigem Salat, saftiger Tomate und kühler, cremiger Gurken-Dill-Sauce in warmes Pitabrot gefüllt. Eine schnelle, frische Variante eines mediterranen Klassikers für den Abend unter der Woche. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/turkey-gyros/",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 5,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
