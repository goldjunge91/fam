      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375 Grad F vor. Schmelze die Butter in einer ofenfesten oder gusseisernen 10-Zoll-Pfanne und gare die gehackte Zwiebel, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streue Mehl, Salz und Pfeffer darüber und rühre, bis die Mischung glatt ist und eine Paste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe und Milch langsam unter Rühren dazu. Bringe alles zum Kochen und gare es etwa 2 Minuten, bis die Sauce dick und blubbernd ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gegarten Truthahn, Erbsen und Karotten ein, bis alles durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile die Brötchen und lege sie auf den Eintopf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe das Gericht 20 bis 25 Minuten, bis die Brötchen aufgegangen und goldbraun sind. Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
