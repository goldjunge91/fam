      "steps": [
        {
          "position": 0,
          "text": "Schäle die Gurke. Hacke etwa ein Drittel fein und schneide den Rest in dünne Scheiben. Stelle die Scheiben zum Servieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Für die Sauce saure Sahne, gehackte Zwiebel, Dill, Zitronensaft und die fein gehackte Gurke verrühren. Bis zum Servieren kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer beschichteten Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Putenstreifen dazu und brate sie 4 bis 6 Minuten, bis sie gar und nicht mehr rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Streue die griechische Gewürzmischung darüber und wende die Putenstreifen, bis sie gleichmäßig gewürzt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme die Pitabrote und belege jedes mit Pute, fein geschnittenem Salat, Tomatenscheiben und den beiseitegestellten Gurkenscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löffle die Gurken-Dill-Sauce darüber und gib zum Schluss zerbröselten Feta dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
