      "steps": [
        {
          "position": 0,
          "text": "Erhitze eine große Pfanne bei mittlerer Hitze. Gib Putenhack, rote und gelbe Paprika, Zwiebel und Knoblauch hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare alles 6-8 Minuten und zerteile dabei das Putenhack, bis es nicht mehr rosa und das Gemüse weich ist. Gieße überschüssige Flüssigkeit ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Salsa, Kidneybohnen, Chilipulver und Kreuzkümmel ein. Erhitze alles, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den zerrissenen Römersalat auf vier Tellern und gib die warme Putenmischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreue den Salat mit frischem Koriander und gib nach Wunsch gehackte Tomate, geriebenen Cheddar oder zerstoßene Tortillachips darüber. Warm sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
