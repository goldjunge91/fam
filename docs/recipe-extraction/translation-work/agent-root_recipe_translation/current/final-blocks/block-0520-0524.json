      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425 F vor und setze einen Rost in ein ungefettetes, tiefes Backblech mit Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße das Ranch-Dressing in eine flache Schüssel. Vermenge in einer zweiten flachen Schüssel die gewürzten Semmelbrösel mit dem geriebenen Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tauche jedes Schweinekotelett in das Ranch-Dressing und drücke es dann auf beiden Seiten fest in die Bröselmischung, damit die Panade haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die panierten Koteletts nebeneinander auf den Rost.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie 15 bis 20 Minuten, bis die Kruste goldbraun ist und die Kerntemperatur 145 F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Koteletts vor dem Servieren 5 Minuten ruhen, damit sich der Fleischsaft verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
