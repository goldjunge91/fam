      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermengen, dann nach und nach Wasser hinzufügen und kneten, bis ein glatter, fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig abdecken und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hackfleisch, gehackte Zwiebel, Knoblauch, Ingwer, Koriander, Sojasauce und Öl in einer Schüssel für die Füllung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig dünn ausrollen und mit einem Glas oder Ausstecher Kreise von 2-inch ausschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeweils einen Esslöffel Füllung in die Mitte jedes Kreises geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Kreis halbieren, dann die beiden Ecken zusammenführen und festdrücken, sodass eine Taschenform entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Einen großen Topf Wasser zum Kochen bringen und die Momos portionsweise hineingeben; vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Momos herausnehmen, sobald sie an die Oberfläche steigen, weitere 2-3 Minuten garen und dann auf einen Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß mit Sesamöl und Chilisauce zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
