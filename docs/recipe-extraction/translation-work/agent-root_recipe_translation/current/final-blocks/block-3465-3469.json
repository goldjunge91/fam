      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln dünn schneiden und Knoblauch, Ingwer sowie rote Chilis fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer Hitze erhitzen und Zwiebeln etwa 15 Minuten goldbraun und karamellisiert braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch, Ingwer und rote Chilis hinzufügen und 2 Minuten unter ständigem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abgetropften Thunfisch hinzufügen, mit einem Löffel zerteilen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tamarindenpaste, Jaggery, Salz und Curryblätter hinzufügen und gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei mittelniedriger Hitze 5-8 Minuten garen, bis sich die Aromen verbinden und die Mischung klebrig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren oder Aufbewahren in einem luftdichten Behälter vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
