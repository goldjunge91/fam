      "steps": [
        {
          "position": 0,
          "text": "Linsen und Reis getrennt unter kaltem Wasser abspülen, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und Kreuzkümmelsamen hinzufügen; 10 Sekunden brutzeln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch und Ingwer hinzufügen und 1 Minute anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackte Zwiebel hinzufügen und etwa 3 Minuten garen, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abgespülte Linsen, Kurkuma und Salz hinzufügen und 1 Minute gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "3 cups Wasser angießen, aufkochen und dann abgedeckt 20 Minuten köcheln lassen, bis die Linsen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einem separaten Topf 2 cups Wasser zum Kochen bringen, Reis und Salz hinzufügen und dann abgedeckt 15-18 Minuten köcheln lassen, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reis und Dal zusammen auf einem Teller servieren und leicht vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
