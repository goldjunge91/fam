  "recipes": [
    {
      "externalId": "waivy:cur-mango-sago",
      "slug": "cur-mango-sago",
      "title": "Mango-Sago-Dessert",
      "instructions": "Ein gekühltes Dessert aus Hongkong: reife Mango wird zu einer seidigen Kokos-Kondensmilch-Creme püriert und mit elastischen Tapioka-Sago-Perlen sowie frischen Mangowürfeln vermischt. Kalt, cremig und fruchtig, mit nur wenig Kochaufwand.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Verwende sehr reife Mangos aus dem Angebot. Ataulfo- oder Champagne-Mangos sind besonders süß und brauchen meist keinen zusätzlichen Zucker.",
        "Sago-Perlen sind günstig und lange haltbar. Koche gleich eine größere Menge und stelle sie für mehrere Desserts kalt.",
        "Ersetze einen Teil der Kokosmilch durch Kondensmilch ohne Zucker, um Kosten zu sparen und die Creme dennoch reichhaltig zu halten."
      ],
      "substitutions": [
        {
          "forIngredientId": "coconut-milk",
          "swap": "all evaporated Milch oder whole Milch für ein lighter, cheaper version",
          "savings": "~$1.00"
        },
        {
          "forIngredientId": "sweetened-condensed-milk",
          "swap": "2 tbsp Zucker plus ein splash mehr Milch",
          "savings": "~$0.40"
        },
        {
          "forIngredientId": "sago",
          "swap": "klein pearl tapioca aus der Backen aisle (same thing)",
          "savings": "oft günstiger"
        }
      ],
