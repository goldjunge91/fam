      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in mundgerechte Stücke schneiden und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und Hähnchen insgesamt etwa 5 Minuten von allen Seiten anbraten. Herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf gewürfelte Zwiebel und gehackten Knoblauch etwa 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stiele und Kerne der getrockneten Chilis entfernen, sie in einer trockenen Pfanne 30 Sekunden leicht rösten, dann 10 Minuten in heißem Wasser einweichen und abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eingeweichte Chilis, Kürbiskerne, Tomaten und 1 Tasse Hühnerbrühe glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die pürierte Mischung durch ein feinmaschiges Sieb in den Topf gießen und die festen Bestandteile entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die restliche Hühnerbrühe hinzufügen und das gegarte Hähnchen zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "20–25 Minuten köcheln lassen, bis das Hähnchen gar ist und sich die Aromen verbinden. Abschmecken und nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
