      ],
      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter in 2 Zoll große Stücke schneiden und mit Wasser, Salz, Knoblauch, Lorbeerblättern, Kreuzkümmel und schwarzem Pfeffer in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zum Kochen bringen, Hitze reduzieren und 3–4 Stunden köcheln lassen, bis das Schweinefleisch sehr zart ist und auseinanderfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fleisch aus der Brühe nehmen und mit zwei Gabeln fein zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe abseihen und das zerpflückte Schweinefleisch mit 1 Tasse Brühe zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "30 Minuten köcheln lassen, bis das Fleisch die Flüssigkeit aufgenommen hat und zusammenzuhalten beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gegarte Fleischmischung auf einem mit Backpapier belegten Backblech verteilen und mit einem Pfannenwender oder einem zweiten Blech fest andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mindestens 4 Stunden kühlen, bis die Masse vollständig fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Rechtecke schneiden, Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und die Chicharrones pro Seite etwa 3 Minuten knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
