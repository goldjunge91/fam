      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in Salzwasser 25–30 Minuten vollständig gar kochen. In mundgerechte Stücke zerpflücken und 4 Tassen Brühe aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Getrocknete Guajillo- und Ancho-Chilis 30 Sekunden in einer trockenen Pfanne rösten, dann 10 Minuten in heißem Wasser einweichen. Abgießen und Stiele sowie Kerne entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eingeweichte Chilis, Tomaten, die Hälfte der Zwiebel und Knoblauch mit 1 Tasse der aufgehobenen Hühnerbrühe vollständig glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die pürierte Mischung durch ein feinmaschiges Sieb in einen Topf streichen und die festen Bestandteile ausdrücken, um die gesamte Flüssigkeit zu gewinnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die abgesiebte Sauce bei mittlerer Hitze erwärmen und 5 Minuten köcheln lassen, damit der rohe Chili-Geschmack verschwindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die übrigen 3 Tassen Brühe, zerpflücktes Hähnchen und die gewürfelte restliche Zwiebel hinzufügen und 15–20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frischen Koriander einrühren und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schalen servieren, traditionell mit Maistortillas dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
