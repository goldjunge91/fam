      "steps": [
        {
          "position": 0,
          "text": "Masa Harina, warmes Wasser und Salz vermengen, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Käse, Paprika und Zwiebel fein würfeln und mit schwarzem Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 12 gleich große Portionen teilen und zu Kugeln formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Kugel zwischen Frischhaltefolie zu einem Kreis von 3 Zoll Durchmesser drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeweils 1 Esslöffel Käsemischung in die Mitte eines Teigkreises geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ränder über der Füllung zusammenklappen und zu einem kleinen Päckchen verschließen, dann vorsichtig flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne bei mittlerer bis hoher Hitze erhitzen und Pastelitos pro Seite 2–3 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
