      "steps": [
        {
          "position": 0,
          "text": "Hähnchen, Schweinefleisch und Rindfleisch getrennt in Salzwasser 1–1.5 Stunden zart kochen. Abkühlen lassen und in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln, Karotten und Rote Bete getrennt in Salzwasser kochen, bis sie gerade weich sind. Abkühlen lassen und in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kohl, Radieschen und rote Zwiebel dünn schneiden und in eine große Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Alle gegarten Fleischsorten, das Gemüse und die tiefgekühlten Erbsen in die Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Essig, Öl, Salz und Pfeffer verquirlen und über die Mischung gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alles vorsichtig, aber gründlich vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fiambre vor dem Servieren mindestens 30 Minuten bei Raumtemperatur marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und bei Bedarf zusätzlich Salz, Pfeffer oder Essig hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
