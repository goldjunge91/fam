      "steps": [
        {
          "position": 0,
          "text": "Erhitze einen Wok oder eine große Pfanne, bis sie sehr heiß ist, und gib 1 tbsp Öl hinein. Sobald es sehr heiß ist, füge das Hähnchen hinzu und brate es bei hoher Hitze 8-10 Minuten unter Rühren, bis es rundum gebräunt ist. Nimm es mit einem Schaumlöffel heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze den Wok erneut und gib das restliche Öl hinein. Füge Knoblauch und Schalotten hinzu und brate sie 3 Minuten unter Rühren goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen zurück in den Wok und füge Chilis, Fischsoße, dunkle Sojasoße und Zucker hinzu. Brate alles bei hoher Hitze weitere 8-10 Minuten oder bis das Hähnchen gar ist. Rühre Basilikumblätter ein und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
