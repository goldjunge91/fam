      "steps": [
        {
          "position": 0,
          "text": "Koche die Nudeln nach Packungsangabe, aber 1 Minute kürzer. Spüle sie kalt ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen dazu und gare es 1-2 Minuten, bis es leicht zu bräunen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Laksa- oder Currypaste ein und gare sie 30 Sekunden, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch und Hühnerbrühe hinein und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Halbiere die Tofustückchen mit einer Küchenschere. Gib sie mit Fischsauce und Limettensaft in den Topf und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre die Hälfte der Sojasprossen unter und schalte dann die Hitze aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Nudeln auf Schüsseln und schöpfe die Laksa darüber. Mit den übrigen Sojasprossen, Limettenspalten, knusprig gebratenen Schalotten, Frühlingszwiebel, Koriander und nach Wunsch frischer Chili garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
