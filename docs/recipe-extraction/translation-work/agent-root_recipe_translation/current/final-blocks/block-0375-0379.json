      "steps": [
        {
          "position": 0,
          "text": "Decke die Hähnchenschenkel mit Backpapier ab und klopfe sie mit einem Nudelholz oder Fleischklopfer auf eine gleichmäßige Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Hähnchen, Paprikapulver, Oregano, Meersalz, schwarzen Pfeffer, Knoblauch, Olivenöl, Zitronensaft und Zitronenschale in einer Schüssel. Wende alles gut, bis es überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sofort garen oder für kräftigeren Geschmack bis zu 24 Stunden marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine große Pfanne bei mittelhoher Hitze. Gare das Hähnchen etwa 8 Minuten und wende es nach der Hälfte der Zeit einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 EL Wasser dazu, um die knusprigen Bratensäfte vom Pfannenboden zu lösen. Gare das Hähnchen dann weitere 2 Minuten, bis es vollständig durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit griechischem Salat, warmem Fladenbrot und Tzatziki servieren.",
          "timerMinutes": null,
