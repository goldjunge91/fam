    {
      "externalId": "waivy:she-easy-curry-laksa",
      "slug": "she-easy-curry-laksa",
      "title": "Schnelle Hähnchen-Laksa",
      "instructions": "Eine schnelle, duftende Laksa nach malaysischer Art mit zartem Hähnchen, elastischen Nudeln und Tofustückchen in einer cremigen Kokos-Curry-Brühe. Mit knackigen Sojasprossen, Limette und frischen Kräutern gekrönt ist sie in 15 Minuten unter der Woche fertig. Rezept von Simple Home Edit: https://simplehomeedit.com/recipe/easy-curry-laksa/",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 10,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Tausche Hähnchenbrust gegen Hähnchenschenkel oder festen Tofu, um das Budget weiter zu strecken.",
        "Kaufe eine große Dose Laksa-Paste und friere sie esslöffelweise ein, damit sie monatelang reicht.",
        "Verwende Brühwürfel der Hausmarke, in Wasser aufgelöst, statt 2L abgepackter Hühnerbrühe, um die Kosten stark zu senken."
      ],
      "substitutions": [
        {
          "forIngredientId": "laksa-paste",
          "swap": "Rote Currypaste mit einer Prise Kurkuma und gemahlenem Koriander",
          "savings": "verwendet Vorratszutaten statt a Spezial- jar"
        },
        {
          "forIngredientId": "ramen",
          "swap": "Reisvermicelli oder Eiernudeln",
