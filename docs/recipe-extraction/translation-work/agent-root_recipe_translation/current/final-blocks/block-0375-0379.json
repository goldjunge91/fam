      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen, schweren Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelten Speck dazu und gare ihn 2-3 Minuten, bis er goldbraun ist. Füge Knoblauch hinzu und gare alles unter Rühren 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tiefkühlerbsen und -mais dazu. Gare alles unter Rühren weitere 1 Minute, bis das Gemüse gerade aufgetaut ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe alles auf eine Seite der Pfanne und gieße die verquirlten Eier hinein. Gare sie 2-3 Minuten, bis sie fest sind, und zerteile sie mit einem Pfannenwender in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochten Reis, geschnittene Frühlingszwiebel, Sesamöl und Tamari dazu. Rühre vorsichtig um und erhitze den Reis vollständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiß servieren und nach Wunsch mit knusprig gebratenen Schalotten bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
