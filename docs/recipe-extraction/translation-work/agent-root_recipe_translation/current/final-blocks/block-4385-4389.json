      "steps": [
        {
          "position": 0,
          "text": "Rinderlende in 1.5 Zoll große Würfel schneiden und in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl, Essig, gehackten Knoblauch, Lorbeerblätter und Pfefferkörner in einer Schüssel zu einer Marinade verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Marinade über das Rindfleisch gießen, vermengen und mindestens 2 Stunden oder über Nacht im Kühlschrank marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das marinierte Rindfleisch auf Metallspieße stecken und dabei Lorbeerblätter aus der Marinade abwechseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Grill oder eine Grillpfanne auf hohe Hitze erhitzen und die Spieße 3-4 Minuten pro Seite für ein englisch-rosa Ergebnis garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen, mit Salz würzen und 2 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß auf den Spießen servieren, mit frischer Petersilie garnieren und knuspriges Brot dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
