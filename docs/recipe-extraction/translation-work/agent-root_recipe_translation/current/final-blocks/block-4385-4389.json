      "steps": [
        {
          "position": 0,
          "text": "Gesalzenen Kabeljau 24 Stunden in kaltem Wasser einweichen und das Wasser alle 8 Stunden wechseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den entsalzten Kabeljau 10 Minuten kochen, bis er zart ist, dann fein zupfen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln weich kochen, schälen und glatt stampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffelstampf mit gezupftem Kabeljau, gehackter Zwiebel, Petersilie, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Mischung zu ovalen Bällchen von etwa 3 Zoll Länge und 1 Zoll Dicke formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier in einer Schüssel verquirlen, dann jedes Bällchen mit Mehl bestäuben, in Ei tauchen und erneut mit Mehl bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl auf 350°F erhitzen und die Bällchen 2-3 Minuten pro Seite goldbraun frittieren, dann auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
