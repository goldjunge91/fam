      "steps": [
        {
          "position": 0,
          "text": "Den Oktopus 45 Minuten in Salzwasser kochen, bis er zart ist, dann abgießen und in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebeln und Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 2 Minuten braten, dann die gegarten Oktopusstücke hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weißwein angießen und 2 Minuten kochen lassen, damit er leicht einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reis hinzufügen und 2 Minuten unterrühren, damit er leicht anröstet, dann Hühnerbrühe und Lorbeerblatt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren, abdecken und 20 Minuten köcheln lassen, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, Petersilie einrühren, mit Salz und Pfeffer würzen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
