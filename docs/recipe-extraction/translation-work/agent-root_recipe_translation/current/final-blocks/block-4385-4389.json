      "steps": [
        {
          "position": 0,
          "text": "Gesalzenen Kabeljau 24 Stunden einweichen, dabei das Wasser alle 8 Stunden wechseln, dann 15 Minuten kochen, bis er zart ist, und zupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln schälen und würfeln, dann 15 Minuten in Salzwasser kochen, bis sie halb gar sind, und abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf erhitzen und geschnittene Zwiebeln und gehackten Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark einrühren und 2 Minuten braten, dann Weißwein und Lorbeerblatt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den gezupften gesalzenen Kabeljau und die halb gegarten Kartoffeln hinzufügen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frische Fischfilets hinzufügen und 8-10 Minuten sanft köcheln lassen, bis der Fisch vollständig gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer würzen, mit frischer Petersilie garnieren und in tiefen Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
