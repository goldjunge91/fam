      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittlerer Hitze und brate Zwiebel 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib in feine Streifen geschnittene Rote Bete und Karotten dazu und gare alles unter Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Rinderbrühe dazu und bringe sie zum Kochen. Füge dann gewürfelte Kartoffeln und Kohl hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze und lasse alles 15 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatenmark, Essig und Zucker gründlich ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Suppe weitere 5 Minuten köcheln und würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß und gib in jede Schale einen Klecks saure Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
