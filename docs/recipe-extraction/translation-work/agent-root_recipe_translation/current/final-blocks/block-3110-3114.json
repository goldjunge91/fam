      "steps": [
        {
          "position": 0,
          "text": "Röste Zwiebel und Ingwer unter dem Grill 2 Minuten pro Seite, bis sie geschwärzt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Rinderbrühe in einem großen Topf zum Kochen und gib geröstete Zwiebel, Ingwer, Sternanis und Zimtstange dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze und lasse die Brühe 20 Minuten köcheln, damit sich die Aromen entfalten. Seihe sie dann ab und entsorge die festen Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Brühe zurück in den Topf und bringe sie zum Kochen. Füge Fischsauce hinzu und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Reisnudeln nach Packungsanweisung in einem separaten Topf und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die gekochten Nudeln auf Servierschalen und belege sie mit dünn geschnittenem Rindfleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße heiße Brühe über Fleisch und Nudeln; die Resthitze gart das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege jede Schale mit Sojasprossen und serviere sie mit frischem Basilikum, Limettenspalten und Jalapeño zum Garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
