      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne von Chipotle- und Ancho-Chilis und weiche sie 15 Minuten in heißem Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Kreuzkümmelsamen 1 Minute in einer trockenen Pfanne, bis sie duften, und mahle sie dann grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere die eingeweichten Chilis mit Knoblauch, Kreuzkümmel, Essig und 1 cup Brühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate den Rinderschulterbraten in einem Schmortopf bei hoher Hitze rundum an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Chilimischung und die restliche Brühe über den Braten, gib Lorbeerblätter hinzu, decke den Topf ab und stelle ihn in den 325°F heißen Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmore das Fleisch 5-6 hours, bis es sich sehr leicht mit einer Gabel auseinanderziehen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Fleisch heraus und zupfe es fein. Seihe die Schmorflüssigkeit ab und träufle sie über das Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In warmen Tortillas mit gewürfelter Zwiebel, Koriander und Limette servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
