      "steps": [
        {
          "position": 0,
          "text": "Koche Hähnchenbrust 15 Minuten in Brühe mit der Hälfte der Zwiebel und Salz, bis sie durchgegart ist. Zupfe das Fleisch und bewahre die Brühe auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Entferne Stiele und Kerne der Chipotle-Chilis, weiche sie 10 Minuten in heißem Wasser ein und püriere sie dann mit Knoblauch und 0.5 cup Einweichflüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste gewürfelte Zwiebel etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Chipotle-Püree und Kreuzkümmel in die Pfanne und gare sie 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre gezupftes Hähnchen, Dosentomaten samt Saft und 0.5 cup aufbewahrte Brühe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles 15 Minuten köcheln, bis die Soße eindickt und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Tortillas und serviere die Tinga darin mit gewürfelter Zwiebel, Koriander und einem Spritzer Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
