      "steps": [
        {
          "position": 0,
          "text": "Erwärme Tortillas in einer trockenen Pfanne bei mittlerer Hitze 1 Minute pro Seite und lege sie dann auf Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in derselben Pfanne und dünste gehackten Knoblauch und Zwiebel 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salsa Roja in die Pfanne und lasse sie 3 Minuten köcheln. Füge dann warme Pintobohnen hinzu und lasse alles weitere 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Bohnen-Salsa-Mischung über die Tortillas auf den Tellern und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Eier einzeln in dieselbe Pfanne und brate sie mit der Sonnenseite nach oben oder bis zum gewünschten Gargrad.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege je zwei Spiegeleier auf jede Tortilla mit Bohnenmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit geriebenem Käse und frischem Koriander bestreuen, mit Salz und Pfeffer würzen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
