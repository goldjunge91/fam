      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermischen, dann eine Mulde formen und Wasser sowie 1 Esslöffel Olivenöl hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mit einer Gabel verrühren, bis ein grober Teig entsteht, dann 5 Minuten von Hand kneten, bis er glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig abgedeckt mit einem feuchten Tuch 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 4 Portionen teilen und jede zu einem dünnen Kreis von etwa 6 Zoll Durchmesser ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittlerer bis hoher Hitze sehr heiß werden lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ein Fladenbrot auf die heiße Fläche legen und 1-2 Minuten backen, wenden und weitere 1-2 Minuten backen, bis hellbraune Flecken entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die fertigen Fladenbrote mit dem restlichen Olivenöl bestreichen und mit Sesamsamen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm mit Hummus, Joghurt oder als Wrap servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
