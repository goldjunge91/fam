      "steps": [
        {
          "position": 0,
          "text": "Getrocknete rote Chilischoten, Koriandersamen und Kreuzkümmelsamen in einer trockenen Pfanne 2 Minuten rösten, dann zu einem feinen Pulver mahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebeln etwa 5 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den gehackten Knoblauch und Ingwer hinzufügen und eine weitere Minute braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfeltes Hähnchen hinzufügen und 5 Minuten unter gelegentlichem Rühren braten, bis es leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die gemahlene Gewürzmischung und das Kurkumapulver einrühren und 1 Minute mitgaren, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kokosmilch angießen und zum Köcheln bringen, dann die Hitze auf niedrig reduzieren und zugedeckt 30 Minuten köcheln lassen, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nach Bedarf mit Salz würzen, dann weitere 10 Minuten ohne Deckel köcheln lassen, damit die Soße eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis oder Fladenbrot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
