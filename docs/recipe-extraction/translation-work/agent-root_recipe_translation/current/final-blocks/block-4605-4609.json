      ],
      "steps": [
        {
          "position": 0,
          "text": "Hefe mit einer Prise Zucker in warmem Wasser auflösen und 5 Minuten stehen lassen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz vermischen, Hefemischung und 3 Esslöffel Olivenöl hinzufügen und 10 Minuten zu einem glatten Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in eine geölte Schüssel legen, abdecken und 1 Stunde gehen lassen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zucchinischeiben in 2 Esslöffeln Olivenöl 5 Minuten anbraten, bis sie weich sind, dann mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 2 Stücke teilen, das erste Stück dünn ausrollen, auf ein geöltes Backblech legen und dann die Hälfte der Tomatensoße darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hälfte der gegarten Zucchini, des Mozzarellas und des Basilikums auf dem Teig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das zweite Teigstück ausrollen und auseinanderziehen, um die Füllung abzudecken, die Ränder mit einer Gabel andrücken, um sie zu verschließen, und mit Öl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "20 Minuten ruhen lassen, dann bei 400°F 30-35 Minuten backen, bis der Teig goldbraun ist, in Stücke schneiden und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
