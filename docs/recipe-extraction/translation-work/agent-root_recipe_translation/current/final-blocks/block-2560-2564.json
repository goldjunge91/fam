      "steps": [
        {
          "position": 0,
          "text": "Schneide Rindfleisch in 2-inch große Würfel und erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune das Rindfleisch portionsweise 8 Minuten pro Portion und stelle es dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle Perlzwiebeln und Knoblauchzehen und dünste sie im Topf 5 Minuten, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Lösche dann mit Rotwein ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Rindfleisch zurück in den Topf und füge Brühe, Lorbeerblätter, Zimtstange, Nelken, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Köcheln, decke den Topf ab und gare das Gericht bei niedriger Hitze 1.5-2 Stunden, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm Lorbeerblätter und Zimtstange heraus und wirf sie weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren. Verteile Rindfleisch und Zwiebeln gleichmäßig auf Schalen und gieße Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
