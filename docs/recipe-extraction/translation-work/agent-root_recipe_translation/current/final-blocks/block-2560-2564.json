      "steps": [
        {
          "position": 0,
          "text": "Spüle getrocknete Bohnen ab und gib sie mit 6 cups Wasser in einen Topf. Bringe alles zum Kochen und schöpfe Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Bohnen ab und gib sie mit frischer Gemüsebrühe zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle Zwiebel, Knoblauch, Karotte und Sellerie. Gib alles mit Lorbeerblatt in den Topf und bringe die Suppe zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Suppe 45 Minuten köcheln, bis die Bohnen fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Tomatenmark mit Olivenöl und 1/4 cup heißer Brühe in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die Tomatenmarkmischung zusammen mit Salz und Pfeffer in die Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass alles weitere 15 Minuten köcheln, bis die Bohnen vollständig weich und cremig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Essig ein, passe die Würze an und serviere die Suppe heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
