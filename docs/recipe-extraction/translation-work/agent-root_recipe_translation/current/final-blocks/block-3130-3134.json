      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebel fein, hacke den Knoblauch und vermische beides mit Hackfleisch, Paprikapulver und Kreuzkümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete die Mischung 2-3 Minuten, bis sie klebrig und gut vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme die Fleischmischung auf einem mit Folie ausgelegten Backblech zu einem Laib.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe den Laib bei 400°F 30 Minuten, bis er gar und oben gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm ihn aus dem Ofen und lasse ihn 5 Minuten ruhen. Schneide ihn dann in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme das Fladenbrot im Ofen oder über einer Herdflamme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würfle Tomate und Gurke fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle das Fladenbrot mit Fleischscheiben, Tomate, Gurke und Joghurt mit Zitronensaft und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
