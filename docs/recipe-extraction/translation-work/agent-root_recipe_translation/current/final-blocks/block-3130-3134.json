      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in mundgerechte Stücke und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Joghurt, Tandoori-Gewürzmischung, Limettensaft und gehackten Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Marinade über das Hähnchen und stelle es mindestens 20 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze und gare das marinierte Hähnchen 8-10 Minuten, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würfle die Gurke und schneide die rote Zwiebel in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege die Tortilla mit gegartem Tandoori-Hähnchen, Gurke, roter Zwiebel und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle die Füllung mit Mangochutney und rolle die Tortilla fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
