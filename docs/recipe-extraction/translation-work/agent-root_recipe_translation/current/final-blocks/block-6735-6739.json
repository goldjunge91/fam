      "steps": [
        {
          "position": 0,
          "text": "Milch und Sahne zusammen in einem Topf erhitzen, bis sie dampfen, nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eigelb mit Zucker schaumig schlagen, dann Maisstärke und Salz unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie die heiße Milchmischung langsam unter ständigem Rühren in die Eimischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zurück in den Topf geben und bei mittlerer Hitze 3-4 Minuten unter ständigem Rühren kochen, bis die Masse eingedickt ist, Vanille und Zimt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücken Sie die Plastikfolie direkt auf die Vanillepuddingoberfläche, lassen Sie sie auf Raumtemperatur abkühlen und stellen Sie sie dann in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heizen Sie den Ofen auf 475 °F vor und fetten Sie eine Muffinform leicht ein, schneiden Sie den Blätterteig in 3 cm große Quadrate und drücken Sie ihn in Förmchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Vanillepudding in Teigförmchen füllen und 15–18 Minuten backen, bis der Vanillepudding fest ist und der Teig aufgebläht und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten in der Pfanne abkühlen lassen, mit Zimt bestäuben und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
