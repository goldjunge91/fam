      "steps": [
        {
          "position": 0,
          "text": "Machen Sie einen Teig, indem Sie Mehl, Salz, Olivenöl und Wasser glatt rühren, 5 Minuten lang kneten und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer Pfanne erhitzen und gewürfelte Zwiebeln und gehackten Knoblauch darin anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hackfleisch hinzufügen und anbraten, bis es braun ist, dann Tomatensauce und Paprika hinzufügen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heizen Sie den Ofen auf 375 °F vor, teilen Sie den Teig in zwei Hälften und rollen Sie ihn jeweils zu einem 12-Zoll-Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Teigkreis auf ein Backblech legen, die Hälfte mit der Füllung bestreichen, umklappen und die Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit verquirltem Ei bestreichen und 40 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Etwas abkühlen lassen und vor dem Servieren in Spalten schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
