      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz mischen, dann kalte Butter dazugeben, bis die Mischung groben Semmelbröseln ähnelt, Eiswasser hinzufügen, um einen Teig zu formen, und 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln, Steckrüben und Zwiebeln schälen und in 0.5 cm große Würfel schneiden, Rindfleisch in gleichgroße Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Ofen auf 400 °F vorheizen und den Teig in 4 Portionen teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rollen Sie jede Portion auf einer bemehlten Oberfläche zu einem 6-Zoll-Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Füllungszutaten gleichmäßig auf die Pastetenhälften verteilen, mit Salz und Pfeffer würzen, den Teig umklappen und die Ränder mit einer Gabel zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf ein Backblech legen, mit verquirltem Ei bestreichen und oben kleine Schlitze schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "45 Minuten backen, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
