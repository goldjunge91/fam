          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Maniok schälen, in 2 cm große Stücke schneiden und zur Brühe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Mais in 2 cm große Stücke schneiden und mit Salz und Pfeffer in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "15 Minuten köcheln lassen, bis der Maniok weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren, garniert mit frischem Koriander.",
