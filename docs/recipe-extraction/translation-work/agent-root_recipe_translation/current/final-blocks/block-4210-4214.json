          "position": 0,
          "text": "Wasser und Milch mit der Zimtstange in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl mit 1 cup kalter Milch in einer Schüssel glatt und klümpchenfrei verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maismehlmischung unter ständigem Rühren langsam in die kochende Flüssigkeit gießen, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze reduzieren und 15 Minuten köcheln lassen, dabei häufig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zucker, Vanilleextrakt und Salz hinzufügen und verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 5 Minuten kochen, bis die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zimtstange entfernen und heiß in Schüsseln servieren.",
