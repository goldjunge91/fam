      "steps": [
        {
          "position": 0,
          "text": "Hähnchen 25 Minuten in Salzwasser gar kochen, zerpflücken und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Getrocknete Pasilla- und Guajillo-Chilis 30 Sekunden in einer trockenen Pfanne rösten; 10 Minuten in heißem Wasser einweichen, dann Stiele und Kerne entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche Chilis mit Zwiebel, Knoblauch, Tomaten und 1 cup Hühnerbrühe glatt pürieren und durch ein feines Sieb passieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer großen Pfanne erhitzen und die passierte Chilisauce 5 Minuten köcheln lassen; die übrige 1 cup Brühe hinzufügen und weitere 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tortillas in einer trockenen Pfanne erwärmen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Tortilla in die warme Sauce tauchen, mit zerpflücktem Hähnchen füllen, fest aufrollen und mit der Naht nach unten in eine Auflaufform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Übrige Sauce über die aufgerollten Enchiladas gießen, sodass sie vollständig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 350°F 20 Minuten backen, bis die Enchiladas durchgewärmt sind und die Sauce am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
