      "steps": [
        {
          "position": 0,
          "text": "Kochbananen schälen, in Stücke schneiden und 15-20 Minuten in Salzwasser sehr weich kochen; gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gekochte Kochbananen glatt und cremig zerstampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schwarze Bohnen, Zucker, Zimt, Nelken und Salz in einem Topf vermengen und 10 Minuten köcheln lassen, bis die Mischung eindickt; dann ganze Nelken entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kochbananenmasse in 8 Portionen teilen und jede zwischen Frischhaltefolie zu einer dünnen Scheibe flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Je 2 Esslöffel der gewürzten schwarzen Bohnen in die Mitte jeder Kochbananenscheibe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kochbanane um die Füllung klappen und verschließen, sodass eine ovale Form entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer Pfanne bei mittelhoher bis hoher Hitze erhitzen und Rellenitos je Seite 3-4 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß servieren, nach Wunsch mit Tomatensauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
