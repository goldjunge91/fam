      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350 Grad F (175 Grad C) vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen großen Topf auf mittlerer Hitze erwärmen. Speck und Kielbasa hineingeben und unter Rühren braten, bis Speckfett ausgelassen und die Wurst leicht gebräunt ist. Fleisch mit einem Schaumlöffel herausnehmen und in einen großen Schmortopf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinefleischwürfel leicht mit Mehl bestäuben und im Speckfett bei mittelhoher Hitze goldbraun braten. Mit einem Schaumlöffel in den Schmortopf geben. Knoblauch, Zwiebel, Karotten, frische Pilze, Kohl und Sauerkraut in den Topf geben. Hitze auf mittlere Stufe reduzieren und unter Rühren etwa 10 Minuten garen, bis die Karotten weich sind. Gemüse nicht bräunen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rotwein angießen und den Bratensatz samt Mehl vom Topfboden lösen. Mit Lorbeer, Basilikum, Majoran, Paprikapulver, Salz, Pfeffer, Kümmel und Cayennepfeffer würzen und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Getrocknete Pilze, scharfe Sauce, Worcestershire, Rinderbrühe, Tomatenmark und Tomaten einrühren. Nur bis zum Kochen erhitzen. Gemüse und Flüssigkeit zum Fleisch in den Schmortopf geben und abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Im vorgeheizten Ofen 2 1/2 bis 3 Stunden backen, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
