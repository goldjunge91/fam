      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie eine runde 8-Zoll-Kuchenform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker etwa 3 Minuten lang schaumig rühren, bis eine leichte, lockere Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier einzeln unterrühren, dann Milch unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer anderen Schüssel Mehl, Backpulver und Salz verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trockene Zutaten unter die feuchten Zutaten heben, dann Wensleydale-Käse und Walnüsse unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig in die vorbereitete Form gießen und 35–40 Minuten backen, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "10 Minuten in der Form abkühlen lassen, dann zum vollständigen Abkühlen auf ein Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
