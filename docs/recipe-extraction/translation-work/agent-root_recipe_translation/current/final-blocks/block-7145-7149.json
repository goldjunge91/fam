      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Trockenfrüchte 10 Minuten in warmer Milch einweichen, damit sie praller werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter und Zucker schaumig rühren, bis sie leicht und locker sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier einzeln unterrühren, dann Vanilleextrakt unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mehl, Backpulver und Salz in einer separaten Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Trockene Zutaten abwechselnd mit der Milch-Frucht-Mischung unter die feuchten Zutaten heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löffelweise Teig mit 2 Zoll Abstand auf das vorbereitete Backblech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "18–22 Minuten backen, bis es goldbraun ist und ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "5 Minuten auf dem Backblech abkühlen lassen und dann auf einen Rost legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
