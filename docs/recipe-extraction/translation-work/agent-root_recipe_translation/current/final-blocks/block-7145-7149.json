      "steps": [
        {
          "position": 0,
          "text": "Hühnerbrühe zum Kochen bringen und ganze Hähnchenbrust mit Lorbeerblatt und Thymian hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen 20–25 Minuten köcheln lassen, bis es gar ist, dann herausnehmen und zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Lauch in Scheiben schneiden und die Kartoffeln in kleine Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gerste, Lauch und Kartoffeln in die Brühe geben und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehacktes Hühnchen und Pflaumen (falls verwendet) unterrühren und weitere 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
