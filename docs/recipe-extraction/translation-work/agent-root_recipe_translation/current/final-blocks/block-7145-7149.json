      "steps": [
        {
          "position": 0,
          "text": "Kalte Butter in Mehl schneiden und salzen, bis sich eine Semmelbröselstruktur bildet, dann Eigelb und 0.5 Tassen Zucker untermischen, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 30 Minuten lang abkühlen lassen, dann ausrollen und in eine 9-Zoll-Tarteform drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stechen Sie den Teig mit einer Gabel ein und backen Sie ihn bei 375 °F 12 Minuten lang blind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Rhabarber in 1 Zoll große Stücke schneiden und mit 0.75 Tassen Zucker und Maisstärke vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Rhabarberfüllung in den vorgebackenen Boden geben und bei 375 °F 35–40 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Servieren 15 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
