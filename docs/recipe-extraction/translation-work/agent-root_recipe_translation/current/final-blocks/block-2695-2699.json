      "steps": [
        {
          "position": 0,
          "text": "Vollkornmehl, Salz und Wasser in einer Schüssel verrühren, bis ein dicker, klumpiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in die heiße Pfanne gießen und mit einem Holzlöffel ständig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "8-10 Minuten weiterrühren, bis die Masse eindickt und leicht bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In eine Servierschüssel geben und mit Honig beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warm servieren, solange die Masse noch weich ist und leicht dampft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
