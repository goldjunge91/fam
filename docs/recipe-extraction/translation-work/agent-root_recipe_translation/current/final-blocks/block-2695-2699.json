      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen Pfanne bei starker Hitze erhitzen, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lammwürfel in einer Lage hineingeben und 4-5 Minuten scharf anbraten, bis sie gebräunt sind; herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebeln in die Pfanne geben und 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knoblauch, Ingwer und Rosmarin hinzufügen und 1 Minute unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lamm zurück in die Pfanne geben und Paprika sowie Tomate hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "8-10 Minuten unter gelegentlichem Rühren garen, bis das Lamm durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz, Pfeffer und Zitronensaft würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rosmarinzweige entfernen und heiß auf Injera servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
