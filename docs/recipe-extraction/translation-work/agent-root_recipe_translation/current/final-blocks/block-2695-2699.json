      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch in 1-inch-Würfel schneiden und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln fein würfeln sowie Knoblauch und frischen Ingwer hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf bei mittelhoher Hitze erhitzen und das Rindfleisch portionsweise jeweils etwa 3-4 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fleisch herausnehmen und beiseitestellen, dann Zwiebel, Knoblauch und Ingwer im selben Topf 5 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Paprikapulver, Cayennepfeffer und Tomatenmark hinzufügen; 2 Minuten unter ständigem Rühren garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rindfleisch zurück in den Topf geben, Wasser und Salz hinzufügen und aufkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren, abdecken und 30-35 Minuten köcheln lassen, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und heiß mit Injera servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
