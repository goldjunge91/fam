      "steps": [
        {
          "position": 0,
          "text": "Bringe einen Topf Salzwasser zum Kochen und koche Spaghetti etwa 9 Minuten bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme währenddessen Olivenöl langsam bei niedriger Hitze in einer großen Pfanne und gib dünn geschnittenen Knoblauch und rote Chiliflocken dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gare den Knoblauch 1–2 Minuten, bis er duftet, aber nicht gebräunt ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Pasta ab, bewahre 1/2 cup Nudelwasser auf und gib die Pasta mit Knoblauchöl in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd, streue Bottarga über die Pasta und vermenge sie vorsichtig mit 1/4 cup Nudelwasser zu einer leichten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Zitronensaft und -abrieb, Petersilie, Salz und schwarzen Pfeffer dazu und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib nach Bedarf das übrige Nudelwasser dazu, bis die Sauce seidig ist, und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
