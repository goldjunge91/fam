      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und fette eine runde Backform von 10 inches mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Topf, bräune Rinderhackfleisch und Hühnerleber mit Zwiebel und Knoblauch an, gib Tomatensauce dazu und lasse alles 20 Minuten köcheln. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche Ditalini und Penne separat bissfest, gieße beides ab und vermische es in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre 2 verquirlte Eier und 1/2 cup Parmesan unter die Pasta und hebe dann Mozzarella und Erbsen unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Fleischsauce über die Nudelmasse und vermische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide Brot in dünne Scheiben und lege damit den Boden und die Seiten der Backform aus. Lasse die Scheiben bei Bedarf überlappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Nudelmasse in die Form, klappe die Brotränder darüber, bestreiche sie mit dem restlichen verquirlten Ei und bestreue sie mit dem übrigen 1/4 cup Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe alles ohne Deckel 35 Minuten goldbraun. Lasse es vor dem Stürzen auf eine Servierplatte und dem Schneiden in Stücke 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
