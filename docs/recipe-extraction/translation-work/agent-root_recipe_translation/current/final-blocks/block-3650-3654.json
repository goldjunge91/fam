      "steps": [
        {
          "position": 0,
          "text": "Taue tiefgekühlten Oktopus auf und koche ihn 45 Minuten in Salzwasser weich. Gieße ihn ab und schneide ihn in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste gehackten Knoblauch und rote Chilischoten 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tomatenmark dazu und rühre 2 Minuten ständig, damit es leicht karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein dazu und lasse ihn 3 Minuten köcheln, bis die Flüssigkeit auf die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Oktopusstücke, Oliven und Kapern in die Pfanne und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel 15 Minuten köcheln und rühre gelegentlich um, bis sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz, probiere das Gericht und passe die Würzung nach Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere großzügig mit frischer Petersilie und serviere es warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
