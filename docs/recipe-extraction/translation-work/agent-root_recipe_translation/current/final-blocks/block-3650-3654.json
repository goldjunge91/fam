      "steps": [
        {
          "position": 0,
          "text": "Koche Kartoffeln in Salzwasser etwa 20 Minuten weich, gieße sie gut ab und lasse sie leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Presse die Kartoffeln durch eine Kartoffelpresse oder zerstampfe sie sehr fein. Rühre dann 1 Ei, Parmesan und Petersilie ein und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme daraus etwa 3 inches lange und 1 inch breite Zylinder und lege sie auf ein mit Backpapier ausgelegtes Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Kroketten mindestens 10 Minuten kalt, damit sie fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage das übrige Ei in einer flachen Schüssel auf und gib Semmelbrösel in eine andere Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wälze jede Krokette in Ei und dann in Semmelbröseln. Drücke diese vorsichtig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere die Kroketten portionsweise 3–4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
