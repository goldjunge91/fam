      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in mundgerechte Stücke. Schäle und schneide die Zwiebeln und hacke den Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle die übrigen Zutaten bereit, dann kannst du mit dem Kochen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gericht zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine Pfanne bei mittlerer Hitze. Gib Öl hinein und dünste die Zwiebel glasig. Nimm sie aus der Pfanne und gib sie in einen Mixer oder eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomaten, Knoblauch, Kurkuma, Kreuzkümmel, Zucker, Ingwerpaste, Kokosmilch und Wasser dazu und püriere alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Hähnchen in dieselbe Pfanne, in der du die Zwiebel gegart hast, und bräune es von allen Seiten. Das dauert etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib den Inhalt des Mixers und Lorbeerblätter in die Pfanne. Bringe alles zum Köcheln und gare das Hähnchen, bis es innen weiß und die Flüssigkeit cremig ist (15 to 20 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne die Lorbeerblätter und serviere das Gericht mit weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
