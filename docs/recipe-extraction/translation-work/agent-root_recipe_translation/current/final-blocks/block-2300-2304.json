      "steps": [
        {
          "position": 0,
          "text": "Brate Zwiebel und Paprika bei mittlerer Hitze zusammen an, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauchgranulat dazu und gare alles eine Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackte Tomaten und die übrigen Gewürze dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Sauce etwa 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme Vertiefungen in die Sauce und schlage in jede ein Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sobald das Eiweiß gestockt ist, garniere das Gericht und serviere es mit Toast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
