      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen. Zwiebelscheiben, gehackten Knoblauch und gewürfelten Fenchel 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinerte Tomaten, Fischfond, Safran und Orangenschale dazugeben und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit Salz und Pfeffer würzen und die Brühe 10 Minuten köcheln lassen, damit sich das Aroma entfaltet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischstücke dazugeben und 4 Minuten köcheln lassen. Anschließend Muscheln und Garnelen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 4–6 Minuten garen, bis sich der Fisch leicht zerteilen lässt, die Muscheln geöffnet und die Garnelen rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Baguettescheiben rösten, Meeresfrüchte und Brühe auf Schüsseln verteilen und mit geröstetem Brot als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
