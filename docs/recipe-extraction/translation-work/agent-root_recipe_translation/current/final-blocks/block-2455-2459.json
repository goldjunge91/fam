      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl, Joghurt, Ingwer, grüne Chili, Kurkuma und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser hinzu, bis ein glatter Teig mittlerer Konsistenz entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Natron hinzu und rühre vorsichtig, bis sich Blasen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fette eine quadratische Backform ein und gieße den Teig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dämpfe den Teig in einem abgedeckten Topf mit 1 inch kochendem Wasser 15-18 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse ihn 5 Minuten abkühlen und schneide ihn dann in quadratische Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einer kleinen Pfanne und gib Senfsamen hinein. Erhitze sie, bis sie aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Curryblätter hinzu und gieße diese Würzmischung über die Dhokla-Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
