      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl, Reismehl, Kurkuma und Salz mit Wasser zu einem dicken Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und fülle den Teig in eine Spritzflasche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke den Teig zügig in langen Strängen direkt ins heiße Öl und forme kreisförmige Spiralen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Frittiere sie etwa 2 Minuten goldbraun, nimm sie mit einem Schaumlöffel heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für Jalebi bereite aus Weizenmehl und Wasser einen Teig zu, gib Lebensmittelfarbe hinzu und drücke ihn spiralförmig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Jalebi hellgolden und tauche sie sofort in heißen Zuckersirup (aus gekochtem Zucker, Wasser und Limettensaft).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie heraus und lege sie zum Festwerden auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fafda und Jalebi zusammen noch warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
