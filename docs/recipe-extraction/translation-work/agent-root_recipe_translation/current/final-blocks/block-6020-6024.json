      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und bräune die Rindfleischstücke portionsweise von allen Seiten an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate im selben Topf Ingwerscheiben und halbierte Zwiebeln etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch zurück in den Topf und füge Sojasoße, dunkle Sojasoße, Zucker, Sternanis und Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse es 45 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelten Rettich dazu und lasse alles weitere 20-25 Minuten köcheln, bis der Rettich zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere das Gericht heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
