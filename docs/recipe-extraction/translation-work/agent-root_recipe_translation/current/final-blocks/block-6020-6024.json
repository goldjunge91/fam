      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Eier, Milch, Salz und Vanille zu einem dünnflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 0.5 Esslöffel Öl in einer beschichteten 8-inch Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße 0.25 Tasse Teig in die Mitte, schwenke die Pfanne sofort zum dünnen Verteilen und backe den Pfannkuchen 1 Minute goldbraun. Wende ihn und gare die andere Seite weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Pfannkuchen auf einen Teller und wiederhole den Vorgang mit dem übrigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche die gebackene Seite jedes Pfannkuchens mit 1 Esslöffel Konfitüre.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Pfannkuchen fest auf und lege ihn mit der Naht nach unten auf einen Servierteller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib einen Klecks saure Sahne und etwas Puderzucker auf jeden aufgerollten Pfannkuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
