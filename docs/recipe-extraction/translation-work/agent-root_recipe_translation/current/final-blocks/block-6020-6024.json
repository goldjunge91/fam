      "steps": [
        {
          "position": 0,
          "text": "Presse den Tofu 15 Minuten zwischen Küchenpapier aus, um überschüssige Flüssigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Pflanzenöl in einem Wok oder einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Tofuwürfel etwa 8 Minuten von allen Seiten goldbraun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das restliche Öl dazu und brate Knoblauch und Zwiebel etwa 1 Minute unter Rühren an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Paprika dazu und brate sie 3 Minuten unter Rühren, bis sie etwas weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den Tofu zurück in den Wok und füge Sojasoße und Sesamöl hinzu. Vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und weißem Pfeffer, gare alles weitere 2 Minuten und serviere es auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
