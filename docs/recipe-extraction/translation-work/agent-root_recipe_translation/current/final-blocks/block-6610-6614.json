      "steps": [
        {
          "position": 0,
          "text": "Wasche die Früchte, entsteine sie und hacke sie grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Früchte, Zucker, Wasser und Hefe in ein sauberes Glasgefäß und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Mischung gut um, decke das Gefäß locker mit einem Mulltuch ab und lasse sie 3-4 Wochen bei Raumtemperatur fermentieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre in der ersten Woche täglich um, danach alle 2-3 Tage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seihe die Mischung nach 4 Wochen durch ein feines Mulltuch in ein sauberes Gefäß ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Flüssigkeit weitere 1-2 Wochen klären und fülle sie dann vorsichtig ab, ohne den Bodensatz aufzuwirbeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lagere die Flaschen vor dem Verzehr mindestens 2 Monate an einem kühlen, dunklen Ort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere den Rakija als Digestif in kleinen Schnapsgläsern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
