      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchenschenkel von beiden Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl in einem großen Topf bei mittlerer bis hoher Hitze und brate das Hähnchen je Seite 4-5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Hähnchen heraus und stelle es auf einem Teller beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste im selben Topf die gewürfelten Zwiebeln und den fein gehackten Knoblauch etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre das Tomatenmark ein und brate es 1 Minute mit. Gib anschließend Brühe und Worcestershiresauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Hähnchen mit Thymian und Lorbeerblatt zurück in den Topf. Lasse es 25-30 Minuten köcheln, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne Thymianzweige und Lorbeerblatt und schmecke das Gericht ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Hähnchen heiß mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
