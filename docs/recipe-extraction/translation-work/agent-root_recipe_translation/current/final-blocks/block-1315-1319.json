      "steps": [
        {
          "position": 0,
          "text": "Dünste Zwiebel und Knoblauch 5 Minuten in Olivenöl an. Gib gewürfelte Paprika dazu und gare sie weitere 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zucchini und Paprikapulver dazu und gare alles 5 Minuten. Füge Tomaten hinzu und lass das Gericht 15 Minuten köcheln, bis es dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme Mulden in das Pisto und schlage je eine Eierportion hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Pfanne ab und gare alles 3–4 Minuten, bis das Eiweiß gestockt und das Eigelb noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
