      "steps": [
        {
          "position": 0,
          "text": "2 Esslöffel Butter in einer großen Pfanne bei mittlerer Hitze schmelzen und gehackte Zwiebeln etwa 4 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fügen Sie gehackten Knoblauch hinzu und kochen Sie ihn 1 Minute lang, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhöhen Sie die Hitze auf mittlere bis hohe Stufe, fügen Sie Hühnerleber hinzu und kochen Sie, bis sie innen nicht mehr rosa ist, etwa 8-10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Salz, schwarzem Pfeffer und getrocknetem Thymian würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie die gekochte Lebermischung zusammen mit der restlichen Butter, den hartgekochten Eiern und der Sahne in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pürieren, bis eine glatte und cremige Masse entsteht, dabei nach Bedarf die Ränder nach unten kratzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pashtet in eine Servierschüssel geben und die Oberseite mit einem Spatel glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lassen Sie es mindestens 2 Stunden im Kühlschrank ruhen, bevor Sie es mit dunklem Brot und Gurken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
