      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und Fleischwürfel bei mittlerer bis hoher Hitze 5 Minuten anbraten; beiseite legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im gleichen Topf gewürfelte Zwiebeln und Karotten anbraten, bis sie weich sind, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark hinzufügen und unter ständigem Rühren 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Fleisch wieder in den Topf und fügen Sie Rinderbrühe, Sauerkraut, eingelegte Gurken und Lorbeerblätter hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 35-40 Minuten köcheln lassen, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Oliven hinzufügen und weitere 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schüsseln mit einem Klecks Sauerrahm und frischem Dill servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
