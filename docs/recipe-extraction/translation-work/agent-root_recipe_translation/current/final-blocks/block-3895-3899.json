      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln und Zwiebeln mit einer Küchenreibe oder einer Küchenmaschine fein reiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geben Sie die geriebene Mischung in ein sauberes Küchentuch und drücken Sie überschüssige Flüssigkeit über einem Spülbecken aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die ausgepresste Mischung in eine Schüssel geben und Ei, Mehl, Salz und schwarzen Pfeffer hinzufügen; mischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie einen Löffel der Kartoffelmischung in heißes Öl und drücken Sie jeden Löffel mit der Rückseite eines Spatels flach, sodass dünne Pfannkuchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "3-4 Minuten pro Seite braten, bis es goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochtes Deruny auf einen mit Papiertüchern ausgelegten Teller geben, um überschüssiges Öl abtropfen zu lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm mit saurer Sahne als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
