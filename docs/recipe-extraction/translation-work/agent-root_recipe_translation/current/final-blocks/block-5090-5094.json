      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 425°F vor und lege zwei Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasche und schäle die Süßkartoffeln und schneide sie in 1/4 Zoll dicke Stifte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe die Stifte mit Küchenpapier trocken, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge sie mit Olivenöl, Salz, Pfeffer, Paprikapulver und Knoblauchpulver, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Stifte in einer Lage auf den vorbereiteten Blechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie 20-25 Minuten und wende sie nach der Hälfte der Zeit, bis sie knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
