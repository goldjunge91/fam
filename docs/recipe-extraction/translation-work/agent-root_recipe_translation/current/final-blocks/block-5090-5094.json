      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Hähnchenflügel mit Küchenpapier trocken und würze sie leicht mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Maisstärke, Mehl, Knoblauchpulver, Paprikapulver, Salz und Pfeffer in einer flachen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jeden Flügel gründlich in der Maisstärkemischung und lege ihn auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das Öl in einem großen Topf oder einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Flügel portionsweise vorsichtig 12-15 Minuten, bis sie goldbraun und knusprig sind. Wende sie nach der Hälfte der Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Flügel mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
