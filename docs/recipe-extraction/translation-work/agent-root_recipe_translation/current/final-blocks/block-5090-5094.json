      "steps": [
        {
          "position": 0,
          "text": "Schneide die Zwiebeln in 1/2 Zoll dicke Ringe und trenne die Ringe voneinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Mehl, Maisstärke, Backpulver, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ei und kaltes Wasser in eine weitere Schüssel und verquirle alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die flüssigen Zutaten unter die trockenen, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das Öl in einem großen Topf oder einer tiefen Pfanne auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tauche die Zwiebelringe in den Teig, lasse überschüssigen Teig abtropfen und gib sie vorsichtig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere sie portionsweise 2-3 Minuten goldbraun und wende sie einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
