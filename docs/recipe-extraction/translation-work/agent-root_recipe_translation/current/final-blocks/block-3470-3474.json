      "steps": [
        {
          "position": 0,
          "text": "Spüle getrockneten Gundruk unter kaltem Wasser ab, um überschüssiges Salz zu entfernen und ihn etwas aufzuweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel dazu und gare sie 3-4 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und grüne Chilischote dazu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den aufgeweichten Gundruk, Kurkuma und Salz dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Wasser dazu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse es ohne Deckel 12-15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche weiter, bis der Gundruk zart ist und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß als Beilage oder mit Reis und Linsen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
