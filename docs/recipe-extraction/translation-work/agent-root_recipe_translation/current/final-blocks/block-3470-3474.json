      "steps": [
        {
          "position": 0,
          "text": "Erhitze Ghee in einem Topf mit schwerem Boden, gib zerbröselten Paneer dazu und rühre 3-4 Minuten ständig, bis er leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Cashews dazu und gare sie 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Rosinen dazu und gare sie 1 Minute. Streue dann Mehl darüber und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße unter Rühren langsam Vollmilch dazu, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gezuckerte Kondensmilch und Zucker dazu und rühre ununterbrochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Mischung bei mittlerer bis niedriger Hitze 8-10 Minuten köcheln und rühre häufig, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib zerstoßene Kardamomsamen dazu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Masse in eine gefettete Form, lasse sie vollständig abkühlen, schneide sie in Quadrate und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
