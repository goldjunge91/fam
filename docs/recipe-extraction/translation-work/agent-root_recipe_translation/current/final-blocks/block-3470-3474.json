      "steps": [
        {
          "position": 0,
          "text": "Vermische Jaggery, geraspelte Kokosnuss, Sesam, Ingwer und Salz in einer Schüssel zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser und Ghee zum Kochen und rühre dann nach und nach Reismehl ein, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig glatt und lasse ihn leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 6 Portionen und forme jede zu einer kleinen Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke jede Kugel flach, gib einen Löffel Füllung in die Mitte und forme sie zu einem Blatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Wasser in einem Topf zum Kochen und gib die Yomari vorsichtig portionsweise hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche sie, bis sie an die Oberfläche steigen, lasse sie dann weitere 2 Minuten köcheln und nimm sie mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm und beträufle sie nach Wunsch mit Ghee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
