      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl mit 0.5 cup Wasser zu einem klebrigen Teig und lasse ihn 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf, gib das Hackfleisch dazu und zerteile es mit einem Löffel. Gare es, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel, gehackten Knoblauch und Ingwer dazu und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Brühe dazu, bringe sie zum Kochen und gib dann gewürfelte Karotte hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zupfe kleine Teigstücke ab und lasse sie direkt in die kochende Brühe fallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre gelegentlich um, damit nichts anklebt, und koche alles 10-12 Minuten, bis die Teigstücke an die Oberfläche steigen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit Koriander und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
