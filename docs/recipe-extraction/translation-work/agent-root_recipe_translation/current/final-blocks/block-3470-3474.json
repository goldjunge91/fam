        {
          "position": 0,
          "text": "Vermische Reismehl, Weizenmehl, Zucker, Salz, Ingwer, Kokosnuss und zerstoßene Kardamomsamen in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib zerdrückte Banane und nach und nach Wasser unter Rühren dazu, bis ein dicker, glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem tiefen Topf oder Wok auf 350°F. Teste die Temperatur mit einem kleinen Stück Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tauche eine Sel-Roti-Form oder einen großen Löffel vorsichtig ins Öl und fülle ihn dann mit Teig, sodass eine Ringform entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere sie 2-3 Minuten goldbraun, wende sie vorsichtig und frittiere die andere Seite weitere 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm; frisch am selben Tag schmecken sie am besten.",
