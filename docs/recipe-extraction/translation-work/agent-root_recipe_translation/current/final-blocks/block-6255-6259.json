      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und dünste gehackten Knoblauch und gewürfelte Zwiebel 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelten Schweinebauch dazu und brate ihn etwa 4 Minuten leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Venusmuscheln und Wasser dazu, decke den Topf ab und gare alles 8-10 Minuten, bis sich die Muscheln öffnen. Entsorge geschlossene Muscheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Muscheln heraus und stelle sie beiseite. Rühre Fischsauce in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile den gekochten Reis auf Schalen und schöpfe die Muschelbrühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gegarten Muscheln darauf und gieße die übrige Sauce über den Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere großzügig mit Frühlingszwiebeln und frischem Dill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß mit Limettenspalten und zusätzlicher Fischsauce als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
