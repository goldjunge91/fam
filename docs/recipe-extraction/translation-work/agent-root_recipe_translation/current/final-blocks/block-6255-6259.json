      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, Kurkuma, Salz, Kokosmilch und Wasser in einer Schüssel zu einem dünnflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tbsp Öl in einer beschichteten Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße eine dünne Teigschicht in die Pfanne und schwenke sie, sodass ein kleiner Crêpe von etwa 4-5 Zoll entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib rasch einige Garnelen und Schweinebauchscheiben auf eine Hälfte des Crêpes, streue gekochte Mungbohnen darüber und klappe ihn zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Crêpe etwa 2-3 Minuten pro Seite, bis die Ränder knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege ihn auf eine Servierplatte und wiederhole den Vorgang mit dem restlichen Teig und der Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß mit frischem Salat, Kräutern und Dip aus Fischsauce, Wasser, Zucker und Limette.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
