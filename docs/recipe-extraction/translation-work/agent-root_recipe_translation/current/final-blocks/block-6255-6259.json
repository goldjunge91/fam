      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, Wasser und Salz zu einem dünnen, glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher Hitze und dünste gewürfelte Zwiebel 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Schweinehackfleisch dazu und brate es unter Zerteilen, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gehackte Pilze, Fischsauce und schwarzen Pfeffer ein und gare alles weitere 3 Minuten. Stelle die Füllung beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öle eine beschichtete Pfanne leicht ein und erhitze sie bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße eine dünne Teigschicht in die Pfanne, schwenke sie gleichmäßig und gare sie 1-2 Minuten, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib eine Linie Füllung in die Mitte des Crêpes, rolle ihn fest auf und lege ihn auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wiederhole den Vorgang mit dem restlichen Teig und der Füllung. Serviere die Röllchen heiß mit Dip aus Fischsauce, Limette und Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
