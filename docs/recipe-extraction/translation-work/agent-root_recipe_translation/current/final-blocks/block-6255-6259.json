      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl mit 2 Tassen Wasser zu einem glatten Teig und seihe ihn durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße den Teig in eine gefettete runde Form von 9 Zoll und dämpfe ihn 15–20 Minuten, bis er gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig leicht abkühlen und schneide ihn dann in mundgerechte Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem Topf und dünste Knoblauch 1 Minute an. Gib dann Schweinehackfleisch und Garnelen dazu und zerkleinere das Fleisch beim Braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare alles 5 Minuten, bis das Schweinefleisch nicht mehr rosa ist. Rühre Fischsauce und Kokosmilch ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Sauce 5 Minuten köcheln, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Bánh-Nước-Stücke auf Schalen und schöpfe die Schweinefleisch-Garnelen-Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere mit Frühlingszwiebeln und Röstschalotten und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
