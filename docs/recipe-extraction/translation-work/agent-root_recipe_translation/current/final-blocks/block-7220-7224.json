          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Brötchen 2-3 Minuten leicht, bis sie warm und innen etwas knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile Mortadella und Provolone gleichmäßig auf die beiden Brötchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belege jedes Sandwich mit gerösteter Paprika und frischem Rucola.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Olivenöl und Rotweinessig und träufle das Dressing über den Rucola.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klappe die Sandwiches zu, halbiere sie diagonal und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
