      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in 1/4-inch große Würfel und hacke die Zwiebel fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Öl auf einer Grillplatte oder in einer großen Pfanne bei mittlerer bis hoher Hitze. Gib die Kartoffeln hinein und brate sie 4-5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe die Kartoffeln zur Seite. Gib das Hackfleisch dazu und zerteile es mit einem Pfannenwender. Brate es 2-3 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Kartoffeln und Hackfleisch, gib die gewürfelte Zwiebel dazu und brate alles eine weitere Minute, bis die Zwiebel weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz und Pfeffer. Zupfe den amerikanischen Schmelzkäse in Stücke und rühre ihn unter, bis er geschmolzen und gleichmäßig verteilt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste das Hero-Brötchen leicht auf der Grillplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Hackfleisch-Käse-Mischung in das geröstete Brötchen, gib nach Wunsch scharfe Sauce darüber und serviere es sofort heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
