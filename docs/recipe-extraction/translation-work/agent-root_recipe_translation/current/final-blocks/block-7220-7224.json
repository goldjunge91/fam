      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz. Arbeite die kalte, gewürfelte Butter ein, bis die Mischung an grobe Streusel erinnert. Gib Eiswasser dazu, bis ein Teig entsteht, und stelle ihn 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle, entkerne und schneide die Äpfel in 1/4-inch dicke Scheiben. Vermenge sie in einer Schüssel mit beiden Zuckersorten, Zimt und Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle zwei Drittel des Teigs aus und drücke ihn in eine 9-inch Pieform. Fülle die Apfelmischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den übrigen Teig aus, schneide ihn in Streifen und lege ein Gittermuster über die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle das Ei mit 1 tbsp Wasser und bestreiche den Teig damit. Backe den Kuchen bei 375°F 40-45 Minuten, bis der Teig goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse den Kuchen vor dem Anschneiden mindestens 15 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Kuchenstücke warm mit einer Kugel Vanilleeis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
