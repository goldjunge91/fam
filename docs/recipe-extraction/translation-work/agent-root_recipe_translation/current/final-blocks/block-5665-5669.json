      "steps": [
        {
          "position": 0,
          "text": "Sojasauce, Honig, Hoisinsauce, Essig, gehackten Knoblauch, Ingwer und Lebensmittelfarbe in einer Schüssel zur Marinade verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Schweinefleisch in einen wiederverschließbaren Beutel legen, Marinade darüber gießen, verschließen und mindestens 4 Stunden oder über Nacht kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Ofen auf 400°F vorheizen und ein Backblech mit Folie auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Schweinefleisch auf das Blech legen und großzügig mit Marinade bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "25–30 Minuten braten, bis die Kerntemperatur 145°F erreicht. Nach der Hälfte der Garzeit mit der restlichen Marinade bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "5 Minuten ruhen lassen, dann quer zur Faser dünn aufschneiden und mit gedämpftem Gemüse und Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
