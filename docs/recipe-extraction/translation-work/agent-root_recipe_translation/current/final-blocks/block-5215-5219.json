      "steps": [
        {
          "position": 0,
          "text": "Gieße die Kichererbsen aus der Dose ab und spüle sie gründlich mit kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die abgetropften Kichererbsen, Tahini, Zitronensaft, gehackten Knoblauch, Olivenöl und Salz in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere alles glatt und cremig. Gib bei Bedarf 1–2 EL Wasser dazu, bis die gewünschte Konsistenz erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Hummus in eine Servierschüssel und richte Karotten, Gurke, Kirschtomaten und Paprika auf einer Platte darum an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme das Pitabrot im Toaster oder in einer Pfanne und schneide es in Dreiecke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Pitabrot zum Gemüse auf die Platte und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
