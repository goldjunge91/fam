      "steps": [
        {
          "position": 0,
          "text": "Fülle einen Topf etwa 2 Inch hoch mit Wasser und bringe es zum Kochen. Setze einen Dämpfeinsatz darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Brokkoliröschen in den Dämpfeinsatz, decke ihn ab und dämpfe den Brokkoli 4–5 Minuten, bis er gar, aber noch bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze währenddessen das Pflanzenöl in einer kleinen Pfanne bei mittlerer Hitze und gib den gehackten Knoblauch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate den Knoblauch unter ständigem Rühren 1–2 Minuten, bis er duftet und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Chiliflocken dazu und brate alles weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte den gedämpften Brokkoli auf einer Servierplatte an und beträufle ihn mit Sesamöl und Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Knoblauch-Öl-Mischung darüber, vermenge alles vorsichtig und bestreue den Brokkoli mit Sesamsamen. Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
