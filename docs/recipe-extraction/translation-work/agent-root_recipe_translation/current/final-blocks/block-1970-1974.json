      "steps": [
        {
          "position": 0,
          "text": "Die Hälfte einer Zwiebel reiben und beiseitestellen. Die übrigen Zwiebeln in Scheiben schneiden und bei niedriger bis mittlerer Hitze in Butter karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer Schüssel Rinderhackfleisch, geriebene Zwiebel, Salz, Pfeffer, Muskatnuss, Kartoffel- oder Maisstärke und Wasser vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zu einer Rolle formen und in 6 Frikadellen schneiden. Mit einem Messer ein leichtes Gittermuster in jede Frikadelle ritzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Karbonader bei starker Hitze in Butter auf beiden Seiten anbraten, dann die Hitze reduzieren und weitere 2–3 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Karbonader und Zwiebeln zum Abendessen mit Kartoffeln, Erbsen und brauner Sauce servieren oder zum Mittagessen beziehungsweise als Snack auf einer Scheibe Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
