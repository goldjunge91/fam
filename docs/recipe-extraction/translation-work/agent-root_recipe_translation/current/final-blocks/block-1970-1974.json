            },
            {
              "key": "c36716b8-9b9c-538e-bda5-bd6c9223cfb7",
              "ingredientName": "Salz",
              "grams": 5,
              "quantity": 5,
              "unit": "g",
              "position": 7,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln schälen und in 5 cm große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1–2 cm Olivenöl in eine große Pfanne geben und sehr stark erhitzen. Kartoffeln etwa 20 Minuten goldbraun braten und dabei gelegentlich wenden. Auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Paprika halbieren und entkernen. Mit etwas Olivenöl einreiben und mit der Schnittfläche nach unten auf ein Backblech legen. Unter den Grill legen und rösten, bis die Haut dunkel und blasig ist. Solange die Paprika noch heiß sind, in einen Plastikbeutel für Sandwiches geben und verschließen. Nach 15 Minuten herausnehmen und häuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In der Zwischenzeit mehr Olivenöl in einer anderen Pfanne erhitzen. Zwiebeln schälen und in dünne Ringe schneiden. 15 Minuten goldbraun braten und dabei häufig wenden. Zum Schluss Ras el Hanout dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kürbis in 5 cm große Würfel schneiden und in derselben Pfanne wie die Kartoffeln 10–15 Minuten braten, bis er weich und leicht gebräunt ist. Auf Küchenpapier geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das übrige Olivenöl aus der Pfanne abgießen, das gesamte gegarte Gemüse hineingeben und vermischen. Eier verquirlen und über das Gemüse gießen. Pfanne abdecken, damit die Eier garen. Pfanneninhalt auf ein großes Schneidebrett geben, Salz und Pfeffer hinzufügen und alles mit einem großen Messer hacken und vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
