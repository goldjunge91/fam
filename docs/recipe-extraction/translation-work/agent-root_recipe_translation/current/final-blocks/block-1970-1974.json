      "steps": [
        {
          "position": 0,
          "text": "Fleisch in Streifen schneiden. Öl in einer Pfanne erhitzen und die Streifen 6 Minuten braten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pommes frites in der Fritteuse goldbraun frittieren. Anschließend in eine Auflaufform geben und gleichmäßig darin verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pommes mit einer weiteren Schicht Fleisch bedecken und gleichmäßig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine Schicht Käse auf das Fleisch geben. Du kannst auch geriebenen Käse verwenden. Für einige Minuten in den Ofen stellen, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Salat, Tomate und Gurke klein schneiden und zu einem einfachen Salat vermischen. Zusätzlich kannst du Oliven, Jalapeños und rote Zwiebeln dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Salat auf der Form verteilen und mit Knoblauchsauce und scharfer Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
