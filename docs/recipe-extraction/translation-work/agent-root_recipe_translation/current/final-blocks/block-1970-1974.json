      "steps": [
        {
          "position": 0,
          "text": "Das Hähnchen mit Olivenöl anbraten, dann einen Maggi-Würfel dazugeben und etwa 30 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einem anderen Topf das gesamte Gemüse dazugeben und anbraten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wenn alles fertig ist, Reis, Rosinen und Gewürze zum Gemüse geben und 2 und eine halbe Tasse Wasser hinzufügen, damit der Reis garen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sobald der Reis gar ist, alles in den Ofen geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
