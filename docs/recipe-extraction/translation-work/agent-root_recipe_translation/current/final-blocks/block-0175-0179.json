    {
      "externalId": "waivy:af2-crispy-skin-salmon",
      "slug": "af2-crispy-skin-salmon",
      "title": "Knuspriges Lachsfilet aus der Heißluftfritteuse",
      "instructions": "Ein einzelnes Lachsfilet mit splitterknuspriger Haut und zartem, gerade eben gegartem Kern – ein Restaurant-Trick, den du im Wohnheim mit einem Stück Fisch und fast ohne Abwasch hinbekommst. Trockene Hitze lässt die Haut knuspern, während das Innere buttrig-zart bleibt. Ein Spritzer Zitrone zum Schluss sorgt für Frische. Inspiriert vom beliebten Trend für Lachs mit knuspriger Haut aus der Heißluftfritteuse.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 12,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Kaufe tiefgekühlten Lachs im Beutel – er ist viel günstiger als frischer Fisch von der Theke und taut über Nacht im Kühlschrank oder in 15 Minuten unter kaltem Wasser auf.",
        "Achte kurz vor Ladenschluss auf reduzierte frische Fischware und friere sie noch am selben Tag ein.",
        "Lass den frischen Dill weg und nimm eine Prise getrockneten Dill oder einfach Zitrone – für den Geschmack sorgt vor allem die knusprige Haut."
      ],
      "substitutions": [
        {
          "forIngredientId": "salmon",
          "swap": "Tilapia- oder Kabeljaufilet als günstigeren Weißfisch verwenden (die Haut wird nicht genauso knusprig, in der Heißluftfritteuse gelingt er trotzdem sehr gut)",
          "savings": "ca. $1.50-2.00 pro Portion"
        },
        {
          "forIngredientId": "olive-oil",
          "swap": "Avocadoöl oder etwas Kochspray",
