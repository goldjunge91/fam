      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und ölen Sie eine 9-Zoll-Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln in Butter bei mittlerer Hitze 3-4 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischen Sie in einem Mixer oder einer Küchenmaschine 2 Tassen Maiskörner mit Milch, bis sie leicht stückig (nicht glatt) sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mischen Sie den Mais mit ganzen Maiskörnern, sautierten Zwiebeln, geriebenem Käse, geschlagenen Eiern, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Mischung in die vorbereitete Auflaufform gießen und die Oberseite glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "30–35 Minuten backen, bis es goldbraun ist und ein in der Mitte eingesetztes Messer sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Schneiden in Quadrate 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm als Hauptgericht oder Beilage servieren.",
