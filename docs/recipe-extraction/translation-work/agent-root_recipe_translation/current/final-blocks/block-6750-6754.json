      "steps": [
        {
          "position": 0,
          "text": "Weiße Fischfilets in mundgerechte Stücke schneiden und leicht salzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer großen Pfanne erhitzen und die Fischstücke in der Pfanne 3-4 Minuten pro Seite braten, bis sie hellgolden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Fisch herausnehmen und auf Papiertüchern beiseite legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne geschnittene Zwiebeln und Karotten mit zerdrücktem Knoblauch 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Essig, Wasser, Lorbeerblätter und Pfefferkörner zum Gemüse geben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "10 Minuten köcheln lassen, um die Beizlake zu entwickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den gekochten Fisch und das Gemüse in sterilisierte Gläser schichten und mit heißer Salzlake übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vollständig abkühlen lassen, verschließen und vor dem Servieren mindestens 3 Tage im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
