      "steps": [
        {
          "position": 0,
          "text": "Maniokstärke, geriebenen Käse und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eier mit zerlassener Butter und Milch verquirlen, dann in die Stärkemischung gießen und kneten, bis ein klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem tiefen Topf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit nassen Händen oder zwei Löffeln vorsichtig aus dem Teig längliche Fladen formen, die etwa 3 cm lang und 1/2 cm dick sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schieben Sie jedes Patty vorsichtig mit einem Löffel in heißes Öl und braten Sie 3-4 auf einmal, ohne es zu überfüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2-3 Minuten pro Seite braten, bis es goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Schaumlöffel herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm als Snack oder Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
