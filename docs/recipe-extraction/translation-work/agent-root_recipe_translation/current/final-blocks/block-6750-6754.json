      "steps": [
        {
          "position": 0,
          "text": "Die Mangos schälen und in kleine Stücke schneiden, dabei den Kern entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Mango, Zucker und Essig in einem Topf mit dickem Boden vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Ingwer, zerdrückten Knoblauch und gehackte rote Chilis in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung zum Kochen bringen, dann die Hitze reduzieren und 15 Minuten köcheln lassen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Senfkörner, Salz und Kurkuma hinzufügen und weitere 5 Minuten köcheln lassen, bis die Masse eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Noch heiß in saubere Gläser füllen und fest verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Kühlen bis zu 2 Wochen lang auf Raumtemperatur abkühlen lassen.",
          "timerMinutes": null,
