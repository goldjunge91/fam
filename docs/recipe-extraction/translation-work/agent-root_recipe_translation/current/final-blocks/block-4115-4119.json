      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Frittiere die Kochbananenscheiben 2 Minuten pro Seite, bis sie leicht goldgelb und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm sie heraus und lege sie zwischen zwei Stücke Frischhaltefolie oder in eine Tostonera, eine hölzerne Presse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke sie flach, bis sie etwa 1/4 Zoll dick sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das Öl erneut auf 350°F und frittiere die flach gedrückten Tostones 1-2 Minuten pro Seite, bis sie knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Salz und gehackten Knoblauch mit 2 EL Wasser zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Tostones auf Küchenpapier abtropfen und serviere sie heiß mit Knoblauchsoße zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
