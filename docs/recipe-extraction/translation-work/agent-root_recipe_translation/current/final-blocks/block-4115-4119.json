      "steps": [
        {
          "position": 0,
          "text": "Bringe 2 Liter Salzwasser in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Maniokstücke dazu und koche sie 20-25 Minuten, bis sie sich leicht mit einer Gabel einstechen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Während der Maniok kocht, vermische gehackten Knoblauch, Olivenöl, Limettensaft und Kreuzkümmel in einem Topf. Erwärme alles bei niedriger Hitze 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Knoblauch nicht braun werden; erwärme die Mojo-Soße nur sanft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Maniok gut ab und gib ihn auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die heiße Mojo-Soße darüber und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
