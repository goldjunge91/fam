      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1/2 Tasse Zucker und Wasser in einen Topf und erhitze die Mischung bei mittlerer Hitze etwa 5 Minuten, bis goldbraunes Karamell entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das Karamell in eine runde Backform von 9-Zoll und bedecke damit Boden und Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere restlichen Zucker, gezuckerte Kondensmilch, ungezuckerte Kondensmilch, Eier und Vanille glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Puddingmischung in die karamellisierte Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle die Form in ein größeres Bratblech, das mit 1 Zoll heißem Wasser gefüllt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Flan 35-40 Minuten, bis er fest, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vollständig abkühlen lassen und dann 4 Stunden kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Fahre mit einem Messer am Rand entlang und stürze den Flan auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
