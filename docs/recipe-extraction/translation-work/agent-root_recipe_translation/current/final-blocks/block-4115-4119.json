          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die feuchten und trockenen Zutaten zu einem dicken Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
