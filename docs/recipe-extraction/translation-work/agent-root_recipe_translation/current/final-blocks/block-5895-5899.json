      "steps": [
        {
          "position": 0,
          "text": "Behalte eine Dose Kichererbsen ganz. Püriere die zweite Dose mit Tahini, Zitronensaft, Knoblauch und Eiswasser, bis die Masse ganz glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze den pürierten Hummus mit Salz und fülle ihn in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer kleinen Pfanne und röste Paprikapulver und Kreuzkümmel 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme die beiseitegestellten ganzen Kichererbsen in einer separaten Pfanne vorsichtig 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das warme Gewürzöl und die ganzen Kichererbsen in eine flache Mulde in der Mitte des pürierten Hummus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue alles mit frischer Petersilie, beträufle es mit dem restlichen Öl und serviere den Hummus warm mit Pita-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
