      "steps": [
        {
          "position": 0,
          "text": "Vermenge Mehl und Salz. Gib 2 Esslöffel Öl hinzu und verreibe alles mit den Fingerspitzen, bis die Mischung an Semmelbrösel erinnert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach Wasser dazu und knete einen festen Teig. Decke ihn ab und lass ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die übrigen 2 Esslöffel Öl in einer Pfanne. Gib Zwiebel, Ingwer und Knoblauch fein gehackt dazu und brate alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die abgetropften Kichererbsen, Koriander, Kreuzkümmel, Amchur und Chilipulver dazu. Gare alles 5 Minuten zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 6 Kugeln und rolle jede zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Frittieröl in einem tiefen Topf auf 350 °F, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Teigkreise vorsichtig einzeln ins heiße Öl. Drücke sie mit einem Löffel leicht an, damit das Brot aufgeht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frittiere jede Seite 1–2 Minuten goldbraun und knusprig. Lass die Brote auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die heißen Puris mit der gewürzten Kichererbsenmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
