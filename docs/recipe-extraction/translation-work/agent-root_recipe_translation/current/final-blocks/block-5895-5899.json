          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gewürfelten Zwiebeln dazu und brate sie 8 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre gehackten Knoblauch und Ingwer ein und brate alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kurkuma und gemahlenen Koriander dazu und rühre 1 Minute ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomaten aus der Dose samt Saft dazu und lass alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Füge die abgetropften Kichererbsen und Kokosmilch hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare das Curry bei mittlerer Hitze 15 Minuten und rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue Garam Masala darüber und schmecke mit Salz ab.",
