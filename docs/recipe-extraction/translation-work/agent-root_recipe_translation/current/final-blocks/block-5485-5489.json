      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinehack, gehackten Kohl, Frühlingszwiebeln, Sojasauce, Sesamöl, Ingwer und Knoblauch in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 Esslöffel Füllung auf jedes Teigblatt, falte es halbmondförmig und drücke die Ränder fest zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne mit flachem Boden bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Teigtaschen mit der flachen Seite nach unten in die Pfanne und brate sie 2-3 Minuten, bis die Unterseiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße vorsichtig Wasser um die Teigtaschen und decke die Pfanne sofort ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe sie 5-6 Minuten, bis das Wasser größtenteils aufgenommen und die Füllung gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Deckel ab und brate die Unterseiten weitere 1-2 Minuten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit Sojasauce und schwarzem Essig zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
