      "steps": [
        {
          "position": 0,
          "text": "Zerbrösele den gepressten Tofu und vermische ihn mit Rinderhack, gehacktem Kohl, Frühlingszwiebeln, Knoblauch, Sojasauce, Sesamöl und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib etwa 1 Esslöffel Füllung in die Mitte jedes Teigblatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Falte das Teigblatt zu einem Halbkreis und drücke die Ränder zu. Du kannst anschließend die beiden Ecken zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und lege die Mandu einlagig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate sie 2-3 Minuten goldbraun, wende sie und brate die andere Seite ebenfalls 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere die Mandu heiß mit Sojasauce oder einer koreanischen Sauce aus Sojasauce, Reisessig und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
