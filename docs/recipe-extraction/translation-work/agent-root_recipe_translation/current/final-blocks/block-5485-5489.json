      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver und Zucker. Gib warmes Wasser und 1 Esslöffel Öl hinzu und knete einen weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Eier in einer Pfanne und lasse sie leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Rührei, gehackten Schnittlauch, Sesamöl, Salz und weißen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 8 Stücke und rolle jedes zu einem dünnen Oval von etwa 4 inches Länge aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche jedes Oval mit Öl und verteile die Füllung längs in der Mitte. Falte es zusammen und verschließe die Ränder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze das restliche Öl in einer Pfanne bei mittlerer Hitze und brate die Bao 3-4 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit Sojasauce oder Essig zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
