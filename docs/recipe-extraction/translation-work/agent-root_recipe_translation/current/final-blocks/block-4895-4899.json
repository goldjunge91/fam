      "steps": [
        {
          "position": 0,
          "text": "2 EL Butter in einer Pfanne bei mittlerer Hitze schmelzen und die geschnittene Zwiebel 8–10 Minuten langsam braten, bis sie weich und tief karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rinderhackfleisch mit Salz, Pfeffer und Worcestershiresauce würzen und zu 2 dünnen Bratlingen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Bratlinge in einer zweiten Pfanne bei mittelhoher Hitze je Seite 3–4 Minuten braten, bis sie gebräunt sind. Je eine Scheibe Schweizer Käse darauflegen und schmelzen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Innenseite jeder Brotscheibe mit Mayonnaise bestreichen. Eine Scheibe mit karamellisierten Zwiebeln und einem Bratling mit geschmolzenem Käse belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit einer weiteren Brotscheibe bedecken. 1 EL Butter in einer sauberen Pfanne oder auf einer Grillplatte bei mittlerer Hitze schmelzen und das Sandwich hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "3–4 Minuten braten, bis das Brot goldbraun ist. Vorsichtig wenden und die andere Seite ebenfalls 3–4 Minuten goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
