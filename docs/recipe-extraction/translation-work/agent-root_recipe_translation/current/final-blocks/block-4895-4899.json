      "steps": [
        {
          "position": 0,
          "text": "Das Steak 15 Minuten einfrieren, damit es sich leichter schneiden lässt. Dann möglichst dünn quer zur Faser schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1.5 EL Butter in einer großen Pfanne bei starker Hitze erhitzen und die dünnen Steakscheiben insgesamt 2–3 Minuten braten, bis sie durchgegart sind. Auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne die restlichen 1.5 EL Butter erhitzen und die geschnittene Zwiebel und Paprika etwa 8 Minuten weich und leicht karamellisiert dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch hinzufügen und 30 Sekunden garen. Das Steak zurück in die Pfanne geben, vermengen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Innenseiten der Brotscheiben mit Mayonnaise bestreichen. Zwei Scheiben mit der Steakmischung füllen und jeweils mit 2 Scheiben Provolone belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Sandwiches in eine Pfanne oder auf eine Grillplatte bei mittlerer Hitze legen, locker abdecken und braten, bis das Brot goldbraun und der Käse geschmolzen ist, etwa 3 Minuten je Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Halbieren und sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
