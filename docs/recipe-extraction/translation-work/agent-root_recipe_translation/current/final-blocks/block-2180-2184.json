      "steps": [
        {
          "position": 0,
          "text": "Stelle die Zutaten bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser, Schälerbsen, Schweinebauch oder Speck, Schweinekotelett und Brühwürfel in einem großen Suppentopf zum Kochen. Reduziere die Hitze, decke den Topf ab und lass alles 45 Minuten köcheln. Rühre gelegentlich um und schöpfe aufsteigenden Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Schweinekotelett heraus, löse das Fleisch vom Knochen und schneide es in dünne Scheiben. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sellerie, Karotten, Kartoffel, Zwiebel, Lauch und Knollensellerie in die Suppe. Bringe sie erneut zum Kochen, reduziere dann die Hitze und lass sie ohne Deckel weitere 30 Minuten köcheln. Gib etwas Wasser dazu, falls Zutaten am Topfboden ansetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die geräucherte Wurst für die letzten 15 Minuten der Garzeit dazu. Wenn das Gemüse weich ist, nimm Speck und Wurst heraus, schneide sie dünn und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Püriere die Suppe nach Wunsch mit einem Stabmixer. Schmecke sie mit Salz und Pfeffer ab. Gib das Fleisch zurück in die Suppe und stelle einige Scheiben Rookworst zum Garnieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Suppe in vorgewärmten Schalen oder tiefen Tellern, garniert mit Rookworstscheiben und gehacktem Selleriegrün.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
