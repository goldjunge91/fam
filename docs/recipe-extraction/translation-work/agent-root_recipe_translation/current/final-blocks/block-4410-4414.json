      "steps": [
        {
          "position": 0,
          "text": "Lassen Sie die Heringsfilets abtropfen und spülen Sie sie gründlich unter kaltem, fließendem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneiden Sie den Hering in mundgerechte Stücke und schichten Sie ihn mit den geschnittenen Zwiebeln in ein sauberes Einmachglas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermischen Sie Essig, Wasser, Zucker, Einlegegewürze, Dillsamen und frischen Dill in einem Topf und bringen Sie alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie die heiße Einlegeflüssigkeit über den Hering und die Zwiebeln und lassen Sie alles auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decken Sie das Glas ab und stellen Sie es vor dem Servieren mindestens 8 Stunden oder bis zu 2 Wochen kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Servieren Sie den Hering gekühlt auf Roggenbrot mit frischem Dill und saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
