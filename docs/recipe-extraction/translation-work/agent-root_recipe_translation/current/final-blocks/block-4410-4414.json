      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mehl, Zucker, Backpulver und Salz in einer großen Schüssel mit dem Schneebesen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage die Eier auf und verrühre sie mit Buttermilch und geschmolzener Butter. Rühre die Mischung anschließend unter die trockenen Zutaten, bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine Aebleskiver-Pfanne (eine spezielle Form mit kugelförmigen Mulden) und fette jede Mulde leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede Mulde zur Hälfte mit Teig, gib dann 1 Teelöffel Marmelade hinein und bedecke sie mit weiterem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe die Aebleskiver bei mittlerer Hitze auf jeder Seite 3-4 Minuten. Drehe sie dabei mit einem Holzspieß oder einer Gabel, damit sie rund werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib sie auf einen Teller und bestäube sie noch warm mit Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie sofort mit Marmelade oder Zitronencreme zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
