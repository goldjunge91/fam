      "steps": [
        {
          "position": 0,
          "text": "Zerstoße Knoblauch und Koriander zusammen in einem Mörser zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die Knoblauch-Koriander-Paste mit Fischsauce, Sojasauce, Limettensaft, schwarzem Pfeffer und Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbiere das Hähnchen der Länge nach und reibe die Marinade rundherum innen und außen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass das Hähnchen mindestens 30 Minuten bei Zimmertemperatur marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Grill auf mittlere bis hohe Hitze vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille das Hähnchen mit der Hautseite nach unten 15-18 Minuten. Wende es und grille es weitere 12-15 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass es vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
