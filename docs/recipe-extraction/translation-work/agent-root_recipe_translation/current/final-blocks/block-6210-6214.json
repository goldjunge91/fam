      "steps": [
        {
          "position": 0,
          "text": "Vermenge Klebreismehl, Kokosmilch, Salz und grüne Lebensmittelfarbe zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Teig in kleine Portionen und drücke sie zu dünnen Kreisen mit etwa 3 inches Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe jeden Kreis auf einer heißen beschichteten Pfanne oder Grillplatte pro Seite 1-2 Minuten, bis er leicht gegart, aber noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge geriebene Kokosnuss mit Palmzucker und Kurkumapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib einen Löffel der Kokos-Zucker-Mischung in die Mitte jedes gebackenen Pfannkuchens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe den Pfannkuchen vorsichtig zusammen, solange er noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere ihn warm oder richte ihn auf einem Teller an und reiche nach Belieben zusätzliche Palmzuckersauce dazu.",
