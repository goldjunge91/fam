      "steps": [
        {
          "position": 0,
          "text": "Vermenge Rinderhackfleisch mit Semmelbröseln, Ei, gehacktem Knoblauch, gehackten Schalotten und Kurkuma.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze mit Salz und Pfeffer und forme kleine Kugeln mit etwa 1.5 inches Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe die Rinderbrühe in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Fleischbällchen vorsichtig in die kochende Brühe und lass sie 8-10 Minuten köcheln, bis sie aufsteigen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib lange Bohnen dazu und gare sie weitere 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Füge Pak Choi und Sojasauce hinzu und gare alles weitere 3-4 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke das Gericht mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Fleischbällchen heiß in Schalen mit Brühe und Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
