      "steps": [
        {
          "position": 0,
          "text": "Mahle eingeweichten Reis und Chana Dal mit möglichst wenig Wasser zu einer groben Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einer Pfanne und gib die gemahlene Masse hinein. Rühre ständig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Jaggery, geriebene Kokosnuss und Kardamompulver bei mittlerer Hitze ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare die Mischung 8-10 Minuten, bis sie dick wird und sich vom Pfannenrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Mischung auf einem Teller vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme daraus Kugeln oder Scheiben und drücke sie leicht flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere die Annarsa auf beiden Seiten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie bei Zimmertemperatur.",
          "timerMinutes": null,
