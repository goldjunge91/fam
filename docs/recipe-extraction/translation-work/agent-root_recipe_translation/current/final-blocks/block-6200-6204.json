      "steps": [
        {
          "position": 0,
          "text": "Vermenge Jaggery mit geriebener Kokosnuss, zerstoßenem Kardamom und Muskatnuss in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Wasser und rühre nach und nach Reismehl ein, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salz hinzu und lass den Teig etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Befeuchte deine Hände, nimm eine kleine Teigportion und drücke sie flach. Gib einen Löffel Jaggery-Kokos-Füllung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme den Teig zu einem Modak, ähnlich einer geriffelten Pyramide.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öle einen Dämpfeinsatz oder Idli-Maker leicht ein und lege die Modaks hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Dämpfe sie 12-15 Minuten, bis sie fest und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie heraus und serviere sie warm mit etwas Ghee darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
