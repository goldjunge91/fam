      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 450 °F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Backpulver, Salz und schwarzen Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kalte Butter in kleine Würfel schneiden und mit den Fingerspitzen in die Mehlmischung einarbeiten, bis sie wie grobe Krümel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Buttermilch unterrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf eine bemehlte Arbeitsfläche geben und 5-mal vorsichtig durchkneten, dann auf eine Dicke von ½ Zoll ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kekse mit einem 2-Zoll-Ausstecher ausstechen und auf ein Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "12 bis 15 Minuten backen, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Landschinkenscheiben knusprig frittieren, dann jeweils eine Scheibe in jeden noch warmen Keks legen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
