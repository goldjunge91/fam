          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer Pfanne erhitzen und gewürfelte Zwiebel weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerdrückte Kochbananen unter die Zwiebelmischung rühren und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und geriebenen Käse unterheben, bis er schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Mischung zu Bratlingen formen und in einer gebutterten Pfanne auf beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eier nach Wunsch braten und zu den Tigrillo-Bratlingen servieren.",
