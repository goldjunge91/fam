      "steps": [
        {
          "position": 0,
          "text": "Chitterlings mehrmals gründlich unter kaltem Wasser abspülen und Verunreinigungen entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Chitterlings mit 8 Tassen Wasser und Lorbeerblättern in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zum Kochen bringen und 45 Minuten garen, dabei aufsteigenden Schaum abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abgießen, erneut abspülen und mit frischem Wasser zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zwiebel, Knoblauch, Salz und schwarzen Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 45 Minuten köcheln lassen, bis die Chitterlings sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abgießen und etwa 1 Tasse Kochflüssigkeit aufbewahren.",
