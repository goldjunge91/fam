      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenschenkel in mundgerechte Stücke und vermische sie mit Speisestärke und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok bei mittelhoher bis hoher Hitze und brate das Hähnchen goldbraun. Stelle es dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste im selben Wok getrocknete Chilischoten und Sichuan-Pfefferkörner 1 Minute, bis sie duften, und zerdrücke sie anschließend leicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und Ingwer in den Wok und brate alles 30 Sekunden unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in den Wok und füge Sojasauce, Essig und Zucker hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schwenke alles bei starker Hitze 3-4 Minuten, bis es gleichmäßig überzogen und durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und schmecke es bei Bedarf mit mehr Sojasauce oder Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Richte es auf einer Servierplatte an und garniere es mit den gerösteten Chilischoten und Pfefferkörnern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
