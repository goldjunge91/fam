      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 tablespoons Sesamöl in einem großen Topf bei mittlerer Hitze und röste getrocknete Chilischoten, Sichuan-Pfefferkörner, Sternanis und Ingwer 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Rinderbrühe in den Topf, gib gehackten Knoblauch dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Richte dünn geschnittenes Rindfleisch, Pak Choi, gewürfelten Tofu und Reisnudeln auf getrennten Tellern an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die heiße Brühe in einen Hotpot um oder lasse sie im Topf am Tisch weiterköcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Gäste können die Zutaten mit Essstäbchen oder kleinen Sieben 10-30 Sekunden in der Brühe garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Sojasauce mit dem restlichen Sesamöl in kleinen Schälchen als Dip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche und genieße die Zutaten nach und nach in mehreren Gängen und gib nach Wunsch weitere Zutaten in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere weiter, bis alle Zutaten gegart und gegessen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
