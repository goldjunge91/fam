      "steps": [
        {
          "position": 0,
          "text": "Röste Sichuan-Pfefferkörner, Sternanis und Zimt 2 Minuten in einer trockenen Pfanne und vermische sie dann mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Ente innen und außen mit der Gewürz-Salz-Mischung ein und lasse sie 2 Stunden im Kühlschrank ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege Ingwerscheiben und Sternanis in die Bauchhöhle der Ente und dämpfe sie 45 Minuten, bis sie vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Ente leicht abkühlen und trockne die Haut gründlich mit Küchenpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege einen Wok oder großen Topf mit Alufolie aus und verteile Teeblätter, Zucker und Reis auf dem Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle ein Gitter über die Räuchermischung und lege die Ente mit der Brustseite nach oben darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Wok dicht mit Folie und Deckel ab und räuchere die Ente bei mittlerer Hitze 30-40 Minuten, bis sie dunkel und aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Topf vom Herd und lasse die Ente 5 Minuten abkühlen. Hacke sie dann in Stücke und serviere sie mit Sojasauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
