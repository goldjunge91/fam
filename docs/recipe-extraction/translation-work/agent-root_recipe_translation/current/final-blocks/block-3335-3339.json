      "steps": [
        {
          "position": 0,
          "text": "Schneide das Kaninchenfleisch in mundgerechte Stücke und blanchiere es 5 Minuten in kochendem Salzwasser. Gieße es ab und spüle es ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Wok bei mittelhoher bis hoher Hitze und röste getrocknete Chilischoten und Sichuan-Pfefferkörner 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und rühre 30 Sekunden ununterbrochen, bis alles aromatisch duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die blanchierten Kaninchenstücke dazu und brate sie 3-4 Minuten unter Rühren, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Sojasauce, Essig, Zucker, Wasser und Sternanis in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Sauce in den Wok und bringe sie zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Wok ab und lasse alles 15-20 Minuten köcheln, bis das Kaninchen zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Probiere das Gericht, schmecke es ab und richte es mit allen Chilischoten und Pfefferkörnern auf einer Servierplatte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
