      "steps": [
        {
          "position": 0,
          "text": "Schneide festen Tofu in 3/4-inch große Würfel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze. Bräune das Schweinehackfleisch unter Zerteilen etwa 3-4 Minuten. Gieße bei Bedarf überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch, Ingwer und Chilipaste zum Schweinefleisch und brate alles 1 Minute unter Rühren an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Wasser und Sojasoße hinein. Gib vorsichtig die Tofuwürfel dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Maisstärke mit 2 tablespoons kaltem Wasser und rühre die Mischung zum Andicken in die Soße. Das dauert etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit gemahlenen Sichuan-Pfefferkörnern, bestreue das Gericht mit Frühlingszwiebeln und serviere es sofort auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
