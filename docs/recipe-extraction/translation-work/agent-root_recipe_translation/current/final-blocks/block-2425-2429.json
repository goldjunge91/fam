      "steps": [
        {
          "position": 0,
          "text": "Röste Poblano-Chilis direkt über einer Gasflamme oder unter dem Ofengrill etwa 8 Minuten, bis sie rundum schwarz sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die gerösteten Chilis 5 Minuten in einen Plastikbeutel, damit sie im Dampf ruhen. Ziehe dann vorsichtig die schwarze Haut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide jede Chili seitlich ein und entferne vorsichtig die Kerne, ohne die Chili einzureißen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede Chili mit einer Scheibe Oaxaca-Käse und klappe die Öffnung zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage Eiweiß steif und hebe dann vorsichtig das Eigelb unter, sodass ein luftiger Eischnee entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende die gefüllten Chilis in Mehl, tauche sie in den Eischnee und frittiere sie in heißem Öl etwa 4 Minuten insgesamt, bis beide Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse Tomaten mit angeschwitzter Zwiebel und Knoblauch 10 Minuten köcheln, um eine Soße zuzubereiten. Mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße warme Soße auf Teller, lege eine frittierte Poblano-Chili darauf und serviere sie mit Koriander und zusätzlicher Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
