      "steps": [
        {
          "position": 0,
          "text": "Blanchiere das Rindfleisch 2 Minuten in kochendem Wasser. Gieße es ab und spüle es mit kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und röste Sternanis, Zimt, getrocknete Chilis und Lorbeerblatt 1 Minute an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib blanchiertes Rindfleisch, Ingwer und Knoblauch dazu und rühre 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 6 cups Wasser und 3 Esslöffel Sojasoße dazu. Bringe alles zum Kochen, reduziere die Hitze und lasse es zugedeckt 60 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Weizennudeln nach Packungsanweisung in kochendem Salzwasser und lasse sie gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Nudeln auf Schüsseln, schöpfe heiße Rinderbrühe und Fleisch darüber und garniere mit Frühlingszwiebeln und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
