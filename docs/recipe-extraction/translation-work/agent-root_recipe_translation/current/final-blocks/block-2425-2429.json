      "steps": [
        {
          "position": 0,
          "text": "Erhitze 0.5 tbsp Butter in einer großen Pfanne bei mittlerer bis hoher Hitze. Gare gewürfelte Zwiebel und Paprika 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gegartes, gezupftes Hähnchen oder Rinderhackfleisch sowie geschnittene Jalapeños hinzu und erhitze alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege eine Tortilla flach auf die Arbeitsfläche und verteile Käse auf einer Hälfte. Gib einen Löffel der Fleischmischung darauf und klappe die Tortilla in der Mitte zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wiederhole dies mit den übrigen Tortillas und der Füllung, um 4 Quesadillas zuzubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wische die Pfanne aus und gib die restliche Butter bei mittlerer bis hoher Hitze hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Quesadillas einzeln oder zu zweit 2-3 Minuten pro Seite goldbraun, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm mit saurer Sahne, Salsa und frischem Koriander als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
