      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Hähnchenschenkel ohne Knochen trocken und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Mehl, Maisstärke, Backpulver, Salz und schwarzen Pfeffer in einer flachen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Hähnchenstück gründlich in der Mehlmischung und schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne oder einem Topf auf 350°F (175°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die mehlierten Hähnchenstücke portionsweise vorsichtig ins heiße Öl und frittiere sie 5–6 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das gegarte Hähnchen zum Abtropfen auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verrühre Sojasauce, Honig und gehackten Knoblauch in einem kleinen Topf bei niedriger Hitze 1–2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermenge das knusprige Hähnchen mit der Soja-Honig-Glasur, bis es rundum überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Garniere das Gericht mit Sesam und serviere es sofort mit Reis oder Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
