      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das Hähnchen unter gelegentlichem Rühren etwa 10–12 Minuten, bis es goldbraun und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den gehackten Knoblauch dazu und brate ihn 2 Minuten an, bis er duftet und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Sojasauce, Sesamöl, braunen Zucker, Reisessig und Wasser in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Knoblauch-Soja-Sauce über das Hähnchen und vermenge alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate alles weitere 2–3 Minuten, bis die Sauce leicht reduziert ist und das Hähnchen überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Richte das Gericht auf einer Servierplatte an und garniere es mit Sesam und geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß auf gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
