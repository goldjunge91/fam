      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in 1 Zoll große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen hinein und brate es unter häufigem Rühren etwa 8 Minuten, bis es größtenteils goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den gehackten Knoblauch dazu und brate ihn 1 Minute an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Ketchup, Gochujang, Sesamöl, Honig und Sojasauce in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die crimsonfarbene Sauce über das Hähnchen und vermenge alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze auf mittlere Stufe und gare alles 3–4 Minuten, bis die Sauce eindickt und das Hähnchen vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle das Gericht in eine Servierschüssel und garniere es mit Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort auf Reis oder mit Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
