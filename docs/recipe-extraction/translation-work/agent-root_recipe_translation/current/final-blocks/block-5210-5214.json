      "steps": [
        {
          "position": 0,
          "text": "Schäle die Süßkartoffeln, würfle sie in etwa 1 Zoll große Stücke und vermenge sie mit 1 EL Olivenöl, Salz, Pfeffer und Thymian.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile die Süßkartoffeln auf einem Backblech und röste sie bei 425°F 20–25 Minuten. Wende sie nach der Hälfte der Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe die Hähnchenbrüste trocken und bestreiche sie mit dem restlichen Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze das Hähnchen von beiden Seiten mit Knoblauchpulver, Paprikapulver, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Grill oder eine Grillpfanne auf mittelhohe bis hohe Hitze vor. Grille das Hähnchen je Seite 6–7 Minuten, bis es eine Kerntemperatur von 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen vom Grill und lass es vor dem Servieren 3–4 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib ein kleines Stück Butter auf die gerösteten Süßkartoffeln und beträufle sie mit Honig. Richte sie zusammen mit dem gegrillten Hähnchen an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
