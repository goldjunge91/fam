      "steps": [
        {
          "position": 0,
          "text": "Klopfe die Hähnchenbrust gleichmäßig auf 0.5 Zoll Dicke und schneide sie in 2 gleich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Buttermilch in einen flachen Teller. Vermische in einem zweiten Teller Mehl, Salz, Pfeffer und Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende die Hähnchenstücke zuerst in der Buttermilch und anschließend gründlich in der gewürzten Mehlmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Pflanzenöl in einem tiefen Topf oder einer tiefen Pfanne auf 350°F. Gib die panierten Hähnchenstücke vorsichtig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere sie insgesamt 6–8 Minuten und wende sie nach der Hälfte der Zeit, bis sie goldbraun sind und eine Kerntemperatur von 165°F erreicht haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass das Hähnchen auf Küchenpapier abtropfen, während du die Buttermilchbrötchen nach Packungsanweisung bäckst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide die warmen Brötchen auf, gib jeweils etwas Butter und eine Scheibe Käse hinein, lege das frittierte Hähnchen dazwischen und serviere die Sandwiches.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
