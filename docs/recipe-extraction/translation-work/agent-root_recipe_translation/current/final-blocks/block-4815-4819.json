      "steps": [
        {
          "position": 0,
          "text": "Milch und Brühe mit Zwiebel und Knoblauch in einem großen Topf zum Kochen bringen. Die festen Zutaten abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Polentagrieß langsam in einem dünnen Strahl einrühren und dabei ständig rühren, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hitze reduzieren und die Polenta 30–35 Minuten unter häufigem Rühren garen, bis sie sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter und Parmesan einrühren, bis alles vollständig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Währenddessen Olivenöl in einer Pfanne erhitzen und die Pilze goldbraun anbraten. Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die cremige Polenta in Schüsseln geben oder auf einer Platte verstreichen. Mit den gebratenen Pilzen belegen und mit Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
