      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf oder einer Tajine bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lammwürfel portionsweise anbraten, etwa 3 Minuten pro Seite, und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln in den Topf geben und 5 Minuten goldbraun dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ingwer, Kreuzkümmel und Koriander einrühren und 1 Minute mitgaren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Lamm zurück in den Topf geben. Brühe, Zimtstange, Salz und Pfeffer hinzufügen und alles leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und bei niedriger Hitze 45 Minuten garen, bis das Lamm fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backpflaumen und Honig dazugeben und weitere 15 Minuten ohne Deckel garen, damit die Sauce etwas einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und heiß mit Couscous oder Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
