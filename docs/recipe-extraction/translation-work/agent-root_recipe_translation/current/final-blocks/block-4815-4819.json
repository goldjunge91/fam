        {
          "position": 0,
          "text": "Sesamöl in einem großen Topf oder Schmortopf bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geschnittenes Schweinefleisch dazugeben und 3 Minuten garen, bis es nicht mehr rosa ist. An den Rand schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch 30 Sekunden anbraten, dann gewürfelte Zwiebel dazugeben und 2 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gochugaru einrühren und 1 Minute mitbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kimchi und Kimchi-Saft dazugeben, gut umrühren und 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wasser oder Brühe und Sojasauce zugießen und alles leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tofuwürfel dazugeben und 15 Minuten ohne Deckel köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken, mit geschnittenen Frühlingszwiebeln garnieren und heiß mit Reis servieren.",
