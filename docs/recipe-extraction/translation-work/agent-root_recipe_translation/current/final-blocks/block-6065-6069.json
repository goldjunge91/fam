      "steps": [
        {
          "position": 0,
          "text": "Spüle die Krabben gründlich unter kaltem Wasser ab und entferne Schmutz mit einer weichen Bürste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser mit Ingwer, Frühlingszwiebeln, Shaoxing-Wein und Salz in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Krabben vorsichtig ins kochende Wasser und decke den Topf sofort ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe das Wasser erneut zum Kochen und dämpfe die Krabben je nach Größe 15-18 Minuten, bis die Schalen leuchtend orange-rot sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Reisessig, Sojasauce und Sesamöl in einer kleinen Dippschale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Krabben mit einer Zange heraus und serviere sie heiß mit Dip und kleinen Gabeln zum Auslösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
