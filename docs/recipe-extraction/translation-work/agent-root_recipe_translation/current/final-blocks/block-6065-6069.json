      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Ente 5 Minuten in kochendem Wasser. Gieße sie ab und tupfe sie vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Pilze, Wurst, Erdnüsse, Wasserkastanien und Garnelen 3 Minuten in Öl unter Rühren an und vermische sie dann mit Klebreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Entenhöhle locker mit der Reismischung und nähe die Öffnung mit Küchengarn zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Ente mit der Brust nach oben in einen Bräter und gib Ingwer, Sojasauce, Shaoxing-Wein und Hühnerbrühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Bräter fest mit Folie ab und schmore die Ente im 350°F heißen Ofen 90 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Folie, erhöhe die Temperatur auf 400°F und brate die Ente weitere 15 Minuten, damit die Haut knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Ente 10 Minuten ruhen, lege sie dann auf ein Schneidebrett und schneide sie in Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
