      "steps": [
        {
          "position": 0,
          "text": "Schneide den oberen Teil des Brotlaibs ab und höhle ihn aus. Lass dabei eine 1 inch dicke Schale stehen, damit eine Brotschüssel entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das herausgelöste Brot in mundgerechte Würfel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe beide Käsesorten und vermenge sie mit der Speisestärke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reibe das Innere eines Fonduetopfs oder eines schweren Topfs mit der Schnittfläche der Knoblauchzehe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Wein in den Topf und erhitze ihn bei mittlerer Hitze, bis sich kleine Bläschen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib nach und nach die Käsemischung dazu und rühre ständig in einer Acht, bis sie glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit schwarzem Pfeffer und etwas Muskatnuss und stelle die Brotschüssel mit den Brotwürfeln zum Dippen auf den Tisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
