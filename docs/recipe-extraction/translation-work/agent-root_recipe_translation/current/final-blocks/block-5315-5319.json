      "steps": [
        {
          "position": 0,
          "text": "Bereite eine Béchamelsauce zu: Schmilz Butter in einem Topf, rühre das Mehl ein und gieße dann langsam unter Rühren die Milch dazu, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Dijon-Senf ein und würze mit Salz und weißem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste die Brotscheiben leicht und lege sie in eine gebutterte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belege jede Brotscheibe mit einer gefalteten Scheibe Schinken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Béchamelsauce gleichmäßig über Schinken und Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reibe den Käse darüber und backe alles bei 425°F 12–15 Minuten, bis die Oberfläche goldbraun ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für eine stärkere Bräunung kannst du das Gericht weitere 1–2 Minuten unter den Grill stellen. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
