      "steps": [
        {
          "position": 0,
          "text": "Schneide den Raclettekäse in 1/4 inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme die gekochten Kartoffeln in einem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Röste die Brotscheiben leicht und lege sie auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine Pfanne oder ein Raclette-Gerät bei mittlerer bis hoher Hitze und lege die Käsescheiben hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald der Käse an den Rändern schmilzt und Blasen wirft, schabe ihn mit einem Holzspatel oder Messer auf das geröstete Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Kartoffeln, Schinken und Gewürzgurken ebenfalls auf der Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole das Schmelzen und Abschaben, bis der gesamte Käse verwendet ist, und bestreue alles mit schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
