          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle den Käse und rühre ihn unter die Sauce, bis er geschmolzen ist. Würze mit Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Masse auf einem Teller und stelle sie mindestens 2 Stunden kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme aus der abgekühlten Masse etwa 3 inch lange zylindrische Kroketten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle das Ei in einer Schüssel und gib die Semmelbrösel in eine andere. Wende jede Krokette zuerst im Ei und dann in den Bröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze das Öl in einem tiefen Topf oder einer Fritteuse auf 350°F und frittiere die Kroketten 2–3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie heiß mit Senf oder Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
