          "position": 0,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze mit 1 Esslöffel Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebeln und Paprika etwa 5 Minuten an, bis sie weich sind, und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Steak in die Pfanne und brate es 3–4 Minuten, bis es gebräunt ist. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Gemüse zurück in die Pfanne und belege das Steak mit Provolone-Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne ab und gare alles etwa 1–2 Minuten, bis der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Hoagie-Brötchen mit Butter, röste sie und verteile Mayonnaise darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Steak-Käse-Mischung in beide Brötchen und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
