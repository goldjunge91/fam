    {
      "externalId": "waivy:rice-cooker-chana-masala",
      "slug": "rice-cooker-chana-masala",
      "title": "Chana Masala aus dem Reiskocher",
      "instructions": "Ein herzhaftes, kräftig gewürztes Kichererbsen-Tomaten-Curry, das von allein köchelt, während du gar nichts tun musst.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
