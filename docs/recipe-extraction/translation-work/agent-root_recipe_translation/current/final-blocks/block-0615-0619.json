  "recipes": [
    {
      "externalId": "waivy:rice-cooker-vegetable-pulao",
      "slug": "rice-cooker-vegetable-pulao",
      "title": "Gemüse-Pulao aus dem Reiskocher",
      "instructions": "Aromatischer Basmatireis mit ganzen Gewürzen, süßen Erbsen und Karotten. Ein gemütliches One-Pot-Abendessen, das die Küche mit warmen Düften erfüllt.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 30,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Kaufe ganze Gewürze in großen Beuteln im indischen Lebensmittelgeschäft. Das kostet nur einen Bruchteil des Gewürzglases aus dem Supermarkt.",
        "Verwende Gemüse, das im Angebot ist oder im Kühlschrank weich wird. Kartoffeln, grüne Bohnen oder Mais passen ebenfalls gut.",
        "Tiefgekühlte Erbsen sind günstiger als frische, halten sich monatelang und sind eine gute Wahl, wenn sie im Angebot sind."
      ],
      "substitutions": [
        {
          "forIngredientId": "ghee",
          "swap": "Pflanzenöl oder ein beliebiges neutrales Öl",
          "savings": "Spart etwa $0.40 pro Zubereitung und macht das Gericht vollständig vegan"
        },
        {
          "forIngredientId": "frozen-peas",
          "swap": "Tiefgekühltes Mischgemüse",
          "savings": "Ein Beutel enthält Erbsen und Möhren und spart ~$1 gegenüber dem Einzelkauf"
        },
        {
          "forIngredientId": "garam-masala",
          "swap": "1 tsp Currypulver und eine Prise Zimt",
          "savings": "Verwendet eine wahrscheinlich vorrätige Zutat und spart ein $5-Glas"
        }
      ],
