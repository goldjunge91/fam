      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und Zwiebel 6–7 Minuten weich dünsten. Paprika und Knoblauch dazugeben und weitere 2 Minuten garen. Paella-Reis einrühren und unter Rühren 1 Minute garen, bis die Körner überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brühe angießen, Safran hinzufügen und zum Kochen bringen. Ohne Deckel sanft 20 Minuten sprudelnd garen, gelegentlich umrühren, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Meeresfrüchte und Zitronensaft einrühren und 2 Minuten oder bis alles dampfend heiß und vollständig gar ist erhitzen. In warmen Schüsseln servieren und mit Petersilie bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
