      ],
      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 200C/Umluft 180C/Gasstufe 6 erhitzen. Kartoffeln 15–20 Minuten weich kochen. Abgießen, zurück in den Topf geben und mit etwas Würzung sowie 2 TL Paprikapulver zerstampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Währenddessen Öl in einer großen Pfanne erhitzen und Zwiebeln sowie Knoblauch einige Minuten weich braten. Übriges Paprikapulver einrühren und 1 Minute garen, Tomaten dazugeben und zum Köcheln bringen. In eine große ofenfeste Form geben, Hähnchen, Paprika, Oliven und etwas Würzung einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffelpüree darübergeben und 15 Minuten backen, bis es oben goldbraun und die Sauce blubbernd heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
