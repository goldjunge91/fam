      ],
      "steps": [
        {
          "position": 0,
          "text": "Wasser im Wasserkocher aufkochen. Zwiebel, Paprika, Chorizo und Knoblauch in Öl in einer beschichteten Pfanne oder flachen Pfanne mit Deckel bei starker Hitze 3 Minuten braten. Reis und gehackte Tomaten mit 500ml kochendem Wasser einrühren, abdecken und bei starker Hitze 12 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Deckel abnehmen und umrühren – der Reis sollte fast gar sein. Garnelen einrühren und, falls der Reis trocken aussieht, noch etwas Wasser dazugeben. Eine weitere Minute garen, bis die Garnelen gerade rosa und der Reis gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
