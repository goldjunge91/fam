        {
          "position": 0,
          "text": "Grille die Chorizos: Gare sie auf dem Grill oder in der Pfanne etwa 10–15 Minuten, bis sie vollständig durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite die Brötchen vor: Schneide sie auf und röste sie leicht auf dem Grill oder in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Setze das Sandwich zusammen: Schneide jede Chorizo längs auf und lege sie in ein Brötchen. Gib großzügig Chimichurri-Sauce darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Serviere es sofort, solange es heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Profi-Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Chorizo langsam bei mittlerer Hitze, damit die Haut nicht aufplatzt und die Wurst gleichmäßig durchgart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Toaste das Brot auf dem Grill, damit es einige der Aromen der Chorizo aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
