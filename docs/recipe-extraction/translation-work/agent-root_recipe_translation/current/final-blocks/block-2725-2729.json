      "steps": [
        {
          "position": 0,
          "text": "Frische Weißfischfilets in mundgerechte Würfel schneiden und in eine nicht reaktive Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Frischen Limettensaft über den Fisch pressen, bis er größtenteils bedeckt ist, dann Salz hinzufügen und vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "15-20 Minuten im Kühlschrank marinieren und gelegentlich umrühren, bis der Fisch undurchsichtig und fest wird (die Säure lässt den Fisch garen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Während der Fisch mariniert, rote Zwiebel dünn schneiden, Jalapeño hacken, Tomaten würfeln und Koriander hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geschnittene Zwiebel, Jalapeño, gewürfelte Tomaten und Koriander zur Ceviche geben und vorsichtig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Pfeffer würzen und bei Bedarf mehr Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf gekühlte Servierschalen verteilen und mit Avocadoscheiben garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit knusprigen Tortillachips oder Crackern als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
