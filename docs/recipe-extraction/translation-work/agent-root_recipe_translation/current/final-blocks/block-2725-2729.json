      "steps": [
        {
          "position": 0,
          "text": "Maniokwürfel 20 Minuten in Salzwasser kochen, bis sie sehr weich sind; abgießen und mit Butter und Milch glatt stampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer Pfanne bei mittlerer Hitze erhitzen und Rinderhackfleisch anbräunen, dann Zwiebel und Knoblauch hinzufügen und weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dosentomaten, Salz und Pfeffer einrühren und 8 Minuten köcheln lassen, bis die Mischung leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hälfte des Maniokpürees in einer gefetteten Auflaufform von 9x13 verteilen und die Fleischmischung gleichmäßig darauf schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit dem restlichen Maniokpüree bedecken und glatt streichen, dann Käse darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 375°F 15 Minuten goldbraun backen, bis alles heiß ist, dann vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
