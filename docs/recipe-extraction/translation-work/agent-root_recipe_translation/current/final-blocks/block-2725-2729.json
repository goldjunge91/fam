      "steps": [
        {
          "position": 0,
          "text": "Hähnchenoberkeulen mit Salz und Pfeffer würzen, dann 2 tbsp Öl in einem großen Topf bei mittelhoher Hitze erhitzen und das Hähnchen etwa 4-5 Minuten pro Seite rundherum anbräunen; herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Restliches Öl hinzufügen und gewürfelte Zwiebeln sowie gehackten Knoblauch etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark und Kreuzkümmel einrühren und 1 Minute vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hähnchen zurück in den Topf geben, Hühnerbrühe angießen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und 20 Minuten garen, bis das Hähnchen fast durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Okraschoten in 1-inch-Stücke schneiden, hinzufügen und umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ohne Deckel 10-12 Minuten köcheln lassen, bis die Okraschoten weich und die Sauce leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und heiß auf Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
