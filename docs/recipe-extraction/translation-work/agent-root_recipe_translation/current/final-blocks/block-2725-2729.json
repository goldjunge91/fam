      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf bei mittlerer Hitze erhitzen und Zwiebel, Knoblauch sowie Ingwer 3 Minuten anbraten, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brotwürfel hinzufügen und 2 Minuten unter ständigem Rühren leicht rösten, dann Garnelen dazugeben und 2 Minuten pro Seite garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kokosmilch, Brühe und Dosentomaten samt Saft angießen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "15 Minuten unter gelegentlichem Rühren köcheln lassen, bis die Garnelen gar sind und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit einem Stabmixer teilweise pürieren, bis die Mischung cremig, aber noch stückig ist; alternativ mit einem Kartoffelstampfer zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und roten Chiliflocken würzen, Koriander einrühren und heiß auf weißem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
