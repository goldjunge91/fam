      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und öle eine 9x13 Zoll große Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer Pfanne und dünste Zwiebel, Knoblauch und Jalapeño etwa 3 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme Maistortillas in einer trockenen Pfanne oder über einer Flamme 10 Sekunden pro Seite, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tauche jede Tortilla in Salsa Verde, fülle sie mit Käse und Zwiebelmischung, rolle sie fest auf und lege sie mit der Nahtseite nach unten in die Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die restliche Salsa Verde über die Enchiladas und träufle Crema in einem dünnen Strahl darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streue den übrigen Käse darüber und backe die Enchiladas 25 Minuten, bis der Käse geschmolzen ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere sie mit frischem Koriander und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
