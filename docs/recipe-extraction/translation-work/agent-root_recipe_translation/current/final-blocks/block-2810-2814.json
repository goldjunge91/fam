      "steps": [
        {
          "position": 0,
          "text": "Kutteln 15 Minuten in Salzwasser kochen, um sie zu reinigen; abgießen und mundgerecht schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem Topf erhitzen und gehackten Knoblauch sowie Ingwer 1 Minute anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel hinzufügen und etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe angießen und aufkochen, dann die gereinigten Kutteln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren und Kutteln 30-40 Minuten köcheln lassen, bis sie sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reis abspülen und in den Topf geben; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15-20 Minuten köcheln lassen, bis der Reis sehr weich ist und die Mischung breiartig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sojasauce, Sesamöl, Salz und Pfeffer nach Geschmack einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß in Schalen servieren und mit geschnittener Frühlingszwiebel garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
