      "steps": [
        {
          "position": 0,
          "text": "Sago nach Packungsanweisung kochen, bis es durchsichtig ist, dann abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Braunen Zucker und Wasser in einem Topf vermengen und bei mittlerer Hitze zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sago einrühren und 2 Minuten köcheln lassen, dann vom Herd nehmen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vanille und Salz in den abgekühlten Sirup einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seidentofu vorsichtig in Servierschalen schöpfen, ohne ihn zu sehr zu zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warmen oder abgekühlten Sirup mit Sago über den Tofu gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort bei Raumtemperatur oder gekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
