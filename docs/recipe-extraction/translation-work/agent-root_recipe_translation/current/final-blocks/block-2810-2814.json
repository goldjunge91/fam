      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 375°F vorheizen und eine Backform von 8x12 inch mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reismehl, braunen Zucker, Backpulver und Salz in einer großen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer anderen Schüssel Eier verquirlen und mit Kokosmilch vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Flüssige Zutaten zu den trockenen geben und nur so lange rühren, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig in die vorbereitete Form gießen und die Oberfläche glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geriebene Kokosnuss und Käse gleichmäßig darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Butter in kleinen Stücken auf der Oberfläche verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "20-25 Minuten backen, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt und die Oberseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
