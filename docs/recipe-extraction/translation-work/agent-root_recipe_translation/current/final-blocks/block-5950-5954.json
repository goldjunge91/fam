      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und schneide jede mit einem kleinen runden Ausstecher oder Messer in einen etwa 2 Zoll hohen Zylinder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer großen ofenfesten Pfanne bei mittelhoher Hitze und stelle die Kartoffelzylinder mit einer Schnittfläche nach unten hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Kartoffeln auf der Unterseite 2 Minuten goldbraun, wende sie und brate die andere Seite ebenfalls 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Hühnerbrühe um die Kartoffeln, gib Thymianzweige und gehackten Knoblauch hinzu und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Pfanne mit Folie ab und stelle sie in den auf 375 °F vorgeheizten Ofen. Gare die Kartoffeln 20 Minuten, bis sie weich sind und die Flüssigkeit auf die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Folie und backe die Kartoffeln weitere 5 Minuten, bis die Oberseiten goldbraun und die Flüssigkeit größtenteils verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere die Kartoffeln mit frischer Petersilie und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
