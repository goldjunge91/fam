      "steps": [
        {
          "position": 0,
          "text": "Schneide den Speck in kleine Stücke und brate ihn in einer großen Pfanne bei mittelhoher Hitze etwa 6 Minuten knusprig. Nimm ihn heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Blumenkohl in Röschen und würfle die Zwiebel. Gib beides ins Speckfett und brate es unter gelegentlichem Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke den Knoblauch fein und gib ihn zusammen mit der Butter in die Pfanne. Brate alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Schlagsahne und Hühnerbrühe hinzu, würze mit Salz und Pfeffer und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf mittlere Stufe und gare alles ohne Deckel 10 Minuten, bis der Blumenkohl weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre den Cheddar ein, bis er vollständig geschmolzen ist. Hebe den gebratenen Speck unter und schmecke bei Bedarf nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
