      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln 15 Minuten in Salzwasser, bis sie weich sind. Gieße sie ab, lasse sie abkühlen, pelle sie und zerdrücke sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel und grüne Chili fein. Hacke den Koriander und vermische alles mit den zerdrückten Kartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwer, Mehl, Salz, Pfeffer und Tamarindenpaste zur Kartoffelmasse und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile die Masse in 8 gleich große Portionen und forme daraus etwa 2 Zoll große Fladen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer flachen Pfanne bei mittelhoher Hitze und lege die Fladen vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate sie portionsweise auf jeder Seite 3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Fladen auf Küchenpapier abtropfen und serviere sie heiß mit Joghurt oder Tamarindenchutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
