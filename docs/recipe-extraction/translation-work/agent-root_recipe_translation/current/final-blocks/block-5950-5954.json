      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und schneide sie mit einem Messer oder Hobel in dünne Scheiben. Schneide die Zwiebeln in dünne Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Heize den Ofen auf 375 °F vor und fette eine 9 x 13 Zoll große Auflaufform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Hälfte der Kartoffeln in die Form, würze mit Salz und Pfeffer und verteile die Hälfte der Zwiebeln darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte die übrigen Kartoffeln und Zwiebeln darauf, würze erneut mit Salz und Pfeffer und bestreue alles gleichmäßig mit Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze die Milch in einem Topf, bis sie dampft, und gieße sie vorsichtig über die Kartoffel-Zwiebel-Schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den geriebenen Käse gleichmäßig darauf und setze kleine Butterstücke darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Form mit Folie ab und backe den Auflauf 30 Minuten. Entferne die Folie und backe ihn weitere 15 Minuten, bis die Oberfläche goldbraun ist und die Milch am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse den Auflauf 5 Minuten abkühlen, garniere ihn mit frischer Petersilie und serviere ihn heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
