      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und Zwiebel sowie Knoblauch 3–4 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Passierte Tomaten, Fischbrühe und Weißwein hinzufügen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischfilets hinzufügen und 5 Minuten köcheln lassen, dann Garnelen und Miesmuscheln dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weitere 8–10 Minuten köcheln lassen, bis Garnelen rosa, Muscheln geöffnet und Fisch leicht zerteilbar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nicht geöffnete Muscheln entsorgen, mit Salz und Pfeffer würzen und in Schalen mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
