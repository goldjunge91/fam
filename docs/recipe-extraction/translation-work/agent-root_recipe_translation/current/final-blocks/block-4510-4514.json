      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermischen, eine Mulde formen, Wasser und Ei hineingeben und zu weichem Teig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig 5 Minuten glatt kneten, in Frischhaltefolie wickeln und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ricotta, Cheddar, Pfeffer und Dill in einer separaten Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig auf einer bemehlten Fläche mit den Händen sehr dünn ziehen, bis er fast durchsichtig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ricottamischung gleichmäßig auf dem Teig verteilen, fest aufrollen und zu einer Spirale wickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Spirale mit der Naht nach unten in eine gebutterte Auflaufform legen und großzügig mit geschmolzener Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375 °F 35–40 Minuten goldbraun backen und mit einem Klecks saurer Sahne servieren.",
          "timerMinutes": null,
