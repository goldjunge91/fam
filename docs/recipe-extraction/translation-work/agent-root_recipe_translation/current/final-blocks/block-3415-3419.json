      "steps": [
        {
          "position": 0,
          "text": "Spüle den Fischkopf gründlich unter kaltem Wasser ab und tupfe ihn mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege den Fischkopf auf einen hitzebeständigen Teller, der in deinen Dämpfeinsatz passt, und würze ihn mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die roten Chilischoten fein und entferne nach Wunsch einige Kerne, wenn du es milder magst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle einen Dämpftopf mit Wasser und bringe es zum Kochen. Stelle den Teller mit dem Fischkopf hinein und dämpfe ihn 12-15 Minuten, bis der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze währenddessen Pflanzenöl in einer kleinen Pfanne und röste die gehackten Chilischoten, Knoblauch und Ingwer 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Sojasauce und Sesamöl zur Chilimischung und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Fischkopf aus dem Dämpfer und verteile die heiße Chilimischung gleichmäßig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere ihn mit Frühlingszwiebeln und Koriander und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
