      "steps": [
        {
          "position": 0,
          "text": "Reibe das Schweinefleisch rundherum mit Salz, braunem Zucker und schwarzem Pfeffer ein und lege es in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasauce, Reiswein, Ingwer, Knoblauch und Sternanis, gieße die Mischung über das Schweinefleisch und mariniere es mindestens 4 Stunden oder über Nacht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Schweinefleisch aus der Marinade und tupfe es mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Smoker auf 225°F vor und gib eingeweichte Holzchips in die Feuerbox.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Schweinefleisch in den Smoker und räuchere es 2.5-3 Stunden, bis die Kerntemperatur 190°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Schweinefleisch aus dem Smoker und lasse es vor dem Aufschneiden 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide das Fleisch quer zur Faser in dünne Scheiben und richte sie auf einer Servierplatte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es bei Raumtemperatur oder warm mit gedämpftem Reis und eingelegtem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
