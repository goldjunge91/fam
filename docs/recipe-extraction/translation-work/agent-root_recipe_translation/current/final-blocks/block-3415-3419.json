      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gib Salz und ganze Hähnchenbrüste hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze auf mittlere Stufe und lasse das Hähnchen 15-18 Minuten sanft köcheln, bis es gar, aber noch saftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Hähnchen heraus und lasse es leicht abkühlen. Zupfe oder zerreiße es dann in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Sojasauce, Essig, Sesamöl, Chiliöl, Knoblauch, Ingwer und Frühlingszwiebeln in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße das Dressing über das warme, zerteilte Hähnchen und vermische alles vorsichtig, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles 5 Minuten stehen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte das Gericht auf einer Servierplatte an und garniere es mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es bei Raumtemperatur oder leicht warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
