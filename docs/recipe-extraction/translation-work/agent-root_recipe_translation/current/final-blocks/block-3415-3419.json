      "steps": [
        {
          "position": 0,
          "text": "Blanchiere den gereinigten Rinderpansen 10 Minuten in kochendem Wasser. Gieße ihn ab, lasse ihn abkühlen und schneide ihn in dünne, 2-inch lange Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Wok oder einer Pfanne bei starker Hitze, bis es gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwer dazu und brate sie 15 Sekunden unter Rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Pansenstücke dazu und gare sie 3-4 Minuten unter ständigem Rühren, bis die Ränder knusprig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Sojasauce, Reisessig, Chiliflocken, Salz und weißen Pfeffer dazu und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate alles weitere 2-3 Minuten unter Rühren, bis die Sauce leicht eingekocht und der Pansen gut überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Frühlingszwiebeln dazu, vermische alles und gare es 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Richte das Gericht auf einer Servierplatte an und bestreue es vor dem Servieren mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
