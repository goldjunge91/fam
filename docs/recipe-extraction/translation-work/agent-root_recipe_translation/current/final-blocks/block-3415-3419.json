      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Schweinebauchwürfel 5 Minuten in kochendem Wasser, gieße sie ab und spüle sie mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen, schweren Topf bei mittelhoher bis hoher Hitze und bräune den abgetropften Schweinebauch etwa 8 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwerscheiben und Knoblauchzehen dazu und rühre 1 Minute ununterbrochen, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Sojasauce, Reiswein und Wasser dazu und gib Zucker, Sternanis und Zimtstange hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse es 90 Minuten köcheln, bis der Schweinebauch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Deckel ab und erhöhe die Hitze auf mittlere Stufe. Lasse alles weitere 10 Minuten köcheln, damit die Schmorflüssigkeit einkocht und eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Frühlingszwiebeln ein und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß mit gedämpftem Reis und zusätzlichen Frühlingszwiebeln als Garnitur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
