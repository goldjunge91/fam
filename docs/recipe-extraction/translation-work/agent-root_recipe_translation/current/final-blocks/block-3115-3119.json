        {
          "position": 0,
          "text": "Reinige Lauch, indem du ihn längs aufschneidest und zwischen den Schichten abspülst. Schneide ihn dann in dünne Halbringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schäle Kartoffeln und würfle sie in 1-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und brate Lauch 5 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kartoffeln und Gemüsebrühe dazu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse die Suppe 20 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Püriere die Suppe portionsweise mit einem Stabmixer oder Standmixer vollständig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Schlagsahne ein und würze mit Salz und weißem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kühle die Suppe mindestens 30 Minuten. Schöpfe sie dann in Schalen und garniere sie mit frischem Schnittlauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
