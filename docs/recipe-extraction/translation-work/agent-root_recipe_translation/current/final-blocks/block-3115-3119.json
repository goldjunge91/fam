      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinehackfleisch, gehackte Garnelen, Frühlingszwiebel, Knoblauch, 1 EL Sojasauce und Sesamöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 TL Füllung in die Mitte jedes Wan-Tan-Teigblatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchte die Ränder des Teigblatts mit dem Finger mit Wasser, falte es zu einem Dreieck und führe dann die gegenüberliegenden Ecken zusammen und drücke sie fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe einen Topf Wasser zum Kochen und koche Wan Tans portionsweise 3 Minuten, bis sie aufsteigen. Koche sie dann eine weitere Minute und nimm sie mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Hühnerbrühe mit der übrigen Sojasauce und gehacktem Ingwer in einem Topf und lasse sie sanft köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gehackten Pak Choi in die Brühe und gare ihn 2 Minuten, bis er leicht zusammenfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile gekochte Wan Tans auf Schalen, gieße heiße Brühe mit Pak Choi darüber und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
