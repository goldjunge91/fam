      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Fischfilets trocken, reibe sie rundherum mit Salz und Zucker ein und lege sie auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke sie mit Frischhaltefolie ab und lasse sie 20 Minuten im Kühlschrank pökeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spüle den gepökelten Fisch unter kaltem Wasser ab und tupfe ihn mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte die Fischfilets in eine flache Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Sojasauce, Reisessig, Chiliöl, Knoblauch, Ingwer und Sesamöl in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Dressing gleichmäßig über die Fischfilets.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Schüssel ab und lasse alles 10 Minuten bei Raumtemperatur ziehen, damit die Aromen einziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege den Fisch kurz vor dem Servieren mit Frühlingszwiebeln und Koriander; bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
