      "steps": [
        {
          "position": 0,
          "text": "Schneide extra festen Tofu in 3/4 Zoll große Würfel und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F (teste mit einem Holzstäbchen; es sollte sofort brutzeln).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Tofuwürfel portionsweise vorsichtig hinein und frittiere sie etwa 6-8 Minuten je Portion, bis sie rundherum goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den frittierten Tofu mit einer Schaumkelle heraus und lasse ihn auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Stinktofu-Lake, Sojasauce, Chilipaste, Knoblauch und Ingwer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den frittierten Tofu in eine Servierschüssel und gieße die Saucenmischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle ihn mit Sesamöl und bestreue ihn mit Sichuan-Pfefferkörnern und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange er noch warm und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
