        {
          "position": 1,
          "text": "Die gekühlten Bohnen in einem kleinen Topf bei mittlerer Hitze erwärmen und dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mehl-Tortillas in einer trockenen Pfanne 30 Sekunden pro Seite erhitzen, um sie geschmeidig zu machen.",
