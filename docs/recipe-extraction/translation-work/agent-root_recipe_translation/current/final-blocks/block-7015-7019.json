        {
          "position": 4,
          "text": "Die Bohnen mit gekochtem Rinderhackfleisch, gewürfelten Zwiebeln und der Hälfte des Käses auf jeder Tortilla belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rollen Sie jede Tortilla fest und falten Sie dabei die Seiten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Burritos mit der Nahtseite nach unten in eine gefettete Auflaufform legen und mit dem restlichen Käse und Salsa belegen.",
