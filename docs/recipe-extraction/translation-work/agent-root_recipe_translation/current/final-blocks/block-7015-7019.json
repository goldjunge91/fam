      "steps": [
        {
          "position": 0,
          "text": "Hackfleisch in einer Pfanne bei mittlerer bis hoher Hitze anbraten und beim Bräunen in kleine Stücke brechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Überschüssiges Fett vom Rindfleisch abtropfen lassen, dann Chilipulver, Knoblauchpulver, Worcestershire-Sauce und Wasser hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Fleischsauce 5-7 Minuten köcheln lassen, bis sie leicht eingedickt ist und duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kochen oder dämpfen Sie die Hot Dogs, bis sie durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie jeden Hotdog in ein Brötchen und beträufeln Sie ihn mit einer kleinen Menge Senf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie die Fleischsoße großzügig über jeden Hot Dog.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit fein gewürfelten rohen Zwiebeln belegen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
