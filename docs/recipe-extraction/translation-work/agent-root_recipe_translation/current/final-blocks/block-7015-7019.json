        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl, Hefe und Salz in einer Schüssel vermischen, dann warmes Wasser hinzufügen und 10 Minuten lang kneten, bis eine glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig in einer geölten Schüssel 30 Minuten gehen lassen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In der Zwischenzeit Kichererbsen, Tahini, Zitronensaft, gehackten Knoblauch, 1 Esslöffel Olivenöl und Salz in einer Küchenmaschine glatt rühren und bei Bedarf Wasser hinzufügen, um die Konsistenz zu erhöhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teilen Sie den Teig in 8 Portionen und rollen Sie jede zu einem dünnen, etwa 1/4 Zoll dicken Oval aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitzen Sie eine gusseiserne Pfanne oder Grillplatte bei mittlerer bis hoher Hitze und backen Sie jedes Brot 2–3 Minuten pro Seite, bis es aufgebläht ist und leicht fleckig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gebackene Brote auf einem Teller stapeln und zum Warmhalten mit einem Tuch abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hummus in eine Servierschüssel geben, in der Mitte eine Mulde formen und mit dem restlichen Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren Sie zum Dippen warmes Brot neben dem Hummus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
