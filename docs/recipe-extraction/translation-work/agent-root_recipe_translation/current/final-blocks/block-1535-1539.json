      "steps": [
        {
          "position": 0,
          "text": "Gib Reis und 6 Tassen Brühe in einen großen Topf und bringe alles zum Kochen. Rühre um, damit nichts am Topf ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lass alles 30–35 Minuten köcheln. Rühre alle 5 Minuten um, bis der Reis vollständig zerfallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pochiere währenddessen das Hähnchen im Congee. Nimm es heraus und zerpflücke es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide frischen Ingwer in feine Streifen und frittiere ihn in Öl knusprig und goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere den Congee mit Hähnchen, knusprigem Ingwer, Frühlingszwiebel, Sesamöl und Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
