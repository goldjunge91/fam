      "steps": [
        {
          "position": 0,
          "text": "Brate die Hähnchenschenkel mit der Hautseite nach unten goldbraun an und wende sie kurz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib ganze Knoblauchzehen und Ingwerscheiben dazu und brate alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Sojasauce, Sesamöl und Reiswein oder eine Mischung aus Essig und Zucker dazu. Rühre um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Pfanne ab und lass alles 15 Minuten köcheln. Nimm den Deckel ab und koche weitere 5 Minuten, bis die Sauce dick und glänzend ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und gib eine große Handvoll Thai-Basilikum dazu. Rühre, bis die Blätter zusammenfallen. Serviere das Hähnchen auf Reis.",
