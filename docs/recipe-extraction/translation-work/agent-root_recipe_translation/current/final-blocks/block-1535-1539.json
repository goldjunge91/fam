      "steps": [
        {
          "position": 0,
          "text": "Für die Char-Siu-Marinade: Vermische Sojasauce, Ahornsirup, Sesamöl, Knoblauch, Ingwer, 5-Gewürze-Pulver und geräuchertes Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mariniere die Hähnchenschenkel 30 Minuten oder über Nacht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backe sie bei 400°F 20 Minuten. Bestreiche sie mit zusätzlicher Glasur und grille sie 3 Minuten, bis sie glänzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für schnell eingelegte Gurke: Vermische sie mit Reisessig, einer Prise Zucker und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere das aufgeschnittene Hähnchen auf Reis mit Gurke und Frühlingszwiebel. Löffle Bratensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
