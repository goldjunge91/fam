    {
      "externalId": "waivy:mfr-chn-congee",
      "slug": "mfr-chn-congee",
      "title": "Chinesischer Hühner-Congee (Jook) mit Ingwer",
      "instructions": "Reis, langsam in Brühe gekocht, bis er zu einem seidigen Brei zerfällt, belegt mit zerpflücktem Hähnchen, knusprigem Ingwer, Frühlingszwiebel, Sesamöl und Sojasauce – Chinas stärkendes Essen, Frühstück, Katermittel und Wohlfühlschale in einem.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 40,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "1 Tasse Reis ergibt 4 großzügige Portionen – Congee gehört zu den günstigsten Wohlfühlgerichten.",
        "Knuspriger Ingwer ist die entscheidende Garnitur – er braucht 3 Minuten und verändert das Gericht.",
        "Übriger Congee dickt im Kühlschrank ein – gib beim Aufwärmen Wasser dazu."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-breast",
          "swap": "Beliebige übrige Eiweißquelle – Fisch, Schweinefleisch oder Tofu"
        },
        {
          "forIngredientId": "chicken-broth",
          "swap": "Wasser mit wenigen Tropfen Sesamöl für einen milderen Geschmack"
        }
      ],
