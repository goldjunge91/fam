      "steps": [
        {
          "position": 0,
          "text": "Reibe das Schweinefilet rundum mit grobem schwarzem Pfeffer ein und schneide es dann in 1 Zoll große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen beschichteten Pfanne bei mittlerer Hitze. Gib das Schweinefleisch dazu und gare es unter Rühren etwa 8 bis 10 Minuten, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe währenddessen das Wasser in einem großen Topf zum Kochen. Gib Orzo und Salz dazu und gare die Nudeln ohne Deckel 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre den Spinat unter die Orzo-Nudeln und gare alles etwa 1 weitere Minute, bis die Nudeln gar und die Blätter zusammengefallen sind. Gieße alles gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die halbierten Traubentomaten zum Schweinefleisch in die Pfanne und vermenge alles, bis die Tomaten durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die abgetropften Orzo-Nudeln und den Spinat zusammen mit dem zerbröselten Feta unter und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
