          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fahre damit fort, bis das Omelett gestockt ist und oben kein flüssiges Ei mehr zu sehen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile Feta, Tomate und Frühlingszwiebel auf einer Hälfte des Omeletts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klappe die leere Hälfte über die Füllung und lass das Omelett auf einen Teller gleiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Halbiere es zum Servieren für zwei Personen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
