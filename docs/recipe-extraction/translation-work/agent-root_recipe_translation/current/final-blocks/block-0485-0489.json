      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 EL Olivenöl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Fischfilets dazu und gare sie etwa 4 bis 5 Minuten pro Seite, bis sie sich leicht in Stücke teilen lassen. Lege sie dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße das übrige Öl in die Pfanne und gib Paprika, Pilze, Zwiebel, Zitronensaft und ein Viertel Teelöffel Salz dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke die Pfanne ab und gare alles bei mittlerer Hitze 6 bis 8 Minuten. Rühre gelegentlich um, bis das Gemüse weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege den Fisch wieder auf das Gemüse und würze ihn mit Pfeffer und dem restlichen Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und gare alles etwa 2 weitere Minuten, bis alles durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue Schnittlauch darüber, gib nach Wunsch Pinienkerne dazu und serviere das Gericht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
