      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofengrill vor. Decke die Fleischbällchen ab und erhitze sie bei hoher Mikrowellenleistung etwa 4 bis 6 Minuten, bis sie ganz heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während sie heiß werden, lege das Sauerteigbrot auf ein Backblech und bestreiche eine Seite jeder Scheibe mit Olivenöl. Grille es wenige Zentimeter von der Hitzequelle entfernt 1 bis 2 Minuten, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe das geröstete Brot mit der Schnittfläche des Knoblauchs ein und entsorge den Knoblauch anschließend. Reiße die Scheiben in mundgerechte Stücke und verteile sie in einer gefetteten Auflaufform von 11x7 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Ofentemperatur auf 350F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die heißen Fleischbällchen mit Marinara-Sauce, der Hälfte des Mozzarellas und der Hälfte des Parmesans, bis alles überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Löffle die Fleischbällchenmischung über das Brot und bestreue sie mit dem übrigen Mozzarella und Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Auflauf ohne Abdeckung 15 bis 18 Minuten, bis der Käse geschmolzen ist und blubbert. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
