      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln etwa 15 Minuten in Salzwasser, bis sie mit einer Gabel leicht einzustechen sind. Lass sie abtropfen und zerdrücke sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 Esslöffel Butter in einer Pfanne und dünste Zwiebel und Knoblauch etwa 4 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre das Krabbenfleisch unter die Zwiebelmischung, würze mit Paprikapulver, Salz und Pfeffer und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Milch zum Kartoffelpüree und schlage es cremig auf. Hebe die Krabbenmischung vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Kartoffel-Krabben-Mischung in einer gebutterten Auflaufform und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle die Eier mit einer Gabel und bestreiche die Oberfläche damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Parmesan und Semmelbrösel und streue die Mischung gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die restliche 1 Esslöffel Butter darauf und backe das Gericht bei 375°F 20 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse es vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
