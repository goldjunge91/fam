      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kochbananen: Schneide die Enden ab, ritze die Schale längs ein und ziehe sie vorsichtig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Kochbananen schräg in 1/2-inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne bei mittelhoher bis hoher Hitze, bis es glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Frittiere die Scheiben portionsweise pro Seite 2-3 Minuten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die frittierten Kochbananen auf einen mit Küchenpapier ausgelegten Teller und würze sie sofort mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dünste die Zwiebelscheiben im restlichen Öl etwa 4 Minuten, bis sie weich und leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte die Kochbananenscheiben auf einem Teller an, gib Zwiebeln und Koriander darauf und presse Limettensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort knusprig servieren.",
          "timerMinutes": null,
