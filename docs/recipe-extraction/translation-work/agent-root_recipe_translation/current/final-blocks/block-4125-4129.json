      "steps": [
        {
          "position": 0,
          "text": "Falls du frische Muscheln verwendest, schrubbe sie unter kaltem Wasser und wirf alle weg, die sich nicht schließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 1 Esslöffel Butter in einem großen Topf und gib Muscheln und Weißwein hinzu. Gare sie zugedeckt etwa 8 Minuten, bis sie sich öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Muscheln heraus, wirf geschlossene Exemplare weg und seihe die Kochflüssigkeit durch ein Passiertuch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz die restlichen 2 Esslöffel Butter in einer Pfanne und dünste Zwiebel und Knoblauch etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Semmelbrösel, Parmesan und Petersilie in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Löse das Muschelfleisch aus den Schalen, hacke es grob und lege es zurück in die Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib auf jede Muschel etwas Zwiebel-Knoblauch-Mischung und streue großzügig die Semmelbrösel-Käse-Mischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege die Muscheln auf ein Backblech und backe sie bei 400°F 10 Minuten, bis der Belag goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie heiß mit Zitronenspalten und der zurückbehaltenen Muschelbrühe zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
