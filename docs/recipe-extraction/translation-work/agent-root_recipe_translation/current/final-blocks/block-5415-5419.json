      "steps": [
        {
          "position": 0,
          "text": "Schneide die Zwiebel in Scheiben, hacke den Knoblauch und gib beides mit der Schweineschulter in einen Schongarer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Paprika, braunen Zucker, Essig, Salz und Pfeffer und reibe das Fleisch damit ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gare das Fleisch auf niedriger Stufe 6–8 Stunden oder auf hoher Stufe 3–4 Stunden, bis es sehr zart ist und sich leicht zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch aus dem Schongarer und zerpflücke es mit zwei Gabeln in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge das gezupfte Fleisch mit Barbecue-Sauce und 1 cup Garflüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Sliderbrötchen leicht an, fülle sie mit der Pulled-Pork-Mischung und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
