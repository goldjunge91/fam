      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rinderfilet in 8 gleich große Würfel und brate sie in einer heißen Pfanne je Seite 1–2 Minuten kurz an. Würze sie mit Salz und Pfeffer und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Pilze, Schalotte und Knoblauch fein und dünste alles in Butter an, bis die Flüssigkeit verdampft ist, etwa 8 Minuten. Gib Thymian dazu und lass die Mischung vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Blätterteig in 8 kleine Quadrate, gib jeweils einen Löffel Pilzmischung und einen Rindfleischwürfel darauf. Schlage den Teig darum und drücke die Ränder fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche die Teigpäckchen mit verquirltem Eigelb und lege sie auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie bei 400°F 15–18 Minuten, bis der Teig goldbraun und aufgegangen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass sie vor dem Servieren als elegante Slider leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
