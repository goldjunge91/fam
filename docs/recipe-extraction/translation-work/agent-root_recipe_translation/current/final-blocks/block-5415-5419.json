      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in 6 gleich große Stücke und klopfe sie vorsichtig auf eine gleichmäßige Dicke von 1 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Hähnchen auf beiden Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und brate das Hähnchen je Seite 5–6 Minuten goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge währenddessen die Krautsalatmischung mit Essig, Zucker und einer Prise Salz zu einem schnellen Krautsalat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Sliderbrötchen leicht an und bestreiche die Unterseiten mit Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege je ein Stück Hähnchen auf ein Brötchen, gib Krautsalat darauf und setze den Brötchendeckel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
