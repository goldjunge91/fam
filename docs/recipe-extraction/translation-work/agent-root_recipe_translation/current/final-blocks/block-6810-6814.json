      "steps": [
        {
          "position": 0,
          "text": "Knoblauch zerkleinern und mit Limettensaft, Orangensaft, Salz, Pfeffer, Kreuzkümmel und Olivenöl zu einer Marinade vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Schweinehaut mit einem Messer kreuzweise einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie das Schweinefleisch in einen großen Bräter und bedecken Sie es vollständig mit Mojo-Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Folie fest abdecken und mindestens 8 Stunden, am besten über Nacht, im Kühlschrank lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heizen Sie den Ofen auf 350 °F vor und backen Sie ihn abgedeckt 4 Stunden lang, wobei Sie alle 45 Minuten begießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Folie entfernen, Hitze auf 425 °C erhöhen und ohne Deckel 30 Minuten backen, bis die Haut knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "10 Minuten ruhen lassen, dann das Fleisch mit zwei Gabeln zerkleinern und mit der beiseite gestellten Pfannensoße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
