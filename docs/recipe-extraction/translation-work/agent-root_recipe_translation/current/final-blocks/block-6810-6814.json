      "steps": [
        {
          "position": 0,
          "text": "Schrubben Sie die Muscheln unter kaltem Wasser und entsorgen Sie offene oder rissige Muscheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Chorizo in dünne Scheiben schneiden, Zwiebel würfeln und Knoblauch fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf oder Cataplana bei mittlerer bis hoher Hitze erhitzen und Chorizo 2 Minuten anbraten, bis Fett austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebel und Knoblauch hinzufügen und 3 Minuten kochen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wein hinzufügen und 2 Minuten köcheln lassen, um ihn leicht zu reduzieren, dann Tomatenkonserven, Lorbeerblätter, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Muscheln und Wolfsbarschfilets hinzufügen, abdecken und 12–15 Minuten köcheln lassen, bis sich die Muscheln öffnen und der Fisch gar ist. Alle Muscheln, die sich nicht öffnen, wegwerfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in flachen Schüsseln servieren, mit frischer Petersilie garniert und mit knusprigem Brot zum Aufsaugen der Soße servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
