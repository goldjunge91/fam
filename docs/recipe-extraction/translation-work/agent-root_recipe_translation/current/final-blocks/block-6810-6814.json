      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie das Rindfleisch in dünne Streifen von etwa 2 cm Länge und 0.5 cm Breite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln in dünne Streifen schneiden und 15 Minuten in kaltem Wasser einweichen, dann abtropfen lassen und trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "3 Esslöffel Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und die geschnittenen Zwiebeln und den gehackten Knoblauch darin anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rindfleischstreifen hinzufügen und unter gelegentlichem Rühren 3–4 Minuten braten, bis die Ränder gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatenmark einrühren und 1 Minute kochen lassen, dann Rinderbrühe und Lorbeerblatt hinzufügen und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In der Zwischenzeit das restliche Öl in einer tiefen Pfanne auf 350 °F erhitzen und die Kartoffeln portionsweise 4–5 Minuten braten, bis sie goldbraun und knusprig sind. Auf Küchenpapier abtropfen lassen und mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kombinieren Sie die gekochte Rindfleischmischung mit knusprigen Kartoffeln, schwenken Sie sie vorsichtig und servieren Sie sie heiß, garniert mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
