      "steps": [
        {
          "position": 0,
          "text": "Gewürfeltes Weißbrot mit Milch vermengen, salzen und eine Weile ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nun die geriebenen Kartoffeln, den geriebenen Käse, die Eier und Petersilie dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter schmelzen und die gewürfelten Zwiebeln darin goldbraun braten. Zur Mischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl dazugeben und den Teig vorsichtig kneten. Runde Knödel formen, leicht flach drücken und in Butter auf beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In klarer Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
