      "steps": [
        {
          "position": 0,
          "text": "Zubereitungsschritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salz gehackt napa cabbage lightly und let sit 5 Minuten, then squeeze out excess liquid.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mische crumbled tofu, squeezed cabbage, green onions, Knoblauch, ginger, soy Sauce, und sesame Öl in a Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege 1 Teelöffel filling in the center of each dumpling wrapper, wet the edge mit Wasser, fold in half, then crimp the edges to seal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze vegetable Öl in a large skillet over mittlerer-hoher Erhitze und Lege dumplings flat-Seite down in the Pfanne in a single layer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fry für 2-3 Minuten bis bottoms are golden, then Gib ¼ cup Wasser to the Pfanne und cover immediately.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Steam für 5-6 Minuten bis Wasser evaporates und dumplings are cooked through, then Serviere hot mit soy Sauce or chili Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
