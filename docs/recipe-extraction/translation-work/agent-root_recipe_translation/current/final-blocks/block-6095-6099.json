      "steps": [
        {
          "position": 0,
          "text": "Gieße Wasser in einen Topf und bringe es zum Kochen. Gib Teeblätter dazu und koche sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Milch dazu und bringe die Mischung erneut zum Köcheln. Rühre Natron ein (die Mischung schäumt leicht).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf niedrige Stufe und lass alles 8-10 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Salz und Kardamompulver dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seihe den Tee durch ein feines Sieb in Serviertassen ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue jede Tasse mit gehackten Pistazien und Mandeln und serviere den Tee sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
