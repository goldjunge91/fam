      "steps": [
        {
          "position": 0,
          "text": "Blanchiere den Spinat 2 Minuten in kochendem Salzwasser. Gieße ihn ab, lass ihn abkühlen und püriere ihn zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einer Pfanne und brate die Paneerwürfel von allen Seiten hellgolden an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die geschnittenen Zwiebeln im selben Ghee goldbraun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Ingwer und Knoblauch in das restliche Ghee und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre rotes Chilipulver ein und gare es 30 Sekunden. Gib dann Joghurt dazu und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Spinatpaste hinein und gare sie unter ständigem Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Wasser, Kardamom, Zimt und Salz dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib gebratenen Paneer und Zwiebeln vorsichtig dazu und lass alles 15-20 Minuten köcheln, bis sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht heiß mit Basmatireis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
