      "steps": [
        {
          "position": 0,
          "text": "Erhitze Ghee in einem schweren Topf und brate 2 geschnittene Zwiebeln goldbraun an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die fein gehackte dritte Zwiebel mit Ingwer und Knoblauch in dasselbe Ghee und gare alles, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Fleischwürfel dazu und gare sie bei hoher Hitze 5 Minuten. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Joghurt und rotes Chilipulver dazu, rühre gut um und lass alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser dazu und gib Kardamom, Zimt, Lorbeerblätter und Salz hinein. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze und lass das Fleisch zugedeckt 60 Minuten köcheln, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Curry sollte eine helle, blasse Sauce haben. Garniere es mit den gebratenen Zwiebeln und serviere es heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
