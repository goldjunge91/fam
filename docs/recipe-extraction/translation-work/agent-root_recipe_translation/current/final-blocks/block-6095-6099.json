      "steps": [
        {
          "position": 0,
          "text": "Röste Vollkornmehl in einer trockenen Pfanne bei mittlerer Hitze 8-10 Minuten unter ständigem Rühren, bis es duftet und goldbraun ist. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einem Topf mit schwerem Boden und brate Mandeln, Cashewkerne und Rosinen goldbraun an. Nimm sie mit einer Schaumkelle heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das geröstete Mehl in dasselbe Ghee und röste es bei mittlerer Hitze 5 Minuten unter ständigem Rühren, bis es braun und aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße langsam unter ständigem Rühren Wasser dazu, damit keine Klümpchen entstehen, und koche alles 10 Minuten, bis die Masse eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Zucker, Kardamom und Salz dazu. Rühre gut um und gare alles weitere 8-10 Minuten, bis die Masse fest wird und sich vom Pfannenrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die gebratenen Nüsse und Rosinen unter, vermenge alles gut und gib die Masse auf einen gefetteten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Halwa leicht abkühlen, schneide sie in Quadrate und serviere sie warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
