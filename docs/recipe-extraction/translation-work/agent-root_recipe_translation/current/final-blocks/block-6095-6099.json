      "steps": [
        {
          "position": 0,
          "text": "Weiche Safran in 0.25 Tasse warmer Milch 10 Minuten lang ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Hefe mit 0.25 Tasse warmer Milch und 1 TL Zucker in einer Schüssel. Lass die Mischung 5 Minuten stehen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl, Salz und 2 tbsp Zucker in einer großen Schüssel und forme in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Hefemischung, die restliche warme Safranmilch, 2 tbsp geschmolzenes Ghee, 1 verquirltes Ei und Kardamom in die Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Knete alles 10 Minuten zu einem weichen Teig. Decke ihn ab und lass ihn an einem warmen Ort 60-90 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teile den Teig in 4 Portionen und forme dicke ovale Fladen. Lege sie auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die Oberseiten mit 2 tbsp geschmolzenem Ghee, drücke Mandeln und Mohn darauf und lass die Fladen 45 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heize den Ofen auf 400°F vor und backe die Fladen 20-25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lass sie leicht abkühlen und serviere sie warm mit Butter oder Marmelade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
