      "steps": [
        {
          "position": 0,
          "text": "Lege ein Stück Frischhaltefolie auf die Arbeitsfläche. Es sollte etwas größer als das Nori-Blatt sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege das Nori-Blatt mit der glänzenden Seite nach unten darauf. Richte eine Ecke auf dich aus, sodass das Blatt rautenförmig liegt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile in der Mitte der Raute ein dünnes Rechteck Reis von etwa 12 x 7 cm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Belege den Reis mit Gurkenscheiben, darauf mit Thunfisch, der mit Mayonnaise vermengt wurde, dann mit Avocado und zum Schluss mit etwas mehr Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe die vier Ecken des Nori-Blatts über die Füllung nach innen. Drücke das Päckchen mithilfe der Frischhaltefolie fest zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass es mit der Naht nach unten eine Minute ruhen. Wickle es dann aus, schneide es in zwei Hälften und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
