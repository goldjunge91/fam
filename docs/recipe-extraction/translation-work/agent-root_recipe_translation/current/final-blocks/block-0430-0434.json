      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne oder einem Wok bei hoher Hitze. Gib Knoblauch und Ingwer dazu und gare sie unter Rühren 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Hähnchen dazu und gare es unter Rühren 2-4 Minuten, bis es rundherum angebraten und nicht mehr roh aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tamari, süße Chilisauce, Brokkoli und 1/4 cup (60ml) Wasser dazu. Rühre alles um, lege einen Deckel auf und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre rote Paprika und rote Zwiebel unter und gare alles eine weitere 1 Minute oder bis das Hähnchen gar und das Gemüse bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere das Gericht auf gedämpftem Reis und garniere es mit frisch geschnittener Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
