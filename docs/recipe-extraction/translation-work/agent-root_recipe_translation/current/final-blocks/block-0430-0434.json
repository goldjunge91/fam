      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher Hitze. Gib gewürfelte Zwiebel und gehackten Knoblauch dazu und gare sie etwa 2 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Rinderhack dazu und brate es unter Zerteilen 2-3 Minuten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Kidneybohnen, Paprikapulver, Kreuzkümmel, Zwiebelpulver, Knoblauchpulver, Oregano und Salz ein. Rühre alles 1 Minute, damit die Gewürze angeröstet werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und 60ml (1/4 cup) Wasser ein. Lass alles 10 Minuten köcheln, bis die Mischung eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Löffle die Rindfleisch-Bohnen-Mischung in Schüsseln. Belege sie mit geriebenem Cheddar, saurer Sahne und geschnittener Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere dazu fein geschnittenen Rotkohl, gewürfelte Tomate, geschnittene Avocado, eingelegte Jalapeños, Maiskörner und Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
