      "steps": [
        {
          "position": 0,
          "text": "Koche die Spaghetti nach Packungsanweisung bissfest, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Speck in einer großen Pfanne knusprig und nimm ihn heraus. Hacke ihn grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, Parmesan und schwarzen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische den geriebenen Kohl mit Mehl und Dashi-Brühe zu einem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gekochten Spaghetti und den Speck dazu und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Masse im Speckfett bei mittlerer Hitze etwa 5 Minuten, bis die Unterseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Eiermischung über die Oberfläche und wende die Masse. Gare die andere Seite 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Gericht auf einen Teller und garniere es mit Bonitoflocken, die sich durch die Restwärme bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
