      "steps": [
        {
          "position": 0,
          "text": "Röste Poblano-Chilis über einer Gasflamme oder unter dem Backofengrill, bis die Haut rundum verkohlt ist. Lege sie anschließend 10 Minuten in einen Plastikbeutel und lasse sie darin dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ziehe die verkohlte Haut ab. Schneide jede Chili vorsichtig längs ein und entferne die Kerne, ohne sie aufzureißen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Gochujang, Sojasauce und Wasser in einem kleinen Topf. Erhitze die Mischung, bis sie köchelt, und stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle jede Chili mit Mozzarella und wende sie leicht in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle die Eier in einer flachen Schüssel und wende jede gefüllte Chili darin, bis sie vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer Hitze und brate die Chilis etwa 3 Minuten pro Seite, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte sie auf einem Teller an, gieße Gochujang-Sauce darüber und garniere sie mit Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
