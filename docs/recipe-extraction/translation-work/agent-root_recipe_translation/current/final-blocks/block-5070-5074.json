      "steps": [
        {
          "position": 0,
          "text": "Verrühre Sojasauce, Essig, Zucker, Knoblauch und Gochujang in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei starker Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Hähnchenwürfel etwa 8 Minuten, bis sie durchgegart und an den Rändern knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Sauce über das Hähnchen und vermische alles, bis die Stücke gleichmäßig überzogen und leicht karamellisiert sind. Das dauert etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Tortilla mit glasiertem Hähnchen und garniere sie mit Sesamsamen und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
