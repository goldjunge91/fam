      "steps": [
        {
          "position": 0,
          "text": "Machen Sie einen Teig, indem Sie Mehl, Salz und kalte Butter mit einer Gabel vermischen, bis er krümelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eigelb und warmes Wasser hinzufügen und verrühren, bis der Teig zusammenkommt; 30 Minuten kühl stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch in einer Pfanne mit Zwiebeln und Knoblauch bei mittlerer Hitze anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kreuzkümmel, Oliven und Rosinen hinzufügen; 5 Minuten köcheln lassen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig zwischen Backpapier in dünne Blätter rollen; in 4-Zoll-Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 EL Füllung in die Mitte jedes Quadrats geben, diagonal falten und die Ränder mit einer Gabel verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Empanadas portionsweise goldbraun braten, etwa 2-3 Minuten pro Seite; Auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
