      "steps": [
        {
          "position": 0,
          "text": "Maisstärke und Mehl mit einer Prise Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Paneerwürfel in der Maisstärke-Mehl-Mischung wenden, bis sie gleichmäßig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "3 EL Öl in einer tiefen Pfanne erhitzen und die panierten Paneerwürfel portionsweise rundherum etwa 8 Minuten goldbraun braten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das restliche 1 EL Öl erhitzen und den Knoblauch 30 Sekunden braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Zwiebel hinzufügen und 1 Minute braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sojasauce, Tomatensauce, Essig und Wasser vermengen und in die Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Paneer zurück in die Pfanne geben und 3–4 Minuten köcheln lassen, bis die Sauce leicht eindickt und der Paneer heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und heiß mit Reis oder Nudeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
