      "steps": [
        {
          "position": 0,
          "text": "Zerkleinere den Blumenkohlreis in einer Küchenmaschine fein und drücke überschüssige Flüssigkeit mit Küchenpapier oder einem sauberen Küchentuch heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle die Eier in einer Schüssel und vermenge sie mit Blumenkohlreis, Mandelmehl, Parmesan, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer beschichteten Pfanne bei mittlerer Hitze und forme aus der Blumenkohlmischung zwei flache Bratlinge von etwa 1/2-inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Bratlinge pro Seite 5-6 Minuten goldbraun und fest und lege sie anschließend auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Halbiere die Avocado, schneide sie in dünne Scheiben und verteile sie zusammen mit halbierten Kirschtomaten auf den Blumenkohltoasts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle alles mit Zitronensaft, würze mit Salz und Pfeffer und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
