      "externalId": "waivy:drink-watermelon-cooler",
      "slug": "drink-watermelon-cooler",
      "title": "Wassermelonen-Kühler",
      "instructions": "Frische Wassermelone wird mit Limettensaft und etwas Honig fein püriert und auf Eis serviert. Ein natürlich süßes, erfrischendes Sommergetränk, in weniger als fünf Minuten zubereitet.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": null,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Eine ganze Wassermelone während der Saison kaufen und selbst würfeln; das ist günstiger als vorgeschnittene Stücke.",
        "Übrige Wassermelonenwürfel einfrieren und statt Eiswürfeln mitmixen.",
        "Bei reifer, süßer Melone den Honig weglassen."
      ],
      "substitutions": [
        {
          "forIngredientId": "honey",
          "swap": "agave-syrup oder ein pinch von Zucker",
          "savings": "Agavendicksaft ist vegan und pro Verwendung oft günstiger als Rohhonig"
        },
        {
          "forIngredientId": "lime",
          "swap": "bottled Limette juice (Limette-juice-bottled)",
          "savings": "Spart etwa $0.30 gegenüber einer frischen Limette und hält länger"
        },
        {
          "forIngredientId": "watermelon",
          "swap": "gefroren-berries blended mit ein splash von Wasser",
          "savings": "Tiefgekühltes Obst ist außerhalb der Saison günstiger und verdirbt nicht so schnell"
        }
      ],
