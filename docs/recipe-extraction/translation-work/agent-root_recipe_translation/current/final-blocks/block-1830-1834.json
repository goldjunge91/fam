      "steps": [
        {
          "position": 0,
          "text": "Schritt 1: Koche die Kartoffel 8-10 mins in Wasser, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße sie ab und lass sie ausdampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Omelettpfanne, gib Chorizo dazu und gare sie 2 mins.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Kartoffel hinzu und gare sie weitere 5 mins, bis sie leicht knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Pfanneninhalt heraus, wische die Pfanne aus und brate darin ein Omelett aus 2 or 3 Eiern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wenn das Omelett fast gar ist, streue Chorizo, Kartoffel, Petersilie und Käse darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klappe das Omelett in der Pfanne zusammen und gare es 1 min weiter, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
