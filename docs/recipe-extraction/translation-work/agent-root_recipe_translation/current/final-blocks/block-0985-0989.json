      "cookTimeMinutes": 30,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Karamellisierte Zwiebeln sind der wichtigste Teil von Biryani. Nimm dir Zeit dafür.",
        "Wenn der Reis direkt in der gewürzten Hühnerbrühe gart, nimmt er den ganzen Geschmack auf."
      ],
      "substitutions": [
