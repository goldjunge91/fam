      "steps": [
        {
          "position": 0,
          "text": "Karamellisiere Zwiebeln 15 Minuten in Öl, bis sie dunkelgold sind. Nimm die Hälfte heraus und stelle sie als Topping beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch, Ingwer und alle Gewürze zu den übrigen Zwiebeln und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Hähnchenstücke dazu und gare sie 8 Minuten. Füge Reis und 3 Tassen Wasser hinzu. Würze alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe das Gericht zum Kochen, reduziere dann die Hitze, decke den Topf ab und gare es 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass es 5 Minuten ruhen und lockere den Reis auf. Garniere ihn mit den zurückbehaltenen karamellisierten Zwiebeln, Minze und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
