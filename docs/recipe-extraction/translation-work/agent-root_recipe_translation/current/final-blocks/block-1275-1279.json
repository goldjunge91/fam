      "steps": [
        {
          "position": 0,
          "text": "Für schnelles Pickle: Schneide Karotte und Daikon in feine Streifen und vermenge sie mit Reisessig, Zucker und Salz. Lass alles 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Schweinehack mit Sojasauce und bräune es 5 Minuten in einer Pfanne an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Eier mit der Oberseite nach oben. Verrühre Sriracha und Mayo zu Sriracha-Mayo.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte Reis, Schweinehack, Spiegeleier, eingelegtes Gemüse, Gurke und Koriander in eine Schüssel und träufle Sriracha-Mayo darüber.",
