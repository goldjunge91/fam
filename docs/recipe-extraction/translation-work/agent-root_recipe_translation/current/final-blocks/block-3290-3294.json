      "steps": [
        {
          "position": 0,
          "text": "Mehl, Zucker, Backpulver, Salz und Öl in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Warme Milch nach und nach hinzufügen und zu einem weichen Teig kneten; 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Char Siu, Hoisin-Sauce, Sesamöl und Zwiebel in einer separaten Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 6 Stücke teilen und jedes zu einem dünnen Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Je 1 Esslöffel Füllung in die Mitte jedes Kreises geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ränder um die Füllung zusammenführen und zusammendrücken, dann vorsichtig zu einer Kugel rollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bao mit der Naht nach unten auf Backpapierquadrate legen und 15 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Über kochendem Wasser 12-15 Minuten dämpfen, bis sie luftig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
