      "steps": [
        {
          "position": 0,
          "text": "Klebreismehl, Zucker und Salz in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach warmes Wasser hinzufügen und kneten, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 6 Stücke teilen und zu Kugeln formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Kugel flach drücken und 1 Esslöffel rote Bohnenpaste in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ränder über der Füllung zusammenfalten und verschließen, sodass eine Kugel entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Kugel in Sesamsamen wenden, bis sie bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einem tiefen Topf oder Wok auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Jian Dui vorsichtig ins Öl geben und 3-4 Minuten goldbraun frittieren; gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit einer Schaumkelle herausnehmen, auf Küchenpapier abtropfen lassen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
