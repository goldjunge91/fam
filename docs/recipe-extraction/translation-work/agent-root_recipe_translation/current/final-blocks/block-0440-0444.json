      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425F vor und lege die Tilapiafilets nebeneinander in einer Lage in eine ungefettete Auflaufform mit den Maßen 13x9-inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle geschmolzene Butter, Zitronensaft, Knoblauchpulver und Salz in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die Zitronen-Buttersoße gleichmäßig mit einem Löffel über den Filets, sodass sie gut bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Streue die abgetropften Kapern, getrockneten Oregano und Paprikapulver darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Fisch ohne Abdeckung 10 bis 15 Minuten, bis er sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die Filets mit einem Schaumlöffel heraus, gib etwas Bratensoße darüber und serviere sie nach Wunsch mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
