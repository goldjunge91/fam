    {
      "externalId": "waivy:toh-barbecue-chicken-quesadillas",
      "slug": "toh-barbecue-chicken-quesadillas",
      "title": "Barbecue-Hähnchen-Quesadillas",
      "instructions": "Zartes gezupftes Hähnchen wird mit rauchiger Barbecuesoße, Salsa und grünen Chilis vermischt, zwischen Weizentortillas mit kräftigem Cheddar gefüllt und goldbraun und käsig überbacken. Ein schnelles, beliebtes Essen aus der Hand mit genau der richtigen säuerlichen Schärfe. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/barbecue-chicken-quesadillas/",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 10,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Verwende ein fertig gegrilltes Hähnchen oder tiefgekühltes, vorgegartes Hähnchen. Das spart Kochzeit, Vorbereitungszeit und Geld.",
        "Kaufe einen Cheddarblock und reibe ihn selbst. Das ist pro Unze günstiger als fertig geriebener Käse und er schmilzt besser.",
        "Strecke die Füllung mit einer Dose abgetropfter schwarzer Bohnen oder Mais. So werden mehr Leute für nur ein paar Cent zusätzlich satt."
      ],
      "substitutions": [
        {
          "forIngredientId": "rotisserie-chicken",
          "swap": "Gezupftes Hähnchen aus der Dose oder übrig gebliebenes gegartes Putenfleisch",
          "savings": "Hähnchen aus der Dose ist lange haltbar und kostet weniger pro Portion"
        },
        {
          "forIngredientId": "sharp-cheddar",
          "swap": "Beliebiger geriebener Cheddar oder eine Pizzakäsemischung",
          "savings": "Großpackungen mit geriebenem Käse sind günstiger pro Unze"
        },
        {
          "forIngredientId": "bbq-sauce",
          "swap": "Ketchup mit etwas braunem Zucker und geräuchertem Paprikapulver verrühren",
          "savings": "Verwendet Vorratszutaten statt einer eigenen Spezialflasche"
        }
      ],
