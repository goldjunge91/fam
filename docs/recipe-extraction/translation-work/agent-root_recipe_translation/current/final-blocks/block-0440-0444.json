      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400F vor. Brate das Rinderhack in einer großen Pfanne bei mittlerer Hitze mit einer Tasse gehackter Zwiebel krümelig an. Zerteile das Fleisch dabei und brate es, bis kein Rosa mehr zu sehen ist und die Zwiebel weich wird, etwa 6 bis 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße das Fett ab und rühre Tomatensoße, gewürfelten Velveeta, Senfpulver und Worcestershiresauce ein. Rühre weiter, bis der Käse glatt geschmolzen ist, etwa 4 bis 6 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die Käse-Hackfleisch-Mischung in einer gefetteten Auflaufform mit den Maßen 13x9-inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile den geriebenen Cheddar und zerbröselten Speck gleichmäßig darüber und bedecke die Oberfläche anschließend mit einer Lage Kartoffeltalern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Auflauf ohne Abdeckung 35 bis 40 Minuten, bis er heiß ist, blubbert und die Kartoffeltaler goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gehackte Datteltomaten, geschnittene Dill-Gewürzgurken und die zurückbehaltene rohe Zwiebel darüber. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
