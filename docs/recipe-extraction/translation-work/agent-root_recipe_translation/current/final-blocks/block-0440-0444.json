      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 450 F vor. Verrühre das gezupfte Hähnchen in einer großen Schüssel mit grünen Chilis, Salsa, Barbecuesoße und Taco-Soße, bis alles damit überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege vier Tortillas auf zwei Backbleche. Verteile die Hähnchenmischung gleichmäßig darauf bis an die Ränder.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Streue den geriebenen Cheddar über die Füllung, lege jeweils eine zweite Tortilla darauf und drücke sie leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe die Quesadillas 6 bis 8 Minuten, bis die Oberfläche goldbraun und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide jede Quesadilla in sechs Spalten und serviere sie heiß, nach Wunsch mit saurer Sahne und zusätzlicher Salsa.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
