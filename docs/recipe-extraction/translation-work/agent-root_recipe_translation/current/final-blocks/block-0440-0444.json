      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mayonnaise, Dijon-Senf und Honig in einer kleinen Schüssel zu einem Aufstrich und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Klopfe jede Hähnchenbrust auf eine gleichmäßige Dicke von 1/2-inch und würze beide Seiten mit Montreal-Steakgewürz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grille das Hähnchen zugedeckt bei mittlerer Hitze (oder grille es 4 inches von der Hitzequelle entfernt) etwa 4 bis 6 Minuten pro Seite, bis die Kerntemperatur 165 Grad F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege in der letzten Minute je eine Scheibe Schweizer Käse auf jede Hähnchenbrust und lass sie schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Toaste die aufgeschnittenen Brötchen mit der Schnittseite nach unten bei mittlerer Hitze 30 bis 60 Sekunden goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Brötchen mit der Honig-Dijon-Mayonnaise, gib je eine Hähnchenbrust darauf, belege sie mit zerbröseltem Speck und ergänze nach Wunsch Salat und Tomate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
