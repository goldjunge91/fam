      "steps": [
        {
          "position": 0,
          "text": "Schneide das Baguette schräg in 1/2 inch dicke Scheiben und röste sie unter dem Grill leicht goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer Pfanne bei mittlerer bis hoher Hitze und dünste gehackten Knoblauch 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Garnelen dazu und brate sie pro Seite 2 Minuten, bis sie rosa und gar sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Mayonnaise, Tomatenmark, Zitronensaft, Paprikapulver, Salz und Pfeffer zu einer Sauce Rosé.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche jede geröstete Brotscheibe großzügig mit der rosa Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib jeweils 2-3 Garnelen darauf und garniere mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
