      "steps": [
        {
          "position": 0,
          "text": "Falls du Artischocken aus der Dose verwendest, gieße sie gut ab und tupfe sie trocken. Frische Artischocken putzen und halbieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Olivenöl in einer Pfanne bei mittlerer bis hoher Hitze und dünste Knoblauch 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Artischockenherzen dazu und brate sie unter gelegentlichem Rühren 3-4 Minuten leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Petersilie, Oregano, Zitronensaft, Chiliflocken, Salz und Pfeffer dazu und gare alles 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide das Baguette schräg in Scheiben und bestreiche sie mit dem restlichen Olivenöl. Röste sie leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die warme Artischockenmischung auf den gerösteten Scheiben und bestreue sie mit geriebenem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
