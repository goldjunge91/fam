      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinehackfleisch mit der Hälfte der Frühlingszwiebeln, 1 tbsp Sojasoße und Sesamöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 tsp Füllung in die Mitte jedes Wonton-Teigblatts und falte es zu einem Dreieck. Führe dann die Ecken zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe Wasser in einem Topf zum Kochen und gare die Wontons, bis sie an die Oberfläche steigen, dann noch 2 Minuten weiter. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe die Brühe in einem anderen Topf mit Ingwer, Knoblauch und der restlichen Sojasoße zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Nudeln separat nach Packungsanweisung und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Pak Choi in die Brühe und lasse ihn 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile Nudeln auf Schüsseln, gib Wontons und Gemüse dazu, schöpfe heiße Brühe darüber und garniere mit den restlichen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
