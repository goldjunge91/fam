      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Aalfilets mit Küchenpapier vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze. Gare den Aal 2-3 Minuten mit der Hautseite nach unten, bis sie knusprig ist. Wende ihn und gare die Fleischseite 1 Minute, bis er gerade durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasoße, Mirin, Zucker, Sake, Wasser sowie gehackten Ingwer und Knoblauch in einem kleinen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Soße 2-3 Minuten köcheln, bis sie leicht eindickt. Probiere sie und passe die Süße bei Bedarf mit mehr Zucker an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche den gegarten Aal auf beiden Seiten großzügig mit der Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den glasierten Aal mit der Hautseite nach oben zurück in die Pfanne und gare ihn 1 weitere Minute, damit die Glasur fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile den Reis auf zwei Schüsseln und lege den glasierten Aal vorsichtig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Träufle die restliche Glasur über den Aal und garniere ihn mit Sesamsamen und geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
