      "steps": [
        {
          "position": 0,
          "text": "Weiche Glasnudeln 8 Minuten in heißem Wasser ein, bis sie weich sind, und gieße sie dann gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne oder einem Wok bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Schweinehackfleisch hinzu und zerteile es beim Braten. Gare es etwa 4-5 Minuten, bis kein Rosa mehr zu sehen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Knoblauch und Ingwer ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Chilipaste, Sojasoße, Sesamöl, Zucker und Wasser hinzu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die weichen Nudeln in die Pfanne und vermenge alles 2-3 Minuten, bis es durchgewärmt und gut überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Frühlingszwiebeln garnieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
