      "steps": [
        {
          "position": 0,
          "text": "Schneide die Karotte in feine Stifte, den Chinakohl in mundgerechte Stücke und die Frühlingszwiebeln schräg in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Tofu in 1-inch große Würfel und halbiere die Pilze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gib Kombu-Algen hinein, damit sie ihr Aroma abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte Rindfleischscheiben, Gemüse und Tofu auf einer Platte um den köchelnden Topf auf dem Tisch an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Person nimmt Zutaten und taucht sie einige Sekunden in die heiße Brühe, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Ponzu-Soße mit Sesamsamen als Dip für die gegarten Zutaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche und genieße weiter, bis alle Zutaten aufgebraucht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße zum Schluss die restliche Brühe in Schüsseln und genieße sie als Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
