      "steps": [
        {
          "position": 0,
          "text": "Die Andouille-Wurst in 0.5-Zoll dicke Scheiben schneiden und in einem großen Topf bei mittlerer bis hoher Hitze 5 Minuten anbraten, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf Öl und Mehl bei mittlerer Hitze verquirlen und 10-12 Minuten ständig rühren, bis die Mehlschwitze dunkel schokoladenbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel, Sellerie und Paprika zur Mehlschwitze geben und 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch einrühren und 1 Minute kochen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hühnerbrühe langsam unter Rühren zugießen, um Klümpchen zu vermeiden, dann die angebratene Wurst zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Okra und gewürfelte Tomaten mit ihrem Saft hinzufügen und weitere 15 Minuten köcheln lassen, bis die Okra weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Cayennepfeffer abschmecken, dann kurz vor dem Servieren Filé-Pulver einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß über weißem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
