      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 350°F vorheizen und die Mirlitons längs halbieren, dann 20 Minuten in Salzwasser kochen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Etwas abkühlen lassen und das Fruchtfleisch mit einem Löffel herauslösen, dabei eine dünne Schale stehen lassen, dann das Fruchtfleisch in kleine Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Butter in einer Pfanne schmelzen und Zwiebel und Knoblauch etwa 3 Minuten braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Garnelen hinzufügen und etwa 3-4 Minuten garen, bis sie rosa sind, dann das Mirliton-Fruchtfleisch und den Cayennepfeffer unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Semmelbrösel und Parmesan in einer kleinen Schüssel vermengen und 2 Esslöffel geschmolzene Butter unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Garnelenmischung in die Mirliton-Schalen einer Backform geben, mit Milch beträufeln und mit der Semmelbröselmischung bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20-25 Minuten backen, bis die Oberfläche goldbraun ist und die Füllung am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
