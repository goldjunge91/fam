      "steps": [
        {
          "position": 0,
          "text": "Den Backofen auf 350°F vorheizen und eine 9x13 Zoll große Backform einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Brotwürfel in die Backform geben und die Rosinen darüber verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Milch, Eier, geschmolzene Butter, braunen Zucker, Vanilleextrakt und Zimt in einer Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Eiermilch über das Brot gießen und leicht andrücken, damit es die Flüssigkeit aufnimmt; anschließend 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "40-45 Minuten backen, bis der Pudding fest und die Oberfläche goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Während der Pudding backt, 2 Esslöffel Butter in einem Topf schmelzen und den Zucker einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, leicht abkühlen lassen, dann vorsichtig den Whiskey hinzufügen und umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren die warme Whiskysauce über den warmen Brotpudding gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
