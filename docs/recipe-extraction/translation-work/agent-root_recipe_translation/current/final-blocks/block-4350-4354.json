          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Marinade über den Thunfisch gießen und vorsichtig vermengen, bis alles gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
