      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 325°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Haferflocken, Mandeln, braunen Zucker, Salz und Zimt in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Honig und Kokosöl zusammen erwärmen, bis sie geschmolzen sind, dann Vanilleextrakt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die flüssige Mischung über die trockenen Zutaten gießen und gleichmäßig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf einem Backblech verteilen und 25–30 Minuten backen. Alle 10 Minuten umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen und 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Getrocknete Cranberrys untermischen und auf dem Blech vollständig abkühlen lassen, bevor die Granola aufbewahrt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
