      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser, Hefe und 1 Esslöffel Zucker in einer kleinen Schüssel vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Salz und restlichen Zucker in einer großen Schüssel vermischen, dann die Hefemischung hinzufügen und 8–10 Minuten lang kneten, bis eine glatte und elastische Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig mit einem feuchten Tuch abdecken und an einem warmen Ort 1 Stunde gehen lassen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rollen Sie den Teig auf eine Dicke von 1/4 cm aus und schneiden Sie ihn mit einem Glas oder einem Keksausstecher in 3 cm große Kreise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den geschnittenen Teig abgedeckt 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einem tiefen Topf oder einer Fritteuse auf 350 °F erhitzen und die Donuts 1–2 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen, dann mit einem Spieß ein Loch stechen und mit einem Spritzbeutel oder Löffel die Marmelade auffüllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Noch warm großzügig mit Puderzucker bestäuben und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
