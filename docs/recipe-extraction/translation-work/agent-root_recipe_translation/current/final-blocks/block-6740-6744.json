      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter schmelzen und mit Mandelbutter, Honig, Zimt, Salz und Wasser vermischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie ein Phyllo-Blatt auf eine saubere Oberfläche und bestreichen Sie es leicht mit zerlassener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteilen Sie etwa 1 Esslöffel Mandelmischung entlang einer Kante, falten Sie die Seiten nach innen und rollen Sie sie fest in eine Zigarrenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit der Nahtseite nach unten auf das vorbereitete Backblech legen und mit dem restlichen Phyllo und der Füllung wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "25–30 Minuten backen, bis es goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Noch warm großzügig mit Puderzucker bestäuben und bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
