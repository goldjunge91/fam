      "steps": [
        {
          "position": 0,
          "text": "Aus Mehl, Salz, geschnittener kalter Butter, Eigelb und Wasser einen Teig herstellen, bis eine Kugel entsteht, 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln in einer Pfanne anbraten, bis sie weich sind, den abgetropften Thunfisch dazugeben und 3 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geröstete Paprika, hartgekochte Eier und Oliven hacken, dann unter die Thunfischfüllung mischen und vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heizen Sie den Ofen auf 375 °F vor, teilen Sie den Teig in zwei Hälften und rollen Sie ihn jeweils zu einem 10-Zoll-Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Teigkreis auf ein Backblech legen, die Hälfte mit der Füllung bestreichen, umklappen und die Ränder mit einer Gabel festdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit verquirltem Ei bestreichen und 35–40 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten abkühlen lassen und vor dem Servieren in Spalten schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
