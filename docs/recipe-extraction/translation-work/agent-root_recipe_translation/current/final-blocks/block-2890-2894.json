          "text": "Eier in einer weiteren flachen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer tiefen Pfanne oder einem Schmortopf auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Welsfilets trocken tupfen und jeweils in das verquirlte Ei tauchen.",
