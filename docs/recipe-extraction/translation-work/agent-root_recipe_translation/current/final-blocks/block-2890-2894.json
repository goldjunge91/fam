      "steps": [
        {
          "position": 0,
          "text": "Speck in einer großen Pfanne bei mittlerer Hitze knusprig braten, herausnehmen und zerkrümeln; Bratfett aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Okra in 0.5-inch-Stücke und Zwiebel in Würfel schneiden, dann 3 Minuten im Speckfett anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute garen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dosentomaten samt Saft angießen und Salz, schwarzen Pfeffer sowie Zucker hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aufkochen lassen und ohne Deckel 15 Minuten köcheln lassen, bis die Okra weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerkrümelten Speck einrühren und abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm als Beilage oder auf Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
