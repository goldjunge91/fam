      "steps": [
        {
          "position": 0,
          "text": "Teigboden: Bereite aus 250g Mehl (ich mische gern verschiedene Mehle wie helles Mehl und Vollkorn-Dinkelmehl), 125g Butter, 1 Ei und einer Prise Salz einen Teig zu. Drücke ihn in eine Tarteform und stelle sie in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Füllung: Verrühre 300g Frischkäse und 100ml Milch glatt. Gib 3 Eier und 100g geriebenen Parmesan dazu und würze mit Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Teigboden aus dem Kühlschrank und stich den Boden mit einer Gabel ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Füllung hinein und backe die Tarte bei 175 Grad C etwa 25 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke die Tarte nach der Hälfte der Backzeit mit Alufolie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide in der Zwischenzeit etwa 350g Mini-Tomaten in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze 3tbsp Olivenöl, 3tbsp Weißweinessig und 1 tbsp Honig mit Salz und Pfeffer in einer kleinen Pfanne und verrühre alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Mischung über die Tomatenscheiben und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege die Tomatenscheiben mit einem Löffel auf die Tarte und vermeide dabei zu viel Flüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Garniere die Tarte mit Basilikumblättern und lass sie dir schmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
