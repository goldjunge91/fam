      "steps": [
        {
          "position": 0,
          "text": "Teig zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mehl, 1 Teelöffel Salz und Kurkuma in eine große Schüssel und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe das Backfett in das Mehl, bis kleine Stückchen vollständig mit Mehl bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 1/2 cup des Eiswassers hinein und vermenge alles mit den Händen, bis sich der Teig verbindet. Gib nach und nach jeweils 2 to 3 Esslöffel Eiswasser hinzu, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Du kannst den Teig nun in 2 große Stücke teilen, in Folie wickeln und vor der Verwendung 30 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alternativ kannst du den Teig in 10 to 12 gleich große Stücke teilen, auf eine Platte oder ein Backblech legen, sorgfältig mit Frischhaltefolie abdecken und 30 Minuten kalt stellen, während du die Füllung zubereitest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füllung zubereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Rinderhackfleisch in eine große Schüssel. Streue Piment und schwarzen Pfeffer darüber. Vermische alles und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Erhitze Öl in einer Pfanne, bis es heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gib die Zwiebeln hinzu und brate sie an, bis sie glasig sind. Füge scharfe Paprika, Knoblauch und Thymian hinzu und brate alles eine weitere Minute. Gib 1/4 Teelöffel Salz dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib das gewürzte Hackfleisch hinzu und vermenge alles. Zerteile dabei Klümpchen und gare das Fleisch, bis es nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Gib Ketchup und nach Geschmack weiteres Salz hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Gieße 2 cups Wasser hinein und rühre um. Bringe die Mischung zum Kochen, reduziere dann die Hitze und lasse sie köcheln, bis der Großteil der Flüssigkeit verdampft und der Rest zu einer dicken Soße eingekocht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Hebe Frühlingszwiebeln unter. Nimm die Pfanne vom Herd und lasse die Füllung vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
