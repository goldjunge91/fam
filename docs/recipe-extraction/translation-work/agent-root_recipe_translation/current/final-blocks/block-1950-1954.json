              "grams": 2.5,
              "quantity": 2.5,
              "unit": "g",
              "position": 1,
              "optional": false,
              "source_note": null
            },
            {
              "key": "e01d39cc-45e0-526f-96df-939e1aed2793",
              "ingredientName": "Weizenmehl",
              "grams": 480,
              "quantity": 480,
              "unit": "g",
              "position": 2,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Anleitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser und Salz in einem großen Topf zum Kochen, um die Klöße zu garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Weizenmehl und Salz in einer großen Schüssel, sodass das Salz gleichmäßig verteilt ist. Gib nach und nach Wasser zur Mehlmischung und vermenge alles mit den Händen, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in gleich große Stücke und forme jedes zu einer glatten Kugel. Drücke jede Kugel mit der Handfläche leicht flach, sodass ein runder Kloß entsteht. Er sollte wie eine dicke Scheibe aussehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Klöße vorsichtig einzeln in das kochende Wasser und achte darauf, dass sie nicht zusammenkleben. Du kannst sie mit einem Holzlöffel im Wasser umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Klöße 15-20 Minuten, bis sie gar sind und an die Wasseroberfläche steigen. Rühre gelegentlich um, damit sie nicht festkleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die gegarten Klöße mit einer Schaumkelle aus dem Topf und lasse überschüssiges Wasser abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie zu deinen Lieblingsgerichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
