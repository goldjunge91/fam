      ],
      "steps": [
        {
          "position": 0,
          "text": "Gib 2 ½ cups Wasser und 1 Dose Kokosmilch in einen schweren Topf mit 4 QT Fassungsvermögen. Bringe alles bei mittlerer bis hoher Hitze zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib währenddessen 1 cup Maismehl und 1 ½ cup Wasser in einen großen Messbecher und verrühre alles mit dem Schneebesen, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sobald der Topfinhalt zu kochen beginnt, rühre die Maismehlmischung mit dem Schneebesen ein und rühre etwa 1 Minute weiter, damit keine Klümpchen entstehen. Reduziere die Hitze auf niedrig und decke den Topf mit einem gut schließenden Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche den Brei bei niedriger Hitze 15-20 Minuten und rühre gelegentlich um. Wenn noch etwa 5 Minuten verbleiben, rühre Vanilleextrakt, Zimt, Muskatnuss und Piment ein. Nimm den Topf vom Herd und süße den Brei mit Kondensmilch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Servieren und genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
