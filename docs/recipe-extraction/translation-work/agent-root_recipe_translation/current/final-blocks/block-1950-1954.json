      "steps": [
        {
          "position": 0,
          "text": "Zerdrücke die Bananen mit einer Gabel in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib braunen Zucker, Vanilleextrakt, Zimt, Muskatnuss und eine Prise Salz hinzu. Siebe das Mehl darüber und verrühre alles mit einem Löffel, bis die Zutaten vollständig vermischt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Öl in eine 10 inch große Pfanne und erhitze es bei mittlerer bis hoher Hitze. Sobald das Öl heiß ist, gib den Bananenteig löffelweise hinein. Wenn eine Seite goldbraun ist und sich an der Oberseite Bläschen bilden, wende den Fritter und brate die andere Seite ebenfalls goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Fritter heraus und lasse sie auf Küchenpapier abtropfen. Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
