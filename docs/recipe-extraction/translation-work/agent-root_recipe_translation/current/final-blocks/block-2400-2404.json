      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Wasser zum Kochen. Blanchiere das Hähnchen 3 Minuten, gieße es ab und spüle es mit kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische im selben Topf Sojasauce, Wasser, Zucker, Ingwer, Knoblauch, Frühlingszwiebeln, Sternanis und Zimt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe die Mischung zum Kochen, gib das blanchierte Hähnchen dazu und reduziere die Hitze auf mittelniedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass das Hähnchen 20-25 Minuten köcheln und wende es nach der Hälfte der Garzeit, damit es gleichmäßig Farbe bekommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Hähnchen heraus und lass es leicht abkühlen. Beträufle es dann mit Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide das Hähnchen in Stücke und serviere es mit Sojasaucenbrühe darübergelöffelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
