      "steps": [
        {
          "position": 0,
          "text": "Schneide Aubergine in 2-inch große Stücke und erhitze 2 EL Öl in einem Wok bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Aubergine portionsweise insgesamt etwa 8 Minuten goldbraun und weich. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl dazu und brate Schweinehackfleisch bei hoher Hitze etwa 5 Minuten an. Zerteile es dabei, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Bohnenpaste, Knoblauch und Ingwer ein und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Aubergine zurück in den Wok und füge Sojasauce, Essig, Zucker und Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass alles 5 Minuten unter gelegentlichem Rühren köcheln, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit Sichuan-Pfefferkörnern und Frühlingszwiebeln und serviere es mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
