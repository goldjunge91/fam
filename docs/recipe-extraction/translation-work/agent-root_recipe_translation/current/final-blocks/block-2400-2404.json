      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Maisstärke, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Eiswasser zu den trockenen Zutaten und rühre nur so lange, bis alles vermischt ist. Der Teig sollte klumpig und kalt sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Wok auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe Garnelen oder Fisch sowie das Gemüse trocken und tauche jedes Stück in den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die panierten Zutaten portionsweise 2-3 Minuten pro Seite hellgolden. Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort mit Tempura-Dipsauce zum Eintunken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
