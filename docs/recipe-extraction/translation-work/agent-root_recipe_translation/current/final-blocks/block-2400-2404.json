      "steps": [
        {
          "position": 0,
          "text": "Klopfe Schweinekoteletts mit einem Fleischklopfer auf etwa 0.5 inches Dicke und würze dann beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schalen bereit: eine mit Mehl, eine mit verquirlten Eiern und eine mit Panko.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Kotelett zuerst in Mehl und schüttle Überschuss ab. Tauche es dann ins Ei und wende es abschließend gründlich in Panko. Drücke die Brösel leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Wok auf 350°F und gib die panierten Koteletts vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere sie 3-4 Minuten pro Seite goldbraun und gar. Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide Tonkatsu in Streifen und serviere es auf fein geschnittenem Kohl, mit Tonkatsu-Sauce beträufelt und mit Frühlingszwiebeln und einer Zitronenspalte garniert.",
          "timerMinutes": null,
