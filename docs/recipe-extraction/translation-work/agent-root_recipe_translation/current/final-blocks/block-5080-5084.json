      "steps": [
        {
          "position": 0,
          "text": "Trenne die Eier. Gib die Eigelbe in eine hitzebeständige Schüssel und stelle das Eiweiß für eine andere Verwendung beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eigelb und Zucker in der Schüssel über einem Wasserbad mit leicht köchelndem Wasser 8-10 Minuten ständig, bis die Masse hell und dick ist und auf einem Thermometer 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm die Schüssel vom Herd und rühre Sake und Vanilleextrakt langsam und unter ständigem Schlagen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Mischung 5 Minuten abkühlen und rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Sahne in einer separaten Schüssel steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die Schlagsahne in zwei Portionen vorsichtig unter die abgekühlte Zabaione.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Creme auf Dessertgläser und bestäube sie mit Kakaopulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege sie mit frischen Erdbeeren und serviere sie sofort oder stelle sie bis zu 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
