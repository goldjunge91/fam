      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Hefe und Salz in einer großen Schüssel und forme in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Eier, Zucker und Yuzu-Saft in die Mulde und verrühre alles mit einer Gabel, bis ein grober Teig entsteht. Knete ihn dann 10 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Arbeite die weiche Butter nach und nach in den Teig ein und knete etwa 5 Minuten, bis sie vollständig eingearbeitet ist. Hebe dann die getrockneten Cranberrys unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Teig in eine gefettete Schüssel, decke sie mit Frischhaltefolie ab und lasse den Teig 2 Stunden gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme den Teig zu einer Kugel, lege sie in eine Panettoneform oder hohe Kuchenform, decke sie locker ab und lasse sie 1.5 Stunden gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Panettone bei 375°F 40-50 Minuten, bis er goldbraun ist und ein Holzstäbchen aus der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche den noch warmen Panettone direkt nach dem Herausnehmen aus dem Ofen mit Honigglasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse ihn 10 Minuten in der Form abkühlen und stürze ihn dann auf ein Kuchengitter. Lasse ihn dort vollständig, mindestens 2 Stunden, auskühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
