      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und brate das Kalbfleisch von allen Seiten etwa 8 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel und Weißwein dazu. Bringe alles zum Köcheln, decke den Topf ab und gare das Fleisch 45 Minuten, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Kalbfleisch aus dem Topf und lasse es vollständig abkühlen. Schneide es anschließend in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere abgetropften Thunfisch, Sakura-Miso, Mayonnaise, Kapern und den Saft einer halben Zitrone in einer Küchenmaschine glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte die Kalbfleischscheiben auf einer Servierplatte an und gib je einen Löffel Thunfisch-Miso-Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle die Platte vor dem Servieren mindestens 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit weiteren Kapern und dünnen Zitronenscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kalt oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
