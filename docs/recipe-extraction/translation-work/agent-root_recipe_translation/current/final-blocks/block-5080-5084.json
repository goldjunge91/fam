      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen. Koche die Fettuccine nach Packungsanweisung bissfest, gieße sie ab und stelle 1 Tasse Nudelwasser beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und dünste den gehackten Knoblauch etwa 1 Minute an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die abgetropfte Pasta dazu und schwenke sie im Knoblauchöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Sojasauce über die Pasta und gib Butter dazu. Rühre ständig und gieße nach und nach Nudelwasser an, bis eine leichte Sauce entsteht. Das dauert etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Pfanne vom Herd und garniere die Pasta sofort mit Bonitoflocken, die sich durch die Restwärme bewegen und wellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische die Pasta vorsichtig mit einigen Flocken und lasse die übrigen sichtbar obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile sie auf Servierschalen und garniere sie mit geschnittenen Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange die Bonitoflocken noch in Bewegung sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
