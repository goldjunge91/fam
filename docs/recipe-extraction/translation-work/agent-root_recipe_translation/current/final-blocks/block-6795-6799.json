      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen. Dünn geschnittenen Knoblauch und Chiliflocken 1 Minute darin dünsten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Muscheln und Weißwein dazugeben, den Topf abdecken und 3–4 Minuten köcheln lassen, bis sich die Muscheln zu öffnen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischfond angießen und alles leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Fisch in große Stücke schneiden, dazugeben und 5–7 Minuten ohne Deckel köcheln lassen, bis er gerade gar ist und sich die übrigen Muscheln geöffnet haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geschlossene Muscheln entfernen und abschmecken. Bei Bedarf Salz und Pfeffer ergänzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frische gehackte Petersilie unterrühren und in flachen Schüsseln mit knusprigem Brot zum Auftunken der Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
