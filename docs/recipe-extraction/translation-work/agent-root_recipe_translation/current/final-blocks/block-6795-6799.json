      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln, Zwiebeln und Sellerie würfeln und separat beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem großen Topf bei mittlerer Hitze schmelzen und Zwiebel und Sellerie 4 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Gemüse mit Mehl bestäuben und 1 Minute unter ständigem Rühren anschwitzen, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hühnerbrühe nach und nach unter Rühren zugießen, damit sich keine Klümpchen bilden. Kartoffeln, Lorbeerblatt und Thymian dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 15 Minuten köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Venusmuscheln abgießen und den Saft auffangen. Muscheln und Saft zusammen mit der Sahne in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten köcheln lassen, ohne die Suppe aufzukochen. Mit Salz und Pfeffer abschmecken, das Lorbeerblatt entfernen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
