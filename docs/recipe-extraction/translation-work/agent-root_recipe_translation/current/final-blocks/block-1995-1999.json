      "steps": [
        {
          "position": 0,
          "text": "Kochen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib etwas Olivenöl in eine Sauteuse oder einen Topf mit Deckel. Sobald es heiß ist, gib Zwiebeln, gewürfeltes Rindfleisch und rote Paprika hinein und brate alles 5 Minuten unter gelegentlichem Rühren. Das Fleisch sollte vollständig gebräunt sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Paprikapulver, Tomatenpüree und Chiliflocken dazu und würze mit Salz und Pfeffer. Vermische alles und brate es weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Kohl dazu und verrühre alles. Brate die Mischung unter gelegentlichem Rühren 3-5 Minuten. Das meiste Öl sollte dabei verdampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße kochendes Wasser in den Topf, sodass der Kohl vollständig bedeckt ist und das Wasser etwa 1 Zoll darüber steht. Setze den Deckel auf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass den Eintopf 2.5 Stunden köcheln. Er ist fertig, wenn der Kohl weich und das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle den Eintopf in breite Schalen und lass ihn 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
