      "steps": [
        {
          "position": 0,
          "text": "Vanillecreme",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Trenne die Eigelbe und stelle das Eiweiß für die Baisermasse beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eigelb, Maisstärke und Zucker in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Sahne und Milch in einem Topf. Öffne die Vanilleschote und gib die Samen in den Topf. Sobald die Milch zu sprudeln beginnt, gieße etwa die Hälfte unter ständigem Rühren zur Eiermischung. Stelle den Topf zurück auf den Herd und gieße die Eiermischung unter ständigem Rühren zurück in den Topf zur restlichen Milch. Sobald die Mischung eindickt, reduziere die Hitze und rühre etwa 30 Sekunden weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Creme in eine saubere Schüssel und decke sie mit Frischhaltefolie ab, die direkt auf der Oberfläche liegt. Stelle sie zum Abkühlen in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kuchen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verrühre Butter und Zucker, bis die Masse hell und luftig ist. Gib die Eigelbe einzeln dazu und stelle das Eiweiß für die Baisermasse beiseite. Gib das mit Backpulver vermischte Mehl dazu. Rühre die Milch ein und schlage alles glatt (nach Wunsch mit einem elektrischen Mixer).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heize den Ofen auf 320°F (160°C) vor. Lege ein Backblech mit Backpapier aus und verteile den Teig darauf zu einem großen, gleichmäßigen Rechteck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Baiserhaube",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schlage Eiweiß und Zucker zu glänzenden, festen Spitzen. Das Baiser sollte seine Form halten. Wenn es noch zerläuft, schlage weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Verteile das Baiser auf dem Kuchenteig. Forme mit einem Spatel leichte Wellen. Streue Mandeln darüber. Backe den Kuchen etwa 30 Minuten, bis Baiser und Mandeln goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Sahnefüllung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Schlage die Sahne steif. Hebe vorsichtig die Vanillecreme unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Zusammensetzen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
