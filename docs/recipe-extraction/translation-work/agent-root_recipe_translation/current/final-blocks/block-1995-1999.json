      "steps": [
        {
          "position": 0,
          "text": "Vorbereitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sommerkürbis, Zucker, Eier und Natron in einer Rührschüssel. Gib das Mehl dazu und rühre weiter, bis eine dicke, klebrige Masse entsteht. Gib etwas mehr Mehl dazu, wenn die Mischung noch dünn und leicht flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe etwas Olivenöl auf den Boden und die Ränder eines großen runden Backblechs (etwa 2 Zoll tief).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Masse auf dem Blech. Gib etwas Olivenöl auf deine Hand und verstreiche es mit kreisenden Bewegungen vorsichtig auf der Oberfläche. Dadurch wird sie glatt und erhält einen leicht glänzenden Überzug.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe den Kuchen 40 Minuten bei 180 Grad im Ofen. Die Oberfläche sollte danach goldbraun sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Kuchen abkühlen, bevor du ihn in Quadrate schneidest und servierst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
