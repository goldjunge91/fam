      "steps": [
        {
          "position": 0,
          "text": "Schlage Ei und Zucker, bis die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter und lass sie leicht abkühlen. Gib sie dann zur Eiermischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Gewürze ein und gib anschließend langsam unter Rühren das Mehl dazu, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass den Teig mindestens 30 Minuten ruhen. Dadurch verbessert sich die Konsistenz der Krumkaker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib etwa one gehäuften Esslöffel Teig auf das Eisen und backe ihn. Falls der Teig zu dick ist, gib etwas Wasser dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme die Krumkake noch heiß mit einer hölzernen Krumkake-Rolle oder über einem Becher (bei einem Becher sollten sie etwas dicker sein). Die Krumkaker werden schnell fest. Lass sie daher auf der Rolle oder dem Becher liegen, bis die nächste Krumkake geformt werden kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Krumkaker vollständig abkühlen und bewahre sie in einer Metall- oder Glasdose auf, die am Boden mit Küchenpapier ausgelegt ist. Du kannst sie auch einfrieren!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
