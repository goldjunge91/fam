      "steps": [
        {
          "position": 0,
          "text": "Halbiere und entkerne die Paprika. Lege sie mit der Schnittseite nach unten auf ein Backblech und verteile Zwiebel und Knoblauch daneben. Röste alles bei 450 °F 20–25 Minuten, bis die Paprika verkohlt und zusammengefallen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ziehe die Haut von den Paprika ab, sobald sie kühl genug zum Anfassen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere geröstete Paprika, Zwiebel und Knoblauch mit zerdrückten Tomaten, geräuchertem Paprikapulver und Gemüsebrühe, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Suppe in einen Topf und lass sie 10 Minuten köcheln. Rühre griechischen Joghurt ein, nachdem du den Topf vom Herd genommen hast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz und Pfeffer. Serviere die Suppe mit zusätzlichem Joghurt als Klecks obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
