      "steps": [
        {
          "position": 0,
          "text": "Koche Quinoa etwa 15 Minuten, bis sie weich ist. Heize den Ofen auf 375 °F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Rinderhack mit Zwiebel, Knoblauch, Kreuzkümmel und Zimt an. Gieße das Fett ab. Rühre Tomatenmark und gekochte Quinoa ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Spitzen der Paprika ab und entferne die Kerne. Fülle jede Paprika mit der Hack-Quinoa-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Paprika in eine Auflaufform und gib einen Schuss Wasser auf den Boden. Backe sie 30–35 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garniere sie mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
