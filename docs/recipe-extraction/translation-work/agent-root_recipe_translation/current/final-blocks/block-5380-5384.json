          "position": 0,
          "text": "Koche den Reis nach Packungsanleitung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Rinderhackfleisch in einer großen Pfanne bei mittlerer bis hoher Hitze etwa 5 Minuten an. Zerteile es dabei und gieße anschließend überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch, Ingwer, Sojasauce, braunen Zucker und Sesamöl zum Fleisch und rühre 1 Minute um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Spinat in einer weiteren Pfanne bei mittlerer Hitze 2 Minuten zusammenfallen und würze ihn leicht mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Eier in einer kleinen Pfanne als Spiegeleier oder teile den Reis auf Schüsseln auf und gib rohe Eigelbe darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den gekochten Reis auf zwei Schüsseln und gib die Fleischmischung sowie den zusammengefallenen Spinat darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege je ein Spiegelei auf die Bowls und garniere mit Sesam und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
