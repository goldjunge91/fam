      "steps": [
        {
          "position": 0,
          "text": "Öl in einer Pfanne erhitzen und Knoblauch, Ingwer und Zwiebel 2 Minuten anbraten, bis ein angenehmer Duft entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ordnen Sie die Taro-Blätter in der Pfanne so an, dass ein Bett entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischfilets auf die Taroblätter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch gleichmäßig über den Fisch gießen, Fischsauce, Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aufkochen lassen, dann die Hitze reduzieren und zugedeckt 20–25 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In den letzten 5 Minuten der Garzeit grüne Chilischoten hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Überprüfen Sie mit einer Gabel, ob der Fisch gar ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit den Taroblättern und der Soße über gedünstetem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
