      ],
      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen und die geschnittenen Zwiebeln und den gehackten Knoblauch 5 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomaten mit Saft, Oregano und Paprikaflocken hinzufügen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fischbrühe angießen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Meeresfrüchte putzen und zubereiten: Garnelen schälen, Bärte von Muscheln entfernen und Muscheln schrubben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zuerst herzhaftere Meeresfrüchte hinzufügen (z. B. feste Weißfischstücke) und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restlichen Meeresfrüchte (Garnelen, Muscheln, Venusmuscheln) hinzufügen und 8–10 Minuten kochen lassen, bis die Garnelen rosa sind und sich die Muscheln und Venusmuscheln geöffnet haben (alle, die sich nicht öffnen, wegwerfen).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Hälfte der frischen Petersilie unterrühren und mit Salz und schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln füllen, mit restlicher Petersilie garnieren und mit geröstetem, knusprigem Brot zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
