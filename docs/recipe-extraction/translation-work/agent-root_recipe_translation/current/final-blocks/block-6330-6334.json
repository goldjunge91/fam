      "steps": [
        {
          "position": 0,
          "text": "Mehl mit warmem Wasser und Salz zu einem weichen Teig vermischen und dann 8 Minuten lang kneten, bis er sehr glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig mit einem feuchten Tuch abdecken und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mangold waschen und hacken. Mit gehacktem Knoblauch in 1 Esslöffel Butter 8 Minuten anbraten, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gekochtes Gemüse mit Ricotta, Parmesan, schwarzem Pfeffer und Muskatnuss in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teilen Sie den Teig in kleine Portionen und rollen Sie jede Portion sehr dünn zwischen Backpapier zu Rechtecken aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 Esslöffel Füllung in der Mitte jedes Teigrechtecks verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Teig fest um die Füllung rollen und die Ränder durch Zusammendrücken oder Drücken mit einer Gabel verschließen, sodass ein langer Zylinder entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wickeln Sie die gefüllten Rollen spiralförmig oder halbmondförmig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Salzwasser in einem großen Topf zum Kochen bringen. Picagge darin garen, bis sie an die Oberfläche steigen, und weitere 2–3 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Abgießen und mit den übrigen 4 Esslöffeln geschmolzener Butter sowie zusätzlichem Parmesan vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
