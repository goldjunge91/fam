      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen Pfanne bei mittlerer Hitze erhitzen und Knoblauch, Zwiebeln, Ingwer und Chilis 2 Minuten lang anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Getrocknete Garnelen hinzufügen und 1 Minute unter ständigem Rühren kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nach und nach die Taroblätter hinzufügen und umrühren, bis sie zusammenfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie die Kokosmilch langsam und unter Rühren hinzu, um eine gleichmäßige Mischung zu erzielen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fischsauce und Salz hinzufügen. Ohne Deckel 20–25 Minuten köcheln lassen, bis die Blätter weich sind und die Sauce etwas eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gelegentlich umrühren, um ein Anhaften zu verhindern und ein gleichmäßiges Garen zu gewährleisten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und bei Bedarf mit zusätzlicher Fischsauce oder Salz nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit gedünstetem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
