      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Backpulver und Salz in einer Rührschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme in der Mitte eine Mulde, gib Ei und Wasser hinein und rühre, bis ein dicker Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe gehackte Zwiebeln, Knoblauch und rote Chilis unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Garnelen hinzu und rühre vorsichtig, damit sie gleichmäßig im Teig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Wok auf 350°F (175°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Löffelportionen Teig ins heiße Öl und frittiere sie 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit süßer Chilisauce oder Sambal servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
