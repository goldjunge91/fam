        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze und bräune Rindfleisch portionsweise 3-4 Minuten. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel im selben Topf 5 Minuten weich, gib Knoblauch hinzu und gare ihn 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Rindfleisch zurück in den Topf, gieße Brühe hinzu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse es 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Reis und alle Gewürze ein und lasse die Suppe 20 Minuten köcheln, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische gemahlene Walnüsse mit 1/4 Tasse warmer Brühe zu einer Paste und rühre sie in die Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 5 Minuten köcheln, passe die Würzung mit Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schöpfe die Suppe in Schalen und serviere sie heiß mit knusprigem Brot.",
          "timerMinutes": null,
