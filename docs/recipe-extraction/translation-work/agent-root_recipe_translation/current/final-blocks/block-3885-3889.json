      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eier, Milch, Mehl, Salz und Zucker zu einem glatten, dünnflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl und Butter in einer 10 Zoll großen beschichteten Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße 1/4 Tasse Teig in die Mitte und neige die Pfanne sofort, damit sich der Teig dünn kreisförmig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe den Pfannkuchen etwa 1 Minute, bis die Unterseite goldbraun ist. Wende ihn und backe die andere Seite weitere 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ihn auf einen Teller und wiederhole den Vorgang mit dem restlichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jeden Mlyntsi mit Marmelade, Schokoladenaufstrich oder saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rolle die Pfannkuchen auf und serviere sie warm mit einem Klecks saurer Sahne und nach Wunsch mit Puderzucker bestäubt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
