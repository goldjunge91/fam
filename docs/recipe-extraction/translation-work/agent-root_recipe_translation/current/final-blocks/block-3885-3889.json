      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Wasser, Salz und Öl zu einem weichen Teig, knete ihn 5 Minuten, decke ihn ab und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Hackfleisch in einer Pfanne bei mittelhoher Hitze und zerteile es während des Garens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Zwiebel und Knoblauch zum Fleisch und dünste sie 5 Minuten weich. Würze mit Pfeffer und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 6 gleich große Stücke und rolle jedes dünn oval aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2-3 Esslöffel Fleischfüllung auf eine Hälfte jedes Teigovals, klappe den Teig zu einem Halbmond zusammen und drücke die Ränder fest zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer Hitze und brate Kutabs je Seite 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
