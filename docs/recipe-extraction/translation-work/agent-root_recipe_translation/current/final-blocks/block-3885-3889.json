      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Spinat 2 Minuten in kochendem Salzwasser und drücke dann überschüssige Feuchtigkeit heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Walnüsse 3 Minuten in einer trockenen Pfanne, bis sie duften, und hacke sie dann fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste gehackte Zwiebel 3 Minuten in einer Pfanne weich, gib Knoblauch hinzu und gare ihn 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hacke den blanchierten Spinat fein und vermische ihn mit Walnüssen, Zwiebelmischung und allen Gewürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Granatapfelkerne oder Essig ein und passe die Würzung an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Häufe die Mischung auf einer Servierplatte an und forme sie zu einem Hügel oder zu Bratlingen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren bei Raumtemperatur 10 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
