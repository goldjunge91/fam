      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig zu, indem du Mehl, Wasser und Salz vermischst. Knete ihn 8 Minuten und lasse ihn zugedeckt 45 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische beide Käsesorten in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig zu einem großen dünnen Kreis von etwa 14 Zoll Durchmesser aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Teig auf ein geöltes Backblech und verteile die Käsemischung gleichmäßig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe die Ränder rundherum etwa 2 Zoll nach innen, sodass ein Rand mit sichtbarem Käse in der Mitte entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe das Brot bei 400°F 25-30 Minuten, bis die Kruste goldbraun ist und der Käse zu blubbern beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm es aus dem Ofen, forme 2 kleine Mulden im Käse, schlage je ein Ei hinein und backe es weitere 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche die Kruste mit geschmolzener Butter und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
