      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in 8 Stücke und erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Hähnchen mit Salz und Pfeffer, bräune es 10 Minuten von allen Seiten an und nimm es heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel und gehackten Knoblauch in den Topf und dünste alles 2 Minuten an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis dazu und rühre 1 Minute, damit er mit Öl überzogen wird. Gieße dann Hühnerbrühe hinein und lege das Hähnchen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Lorbeerblätter hinzu und bringe alles zum Kochen. Reduziere die Hitze, decke den Topf ab und lasse es 35 Minuten köcheln, bis der Reis gar und das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entferne die Lorbeerblätter und rühre gehackte Petersilie ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht direkt aus dem Topf als vollständige Mahlzeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
