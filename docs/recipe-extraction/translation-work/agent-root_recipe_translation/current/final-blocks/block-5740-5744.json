      "steps": [
        {
          "position": 0,
          "text": "Schneide das Schweinefleisch in 2-inch große Würfel und erhitze Öl in einem großen Topf bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Fleischwürfel 8 Minuten von allen Seiten an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Ingwerscheiben und zerdrückten Knoblauch in den Topf und rühre 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Fleisch zurück in den Topf und füge Sojasoße, Wasser, braunen Zucker, Sternanis und 2 gehackte Frühlingszwiebeln hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Kochen. Reduziere die Hitze, decke den Topf ab und lasse das Fleisch 1.5 Stunden köcheln, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Reisessig ein und lasse alles ohne Deckel weitere 5 Minuten köcheln, damit die Soße etwas eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit den übrigen gehackten Frühlingszwiebeln und serviere es auf gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
