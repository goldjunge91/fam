      "steps": [
        {
          "position": 0,
          "text": "Schneide die Aubergine in lange Streifen von etwa 3 inches Länge und 1 inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate die Auberginenstreifen portionsweise 4 Minuten pro Seite weich und leicht gebräunt. Lege sie anschließend auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch in dieselbe Pfanne und rühre 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Sojasoße, Reisessig, Zucker und Wasser in einer kleinen Schüssel und gieße die Mischung mit dem Knoblauch in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Auberginen zurück in die Pfanne und lasse die Soße aufkochen. Gare alles ohne Deckel 10 Minuten, bis die Aubergine sehr weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Speisestärke mit 1 Esslöffel Wasser und rühre die Mischung zum Andicken in die Soße. Gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle das Gericht mit Sesamöl, garniere es mit geschnittenen Frühlingszwiebeln und serviere es auf gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
