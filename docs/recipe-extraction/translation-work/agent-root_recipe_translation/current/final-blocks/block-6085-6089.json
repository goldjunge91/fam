      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Grieß, Salz und Natron in einer Schüssel. Gib nach und nach Wasser dazu und knete alles zu einem weichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lass ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze währenddessen 2 tbsp Öl in einer Pfanne und brate die gewürfelten Kartoffeln etwa 8 Minuten goldbraun und weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zwiebel, grüne Chili, Kreuzkümmelsamen, Kurkuma und rotes Chilipulver zu den Kartoffeln. Gare alles 3 Minuten, bis es duftet, und stelle die Bhaji-Beilage beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 8 gleich große Portionen und forme jede zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Frittieröl in einem tiefen Topf auf 350°F (175°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Drücke jede Teigkugel auf einer geölten Fläche zu einem dünnen Kreis von etwa 5 inches Durchmesser flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frittiere jedes Poori im heißen Öl pro Seite 1-2 Minuten, bis es goldbraun und aufgepufft ist. Wende es einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere die Pooris heiß mit der warmen Bhaji-Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
