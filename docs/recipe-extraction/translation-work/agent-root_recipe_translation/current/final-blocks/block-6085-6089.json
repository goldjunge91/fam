      "steps": [
        {
          "position": 0,
          "text": "Weiche Reis und Urad Dal getrennt 4 Stunden in Wasser ein. Gieße beides gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle den eingeweichten Reis und Urad Dal mit 0.5 cup Wasser zu einem glatten, dickflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geraspelte Kokosnuss, Jaggery und Kardamom mit dem restlichen Wasser in einen Mixer und püriere alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Kokos-Jaggery-Mischung zum Reisteig und hebe sie vorsichtig unter. Rühre dann Salz ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fette kleine Formen aus Edelstahl oder Bambus (oder Idli-Förmchen) mit Öl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Form zu drei Vierteln mit Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Dämpfe die Küchlein in einem Dämpfer oder Idli-Gerät 8-10 Minuten, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass die Küchlein etwas abkühlen und stürze sie dann aus den Formen. Serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
