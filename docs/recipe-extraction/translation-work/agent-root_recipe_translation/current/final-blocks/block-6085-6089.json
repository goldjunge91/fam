      ],
      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete rote Chilischoten, Kreuzkümmelsamen, Koriandersamen und Pfefferkörner 1 Minute in einer trockenen Pfanne an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die gerösteten Gewürze mit geraspelter Kokosnuss, Knoblauch und Ingwer in einen Mixer. Püriere alles mit möglichst wenig Wasser zu einer dicken Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und dünste die gewürfelte Zwiebel etwa 4 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Kokos-Gewürz-Paste dazu und brate sie unter ständigem Rühren 2 Minuten an, damit sie nicht ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Krabbenfleisch und Salz dazu und rühre vorsichtig um, damit das Fleisch nicht zu sehr zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare alles bei mittlerer Hitze 8-10 Minuten und rühre gelegentlich um, damit die Aromen einziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verfeinere das Gericht mit Limettensaft und schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß als trockenes Curry mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
