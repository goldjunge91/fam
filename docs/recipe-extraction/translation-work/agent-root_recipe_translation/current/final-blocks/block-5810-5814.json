      "steps": [
        {
          "position": 0,
          "text": "Verwende besonders frisches Rindfleisch von hoher Qualität aus einer vertrauenswürdigen Metzgerei und bitte darum, es sehr fein zu hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Schalotte und Petersilie fein und schneide die Kapern in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rinderhack in eine Schüssel und forme in der Mitte eine Mulde für das Eigelb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Eigelb, Senf, Worcestersoße, Salz und Pfeffer zum Rindfleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die Zutaten vorsichtig mit einer Gabel, bis sie gerade eben verbunden sind. Knete das Fleisch nicht zu stark.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe Kapern, Schalotte und Petersilie unter, bis sie gleichmäßig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Teile die Masse in zwei Portionen, forme daraus Nocken oder Häufchen auf Serviertellern und serviere sie sofort mit geröstetem Brot oder Crackern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
