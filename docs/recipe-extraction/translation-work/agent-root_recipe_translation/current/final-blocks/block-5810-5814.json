      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilischoten und röste sie 30 Sekunden in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein. Gieße sie ab und püriere sie mit Knoblauch, Essig, Salz und Pfeffer zu einer glatten Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl und Butter in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Chili-Soße ins heiße Öl und gare sie unter ständigem Rühren 2-3 Minuten, damit sie nicht ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Garnelen dazu und rühre sie unter die Soße. Gare sie 4-5 Minuten, bis sie rosa und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere die Soße und schmecke sie bei Bedarf mit mehr Salz oder Essig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib alles in eine Servierschüssel, presse frischen Limettensaft darüber und serviere das Gericht sofort mit Reis oder warmen Tortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
