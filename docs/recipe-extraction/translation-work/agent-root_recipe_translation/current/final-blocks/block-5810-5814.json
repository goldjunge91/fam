      "steps": [
        {
          "position": 0,
          "text": "Hacke Petersilie, Oregano und Knoblauch grob und gib sie mit Essig und Olivenöl in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere alles portionsweise, bis das Chimichurri noch stückig ist. Würze es dann mit roten Chiliflocken, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse das Chimichurri mindestens 15 Minuten bei Zimmertemperatur ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Steaks mit Küchenpapier trocken und würze beide Seiten großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine gusseiserne Pfanne oder einen Grill sehr stark, bis sie oder er raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Steaks für medium-rare 4-5 Minuten pro Seite scharf an. Passe die Zeit je nach Dicke und gewünschtem Gargrad an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Steaks auf einen Teller und lasse sie 5 Minuten ruhen. Serviere sie anschließend mit reichlich Chimichurri.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
