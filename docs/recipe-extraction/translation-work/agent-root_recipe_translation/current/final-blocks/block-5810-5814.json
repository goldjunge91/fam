      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne und dünste gewürfelte Zwiebel und gehackten Knoblauch etwa 4 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Tomaten, Lorbeerblätter, Salz und Pfeffer dazu. Lasse alles 10 Minuten köcheln, bis die Soße etwas eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Oliven und Kapern ein und probiere die Soße. Schmecke sie bei Bedarf ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Fischfilets nebeneinander in die Soße und bette sie vorsichtig ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf mittlere bis niedrige Stufe und lasse den Fisch zugedeckt 12-15 Minuten köcheln, bis er undurchsichtig ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Fisch und Soße vorsichtig auf eine Servierplatte, ohne die Filets zu zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit frischem Koriander und serviere es sofort mit Limettenspalten und Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
