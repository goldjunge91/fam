          "images": []
        },
        {
          "position": 2,
          "text": "Zubereitung: Whisk together flour, ginger, cinnamon, cloves, baking soda, and salt in separate bowl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zubereitung: Fold dry ingredients into wet ingredients bis just combined; dough will be stiff.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zubereitung: Rolle dough between parchment sheets to ¼-inch thickness; cut into shapes mit kochenie cutters.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zubereitung: Lege on prepared baking sheet 1-inch apart and backen 12-15 Minuten bis set and edges are firm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zubereitung: Cool on baking sheet 5 Minuten, then transfer to wire rack to cool completely.",
          "timerMinutes": null,
