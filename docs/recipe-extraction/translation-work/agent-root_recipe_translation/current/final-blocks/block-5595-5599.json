      "steps": [
        {
          "position": 0,
          "text": "Zubereitung: Lege veal between plastic wrap and pound thin mit a mallet bis about 1/4 inch thick.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zubereitung: Set up three shalniedrig bowls: one mit flour mixed mit salt and pepper, one mit beaten egg, and a plate for breading.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zubereitung: Coat each veal cutlet in flour mixture, then egg, then place on the plate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zubereitung: Hitze olive oil and butter in a large skillet over mittel-hoch Hitze bis butter foams.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zubereitung: Kochen veal cutlets 2-3 Minuten per side bis golden, working in batches if necessary, then transfer to a plate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zubereitung: In the same pan, hinzufügen chicken broth and lemon juice, rührenring to deglaze, then hinzufügen capers.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zubereitung: Köcheln sauce for 2 Minuten, return veal to the pan, and coat mit sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zubereitung: Garnieren mit frisch parsley and servieren immediately.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
