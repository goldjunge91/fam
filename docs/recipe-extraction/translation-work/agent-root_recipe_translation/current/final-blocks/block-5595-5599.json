      "steps": [
        {
          "position": 0,
          "text": "Zubereitung: Schneide bread into circles and fry in 1 Esslöffel butter bis golden, then spread thin layer of pâté on each crouton.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zubereitung: Würze steaks mit salt and pepper, then sear in remaining butter over hoch Hitze for 3-4 Minuten per side for mittel-rare.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zubereitung: Entferne steaks and set aside, then sauté shallots in the pan for 1 minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zubereitung: Deglaze the pan mit red wine, scraping up browned bits, then hinzufügen beef broth and thyme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zubereitung: Reduce sauce over mittel-hoch Hitze for 8-10 Minuten bis it reaches a light glaze consistency.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zubereitung: Gib zurück steaks to pan mit sauce and place pâté Croutons on top of each steak.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zubereitung: Köcheln for 2 Minuten, then transfer to serving plate and spoon sauce around the base.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
