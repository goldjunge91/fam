      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und 2 tablespoons Öl mit warmem Wasser zu einem weichen Teig vermengen und 8 Minuten glatt kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig abgedeckt mit einem feuchten Tuch 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 2 Portionen teilen und jede auf einer geölten Fläche sehr dünn ziehen, dann zu Rechtecken falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Restliches Öl in einer Pfanne bei mittelhoher Hitze erhitzen und jedes Roti 1-2 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit 2 Teebeuteln in 2 cups heißem Wasser 4-5 Minuten starken schwarzen Tee aufbrühen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tee abseihen und Kondensmilch, Milch sowie Zucker in einen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Teemischung vorsichtig erhitzen, aber nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heißen Tee 5-6 Mal rasch zwischen zwei Metallbechern hin- und hergießen, damit Schaum entsteht und er etwas abkühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Teh Tarik sofort mit warmem Roti und Butter zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
