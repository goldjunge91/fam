      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust 15 Minuten in Salzwasser kochen, bis sie gar ist, dann in mundgerechte Stücke zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backofen auf 350°F vorheizen und eine Auflaufform von 9x13 leicht mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Saure Sahne, Hühnercremesuppe, gewürfelte grüne Chilis, gehackten Knoblauch und gehackte Zwiebel in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerpflücktes Hähnchen unter die Sauerrahmmischung rühren und 0.5 cup Hühnerbrühe hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tortillas 30 Sekunden in der Mikrowelle erwärmen, bis sie biegsam sind, dann jede mit Hähnchenmischung füllen und fest aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aufgerollte Enchiladas mit der Naht nach unten in die vorbereitete Auflaufform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Übrige Sauce über die Enchiladas gießen und mit geriebenem Cheddar belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Ohne Abdeckung 30 Minuten backen, bis die Sauce blubbert und der Käse geschmolzen und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
