      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch in einer Pfanne bei mittelhoher Hitze etwa 8 Minuten braten und dabei zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Taco-Gewürz und 0.25 cup Wasser zum Rindfleisch geben und 5 Minuten köcheln lassen, bis die Mischung eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Römersalat in mundgerechte Stücke zupfen und auf Servierschalen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Warmes gewürztes Rindfleisch, Kirschtomaten, Cheddar und schwarze Oliven auf dem Salat anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tortillachips zerdrücken und über jeden Salat streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einer Mischung aus saurer Sahne und Salsa beträufeln, dann frischen Limettensaft darüberpressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Essen vorsichtig vermengen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
