      "steps": [
        {
          "position": 0,
          "text": "Rote Chilis, Schalotten, Knoblauch, Galgant und Ingwer mit 1/3 cup Wasser zu einer sehr glatten Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und die Paste bei mittlerer Hitze 4-5 Minuten anbraten, bis sie duftet und sich das Öl absetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenteile hinzufügen und 5-7 Minuten ständig rühren, bis sie überzogen und teilweise gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch langsam unter Rühren in den Topf gießen, damit keine Klumpen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zitronengras zerdrücken und zusammen mit Salz und braunem Zucker hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Leicht köcheln lassen und ohne Deckel 60-70 Minuten garen; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitergaren, bis die Sauce deutlich eingedickt ist, Öl oben schwimmt und das Hähnchen sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vom Herd nehmen, Zitronengras entfernen und vor dem Servieren mit gedämpftem Reis abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
