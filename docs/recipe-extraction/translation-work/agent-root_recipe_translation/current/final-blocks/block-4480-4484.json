          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Auberginenfruchtfleisch, die Zwiebel und den Knoblauch hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Lammhackfleisch in einer Pfanne anbraten, dann Zwiebel und Knoblauch dazugeben und weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das gehackte Auberginenfruchtfleisch, die Tomatensoße, den Oregano, das Salz und den Pfeffer dazugeben und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Auberginenhälften mit der Fleischmischung füllen und mit zerbröseltem Fetakäse bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "20 Minuten backen, bis die Aubergine weich und die Füllung durchgehend heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
