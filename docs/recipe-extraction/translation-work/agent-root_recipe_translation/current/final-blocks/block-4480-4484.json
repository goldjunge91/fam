      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Erbsen unter kaltem Wasser abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel würfeln und mit Olivenöl in einem großen Topf bei mittlerer Hitze erhitzen, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erbsen und Gemüsebrühe in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 25 Minuten köcheln lassen, bis die Erbsen vollständig weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Suppe mit einem Stabmixer oder einer Küchenmaschine glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zitronensaft, Salz, Pfeffer und Paprika einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Durchwärmen und bei Bedarf nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Als Dip mit Pita-Chips oder Crackern servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
