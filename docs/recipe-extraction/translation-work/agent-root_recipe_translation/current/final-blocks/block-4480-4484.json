      "steps": [
        {
          "position": 0,
          "text": "Das Kalbfleisch in etwa 2 Zoll lange, dünne Streifen schneiden und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Kalbfleischstreifen portionsweise 2-3 Minuten pro Seite anbraten, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die restliche Butter in derselben Pfanne schmelzen und die gehackten Schalotten weich dünsten. Dann die in Scheiben geschnittenen Pilze dazugeben und 4 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Mehl über die Pilze und Schalotten streuen, gut umrühren und 1 Minute zu einer Mehlschwitze kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Weißwein und die Rinderbrühe angießen, dabei die Röststoffe vom Pfannenboden lösen, und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Senf einrühren, das Kalbfleisch zurück in die Pfanne geben, die Hitze reduzieren und 8 Minuten köcheln lassen, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen und die Sahne einrühren. 2 Minuten sanft erhitzen, ohne sie aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und nachwürzen, dann mit frischer Petersilie garnieren und auf Eiernudeln oder Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
