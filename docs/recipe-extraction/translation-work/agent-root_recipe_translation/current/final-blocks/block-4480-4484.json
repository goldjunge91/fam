      "steps": [
        {
          "position": 0,
          "text": "Den Apfel auf der groben Seite einer Küchenreibe raspeln und sofort mit Zitronensaft vermengen, damit er nicht braun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer Schüssel Haferflocken, Milch, Joghurt, Honig und Vanilleextrakt vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den geriebenen Apfel, die Haselnüsse und die Rosinen unterrühren, bis alles gleichmäßig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abdecken und über Nacht oder mindestens 4 Stunden kalt stellen, gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf Schüsseln verteilen und vor dem Servieren bei Bedarf noch Milch für die gewünschte Konsistenz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
