          "position": 0,
          "text": "Den Backofen auf 375°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Auberginen längs halbieren und das Fruchtfleisch herauslösen, dabei eine 1/4-Zoll-dicke Schale stehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Auberginenhälften mit Olivenöl bestreichen, auf ein Backblech legen und 15 Minuten backen.",
