      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie Fleisch in 1-Zoll-Würfel und Kartoffeln in ähnlich große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und das Fleisch portionsweise 4-5 Minuten lang anbraten, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In derselben Pfanne die geschnittenen Zwiebeln 3 Minuten lang anbraten, bis sie weich sind, dann gehackten Knoblauch hinzufügen und 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Fleisch wieder in die Pfanne und fügen Sie Kartoffeln, Salz, Pfeffer und Paprika hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und bei mittlerer Hitze 20-25 Minuten köcheln lassen, dabei gelegentlich umrühren, bis die Kartoffeln zart und das Fleisch gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frische Petersilie und Koriander einrühren und weitere 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß direkt aus der Pfanne servieren oder auf eine Servierplatte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
