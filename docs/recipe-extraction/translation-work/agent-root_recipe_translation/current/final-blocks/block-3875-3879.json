      "steps": [
        {
          "position": 0,
          "text": "Auberginen der Länge nach in 0.25 Zoll dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitzen Sie Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und braten Sie die Auberginenscheiben portionsweise 3-4 Minuten pro Seite, bis sie goldbraun und zart sind, und legen Sie sie dann auf Papiertüchern beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gemahlene Walnüsse, gehackten Knoblauch, Granatapfelmelasse, Koriander, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteilen Sie 2 Esslöffel Walnussfüllung auf der Hautseite jeder Auberginenscheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Scheibe fest aufrollen und mit der Nahtseite nach unten auf einer Servierplatte anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mindestens 30 Minuten im Kühlschrank lagern, damit die Brötchen ihre Form behalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Granatapfelkernen garnieren, bevor es kalt oder bei Zimmertemperatur serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
