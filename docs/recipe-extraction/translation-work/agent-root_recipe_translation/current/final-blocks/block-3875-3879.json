      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser und Hefe in einer kleinen Schüssel vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, dann die Hefemischung hinzufügen und verrühren, bis ein zottiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig auf einer bemehlten Oberfläche 8-10 Minuten lang kneten, bis er glatt und elastisch ist, dann in eine geölte Schüssel geben, abdecken und 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geriebenen Mozzarella und zerbröselten Feta-Käse in einer Schüssel mit 1 EL Butter vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in zwei Hälften teilen und jeweils auf Pergamentpapier eine ovale Form formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteilen Sie die Hälfte der Käsemischung auf jedem Teigoval und lassen Sie auf allen Seiten einen Rand von einen 1-Zoll-Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Falten Sie die Kanten nach oben und drücken Sie sie zusammen, um eine Bootsform mit offenen Enden zu erhalten. Bestreichen Sie dann die Kanten mit der restlichen geschmolzenen Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 450°F 15-18 Minuten backen, bis die Kruste goldbraun ist, dann ein Ei in die Mitte jedes Khachapuri schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Weitere 3-4 Minuten backen, bis das Eiweiß fest ist, das Eigelb aber noch flüssig ist, dann heiß mit einem Stück Butter servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
