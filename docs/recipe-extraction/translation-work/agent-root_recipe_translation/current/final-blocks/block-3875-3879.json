      "steps": [
        {
          "position": 0,
          "text": "Lammfleisch in 1-Zoll-Würfel schneiden und in einen großen Topf mit Wasser, Salz und Pfeffer geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 20 Minuten köcheln lassen, dabei den Schaum von der Oberfläche abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch hinzufügen und weitere 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie frische oder getrocknete Pflaumen, Weißwein und frischen Dill in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 10-15 Minuten köcheln lassen, bis das Lammfleisch zart und die Pflaumen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frischen Koriander einrühren und abschmecken, um die Würze anzupassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in Schüsseln mit reichlich Brühe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
