      "steps": [
        {
          "position": 0,
          "text": "Bringe 5 cups Anchovisbrühe mit Kombu zum Kochen und nimm den Kombu nach 3 Minuten heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Fischfilet ganz oder in großen Stücken in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Suppe sanft 8-10 Minuten köcheln, bis der Fisch gar ist, aber nicht auseinanderfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Doenjang-Paste mit 1/4 cup heißer Brühe in einer kleinen Schüssel und gib die Mischung dann in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib geschnittene Zucchini dazu und lass alles 3 Minuten köcheln, bis sie zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Sojasauce und rote Chiliflocken dazu und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre kurz vor dem Servieren gehackte Frühlingszwiebel und Sesamöl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß in Schalen servieren, dazu gedämpften Reis reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
