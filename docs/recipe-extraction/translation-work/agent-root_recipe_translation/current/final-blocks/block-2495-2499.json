      "steps": [
        {
          "position": 0,
          "text": "Schlage Eier in eine Schüssel und verquirle sie gründlich, bis alles vollständig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Wasser oder Brühe, Sojasauce, Sesamöl, gehackten Knoblauch, Salz und schwarzen Pfeffer zu den Eiern und verquirle alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Seihe die Mischung durch ein feines Sieb in eine hitzebeständige Schüssel, um Blasen zu entfernen und eine seidige Konsistenz zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle einen Topf mit 2 inches Wasser und bringe es zum Kochen. Reduziere die Hitze auf leichtes Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Schüssel mit der Eiermischung in den Topf (Wasserbad) oder dämpfe sie in einem Dämpfeinsatz und decke sie mit Folie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe die Mischung 12-15 Minuten, bis der Eierpudding gestockt, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Schüssel vom Herd und lass sie 1 Minute ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue das Gericht mit gehackten Frühlingszwiebeln und Sesamsamen und träufle etwas zusätzliches Sesamöl darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort mit Reis und Beilagen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
