      "steps": [
        {
          "position": 0,
          "text": "Weiche Reiskuchen 5-10 Minuten in warmem Wasser ein, bis sie leicht weich sind. Gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Gochujang, Gochugaru, Zucker, gehackten Knoblauch und Fischsauce mit Wasser zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne bei mittelhoher Hitze und gieße die Sauce hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die weichen Reiskuchen in die kochende Sauce und rühre häufig um. Gare alles 8-10 Minuten, bis die Reiskuchen gar und die Sauce eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte Frühlingszwiebeln dazu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle das Gericht in eine Servierschüssel und garniere es mit Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren und Gäste darauf hinweisen, dass die Sauce sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
