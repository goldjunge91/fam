      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Rinderrippchen 5 Minuten in kochendem Wasser, um Unreinheiten zu entfernen. Gieße sie ab und spüle sie gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Rippchen, Wasser, Sojasauce, gehackten Knoblauch, Ingwer und die Hälfte des Zuckers in einem großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze auf niedrig und lass es zugedeckt 40 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Karotten und Kartoffeln in gleichmäßige Stücke und gib sie mit dem restlichen Zucker und Sesamöl in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass alles weitere 20 Minuten köcheln, bis das Gemüse vollständig gar und zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und passe bei Bedarf die Sojasauce an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle das Gericht auf eine Servierplatte und garniere es mit gehackten Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in einzelnen Schalen mit Fleisch und Gemüsebrühe servieren.",
          "timerMinutes": null,
