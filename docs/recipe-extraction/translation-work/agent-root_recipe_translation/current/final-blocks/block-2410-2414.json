      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittelhoher Hitze erhitzen und Flanksteak auf jeder Seite 3 Minuten anbraten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleisch herausnehmen und beiseitestellen. Gehackten Knoblauch und gewürfelte Zwiebel im selben Topf 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kreuzkümmel, Oregano und Lorbeerblätter dazugeben und 1 Minute rösten, damit die Gewürze ihr Aroma entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe und Tomatensauce angießen und gut umrühren. Rindfleisch zurück in den Topf legen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren, abdecken und 1.5 Stunden köcheln lassen, bis das Rindfleisch sehr zart ist und sich leicht mit einer Gabel zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rindfleisch aus dem Topf nehmen und mit zwei Gabeln in dünne Streifen zerteilen. Fett entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Paprika in dünne Streifen schneiden und zusammen mit dem zerteilten Rindfleisch in den Topf geben. Weitere 10 Minuten köcheln lassen, bis die Paprika weich, aber noch bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frischen Limettensaft darüberpressen, Salz und Pfeffer abschmecken und bei Bedarf anpassen, dann servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
