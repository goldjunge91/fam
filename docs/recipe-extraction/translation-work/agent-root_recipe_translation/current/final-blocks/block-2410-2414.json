      "steps": [
        {
          "position": 0,
          "text": "Pflanzenöl in einer Pfanne bei mittelhoher Hitze erhitzen. Jede Maistortilla auf jeder Seite 30 Sekunden knusprig und goldbraun frittieren und dann auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In derselben Pfanne (ohne zusätzliches Öl) Rinderhackfleisch bei mittlerer Hitze etwa 5 Minuten anbraten und dabei zerteilen, bis kein Rosa mehr zu sehen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Taco-Gewürz und 1/4 Tasse Wasser zum gegarten Rindfleisch geben, gut verrühren und 2 Minuten köcheln lassen, bis die Sauce eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bohnenmus in einem kleinen Topf bei niedriger Hitze erwärmen und gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine dünne Schicht warmes Bohnenmus auf jede knusprige Tortilla streichen und mit gewürztem Rinderhack belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Tostada mit Salat, gewürfelter Tomate und geriebenem Käse belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit saurer Sahne und Salsa als Beilage servieren, damit jede Person nach Geschmack belegen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
