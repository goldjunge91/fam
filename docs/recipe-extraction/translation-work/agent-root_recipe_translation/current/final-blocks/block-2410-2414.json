      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittelhoher Hitze erhitzen. Hähnchenoberkeulen mit Salz und Pfeffer würzen und mit der Hautseite nach unten 5 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen wenden und weitere 3 Minuten garen. Herausnehmen und auf einem Teller beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel und Paprika im selben Topf 3 Minuten weich dünsten. Gehackten Knoblauch und Kreuzkümmel dazugeben und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis in den Topf geben und 2 Minuten ständig rühren, sodass er mit Öl überzogen ist. Hühnerbrühe und Tomatensauce angießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Safranfäden einrühren und Hähnchenoberkeulen mit der Hautseite nach oben zurück in den Topf legen. Zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze reduzieren, abdecken und 25–30 Minuten köcheln lassen, bis der Reis weich und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tiefgekühlte Erbsen einrühren, wieder abdecken und vor dem Auflockern mit einer Gabel und Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
