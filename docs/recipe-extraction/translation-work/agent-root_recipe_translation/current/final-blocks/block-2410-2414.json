      "steps": [
        {
          "position": 0,
          "text": "Zerteiltes Hähnchen mit Bohnenmus, gewürfelter Zwiebel, 1/2 Tasse Käse, Salz und schwarzem Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehltortillas 20 Sekunden pro Seite in einer trockenen Pfanne erwärmen, damit sie biegsam und leichter zu rollen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Etwa 3 Esslöffel Füllung in die Mitte jeder Tortilla geben und fest aufrollen, die Seiten dabei einschlagen. Mit der Naht nach unten auf einen Teller legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pflanzenöl in einer tiefen Pfanne auf 350°F erhitzen (ein Stück Tortilla sollte sofort brutzeln, wenn es hineingegeben wird).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Flautas vorsichtig mit der Naht nach unten in das heiße Öl legen und 2–3 Minuten goldbraun frittieren. Wenden und die andere Seite weitere 2 Minuten knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Flautas mit einer Schaumkelle herausnehmen, auf Küchenpapier abtropfen lassen und noch heiß mit übrigem Käse bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Flautas mit saurer Sahne belegt und Salsa als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
