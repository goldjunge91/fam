      "steps": [
        {
          "position": 0,
          "text": "Brate die fein gehackten Zwiebeln und das Hackfleisch in Öl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Salz und Pfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fette ein rundes Backblech ein und lege eine Schicht Teig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile eine dünne Schicht Füllung darauf und bedecke sie mit einer weiteren Filoteigschicht, die gut mit Öl bestrichen sein muss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib eine weitere Schicht Füllung darauf und bedecke sie mit Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wenn du fünf oder sechs Schichten hast, bedecke alles mit Filoteig. Backe den Burek eine halbe Stunde bei 200 °C/392 °F, schneide ihn in Viertel und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
