      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in 1/4 Zoll dicke Stifte schneiden und 10 Minuten in kaltem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem hohen Topf auf 350°F erhitzen und die Kartoffeln portionsweise etwa 8-10 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pommes auf Küchenpapier abtropfen lassen und mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderhackfleisch in einer Pfanne bei mittlerer bis hoher Hitze anbraten und beim Garen zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bratensoße nach Packungsanleitung zubereiten und das gegarte Rinderhackfleisch unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pommes auf zwei Schalen verteilen und mit Käsebruch belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiße Bratensoße über Pommes und Käse gießen, sodass der Käse leicht schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
