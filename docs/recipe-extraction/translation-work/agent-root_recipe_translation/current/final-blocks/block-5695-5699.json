      "steps": [
        {
          "position": 0,
          "text": "Den Thunfisch 5 Minuten vor dem Servieren aus dem Kühlschrank nehmen, damit er die richtige Temperatur erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein sehr scharfes, in heißes Wasser getauchtes und zwischen den Schnitten trocken gewischtes Messer verwenden. Den Thunfisch quer zur Faser in 1/4 Zoll dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Thunfischscheiben leicht überlappend auf einem gekühlten Teller anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sojasauce und Wasabi in einer kleinen Schüssel zu einer Dip-Sauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teller mit eingelegtem Ingwer, Sesam und Frühlingszwiebel garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort mit der Sojasaucenmischung servieren. Zwischen den Bissen etwas eingelegten Ingwer genießen.",
