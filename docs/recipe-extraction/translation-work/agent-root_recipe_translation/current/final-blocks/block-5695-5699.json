      "steps": [
        {
          "position": 0,
          "text": "Flankensteak quer zur Faser in dünne Scheiben schneiden und mit 1 Esslöffel Speisestärke sowie Salz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 Esslöffel Pflanzenöl in einer großen Pfanne oder einem Wok bei hoher Hitze erhitzen. Fleisch portionsweise etwa 2–3 Minuten pro Portion anbraten und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Übriges Öl in die Pfanne geben und Brokkoliröschen 3–4 Minuten pfannenrühren, bis sie leuchtend grün und bissfest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fleisch zurück in die Pfanne geben. Gehackten Knoblauch und Ingwer hinzufügen und 30 Sekunden rühren, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sojasauce, braunen Zucker, Wasser und restliche Speisestärke in einer Schüssel verrühren, in die Pfanne gießen und etwa 2 Minuten ständig rühren, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Sesamöl beträufeln, vermengen und auf gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
