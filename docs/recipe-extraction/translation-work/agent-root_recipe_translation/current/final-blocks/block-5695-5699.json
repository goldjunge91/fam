      "steps": [
        {
          "position": 0,
          "text": "Das Hähnchen in mundgerechte Stücke schneiden und mit 2 gehackten Knoblauchzehen, der Hälfte des Ingwers, 1/2 Teelöffel Garam Masala und Joghurt vermengen. 15–30 Minuten marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen. Hähnchen portionsweise etwa 4 Minuten goldbraun braten und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Topf gewürfelte Zwiebel etwa 4 Minuten weich dünsten. Restlichen Knoblauch und Ingwer hinzufügen und 1 Minute braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprika und Kreuzkümmel einrühren und 30 Sekunden anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatensauce zugießen und aufköcheln lassen, dann das Hähnchen zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze auf mittlere bis niedrige Stufe reduzieren und ohne Deckel 15 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sahne und restliches Garam Masala einrühren und weitere 5 Minuten köcheln lassen, ohne die Sauce aufzukochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken, mit frischem Koriander garnieren und mit Basmatireis oder Naan servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
