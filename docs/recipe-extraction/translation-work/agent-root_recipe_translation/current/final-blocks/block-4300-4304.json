      "steps": [
        {
          "position": 0,
          "text": "Speck in einer Pfanne knusprig braten, herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In derselben Pfanne Spiegeleier braten und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rindersteak trocken tupfen und großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Steak in der heißen Pfanne pro Seite 3–4 Minuten braten, bis es innen rosa ist, und anschließend dünn aufschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brötchen halbieren und nach Wunsch leicht toasten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beide Innenseiten jedes Brötchens mit Mayonnaise bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Käse, Steak, Tomate, Salat, Speck und Spiegelei auf jedem Sandwich schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
