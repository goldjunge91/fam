      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen, kalte Butter einarbeiten, bis die Mischung krümelig ist, dann Wasser hinzufügen und zu einem glatten Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig in Frischhaltefolie wickeln und 30 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Währenddessen gewürfelte Zwiebel und Knoblauch in Öl weich dünsten. Rinderhackfleisch hinzufügen und braten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kreuzkümmel, Salz und Pfeffer einrühren, vom Herd nehmen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hart gekochte Eier und Oliven hacken und unter die Rindfleischmischung heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teig dünn ausrollen und 12 Kreise mit einem 3 Zoll großen Ausstecher ausstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jeweils einen Löffel Füllung auf einen Kreis geben, halbieren und die Ränder mit einer Gabel verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf ein gefettetes Backblech legen, mit Eigelb bestreichen und bei 400 °F 25–30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
