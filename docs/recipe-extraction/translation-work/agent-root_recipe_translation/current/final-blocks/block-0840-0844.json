      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor. Koche den Naturreis nach Packungsanleitung oder verwende einen Reiskocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Süßkartoffeln und teile den Brokkoli in Röschen. Vermenge beides mit 1 tbsp Olivenöl, Salz und geräuchertem Paprikapulver auf einem großen Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Hähnchenbrüste mit Knoblauchpulver, italienischen Kräutern, dem restlichen Olivenöl, Salz und Pfeffer. Lege sie auf ein separates Blech oder auf die andere Hälfte desselben Blechs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste alles 25–30 Minuten, bis das Hähnchen vollständig gar und das Gemüse karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide das Hähnchen auf und verteile alles gleichmäßig auf 5 Meal-Prep-Behälter mit Reis. Bis zu 5 Tage im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
