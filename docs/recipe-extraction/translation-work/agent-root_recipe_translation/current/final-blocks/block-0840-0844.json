      "steps": [
        {
          "position": 0,
          "text": "Koche den Naturreis, am einfachsten im Reiskocher. Würze 2 lbs Putenhack mit italienischen Kräutern, Paprikapulver und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune das Putenhack 8 Minuten in Olivenöl bei mittelhoher Hitze und zerteile es dabei. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste in derselben Pfanne gewürfelte Zwiebel 4 Minuten an. Gib Knoblauch und gewürfelte Zucchini dazu und gare alles weitere 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile Reis, Putenhack und Gemüse gleichmäßig auf 5 Behälter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ergänze jeden Tag eine Sauce deiner Wahl, zum Beispiel Salsa, scharfe Sauce, Sriracha oder einfache Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
