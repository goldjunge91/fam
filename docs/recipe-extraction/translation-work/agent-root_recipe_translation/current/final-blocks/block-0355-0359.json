    {
      "externalId": "waivy:she-creamy-lemon-pepper-chicken",
      "slug": "she-creamy-lemon-pepper-chicken",
      "title": "Cremiges Zitronen-Pfeffer-Hähnchen",
      "instructions": "Goldbraune, in der Pfanne gebratene Hähnchensteaks in einer seidigen Zitronen-Pfeffer-Sahnesoße mit Parmesan, Dijon-Senf und Knoblauch: frisch, würzig und in 20 Minuten fertig. Rezept von Simple Home Edit: https://simplehomeedit.com/recipe/creamy-lemon-pepper-chicken/",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Ersetze Hähnchenbrust durch Oberkeulen. Sie kosten pro Portion weniger und bleiben in der Sahnesoße saftiger.",
        "Verwende Zitronensaft aus der Flasche und lass die frische Zitronenschale weg, um etwas zu sparen. Eine frische Zitrone sorgt dennoch für viel Aroma und kostet nur wenige Cent.",
        "Serviere Reis statt Kartoffelstampf dazu. So reicht die reichhaltige Soße für vier Portionen, ohne dass es viel kostet."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-breast",
          "swap": "Hähnchenoberkeulen",
          "savings": "ca. $0.20/Portion und harder to overcook"
        },
        {
          "forIngredientId": "heavy-cream",
          "swap": "Doppelrahm oder leichte Sahne für eine leichtere Soße",
          "savings": "light-cream trims richness; double-cream is mehr decadent"
        },
        {
          "forIngredientId": "grated-parmesan",
          "swap": "Geriebener Parmesan",
          "savings": "verwenden Vorhundenes vorrätig"
        }
      ],
