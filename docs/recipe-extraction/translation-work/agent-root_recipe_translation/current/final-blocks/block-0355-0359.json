      "steps": [
        {
          "position": 0,
          "text": "Koche die Fettuccine nach Packungsanleitung, aber 1-2 Minuten kürzer, damit sie bissfest bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze in der Zwischenzeit das Olivenöl in einer großen, tiefen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Speck dazu und brate ihn unter Rühren 2-3 Minuten, bis er langsam bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die rote Zwiebel dazu und gare sie 1-2 Minuten. Füge dann die Pilze hinzu und brate sie 4-5 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Knoblauch und Thymian dazu und brate alles unter Rühren 30 Sekunden, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Hühnerbrühe dazu, löse die anhaftenden Röststoffe vom Pfannenboden und koche alles 1-2 Minuten, bis der Großteil der Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Sahne und Parmesan dazu, lass die Soße aufkochen und gare sie 2-3 Minuten, bis sie eindickt. Schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Pasta ab und spüle sie mit kaltem Wasser, damit sie nicht weitergart oder zusammenklebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Entferne die Thymianzweige. Gib dann die Pasta zur Soße und schwenke sie mit einer Zange 1 Minute, bis sie gerade durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere das Gericht mit zusätzlichem Parmesan, frisch gemahlenem schwarzem Pfeffer und frischen Thymianblättern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
