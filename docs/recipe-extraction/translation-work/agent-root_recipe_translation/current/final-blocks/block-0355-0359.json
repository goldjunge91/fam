      "steps": [
        {
          "position": 0,
          "text": "Würze die Hähnchensteaks rundherum mit Salz, 1 TL schwarzem Pfeffer und edelsüßem Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile das Mehl auf einem Teller und drücke die Hähnchensteaks hinein, bis alle Seiten gleichmäßig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl und 1 EL Butter in einer großen, tiefen, schweren Pfanne bei mittlerer bis hoher Hitze. Gib das Hähnchen dazu und brate es unter einmaligem Wenden 5-6 Minuten, bis es gerade gar ist. Lege es auf einem Teller beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lösche die Pfanne mit Wasser ab oder wische sie sauber. Gib die übrige 1 EL Butter und den Knoblauch dazu und brate alles unter Rühren 30-60 Sekunden, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Hühnerbrühe dazu und koche sie 1-2 Minuten, bis sie um die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf mittlere bis niedrige Stufe. Gib Sahne, Dijon-Senf, Zitronensaft, Zitronenschale und 1 TL schwarzen Pfeffer dazu. Lass die Soße 2-3 Minuten köcheln, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre den Parmesan ein und schmecke mit Salz ab. Gib das Hähnchen und den ausgetretenen Fleischsaft zurück in die Pfanne und lass alles 2-3 Minuten köcheln, bis es heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Hähnchen auf Reis oder Kartoffelstampf mit gedämpften grünen Bohnen, Zitronenscheiben, etwas frisch gemahlenem Pfeffer und nach Wunsch Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
