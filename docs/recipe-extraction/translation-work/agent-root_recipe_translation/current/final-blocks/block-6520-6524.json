      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Kutteln 20 Minuten in kochendem Salzwasser, um den Geruch zu entfernen. Gieße sie ab und spüle sie gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und brate Zwiebel, Karotten, Sellerie und Knoblauch 8 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Kutteln dazu und gare sie unter gelegentlichem Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark und Paprikapulver ein und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Rinderbrühe dazu, gib Lorbeerblätter und Thymian hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke den Topf ab und lass die Kutteln 90 Minuten köcheln, bis sie sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd und lass die Suppe etwas abkühlen. Rühre dann vorsichtig saure Sahne ein, bis sie vollständig vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre Essig für den typischen säuerlichen Geschmack ein, würze mit Salz und Pfeffer und serviere die Suppe heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
