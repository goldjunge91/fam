      "steps": [
        {
          "position": 0,
          "text": "Milch auf 110 °F erwärmen und Hefe darin auflösen, dann 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker schaumig rühren, dann Eier und Vanilleextrakt unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl und Salz vermischen, dann abwechselnd Mehlmischung und Hefemischung zur Buttermischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig 8 Minuten lang kneten, bis er glatt ist, dann in eine geölte Schüssel geben und 1 Stunde gehen lassen, bis sich der Teig verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig ausstanzen und auf Backpapier zu einem Ring formen, dann weitere 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heizen Sie den Ofen auf 350 °F vor und backen Sie den Ring 25 Minuten lang, bis er goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Puderzucker mit Wasser zu einer Glasur vermischen und über den abgekühlten Kuchen träufeln, dann mit Streuseln bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
