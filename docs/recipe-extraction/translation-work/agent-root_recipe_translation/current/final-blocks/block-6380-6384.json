      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf Salzwasser zum Kochen bringen und die Umbricelli darin etwa 10–12 Minuten al dente kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während die Nudeln kochen, erwärmen Sie das Olivenöl in einer großen Pfanne bei schwacher Hitze und fügen Sie dünn geschnittenen Knoblauch hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch 2 Minuten lang leicht anbraten, bis er duftet, aber nicht gebräunt ist, dann den Herd ausschalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Nudeln abtropfen lassen, dabei 1 Tasse Kochwasser auffangen und die Nudeln zum Knoblauchöl geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trüffelöl oder fein geraspelten Trüffel hinzufügen und bei schwacher Hitze vorsichtig umrühren, dabei nach und nach Nudelwasser hinzufügen, um eine leichte Soße zu erhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und Butter und geriebenen Parmesan unterrühren, bis eine cremige Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit schwarzem Pfeffer würzen und sofort in warmen Schüsseln mit etwas Parmesan als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
