      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 325 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mandeln und kandierte Orangenschale in kleine Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Honig und Butter zusammen in einem Topf erwärmen, bis sie geschmolzen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl, Backpulver, Salz, Pfeffer und Zimt in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Honigmischung unter die Mehlmischung rühren, dann Mandeln und kandierte Orangenschale unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Masse auf dem Backblech verteilen und 25 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vollständig abkühlen lassen, dann in unregelmäßige Stücke brechen und mit Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
