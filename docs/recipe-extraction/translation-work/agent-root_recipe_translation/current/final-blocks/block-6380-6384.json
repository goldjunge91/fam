      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer großen Pfanne erhitzen und gewürfelte Zwiebeln und gehackten Knoblauch anbraten, bis ein angenehmer Duft entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Auberginen und Zucchini dazugeben und unter gelegentlichem Rühren 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Paprika unterrühren und weitere 5 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenwürfel samt Saft hinzufügen und mit Salz, Pfeffer und Kräutern würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und lassen Sie es ohne Deckel 15–20 Minuten unter leichtem Rühren köcheln, bis das Gemüse zart ist und sich die Aromen vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nachwürzen und heiß oder bei Zimmertemperatur als Hauptgericht oder Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
