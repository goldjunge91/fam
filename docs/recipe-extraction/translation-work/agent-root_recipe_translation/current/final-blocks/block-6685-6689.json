      "steps": [
        {
          "position": 0,
          "text": "Yuca schälen und in 3 Zoll große Stücke schneiden. Dabei den holzigen Kern entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Yuca in Salzwasser 20 Minuten kochen, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Während Yuca kocht, vermengen Sie geraspelten Kohl, gewürfelte Tomaten und geschnittene Zwiebeln in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Limettensaft, Olivenöl, gewürfelte Jalapeños, Salz und Pfeffer zur Kohlmischung hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lassen Sie den Krautsalat 5 Minuten ruhen, damit sich die Aromen vermischen können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gekochte Yuca abgießen und auf einem Bananenblatt anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Yuca mit der Krautsalatmischung belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Das Bananenblatt um die Zutaten falten und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
