      "steps": [
        {
          "position": 0,
          "text": "Guajillo-Chilis 10 Minuten in heißem Wasser einweichen und anschließend mit 1/4 Tasse Wasser pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch in einem großen Topf anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch im selben Topf anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatensauce und Chilipaste hinzufügen und unter Rühren 3 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Fleisch wieder in den Topf geben, Brühe hinzufügen und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tortillas in Streifen reißen und unter Rühren in den Topf geben, damit sie zerkleinert werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 10 Minuten köcheln lassen, bis der Eintopf eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Eier verquirlen. Den Topf vom Herd nehmen und die Eier langsam unter die heiße Mischung rühren. Dann Koriander hinzufügen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
