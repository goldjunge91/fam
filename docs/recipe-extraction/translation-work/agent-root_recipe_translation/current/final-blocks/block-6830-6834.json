      ],
      "steps": [
        {
          "position": 0,
          "text": "Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen und jede Tortilla kurz erwärmen, bis sie geschmeidig ist, etwa 15 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Falten Sie jede Tortilla in zwei Hälften und braten Sie sie in heißem Öl, bis sie knusprig und goldbraun ist, etwa 1 Minute pro Seite, und lassen Sie sie dann auf Papiertüchern abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch in derselben Pfanne anbraten und mit einem Löffel etwa 5 Minuten lang zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Taco-Gewürz und Wasser zum Rindfleisch geben, gut umrühren und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füllen Sie jede knusprige Taco-Schale mit gewürztem Rindfleisch und belegen Sie sie dann mit Käse, Salat und Tomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warm mit saurer Sahne als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
