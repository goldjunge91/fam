      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz in einer Schüssel vermischen, dann warmes Wasser hinzufügen und verrühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig auf einer bemehlten Arbeitsfläche 2 Minuten lang kneten, bis er glatt ist, dann 10 Minuten mit einem feuchten Tuch abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rollen Sie den Teig auf eine Dicke von 1/8 mm aus und schneiden Sie ihn mit einem Messer in 3 cm große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer tiefen Pfanne auf 375 °F erhitzen und die Teigquadrate vorsichtig etwa 1 Minute pro Seite braten, bis sie goldbraun und aufgebläht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gebratene Sopapillen auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zimt und Zucker in einer flachen Schüssel vermischen und mit den warmen Sopapillen leicht bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm servieren und zum Dippen mit Honig beträufeln oder als Beilage dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
