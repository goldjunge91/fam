      "steps": [
        {
          "position": 0,
          "text": "Gurken gründlich waschen und die Blütenenden abschneiden, damit sie nicht matschig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Packen Sie die Gurken aufrecht in ein sauberes Quartglas mit Dill, Knoblauch und Pfefferkörnern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wasser, Essig, Salz und rote Pfefferflocken in einen Topf geben und unter Rühren zum Kochen bringen, bis sich das Salz auflöst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie die heiße Salzlösung über die Gurken im Glas, bis sie vollständig bedeckt sind, und lassen Sie dabei einen Freiraum von 1/2 cm frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Locker abdecken und auf Zimmertemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vor dem Verzehr mindestens 3 Stunden im Kühlschrank lagern; sie sind 2-3 Wochen haltbar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
