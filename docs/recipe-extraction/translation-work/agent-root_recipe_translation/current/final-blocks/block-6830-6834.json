      "steps": [
        {
          "position": 0,
          "text": "Mehl, 1 Ei, Öl, Salz und 1/2 Tasse Wasser zu einem weichen Teig vermischen, dann glatt kneten und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln schälen und hacken, dann etwa 12 Minuten kochen, bis sie weich sind, und gut abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel würfeln und in Butter etwa 5 Minuten goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heiße Kartoffeln mit der gekochten Zwiebel, Butter, Salz und Pfeffer zerstampfen, bis eine glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie den Teig dünn zwischen Backpapier aus und verteilen Sie dann die Kartoffelfüllung gleichmäßig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rollen Sie den Teig fest zu einer Rolle, wickeln Sie ihn auf und legen Sie ihn dann mit der Nahtseite nach unten auf ein gefettetes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit geschlagenem Ei bestreichen und bei 375 °C etwa 25–30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Etwas abkühlen lassen, dann in Scheiben schneiden und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
