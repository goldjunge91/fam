      "steps": [
        {
          "position": 0,
          "text": "Verquirle Joghurt und Kichererbsenmehl in einer Schüssel glatt. Gib 4 Tassen Wasser dazu und verrühre alles erneut, damit keine Klumpen bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne und gib die Senfsamen dazu. Lasse sie etwa 1 Minute aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Bockshornkleesamen und getrocknete rote Chilis dazu und gare sie 30 Sekunden, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackte Zwiebel und Ingwer in die Pfanne und dünste sie 3-4 Minuten, bis die Zwiebel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Joghurt-Kichererbsenmehl-Mischung langsam unter ständigem Rühren in die Pfanne, damit sich keine Klumpen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kurkumapulver und Salz hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe das Kadhi zum Kochen, reduziere die Hitze auf mittlere bis niedrige Stufe und lasse es 15-20 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Das Kadhi sollte leicht eindicken und eine blassgelbe Farbe annehmen. Serviere es heiß und mit frischem Koriander garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
