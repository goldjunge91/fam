      "steps": [
        {
          "position": 0,
          "text": "Röste Koriandersamen, Kreuzkümmelsamen, getrocknete Chilis und Pfefferkörner 2 Minuten in einer Pfanne, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere die gerösteten Gewürze mit geriebener Kokosnuss und 1/4 Tasse Wasser in einer Küchenmaschine oder einem Mixer zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und brate geschnittene Zwiebeln etwa 8 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und gare alles 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Fleischwürfel hinzu und gare sie bei mittlerer bis hoher Hitze 5 Minuten unter gelegentlichem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die gemahlene Gewürzpaste dazu und brate sie unter ständigem Rühren 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Kokosmilch dazu, gib Salz und Curryblätter hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse das Curry 35-40 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schmecke mit Salz ab und serviere das Curry heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
