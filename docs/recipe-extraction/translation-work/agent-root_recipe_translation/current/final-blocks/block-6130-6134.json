      "steps": [
        {
          "position": 0,
          "text": "Spüle die Mungbohnen ab und koche sie 20-25 Minuten in Wasser, bis sie sehr weich sind. Gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerdrücke die gegarten Mungbohnen glatt und vermische sie mit Zucker, geschmolzener Butter, Mehl und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öle ein Backblech leicht ein und verteile die Mungbohnenmischung gleichmäßig etwa 1/2-inch dick darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Streue Sesamsamen darüber und drücke sie leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Kuchen bei 350°F 15-18 Minuten, bis er goldbraun und an den Rändern leicht knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse ihn 10 Minuten abkühlen und schneide ihn dann mit einem geölten Messer in Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere ihn bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
