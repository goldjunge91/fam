      "steps": [
        {
          "position": 0,
          "text": "Wenn du getrocknete Erbsen verwendest, weiche sie über Nacht ein und koche sie weich. Gieße sie ab. Du kannst stattdessen auch abgetropfte und abgespülte weiße Erbsen aus der Dose verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne und gib die Kreuzkümmelsamen dazu. Lasse sie 30 Sekunden knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel dazu und gare sie 2-3 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Tomate und gehackte grüne Chili hinzu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Kurkumapulver und rotes Chilipulver ein und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gegarte Erbsen dazu und rühre vorsichtig um, damit sich alle Zutaten verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles bei mittlerer Hitze 3-4 Minuten und rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Zitronensaft und Salz nach Geschmack dazu, garniere das Gericht mit frischem Koriander und serviere es warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
