          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Melt butter in a skillet und sauté Zwiebel bis softened, about 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib mushrooms und Koche bis liquid evaporates, about 5 Minuten, then let cool slightly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Whisk together eggs, heavy cream, Salz, Pfeffer, nutmeg, und thyme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Spread cooled mushroom mixture on pie crust und sprinkle gruyere cheese evenly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pour egg mixture over mushrooms und cheese.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
