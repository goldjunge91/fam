      "steps": [
        {
          "position": 0,
          "text": "Schneide Rindfleisch in 1 Zoll große Würfel und erhitze Öl in einem großen Topf bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune das Fleisch etwa 8 Minuten von allen Seiten, nimm es dann heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste im selben Topf gewürfelte Zwiebel etwa 5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch und Tomatenmark hinzu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Fleisch zurück in den Topf, füge Paprikapulver, Lorbeerblatt, Salz und Pfeffer hinzu und gieße Brühe an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze, decke den Topf ab und lasse es 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide Kartoffeln in große Stücke und gib sie in den Topf. Lasse alles 25 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
