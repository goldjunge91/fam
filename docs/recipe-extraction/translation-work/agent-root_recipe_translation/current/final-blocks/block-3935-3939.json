      "steps": [
        {
          "position": 0,
          "text": "Erhitze einen großen Topf bei mittelhoher Hitze und bräune das Rindfleisch insgesamt etwa 8 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebeln, Karotten und Sellerie hinzu und gare alles etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark und gehackten Knoblauch ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe an, gib Lorbeerblätter hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze und lasse die Suppe 45 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide Kartoffeln in Stücke und gib sie in den Topf. Lasse alles 20 Minuten köcheln, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vom Herd, rühre kurz vor dem Servieren Essig oder saure Sahne ein und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
