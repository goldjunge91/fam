      "steps": [
        {
          "position": 0,
          "text": "Säubere die Lebern unter kaltem Wasser und entferne grüne Gallenflecken und Häutchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Zwiebeln und Äpfel fein und dünste sie etwa 10 Minuten in Butter bei mittlerer Hitze karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhöhe die Hitze auf mittelhoch, gib Lebern hinzu und bräune sie rundherum 6-8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Brandy über die Lebern und flambiere sie vorsichtig. Lasse die Flammen 1 Minute abklingen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Sahne, Salz, Pfeffer, Thymian und gehackten Knoblauch hinzu und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Mischung in einen Mixer und püriere sie vollständig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streiche die Masse für eine besonders feine Konsistenz durch ein feines Sieb, kühle sie 2 Stunden und serviere sie auf geröstetem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
