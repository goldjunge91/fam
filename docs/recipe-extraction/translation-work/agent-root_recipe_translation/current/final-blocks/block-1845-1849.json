      "steps": [
        {
          "position": 0,
          "text": "Gib Corned Beef in einen großen Topf oder Dutch Oven und bedecke es mit Wasser. Füge das Gewürzpäckchen vom Corned Beef hinzu. Decke den Topf ab und bringe alles zum Kochen, reduziere dann die Hitze und lass es sanft köcheln. Gare etwa 50 Minuten pro pound oder bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib ganze Kartoffeln und geschälte, geschnittene Karotten dazu und gare sie, bis das Gemüse fast weich ist. Füge Kohl hinzu und gare weitere 15 Minuten. Nimm das Fleisch heraus und lass es 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Gemüse in eine Schüssel und decke es ab. Gib nach Wunsch etwas Kochbrühe dazu. Schneide das Fleisch quer zur Faser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
