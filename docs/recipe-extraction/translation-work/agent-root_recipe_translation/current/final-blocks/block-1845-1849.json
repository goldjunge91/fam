      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln dünsten:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer großen Pfanne, am besten aus Gusseisen, bei mittlerer Hitze. Gib die Zwiebel dazu und gare sie einige Minuten, bis sie glasig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln und Corned Beef hinzufügen:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gehacktes Corned Beef und Kartoffeln unter. Verteile alles gleichmäßig in der Pfanne. Erhöhe die Hitze auf hoch oder mittelhoch und drücke die Mischung mit einem Metallwender an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bräunen lassen und wenden:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Kartoffeln und Corned Beef nicht um, sondern lass sie bräunen. Wenn du sie brutzeln hörst, ist das gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heb mit einem Metallwender eine Stelle an und prüfe, ob sie gebräunt ist. Wenn ja, wende portionsweise, damit auch die andere Seite bräunt. Drücke die Mischung erneut mit dem Wender an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenn etwas zu stark ansetzt, gib etwas Butter in die Pfanne. Gare auf diese Weise weiter, bis Kartoffeln und Corned Beef schön gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Petersilie einrühren und würzen:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Nimm die Pfanne vom Herd und rühre gehackte Petersilie ein. Gib reichlich frisch gemahlenen schwarzen Pfeffer dazu und salze nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
