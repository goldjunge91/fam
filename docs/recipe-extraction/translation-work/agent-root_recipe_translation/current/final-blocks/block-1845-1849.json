      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer Pfanne oder einem Dutch Pot bei mittlerer bis hoher Hitze. Gib Zwiebel und grüne Paprika dazu und dünste sie etwa 3-5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch dazu und rühre etwa 1 Minute um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den zerkleinerten Kohl dazu und rühre um. Gare ihn etwa 3-5 Minuten unter häufigem Rühren, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Corned Beef, Roma-Tomaten und Thymian dazu und rühre um. Füge Ketchup und Scotch-Bonnet-Chilisauce hinzu. Reduziere die Hitze auf mittel und gare alles etwa 3-5 Minuten, bis das Corned Beef heiß ist. Nimm die Pfanne vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit weißem Reis oder Brot servieren oder pur genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
