      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen gusseisernen oder beschichteten Pfanne mit Deckel bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel dazugeben und 2-3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Paprika und Knoblauch dazugeben und weitere 3-5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomaten, Kreuzkümmel, Paprikapulver, Salz und Chilipulver hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gut vermengen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze auf mittelniedrige Stufe reduzieren und ohne Deckel 10-15 Minuten köcheln lassen, bis die Mischung die gewünschte Dicke erreicht. Sauce abschmecken und nach Belieben würzen. Mit dem Löffelrücken vier Mulden formen, die groß genug für je ein Ei sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In jede Mulde ein Ei aufschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Pfanne abdecken und 5-7 Minuten köcheln lassen, bis die Eier gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort mit knusprigem Brot oder Pita servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
