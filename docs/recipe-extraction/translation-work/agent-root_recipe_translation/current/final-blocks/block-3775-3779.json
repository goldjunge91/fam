        {
          "position": 0,
          "text": "Säubere Kutteln gründlich, koche sie 1 Stunde weich und schneide sie dann in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche getrocknete rote Paprika 10 Minuten in heißem Wasser ein, entferne die Kerne und püriere sie zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl und dünste gewürfelte Zwiebel und Knoblauch weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geschnittene Chorizo hinzu und gare sie 3 Minuten, damit Fett austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Paprikapulver und Paprikapaste ein und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gegarte Kutteln, Weißwein und Rinderbrühe hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche alles 30 Minuten, gib dann Morcilla-Stücke hinzu und lasse es weitere 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer und serviere das Gericht heiß in Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
