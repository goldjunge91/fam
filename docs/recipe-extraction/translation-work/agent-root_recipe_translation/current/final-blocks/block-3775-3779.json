          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Weißwein und Gemüsebrühe hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Fischfilets vorsichtig mit der Hautseite nach unten in die Brühe und gare sie 6-8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochte Kartoffeln und Erbsen hinzu und rühre vorsichtig, damit der Fisch nicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer und gare alles weitere 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Gericht auf Servierteller und garniere es mit frischer Petersilie.",
          "timerMinutes": null,
