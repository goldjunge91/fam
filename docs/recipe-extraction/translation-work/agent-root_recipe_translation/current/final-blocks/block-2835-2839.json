      "steps": [
        {
          "position": 0,
          "text": "Zwiebel fein würfeln und in 1 tbsp Öl bei mittlerer Hitze etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Semmelbrösel und Milch in einer Schüssel vermengen und 2 Minuten quellen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch, Schweinefleisch, gegarte Zwiebel, eingeweichte Semmelbrösel, Ei, Petersilie, Salz und Pfeffer in einer großen Schüssel nur kurz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zu 8 Bratlingen von etwa 0.75 inches Dicke formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3 tbsp Öl in einer großen Pfanne bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bratlinge 4-5 Minuten pro Seite goldbraun und durchgegart braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit Senf und knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
