      "steps": [
        {
          "position": 0,
          "text": "Semmelbrösel 2 Minuten in Milch einweichen, dann mit Rinderhackfleisch, gehackten Sardellen, 1 Ei, gehackter Zwiebel, Salz und Pfeffer vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zu 12-16 Fleischbällchen mit etwa 1.5 inches Durchmesser formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderbrühe in einem großen Topf zum Kochen bringen und Fleischbällchen vorsichtig hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze reduzieren und 20 Minuten köcheln lassen, bis die Fleischbällchen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für eine Mehlschwitze Butter schmelzen, Mehl einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Langsam 1 cup heiße Brühe unter Rühren zur Mehlschwitze geben, bis eine glatte Sauce entsteht, dann in den Topf einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kapern einrühren und 5 Minuten köcheln lassen, bis die Sauce eindickt; nach Bedarf abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Eiernudeln oder Salzkartoffeln servieren und Sauce darübergeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
