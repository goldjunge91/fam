          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kräutermischung rundum auf das Schweinefilet reiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grill auf mittelhohe Hitze vorheizen und den Rost leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schweinefleisch 15-20 Minuten grillen und gelegentlich wenden, bis die Kerntemperatur 145°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Honig und Balsamicoessig vermischen und in den letzten 2 Minuten der Garzeit auf das Schweinefleisch pinseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten ruhen lassen, dann in Scheiben schneiden und mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
