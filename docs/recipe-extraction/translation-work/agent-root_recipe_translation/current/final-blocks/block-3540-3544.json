      "steps": [
        {
          "position": 0,
          "text": "Spüle fermentierte Teeblätter mit kaltem Wasser ab, um überschüssige Lake zu entfernen, und drücke sie vorsichtig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Blattsalat, gehackte Tomate und gewürfelte Gurke in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Limettensaft, Fischsauce, gehackten Knoblauch und Chiliflocken in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Pflanzenöl in einer kleinen Pfanne und röste Sesam 1 Minute leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib fermentierte Teeblätter zur Salatmischung und vermenge alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle den Salat mit Limettendressing und vermische alles, bis es gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue ihn mit zerstoßenen Erdnüssen und geröstetem Sesam und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
