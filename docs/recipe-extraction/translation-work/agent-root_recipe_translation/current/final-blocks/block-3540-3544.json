      "steps": [
        {
          "position": 0,
          "text": "Koche Reisnudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tbsp Öl in einem Wok oder einer großen Pfanne und brate geschnittene Schalotten etwa 5 Minuten knusprig und goldbraun. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl in den Wok und dünste gehackten Knoblauch 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Schweinehackfleisch dazu und brate es bei starker Hitze etwa 6 Minuten krümelig, bis es gebräunt und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Sojasauce, Fischsauce, Sesam und Chiliflocken ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die gekochten Nudeln auf Schalen und belege sie mit der Schweinefleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere sie mit knusprigen Röstschalotten und zerstoßenen Erdnüssen und presse vor dem Servieren Limettensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
