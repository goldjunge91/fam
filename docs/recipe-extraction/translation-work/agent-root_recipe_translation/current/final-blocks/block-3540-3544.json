      "steps": [
        {
          "position": 0,
          "text": "Schneide Fischfilets in 2-inch große Stücke und würze sie leicht mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einem großen Topf und dünste gewürfelte Zwiebel, Knoblauch und Ingwer etwa 4 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Kurkuma und Currypulver ein und gare alles unter ständigem Rühren 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Tomaten aus der Dose samt Saft und Fischbrühe dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelte Kartoffel dazu und gare sie 10 Minuten, bis sie teilweise zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Fischstücke vorsichtig zum Curry und lasse alles 10 Minuten köcheln, bis der Fisch gar ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht, passe die Würzung nach Bedarf an und serviere es heiß mit frischem Koriander auf gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
