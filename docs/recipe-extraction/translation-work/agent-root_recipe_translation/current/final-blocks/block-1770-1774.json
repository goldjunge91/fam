      "steps": [
        {
          "position": 0,
          "text": "Weiche den Stockfisch über Nacht in Wasser ein. Koche ihn anschließend in frischem Wasser auf dem Herd, bis sich Schaum bildet. Nimm den Topf vom Herd, gieße den Fisch ab und lass ihn abkühlen. Zerpflücke ihn dann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Speck in einer Pfanne bei mittlerer Hitze knusprig. Nimm ihn heraus und gieße den größten Teil des Speckfetts ab; etwa 1 Esslöffel in der Pfanne lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gelbe Zwiebel, Frühlingszwiebel, Scotch Bonnet und Knoblauch in die Pfanne und rühre um. Gare alles etwa 2 Minuten, bis die Zwiebeln weich sind. Gib den Stockfisch dazu, rühre um und gare ihn etwa eine Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Callaloo, Roma-Tomaten, Thymian und schwarzen Pfeffer dazu. Vermenge alles und gare es etwa 2 Minuten, bis es heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass es dir schmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
