      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Pflanzenöl in einem Wok oder einer großen Pfanne bei mittlerer Hitze. Gib den Knoblauch dazu und brate ihn etwa 30 seconds unter Rühren, bis er duftet, aber nicht verbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das gehackte Schweinefleisch dazu und zerteile es mit einem Pfannenwender. Brate es unter Rühren 2-3 Minuten, bis es gar und gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die fermentierten Bohnen unter und gare alles eine weitere Minute, dabei gut mit dem Fleisch vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den geschnittenen Wasserspinat dazu und brate ihn unter Rühren 2-3 Minuten, damit er leuchtend grün und knackig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmecke ab und würze bei Bedarf mit Fischsauce oder Zucker nach. Gib das Gericht auf eine Servierplatte und serviere es sofort mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
