      "steps": [
        {
          "position": 0,
          "text": "Weiche Mandeln 10 Minuten in heißem Wasser ein und püriere sie dann zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Hähnchen in mundgerechte Stücke und mariniere es mindestens 20 Minuten in Joghurt, Ingwer-Knoblauch-Paste und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl und gib Kreuzkümmelsamen hinein. Lass sie knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Zwiebeln in dünne Scheiben und gare sie im Öl goldbraun. Stelle die Hälfte zum Garnieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das marinierte Hähnchen in die Pfanne und gare es 8-10 Minuten, bis es leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kokosmilch hinein und gib Mandelpaste dazu. Rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Garam Masala und Kurkuma dazu. Lass das Curry 20 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Belege das Gericht mit den beiseitegestellten Röstzwiebeln und Koriander. Heiß mit Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
