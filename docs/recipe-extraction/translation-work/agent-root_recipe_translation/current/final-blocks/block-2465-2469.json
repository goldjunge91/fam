        {
          "position": 2,
          "text": "Gib 12 cups frisches Wasser, die gereinigten Knochen, geröstete Zwiebel, Ingwer, Sternanis und Zimtstange in einen großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und lass die Brühe 90 Minuten köcheln, bis sie aromatisch und kräftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Rinderbrust heraus, sobald sie zart ist. Schneide sie in dünne Scheiben und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seihe die Brühe durch ein feines Sieb, gib Fischsauce dazu und stelle sie zurück auf den Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche Phở-Nudeln separat nach Packungsanweisung und verteile sie auf Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße heiße Brühe über die Nudeln, belege sie mit Rinderbrustscheiben und Sojasprossen, gib Basilikum dazu und serviere mit Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
