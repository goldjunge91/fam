      "steps": [
        {
          "position": 0,
          "text": "Reibe Paneer und zerdrücke gekochte Kartoffel mit Salz. Vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Cashewkerne grob und vermische sie mit Erbsen und Sahne unter die Paneer-Kartoffel-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme 12 Kugeln, wende sie nach Wunsch in Semmelbröseln und stelle sie 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl und brate die Koftas vorsichtig hellgolden. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dünste im selben Öl geschnittene Zwiebeln goldbraun und stelle die Hälfte zum Garnieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Ingwer-Knoblauch-Paste dazu und gare sie, bis sie duftet. Füge dann gehackte Tomaten hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare die Tomaten weich. Püriere die Mischung glatt und gib sie zurück in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Garam Masala und Sahne dazu und lass die Sauce 5 Minuten köcheln. Gib die Koftas vorsichtig hinein und gare sie weitere 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Garniere das Gericht mit Röstzwiebeln und Koriander und serviere es mit Reis oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
