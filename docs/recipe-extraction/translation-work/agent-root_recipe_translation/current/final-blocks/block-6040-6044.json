      "steps": [
        {
          "position": 0,
          "text": "Schneide den Schweinebauch in 2-inch-Würfel und blanchiere ihn 5 Minuten in kochendem Wasser. Gieße ihn ab und spüle ihn ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle den eingelegten Senfkohl gründlich unter kaltem Wasser ab, um überschüssiges Salz zu entfernen, und schneide ihn in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Schmortopf und brate die Schweinefleischwürfel etwa 8 Minuten rundherum goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Ingwerscheiben, Knoblauch und Frühlingszwiebeln in den Topf und brate alles 1 Minute an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Wasser und Sojasauce dazu, gib Kandiszucker und Sternanis hinzu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lass das Fleisch 45 Minuten köcheln, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib den gehackten eingelegten Senfkohl dazu und gare alles weitere 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke das Gericht ab und würze es bei Bedarf mit Sojasauce nach. Serviere es heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
