      "steps": [
        {
          "position": 0,
          "text": "Vermenge Schweinehackfleisch, Frühlingszwiebeln, Sojasauce, Sesamöl, Ingwer und Wasser in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 Teelöffel Füllung in die Mitte jedes Wan-Tan-Teigblatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchte die Ränder des Teigblatts mit dem Finger mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe das Teigblatt diagonal zu einem Dreieck zusammen. Führe dann die beiden Ecken zusammen und drücke sie fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Pflanzenöl in einem tiefen Topf oder Wok auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Wan-Tans vorsichtig ins heiße Öl und frittiere sie 2-3 Minuten goldbraun. Wende sie einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe die Wan-Tans mit einer Schaumkelle heraus und lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm mit süß-saurer Sauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
