      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Misopaste, Honig, Sojasauce, Mirin, gehackten Knoblauch und Ingwer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Lachsfilets auf das Backblech und bestreiche sie großzügig mit der Miso-Karamell-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate den Lachs 12-15 Minuten im Ofen, bis er sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle ihn mit Sesamöl und garniere ihn mit gehackten Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere ihn sofort mit gedämpftem Reis oder Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
