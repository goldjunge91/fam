      "steps": [
        {
          "position": 0,
          "text": "Tupfe das Hähnchen trocken und würze es mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Maisstärke und wende die Hähnchenstücke gründlich darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl auf 350°F und frittiere das Hähnchen portionsweise 8-10 Minuten, bis es goldbraun ist; lass es dann auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Gochujang, Honig, Sojasauce, Reisessig und gehackten Knoblauch in einem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze die Sauce bei mittlerer Hitze vorsichtig 2-3 Minuten, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende das frittierte Hähnchen in der Sauce, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es mit Sesam und gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
