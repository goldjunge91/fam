      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Hefe, Salz und Zucker. Gib dann erwärmtes Wasser hinzu und knete den Teig 10 Minuten, bis er glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile den Teig in 4 gleich große Portionen und knete in jede eine andere Lebensmittelfarbe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle jede gefärbte Portion zu einem dünnen Strang und flechte oder schichte die Stränge zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme den geflochtenen Teig zu einem Bagelring und lasse ihn 30 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe Wasser mit Natron und Honig zum Kochen und koche die Bagels 1 Minute pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Bagels auf ein gefettetes Backblech, bestreue sie mit Sesam und backe sie bei 400°F 20-25 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie auf einem Kuchengitter abkühlen, bevor du sie aufschneidest und servierst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
