      "steps": [
        {
          "position": 0,
          "text": "Schritt 1\nHeize den Grill oder eine Grillpfanne auf hoher Stufe vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Hähnchen, Currypaste und Kokosmilch in eine Schüssel und vermische alles, bis das Hähnchen gleichmäßig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke Gemüse und Hähnchen abwechselnd auf Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille die Spieße auf dem Grill oder in der Grillpfanne 5-8 Minuten. Wende sie gelegentlich, bis das Hähnchen durchgegart und leicht verkohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Kräuterreis und Salat servieren, dazu eine Limettenhälfte zum Darüberpressen reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
