      "steps": [
        {
          "position": 0,
          "text": "Schäle die Zwiebeln, halbiere sie von oben nach unten und schneide sie in feine Halbmonde. Gib sie in ein Sieb über einer Schüssel und bestreue sie mit Salz. Wende die Zwiebelstücke leicht mit den Händen, damit alle Flächen bedeckt sind. Lass sie etwa eine Stunde in der Lake ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib währenddessen Essig, 50ml/2fl oz Wasser und Zucker in einen Topf. Bringe alles unter Rühren zum Köcheln, damit sich der Zucker auflöst, und koche es einige Minuten. Stelle den Topf beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Zwiebeln in sterilisierte Gläser und streue dabei etwas Pfeffer dazwischen. Bedecke sie mit warmem Essig und stecke zum Schluss ein paar Lorbeerblätter an den Rand der Gläser. Verschließe die Gläser. Bewahre die Zwiebeln am besten im Kühlschrank auf und verbrauche sie innerhalb von 4 Wochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
