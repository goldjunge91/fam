      "steps": [
        {
          "position": 0,
          "text": "Erhitze tiefgekühlten Blumenkohlreis 4 Minuten in der Mikrowelle. Verteile ihn auf einem sauberen Geschirrtuch und drücke überschüssige Feuchtigkeit heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sesamöl in einer großen Pfanne bei hoher Hitze. Gib Knoblauch und Ingwer dazu und brate sie 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib tiefgekühltes Gemüse, Edamame und Mais dazu. Brate alles unter Rühren 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe alles an den Rand. Rühre die Eier im freien Teil der Pfanne 1–2 Minuten zu Rührei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Blumenkohlreis und Sojasauce dazu. Schwenke alles 2 Minuten, damit es sich vermischt. Garniere das Gericht mit Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
