      "steps": [
        {
          "position": 0,
          "text": "Vermenge Hähnchenstücke mit Limettensaft, 2 gehackten Knoblauchzehen, Salz und Pfeffer und lasse sie 15 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mehl in eine flache Schüssel, wende jedes Hähnchenstück darin und lege es dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und frittiere das Hähnchen portionsweise 3-4 Minuten pro Seite goldbraun und gar. Lege es auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zwiebel, Paprika, den restlichen Knoblauch und Lorbeerblätter in dieselbe Pfanne und dünste alles 3 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Hühnerbrühe hinzu, gib das Hähnchen zurück in die Pfanne und lasse alles 5 Minuten sanft köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht, passe die Würzung an und serviere es heiß mit weißem Reis oder Bratkartoffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
