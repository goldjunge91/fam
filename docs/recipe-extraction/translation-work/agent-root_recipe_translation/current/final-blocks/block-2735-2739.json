      "steps": [
        {
          "position": 0,
          "text": "Schmilz Butter in einer beschichteten Pfanne bei mittlerer Hitze, gib Maniokmehl hinzu und rühre 2 Minuten ständig, bis es leicht geröstet ist und duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib braunen Zucker, Zimt und Salz hinzu, verrühre alles gut und röste es eine weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Bananen in dünne Scheiben und lege 4-5 Scheiben in die Pfanne. Drücke sie leicht in die Maniokmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile Rosinen und Olivenhälften (als „Augen“) um die Bananenscheiben und bedecke alles mit einer dünnen Schicht der übrigen Maniokmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare alles 3-4 Minuten ohne Rühren, bis die Unterseite goldbraun und fest ist und eine Kruste entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende den Fladen vorsichtig mit zwei Pfannenwendern und gare die andere Seite 2 Minuten, bis sie leicht goldbraun ist. Lege ihn dann auf einen Servierteller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
