      "steps": [
        {
          "position": 0,
          "text": "Koche das Hähnchen 20 Minuten in Brühe mit der Hälfte der Zwiebel, bis es gar ist. Zupfe es auseinander und hebe die Brühe auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Aji-Amarillo-Chilis mit Knoblauch, der übrigen Zwiebel, Brotstücken, Walnüssen und 1 Tasse Brühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 EL Öl in einem Topf und dünste die pürierte Mischung 5 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kondensmilch und gezupftes Hähnchen zur Sauce und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße nach und nach die restliche Brühe hinzu, bis die Sauce die gewünschte Konsistenz hat. Lasse sie 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte gekochte Kartoffeln auf einer Servierplatte an und gieße Ají de Gallina darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit halbierten hart gekochten Eiern, schwarzen Oliven und frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
