      "steps": [
        {
          "position": 0,
          "text": "Koche Kartoffeln in Salzwasser etwa 15 Minuten, bis sie mit einer Gabel leicht zu durchstechen sind. Gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerdrücke die warmen Kartoffeln mit Aji-Amarillo-Paste, Limettensaft und Öl zu einer cremigen Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze die Kartoffelmasse mit Salz und Pfeffer und verteile sie gleichmäßig auf mit Salat ausgelegten Serviertellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Thunfisch oder Hähnchen mit Mayonnaise, roten Zwiebeln, Koriander, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Häufe die Thunfisch- oder Hähnchenmischung auf jede Kartoffelbasis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Scheiben hart gekochten Eis neben der Causa an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht gekühlt oder bei Raumtemperatur mit Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
