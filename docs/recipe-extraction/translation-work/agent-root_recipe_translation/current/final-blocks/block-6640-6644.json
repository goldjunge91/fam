      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in mundgerechte Stücke würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und braunen Zucker dunkel karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hähnchen dazugeben und von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebeln und Knoblauch im selben Topf anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie das Huhn wieder in den Topf und fügen Sie Straucherbsen, Koriander und Thymian hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hühnerbrühe und Wasser angießen, zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 30 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reis einrühren und zugedeckt 20–25 Minuten köcheln lassen, bis der Reis gar ist und die Flüssigkeit aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen, mit einer Gabel auflockern und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
