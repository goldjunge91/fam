      "steps": [
        {
          "position": 0,
          "text": "Pflanzenöl in einem großen Topf erhitzen und gehackten Knoblauch und gewürfelte Zwiebeln etwa 2 Minuten lang anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Karotten hinzufügen und 3 Minuten kochen lassen, dann den Reis hinzufügen und umrühren, bis er mit Öl bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Reis unter ständigem Rühren 2 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie Kokosmilch und Wasser hinzu und fügen Sie Kurkuma und Salz hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Kidneybohnen und grünen Erbsen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe, decken Sie den Reis fest ab und lassen Sie ihn 20–25 Minuten köcheln, bis der Reis weich ist und die Flüssigkeit aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einer Gabel auflockern und abgedeckt 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß als komplettes Eintopfgericht servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
