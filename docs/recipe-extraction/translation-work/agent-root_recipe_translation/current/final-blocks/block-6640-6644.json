      "steps": [
        {
          "position": 0,
          "text": "Die getrockneten Kidneybohnen über Nacht in Wasser einweichen, dann abtropfen lassen und gründlich abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebeln, Karotten, Sellerie und gehackten Knoblauch etwa 5 Minuten lang anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 1 Minute kochen lassen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die abgetropften Bohnen und die Gemüsebrühe in den Topf geben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren und 45–60 Minuten köcheln lassen, bis die Bohnen vollständig weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz, schwarzem Pfeffer und Paprika würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Einige Bohnen am Topfrand zerdrücken, um die Suppe etwas zu verdicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Weitere 5 Minuten köcheln lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
