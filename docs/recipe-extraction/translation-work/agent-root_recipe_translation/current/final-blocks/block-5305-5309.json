      "steps": [
        {
          "position": 0,
          "text": "Bringe die Hühnerbrühe in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und lass die Brühe 5 Minuten köcheln, damit sie deren Aroma annimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Sojasauce und Mirin ein und schmecke die Brühe ab. Würze sie nach Bedarf nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe in einem separaten Topf Wasser zum Kochen und gare die Ramen-Nudeln nach Packungsanleitung etwa 3–4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Nudeln ab und verteile sie auf zwei Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die heiße Brühe gleichmäßig über die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Schale mit aufgeschnittenem Hähnchen, einem weich gekochten Ei, Frühlingszwiebeln und Nori-Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange die Brühe dampfend heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
