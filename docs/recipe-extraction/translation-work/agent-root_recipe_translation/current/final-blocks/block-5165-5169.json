      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 8x8 baking pan ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter und verrühre sie mit dem Zucker. Rühre anschließend Eier und Vanilleextrakt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Siebe Mehl, Kakaopulver, Backpulver und 1/4 tsp Salz zusammen und hebe die trockenen Zutaten unter die feuchten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Hälfte des Teigs in die vorbereitete Form und träufle die Hälfte der Karamellsauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den restlichen Teig und die übrige Karamellsauce darauf. Bestreue alles mit Schokoladenstückchen und Meersalz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Brownies 25-30 Minuten, bis an einem hineingesteckten Zahnstocher noch feuchte Krümel haften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie vollständig abkühlen und schneide sie in 12 Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
