      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Zucker, Hefe und Salz in einer Schüssel. Gib warme Milch und Ei hinzu und forme daraus einen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 8 Minuten und stelle ihn anschließend 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig zu einem Rechteck aus und arbeite kalte Butter mit der Touriertechnik ein. Falte den Teig 3-mal und lasse ihn zwischen den Faltungen jeweils 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den fertigen Teig 1/4-inch dick aus und stich mit einem Donutausstecher Ringe aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die geformten Cronuts 45 Minuten gehen, bis sie aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze das Öl auf 350°F und frittiere die Cronuts vorsichtig 1-2 Minuten pro Seite, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und wende sie sofort im Zimtzucker, solange sie noch warm sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
