        {
          "position": 0,
          "text": "Roggenmehl mit 0.5 cup Wasser verrühren und 2-3 Tage bei Raumtemperatur fermentieren lassen oder fertigen Żurek-Sauerteig verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und gewürfelte Zwiebel sowie Karotte 3 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderbrühe, Kartoffeln, Kielbasa, Lorbeerblatt, Salz und Pfeffer hinzufügen, aufkochen und dann 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die fermentierte Roggenmischung durch ein Passiertuch abseihen, um die Flüssigkeit aufzufangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Roggenflüssigkeit in die Suppe gießen und weitere 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und saure Sahne glatt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit zusätzlichem Salz und Pfeffer abschmecken und heiß in Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
