      "steps": [
        {
          "position": 0,
          "text": "Aus Mehl, Ei, 0.5 cup saurer Sahne, Wasser und 0.5 tsp Salz einen Teig kneten, bis er glatt ist; 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln kochen und mit Cheddar, 1 tbsp Butter, restlichem Salz und schwarzem Pfeffer stampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig sehr dünn ausrollen und mit einem Glas oder Ausstecher Kreise von 3-inch Durchmesser ausschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Je 1 tbsp Kartoffelfüllung auf die Kreise geben, halb zusammenklappen und die Ränder fest zudrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pierogi in Salzwasser 3-4 Minuten kochen, nachdem sie an die Oberfläche gestiegen sind; mit einer Schaumkelle herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gewürfelte Zwiebel in den restlichen 2 tbsp Butter goldbraun und knusprig anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Pierogi mit karamellisierter Zwiebel vermengen und mit zusätzlicher saurer Sahne als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
