      "steps": [
        {
          "position": 0,
          "text": "Gehacktes Schweinefleisch und gewürfeltes Fett 30 Minuten im Gefrierfach kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kaltes Schweinefleisch, Fett, Salz, Pfeffer, Knoblauch, Paprikapulver, Majoran und Wasser gründlich vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung vorsichtig mit einem Wurstfüller in vorbereitete Wursthüllen füllen und dabei Luftblasen vermeiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hüllen in Abständen von 4-inch mit Küchengarn abbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würste in einen Topf mit siedendem, nicht kochendem Wasser geben und 25-30 Minuten garen, bis die Kerntemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würste herausnehmen und leicht abkühlen lassen, dann bis zum Servieren kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würste in einer Pfanne bei mittelhoher Hitze 5 Minuten goldbraun braten oder grillen, bis sie leicht angekohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
