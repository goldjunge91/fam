      "steps": [
        {
          "position": 0,
          "text": "Vermische Rinderhackfleisch mit gehackter Zwiebel, Ei, Salz und Pfeffer und lasse die Mischung 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile die Fleischmischung in vier Portionen und forme jede fest um einen flachen Metallspieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Grill oder Pfanne auf mittlere bis hohe Hitze und gare die Kebabs 12-15 Minuten. Wende sie alle 3 Minuten, bis sie durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche Reis 12 Minuten in Salzwasser, gieße ihn ab und schichte ihn mit geschmolzener Butter in einen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse Safran in heißem Wasser ziehen, gieße es über den Reis, decke den Topf ab und dämpfe ihn bei niedriger Hitze 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhöhe die Hitze 5 Minuten auf mittlere Stufe, damit sich am Boden eine goldene, knusprige Reiskruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Kebabs auf Reis mit gegrillten Tomatenscheiben als Beilage.",
