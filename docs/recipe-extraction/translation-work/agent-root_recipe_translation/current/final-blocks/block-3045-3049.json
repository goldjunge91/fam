      "steps": [
        {
          "position": 0,
          "text": "Bräune Rindfleischstücke etwa 8 Minuten in Olivenöl bei mittlerer bis hoher Hitze. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel im selben Topf etwa 4 Minuten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch mit Rinderbrühe, Salz und Pfeffer zurück in den Topf und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Topf ab und lasse alles 30 Minuten köcheln, bis das Rindfleisch fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib frische Petersilie, Koriander, getrocknete Limetten (mit einem Messer eingestochen) und Kidneybohnen hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel 15 Minuten köcheln und rühre gelegentlich um, bis die Kräuter zusammengefallen sind und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht, passe die Würzung an und entferne die getrockneten Limetten vor dem Servieren mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
