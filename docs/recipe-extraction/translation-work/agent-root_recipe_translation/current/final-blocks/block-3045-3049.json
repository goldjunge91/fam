      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und bräune die Hähnchenschenkel insgesamt 8 Minuten auf beiden Seiten. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel und Knoblauch im selben Topf etwa 5 Minuten, bis sie weich und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gemahlene Walnüsse, Granatapfelmelasse, Hühnerbrühe, Salz und Pfeffer hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in den Topf, decke ihn ab und lasse alles bei niedriger Hitze 40 Minuten köcheln, bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke das Gericht ab und lasse es ohne Deckel weitere 5 Minuten köcheln, damit die Sauce leicht reduziert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es auf gedämpftem Reis und garniere es bei Verfügbarkeit mit Granatapfelkernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
