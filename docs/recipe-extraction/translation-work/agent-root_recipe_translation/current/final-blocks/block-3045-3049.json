              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Zucker und Salz in einer großen Schüssel und forme in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme die Milch leicht und verrühre sie mit der Hefe, bis sie schäumt. Gieße sie in die Mehlmulde und vermische alles zu einem groben Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig 8 Minuten glatt, decke ihn ab und stelle ihn 30 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig zu einem 12x8 Zoll großen Rechteck aus und verteile kalte Butterflocken auf zwei Dritteln der Fläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falte den Teig in Dritteln wie einen Brief und drehe ihn um 90 Grad. Rolle ihn aus und falte ihn innerhalb von 2 Stunden noch dreimal, mit jeweils 30 Minuten Kühlzeit zwischen den Faltungen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Teig nach der letzten Faltung ab und stelle ihn über Nacht oder bis zu 24 Stunden in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rolle den Teig 1/4 Zoll dick aus, schneide Dreiecke und rolle sie fest auf. Lege sie auf Backbleche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie 2 Stunden gehen, bis sie aufgegangen sind. Bestreiche sie mit verquirltem Eigelb und backe sie bei 400°F 20-25 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
