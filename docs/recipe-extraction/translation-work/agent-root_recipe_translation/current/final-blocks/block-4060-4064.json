      "steps": [
        {
          "position": 0,
          "text": "Zitronensaft, Essig, Öl, Knoblauch, scharfe Chili und Senfpulver in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen in eine große Form legen, Marinade darüber gießen und mindestens 30 Minuten oder bis über Nacht im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine große Pfanne bei mittelhoher Hitze erhitzen, Hähnchen aus der Marinade nehmen und die Flüssigkeit aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hähnchen in der Pfanne insgesamt etwa 8 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geschnittene Zwiebeln in die Pfanne geben und 5 Minuten garen, bis sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aufbewahrte Marinade und Brühe in die Pfanne gießen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren, abdecken und 20-25 Minuten köcheln lassen, bis das Hähnchen gar und die Zwiebeln sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
