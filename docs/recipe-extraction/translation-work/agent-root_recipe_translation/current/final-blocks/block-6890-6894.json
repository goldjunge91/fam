      "steps": [
        {
          "position": 0,
          "text": "Aktivieren Sie die Hefe, indem Sie sie mit warmem Wasser vermischen und 5 Minuten ruhen lassen, bis sich Blasen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz vermischen, dann Hefemischung und 2 Esslöffel Olivenöl hinzufügen, um einen Teig zu formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "6 Minuten lang kneten, bis eine glatte Masse entsteht, dann in eine geölte Schüssel geben und 45 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Ofen auf 500 °F vorheizen und den Teig sehr dünn auf einer mit Olivenöl bestrichenen Pizzaform ausbreiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerkleinerte Tomaten mit gehacktem Knoblauch und italienischen Gewürzen vermischen und leicht auf dem Teig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mozzarella gleichmäßig über die Soße streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "12–15 Minuten backen, bis die Kruste knusprig ist und der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mit frischem Basilikum belegen und mit Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
