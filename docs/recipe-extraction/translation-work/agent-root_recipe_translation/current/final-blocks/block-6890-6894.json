      "steps": [
        {
          "position": 0,
          "text": "Grüne Kochbananen schälen und der Länge nach in dünne Streifen schneiden, dann 10 Minuten in Salzwasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und Kochbananenscheiben portionsweise 3–4 Minuten pro Seite braten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gebratene Kochbananen auf Küchenpapier abtropfen lassen und leicht salzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Steakscheiben mit Salz, Pfeffer und gehacktem Knoblauch würzen und dann in einer separaten Pfanne 3–4 Minuten braten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sofrito in das gekochte Fleisch einrühren und vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Legen Sie eine frittierte Kochbananenscheibe flach hin und verteilen Sie eine dünne Schicht Mayonnaise darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Legen Sie Fleisch, Käse, Tomaten und Salat auf die Kochbanane und belegen Sie sie dann wie ein Sandwich mit einer weiteren frittierten Kochbananenscheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange die Kochbananen noch warm und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
