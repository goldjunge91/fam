      "steps": [
        {
          "position": 0,
          "text": "Weiche die getrockneten Kichererbsen 6 Stunden oder über Nacht in Wasser ein und gieße sie anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf und brate die Hähnchenschenkel rundherum an. Nimm sie heraus und stelle sie beiseite.",
