      "steps": [
        {
          "position": 0,
          "text": "Spüle die Puy-Linsen ab und gib sie mit 3 cups Wasser in einen Topf. Bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lass die Linsen 20-25 Minuten köcheln, bis sie weich, aber noch bissfest sind. Gieße sie ab und lass sie etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle währenddessen rote Zwiebel und Gurke fein und halbiere die Kirschtomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Dijon-Senf, Balsamicoessig, Olivenöl, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die abgekühlten Linsen und das gewürfelte Gemüse in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße das Dressing darüber und mische alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre frische Petersilie und Minzblätter unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke den Salat ab und serviere ihn bei Zimmertemperatur oder gekühlt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
