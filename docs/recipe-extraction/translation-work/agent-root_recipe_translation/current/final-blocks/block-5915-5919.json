      "steps": [
        {
          "position": 0,
          "text": "Koche Basmatireis mit 4 cups Salzwasser, Kreuzkümmelsamen, Zimt und Lorbeerblättern 6-7 Minuten, bis er zu 70 % gar ist. Gieße ihn ab und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mariniere die Hähnchenstücke 20 Minuten in Joghurt, Ingwer-Knoblauch-Paste, Chilipulver und Kurkuma.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Zwiebeln in Scheiben und frittiere sie in 2 tbsp Ghee goldbraun und knusprig. Nimm die Hälfte für die Garnitur heraus und zerdrücke den Rest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schichte in einem Topf mit dickem Boden die Hälfte des marinierten Hähnchens, zerdrückte Röstzwiebeln, Minze und Koriander, dann Reis, das übrige Hähnchen und den restlichen Reis. Belege alles mit den knusprigen Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle alles mit dem restlichen Ghee. Decke den Topf mit Folie und einem dicht schließenden Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze alles bei starker Hitze 2 Minuten, bis Dampf entsteht. Reduziere dann die Hitze auf niedrige Stufe und gare das Gericht 45 Minuten, ohne den Deckel zu öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schalte die Hitze aus und lass den Biryani 5 Minuten ruhen. Öffne den Deckel vorsichtig und lockere den Reis vor dem Servieren mit einer Gabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
