            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Brate zuerst schwarzen Pfeffer und Knoblauch in einer trockenen Pfanne bei mittlerer Hitze an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib reichlich Olivenöl extra vergine hinzu und lasse es eine Minute ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sobald das Öl heiß ist, gib Tomaten und Salz hinzu und decke die Pfanne ab. Lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Deckel ab und zerdrücke die Tomaten. Koche sie ein, bis die gewünschte Konsistenz erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme Mulden für die Eier und reduziere die Hitze. Schlage die Eier vorsichtig in die Mulden, sodass sie den Pfannenboden und nicht nur die Tomatensoße berühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Eier ab und lasse sie 5 Minuten garen, ohne den Deckel anzuheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd und lasse die Restwärme die Eier 1-2 Minuten stocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Fladenbrot servieren. Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
