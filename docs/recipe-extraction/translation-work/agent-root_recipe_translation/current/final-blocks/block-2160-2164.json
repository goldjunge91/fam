        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische die Zutaten für die Marinade in einem großen wiederverschließbaren Beutel oder einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Hähnchen dazu und achte mit den Händen darauf, dass jedes Stück überzogen ist. Bei einem Beutel kannst du ihn verschließen und massieren, damit sich die Würzmischung überall auf den Hähnchenteilen verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mariniere das Hähnchen über Nacht oder bis zu 24 hours.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische die Zutaten für die Joghurtsauce in einer Schüssel. Decke sie ab und stelle sie bis zur Verwendung in den Kühlschrank (dort hält sie sich 3 days).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize Grill, Grillgerät oder eine große schwere Pfanne auf dem Herd auf mittlere bis hohe Hitze vor. Du musst sie nicht einölen, da die Marinade Öl enthält und die Schenkelfilets ebenfalls Fett haben. Wenn du möchtest, öle die Grillfläche trotzdem leicht ein. (Hinweise zum Backen siehe Rezeptnotizen.)",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Hähnchen auf den Grill und gare die erste Seite 4 bis 5 Minuten, bis sie schön gebräunt ist. Wende es und gare die andere Seite 3 bis 4 Minuten; die 2. Seite braucht weniger Zeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Hähnchen vom Grill, decke es locker mit Folie ab und lasse es 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "ZUM SERVIEREN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schneide das Hähnchen in Scheiben und richte es mit Fladenbrot, Salat und Joghurtsauce auf einer Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Für einen Wrap bestreiche ein Stück Fladenbrot mit Joghurtsauce. Belege es mit etwas Salat, Tomate und Shawarma-Hähnchen. Rolle es zusammen und genieße es!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
