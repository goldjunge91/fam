      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Öl in einer Pfanne mit Deckel. Dünste Zwiebeln, Chili, Knoblauch und Korianderstiele 5 mins weich. Rühre Tomaten und Zucker ein und lasse alles 8-10 mins einkochen, bis es dick ist. Kann bis zu 1 month eingefroren werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke mit der Rückseite eines großen Löffels 4 Mulden in die Soße und schlage je ein Ei hinein. Decke die Pfanne ab und gare die Eier bei niedriger Hitze 6-8 mins, bis sie nach Wunsch gestockt sind. Streue Korianderblätter darüber und serviere das Gericht mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
