      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und koche die Makkaroni nach Packungsanleitung bissfest. Gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem Topf bei mittlerer Hitze, rühre Mehl zu einer Mehlschwitze ein und gare sie unter Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße nach und nach unter ständigem Rühren Milch hinzu, damit sich keine Klumpen bilden. Erhitze die Sauce etwa 5 Minuten, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Topf vom Herd, rühre Cheddar und Gruyère ein, bis sie geschmolzen und glatt sind, und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische gekochte Pasta mit Käsesauce und fülle sie in eine gebutterte 9x13 Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Panko-Semmelbrösel mit geschmolzener Butter und Parmesan und streue alles gleichmäßig über die Pasta.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe das Gericht 15-20 Minuten, bis die Oberfläche goldbraun ist und die Sauce am Rand blubbert. Lasse es vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
