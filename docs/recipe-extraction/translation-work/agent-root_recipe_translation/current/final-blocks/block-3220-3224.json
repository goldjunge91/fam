      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor, koche die Lasagneplatten nach Packungsanleitung, gieße sie ab und lege sie flach auf Backpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Rinderhackfleisch in einer großen Pfanne bei mittlerer bis hoher Hitze mit gehacktem Knoblauch und zerteile es dabei. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Marinara-Sauce ein und lasse alles 5 Minuten köcheln. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Ricotta, 1 Tasse Mozzarella, Parmesan und Ei in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile eine dünne Schicht Fleischsauce auf dem Boden einer 9x13 Auflaufform, schichte 3 Nudelplatten, die Hälfte der Ricottamischung und ein Drittel der Fleischsauce darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege 3 weitere Nudelplatten darauf, gib die restliche Ricottamischung und ein weiteres Drittel der Fleischsauce hinzu. Belege alles mit den letzten 3 Nudelplatten und der übrigen Fleischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue den restlichen Mozzarella darüber, decke die Form mit Folie ab und backe sie 25 Minuten zugedeckt sowie weitere 10-15 Minuten ohne Folie, bis der Käse blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse die Lasagne vor dem Schneiden und Servieren 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
