      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis nach Packungsanleitung und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Sojasauce, Honig, Knoblauch und Ingwer in einer Schüssel zu einer Teriyaki-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und gib Hähnchenwürfel hinein. Gare sie 6-8 Minuten, bis sie von allen Seiten leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Brokkoliröschen zum Hähnchen in die Pfanne und gare sie 3-4 Minuten, bis sie bissfest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Teriyaki-Sauce über Hähnchen und Brokkoli und rühre um, bis alles bedeckt ist. Gare weitere 2-3 Minuten, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile gekochten Reis auf Schalen und gib die Teriyaki-Hähnchen-Brokkoli-Mischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue vor dem Servieren Sesamsamen über jede Schale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
