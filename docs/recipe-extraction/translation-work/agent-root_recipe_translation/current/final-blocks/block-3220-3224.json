      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Hähnchenflügel mit Küchenpapier trocken und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende die Flügel in Mehl, bis sie gleichmäßig bedeckt sind, und schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf oder einer tiefen Pfanne auf 350°F. Gib die Flügel vorsichtig portionsweise hinein und frittiere sie 12-15 Minuten goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Flügel 2-3 Minuten auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Chilisauce und geschmolzene Butter in einer großen Schüssel, gib die abgetropften Flügel hinzu und wende sie, bis sie vollständig überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide Sellerie in Stifte und serviere die Wings mit Sellerie und Blauschimmelkäse-Dressing zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
