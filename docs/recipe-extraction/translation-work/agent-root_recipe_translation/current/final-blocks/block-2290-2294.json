      ],
      "steps": [
        {
          "position": 0,
          "text": "Wasser in einem mittelgroßen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hitze auf niedrig reduzieren und Maismehl unter ständigem Rühren mit einem Schneebesen langsam in das kochende Wasser geben. Ugali dickt recht schnell ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bei niedriger Hitze unter ständigem Rühren mit einem stabilen Holzlöffel weitergaren, bis sich Ugali vom Topfrand löst, zusammenhält und nach geröstetem Mais duftet. Sofort auf eine Servierplatte stürzen. Nach Wunsch mit einem Löffel oder Pfannenwender rasch zu einer dicken Scheibe oder runden Form gestalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beim Abkühlen wird Ugali fester und lässt sich mit einem Messer schneiden (ähnlich wie feste Polenta).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
