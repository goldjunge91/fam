      "steps": [
        {
          "position": 0,
          "text": "Lege die Hähnchenteile in einen großen Topf und bedecke sie mit 8 cups kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe das Wasser bei hoher Hitze zum Kochen, reduziere dann die Hitze und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schöpfe Schaum und Verunreinigungen ab, die an die Oberfläche steigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib halbierte Zwiebel, Karotten, Pastinaken, Sellerie, Petersilienwurzel und Lorbeerblätter dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles ohne Deckel 1-1.5 Stunden köcheln, bis das Hähnchen sehr zart und die Brühe aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen aus dem Topf und lasse es abkühlen. Löse dann das Fleisch von den Knochen und zerpflücke es in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Seihe die Brühe durch ein feinmaschiges Sieb in einen sauberen Topf und entsorge das Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib das Hähnchenfleisch zurück in die Brühe, würze mit Salz und Pfeffer und serviere die Suppe heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
