      "steps": [
        {
          "position": 0,
          "text": "Erhitze Schmalz in einem großen Topf bei mittelhoher Hitze und brate gewürfelte Zwiebel etwa 5 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehackfleisch dazu und brate es krümelig, während du es zerteilst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sauerkraut, geschnittene Kielbasa, gewürfelte Tomaten samt Saft, Rinderbrühe, Lorbeerblätter und Kümmel dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, reduziere dann die Hitze auf niedrig und decke den Topf ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche alles 45-60 Minuten und rühre gelegentlich um, bis sich die Aromen verbunden haben und die Mischung eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und passe die Würzung bei Bedarf mit Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß in Schalen, nach Wunsch mit saurer Sahne und frischer Petersilie garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
