      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Milch langsam unter häufigem Rühren auf 86°F. Gib dann verdünntes Lab dazu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse die Milch 30 Minuten ungestört stehen, bis sich ein fester Käsebruch gebildet hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Käsebruch mit einem langen Messer in 1/4-inch große Stücke, indem du waagerechte und senkrechte Schnitte machst. Lasse ihn dann 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze den Käsebruch langsam auf 105°F über 30 Minuten und rühre dabei vorsichtig und ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Molke durch ein Käsetuch ab und drücke den Käsebruch leicht aus. Gib ihn dann in ein mit Käsetuch ausgelegtes Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage das Käsetuch um den Käsebruch und hänge ihn 1 Stunde zum Abtropfen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische den abgetropften Käsebruch mit Salz und Kümmel und knete ihn vorsichtig, damit er elastisch wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Forme daraus eine Kugel oder einen Laib, wickle ihn in Käsetuch und hänge ihn 2-3 Tage an einem kühlen Ort zum Trocknen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Wickle den Käse aus und lagere ihn an einem kühlen Ort. Wende ihn täglich, damit er gleichmäßig trocknet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
