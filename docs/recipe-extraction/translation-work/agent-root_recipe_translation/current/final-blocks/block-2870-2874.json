      "steps": [
        {
          "position": 0,
          "text": "Vermische Graham-Cracker-Krümel mit geschmolzener Butter und drücke sie fest auf den Boden einer 9-inch-Springform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe den Boden bei 325°F 5 Minuten, nimm ihn heraus und lasse ihn etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage weichen Frischkäse mit Zucker glatt und cremig und schabe dabei regelmäßig die Schüssel aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib saure Sahne und Vanilleextrakt zur Frischkäsemischung und schlage alles, bis es vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Eier einzeln dazu und schlage nach jeder Zugabe auf niedriger Stufe, bis sie gerade eingearbeitet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe das Mehl vorsichtig mit einem Teigschaber unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Füllung auf den vorbereiteten Boden und streiche die Oberfläche glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Kuchen bei 325°F 55-60 Minuten, bis die Mitte fest ist, beim leichten Rütteln aber noch etwas wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schalte den Ofen aus, öffne die Tür einen Spalt und lasse den Käsekuchen 1 Stunde im Ofen abkühlen, damit er nicht reißt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
