      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer Schüssel, forme eine Mulde und gib Ei und warmes Wasser hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre, bis ein grober Teig entsteht, und knete ihn dann 5 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig ab und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche gewürfelte Kartoffeln weich und stampfe sie dann mit Käse und Salz nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig auf einer bemehlten Fläche 1/8-inch dick aus und schneide mit einem Glas oder Ausstecher 3-inch große Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1 EL Füllung in die Mitte jedes Kreises, klappe ihn zusammen und drücke die Ränder fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und koche die Wareniki portionsweise, bis sie an die Oberfläche steigen. Koche sie dann weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brate in einer separaten Pfanne gewürfelte Zwiebel in Butter goldbraun an und vermische sie mit den abgetropften Wareniki.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie warm mit saurer Sahne dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
