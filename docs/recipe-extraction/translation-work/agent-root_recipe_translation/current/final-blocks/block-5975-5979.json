      "steps": [
        {
          "position": 0,
          "text": "Vermische schwarzen Pfeffer, koscheres Salz, Knoblauchpulver, Paprikapulver und Zwiebelpulver in einer Schüssel zu einem Trockenrub.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Fett am Brisket auf eine Dicke von 1/4 Zoll zurück. Reibe das Fleisch großzügig mit der Gewürzmischung ein und drücke sie fest an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Brisket mit der Fettseite nach oben in den auf 225 °F vorgeheizten Smoker und räuchere es 10–12 Stunden, bis die Kerntemperatur 203 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wickle das Brisket fest in Folie, gib Rinderbrühe, Apfelessig und Butter dazu und gare es weitere 1–2 Stunden, bis es mit der Gabel zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Brisket aus der Folie und lasse es vor dem Aufschneiden gegen die Faser 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Brotscheiben auf dem Grill oder im Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das aufgeschnittene Brisket auf geröstetem Brot und gib den Bratensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
