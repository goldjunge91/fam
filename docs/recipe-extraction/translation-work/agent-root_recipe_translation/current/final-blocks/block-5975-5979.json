      "steps": [
        {
          "position": 0,
          "text": "Verrühre Sojasauce, braunen Zucker, geriebene Birne, Knoblauch, Sesamöl, Ingwer und Reisessig in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Rinderrippchen in eine große Form und gieße die Marinade darüber. Wende das Fleisch, damit es gleichmäßig bedeckt ist, und stelle es mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch 30 Minuten vor dem Grillen aus dem Kühlschrank und heize den Grill auf hohe Hitze vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die marinierten Rippchen auf den geölten Rost und grille sie für medium-rare auf jeder Seite 2–3 Minuten. Achte darauf, dass keine Flammen hochschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das gegarte Galbi auf eine Servierplatte und bestreue es mit gehackten Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere es sofort mit gedämpftem Reis und eingelegtem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
