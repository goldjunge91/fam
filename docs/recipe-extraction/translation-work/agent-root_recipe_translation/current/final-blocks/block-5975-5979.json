      "steps": [
        {
          "position": 0,
          "text": "Püriere Scotch-Bonnet-Chili, Piment, Thymian, Knoblauch, Ingwer, Limettensaft, Sojasauce, braunen Zucker und Kokosmilch in einer Küchenmaschine glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Schweineschulter tief ein und reibe die Jerk-Marinade großzügig rundherum und in die Einschnitte ein. Stelle das Fleisch mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Grill auf mittelhohe Hitze vor und öle den Rost gut ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die marinierte Schweineschulter auf den Grill, decke ihn ab und gare das Fleisch 4–5 Stunden. Wende es alle 30 Minuten, bis die Kerntemperatur 190 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Fleisch auf ein Schneidebrett und zupfe es mit zwei Gabeln vollständig auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische übrige Marinade mit dem Bratensaft zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge das gezupfte Fleisch mit der Jerk-Sauce und serviere es heiß mit Reis und Bohnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
