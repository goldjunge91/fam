      "steps": [
        {
          "position": 0,
          "text": "Bereite den Grill auf mittelhohe Hitze vor und lege die Fleischsorten getrennt bereit: Rippchen, Hähnchen, Lamm und Chorizo.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze alle Fleischstücke auf beiden Seiten mit Salz, schwarzem Pfeffer und Oregano.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Rinderrippchen zuerst auf die heißeste Stelle des Grills und gare sie 20 Minuten. Wende sie alle 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Rippchen auf die kühlere Seite und gib Hähnchenbrust und Lammkoteletts dazu. Grille das Hähnchen 12–15 Minuten und das Lamm 8–10 Minuten; wende beides häufig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege Chorizo und rote Zwiebelscheiben auf den Grill und gare sie 8–10 Minuten, bis die Wurst durch und die Zwiebel angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche Mozzarellascheiben mit Olivenöl und grille sie auf jeder Seite 1 Minute, bis sie leicht gebräunt sind und zu schmelzen beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte das gegrillte Fleisch und den Käse auf einer großen Platte an und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
