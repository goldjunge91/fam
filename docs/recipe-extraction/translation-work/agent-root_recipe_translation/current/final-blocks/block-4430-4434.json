      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln und Karotten in 1 Zoll große Würfel und Zwiebeln in kleine Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln, Karotten und Zwiebeln zusammen in Salzwasser 20 Minuten sehr weich kochen und dann gut abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gemüse zurück in den Topf geben, Butter und Milch hinzufügen und zu einer stückig-glatten Konsistenz stampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Salz, Pfeffer und Muskatnuss würzen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kielbasa-Scheiben in einer separaten Pfanne 3–4 Minuten bräunen, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hutspot auf vier Teller verteilen und mit warmen Kielbasa-Scheiben belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
