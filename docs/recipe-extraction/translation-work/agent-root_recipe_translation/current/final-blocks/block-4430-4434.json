      "steps": [
        {
          "position": 0,
          "text": "Butter und braunen Zucker etwa 3 Minuten hell und luftig schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ei und Vanilleextrakt einrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Zimt, Nelken, Ingwer, Backpulver und Salz in einer separaten Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trockene Zutaten unter die Buttermischung rühren, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig zwischen Backpapier 1/4 Zoll dick ausrollen und 20 Minuten kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Rechtecke oder festliche Formen schneiden und auf Backbleche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 350 °F 12–15 Minuten goldbraun und fest backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten auf dem Blech abkühlen lassen und dann auf ein Kuchengitter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
