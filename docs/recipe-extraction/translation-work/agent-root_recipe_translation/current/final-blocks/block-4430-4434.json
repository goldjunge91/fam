      "steps": [
        {
          "position": 0,
          "text": "Schlagsahne erhitzen, bis sie dampft, dann über gehackte Zartbitterschokolade gießen und 2 Minuten stehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schokolade und Sahne glatt verrühren, dann Butter und Vanilleextrakt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ganache 1 Stunde im Kühlschrank kühlen, bis sie fest genug zum Portionieren ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit einem Melonenausstecher oder Teelöffel kleine Ganachekugeln formen und auf Backpapier legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Milchschokolade mit Kokosöl im Wasserbad schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Ganachekugel mit einer Gabel in geschmolzene Milchschokolade tauchen und vollständig überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Überzogene Pralinen zurück auf das Backpapier legen und 30 Minuten kühlen, bis sie fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mit Kakaopulver oder Puderzucker bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
