      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 325 °F vorheizen und Sahne sowie Milch in einem Topf erhitzen, bis sie dampfen, aber nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eigelb mit Zucker und Salz 2 Minuten hell aufschlagen, dann Vanilleextrakt langsam hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heiße Sahnemischung unter ständigem Rühren langsam in die Eigelbmischung gießen, um die Eier anzugleichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Creme durch ein feinmaschiges Sieb in eine Schüssel gießen, um Stückchen zu entfernen, und auf vier Förmchen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Förmchen in eine Auflaufform stellen, heißes Wasser bis zur halben Höhe der Förmchen zugießen und 25–30 Minuten backen, bis die Creme gestockt, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Förmchen aus dem Wasserbad nehmen, auf Raumtemperatur abkühlen lassen und mindestens 2 Stunden im Kühlschrank kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kurz vor dem Servieren jedes Förmchen gleichmäßig mit braunem Zucker bestreuen und mit einem Küchenbrenner goldbraun und blasig karamellisieren. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
