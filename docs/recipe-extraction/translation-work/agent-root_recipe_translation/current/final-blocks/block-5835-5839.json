      "steps": [
        {
          "position": 0,
          "text": "Lege fertilized duck egg in a Topf und cover completely mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Salz, ginger, und Knoblauch to the Wasser für flavoring.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bring Wasser to a boil, then reduce to a gentle köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche für 16-18 Minuten depending on the age of the embryo (older eggs Koche longer).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Remove egg mit a slotted spoon und Lege on a plate to cool für 2-3 Minuten bis handleable.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gently tap und crack open the larger end of the eggshell.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sip the warm broth von inside the egg, then scoop out the soft contents mit a small spoon und eat mit Salz und vinegar dip.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Discard the shell und any remaining hard parts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
