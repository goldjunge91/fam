      "steps": [
        {
          "position": 0,
          "text": "Soak tofu skin sheets in warm Wasser für 5 Minuten bis pliable, then pat dry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 tbsp Öl in a Pfanne und Koche gemahlen Schweinefleisch mit Knoblauch und ginger bis browned.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib diced mushrooms und Koche für 3 Minuten, then rühre in 2 tbsp soy Sauce und sesame Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege 2-3 tbsp filling on each tofu skin sheet, roll tightly, und fold in sides.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege rolls seam-Seite down in a greased baking dish und backe at 375°F für 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mische 1/2 cup Wasser, 1 tbsp soy Sauce, und cornstarch into a Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pour Sauce over rolls und backe für another 10 Minuten bis Sauce thickens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "garniere mit green onions und Serviere hot.",
          "timerMinutes": null,
