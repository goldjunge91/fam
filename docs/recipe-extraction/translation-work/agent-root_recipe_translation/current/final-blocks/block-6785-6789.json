      "steps": [
        {
          "position": 0,
          "text": "Mehl, Wasser, Hefe, Salz und Zucker verrühren, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "10 Minuten lang kneten, bis der Teig glatt und elastisch ist, dann 1 Stunde gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 8 gleich große Stücke und rollen Sie jedes zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit dem Daumen durch jede Kugel ein Loch drücken und sie vorsichtig zu einem Bagel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lassen Sie die Bagels 45 Minuten lang auf Backpapier gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Einen großen Topf mit Wasser zum Kochen bringen und den Honig einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jeden Bagel auf jeder Seite 30 Sekunden kochen und anschließend auf ein mit Backpapier belegtes Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 425 °F 20–25 Minuten backen, bis die Bagel goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
