      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Makkaroni in kochendem Salzwasser 2 Minuten kürzer als auf der Packung angegeben und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz die Butter in einem großen Topf bei mittlerer Hitze, rühre das Mehl ein und gare die Mehlschwitze 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die Milch nach und nach ein und rühre ständig, bis die Sauce eindickt, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd, rühre den geriebenen Cheddar ein, bis er geschmolzen und die Sauce glatt ist, und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die gekochten Makkaroni unter die Käsesauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Mischung in eine gefettete Auflaufform mit den Maßen 9 × 13 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermenge Panko-Paniermehl mit Parmesan, streue es darüber und backe den Auflauf 15–18 Minuten, bis er goldbraun ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
