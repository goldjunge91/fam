      "steps": [
        {
          "position": 0,
          "text": "Koche die Reisnudeln nach Packungsanleitung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einem Wok oder einer großen Pfanne bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den gehackten Knoblauch und die geschnittenen Chilischoten hinein und brate sie 30 Sekunden unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hähnchenhackfleisch dazu und brate es unter Rühren etwa 5–6 Minuten gar. Zerteile es dabei in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gewürfelte Paprika dazu und gare sie weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Sojasauce, Fischsauce und Limettensaft in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die gekochten Nudeln und die Sauce in den Wok und vermenge alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Wok vom Herd und hebe kurz vor dem Servieren die frischen Basilikumblätter unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
