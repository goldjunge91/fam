      "steps": [
        {
          "position": 0,
          "text": "Weizenmehl, Vollkornmehl, Salz, Kreuzkümmel und Ajowansamen in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl und Wasser nach und nach hinzufügen und kneten, bis ein weicher, glatter Teig entsteht, dann 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 6 gleich große Portionen teilen und jede zu einem dünnen Kreis mit etwa 8 Zoll Durchmesser ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geschmolzene Butter auf dem Teigkreis verstreichen, Koriander darüberstreuen, den Teig dann eng zu einer Rolle aufrollen und zu einer Spirale wickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Spirale vorsichtig mit der Hand flach drücken und zu einem 1/4-Zoll dicken Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittlerer bis hoher Hitze erhitzen und ein Paratha hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Etwa 1-2 Minuten braten, bis hellbraune Flecken entstehen, dann wenden und mit Butter bestreichen; mit einem Pfannenwender andrücken, bis es aufgegangen und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erneut wenden, mit Butter bestreichen und weitere 30 Sekunden braten, bis es knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf einen Teller geben und heiß mit Curry oder Joghurt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
