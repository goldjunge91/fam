      "steps": [
        {
          "position": 0,
          "text": "Tempehscheiben 10 Minuten dämpfen, um die Bitterkeit zu entfernen, dann kurz abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kurkuma, Salz, Knoblauch und Ingwer in einer kleinen Schüssel zu einer Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Kurkumapaste auf beide Seiten jeder Tempehscheibe reiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und die Tempehscheiben portionsweise vorsichtig 2-3 Minuten pro Seite braten, bis sie goldbraun und knusprig sind, dann auf Küchenpapier legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Im selben Öl Schalotten und Chilischoten braten, bis sie duften und leicht knusprig sind, etwa 2 Minuten, dann herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gebratenen Tempeh auf einem Teller anrichten, mit Schalotten und Chilischoten belegen und anschließend mit Sojasauce und Limettensaft beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
