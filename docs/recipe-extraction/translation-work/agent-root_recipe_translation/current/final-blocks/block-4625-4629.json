      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 425°F vorheizen und eine 10-Zoll-Gusseisenpfanne oder runde Backform mit 3 Esslöffel Olivenöl 5 Minuten im Ofen erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kichererbsenmehl mit Wasser in einer Schüssel glatt und klümpchenfrei verquirlen, dann Salz, Pfeffer, Knoblauch und Rosmarin einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig vorsichtig in die heiße, geölte Pfanne gießen und das restliche Olivenöl darüberträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nach Wunsch dünn geschnittene Zwiebel über dem Teig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "15-18 Minuten backen, bis die Oberfläche goldbraun und die Ränder dunkel und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen und vor dem Schneiden in Stücke 2-3 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm mit einem Spritzer Zitronensaft und nach Wunsch zusätzlichem Pfeffer servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
