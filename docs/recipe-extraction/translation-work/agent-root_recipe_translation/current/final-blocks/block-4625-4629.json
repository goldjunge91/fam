      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und Kreuzkümmelsamen hinzufügen, sodass sie 10 Sekunden knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geschnittene Zwiebeln hinzufügen und 3-4 Minuten anbraten, bis sie weich werden und sich goldbraun färben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fein gehackten Knoblauch einrühren und 30 Sekunden braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffelstifte, Kurkuma, Chilipulver und Salz hinzufügen und gut umrühren, damit das gesamte Gemüse bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "12-15 Minuten ohne Deckel garen, gelegentlich umrühren, bis die Kartoffeln weich und die Zwiebeln kräftig karamellisiert und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und Koriander und Limettensaft einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß als Beilage oder Snack servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
