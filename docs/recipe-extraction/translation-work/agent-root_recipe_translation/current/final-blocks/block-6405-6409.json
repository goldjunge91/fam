      "steps": [
        {
          "position": 0,
          "text": "Butter in einem Topf bei mittlerer Hitze schmelzen, dann Mehl unterrühren, bis eine Mehlschwitze entsteht; 2 Minuten unter Rühren kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Unter ständigem Rühren nach und nach Milch hinzufügen, um Klumpen zu vermeiden; Kochen und rühren Sie weiter, bis die Soße eindickt, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jamón fein würfeln und unter die Béchamelsoße heben; Mit Salz und weißem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung auf einem mit Backpapier ausgelegten Backblech verteilen und 30 Minuten lang abkühlen lassen. Anschließend 1 Stunde lang in den Kühlschrank stellen, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aus der abgekühlten Masse 12–16 Kroketten von etwa 2 Zoll Länge formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier in einer Schüssel schlagen; Semmelbrösel in eine andere Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tauchen Sie jede Krokette in geschlagenes Ei und bestreichen Sie sie anschließend gründlich mit Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen. Die Kroketten portionsweise 2–3 Minuten goldbraun frittieren und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß mit Zitronenspalten oder Aliolisauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
