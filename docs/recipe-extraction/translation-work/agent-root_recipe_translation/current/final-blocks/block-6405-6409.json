          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinefleisch auf einen Teller legen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch in die Pfanne geben und 30 Sekunden lang kochen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Paprika über die Pfanne streuen und umrühren, dann Weißwein und Zitronensaft hinzufügen; Kratzen Sie alle gebräunten Stücke ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie das Schweinefleisch wieder in die Pfanne und schwenken Sie es vorsichtig 1–2 Minuten lang in der Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Servierteller verteilen und die Soße über das Fleisch löffeln; heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
