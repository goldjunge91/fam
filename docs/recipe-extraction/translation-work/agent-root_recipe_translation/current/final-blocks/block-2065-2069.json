      "steps": [
        {
          "position": 0,
          "text": "Gib Mehl, Eier, Milch, 1 tbsp Öl und eine Prise Salz in eine Schüssel oder einen großen Messbecher und verrühre alles mit dem Schneebesen zu einem glatten Teig. Lasse den Teig nach Möglichkeit 30 mins ruhen oder beginne sofort mit dem Ausbacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine mittelgroße Pfanne oder Crêpepfanne bei mittlerer Hitze und wische sie vorsichtig mit etwas geöltem Küchenpapier aus. Backe die Pfannkuchen in der heißen Pfanne jeweils 1 min pro Seite goldbraun und halte sie währenddessen im niedrigen Ofen warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Serviere die Pfannkuchen mit Zitronenspalten und Zucker oder deiner Lieblingsfüllung. Nach dem Abkühlen kannst du sie mit Backpapier dazwischen stapeln, in Frischhaltefolie wickeln und bis zu 2 months einfrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
