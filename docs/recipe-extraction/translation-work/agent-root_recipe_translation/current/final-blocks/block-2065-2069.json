      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei hoher Hitze. Falls du eine Heißluftfritteuse verwendest, heize sie bei 205C für 3 Minuten vor. Brate die Paprika unter häufigem Rühren 5 Minuten, bis sie Blasen werfen und weich werden. Sie sollten weich und leicht verkohlt sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Paprika auf eine Servierplatte und würze sie mit Meersalz. Nach Wunsch mit Dips oder als Teil einer Tapas-Auswahl servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
