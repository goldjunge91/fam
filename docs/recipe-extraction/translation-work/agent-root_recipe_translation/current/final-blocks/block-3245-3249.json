      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Butter in einer 10-inch-Gusseisenpfanne bei mittlerer Hitze und brate Paprika und Zwiebel etwa 5 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Spinat dazu und gare ihn etwa 2 Minuten, bis er zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Eier, Schlagsahne, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Eiermischung über das Gemüse in der Pfanne und bestreue sie mit Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare die Frittata auf dem Herd 3 Minuten, bis die Ränder anfangen fest zu werden. Stelle die Pfanne dann in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Frittata 8-10 Minuten, bis die Mitte gerade gestockt und die Oberseite leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide sie in Stücke und serviere sie warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
