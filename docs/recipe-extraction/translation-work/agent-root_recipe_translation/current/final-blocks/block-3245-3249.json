      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und bestreiche Baguettescheiben auf beiden Seiten mit 1.5 tablespoons Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Brotscheiben 5-7 Minuten im Ofen, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die heißen gerösteten Brotscheiben sofort mit aufgeschnittenen Knoblauchzehen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische gewürfelte Tomaten, frisches Basilikum, das übrige Olivenöl, Balsamico-Essig, Salz und schwarzen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Tomatenmischung 3-5 Minuten stehen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib großzügig Tomatenbelag auf jedes mit Knoblauch eingeriebene Toaststück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sofort, solange das Brot noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
