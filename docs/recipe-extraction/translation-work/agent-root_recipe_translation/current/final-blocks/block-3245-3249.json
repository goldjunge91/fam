      "steps": [
        {
          "position": 0,
          "text": "Nimm den Lachs 10 Minuten vor dem Garen aus dem Kühlschrank, damit er Raumtemperatur erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe den Lachs mit Küchenpapier trocken und würze beide Seiten großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer Pfanne bei mittelhoher Hitze, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Lachs mit der Hautseite nach oben in die Pfanne und gare ihn 4 Minuten ohne ihn zu bewegen, bis die Haut knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende den Lachs und gib Butter, Thymian und Knoblauch in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare ihn 3 Minuten und beträufle die Filets dabei ununterbrochen mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse frischen Zitronensaft über den Lachs und serviere ihn sofort mit Pfannensauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
