      "steps": [
        {
          "position": 0,
          "text": "Teigboden",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Zucker, Vanille und Butter, bis die Masse hell und luftig ist. Rühre die Eigelbe ein. Gib Mehl und Backpulver dazu und knete den Teig mit den Händen glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wickle den Teig in Frischhaltefolie und kühle ihn mindestens 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mandelfüllung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mahle Mandeln und Zucker in einer Küchenmaschine zusammen, bis die Mandeln fein sind. Du kannst selbst entscheiden, wie grob oder fein du sie haben möchtest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Butter, Ei, Cognac und/oder Mandelextrakt, falls verwendet, ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zusammensetzen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege den Boden deiner Kuchenform mit Backpapier aus und fette die Seiten der Form ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heize den Ofen auf 350°F (175°C) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schneide 2/3 des Teigs in Scheiben und drücke sie in die Kuchenform. Bedecke den Boden mit Teig und ziehe den Teig 2-3 cm (1 inch) am Rand hoch. Drücke ihn gleichmäßig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Verteile die Mandelfüllung gleichmäßig auf dem Teigboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Rolle den restlichen Teig aus und schneide ihn in lange Streifen. Lege sie gitterförmig über den Kuchen. Falls Streifen brechen, drücke sie einfach wieder zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Bestreiche den Teig vorsichtig mit verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Backe den Kuchen etwa 45 Minuten. Die Oberfläche sollte goldbraun sein, während die Mandelfüllung weich bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
