      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen und eine 8 × 8 Zoll große Auflaufform leicht mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Apfelscheiben mit Zucker und Zimt vermengen und gleichmäßig in der Form verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Haferflocken, braunen Zucker, Mehl und Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kalte Butter in kleine Stücke schneiden und in die Hafermischung einarbeiten, bis grobe Streusel entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Streusel gleichmäßig über die Äpfel geben und leicht andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "35–40 Minuten backen, bis die Streusel goldbraun und die Äpfel beim Einstechen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen. Nach Wunsch mit Vanilleeis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
