      "steps": [
        {
          "position": 0,
          "text": "Den Reis nach Packungsanleitung kochen und leicht abkühlen lassen, bis er noch warm, aber gut formbar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salz und Wasser in einer kleinen Schüssel verrühren, um eine Salzwasserlösung für die Hände herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hände mit Salzwasser befeuchten. Eine Handvoll warmen Reis zwischen den Handflächen vorsichtig zu einem Dreieck formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In die Mitte eine kleine Vertiefung drücken, ein Stück Umeboshi-Pflaume oder Thunfisch-Mayonnaise hineinlegen und mit weiterem Reis bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vorsichtig zu einem festen Dreieck mit etwa 2 Zoll Seitenlänge formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nori in Streifen schneiden und um den unteren Teil jedes Onigiri wickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für die beste Konsistenz innerhalb von 2 Stunden bei Raumtemperatur oder leicht warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
