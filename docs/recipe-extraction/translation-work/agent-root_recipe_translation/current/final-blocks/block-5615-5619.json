      "steps": [
        {
          "position": 0,
          "text": "Die Garnelen schälen und entdarmen. Knoblauch und Schalotten fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und den Knoblauch etwa 30 Sekunden anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Garnelen dazugeben und je Seite 2 Minuten braten, bis sie rosa werden. Auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne 2 Esslöffel Butter schmelzen und Schalotten sowie Champignons etwa 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Weißwein ablöschen, die Bratrückstände lösen und 3 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sahne einrühren, 2 Minuten köcheln lassen und vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garnelen zurück in die Pfanne geben, Estragon hinzufügen und mit Salz und weißem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Mischung auf 4 feuerfeste Schalen oder Förmchen verteilen und mit Gruyère sowie Paniermehl bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit der restlichen Butter belegen und bei 400°F 10–12 Minuten goldbraun und blubbernd backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
