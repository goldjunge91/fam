      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und würze die Hähnchenstücke mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune das Hähnchen portionsweise von allen Seiten etwa 4 Minuten pro Seite an. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle Zwiebel und Paprika, hacke den Knoblauch und schneide die Pilze in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zwiebel und Knoblauch in die Pfanne und dünste sie 3 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Paprika und Pilze dazu und gare alles 5 Minuten, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Weißwein dazu und löse die Bratrückstände vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Hähnchen zurück in die Pfanne. Füge Tomaten aus der Dose samt Saft und italienische Gewürzmischung hinzu. Decke die Pfanne ab und lass alles 20-25 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Koche die Pasta nach Packungsanleitung und serviere sie mit dem Hähnchen Cacciatore.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
