      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweineschulter in 1 Zoll große Würfel und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine große Pfanne oder einen Schmortopf bei mittlerer bis hoher Hitze und bräune die Fleischwürfel insgesamt etwa 5-6 Minuten von allen Seiten an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle die Zwiebel, gib sie in die Pfanne und dünste sie 3 Minuten an, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Ketchup, Melasse, braunen Zucker, Essig, Senf und Worcestersauce in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Schweinefleisch zurück in die Pfanne, gieße die Sauce darüber und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Bohnen aus der Dose ab, spüle sie ab, gib sie in die Pfanne und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze auf niedrige Stufe, decke die Pfanne ab und lass alles 30 Minuten köcheln. Rühre gelegentlich um, bis das Fleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere das Gericht heiß auf Reis oder mit Maisbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
