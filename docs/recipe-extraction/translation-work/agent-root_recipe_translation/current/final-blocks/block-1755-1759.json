      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 120C/225F/gas mark 1 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Fleisch aus dem Kühlschrank, damit es nicht mehr kalt ist. Zerkleinere Zwiebeln und Knoblauch in einer Küchenmaschine fein. Erhitze 2 tbsp Olivenöl in einem großen Schmortopf und brate das Fleisch rundum goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle das Fleisch beiseite und gib etwas weiteres Öl in den Topf, um die Chorizo anzubraten. Nimm sie heraus. Gib Zwiebel und Knoblauch, Gewürze, Kräuter und Chilis in das Chorizo-Fett und gare sie weich. Würze mit Salz und Pfeffer und gib Essig, Tomaten, Ketchup und Zucker dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib alles Fleisch zurück in den Topf, füge 400ml Wasser (oder nach Wunsch Rotwein) hinzu und bringe es zum Köcheln. Gare zugedeckt im niedrigen Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Prüfe das Fleisch nach 2 hours und gib die Bohnen hinzu. Gare alles eine weitere hour. Zerpflücke das Fleisch kurz vor dem Servieren mit zwei Gabeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
