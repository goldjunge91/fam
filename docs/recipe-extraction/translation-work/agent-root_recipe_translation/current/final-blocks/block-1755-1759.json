      "steps": [
        {
          "position": 0,
          "text": "Friere die Baconscheiben zuerst ein. So lassen sie sich später viel leichter hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasche die Kartoffeln und schneide sie in mittelgroße Würfel. Lege die geschnittenen Kartoffeln in eine Schüssel mit Wasser, damit sie nicht braun werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1-2 Esslöffel Öl in einer großen Pfanne bei mittlerer bis hoher Hitze. Neige die Pfanne, damit sich das Öl gleichmäßig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Kartoffeln ab und gib sie in die Pfanne. Würze sie nach Bedarf mit Salz, Pfeffer und Old Bay.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare die Kartoffeln 10 Minuten und rühre häufig um, bis sie gebräunt sind. Gib bei Bedarf einen weiteren Esslöffel Öl dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hacke den Speck und gib ihn zu den Kartoffeln. Er beginnt Fett abzugeben, das die Kartoffeln weitergart. Schwenke alles durch. Der Speck braucht 5-6 Minuten, bis er knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn der Speck gar ist, reduziere die Hitze auf mittelniedrig, gib gehackten Knoblauch dazu und schwenke alles durch. Erneut würzen. Getrocknete oder frische Petersilie dazugeben. Passe die Hitze bei Bedarf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Knoblauch etwa one Minute garen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Kurz vor dem Servieren Ahornsirup darüberträufeln und alles durchschwenken. Noch eine Minute garen, damit die Kartoffeln karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Warm in einer Schüssel mit einem Spiegelei servieren!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
