      ],
      "steps": [
        {
          "position": 0,
          "text": "Fette eine 1 litre/2 pint Auflaufform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Krusten vom Brot ab. Bestreiche jede Scheibe auf einer Seite mit Butter und schneide sie dann in Dreiecke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege eine Brotschicht mit der Butterseite nach oben in die Form und gib eine Schicht Sultaninen darauf. Streue etwas Zimt darüber und wiederhole die Brotschichten und Sultaninen, bis alles aufgebraucht ist. Mit einer Brotschicht abschließen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme Milch und Sahne in einem Topf bei niedriger Hitze bis kurz vor dem Kochen. Nicht kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Eier in eine Schüssel, gib three quarters des Zuckers dazu und verquirle alles leicht, bis die Masse blass wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die warme Milch-Sahne-Mischung dazu, verrühre alles gut und seihe die Creme in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Creme über die Brotschichten, streue Muskatnuss und den restlichen Zucker darüber und lass alles 30 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heize den Ofen auf 180C/355F/Gas 4 vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backe den Auflauf 30-40 Minuten, bis die Creme gestockt und die Oberfläche goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
