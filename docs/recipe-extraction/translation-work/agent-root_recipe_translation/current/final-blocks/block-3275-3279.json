          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib langsam Wasser dazu und rühre, bis ein glatter, dicker Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze die Idiyappam-Presse (oder Nudelmaschine für Reisnudeln), indem du kochendes Wasser hindurchgießt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle die Presse mit Teig und drücke ihn direkt in kreisförmigen Windungen auf einen gefetteten Dämpfeinsatz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dämpfe die Idiyappam 8-10 Minuten, bis sie gar und fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie vorsichtig mit einem Pfannenwender heraus und serviere sie heiß mit Sambar oder Curry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
