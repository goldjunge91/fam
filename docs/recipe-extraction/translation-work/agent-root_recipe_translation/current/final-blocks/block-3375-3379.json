      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Natron; knete mit Wasser einen festen Teig und lasse ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Ghee in einer schweren Pfanne bei mittlerer Hitze, gib Grieß hinzu und röste ihn 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Ghee hinzu und rühre 8-10 Minuten ständig, bis der Grieß hell goldbraun wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche in einem anderen Topf Wasser mit Zucker und Nelken 5 Minuten zu einem Sirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den heißen Sirup langsam unter ständigem Rühren zum gerösteten Grieß, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Mandeln und Rosinen ein und koche alles 2-3 Minuten, bis das Halwa eindickt. Stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Teile den Teig in 8 Portionen, rolle sie zu dünnen Kreisen aus und frittiere sie in Öl bei 375°F, bis sie aufgehen und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die heißen Puris mit Halwa als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
