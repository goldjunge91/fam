      "steps": [
        {
          "position": 0,
          "text": "Vermische Kichererbsenmehl, Wasser, Salz, Kurkuma und rotes Chilipulver zu einem dickflüssigen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe grüne Chili und Koriander unter den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Wok auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tauche Zwiebelringe in den Teig und bedecke sie auf beiden Seiten gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die panierten Zwiebelringe vorsichtig portionsweise zu 5-6 Stück ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere jede Portion 2-3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pakora mit einer Schaumkelle heraus und lasse sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit grünem Chutney, Tamarinden-Chutney oder Ketchup servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
