      "steps": [
        {
          "position": 0,
          "text": "Säubere die Lammfüße gründlich unter fließendem Wasser und hacke sie in 2 Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blanchiere die Füße 5 Minuten in kochendem Wasser, gieße sie ab und spüle sie gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf mit schwerem Boden bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zwiebel hinzu und gare sie 5 Minuten goldbraun. Füge dann Ingwer und Knoblauch hinzu und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomate hinzu und gare sie 3 Minuten weich. Füge dann die Gewürze hinzu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die blanchierten Füße in den Topf und brate sie unter gelegentlichem Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße 8 Tassen Wasser hinzu, bringe alles zum Kochen, reduziere die Hitze und lasse es zugedeckt 2.5-3 Stunden köcheln, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke mit Salz ab und garniere das Gericht vor dem Servieren mit frischem Koriander; serviere es mit Naan oder Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
