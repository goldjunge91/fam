      "steps": [
        {
          "position": 0,
          "text": "Nehmen Sie die Picanha 30 Minuten vor dem Garen aus dem Kühlschrank, um sie auf Raumtemperatur zu bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Fettkappe kreuzweise einschneiden, ohne in das Fleisch einzuschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reiben Sie das gesamte Steak auf beiden Seiten großzügig mit grobem Meersalz und schwarzem Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einer großen gusseisernen Pfanne oder auf dem Grill auf hoher Hitze erhitzen, bis es raucht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Legen Sie das Steak mit der Fettseite nach unten in die heiße Pfanne und braten Sie es 6–7 Minuten lang an, damit das Fett knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drehen Sie das Steak um und braten Sie es auf der Fleischseite 5–6 Minuten lang an, um einen mittel-seltenen Gargrad zu erreichen. Geben Sie dann Knoblauch und Rosmarin in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen, locker mit Folie abdecken und 8 Minuten ruhen lassen, bevor man es gegen die Faserrichtung aufschneidet und frischen Limettensaft darüber drückt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
