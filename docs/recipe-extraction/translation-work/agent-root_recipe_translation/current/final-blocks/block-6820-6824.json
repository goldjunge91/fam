      "steps": [
        {
          "position": 0,
          "text": "Spülen Sie die Spalterbsen unter kaltem Wasser ab, bis das Wasser klar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einem großen Topf 4 Tassen Wasser zum Kochen bringen und das abgespülte Dal, Kurkuma und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduzieren Sie die Hitze auf mittlere Stufe und lassen Sie es 25–30 Minuten köcheln, bis das Dal weich ist und leicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ghee in einer kleinen Pfanne bei mittlerer Hitze erhitzen, Kreuzkümmel hinzufügen und etwa 30 Sekunden lang knistern lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gehackten Knoblauch und gewürfelte Zwiebeln zum Ghee geben und ca. 5 Minuten kochen, bis die Zwiebeln goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die getrockneten roten Chilis in die Pfanne geben und 1 Minute kochen lassen, dann die gesamte Mischung in das gekochte Dal gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gut umrühren, Zitronensaft hinzufügen und vor dem Servieren mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
