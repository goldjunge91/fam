      "steps": [
        {
          "position": 0,
          "text": "Koche geschälte und gewürfelte Kartoffeln etwa 15 Minuten in Salzwasser, bis sie gabelzart sind. Lass sie abtropfen und zerstampfe sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Rinderhackfleisch in einer Pfanne an. Gib Sofrito, Oliven, Rosinen, Salz und Pfeffer hinzu und gare alles 5 Minuten, bis das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Kartoffelpüree mit Ei und Salz zu einer glatten, formbaren Masse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme etwas Kartoffelmasse in deiner Handfläche zu einer kleinen Mulde. Fülle einen Esslöffel Rindfleischfüllung hinein und bedecke sie vollständig mit weiterer Kartoffelmasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wälze die gefüllte Kugel rundherum leicht in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und frittiere die Rellenos pro Seite 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Ketchup oder scharfer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
