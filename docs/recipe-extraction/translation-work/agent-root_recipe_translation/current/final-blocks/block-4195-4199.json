      "steps": [
        {
          "position": 0,
          "text": "Schäle die grünen Kochbananen: Schneide die Enden ab, ritze die Schale längs ein und ziehe sie vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die geschälten Kochbananen mit der groben Seite einer Vierkantreibe in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerdrücke Knoblauchzehen mit Salz zu einer Paste und vermische sie mit den geriebenen Kochbananen und Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne bei mittelhoher bis hoher Hitze auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib löffelweise Kochbananenmasse in das heiße Öl und drücke sie mit der Rückseite eines Löffels zu dünnen, spitzenartigen Küchlein flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere sie pro Seite 2 Minuten goldbraun und knusprig und lasse sie dann auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort knusprig servieren, nach Wunsch mit etwas frischem Limettensaft.",
