      "steps": [
        {
          "position": 0,
          "text": "Schneide das Rindfleisch in mundgerechte Stücke und würze es mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher bis hoher Hitze und bräune das Rindfleisch insgesamt etwa 8 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Sofrito und gehackten Knoblauch hinzu und rühre 1 Minute ständig, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Rinderbrühe hinzu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse es zugedeckt 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schäle die Yuca und schneide sie in 1-inch große Stücke. Schäle die Kochbananen und schneide sie ebenfalls in 1-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Yuca und Kochbananen in den Topf und lasse alles zugedeckt 15 Minuten köcheln, bis das Gemüse weich und das Rindfleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre frischen Koriander unter, probiere das Gericht und schmecke es bei Bedarf mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle das Gericht in Schalen und serviere es heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
