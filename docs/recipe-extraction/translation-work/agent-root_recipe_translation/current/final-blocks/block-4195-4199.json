      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kochbananen und schneide sie längs in dünne Streifen. Frittiere sie in 350°F heißem Öl pro Seite 2 Minuten, bis sie goldbraun und biegsam sind. Lasse sie anschließend abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Rinderhackfleisch in einer Pfanne an. Gib Sofrito, Oliven, Rosinen und Rinderbrühe hinzu und lasse alles 5 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege zwei frittierte Kochbananenstreifen kreuzweise und überlappend auf einen Teller, sodass ein Kreis entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib einen großzügigen Löffel Rindfleischfüllung in die Mitte und falte die Kochbananenstreifen nach oben und darum, sodass ein Nest entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle das Ei in einer kleinen Schüssel und tauche die gefüllten Piononos vorsichtig hinein, damit sie leicht überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die in Ei getauchten Piononos in 350°F heißem Öl 2-3 Minuten, bis die Eihülle goldbraun und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß, nach Wunsch mit zusätzlicher Sofrito-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
