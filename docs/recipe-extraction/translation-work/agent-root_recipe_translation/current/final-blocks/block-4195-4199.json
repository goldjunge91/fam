      "steps": [
        {
          "position": 0,
          "text": "Schäle und reibe Bananen, Kochbananen, Taro und Yuca in eine große Schüssel. Drücke anschließend überschüssige Flüssigkeit aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Schweinehackfleisch in einem Topf. Gib Sofrito, Oliven und Rosinen hinzu und gare die Füllung 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erweiche Kochbananenblätter über einer Flamme oder in heißem Wasser. Lege dann zwei überlappende Blätter auf eine flache Fläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile 3 Esslöffel der Gemüsemischung in der Mitte der Blätter und gib 2 Esslöffel Schweinefleischfüllung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falte die Blätter zu einem rechteckigen Päckchen um die Füllung und wickle es dann in Alufolie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Schweinebrühe in einem großen Topf zum Kochen und gib die Pasteles vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche sie 30-35 Minuten, bis sie fest und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
