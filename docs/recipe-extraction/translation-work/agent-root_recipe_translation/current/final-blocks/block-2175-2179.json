      "steps": [
        {
          "position": 0,
          "text": "Hering mindestens 1 Stunde in kaltem Wasser einweichen. Wenn er sehr salzig ist, Vorgang wiederholen und das Wasser jedes Mal wechseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gründlich abtropfen lassen und Hering in mundgerechte Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In ein ausreichend großes Glas geben, mit Öl bedecken und Piment, Pfefferkörner sowie Lorbeerblatt hinzufügen. Glas verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vor dem Essen 2 bis 3 Tage im Kühlschrank ziehen lassen. Gekühlt bis zu 2 Wochen haltbar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit fein gehackter Zwiebel oder Zwiebelringen, Zitrone und Petersilie oder Dill servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
