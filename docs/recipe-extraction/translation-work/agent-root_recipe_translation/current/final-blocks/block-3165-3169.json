      "steps": [
        {
          "position": 0,
          "text": "Schneide Kartoffeln in 1-Zoll-Würfel und teile den Blumenkohl in Röschen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und gib Kreuzkümmelsamen hinein. Gare sie etwa 30 Sekunden, bis sie zischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Zwiebel, gehackten Knoblauch und Ingwer hinzu und dünste alles etwa 6 Minuten, bis die Zwiebel goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Kurkuma und Korianderpulver ein und gare alles 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kartoffelwürfel hinzu, rühre um, sodass sie mit Gewürzen überzogen sind, und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Blumenkohlröschen hinzu und rühre gut um. Reduziere dann die Hitze auf mittel und decke die Pfanne ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles 15-18 Minuten unter gelegentlichem Rühren, bis die Kartoffeln zart und der Blumenkohl gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Pfeffer, garniere mit Koriander und serviere das Gericht mit Reis oder Roti.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
