      ],
      "steps": [
        {
          "position": 0,
          "text": "Schalotten und Champignons fein hacken, dann in Butter bei mittlerer Hitze 3–4 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streuen Sie Mehl über das Gemüse und rühren Sie es 2 Minuten lang ständig um, um den Rohmehlgeschmack zu beseitigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nach und nach Fischbrühe unter Rühren hinzufügen, um Klumpenbildung zu vermeiden, dann 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weißwein hinzufügen und weitere 3 Minuten köcheln lassen, um ihn leicht zu reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einer kleinen Schüssel Eigelb und Sahne verquirlen, dann langsam die scharfe Soße in die Eier geben und dabei ständig rühren, um sie zu temperieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Eiermischung zurück in den Topf gießen und bei geringer Hitze 2–3 Minuten ständig rühren, bis die Sauce eindickt. Sie darf nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz, weißem Pfeffer und Zitronensaft würzen und dann durch ein feines Sieb passieren, wenn Sie eine glattere Sauce bevorzugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
