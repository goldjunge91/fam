      "steps": [
        {
          "position": 0,
          "text": "Schrubben Sie Muscheln unter fließendem kaltem Wasser, entfernen Sie die Bärte von den Muscheln und entsorgen Sie alle offenen Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schalotten fein hacken und bei mittlerer Hitze in einen großen Topf mit Butter und Weißwein geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Muscheln und Venusmuscheln hinzufügen, abdecken und 5–7 Minuten garen, bis sich die Schalen öffnen. Den Topf gelegentlich schütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen und Austern hinzufügen, wieder abdecken und weitere 3–4 Minuten kochen, bis die Garnelen rosa sind und sich die Austernschalen öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Entsorgen Sie alle ungeöffneten Schalen und geben Sie dann alle Meeresfrüchte mit einem Schaumlöffel auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restliche Flüssigkeit im Topf 2 Minuten lang kochen lassen, bis sie leicht eingekocht ist, dann über die Meeresfrüchte gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Großzügig mit frischer Petersilie und Zitronenschnitzen garnieren und sofort mit knusprigem Brot zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
