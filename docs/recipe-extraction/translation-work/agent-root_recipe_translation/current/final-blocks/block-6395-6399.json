        {
          "position": 1,
          "text": "Buttermilch oder Sauerrahm hinzufügen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Locker abdecken und bei Zimmertemperatur von 65–75 °F 12–24 Stunden stehen lassen, bis die Creme dick und leicht säuerlich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
