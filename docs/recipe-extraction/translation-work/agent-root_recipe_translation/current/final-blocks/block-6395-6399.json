      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie Muscheln, indem Sie sie unter kaltem Wasser schrubben, die Bärte entfernen und alle offenen Muscheln entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schalotte fein hacken und mit der Hälfte der Butter, Weißwein und Fischfond in eine breite Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Muscheln hinzufügen, abdecken und 4–5 Minuten dämpfen, bis sie sich öffnen, dann mit einem Schaumlöffel herausnehmen und beiseite stellen, alle ungeöffneten Muscheln wegwerfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Steinbuttfilets trocken tupfen, mit Salz und Pfeffer würzen und dann vorsichtig in die kochende Pochierflüssigkeit geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Filets 6–8 Minuten leicht köcheln lassen, bis sie gerade gar sind, in den letzten 2 Minuten Garnelen hinzufügen und dann vorsichtig auf warme Servierteller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restliche Pochierflüssigkeit auf die Hälfte einkochen lassen. Vom Herd nehmen und Sahne sowie übrige Butter einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gießen Sie die Soße um den Fisch, legen Sie Muscheln und Garnelen darauf, garnieren Sie ihn mit frischer Zitrone und servieren Sie ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
