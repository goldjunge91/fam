      "steps": [
        {
          "position": 0,
          "text": "Ausstattung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "6QT Schnellkochtopf",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Anleitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spüle das Ziegenfleisch mit Essig und Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze das Fleisch mit 1 ½ Esslöffel Currypulver, Allzweckgewürz, gemahlenem Ingwer, Piment, Zwiebel, Knoblauchzehen und Thymian. Lasse es mindestens 4 hours oder bis über Nacht marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm Zwiebel und Knoblauch vom Fleisch und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle einen elektrischen Schnellkochtopf, zum Beispiel einen Instant Pot, auf hohe Sauté-Stufe und gib Öl hinein. Bräune das Fleisch etwa 2-3 Minuten pro Seite. Nimm es aus dem Einsatz, gib 1 Esslöffel Öl und das restliche Currypulver hinein und brate alles etwa 10 seconds an. Gib anschließend Zwiebeln und Knoblauch dazu und brate sie weich, etwa 4 Minuten. Wenn die Zwiebeln trocken wirken, gib etwas Wasser hinzu und brate weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Fleisch und Wasser in den Schnellkochtopf und verschließe ihn. Koche alles 40 Minuten bei hohem Druck. Lasse den Druck 10 Minuten auf natürliche Weise ab, dann lasse den restlichen Druck ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sobald der gesamte Druck abgebaut ist, öffne den Schnellkochtopf. Stelle ihn 10-15 Minuten auf Sauté, gib Kartoffeln und eine ganze Scotch-Bonnet-Chili hinzu und koche, bis die Kartoffeln weich sind. Entferne die Scotch-Bonnet-Chili.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
