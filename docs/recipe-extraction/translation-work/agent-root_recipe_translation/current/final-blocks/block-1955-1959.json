      "steps": [
        {
          "position": 0,
          "text": "Anleitung",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle den Instant Pot auf „Sauté“. Sobald er heiß ist, gib Olivenöl hinein. Füge gelbe Zwiebel hinzu und rühre etwa 3 Minuten, bis sie weich ist. Gib Knoblauch und Frühlingszwiebeln dazu und rühre etwa 30 Sekunden weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke am Instant Pot auf „Cancel“. Gib Reis, Kokosmilch, Wasser, Salz, Piment und schwarzen Pfeffer hinein und rühre um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Kidneybohnen samt Flüssigkeit auf die Reismischung. Nicht umrühren. Lege Thymianzweige darauf. Verschließe den Instant Pot und stelle sicher, dass das Ventil auf „Sealing“ steht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke am Instant Pot auf „Manuell“ oder „Druckgaren“ und stelle den hohen Druck für 6 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wenn die Druckgarzeit vorbei ist, lasse den Druck 10 Minuten auf natürliche Weise ab, dann lasse den restlichen Druck schnell ab, indem du das Ventil auf „Venting“ stellst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öffne den Deckel und entferne die Thymianzweige. Lockere den Reis mit einer Gabel auf und genieße ihn!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Anleitung für den Herd",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze. Gib gelbe Zwiebel hinzu und rühre etwa 3 Minuten, bis sie weich ist. Gib Knoblauch und Frühlingszwiebeln dazu und rühre etwa 30 Sekunden weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gib Reis, Kidneybohnen samt Flüssigkeit, Kokosmilch, Wasser, Salz, Piment und schwarzen Pfeffer hinzu und rühre alles durch. Lege Thymian darauf. Bringe die Mischung zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Decke den Topf ab und reduziere die Hitze auf niedrig. Koche alles 18 Minuten bei niedriger Hitze und nimm den Topf dann vom Herd. Lasse den Deckel weitere 5 Minuten geschlossen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Öffne den Deckel, entferne den Thymian und lockere den Reis mit einer Gabel auf. Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
