      "steps": [
        {
          "position": 0,
          "text": "Erhitze einen Topf mit schwerem Boden und mindestens 3 inches Öl oder verwende eine Fritteuse. Erhitze das Öl bei mittlerer Hitze, bis es 350 Grad Fahrenheit erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Weizenmehl, Maismehl, Kristallzucker, Backpulver und Salz in eine große Schüssel und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Vanilleextrakt und Milch dazu und rühre, bis ein Teig entsteht. Forme die Mischung anschließend mit den Händen leicht zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zupfe Teigstücke ab und rolle sie zu länglichen ovalen Formen. Forme etwa 12 Klöße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald das Öl 350 Grad Fahrenheit erreicht hat, frittiere den Teig von allen Seiten, bis er goldbraun ist. Das dauert etwa 4-6 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Klöße heraus und lasse überschüssiges Fett abtropfen. Servieren und genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
