      "steps": [
        {
          "position": 0,
          "text": "Preheat Ofen zu 325°F und grease ein 9x13-inch Backen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "vermengen Haferflocken, Mehl, Ingwer, Natron, und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "in ein saucepan, melt Butter bei niedriger Hitze und umrühren in brown Zucker und molasses bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "gießen der Butter Mischung in der dry ingredients und mischen bis well combined und crumbly.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Press der Mischung firmly in der vorbereitet Backen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "backen für 25-30 Minuten bis lightly golden brown und ein toothpick inserted in der center comes out clean.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "abkühlen in der Pfanne für 10 Minuten, dann schneiden in squares.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "in einem luftdichten Behälter aufbewahren für up zu one week.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
