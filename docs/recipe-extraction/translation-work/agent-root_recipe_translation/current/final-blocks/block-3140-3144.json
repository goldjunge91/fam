      "steps": [
        {
          "position": 0,
          "text": "Koche Lo-Mein-Nudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einem großen Wok oder einer Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch und Ingwer dazu und brate sie unter Rühren etwa 30 Sekunden an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Paprika, Brokkoli und Karotten dazu und brate das Gemüse 4-5 Minuten unter Rühren, bis es bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochte Nudeln, Sojasauce und Sesamöl dazu und vermenge alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue das Gericht mit gehackten Frühlingszwiebeln und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
