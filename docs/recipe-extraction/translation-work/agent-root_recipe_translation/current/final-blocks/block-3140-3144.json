      "steps": [
        {
          "position": 0,
          "text": "Klopfe Schweineschnitzel auf 1/4 inch Dicke und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schalen mit Mehl, verquirltem Ei und Panko-Paniermehl bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Schnitzel erst in Mehl, dann in Ei und anschließend in Panko. Drücke die Brösel leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere die Schnitzel 3-4 Minuten pro Seite goldbraun. Lasse sie dann auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische Mayonnaise mit Tonkatsu-Sauce und bestreiche damit zwei Brotscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Belege das bestrichene Brot mit fein geschnittenem Kohl, lege das frittierte Schnitzel darauf und decke es mit der übrigen Brotscheibe ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
