      "steps": [
        {
          "position": 0,
          "text": "Gare gewürfelte Pancetta in einem großen Topf bei mittlerer Hitze 3 Minuten, bis das Fett ausgelassen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Zwiebel, Karotte und Sellerie (Soffritto) dazu und gare alles 8 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Rinderhackfleisch dazu und brate es unter Zerteilen etwa 5 Minuten an, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Gib dann Weißwein dazu und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Milch dazu und lasse die Sauce bei niedriger Hitze 30-40 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche Tagliatelle nach Packungsanweisung, gieße sie ab und hebe 1 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische gekochte Tagliatelle mit Bolognese-Sauce und gib bei Bedarf Nudelwasser für die richtige Konsistenz hinzu. Bestreue das Gericht mit Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
