      "steps": [
        {
          "position": 0,
          "text": "Bereite Nudelteig zu, indem du Mehl und Eier auf einer sauberen Fläche vermischst. Knete ihn 10 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Ricotta, Parmesan, gehackten Spinat, Salz und Pfeffer in einer Schüssel zu einer Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig zwischen zwei Backpapierblättern sehr dünn aus und schneide ihn in 2-inch große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1 TL Füllung in die Mitte jedes Quadrats, falte es diagonal und drücke die Ränder mit einer Gabel fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und koche die Ravioli, bis sie aufsteigen. Koche sie dann weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Butter in einer Pfanne und schwenke die gekochten Ravioli vorsichtig darin. Richte sie auf Tellern an und gib Marinara-Sauce und Basilikum darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
