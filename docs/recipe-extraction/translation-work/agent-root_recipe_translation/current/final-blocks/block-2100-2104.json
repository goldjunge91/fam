      "steps": [
        {
          "position": 0,
          "text": "Verrühre Butter und Zucker in einer großen Schüssel mit einem elektrischen Mixer, bis die Masse hell ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Eier und Vanille hinzu und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl und Backpulver in einer anderen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre abwechselnd Mehlmischung und Milch unter die Buttermasse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Teig in eine gefettete Form von 13 inch by 9 inch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "AHORNSOẞE.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe Sirup, braunen Zucker, Sahne und Butter in einem großen Topf unter ständigem Rühren zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reduziere die Hitze und koche die Soße sanft 2 Minuten, bis sie etwas eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gieße die Soße vorsichtig über den Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Backe den Kuchen bei 325°f (160°c) etwa 35 Minuten oder bis er hellbraun ist und ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
