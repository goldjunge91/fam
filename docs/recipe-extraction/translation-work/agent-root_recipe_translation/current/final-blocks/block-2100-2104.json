      "steps": [
        {
          "position": 0,
          "text": "Schneide Kartoffeln und Karotten in kleine, gleichmäßige Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib sie in einen großen Topf und fülle ihn mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salz und Essig hinzu. Bringe alles bei mittlerer bis hoher Hitze zum Kochen, reduziere dann auf mittlere Hitze und koche etwa 15 Minuten weiter, bis die Kartoffeln gar sind. Gieße sie ab und lasse sie auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide währenddessen Würstchen und Gewürzgurken in kleine Würfel und hacke die Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide auch die hart gekochten Eier in kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falls du frischen Dill verwendest, hacke auch ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermische Kartoffeln, Karotten, Würstchen, Gewürzgurken, Erbsen und Frühlingszwiebeln in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Mayonnaise und Dill hinzu und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit Salz und Pfeffer abschmecken. Decke die Schüssel mit Frischhaltefolie ab und stelle den Salat vor dem Servieren mindestens 1 hour in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
