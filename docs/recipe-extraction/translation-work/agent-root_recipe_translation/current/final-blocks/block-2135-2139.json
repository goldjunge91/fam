      "steps": [
        {
          "position": 0,
          "text": "Halbiere den Kohl, entferne den harten Strunk und schneide ihn in dünne Streifen. Gib ihn mit allen übrigen Zutaten außer den Würstchen in einen großen Topf. Rühre 300ml Wasser sowie etwas Salz und Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe alles zum Köcheln, reduziere die Hitze, decke den Topf mit einem gut schließenden Deckel ab und koche den Kohl 1½ hrs sanft. Dabei häufig umrühren. Falls er zu trocken wird, gib etwas Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Kabanossi zur Kohlmischung, lege den Deckel auf und lasse alles 20 mins sanft köcheln. Nimm den Deckel ab und gare weitere 10 mins. Mit einfachem Kartoffelstampf oder Salzkartoffeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
