        },
        {
          "position": 1,
          "text": "Bedecke es mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe alles zum Kochen und lasse es 2 to 2 1/2 hours köcheln. Schöpfe dabei Verunreinigungen von der Oberfläche ab, damit die Brühe klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Falls dein Topf groß genug ist, gib das Gemüse und die Gewürze für die letzte Stunde der Garzeit hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mein Schmortopf war nicht groß genug für alles. Nur das Hähnchen und die übrigen Knochen passten hinein, daher habe ich Fleisch und Knochen die gesamte Garzeit gekocht, sie dann herausgenommen und Gemüse und Gewürze separat gegart.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seihe alles aus der Brühe ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entbeine das Hähnchen und zerteile das Fleisch in große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide die Karotten in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib Hähnchen und Karotten zurück in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Koche die Nudeln nach Packungsanweisung, falls du sie verwendest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib die Nudeln in eine Schüssel und schöpfe die heiße Suppe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
