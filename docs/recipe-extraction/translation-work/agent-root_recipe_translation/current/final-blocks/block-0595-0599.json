      ],
      "steps": [
        {
          "position": 0,
          "text": "Spüle den Jasminreis im Topf des Reiskochers unter kaltem Wasser ab, bis das Wasser größtenteils klar bleibt. Gieße ihn gut ab. So wird der fertige Reis locker und nicht klebrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die ganze Dose Kokosmilch in den Topf. Fülle die leere Dose dann etwa zu drei Vierteln mit Wasser und gieße dieses ebenfalls hinein. Rühre Salz und nach Wunsch Zucker ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre einmal um und streiche den Reis zu einer gleichmäßigen Schicht glatt. Die Flüssigkeit sollte bis zur oder knapp unter der Wasserlinie „2 cups rice“ des Reiskochers reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schließe den Deckel und starte einen normalen Garzyklus für weißen Reis. Öffne den Deckel währenddessen nicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass den Reis nach dem Umschalten auf Warmhalten 10 Minuten bei geschlossenem Deckel ruhen, damit die Kokosmilch vollständig aufgenommen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öffne den Deckel und lockere den Reis vorsichtig mit einer Gabel oder einem Reislöffel auf. Hebe dabei den besonders cremigen Kokosreis vom Boden unter. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
