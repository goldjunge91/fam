      ],
      "steps": [
        {
          "position": 0,
          "text": "Koche Brokkoli und Karotten in einem Topf mit kochendem Wasser, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Rindfleisch und die Kartoffeln 45 Minuten im Ofen. Prüfe die Kartoffeln regelmäßig, damit sie nicht zu weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für die Yorkshire Puddings:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 230 °C/Umluft 210 °C/Gasstufe 8 vor. Träufle etwas Sonnenblumenöl gleichmäßig in 2 Yorkshire-Puddingformen mit je 4 Mulden oder in eine beschichtete Muffinform mit 12 Mulden und stelle sie zum Erhitzen in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib für den Teig 140 g Weizenmehl in eine Schüssel und schlage vier Eier unter, bis die Masse glatt ist. Gieße nach und nach 200 ml Milch dazu und rühre weiter, bis keine Klümpchen mehr vorhanden sind. Würze mit Salz und Pfeffer. Fülle den Teig in einen Krug und nimm die heißen Formen aus dem Ofen. Gieße den Teig vorsichtig und gleichmäßig in die Mulden. Stelle die Formen zurück in den Ofen und backe die Puddings ohne sie zu bewegen 20–25 Minuten, bis sie aufgegangen und gebräunt sind. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte alles auf Tellern an und gib nach Wunsch Bratensauce dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
