      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 180 °C/Umluft 160 °C/Gasstufe 4 vor. Bereite die Latkes zu, indem du alle Zutaten vermischst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen beschichteten Pfanne. Gib die Mischung löffelweise hinein und forme sechs runde Latkes. Brate sie 4–5 Minuten pro Seite, lege sie dann auf ein Backblech und backe sie 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Joghurt und Minze in einer kleinen Schüssel. Vermenge die Salatblätter mit den Tomaten und serviere den Salat zu den Latkes und dem Minzjoghurt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
