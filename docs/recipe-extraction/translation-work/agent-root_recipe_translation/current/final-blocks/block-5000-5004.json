      "steps": [
        {
          "position": 0,
          "text": "Gekochte Garnelen mit Sriracha und Mayonnaise zu einer würzigen Füllung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein Nori-Blatt mit der glänzenden Seite nach unten auf eine Bambusmatte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine dünne Schicht Sushireis auf dem Nori verteilen und am oberen Rand ½ Zoll frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Garnelenmischung, Avocado und Gurke als Streifen quer über die Mitte des Reises legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit der Matte fest aufrollen. Falls nötig, die Naht mit Wasser verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Außenseite mit Sesamsamen bestreuen und mit einem scharfen, angefeuchteten Messer in 6–8 Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
