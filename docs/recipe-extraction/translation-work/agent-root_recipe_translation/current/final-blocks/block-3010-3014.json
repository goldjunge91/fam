      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350°F vorheizen und eine Auflaufform von 9x13 einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Makkaroni nach Packungsanweisung kochen, abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einem Topf bei mittlerer Hitze schmelzen und gehackte Zwiebel 2 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl einrühren, bis eine Paste entsteht, und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Milch nach und nach unter Rühren angießen, bis eine glatte Sauce entsteht; 5 Minuten kochen, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und geriebenen Käse, Salz, Pfeffer sowie Muskatnuss glatt einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Käsesauce über die gekochten Makkaroni gießen, gut vermengen und in die Auflaufform füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Semmelbrösel mit verquirltem Ei vermischen und darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "20-25 Minuten goldbraun und blubbernd backen, dann heiß servieren.",
