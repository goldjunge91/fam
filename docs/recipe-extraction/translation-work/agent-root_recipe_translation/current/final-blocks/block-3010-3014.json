      "steps": [
        {
          "position": 0,
          "text": "3 cups Wasser mit Salz in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl mit Maniokmehl und ½ cup kaltem Wasser in einer Schüssel zu einer glatten Paste ohne Klumpen verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maismischung langsam unter ständigem Rühren ins kochende Wasser gießen, damit keine Klumpen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze auf mittelniedrig reduzieren und 15-20 Minuten ständig rühren, während die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter und Milch hinzufügen und gut verrühren, bis die Masse glatt und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 3 Minuten kochen, bis Banku eine glatte, teigartige Konsistenz erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In 3 Portionen teilen, zu Hügeln formen und heiß mit gegrilltem Fisch oder Suppe servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
