      "steps": [
        {
          "position": 0,
          "text": "Schneide den Schweinebauch in 1-inch-Würfel und erhitze Öl in einem großen Topf bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Schweinefleisch 5 Minuten an. Gib dann gehackten Knoblauch und geschnittene Zwiebeln dazu und gare alles 2 Minuten weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Wasser und Patis dazu. Decke den Topf ab und lass das Fleisch 30 Minuten köcheln, bis es fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Bittermelone längs auf, entferne das faserige Innere und schneide sie in Halbmonde. Bereite die Aubergine genauso vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Bittermelone und Aubergine in den Topf und lass alles ohne Deckel 10 Minuten köcheln, bis das Gemüse gerade weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß mit gedämpftem weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
