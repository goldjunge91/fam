      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Pilze 15 Minuten in warmem Wasser ein. Schneide sie dann ebenso wie die chinesische Wurst in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sesamöl in einem Topf bei mittlerer Hitze und brate Pilze und Wurst 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gekochten Reis dazu und brate ihn 2 Minuten unter Rühren, um Klümpchen zu lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Kochwein und Hühnerbrühe dazu und rühre 1 Minute ständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass alles bei niedriger Hitze 5 Minuten köcheln, bis die Flüssigkeit größtenteils aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz, garniere das Gericht mit geschnittenen Frühlingszwiebeln und serviere es warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
