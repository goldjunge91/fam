      "steps": [
        {
          "position": 0,
          "text": "Weiche Klebreis und Mungbohnen getrennt 2 Stunden in Wasser ein und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Schweinebauch in dicke Streifen. Koche ihn 30 Minuten in kochendem Salzwasser vor, gieße ihn ab und würze ihn mit Fischsauce und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge gekochten Reis und Mungbohnen mit 1 tbsp Fischsauce und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Blanchiere die Bananenblätter über einer Flamme, bis sie weich sind. Lege zwei Blätter überlappend zu einem großen Quadrat aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte die Reismischung, das Schweinefleisch und das halbierte Entenei in die Mitte des Bananenblattquadrats.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falte die Bananenblätter zu einem sauberen quadratischen Päckchen und binde es mit Küchengarn zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche die Päckchen 2 Stunden in Wasser und beschwere sie mit einem Teller, damit sie unter Wasser bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie 30 Minuten abkühlen. Wickle sie aus und schneide sie zum Servieren in Portionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
