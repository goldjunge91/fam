      "steps": [
        {
          "position": 0,
          "text": "Bereite die gelbe Schicht zu: Verrühre Mungbohnenpulver mit ½ cup Wasser und ¼ cup Zucker. Koche die Mischung unter Rühren bei mittlerer Hitze 5 Minuten, bis sie eindickt. Gieße sie in eine gefettete Form und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite die grüne Schicht zu: Verrühre Pandanextrakt mit ½ cup Wasser und ¼ cup Zucker. Löse Agar-Agar darin auf, gieße die Mischung in eine zweite gefettete Form und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Kokosschicht zu: Erwärme Kokosmilch mit 2 tbsp Zucker und Salz, aber lass sie nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die abgekühlten gelben und grünen Schichten in kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle jedes Glas zur Hälfte mit Raspel-Eis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib jeweils einen Löffel gelbe und grüne Würfel auf das Eis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die warme Kokosmilchmischung darüber, bis das Glas voll ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
