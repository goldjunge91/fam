      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl bei mittlerer Hitze. Brate gewürfelte Zwiebel und Paprika etwa 5 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch, Kreuzkümmel, Paprikapulver und Cayennepfeffer dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße zerkleinerte Tomaten und abgetropfte weiße Bohnen hinein. Lass alles 10 Minuten köcheln und würze es mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Forme 4 Mulden in der Sauce und schlage in jede Mulde ein Ei. Decke die Pfanne ab und gare alles bei mittelniedriger Hitze etwa 5–7 Minuten, bis das Eiweiß gestockt und das Eigelb noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib frischen Koriander darüber und serviere das Gericht mit knusprigem Brot oder Pitabrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
