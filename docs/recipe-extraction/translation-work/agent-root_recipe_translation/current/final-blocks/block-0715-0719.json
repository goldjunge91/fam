      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400 °F vor. Lege den Lachs auf ein mit Backpapier ausgelegtes Backblech. Beträufle ihn mit 1 EL Olivenöl und würze ihn mit Salz, Pfeffer, Knoblauch und Dill. Presse eine halbe Zitrone darüber aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe den Lachs 12–15 Minuten, bis er sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße kochende Hühnerbrühe über den Couscous in einer Schüssel. Decke die Schüssel 5 Minuten ab und lockere den Couscous anschließend mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge den Couscous mit dem übrigen Olivenöl, Zitronensaft, gehackter Petersilie und gewürfelter Gurke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere den Lachs auf dem Couscous mit Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
