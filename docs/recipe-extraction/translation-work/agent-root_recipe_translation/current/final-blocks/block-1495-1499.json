      "steps": [
        {
          "position": 0,
          "text": "Röste halbierte frische Tomaten mit Knoblauch und Olivenöl bei 400°F 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare Zwiebel in Butter, bis sie weich ist. Gib die gerösteten und die gehackten Tomaten aus der Dose dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Brühe und frisches Basilikum hinzu und lass alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere die Suppe ganz glatt. Rühre Milch unter und würze mit Zucker, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere sie mit einem gegrillten Käse-Sandwich oder knusprigem Brot zum Eintunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
