      ],
      "steps": [
        {
          "position": 0,
          "text": "Gib warmes Wasser, eine großzügige Prise Zucker und Hefe in die Schüssel einer Küchenmaschine. Lass alles stehen, bis es schaumig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1/2 Tasse Zucker, warme Milch, geschmolzene Butter, Eier und Salz in dieselbe Schüssel und verquirle alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Setze den Knethaken ein und gib bei laufender Maschine das Mehl dazu, bis ein glatter, aber leicht klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Teig in eine Schüssel, decke sie mit Frischhaltefolie ab und lass ihn 1 1/2 Stunden gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 12 Stücke und rolle sie zu langen, ovalen Fladen von etwa 1/4 Zoll Dicke, die an einen Biberschwanz erinnern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem großen, tiefen Topf auf 350 Grad. Lege den Teig für die BeaverTails vorsichtig in das heiße Öl und frittiere ihn auf jeder Seite 30 bis 45 Sekunden, bis er goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Stücke auf Küchenpapier abtropfen und garniere sie nach Belieben. Wende sie in Zimtzucker oder weißem Zucker und presse Zitrone darüber oder bestreiche sie großzügig mit Nutella und streue eine Handvoll geröstete Mandeln darauf. Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
