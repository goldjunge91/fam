      "steps": [
        {
          "position": 0,
          "text": "Brotwürfel 10 Minuten in Milch einweichen, bis sie eingezogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eingeweichtes Brot mit Eiern, Schinken, Petersilie, 2 EL Mehl, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "12 Knödel von etwa 1.5 Zoll Durchmesser formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Knödel leicht im restlichen Mehl wenden, damit sie besser zusammenhalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rinderbrühe in einem großen Topf leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Knödel in die köchelnde Brühe geben und 15–20 Minuten kochen, bis sie schwimmen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Knödel in Schüsseln mit heißer Brühe und frischer Petersilie garniert servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Optional: Mit zerlassener Butter und knusprigem Salbei belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
