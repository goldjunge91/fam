      "steps": [
        {
          "position": 0,
          "text": "Gewürfelte Kartoffeln in Salzwasser 8 Minuten vorkochen, dann gut abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Speckstücke in einer großen Pfanne knusprig braten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl zum Speckfett geben und dann die gewürfelten Zwiebeln und Paprika 3 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie die Kartoffeln in die Pfanne und kochen Sie sie ungestört 5 Minuten lang, bis sich am Boden eine Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Umrühren und unter gelegentlichem Rühren 8–10 Minuten weitergaren, bis die Kartoffeln goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Speck, Salz, Pfeffer und Kümmel unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Kartoffel-Speck-Mischung an den Rand der Pfanne schieben, Eier in die Mitte schlagen und braten, bis das Eiweiß gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit einem Spiegelei obenauf und knusprigem Brot als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
