      "steps": [
        {
          "position": 0,
          "text": "Mehl, Eier, Milch, Salz und Zucker zu einem glatten Teig verrühren und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer tiefen Pfanne oder Fritteuse auf 350 °F erhitzen. Die Temperatur mit einem Stück Brot prüfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in einen Trichter oder eine Quetschflasche mit großer Öffnung füllen und über heißes Öl halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Durch Bewegen des Trichters direkt im Öl einen spiralförmigen oder unregelmäßig geformten Teig herstellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Küchlein pro Seite 1–2 Minuten frittieren, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem Schaumlöffel herausnehmen und auf Papiertüchern abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Puderzucker und Zimt in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warme Strauben mit Zimtzucker bestäuben und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
