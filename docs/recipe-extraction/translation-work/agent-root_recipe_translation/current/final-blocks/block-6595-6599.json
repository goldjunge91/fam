      "steps": [
        {
          "position": 0,
          "text": "Rindfleischstücke und Knochen in einen großen Topf geben, mit kaltem Wasser bedecken und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fleisch und Knochen abgießen und abspülen. Mit 8 Tassen frischem Wasser in den gereinigten Topf zurückgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebelviertel hinzufügen und zum Kochen bringen; Den Schaum 5 Minuten lang von der Oberfläche abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Karotten, Sellerie und Pastinaken hinzufügen; Ohne Deckel 60 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln hinzufügen und mit Salz und Pfeffer würzen; Weitere 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entfernen Sie Fleisch und Knochen, zerkleinern Sie alles Fleisch und geben Sie das zerkleinerte Fleisch wieder in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nachwürzen, dann weitere 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schüsseln füllen und mit frischer Petersilie und knusprigem Brot garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
