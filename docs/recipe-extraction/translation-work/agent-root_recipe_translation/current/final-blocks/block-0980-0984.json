      "steps": [
        {
          "position": 0,
          "text": "Gare den Reis. Schneide die Pilze in Scheiben und würfle den Tofu. Fürs Schmoren musst du ihn nicht auspressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl und bräune den Tofu pro Seite 3 Minuten. Nimm ihn heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Pilze 5 Minuten an. Gib Knoblauch und Ingwer dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib beide Sojasaucen und Sesamöl dazu, füge ½ Tasse Wasser hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege den Tofu zurück in die Pfanne und lass ihn 5 Minuten schmoren, bis die Sauce eingekocht ist. Gib den Spinat dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere den Tofu auf Reis mit Frühlingszwiebeln und Sesamsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
