      "steps": [
        {
          "position": 0,
          "text": "Milch in einem Topf bei mittlerer Hitze erhitzen, bis sie dampft, dann mit 2 Esslöffeln kaltem Wasser verrührte Maisstärke einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Creme unter ständigem Rühren 3–4 Minuten kochen, bis sie eindickt. Vom Herd nehmen und leicht abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eigelb und Zucker verquirlen und mit Vanilleextrakt unter die abgekühlte Creme heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine 9x9 Zoll große Auflaufform mit geschmolzener Butter bestreichen, 3 Filoteigblätter hineinlegen und jedes dazwischen mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Creme auf dem Filoteig verteilen und die übrigen 3 Filoteigblätter darauflegen, jedes mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Quadrate schneiden, mit der restlichen Butter bestreichen und bei 350 °F 25–30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Währenddessen Wasser, Honig und Zimt in einem Topf vermischen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warmen Sirup sofort nach dem Herausnehmen über das heiße Gebäck gießen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
