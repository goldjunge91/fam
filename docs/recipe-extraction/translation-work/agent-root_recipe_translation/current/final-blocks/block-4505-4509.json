      "steps": [
        {
          "position": 0,
          "text": "Speck in einem großen Schmortopf bei mittlerer bis hoher Hitze knusprig braten, herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderbraten im Speckfett insgesamt etwa 10 Minuten von allen Seiten anbraten, dann herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel, Karotte und Knoblauch im selben Topf 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark einrühren und 1 Minute kochen, dann mit Rotwein ablöschen und Bratrückstände lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rindfleisch zurück in den Topf geben, Brühe, Speck, Backpflaumen und Lorbeerblatt hinzufügen und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und im Ofen bei 300 °F 2.5–3 Stunden schmoren, bis das Rindfleisch mit der Gabel zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rindfleisch herausnehmen und aufschneiden. Kochflüssigkeit abseihen und die Sauce über dem Fleisch mit Nudeln oder Polenta servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
