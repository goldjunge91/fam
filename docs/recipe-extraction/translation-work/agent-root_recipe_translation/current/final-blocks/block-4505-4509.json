      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen und Zwiebel sowie Knoblauch 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tintenfisch in die Pfanne geben und unter gelegentlichem Rühren 3–4 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reis einrühren und unter ständigem Rühren 1–2 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weißwein zugießen und rühren, bis er aufgenommen ist. Dann warme Brühe schöpflöffelweise unter häufigem Rühren hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 18–20 Minuten Brühe zugießen und rühren, bis der Reis cremig und zart, aber noch bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Butter, Salz und Pfeffer einrühren und sofort in warmen Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
