      "steps": [
        {
          "position": 0,
          "text": "Mehl, Eier, Milch und Salz in einer Schüssel verrühren, bis ein dickflüssiger, klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen großen Topf mit gesalzenem Wasser zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit einem Kasnocken-Sieb oder einem Schaumlöffel kleine Nocken aus dem Teig direkt ins kochende Wasser drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nocken kochen, bis sie an die Oberfläche steigen, dann weitere 2 Minuten garen und mit einem Schaumlöffel herausheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einer Auflaufform die Hälfte der gekochten Kasnocken, die Hälfte des Käses und alle karamellisierten Zwiebeln schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restlichen Kasnocken und den übrigen Käse daraufgeben und mit Butterflöckchen belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400°F 15 Minuten backen, bis die Kasnocken goldbraun sind und Blasen werfen, dann mit Schnittlauch garnieren und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
