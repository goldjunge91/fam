      "steps": [
        {
          "position": 0,
          "text": "Hähnchenteile mit Küchenpapier trocken tupfen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drei flache Schüsseln bereitstellen: eine mit Mehl, eine mit verquirlten Eiern und eine mit mit Paprika vermischtem Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jedes Hähnchenteil in Mehl wenden, dann in Ei tauchen und gründlich mit Paniermehl ummanteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer großen Pfanne auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchenteile pro Seite 6-8 Minuten goldbraun braten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Küchenpapier geben, damit überschüssiges Öl abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Zitronenspalten und einem frischen Salat oder Kartoffelbeilagen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
