      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und Zucker in einer Schüssel mit dem Schneebesen verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer weiteren Schüssel Eier und Milch gut verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nasse und trockene Zutaten vermengen und glatt verrühren; den Teig 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 Esslöffel Butter in einer beschichteten Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Etwa 1/4 Tasse Teig hineingießen, die Pfanne sofort schwenken, damit er sich dünn verteilt, und 2 Minuten backen, bis der Palatschinken hellgoldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Umdrehen und auf der anderen Seite 30 Sekunden backen, dann auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem restlichen Teig wiederholen und nach Bedarf Butter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Jeden Palatschinken mit Konfitüre oder Nutella füllen, aufrollen, mit Puderzucker bestäuben und servieren.",
