      "steps": [
        {
          "position": 0,
          "text": "Butter und Zucker etwa 3 Minuten lang schaumig rühren, bis eine leichte, lockere Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ei und Vanilleextrakt unterrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Backpulver und Salz in einer separaten Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Abwechselnd Mehlmischung und Milch zur Buttermischung geben, jeweils mit Mehl beginnen und enden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Große Löffel Teig auf ein gefettetes Backblech setzen und bei 375 °F 12–14 Minuten backen, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kühlen Sie die Kekse auf dem Gitter vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Puderzucker mit Wasser glatt rühren, dann auf zwei Schüsseln verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mischen Sie das Kakaopulver für die Schokoladenglasur in einer Schüssel und tauchen Sie dann die Hälfte jedes Kekses in Vanilleglasur und die andere Hälfte in Schokoladenglasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
