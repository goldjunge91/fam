      "steps": [
        {
          "position": 0,
          "text": "Eier, Mehl, Milch und Salz verquirlen, um einen dünnen Crêpe-Teig herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitzen Sie eine 8-Zoll-Pfanne mit Antihaftbeschichtung bei mittlerer Hitze und bestreichen Sie sie leicht mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie 3 Esslöffel Teig in die Pfanne, kippen Sie sie, um sie dünn zu verteilen, und kochen Sie sie 1 Minute auf jeder Seite, bis sie fest, aber nicht braun ist. Auf dem Teller beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ricotta, Cheddar, Eigelb und Zucker in einer Schüssel gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie 2 Esslöffel Käsefüllung in die Mitte jedes Crêpes, falten Sie die Seiten nach innen und falten Sie dann die Ober- und Unterseite zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Butter in der Pfanne bei mittlerer Hitze erhitzen und die Blintze vorsichtig mit der Nahtseite nach unten hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf jeder Seite 2-3 Minuten braten, bis der Käse goldbraun ist und durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm servieren und mit saurer Sahne beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
