      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinehackfleisch, Schweinefett, Fischsauce, Knoblauch, Zucker, Salz und Pfeffer in einer Schüssel, bis eine klebrige, gleichmäßige Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege ein Seihtuch flach aus und verteile die Schweinemasse gleichmäßig zu einer etwa 2 Zoll dicken Rolle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle die Masse fest im Seihtuch ein und drehe die Enden zusammen, um die Rolle zu verdichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und lege die eingewickelte Rolle vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse sie 45-50 Minuten sanft köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Rolle heraus und lasse sie vollständig abkühlen. Stelle sie vor dem Auswickeln mindestens 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide sie in 1/4 Zoll dicke Scheiben und serviere sie kalt oder bei Zimmertemperatur mit eingelegtem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
