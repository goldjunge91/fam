      "steps": [
        {
          "position": 0,
          "text": "Vermenge Schweinehackfleisch, Schweinefett, Fischsauce, Knoblauch, Zucker, Salz und Pfeffer, bis eine sehr klebrige, pastenartige Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege Frischhaltefolie aus und forme die Masse darauf zu einer festen, kompakten Rolle von etwa 2.5 Zoll Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wickle die Rolle fest in Frischhaltefolie ein und drehe die Enden kräftig zu, damit die Masse verdichtet wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und lege die eingewickelte Rolle vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse das Wasser sanft kochen und gare die Rolle 55-60 Minuten. Sie sollte sich fest anfühlen, wenn sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie heraus, lasse sie auf Zimmertemperatur abkühlen und stelle sie mindestens 3 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wickle sie aus und schneide sie in dünne Scheiben. Serviere sie kalt mit eingelegtem Rettich und Karotte oder mit Reis und Sojasauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
