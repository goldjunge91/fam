      "steps": [
        {
          "position": 0,
          "text": "Vermische Krabbenfleisch, Schweinehackfleisch, Semmelbrösel, Eier, Fischsauce, Knoblauch, Zwiebel, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge alles gründlich mit den Händen, bis eine klebrige, gut verbundene Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme daraus 12-16 ovale Küchlein oder längliche Röllchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher Hitze, bis es glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate die Küchlein auf jeder Seite 4-5 Minuten goldbraun und gar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege sie zum Abtropfen auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
