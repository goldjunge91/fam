      "steps": [
        {
          "position": 0,
          "text": "Vermische Knoblauch, Zitronengras, Fischsauce, Zucker, Öl, Salz und Pfeffer in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende die Schweinefleischscheiben in der Marinade und lasse sie 15 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Blanchiere die Bananenblätter kurz in heißem Wasser, damit sie weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege jeweils einen Löffel mariniertes Schweinefleisch auf ein Bananenblatt und falte es zu einem gut verschlossenen Päckchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Päckchen bei mittelhoher bis hoher Hitze auf jeder Seite 10-12 Minuten, bis das Schweinefleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öffne die Päckchen vorsichtig am Tisch, da heißer Dampf austritt. Serviere sie mit Reis und frischen Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
