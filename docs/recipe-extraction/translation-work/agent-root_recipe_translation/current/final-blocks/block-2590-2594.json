      "steps": [
        {
          "position": 0,
          "text": "Gib Oktopus, halbierte Zwiebel und 2 Lorbeerblätter in einen großen Topf mit Wasser und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reduziere die Hitze und lasse den Oktopus 40-45 Minuten köcheln, bis er zart ist. Gieße ihn dann ab und lasse ihn etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Oktopustentakel in mundgerechte Stücke und lege sie auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Kartoffeln ganz in Salzwasser, bis sie weich sind, etwa 20 Minuten. Schneide sie dann in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Kartoffelscheiben über den Oktopusstücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Olivenöl mit gehacktem Knoblauch 30 Sekunden in einer kleinen Pfanne und nimm sie dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle Oktopus und Kartoffeln mit Knoblauchöl, bestreue sie mit Paprikapulver, Meersalz und schwarzem Pfeffer und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
