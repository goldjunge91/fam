      "steps": [
        {
          "position": 0,
          "text": "Weiche die Ackerbohnen über Nacht in Wasser ein, gieße sie dann ab und spüle sie gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Bohnen, Schweinshaxe, halbierte Zwiebel und 4 Quarts Wasser mit Lorbeerblättern in einen großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und lasse es 1.5 Stunden köcheln. Schöpfe bei Bedarf den Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Chorizo und geschnittene Morcilla oder Pancetta in den Topf und lasse alles weitere 30 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate in einer kleinen Pfanne gehackten Knoblauch in Öl an und gib Safran dazu, den du in warmem Wasser aufgelöst hast.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre die Knoblauch-Safran-Mischung in den Bohnentopf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 15 Minuten köcheln, bis die Bohnen sehr weich und cremig sind, und würze dann mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
