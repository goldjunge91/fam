      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Fischfilets mit Küchenpapier trocken und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Stelle drei flache Schüsseln bereit: eine mit Mehl, eine mit verquirlten Eiern und eine mit Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Filet erst in Mehl, tauche es dann ins Ei und umhülle es anschließend gründlich mit Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer großen Pfanne auf 350°F (bei mittelhoher Hitze etwa 3 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die panierten Filets vorsichtig ins heiße Öl und brate sie 3-4 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den gegarten Fisch auf Küchenpapier, damit überschüssiges Öl abtropft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere ihn heiß mit Zitronenspalten und bestreue ihn mit gehackter Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
