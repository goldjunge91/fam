      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer großen Pfanne und brate gewürfelte Zwiebel und gehackten Knoblauch 3 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Kreuzkümmel und Paprikapulver dazu und rühre 30 Sekunden ständig, bis die Gewürze duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die abgetropften und abgespülten Kichererbsen sowie Gemüsebrühe dazu und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den frischen Spinat portionsweise dazu und rühre jede Portion unter, sobald sie zusammenfällt; insgesamt etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wenn der gesamte Spinat zusammengefallen ist, lasse alles weitere 2 Minuten köcheln, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
