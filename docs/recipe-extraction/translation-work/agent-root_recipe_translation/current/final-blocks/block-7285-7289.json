      "steps": [
        {
          "position": 0,
          "text": "Die Gemüsebrühe erhitzen, bis sie dampft (3–4 Minuten in der Mikrowelle oder mit kochendem Wasser und Brühwürfel). Die heiße Brühe erwärmt später die Suppe und sollte deshalb nicht ausgelassen werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinerte Tomaten, heiße Brühe, Tomatenmark, Knoblauch, rohe Zwiebel, Olivenöl, Zucker und Salz in den Mixer geben. Nach Wunsch frisches Basilikum hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Deckel sicher verschließen. Bei heißer Flüssigkeit die Öffnung im Deckel freilassen und mit einem Tuch abdecken. Erst auf niedriger, dann auf hoher Stufe 3–4 Minuten mixen, bis die Suppe glatt und dampfend heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bei niedriger Stufe die Schlagsahne zugießen und 15–20 Sekunden mixen, bis sie eingearbeitet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abschmecken und bei Bedarf Salz oder Zucker ergänzen. In Schüsseln füllen und mit gezupftem Basilikum sowie etwas Olivenöl garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
