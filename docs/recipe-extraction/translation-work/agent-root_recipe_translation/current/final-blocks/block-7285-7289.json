      "steps": [
        {
          "position": 0,
          "text": "Die Rindfleischwürfel sehr trocken tupfen, großzügig salzen und pfeffern und in Mehl wenden. Überschüssiges Mehl abschütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem schweren Schmortopf bei mittelhoher Hitze erhitzen. Das Fleisch portionsweise mit etwas Abstand 3–4 Minuten pro Seite kräftig anbraten. Auf einen Teller geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze auf mittlere Stufe reduzieren. Zwiebel, Karotte und Sellerie 6–8 Minuten weich und leicht karamellisiert dünsten, dabei die Bratrückstände lösen. Knoblauch und Tomatenmark einrühren und 1–2 Minuten kochen, bis das Tomatenmark dunkler wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rotwein zugießen und 3–4 Minuten kräftig köcheln lassen, bis sich die Flüssigkeit etwa halbiert hat; dabei den Topfboden abschaben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fleisch samt Fleischsaft zurück in den Topf geben. Rinderbrühe, Worcestershiresoße, Thymian und Lorbeerblätter hinzufügen. Sanft aufkochen, zudecken und bei niedriger Hitze 1.5 Stunden köcheln lassen. Gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln hinzufügen, den Topf teilweise zudecken und weitere 35–45 Minuten köcheln lassen, bis das Fleisch zart und die Kartoffeln gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Für eine dickere Soße den Eintopf ohne Deckel weitere 10 Minuten einkochen lassen oder einige Kartoffelstücke am Topfrand zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gefrorene Erbsen einrühren und 3–4 Minuten erhitzen. Lorbeerblätter entfernen, abschmecken und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Den Eintopf 5 Minuten vom Herd nehmen und ruhen lassen. In Schüsseln füllen und mit frisch gehackter Petersilie bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
