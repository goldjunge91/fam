      "steps": [
        {
          "position": 0,
          "text": "Milch, Eier, geschmolzene Butter, Vanille, Zucker und Salz zuerst in den Mixbehälter geben, damit die flüssigen Zutaten nahe an den Messern sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Backpulver daraufgeben. Den Deckel schließen und etwa 15–20 Sekunden auf niedriger Stufe mixen, bis der Teig glatt ist. Nicht zu lange mixen, sonst werden die Pfannkuchen zäh.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 5 Minuten im Behälter ruhen lassen, damit das Mehl quellen kann und Luftbläschen entweichen. Er sollte dickflüssig vom Löffel laufen; bei Bedarf etwas Milch ergänzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine beschichtete Pfanne oder Grillplatte bei mittlerer Hitze erwärmen und leicht buttern. Etwa 1/4 Tasse Teig pro Pfannkuchen direkt aus dem Mixer hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2–3 Minuten backen, bis sich an der Oberfläche Bläschen bilden und die Ränder fest aussehen. Wenden und weitere 1–2 Minuten goldbraun backen. Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
