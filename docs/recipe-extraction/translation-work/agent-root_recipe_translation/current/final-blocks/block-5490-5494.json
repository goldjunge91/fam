      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis in Wasser etwa 18 Minuten, bis er locker und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Rindfleisch dünn auf und mariniere es in 1 Esslöffel Sojasauce und Sesamöl für 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Blanchiere den Spinat kurz, drücke ihn trocken und vermische ihn mit gehacktem Knoblauch und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Karotten und Zucchini in feine Streifen. Dünste sie getrennt bissfest und würze sie mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Pilze in Scheiben und brate sie mit der übrigen Sojasauce goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze eine Steinschüssel oder gusseiserne Pfanne bei starker Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib den gekochten Reis in die heiße Schüssel und ordne Gemüse und gebratenes Rindfleisch getrennt darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brate ein Spiegelei und lege es in die Mitte. Serviere das Gericht mit Gochujang, das mit Sesamöl verrührt wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
