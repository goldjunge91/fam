      "steps": [
        {
          "position": 0,
          "text": "Vermische warmes Wasser, Zucker und Hefe und lasse die Mischung 5 Minuten stehen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Backpulver in einer Schüssel. Gib die Hefemischung hinzu und knete alles zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig ab und lasse ihn 45 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide das Schweinefleisch in Würfel und brate es mit gehacktem Knoblauch, Hoisinsauce und Sojasauce an, bis es karamellisiert. Rühre gehackte Frühlingszwiebeln ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 8 Stücke und rolle jedes zu einem Kreis von 3-inch Durchmesser aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 2 Esslöffel Füllung auf jeden Kreis. Falte ihn halb zusammen und drücke die Ränder fest zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Bao auf Backpapierquadrate und dämpfe sie in einem Bambusdämpfer oder Topf über kochendem Wasser 12 Minuten, bis sie fluffig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie sofort, solange sie noch warm sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
