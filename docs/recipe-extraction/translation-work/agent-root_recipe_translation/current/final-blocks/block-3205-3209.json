      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer Pfanne bei mittelhoher Hitze erhitzen und Rinderhackfleisch 5-7 Minuten anbräunen, dabei zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Überschüssiges Fett abgießen, dann Kreuzkümmel, Salz, Pfeffer und gekochten Reis einrühren, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schwarze Bohnen in einem separaten Topf erwärmen und zur Rindfleischmischung geben; gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Tortilla in einer trockenen Pfanne pro Seite 30 Sekunden erwärmen, bis sie biegsam ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tortilla flach hinlegen und 2 tablespoons saure Sahne mittig darauf verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hälfte der Rindfleischmischung daraufgeben und mit der Hälfte von Käse und Salsa belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Seiten der Tortilla nach innen falten und dann von unten nach oben fest aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Burritos mit der Naht nach unten in eine Auflaufform legen, mit Folie abdecken und bei 350°F 10 Minuten backen, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
