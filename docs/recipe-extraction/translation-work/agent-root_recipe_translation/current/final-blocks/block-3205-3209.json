      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust der Länge nach in 1-inch breite Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl in eine flache Schale geben, Eier in einer zweiten verquirlen und Panko mit Salz, Pfeffer sowie Knoblauchpulver in einer dritten vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jeden Hähnchenstreifen in Mehl wenden und Überschuss abschütteln, dann in Ei tauchen und schließlich mit der Panko-Mischung bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einem großen Topf oder einer tiefen Pfanne auf 350°F erhitzen und die Temperatur mit einem Thermometer prüfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchenstreifen vorsichtig ins heiße Öl geben und 3-4 Minuten goldbraun frittieren, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gegarte Streifen auf einen mit Küchenpapier ausgelegten Teller legen und überschüssiges Öl abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit einer Dip-Sauce nach Wahl, etwa Ranch oder Honig-Senf, servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
