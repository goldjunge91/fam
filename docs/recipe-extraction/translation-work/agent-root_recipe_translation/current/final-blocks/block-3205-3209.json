      "steps": [
        {
          "position": 0,
          "text": "Eier in eine Schüssel schlagen, Salz und Pfeffer hinzufügen und gut verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel und Paprika hinzufügen und 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geschnittene Pilze hinzufügen und weitere 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirlte Eier zum Gemüse in die Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vorsichtig rühren und Eier 1-2 Minuten garen lassen, dann Spinat und Käse hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weiter rühren, bis die Eier gestockt, aber noch leicht saftig sind, insgesamt etwa 2-3 Minuten, dann sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
