        {
          "position": 4,
          "text": "Mozzarella gleichmäßig über die Sauce verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pepperoni-Scheiben in einer Lage auf dem Käse anordnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "12-15 Minuten backen, bis der Rand goldbraun und der Käse blubbernd sowie leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen und vor dem Schneiden und Servieren 2 Minuten abkühlen lassen.",
