      "steps": [
        {
          "position": 0,
          "text": "Brot in mundgerechte Würfel schneiden und in eine Servierschüssel schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer Pfanne Ghee bei mittlerer Hitze schmelzen und Eier braten, bis das Eigelb fest, aber noch leicht flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spiegeleier auf die Brotwürfel legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Joghurt in einem Topf vorsichtig erhitzen, ohne zu kochen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gießen Sie den warmen Joghurt über das Brot und die Eier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das gesamte Gericht mit Honig beträufeln und mit einer Prise Salz bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort warm servieren und vor dem Verzehr vorsichtig mischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
