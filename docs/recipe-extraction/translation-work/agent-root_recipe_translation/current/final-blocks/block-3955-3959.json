      "steps": [
        {
          "position": 0,
          "text": "In einem großen Topf Hühnerbrühe zum Kochen bringen und ganze Hähnchenstücke mit der Hälfte der geschnittenen Zwiebeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hitze reduzieren und 30 Minuten köcheln lassen, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hähnchen herausnehmen, in mundgerechte Stücke schneiden und beiseite stellen, dabei die Brühe im Topf lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer separaten Pfanne Ghee erhitzen und die restlichen Zwiebelscheiben und den gehackten Knoblauch goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kurkuma hinzufügen und umrühren, dann Reis hinzufügen und umrühren, um ihn mit Ghee zu bestreichen, und 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Reismischung in die Hühnerbrühe geben, zum Kochen bringen und dann die Hitze reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 25 Minuten köcheln lassen, bis der Reis sehr weich und cremig ist, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Das zerkleinerte Hähnchen untermischen, mit Salz und Pfeffer abschmecken und warm in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
