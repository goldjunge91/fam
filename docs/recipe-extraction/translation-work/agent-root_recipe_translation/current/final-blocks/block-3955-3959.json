      "steps": [
        {
          "position": 0,
          "text": "Erhitzen Sie die Hälfte des Ghees in einer großen Pfanne, bräunen Sie das Hackfleisch an und brechen Sie es beim Kochen auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln, Knoblauch und Tomatenmark hinzufügen und kochen, bis die Zwiebeln weich sind, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wasser, Kreuzkümmel, Salz und Pfeffer hinzufügen und die Fleischsoße dann 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einem separaten großen Topf das restliche Ghee bei mittlerer Hitze schmelzen und das Mehl 3-4 Minuten unter ständigem Rühren rösten, bis es leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geben Sie die Fleischmischung nach und nach unter ständigem Rühren zum Mehl, bis ein dicker, geschmeidiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühren und kochen Sie 5 Minuten lang weiter, bis das Bazeen eine zusammenhängende Masse bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Bazeen auf einer Servierplatte kuppelförmig aufhäufen und oben eine Vertiefung bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gießen Sie die restliche Fleischsoße in die Vertiefung und servieren Sie sie warm, auf Wunsch mit zusätzlichem Ghee darüberträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
