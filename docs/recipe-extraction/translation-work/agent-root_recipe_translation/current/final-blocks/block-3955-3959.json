      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, dann nach und nach Wasser hinzufügen und zu einem weichen Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "5 Minuten lang kneten, bis eine glatte Masse entsteht, mit einem feuchten Tuch abdecken und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 6 gleiche Kugeln und drücken Sie jede zu einer dünnen Scheibe flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Großzügig mit Ghee bestreichen, dann zur Hälfte falten und erneut bestreichen, dann noch einmal zur Hälfte falten, sodass ein Dreieck entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer schweren Pfanne auf 350°F erhitzen und jedes Malawah-Dreieck 2-3 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Papiertüchern abtropfen lassen und auf einem Servierteller anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eier leicht schlagen und über die warme Malawah gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Großzügig mit Honig beträufeln und sofort noch warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
