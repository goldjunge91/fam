      "steps": [
        {
          "position": 0,
          "text": "Ghee in einem großen Topf erhitzen und die Hähnchenteile von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Im selben Topf die in Scheiben geschnittenen Zwiebeln goldbraun anbraten, dann den gehackten Knoblauch hinzufügen und 1 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kreuzkümmel, Zimt, Nelken und Lorbeerblätter hinzufügen und 30 Sekunden lang rühren, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Huhn wieder in den Topf, fügen Sie Tomatensauce und Hühnerbrühe hinzu und lassen Sie es köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abdecken und 30 Minuten kochen, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hähnchen herausnehmen, in mundgerechte Stücke schneiden und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In die gleiche Brühe Reis geben und zum Kochen bringen, dann die Hitze reduzieren, abdecken und 20 Minuten köcheln lassen, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reis mit einer Gabel auflockern, zerkleinertes Hühnchen untermischen und heiß servieren, vorzugsweise auf einer Platte angerichtet mit Reis unten und Hühnchen oben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
