      "steps": [
        {
          "position": 0,
          "text": "Limettensaft, 2 Esslöffel Olivenöl, gehackten Knoblauch, Chilipulver, Kreuzkümmel, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleischscheiben in der Marinade wenden und 15 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 Esslöffel Olivenöl in einer großen Pfanne bei hoher Hitze erhitzen und das Rindfleisch portionsweise 2–3 Minuten braten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne Paprika- und Zwiebelscheiben 5–7 Minuten braten, bis sie leicht gebräunt und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rindfleisch zurück in die Pfanne geben, alles vermengen und 2 Minuten garen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tortillas in einer trockenen Pfanne oder über einer Flamme pro Seite 30 Sekunden erwärmen und mit Fleisch und Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
