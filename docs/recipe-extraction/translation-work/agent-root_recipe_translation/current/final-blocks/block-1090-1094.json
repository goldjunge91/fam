      "steps": [
        {
          "position": 0,
          "text": "Brate Paneerwürfel in Öl goldbraun an und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Kreuzkümmelsamen an. Gib Zwiebel, Knoblauch und Ingwer dazu und gare alles 5 Minuten. Füge Kurkuma und Garam Masala hinzu.",
