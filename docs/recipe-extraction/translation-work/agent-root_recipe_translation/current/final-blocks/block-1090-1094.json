      "steps": [
        {
          "position": 0,
          "text": "Bereite die Hähnchenmarinade zu: Vermische 1 Tasse Joghurt, Garam Masala, Kurkuma, Chili, Knoblauch und Ingwer. Bedecke das Hähnchen damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Grille oder brate das Hähnchen pro Seite 5–6 Minuten, bis es außen geröstet und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die Raita zu: Vermische den übrigen Joghurt mit geraspelter Gurke und Minze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Serviere das geschnittene Hähnchen auf Reis mit Raita und Kirschtomaten.",
