      "steps": [
        {
          "position": 0,
          "text": "Die Hähnchenbrüste in Wasser mit Zwiebeln, Knoblauch und Ingwer 20 Minuten pochieren, dann das Fleisch zupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 Esslöffel Butter erhitzen und die restlichen Zwiebeln karamellisieren, Hähnchen und Zimt dazugeben und 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mandeln in einer trockenen Pfanne rösten, bis sie duften, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Eier in einer Pfanne stocken lassen, dann zusammen mit den Kräutern unter die Hähnchenmischung heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Filoteigblätter auf einem Backblech schichten und jedes mit geschmolzener Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hähnchenfüllung mittig auf dem Filoteigstapel verteilen, die gerösteten Mandeln daraufgeben und die Ränder zum Verschließen darüberfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das gesamte Gebäck mit der restlichen geschmolzenen Butter bestreichen und bei 375°F 25-30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mit Puderzucker und Zimt bestäuben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
