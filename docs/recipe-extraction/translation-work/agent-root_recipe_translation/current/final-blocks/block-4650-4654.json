      "steps": [
        {
          "position": 0,
          "text": "Mehl, Wasser und Salz zu einem Teig verkneten und 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch mit gewürfelter Zwiebel, gehacktem Knoblauch und Kreuzkümmel in einer Pfanne anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jalapeño fein hacken und zusammen mit dem geriebenen Käse unter die Hackfleischmischung rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 8 Portionen teilen und jede zu einem dünnen Kreis flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 tablespoons Hackfleischfüllung auf eine Hälfte jedes Teigkreises geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig zusammenklappen, sodass die Füllung eingeschlossen ist, und die Ränder zum Verschließen andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und die Molotes etwa 3 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Salsa servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
