      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 400°F vorheizen und die Cornish-Hühner 40 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hühner kurz abkühlen lassen, dann das Fleisch von den Knochen lösen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Karotten und Sellerie würfeln und 10 Minuten in der Hühnerbrühe köcheln lassen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pastetenteig aus Mehl, Butter, Salz und Eiswasser zubereiten, bis er krümelig ist, dann 15 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das zerkleinerte Hühnerfleisch mit dem gegarten Gemüse, den Erbsen und der Brühe in einer Pastetenform vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig ausrollen und auf die Füllung legen, dann mit verquirltem Ei bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400°F 25-30 Minuten backen, bis der Teig goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
