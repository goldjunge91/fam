      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und öle eine 9×13 Zoll große Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Hackfleisch in einem großen Topf mit Öl, Zwiebel und Knoblauch etwa 8 Minuten und zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatensauce und Brühe ein, lasse alles 15 Minuten köcheln, hebe dann tiefgekühlte Erbsen unter und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche Anelletti al dente, gieße sie ab und gib sie in eine große Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eier in einer kleinen Schüssel, gieße sie über die Pasta und vermische alles. Gib Mozzarella und die Hälfte des Parmesans hinzu und vermische erneut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Hälfte der Pasta in der vorbereiteten Auflaufform und gieße die Hälfte der Fleischsauce darüber. Wiederhole die Schichten mit der übrigen Pasta und Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Streue den restlichen Parmesan gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Auflauf ohne Deckel 20 Minuten, bis die Oberfläche leicht gebräunt und die Pasta durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
