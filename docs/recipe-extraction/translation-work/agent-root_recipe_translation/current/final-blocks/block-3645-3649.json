      "steps": [
        {
          "position": 0,
          "text": "Vermische Paniermehl, Parmesan, Petersilie, Knoblauch, Pinienkerne, Rosinen und 1 Ei in einer Schüssel und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege Schwertfischscheiben flach auf ein Schneidebrett und klopfe sie mit einem Fleischklopfer vorsichtig gleichmäßig dünn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 2 Esslöffel Füllung auf jede Schwertfischscheibe, rolle sie fest auf und fixiere sie mit einem Zahnstocher.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Involtini mit der Naht nach unten in die Pfanne und gare sie je Seite 4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle sie mit Zitronensaft und gare sie 1 weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie auf eine Servierplatte und serviere sie sofort mit frischen Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
