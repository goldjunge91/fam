      "steps": [
        {
          "position": 0,
          "text": "Bringe einen Topf Salzwasser zum Kochen und koche Spaghetti etwa 10 Minuten al dente.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme währenddessen Olivenöl in einer großen Pfanne bei niedriger Hitze sanft und gib gehackten Knoblauch hinzu. Gare ihn 1 Minute, bis er duftet, aber nicht bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Weißwein hinzu und lasse ihn 2 Minuten köcheln, damit er etwas einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Pasta ab, bewahre 1/2 Tasse Nudelwasser auf und gib die Pasta mit dem Knoblauchöl in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe Seeigelrogen und 1/4 Tasse Nudelwasser vorsichtig unter, damit der Rogen nicht zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd, gib Zitronensaft, Petersilie und Chiliflocken hinzu und schwenke alles vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib bei Bedarf weiteres Nudelwasser hinzu, bis eine seidige Sauce entsteht. Würze mit Meersalz und schwarzem Pfeffer und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
