      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste Zwiebel und Knoblauch etwa 3 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Chiliflocken hinzu, gieße Weißwein an und lasse alles 2 Minuten köcheln, damit es etwas einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Dosentomaten und Fischfond hinzu, bringe alles zum Kochen, reduziere die Hitze und lasse es 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelten Fisch und Garnelen hinzu und lasse sie 5 Minuten teilweise garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Miesmuscheln und Venusmuscheln ein, decke den Topf ab und gare sie 8–10 Minuten, bis sich die Schalen öffnen. Entsorge geschlossene Muscheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere die Suppe, würze mit Salz und Pfeffer und rühre frisches Basilikum ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schöpfe die Suppe in Schalen und serviere sie mit Scheiben knusprigem Brot zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
