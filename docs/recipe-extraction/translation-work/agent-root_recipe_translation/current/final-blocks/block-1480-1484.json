      "steps": [
        {
          "position": 0,
          "text": "Suya-Gewürz zubereiten: Gemahlene Erdnüsse (oder Erdnussbutter), Paprika, Ingwer, Knoblauchpulver, Kreuzkümmel und Cayennepfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchenstreifen mit der Gewürzpaste und Öl bedecken, auf Spieße stecken und 30 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reis mit einer Prise geräuchertem Paprika und Tomate als milde Jollof-Grundlage garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spieße bei starker Hitze 6–8 Minuten pro Seite grillen oder im Ofen grillen, bis sie gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fleisch von den Spießen schneiden und mit Reis, fein geschnittenen rohen Zwiebeln und Tomaten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
