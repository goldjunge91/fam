      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Diese mexikanische Pizza kostet $3 und ist in 20 Minuten fertig.",
        "Die Tortilla muss zuerst knusprig gebacken werden; lass diesen Schritt nicht aus.",
        "Übrig gebliebenes Hähnchen vom Grillhähnchenstand passt perfekt und spart 10 Minuten."
      ],
      "substitutions": [
