    {
      "externalId": "waivy:mfr-afr2-suya-bowl",
      "slug": "mfr-afr2-suya-bowl",
      "title": "Suya-Hähnchen-Reisschale",
      "instructions": "Suya-Gewürz aus Westafrika mit gemahlenen Erdnüssen, Ingwer, Paprika und Chili auf Hähnchenspieße gerieben und gegrillt, bis sie gebräunt sind. Auf mit Jollof-Gewürzen zubereitetem Reis mit rohen Zwiebelscheiben und Tomaten serviert: Ein beliebter nigerianischer Straßensnack als vollständiges Abendessen.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Erdnussbutter lässt sich als vorratsfreundlicher Ersatz für gemahlene Erdnüsse in der Gewürzmischung verwenden.",
        "Die Marinade passt ebenso gut zu Rindfleischstreifen oder Hähnchenoberkeulen.",
        "Bereite mehr Gewürzpaste zu; sie hält sich 2 Wochen im Kühlschrank und passt zu vielem."
      ],
      "substitutions": [
        {
          "forIngredientId": "peanut-butter",
          "swap": "2 EL geröstete Erdnüsse, im Mixer gemahlen"
        },
        {
          "forIngredientId": "cayenne",
          "swap": "Chiliflocken; nimm weniger, sie sind sehr scharf"
        }
      ],
      "crispinessLevel": null,
