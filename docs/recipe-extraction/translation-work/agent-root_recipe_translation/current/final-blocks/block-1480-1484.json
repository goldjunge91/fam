      "steps": [
        {
          "position": 0,
          "text": "Tomaten, Zwiebel und Knoblauch pürieren. Die pürierte Mischung 10 Minuten in Öl bei hoher Hitze anbraten, bis sie dunkler wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gemahlene Erdnüsse oder gemahlene Sesamsamen als Egusi-Ersatz mit Brühe einrühren. Kräftig rühren; die Mischung wird zunächst fest und dann wieder geschmeidig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchen und geräuchertes Paprika hinzufügen und 20 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spinat einrühren und weitere 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Reis und für alle, die es scharf mögen, mit zusätzlichem Cayennepfeffer servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
