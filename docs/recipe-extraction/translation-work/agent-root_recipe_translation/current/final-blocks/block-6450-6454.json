      "steps": [
        {
          "position": 0,
          "text": "Mehl, Hefe, Salz und warmes Wasser zu einem Teig vermischen und 8 Minuten kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lassen Sie den Teig in einer geölten Schüssel 45 Minuten lang gehen, bis er sich verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Speck würfeln und in einer Pfanne knusprig braten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebeln in dünne Scheiben schneiden und im Speckfett anbraten, bis sie weich und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier und Sauerrahm verquirlen, dann mit Zwiebeln, Speck und Kümmel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig auf eine geölte 9-Zoll-Kuchenform streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Zwiebelmischung gleichmäßig auf dem Teig verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 400 °F 25–30 Minuten backen, bis die Kruste goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
