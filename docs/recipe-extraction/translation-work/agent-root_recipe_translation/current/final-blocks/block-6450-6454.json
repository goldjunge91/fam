      "steps": [
        {
          "position": 0,
          "text": "Buchweizenmehl, Allzweckmehl, Zucker und Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geschmolzene Butter, Eier und Milch unterrühren, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Äpfel schälen, entkernen und in dünne Scheiben von 1/8 Zoll schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine 8-Zoll-Auflaufform einfetten und eine dünne Teigschicht auf dem Boden verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Apfelscheiben gleichmäßig auf dem Teig verteilen und mit Zimt bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den restlichen Teig über die Äpfel gießen, bis er vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375 °F 35 Minuten backen, bis die Mitte fest und die Oberseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "10 Minuten abkühlen lassen, in Spalten schneiden und warm mit Puderzucker servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
