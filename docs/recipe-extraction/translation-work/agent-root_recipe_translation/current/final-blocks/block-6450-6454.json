      "steps": [
        {
          "position": 0,
          "text": "Butter und Zucker etwa 3 Minuten lang mit dem Elektromixer schaumig rühren, bis eine leichte, lockere Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "4 Eigelb nacheinander unterrühren, dann Vanilleextrakt unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl und Salz unterheben, bis alles gut vermischt ist. Dabei darauf achten, dass nicht zu viel vermischt wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig gleichmäßig in eine runde 9-Zoll-Kuchenform oder eine Tarteform drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Restliches Eiweiß mit 1 Esslöffel Wasser verrühren und über die Teigoberfläche streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ritzen Sie die Oberfläche mit einem Messer leicht kreuzweise ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 350 °F 25–30 Minuten backen, bis der Kuchen goldbraun und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "10 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen, um es vor dem Schneiden vollständig abzukühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
