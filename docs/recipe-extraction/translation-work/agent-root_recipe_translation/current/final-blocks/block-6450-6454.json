      "steps": [
        {
          "position": 0,
          "text": "Das Wildbret in 1.5 Zoll große Würfel schneiden und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem großen Topf erhitzen und das Wildbret von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die gewürfelten Zwiebeln goldbraun anbraten, dann mit Mehl bestäuben und 1 Minute lang umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie Rotwein und Rinderbrühe hinzu und kratzen Sie die gebräunten Stücke vom Boden ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Wildbret mit Wacholderbeeren, Lorbeerblättern und Thymian in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zugedeckt 90 Minuten köcheln lassen, bis das Wild weich ist, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sauerrahm einrühren und mit Salz und Pfeffer würzen, dann weitere 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Eiernudeln oder Rotkohl servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
