      "steps": [
        {
          "position": 0,
          "text": "Verwende kalten Reis vom Vortag. Frischer Reis wird matschig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze einen Wok oder eine breite Pfanne sehr stark. Gib Öl hinein, rühre die Eier und zerteile sie in Stücke. Schiebe sie an den Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und dann den Reis dazu. Drücke und wende ihn, damit jedes Korn mit Öl bedeckt ist. Füge Erbsen und Karotten hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze mit Sojasauce und verfeinere das Gericht mit Sesamöl und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
