      "steps": [
        {
          "position": 0,
          "text": "Koche die Ramen-Nudeln nach Packungsanweisung, gieße sie ab und spüle sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Schweinehackfleisch in einer Pfanne bei mittelhoher Hitze an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwer zum Schweinefleisch und gare alles etwa 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Misopaste mit Rinderbrühe und gib die Mischung zusammen mit Sojasauce und Sake zum Schweinefleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Sauce 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Mozzarella mit verquirltem Ei in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte Nudeln, Sauce und Käsemischung abwechselnd in eine 9x9-Backform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Lasagne bei 375°F 20 Minuten, bis der Käse geschmolzen und an den Rändern Blasen wirft. Garniere sie anschließend mit Nori-Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
