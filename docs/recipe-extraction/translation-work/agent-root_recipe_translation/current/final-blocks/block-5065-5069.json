      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Kalbshaxen trocken und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende sie in Mehl und schüttle überschüssiges Mehl ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Schmortopf bei mittelhoher Hitze und bräune das Kalbfleisch von allen Seiten an, insgesamt etwa 12 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Kalbfleisch heraus und stelle es beiseite. Dünste das Gemüse im selben Topf an, bis es leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Misopaste mit Mirin und Rinderbrühe. Gib die Mischung zusammen mit dem Wein in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Kalbfleisch zurück in den Topf, decke ihn ab und schmore es bei 325°F im Ofen 2 Stunden, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Fleisch vorsichtig heraus, seihe die Schmorflüssigkeit ab und lasse sie auf dem Herd leicht eindicken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Kalbshaxen mit der Sauce und garniere sie mit Gremolata.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
