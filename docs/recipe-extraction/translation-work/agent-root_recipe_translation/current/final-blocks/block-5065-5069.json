      "steps": [
        {
          "position": 0,
          "text": "Erhitze Sesamöl in einer großen Pfanne bei mittelhoher Hitze und brate den Schweinebauch etwa 10 Minuten knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Sojasauce, Knoblauch und Frühlingszwiebeln zum Schweinefleisch. Rühre dann Kimchi ein und gare alles weitere 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Schweinefleischmischung und den Käse auf den Tortillas. Rolle sie fest auf und verschließe die Ränder mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Pflanzenöl in einer tiefen Pfanne auf 350°F und frittiere die Chimichangas etwa 3 Minuten pro Seite, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie mit saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
