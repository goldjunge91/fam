      "steps": [
        {
          "position": 0,
          "text": "Teig zubereiten: Butter und Zucker cremig schlagen. Eigelb und Zitronenabrieb dazugeben. Mehl und Maisstärke nach und nach unterrühren und zu einem Teig verkneten. 1 Stunde kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kekse backen: Teig ausrollen, Kreise ausstechen und bei 180°C (350°F) 12–15 Minuten backen. Abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zusammensetzen: Dulce de leche auf einen Keks streichen und mit einem zweiten bedecken. Ränder in Kokosraspeln rollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig vor dem Ausrollen kühlen. So lässt er sich besser verarbeiten und die Kekse laufen beim Backen nicht zu stark auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alfajores für einen besonders üppigen Genuss in geschmolzene Schokolade tauchen und auf einem Gitter fest werden lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
