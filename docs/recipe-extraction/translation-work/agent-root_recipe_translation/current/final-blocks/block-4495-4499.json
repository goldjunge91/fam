      "steps": [
        {
          "position": 0,
          "text": "Erhitze das Olivenöl in einem großen Topf bei mittlerer Hitze und brate die gewürfelte Zwiebel und den gehackten Knoblauch etwa 3 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die zerdrückten Tomaten dazu und gare sie 2 Minuten. Lösche dann mit Weißwein ab und lass ihn etwa 3 Minuten lang auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Fischbrühe dazu und bringe alles sanft zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Schalentiere in den Topf, decke ihn ab und gare sie 8-10 Minuten. Entsorge alle, die sich nicht öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die frische Petersilie ein, würze mit Salz und Pfeffer und gib zum Schluss einen Spritzer frischen Zitronensafts dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Schalentiere auf Schüsseln, gieße die Sauce darüber und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
