      "steps": [
        {
          "position": 0,
          "text": "Bitte den Fischhändler, den Aal zu säubern und zu häuten, und schneide ihn dann in 2-Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze das Olivenöl in einem großen Topf bei mittlerer Hitze und brate die gewürfelten Zwiebeln und den gehackten Knoblauch etwa 5 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die zerdrückten Tomaten dazu und gare sie 3 Minuten. Lösche dann mit Weißwein ab und lass ihn auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Fischbrühe dazu, füge die Lorbeerblätter hinzu und bringe alles sanft zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Aalstücke vorsichtig in den Topf und lass sie zugedeckt 60 Minuten köcheln. Rühre gelegentlich um, bis der Aal sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer, rühre die frische Petersilie ein und verfeinere das Gericht mit Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Brudet in Schüsseln mit reichlich Sauce und knusprigem Brot zum Tunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
