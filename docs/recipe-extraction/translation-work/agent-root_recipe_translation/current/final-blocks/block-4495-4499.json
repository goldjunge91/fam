      "steps": [
        {
          "position": 0,
          "text": "Säubere den Fisch gründlich, entferne Innereien und Schuppen und tupfe ihn mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze den Fisch innen und außen mit Salz und Pfeffer und fülle ihn dann mit Zitronenscheiben, Knoblauch und Kräuterzweigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Grill oder die Grillpfanne auf mittlere bis hohe Hitze vor und öle den Rost leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bestreiche den Fisch auf beiden Seiten großzügig mit Olivenöl und lege ihn auf den heißen Grill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille ihn auf der ersten Seite 7-8 Minuten, ohne ihn zu bewegen. Wende ihn dann vorsichtig und grille die andere Seite weitere 6-7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib ihn auf eine Servierplatte, beträufle ihn mit zerlassener Butter und frischem Zitronensaft und serviere ihn sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
