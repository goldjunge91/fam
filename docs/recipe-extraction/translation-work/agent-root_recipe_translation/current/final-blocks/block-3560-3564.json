      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 EL Öl in einem Wok oder einer großen Pfanne bei starker Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Rindfleischscheiben portionsweise 1-2 Minuten pro Seite scharf an, bis sie gebräunt sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das restliche Öl dazu und brate Knoblauch 30 Sekunden unter Rühren, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Paprika und Zwiebeln dazu und brate sie 3-4 Minuten unter Rühren, bis sie zart und noch knackig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Rindfleisch zurück in den Wok und füge Sojasauce, Austernsauce und weißen Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische alles 1-2 Minuten, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht auf Jasminreis.",
