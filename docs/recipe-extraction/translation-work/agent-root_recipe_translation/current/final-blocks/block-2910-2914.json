          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die dritte Brotscheibe obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fixiere das Sandwich mit vier Zahnstochern, die diagonal durch das Sandwich gesteckt werden.",
