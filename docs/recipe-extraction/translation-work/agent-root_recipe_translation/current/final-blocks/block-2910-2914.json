      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer Schüssel und arbeite kalte Butter ein, bis die Mischung groben Krümeln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Eiswasser hinzu, bis der Teig gerade zusammenhält. Teile ihn in zwei Hälften, wickle ihn ein und kühle ihn 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 375°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Kirschen, Zucker, Speisestärke, Zitronensaft und Mandelextrakt in einem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Mischung bei mittlerer Hitze 3-4 Minuten unter vorsichtigem Rühren, bis sie leicht eindickt. Lasse sie 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle eine Teighälfte aus und lege sie in eine 9-Zoll-Kuchenform. Gib die Kirschfüllung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rolle die zweite Teighälfte aus, lege sie über die Kirschen und drücke die Ränder zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche die Oberseite mit verquirltem Ei, schneide drei Öffnungen hinein und backe den Kuchen 50-60 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse ihn vor dem Aufschneiden mindestens 30 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
