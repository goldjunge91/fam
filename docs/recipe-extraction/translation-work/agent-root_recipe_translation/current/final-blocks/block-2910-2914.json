      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer Schüssel. Arbeite kalte Butter mit einer Gabel oder einem Teigmischer ein, bis die Mischung groben Krümeln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib esslöffelweise Eiswasser hinzu und vermische alles vorsichtig, bis der Teig gerade zusammenhält. Teile ihn in zwei Hälften, wickle sie in Folie und kühle sie 30 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 375°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge Apfelscheiben, braunen Zucker, Zimt, Muskatnuss, Zitronensaft und Speisestärke in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle eine Teighälfte aus und lege sie in eine 9-Zoll-Kuchenform. Gib die Apfelmischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle die zweite Teighälfte aus und lege sie über die Äpfel. Schneide den Rand zurecht und drücke ihn zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die Oberseite mit verquirltem Ei und schneide drei kleine Öffnungen für den Dampf hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Kuchen 50-60 Minuten, bis der Teig goldbraun ist und die Füllung am Rand blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse ihn vor dem Aufschneiden mindestens 30 Minuten auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
