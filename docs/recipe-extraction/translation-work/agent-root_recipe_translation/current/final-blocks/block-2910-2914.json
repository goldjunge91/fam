        {
          "position": 2,
          "text": "Backe den Boden 8 Minuten goldbraun. Nimm ihn heraus und lasse ihn leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage weichen Frischkäse und Zucker glatt und kratze dabei regelmäßig die Schüssel aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Eier einzeln hinzu und schlage nach jeder Zugabe auf niedriger Stufe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Vanilleextrakt und saure Sahne ein, bis alles gerade vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Füllung auf den Boden und stelle die Springform in einen größeren Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße heißes Wasser in den Bräter, bis es die Springform etwa bis zur Hälfte umgibt (Wasserbad).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backe den Kuchen 55-65 Minuten, bis die Ränder fest sind und die Mitte beim vorsichtigen Rütteln noch leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schalte den Ofen aus und lasse den Käsekuchen 1 Stunde bei leicht geöffneter Ofentür darin stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Nimm ihn aus dem Ofen und lasse ihn auf Zimmertemperatur abkühlen. Stelle ihn vor dem Servieren mindestens 4 Stunden in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
