    {
      "externalId": "waivy:drink-cosmopolitan",
      "slug": "drink-cosmopolitan",
      "title": "Cosmopolitan",
      "instructions": "Der berühmte rosafarbene Cocktail: Zitrus-Wodka, Triple Sec, herbe Cranberry und frische Limette, eiskalt geschüttelt und ohne Eis serviert. Klar, trocken und elegant, mit flambierter Orangen- oder Limettenzeste.",
      "prepTimeMinutes": 4,
      "cookTimeMinutes": 4,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Einfachen Wodka mit einem zusätzlichen Spritzer Limette verwenden; so erhältst du günstiger einen ähnlichen Zitrusgeschmack.",
        "Kaufe 100% Cranberrysaft und verdünne ihn mit etwas Wasser und Sirup, statt gesüßten Cranberry-Cocktail zu nehmen.",
        "Nimm statt eines Marken-Orangenlikörs einen guten Triple Sec. Er bringt dieselbe frische Orangennote."
      ],
      "substitutions": [
        {
          "forIngredientId": "triple-sec",
          "swap": "gleich parts Orange juice mit ein Teelöffel von Zucker",
          "savings": "~$0.40/Getränk"
        },
        {
          "forIngredientId": "simple-syrup",
          "swap": "Agave syrup oder Honig, thinned mit ein little warm Wasser",
          "savings": "~$0.10/Getränk"
        },
        {
          "forIngredientId": "cranberry-juice",
          "swap": "Pomegranate oder cranberry-raspberry juice",
          "savings": "etwa gleich"
        }
      ],
