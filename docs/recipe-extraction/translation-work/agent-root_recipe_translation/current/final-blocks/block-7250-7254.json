    {
      "externalId": "waivy:drink-whiskey-sour",
      "slug": "drink-whiskey-sour",
      "title": "Whiskey Sour",
      "instructions": "Der klassische Sour: Bourbon, ausbalanciert mit frischer Zitrone und etwas einfachem Sirup, kalt geschüttelt und auf Eis serviert. Spritzig, säuerlich und weich, mit einem Hauch aromatischen Bitters.",
      "prepTimeMinutes": 3,
      "cookTimeMinutes": 3,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Bereite einfachen Sirup aus gleichen Teilen Zucker und heißem Wasser selbst zu. Das ist deutlich günstiger als gekaufter Sirup.",
        "Verwende frische Zitronen statt Saft aus der Flasche. Eine Zitrone reicht für zwei Drinks und schmeckt frischer.",
        "Bourbon aus dem mittleren Preissegment genügt; Zitrone und Sirup mildern kräftige Noten."
      ],
      "substitutions": [
        {
          "forIngredientId": "whiskey",
          "swap": "verwenden bourbon oder rye - rye gives ein spicier, drier sour",
          "savings": "Eine Flasche der mittleren Preisklasse eignet sich gut und kostet ~$0.50/oz weniger als Premiumware"
        },
        {
          "forIngredientId": "simple-syrup",
          "swap": "Swap in Honig syrup (Honig thinned mit warm Wasser) für ein Gold Rush variation",
          "savings": "Ungefähr gleiche Kosten, volleres Aroma"
        },
        {
          "forIngredientId": "bitters",
          "swap": "weglassen der bitters entirely - der Getränk is still balanced ohne them",
          "savings": "Spart den Kauf einer Flasche Bitter."
        }
