      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Butter und Zucker cremig und luftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Eier einzeln unter und gib dann Vanilleextrakt hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Siebe Mehl und Salz zusammen und rühre sie unter die Buttermischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Setze kleine Löffel Teig mit 3 Zoll Abstand auf das vorbereitete Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Kekse 6-8 Minuten, bis die Ränder goldbraun und die Mitte noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie aus dem Ofen und bestreue sie sofort mit geriebenem Käse und Zimt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rolle jeden Keks noch warm und zügig fest um einen Rundstab oder Griff und ziehe ihn dann auf ein Gitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse die Kekse vollständig abkühlen, bevor du sie in einem luftdichten Behälter aufbewahrst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
