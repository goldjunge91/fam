      "steps": [
        {
          "position": 0,
          "text": "Püriere Zwiebeln, Knoblauch, Ingwer und rote Chilis zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und dünste die Gewürzpaste 2 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Rinderhackfleisch hinzu und gare es 5 Minuten, während du es beim Bräunen zerteilst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Kurkumapulver ein und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch und Wasser hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze und lasse alles ohne Deckel 25 Minuten köcheln, bis die Sauce eindickt und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und schwarzem Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
