      "steps": [
        {
          "position": 0,
          "text": "Schäle die grüne Papaya, entferne die Kerne und schneide sie in 1 Zoll große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Wasser und Zucker in einem großen Topf zu einem einfachen Sirup und bringe ihn zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Papayawürfel, Zimtstange, Nelken, Limettensaft und Salz hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittel und lasse alles 45-50 Minuten köcheln. Rühre gelegentlich um, bis die Papaya durchscheinend wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Vanilleextrakt hinzu und lasse alles weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und lasse den Inhalt auf Raumtemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Papaya in Gläser und stelle sie bis zum Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gekühlt als Dessert oder süßen Snack servieren und mit Sirup übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
