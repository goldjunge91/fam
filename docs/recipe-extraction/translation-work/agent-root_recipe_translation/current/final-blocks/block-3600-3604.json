      "steps": [
        {
          "position": 0,
          "text": "Weiche Bananenblätter kurz in heißem Wasser ein, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Achiote-Paste, Limettensaft, Orangensaft, Knoblauch und Salz zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle und entdärme die Garnelen, bedecke sie mit der Marinade und stelle sie 20 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere Tomate, Habanero und den übrigen Knoblauch mit einem Schuss Wasser zu einer Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide die Zwiebel in Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Bananenblätter aus und verteile die marinierten Garnelen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Portion Garnelen mit Tomatensauce und Zwiebelringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Falte die Bananenblätter zu Päckchen und binde sie mit Küchengarn zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Grille die Päckchen bei mittelhoher Hitze 12-15 Minuten oder backe sie bei 400°F 15-18 Minuten, bis die Garnelen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere die Päckchen in den Bananenblättern mit Limettenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
