      "steps": [
        {
          "position": 0,
          "text": "Schneide 3 Zwiebeln in dünne Scheiben. Schmilz Butter und Öl in einer ofenfesten Pfanne bei mittelniedriger Hitze. Gib Zwiebeln und eine Prise Salz dazu. Gare sie 20–25 Minuten und rühre alle paar Minuten um, bis sie tief karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schiebe die Zwiebeln an den Rand und erhöhe die Hitze auf mittelhoch. Würze das Hähnchen und brate es mit der Hautseite nach unten 4 Minuten an, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch, Thymian und Brühe dazu. Lege das Hähnchen in die Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass alles zugedeckt 10 Minuten köcheln. Nimm dann den Deckel ab und gare das Hähnchen weitere 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib geriebenen Käse auf das Hähnchen und grille es 2 Minuten im Ofen, bis der Käse blubbert. Serviere es auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
