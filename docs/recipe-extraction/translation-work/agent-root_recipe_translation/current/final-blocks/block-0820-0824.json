      "steps": [
        {
          "position": 0,
          "text": "Klopfe das Hähnchen auf ½ Zoll Dicke. Würze es und wende es leicht in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Hähnchen in Olivenöl 3–4 Minuten pro Seite an, bis es goldbraun ist. Nimm es aus der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch dazu und gare ihn 30 Sekunden. Lösche die Pfanne mit Brühe und Zitronensaft ab. Lass den Wein weg, falls du keinen hast. Gib Butter dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Zucchini mit einem Spiralschneider oder einem Messer in feine Streifen und brate sie 2 Minuten in derselben Pfanne an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Hähnchen zurück in die Sauce. Serviere es auf Zucchininudeln mit Petersilie.",
          "timerMinutes": null,
