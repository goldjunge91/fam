      "steps": [
        {
          "position": 0,
          "text": "Brate Zwiebel, Karotte und Staudensellerie 6 Minuten in Olivenöl an. Gib Knoblauch und Rosmarin dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib zerkleinerte Tomaten dazu und gare sie 4 Minuten. Gieße die Brühe hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib abgetropfte weiße Bohnen und gehackten Grünkohl dazu. Lass alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reiße altbackenes Brot in Stücke oder verwende getoastetes Brot. Rühre es in die Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Suppe weitere 10 Minuten köcheln, bis sich das Brot aufgelöst hat und die Suppe zu einem dicklichen Eintopf geworden ist. Würze sie und serviere sie mit gutem Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
