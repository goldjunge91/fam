      "steps": [
        {
          "position": 0,
          "text": "Feuer vorbereiten: Entzünde im Grill ein Holzfeuer und lass es herunterbrennen, bis Glut entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fleisch würzen: Salze die Rindfleischstücke großzügig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fleisch grillen: Lege das Rindfleisch auf den Grill, die dicksten Stücke am weitesten von der Glut entfernt. Gib Chorizo und Morcilla später dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf den gewünschten Gargrad bringen: Wende das Fleisch gelegentlich und grille es, bis es den gewünschten Gargrad erreicht. Rippchen brauchen oft bis zu 2 Stunden; dünnere Stücke garen schneller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ruhen lassen und servieren: Lass das Fleisch vor dem Aufschneiden etwa 10 Minuten ruhen. Serviere es mit Chimichurri und gegrilltem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verwende eine Mischung aus Holz und Holzkohle für gleichmäßige Hitze. Holz gibt Aroma, Holzkohle hält die Temperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze das Fleisch erst kurz vor dem Grillen, damit es saftig und aromatisch bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviervorschläge:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Serviere es mit Chimichurri, frischem Tomatensalat und knusprigem Brot. Ein kräftiger Malbec passt gut zu den herzhaften Aromen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
