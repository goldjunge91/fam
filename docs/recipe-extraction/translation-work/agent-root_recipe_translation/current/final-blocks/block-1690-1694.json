      ],
      "steps": [
        {
          "position": 0,
          "text": "Nimm den Blätterteig aus dem Gefrierfach und lass ihn auftauen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streue etwas Mehl auf die Arbeitsfläche. Lege die Blätterteigplatten übereinander und rolle sie mit einem Nudelholz aus. Die fünf Platten sollen am Ende so dünn wie eine einzelne Platte sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke mit einer runden oder ovalen Form Kekse aus dem Teig und nutze die Fläche möglichst sparsam, damit du möglichst viele erhältst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge Vanillezucker, Zimt, Kardamom und Limettenabrieb in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Entferne das Mehl von der Arbeitsfläche und streue etwas von der Zuckermischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche den Blätterteig mit etwas verquirltem Ei, tauche ihn dann in die Zuckermischung und rolle ihn vorsichtig darin, damit der Zucker haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege den gezuckerten Blätterteig auf ein gefettetes oder mit Backpapier belegtes Blech und lass den Teig etwa 20 to 25 Minuten ruhen. So werden die Kekse noch knuspriger.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heize währenddessen den Ofen auf 180 C vor und schiebe das Blech hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backe die Kekse etwa 25 Minuten goldbraun, bis der Zucker schön karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Und voilà: Arnhemse Meisjes mit einem Hauch aus Almere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Voilà: Arnhemse Meisjes mit einem Hauch aus Almere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
