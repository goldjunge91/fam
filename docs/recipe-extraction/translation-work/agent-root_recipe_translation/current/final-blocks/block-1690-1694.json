      "steps": [
        {
          "position": 0,
          "text": "Feigen vorbereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die harten Stielenden ab und halbiere die Feigen längs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Feigen mit der Schnittfläche nach oben in eine kleine Pfanne und gieße das Wasser darum herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Feigen garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Feigen bei mittlerer Hitze garen. Sobald sie weich sind, nimm sie aus der Pfanne und lege sie auf eine Servierplatte. Das dauert etwa 10 - 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sirup zubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In der Pfanne bleibt roter Feigensaft zurück. Gib den Zucker dazu und erhitze alles bei mittlerer Hitze. Rühre ein paar Minuten ständig, bis der Saft zu einem dickflüssigen Sirup wird. Nimm die Pfanne vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Drücke jeweils eine Walnusshälfte in jede Feige und träufle den Sirup darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Warm oder abgekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
