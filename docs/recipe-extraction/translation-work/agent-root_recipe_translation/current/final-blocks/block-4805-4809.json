      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in 1 Zoll große Würfel schneiden und 10 Minuten kochen, bis sie halb gar sind. Abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne erhitzen. Kreuzkümmelsamen hineingeben und etwa 30 Sekunden rösten, bis sie aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die gewürfelte Zwiebel dazu und dünste sie 3 Minuten, bis sie weich ist. Füge den gehackten Knoblauch und Ingwer hinzu und gare alles weitere 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Tomaten, Kurkuma und Garam Masala einrühren und 3 Minuten garen, bis die Tomaten zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die vorgekochten Kartoffeln dazugeben, gut umrühren und 5 Minuten weitergaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den frischen Spinat portionsweise einrühren, bis er zusammenfällt. Kokosmilch zugießen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
