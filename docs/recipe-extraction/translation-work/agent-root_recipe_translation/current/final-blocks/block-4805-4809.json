      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 350°F vor. Schneide Aubergine und Zucchini längs in 1/4 Zoll dicke Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Gemüsestreifen mit Olivenöl bestreichen und auf zwei Backblechen 20 Minuten backen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebel sowie Knoblauch 3 Minuten darin dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dosentomaten dazugeben und 15 Minuten köcheln lassen. Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Béchamelsauce Butter schmelzen und Mehl einrühren, bis eine Paste entsteht. Milch langsam unter ständigem Rühren zugießen und kochen, bis die Sauce eindickt. Mit Muskatnuss würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hälfte von Aubergine und Zucchini in einer 9x13 Zoll großen Auflaufform schichten, mit Tomatensauce bestreichen und das restliche Gemüse darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Béchamelsauce darübergießen, mit Feta bestreuen und 30–35 Minuten backen, bis die Oberfläche goldbraun ist und die Sauce blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
