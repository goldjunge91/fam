          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das restliche Öl hineingeben und Paprika, Karotten und Brokkoli 4 Minuten unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eingeweichte Nudeln, Tamarindenpaste, Fischsauce, Limettensaft und braunen Zucker dazugeben und unter ständigem Rühren 3 Minuten braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den gegarten Tofu wieder dazugeben und alles 1 Minute vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
