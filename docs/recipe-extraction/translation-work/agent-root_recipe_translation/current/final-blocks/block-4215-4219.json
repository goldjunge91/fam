          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln in dünne Ringe schneiden und Paprika sowie Tomaten würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch hinzufügen und 30 Sekunden anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Leberstücke hinzufügen und je Seite 3-4 Minuten bräunen, sodass sie innen noch leicht rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Leber herausnehmen und beiseitestellen; dann Zwiebeln und Paprika in derselben Pfanne 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tomaten, Salz und Pfeffer hinzufügen und die Leber zurück in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten köcheln lassen, damit sich die Aromen verbinden, dann mit Koriander garnieren und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
