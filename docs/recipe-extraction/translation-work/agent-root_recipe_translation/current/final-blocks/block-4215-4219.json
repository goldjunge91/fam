      "steps": [
        {
          "position": 0,
          "text": "Masa Harina mit warmem Wasser und 1/2 TL Salz vermengen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhack mit gehacktem Knoblauch und gewürfelter Zwiebel etwa 5 Minuten in einer Pfanne anbraten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomaten aus der Dose, Kreuzkümmel und Salz zur Fleischmischung geben und 8 Minuten köcheln lassen; dann etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Masa-Teig in 12 kleine Kugeln teilen und jede in der Handfläche zu einer dünnen Scheibe flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen Löffel Fleischfüllung in die Mitte jeder Masa-Scheibe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Masa über die Füllung falten, sodass eine Halbmondform entsteht, und die Ränder zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne auf 350°F erhitzen und Molotes portionsweise je Seite 2-3 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
