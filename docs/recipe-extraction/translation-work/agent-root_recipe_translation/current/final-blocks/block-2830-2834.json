      "steps": [
        {
          "position": 0,
          "text": "Essig, Brühe, geschnittene Zwiebeln, Knoblauch, Lorbeerblätter, Wacholderbeeren und Pfefferkörner in einer großen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rindfleisch in die Marinade legen, abdecken und mindestens 24 Stunden oder bis zu 3 Tage im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rindfleisch aus der Marinade nehmen, trocken tupfen und salzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einem Schmortopf erhitzen und das Rindfleisch insgesamt 8-10 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Marinade abseihen, Flüssigkeit auffangen und feste Bestandteile entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Marinadenflüssigkeit über das Rindfleisch gießen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und bei 325°F 2.5 Stunden im Ofen schmoren, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rindfleisch herausnehmen und Gewürzspekulatius in die Schmorflüssigkeit zerbröseln; 5 Minuten köcheln lassen, bis die Sauce eindickt, dann Fleisch aufschneiden und mit Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
