      "steps": [
        {
          "position": 0,
          "text": "Knoblauch, Schalotten, Ingwer und Galgant zu einer glatten Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kurkuma, Salz und Paste in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürzmischung auf alle Hähnchenteile reiben und 20 Minuten marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser zum marinierten Hähnchen geben und zugedeckt in einem Topf 15 Minuten köcheln lassen, bis es halb gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einem tiefen Topf auf 350°F erhitzen und die marinierten Hähnchenteile portionsweise vorsichtig 8-10 Minuten goldbraun und gar frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf Küchenpapier abtropfen lassen und mit einem Spritzer Limettensaft abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Sambal Matah und gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
