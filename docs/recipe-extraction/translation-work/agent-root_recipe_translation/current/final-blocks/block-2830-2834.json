      "steps": [
        {
          "position": 0,
          "text": "Mehl, Eier, Milch, Salz, Pfeffer und Muskatnuss verquirlen, bis ein klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salzwasser in einem großen Topf sprudelnd zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig portionsweise durch ein Sieb oder einen Spätzlehobel direkt ins kochende Wasser drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spätzle nach dem Aufsteigen 2-3 Minuten garen und dann mit einer Schaumkelle herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochte Spätzle in eine gebutterte Auflaufform geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zwiebel dünn schneiden und in 3 tablespoons Butter goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Spätzle mit der restlichen Butter vermengen und mit karamellisierten Zwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen und heiß als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
