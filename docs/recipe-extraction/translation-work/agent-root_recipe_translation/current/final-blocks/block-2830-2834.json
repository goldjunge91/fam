      "steps": [
        {
          "position": 0,
          "text": "Zwiebel dünn schneiden und Öl in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebel 5 Minuten weich dünsten und dann an den Rand der Pfanne schieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bratwürste in die Pfanne legen und pro Seite 2 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bier und Rinderbrühe um die Würste herum in die Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze auf mittelniedrig reduzieren und 10 Minuten köcheln lassen, bis die Würste durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würste herausnehmen und die Flüssigkeit 2 Minuten einkochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würste zurück in die Pfanne legen und Senf, Salz und Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Brötchen mit karamellisierten Zwiebeln und zusätzlichem Senf als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
