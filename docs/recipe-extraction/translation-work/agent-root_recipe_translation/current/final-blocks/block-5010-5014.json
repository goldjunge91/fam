      "steps": [
        {
          "position": 0,
          "text": "Die Kartoffeln in 1-Zoll-Würfel schneiden und 10 Minuten in kaltem Wasser einweichen. Dann trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Kartoffeln mit Maisstärke und Salz überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem Wok bei starker Hitze erhitzen und die Kartoffelwürfel etwa 8–10 Minuten goldbraun und knusprig frittieren. Auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knoblauch fein hacken und rote Chilischoten in Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Honig, Sojasauce und Essig in einer kleinen Schüssel verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehackten Knoblauch und Chilischoten mit etwas Öl in den Wok geben und 30 Sekunden unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die frittierten Kartoffeln in den Wok geben, die Honig-Sojasauce darüber gießen und 1–2 Minuten vermengen, bis alles überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit gehackten Frühlingszwiebeln garnieren und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
