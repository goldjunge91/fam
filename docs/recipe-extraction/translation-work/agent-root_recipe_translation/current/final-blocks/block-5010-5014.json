        {
          "position": 4,
          "text": "Hühnerbrühe zugießen und zum Köcheln bringen. Dann Sojasauce und Essig hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Gemüsekugeln vorsichtig zurück in die Sauce geben und 3–4 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
