          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauchzehen fein hacken und mit dem restlichen Öl in den Wok geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Knoblauch 1 Minute unter Rühren braten, bis er goldbraun zu werden beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Hähnchen zurück in den Wok geben und Sojasauce, Ingwer und Hühnerbrühe hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2–3 Minuten vermengen, bis das Hähnchen vollständig mit der Knoblauchsauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Sesamöl beträufeln und mit gehackten Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort auf Reis servieren.",
          "timerMinutes": null,
