      "steps": [
        {
          "position": 0,
          "text": "Gehackten Kohl, geriebene Karotte, Erbsen, Maisstärke und Mehl mit Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Mischung zu Kugeln von etwa 1.5 Zoll Durchmesser formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem Wok bei starker Hitze erhitzen und die Gemüsekugeln insgesamt etwa 8 Minuten rundherum goldbraun braten. Dann beiseitestellen.",
