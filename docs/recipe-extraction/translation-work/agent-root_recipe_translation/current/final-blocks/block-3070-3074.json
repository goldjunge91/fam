      "steps": [
        {
          "position": 0,
          "text": "Erhitze 3 EL Öl in einem Topf und bräune Rindfleischstücke von allen Seiten. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel, bis sie goldbraun ist. Gib getrocknete Kräuter hinzu und gare sie 1 Minute, dann gib das Rindfleisch zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 3 Tassen Wasser, Salz und Pfeffer hinzu, decke den Topf ab und lasse alles 45 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Kidneybohnen ab, spüle sie ab, rühre sie in den Eintopf und lasse alles ohne Deckel 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche währenddessen den Reis 10 Minuten in kochendem Salzwasser, bis er teilweise gar ist, und gieße ihn dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Butter und das restliche Öl in einem großen Topf. Schichte Reis, dann Eintopf und darauf den übrigen Reis hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf fest ab, reduziere die Hitze auf mittlere bis niedrige Stufe und gare alles 15 Minuten, bis sich am Boden knuspriger Tahdig gebildet hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
