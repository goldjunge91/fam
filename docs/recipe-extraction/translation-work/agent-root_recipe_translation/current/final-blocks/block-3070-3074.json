      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und bräune gewürfeltes Rindfleisch etwa 8 Minuten von allen Seiten. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel im selben Topf, bis sie goldbraun ist. Rühre Tomatenmark und Kurkuma ein und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch mit Wasser, Salz, Pfeffer und eingestochenen getrockneten Limetten zurück in den Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 45 Minuten köcheln, bis das Rindfleisch fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kidneybohnen aus der Dose ab, spüle sie ab, gib sie in den Topf und lasse alles ohne Deckel weitere 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht, passe die Würzung an und serviere es auf gedämpftem Basmatireis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
