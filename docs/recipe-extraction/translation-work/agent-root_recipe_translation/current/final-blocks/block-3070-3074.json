      "steps": [
        {
          "position": 0,
          "text": "Weiche Kichererbsen und Bohnen über Nacht in getrennten Schüsseln mit Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Säubere Lammkopf und -keulen gründlich, blanchiere sie 5 Minuten in kochendem Wasser, gieße sie ab und spüle sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe 3 Quarts frisches Wasser in einem großen Topf zum Kochen und gib Lammkopf, Keulen, halbierte Zwiebel, Kurkuma, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse alles zugedeckt 2 Stunden köcheln. Gieße dann die eingeweichten Kichererbsen und Bohnen ab und gib sie in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles eine weitere Stunde köcheln, bis sich das Fleisch von den Knochen löst und die Hülsenfrüchte sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Löse das Fleisch von den Knochen, zerpflücke es fein und gib es mit den gegarten Hülsenfrüchten zurück in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 15 Minuten köcheln, damit sich die Aromen verbinden. Passe die Würzung an und serviere die Suppe heiß mit warmem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
