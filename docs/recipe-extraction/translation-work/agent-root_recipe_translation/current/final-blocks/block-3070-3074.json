      "steps": [
        {
          "position": 0,
          "text": "Hacke Zwiebel, Knoblauch und Petersilie fein und vermische sie mit Rinderhackfleisch, Ei, Salz, Pfeffer und Kurkuma in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische alles vorsichtig, bis es gerade verbunden ist. Teile die Masse in 8 gleich große Portionen und forme jede fest um einen Metallspieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und gare die Kebabs 8 Minuten. Wende sie gelegentlich, bis sie gebräunt und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste das Fladenbrot in derselben Pfanne oder über einer Flamme 30 Sekunden pro Seite, bis es warm und leicht angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ziehe jeden Kebab vom Spieß auf ein Stück Fladenbrot und wickle es fest darum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort mit Tomaten-, Zwiebel- und Kräuterscheiben als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
