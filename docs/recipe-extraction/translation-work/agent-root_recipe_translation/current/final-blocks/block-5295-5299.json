      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln in dicke Steak-Pommes schneiden und 15 Minuten in kaltem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln mit Küchenpapier vollständig trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einem tiefen Topf auf 325°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Pommes 5 Minuten frittieren, herausnehmen und 5 Minuten abkühlen lassen. Dann weitere 8-10 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf Küchenpapier abtropfen lassen und mit Salz und Cajun-Gewürz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pommes in einer Servierschale anrichten und mit amerikanischen Käsescheiben belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zerbröseltes Hackfleisch, Speckstückchen, gebratene Zwiebeln und einen Klecks Mayonnaise dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit zusätzlichen Servietten servieren.",
          "timerMinutes": null,
