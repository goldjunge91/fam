          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Dutch Oven in einem 500°F heißen Ofen 30 Minuten lang vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig auf einer bemehlten Arbeitsfläche zu einer Kugel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig vorsichtig in den vorgeheizten Dutch Oven legen und die Oberfläche mit einem scharfen Messer einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit dem Deckel abdecken und 30 Minuten backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Deckel abnehmen und weitere 15–20 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Aus dem Topf nehmen und vor dem Anschneiden mindestens 1 Stunde auf einem Gitter abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
