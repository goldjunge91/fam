      "steps": [
        {
          "position": 0,
          "text": "Schneide Auberginen längs in 1/2 Zoll dicke Scheiben und bestreiche beide Seiten mit Pflanzenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Grillpfanne bei mittelhoher Hitze und grille die Auberginenscheiben auf jeder Seite 4-5 Minuten, bis sie weich und markiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Sojasauce, Reisessig, Sesamöl, Knoblauch, Chiliflocken und Honig in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte die gegrillte Aubergine auf einer Servierplatte an und gieße die Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garniere mit Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere bei Zimmertemperatur oder warm mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
