      "steps": [
        {
          "position": 0,
          "text": "Spüle den Reis kurz ab und gib ihn mit Hühnerbrühe und Wasser in einen großen Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe alles zum Kochen, reduziere die Hitze und lasse es ohne Deckel 35 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Ingwer, Salz und weißen Pfeffer dazu und rühre um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche den Reis weitere 5 Minuten, bis er sehr weich und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre gehacktes eingelegtes Gemüse unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe den Reisbrei in Schalen und garniere ihn mit gerösteten Erdnüssen, Frühlingszwiebeln und etwas Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
