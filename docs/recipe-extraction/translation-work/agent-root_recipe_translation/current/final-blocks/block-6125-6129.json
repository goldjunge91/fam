      "steps": [
        {
          "position": 0,
          "text": "Weiche Holzspieße 30 Minuten in Wasser ein, damit sie nicht verbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Sojasauce, Pflanzenöl, Knoblauch, Ingwer, Kreuzkümmel, Chilipulver und Sesamöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Fleischwürfel in die Marinade und lasse sie 10 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke das marinierte Fleisch auf Spieße und lasse kleine Abstände zwischen den Stücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Spieße bei mittelhoher bis hoher Hitze oder in einer Grillpfanne 8-10 Minuten. Wende sie alle 2 Minuten gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege sie auf einen Teller und garniere sie mit gehackten Frühlingszwiebeln und zusätzlichem Kreuzkümmelpulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit gedämpftem Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
