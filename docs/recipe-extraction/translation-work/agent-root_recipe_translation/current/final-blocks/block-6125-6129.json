          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Spiralen auf ein Backblech, bestreiche sie mit verquirltem Ei und bestreue sie mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 375°F 15-18 Minuten goldbraun.",
