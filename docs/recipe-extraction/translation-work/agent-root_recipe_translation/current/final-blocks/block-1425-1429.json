    {
      "externalId": "waivy:mfr-jp-katsudon",
      "slug": "mfr-jp-katsudon",
      "title": "Katsudon (Reisschale mit japanischem Schnitzel)",
      "instructions": "Ein knuspriges, in Panko paniertes Schweineschnitzel, das in einer süß-herzhaften Dashi-Sojasauce mit Zwiebeln und Ei geschmort und auf lockerem japanischem Reis serviert wird. Japans ultimatives Wohlfühlgericht, beliebt vom Izakaya bis zur heimischen Küche.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Hähnchenbrust funktioniert genauso gut wie Schweinefleisch und kostet weniger.",
        "Panko sorgt für die knusprigste Panade, normale Semmelbrösel funktionieren aber auch.",
        "Die Sauce eignet sich auch hervorragend als Dip für Reste."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-breast",
          "swap": "Dünn geklopftes Schweinelendensteak für die authentische Variante"
        },
        {
          "forIngredientId": "mirin",
          "swap": "1 EL Reiswein und 1 TL Zucker"
        }
      ],
