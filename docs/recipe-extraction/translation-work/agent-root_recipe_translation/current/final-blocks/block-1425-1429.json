      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenoberkeulen in 2 Zoll große Stücke. Mariniere sie 20 Minuten oder bis über Nacht in Sojasauce, Mirin, geriebenem Ingwer, Knoblauch und Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe das Hähnchen trocken und wende es in Mehl oder, falls vorhanden, Kartoffelstärke, bis es vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Frittiere es zunächst bei 340°F 4 Minuten. Es soll durchgegart, aber noch nicht sehr knusprig sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass es 3 Minuten ruhen und frittiere es dann bei 375°F weitere 1–2 Minuten, bis es goldbraun und splitterknusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere es auf Reis mit fein geschnittenem Kohl, einem Spritzer Zitrone und Kewpie-Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
