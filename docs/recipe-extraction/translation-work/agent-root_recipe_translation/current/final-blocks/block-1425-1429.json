      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis. Schneide die Hähnchenbrust waagerecht in dünne Schnitzel und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Paniere das Hähnchen: Wende es erst in Mehl, dann in verquirltem Ei und anschließend in Semmelbröseln. Brate es in etwa 1/2 Zoll heißem Öl pro Seite 3–4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche für die Sauce die in dünne Scheiben geschnittene Zwiebel mit Sojasauce, Mirin, Zucker und 3 EL Wasser 3 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das in Streifen geschnittene Schnitzel in die leicht köchelnde Sauce. Gieße verquirltes Ei darum und gare alles zugedeckt 1 Minute, bis das Ei gerade gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib alles auf den heißen Reis und garniere mit geschnittener Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
