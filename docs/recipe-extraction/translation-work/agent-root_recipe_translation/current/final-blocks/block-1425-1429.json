      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis. Verquirle pro Person 3 Eier mit je einem Schuss Sojasauce, Mirin und Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine beschichtete Pfanne bei mittlerer Hitze und pinsle sie mit Öl aus. Gieße 1/3 der Eiermischung hinein und lass sie 30 Sekunden stocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle das Ei mit Stäbchen oder einem Pfannenwender zu einer Seite der Pfanne und schiebe die Rolle an den gegenüberliegenden Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße ein weiteres 1/3 der Eiermischung hinein und rolle die vorhandene Rolle darüber. Wiederhole den Vorgang, nimm das Omelett heraus und schneide es auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Scheiben auf den Reis und garniere mit Frühlingszwiebel und Furikake.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
