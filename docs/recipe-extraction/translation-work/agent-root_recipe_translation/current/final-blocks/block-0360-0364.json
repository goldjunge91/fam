      "steps": [
        {
          "position": 0,
          "text": "Lege die Hähnchensteaks auf ein Brett. Vermische Meersalz, schwarzen Pfeffer, Knoblauchpulver und edelsüßes Paprikapulver in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verteile die Gewürzmischung gleichmäßig auf beiden Seiten des Hähnchens und reibe sie mit den Händen leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Olivenöl in einer großen, schweren Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Hähnchen auf jeder Seite 3-4 Minuten, bis es goldbraun und durchgegart ist. Lege es dann auf einem Teller beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den gehackten Knoblauch in dieselbe Pfanne und brate ihn unter Rühren 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Kirschtomaten dazu und gare sie unter Rühren 1-2 Minuten. Drücke sie mit der Rückseite eines Löffels an, damit ihr Saft austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Sahne dazu und lass sie 1-2 Minuten köcheln, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Pfanne vom Herd. Rühre Zucchini-Nudeln, Pesto und Parmesan 1-2 Minuten unter, bis die Zucchini leicht weich wird. Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib das gegarte Hähnchen darauf. Garniere das Gericht mit Basilikumblättern und zusätzlichem Parmesan. Nach Wunsch noch einen Klecks Pesto daraufgeben und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
