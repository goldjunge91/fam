      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf mit Salzwasser für die Pasta zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wenn du frische Lasagneplatten verwendest, schneide oder reiße sie in etwa 1 Zoll breite Streifen und gare sie erst, wenn die Soße fertig ist (30-60 Sekunden). Gieße sie anschließend ab und gib sie direkt zur Soße. Bei normaler Pasta: Koche sie 1 Minute kürzer als auf der Packung angegeben und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Olivenöl in einer großen Pfanne bei mittlerer Hitze. Gib die Wurst dazu, zerkleinere sie in kleine Stücke und brate sie etwa 5 Minuten, bis sie gebräunt und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Knoblauch dazu und brate ihn 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre das Tomatenmark ein und gare es 1-2 Minuten, damit es karamellisiert und sein Aroma kräftiger wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Weißwein oder zusätzliche Brühe dazu und lass alles 2-3 Minuten köcheln. Kratze dabei die gebräunten Reste vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sobald der Großteil des Weins verdampft ist, gib die Hühnerbrühe dazu und koche alles 2-3 Minuten, bis die Flüssigkeit um die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre die italienischen Kräuter und nach Wunsch die Chiliflocken ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib die Sahne dazu, rühre gut um und lass alles 3-4 Minuten köcheln, bis die Soße leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Rühre den geriebenen Parmesan ein und schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Schalte den Herd aus, gib die gekochte Pasta dazu und vermische sie mit der Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Garniere das Gericht mit frischem Basilikum und serviere es sofort mit zusätzlichem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
