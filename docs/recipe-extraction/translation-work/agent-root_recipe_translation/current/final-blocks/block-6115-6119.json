          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zwiebelscheiben dazu und gare sie etwa 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Wasser in den Topf und bringe es zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge Kurkuma und Salz hinzu und lege die Fischfilets vorsichtig ins kochende Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse alles 10-12 Minuten köcheln, bis der Fisch zart und gar ist. Achte darauf, ihn nicht zu zerbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere mit frischem Koriander und serviere die Suppe mit der Brühe in Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
