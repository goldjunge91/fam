      "steps": [
        {
          "position": 0,
          "text": "Schneide überschüssiges Fett von der Schweineschulter ab und reibe sie rundherum mit Salz, schwarzem Pfeffer und Knoblauchpulver ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Heize Smoker oder Grill auf 225 °F vor. Lege die Schweineschulter mit der Fettseite nach oben hinein und räuchere sie 6–8 Stunden, bis die Kerntemperatur 190 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Apfelessig, Ketchup, braunen Zucker, schwarzen Pfeffer und Chiliflocken in einem Topf und erhitze die Sauce 5 Minuten bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch aus dem Smoker und lasse es 15 Minuten ruhen. Zupfe es dann mit zwei Gabeln vollständig auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge das Pulled Pork mit der Lexington-Sauce, bis es gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Hamburgerbrötchen leicht auf dem Grill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Pulled Pork auf den gerösteten Brötchen und belege es mit Krautsalatmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
