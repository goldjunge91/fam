      "steps": [
        {
          "position": 0,
          "text": "Püriere die Maiskörner mit dem Ei, bis die Masse größtenteils glatt ist und noch einige kleine Maisstückchen enthält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Mehl, Zucker, Salz und 3 Esslöffel geschmolzene Butter ein, bis ein dickflüssiger, aber gießbarer Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine beschichtete Pfanne oder Grillplatte bei mittlerer Hitze und fette sie leicht mit Öl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 1/3 Tasse Teig auf die heiße Fläche und backe ihn 2–3 Minuten, bis die Unterseite goldbraun und der Rand fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende den Fladen vorsichtig und backe die andere Seite 1–2 Minuten hellgoldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege eine Scheibe Queso de Mano oder Mozzarella auf eine Hälfte jeder Cachapa, solange sie noch heiß ist. Klappe sie zusammen und gib ein kleines Stück Butter darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm. Wiederhole den Vorgang mit dem restlichen Teig; insgesamt ergeben sich 6–9 Cachapas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
