      "steps": [
        {
          "position": 0,
          "text": "Schneide die Wurst in 1/2 Zoll dicke Scheiben und ritze die Oberfläche kreuzweise mit einem Messer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Heize den Grill auf mittelhohe Hitze vor. Lege die Wurstscheiben direkt auf den Rost und grille sie 3–4 Minuten pro Seite, bis sie gut gebräunt und durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in einer gusseisernen Pfanne auf dem Grill und brate die Zwiebelscheiben und Jalapeños etwa 8 Minuten karamellisiert an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Brotscheiben auf dem Grill auf jeder Seite etwa 1 Minute goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche das geröstete Brot mit Senf und belege es mit der gebräunten Wurst, der Zwiebel-Jalapeño-Mischung und Cheddar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Brot für 1 Minute zurück auf den Grill, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es sofort und bestreue es mit grob gemahlenem schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
