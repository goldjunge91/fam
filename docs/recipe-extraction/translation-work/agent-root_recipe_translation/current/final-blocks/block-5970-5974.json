      ],
      "steps": [
        {
          "position": 0,
          "text": "Verrühre Mehl, Eier, Milch, Salz und 1 Esslöffel geschmolzene Butter zu einem glatten Teig und lasse ihn 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Bauernkäse, 1/4 Tasse saure Sahne und 2 Esslöffel Zucker in einer Schüssel für die Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine beschichtete Pfanne bei mittelhoher Hitze und fette sie leicht mit Öl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße 1/4 Tasse Teig in die Pfanne und backe ihn 1 Minute, bis die Unterseite fest ist. Wende ihn und backe die andere Seite weitere 30 Sekunden leicht goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege den Blintz mit der gebackenen Seite nach oben auf einen Teller. Gib 2 Esslöffel Füllung in die Mitte, klappe die Ränder zu einem Rechteck darüber und lege ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wiederhole den Vorgang mit dem restlichen Teig und der Füllung, um 12–16 Blintzes zuzubereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib 1 Esslöffel Butter in die Pfanne und brate die gefüllten Blintzes auf jeder Seite 1–2 Minuten goldbraun und heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit saurer Sahne und Marmelade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
