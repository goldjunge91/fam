      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und bräune Lammstücke 5 Minuten von allen Seiten. Nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel und gehackten Knoblauch im selben Topf weich und rühre dann 1 Minute Tomatenmark ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lösche mit Rotwein ab, löse die Röststoffe und gib Lamm mit Brühe und Rosmarin zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere die Hitze, decke den Topf ab und lasse es 45 Minuten köcheln, bis das Lamm fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Karotten in Stücke und Kartoffeln in Viertel. Gib beides zusammen mit Perlzwiebeln in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel weitere 30-35 Minuten köcheln, bis das Gemüse weich und die Sauce leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Salz und Pfeffer, entferne Rosmarinzweige und serviere das Gericht heiß in Schalen mit der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
