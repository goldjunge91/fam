      "steps": [
        {
          "position": 0,
          "text": "Bereite Béchamelsauce zu: Schmilz 2 Esslöffel Butter, rühre Mehl ein und gieße dann nach und nach unter ständigem Rühren Milch hinzu, bis die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere Hechtfilets fein in einer Mühle oder Küchenmaschine, bis eine Paste entsteht. Vermische sie dann mit Béchamel, einem Ei, Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kühle die Masse 30 Minuten und forme sie dann mit zwei warmen Löffeln zu ovalen Quenelles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Fischfond sanft bis zum Köcheln und pochierte die Quenelles 12-15 Minuten, bis sie aufschwimmen und ihre Form behalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Quenelles mit einer Schaumkelle heraus und halte sie auf einer Servierplatte warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seihe 2 Tassen Pochierflüssigkeit in einen Topf und reduziere sie bei mittlerer Hitze auf die Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verquirle das übrige Ei mit Sahne und rühre es dann langsam unter ständigem Rühren in die reduzierte Flüssigkeit ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verfeinere die Sauce mit 2 Esslöffeln Butter und gieße sie vor dem Servieren über die warmen Quenelles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
