      "steps": [
        {
          "position": 0,
          "text": "Hacke Mandeln, kandierte Melone und kandierte Orangenschale zusammen in einer Küchenmaschine fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die gemahlene Masse mit 1 Tasse Puderzucker und binde sie dann mit Eiweiß und Wasser zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle die Paste zwischen zwei Backpapierbögen 1/4 Zoll dick aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide mit einem kleinen Ausstecher Rauten oder ovale Formen aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege Oblaten auf ein Backblech und ordne die Calissons darauf mit etwas Abstand an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestäube sie großzügig mit dem restlichen Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Trockne sie im Ofen bei 275°F 10 Minuten, bis die Oberfläche fest, aber nicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vollständig abkühlen und bewahre sie dann in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
