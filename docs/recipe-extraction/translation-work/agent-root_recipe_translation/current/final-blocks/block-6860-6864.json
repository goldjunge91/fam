      "steps": [
        {
          "position": 0,
          "text": "Entfernen Sie die dünne Membran von der Rückseite jedes Rippenstücks, indem Sie ein Messer darunter schieben und abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Braunen Zucker, Paprika, Knoblauchpulver, schwarzen Pfeffer und Salz vermischen und großzügig auf beiden Seiten der Rippchen einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 300 °F vor und legen Sie die Rippchen mit der Knochenseite nach unten auf ein mit Folie ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Apfelsaft auf den Boden der Pfanne rund um die Rippen gießen, fest mit Folie abdecken und 2.5 Stunden backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter, Honig und Ketchup zu einer Glasur verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entfernen Sie die Folie, bestreichen Sie die Rippchen mit Glasur und stellen Sie sie für 20 Minuten ohne Deckel in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eine weitere Schicht Glasur auftragen und weitere 15 Minuten backen, bis die Sauce karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten ruhen lassen, dann zwischen den Knochen aufschneiden und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
