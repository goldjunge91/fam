      "steps": [
        {
          "position": 0,
          "text": "Braunen Zucker, Paprika, Knoblauchpulver, Zwiebelpulver, schwarzen Pfeffer und Salz in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reiben Sie beide Putenkeulen mit der Gewürzmischung gleichmäßig ein und massieren Sie sie in die Haut ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 325 °F vor und legen Sie die Putenkeulen auf ein mit Folie ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Apfelsaft auf den Boden der Pfanne rund um die Beine gießen und fest mit Folie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zugedeckt 2 Stunden backen, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Butter und Honig vermischen und auf die Putenkeulen streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhöhen Sie die Ofentemperatur auf 400 °F, entfernen Sie die Folie und backen Sie es ohne Deckel 15–20 Minuten lang, bis die Haut knusprig und karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
