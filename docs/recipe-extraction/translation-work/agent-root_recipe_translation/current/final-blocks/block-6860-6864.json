      "steps": [
        {
          "position": 0,
          "text": "Paprika, Knoblauchpulver, schwarzen Pfeffer, Salz und braunen Zucker vermischen, um eine Gewürzmischung zu erzeugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die gesamte Rinderbrustspitze mit der Gewürzmischung einreiben und 1 Stunde ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 325 °F vor und backen Sie das mit Folie bedeckte Rinderbrust 3 Stunden lang, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneiden Sie das gekochte Rinderbrust in 1 cm große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einer Schüssel Butter, braunen Zucker, Ketchup und Worcestershire-Sauce vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Rinderbrustwürfel mit der Glasurmischung vermengen und auf einem mit Folie ausgelegten Backblech verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhöhen Sie die Ofentemperatur auf 400 °F und backen Sie die Würfel 20–25 Minuten lang ohne Deckel, wobei Sie nach der Hälfte der Zeit umrühren, bis die Ränder karamellisieren und leicht verkohlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren, mit zusätzlicher Soße als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
