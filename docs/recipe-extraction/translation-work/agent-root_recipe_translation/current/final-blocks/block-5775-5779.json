      "steps": [
        {
          "position": 0,
          "text": "Butter in einem Topf bei mittlerer Hitze schmelzen lassen, ohne sie zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Mehl einrühren, bis eine glatte Mehlschwitze entsteht. Unter ständigem Rühren 1-2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Milch nach und nach unter ständigem Rühren zugießen, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lorbeerblatt hinzufügen und die Sauce bei mittlerer Hitze 5-7 Minuten weiterkochen, bis sie eindickt und einen Löffel überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und mit Salz, weißem Pfeffer und Muskatnuss abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Lorbeerblatt entfernen. Die Sauce sofort als Grundlage für Gratins, Pastagerichte oder Lasagne verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
