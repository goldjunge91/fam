          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gurken- und Daikonstücke in die Reiskleiemischung drücken und vollständig bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Gefäß locker abdecken und bei Zimmertemperatur ohne direkte Sonneneinstrahlung lagern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nach 12-24 Stunden das Gemüse herausnehmen, unter kaltem Wasser abspülen und zum Servieren schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Reiskleiemischung täglich umrühren, damit die Fermentation erhalten bleibt und sich kein Schimmel bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
