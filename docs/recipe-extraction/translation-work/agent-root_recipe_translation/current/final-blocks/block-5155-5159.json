      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Paprikapulver, Knoblauchpulver, Zwiebelpulver, Cayennepfeffer, schwarzen Pfeffer und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe die Hähnchenteile mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende die Hähnchenteile portionsweise gründlich in der Mehlmischung und drücke die Panade leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die panierten Hähnchenteile 5 Minuten auf einem Teller ruhen, damit die Panade haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das Öl in einem großen, schweren Topf oder einer Fritteuse auf 325°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib jeweils 3-4 Hähnchenteile vorsichtig in das heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere dunkles Fleisch 12-15 Minuten und helles Fleisch 10-12 Minuten. Wende es nach der Hälfte der Zeit, bis es kräftig goldbraun ist und eine Kerntemperatur von 165°F erreicht hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse das Hähnchen auf Küchenpapier abtropfen und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
