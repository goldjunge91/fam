      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln der Länge nach in dünne, etwa 1/8 inch dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drehe jede Scheibe um 90 Grad und schneide sie erneut, sodass ein Waffelmuster entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche die Kartoffelscheiben 30 Minuten in kaltem Wasser ein, um die Stärke zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Kartoffeln mit Küchenpapier vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem schweren Topf oder einer Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Kartoffeln portionsweise 4-5 Minuten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einem Schaumlöffel heraus und lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze sie sofort mit Salz, Pfeffer und Paprika, solange sie heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
