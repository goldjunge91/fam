      "steps": [
        {
          "position": 0,
          "text": "Brate das Rinderhackfleisch in einer Pfanne bei mittelhoher Hitze an und rühre die Taco-Gewürzmischung mit 3 tablespoons Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege eine Tortilla flach hin und bestreiche eine Hälfte mit Nacho-Käsesauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schichte zerbröselte Tostitos, gebratenes Rindfleisch, saure Sahne, geriebenen Käse, Tomaten und Salat in dieser Reihenfolge darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe die Tortilla zu einem Dreieck zusammen und falte sie dann noch einmal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze die Butter in einer Pfanne bei mittlerer Hitze und brate den eingewickelten Crunchwrap von beiden Seiten goldbraun an, etwa 3-4 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm ihn aus der Pfanne und lass ihn vor dem Servieren 1 Minute abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole den Vorgang mit den übrigen Tortillas und Füllungen.",
          "timerMinutes": null,
