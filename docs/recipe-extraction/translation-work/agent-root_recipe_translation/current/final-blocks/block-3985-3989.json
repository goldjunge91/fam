      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch in 1.5 Zoll Würfel schneiden und mit Papiertüchern trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und das Rindfleisch portionsweise anbraten, insgesamt 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Rindfleisch herausnehmen und die gewürfelten Zwiebeln und den Knoblauch etwa 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Rindfleisch wieder in den Topf geben, gewürfelte Tomaten und Tomatenmark hinzufügen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Brühe aufgießen und zum Kochen bringen, dann die Hitze reduzieren und abdecken; 30 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gewürfelte Kartoffeln, Mais und Erbsen hinzufügen; Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zugedeckt 20-25 Minuten weiter köcheln lassen, bis Kartoffeln und Fleisch sehr zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Passen Sie die Gewürze an und servieren Sie es heiß mit Ugali oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
