      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ei und Wasser verquirlen, dann mit 2 Esslöffeln Öl zum Mehl geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 8 Minuten lang kneten, bis er elastisch und glatt ist. Wenn er zu trocken ist, Wasser hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 6 Kugeln aufteilen und 15 Minuten mit einem feuchten Tuch abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie jede Kugel sehr dünn zu einem Kreis mit einem Durchmesser von etwa 8 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittieröl in einer tiefen Pfanne oder einem Wok auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Braten Sie jedes Brot 2 Minuten pro Seite, bis es goldbraun, luftig und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Papiertüchern abtropfen lassen und heiß mit Bohneneintopf oder so servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
