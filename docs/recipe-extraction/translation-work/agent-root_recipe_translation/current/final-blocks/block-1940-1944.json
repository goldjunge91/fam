      ],
      "steps": [
        {
          "position": 0,
          "text": "Eine quadratische Backform von 8-inch mit Backpapier oder Folie auslegen und mit Antihaftspray besprühen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zartbitterschokotropfen, Sahne und die Hälfte der gezuckerten Kondensmilch in einer mikrowellengeeigneten Schüssel vermengen. In 20-Sekunden-Intervallen erhitzen und zwischendurch umrühren, bis die Schokolade geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vanilleextrakt zur dunklen Schokoladenmischung geben und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dunkle Schokoladenmischung in die vorbereitete Form geben und gleichmäßig verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weiße Schokotropfen mit der restlichen Hälfte der Kondensmilch in einer separaten Schüssel vermengen. In 20-Sekunden-Intervallen erhitzen und zwischendurch umrühren, bis die Schokolade geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weiße Schokoladenmischung gleichmäßig auf der dunklen Schicht verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schokoladenschichten mit Mallow Bits oder Mini-Marshmallows bestreuen und leicht andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "4 Stunden oder bis zum Festwerden kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Fudge und Backpapier aus der Form heben. Papier vorsichtig vollständig ablösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Fudge in mundgerechte Stücke schneiden und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
