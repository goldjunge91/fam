      "steps": [
        {
          "position": 0,
          "text": "SUPPE ZUBEREITEN",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hühnerbrühe in einen Wok geben und aufkochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Salz, Zucker, Sesamöl, weißen Pfeffer, scharfe Chilisauce, Essig und Sojasauce dazugeben und einige Sekunden umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tofu, Pilze und schwarze Mu-Err-Pilze in den Wok geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Andicken 1 EL Maisstärke mit 2 EL Wasser in einer Schüssel verrühren und langsam so viel davon in die Suppe geben, bis sie die gewünschte Dicke hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 leicht mit Messer oder Gabel verquirltes Ei in die Suppe geben und 8 Sekunden umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Suppe in Schalen füllen und mit BBQ-Schwein und geschnittener Frühlingszwiebel garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
