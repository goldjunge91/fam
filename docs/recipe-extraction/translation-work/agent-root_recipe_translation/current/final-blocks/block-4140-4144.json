      "steps": [
        {
          "position": 0,
          "text": "Bitterorangensaft, gehackten Knoblauch, Kreuzkümmel, Salz und Pfeffer in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinefleischwürfel in die Marinade geben und mindestens 2 Stunden oder über Nacht im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinefleisch aus der Marinade nehmen, diese aufbewahren, und das Fleisch 8 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zwiebelstreifen und Lorbeerblätter in die Pfanne geben und 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aufbewahrte Marinade und Wasser zugießen, dann die Hitze auf mittlere bis niedrige Stufe reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 25–30 Minuten köcheln lassen, bis das Schweinefleisch zart ist und die Sauce reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Ohne Deckel weitere 5 Minuten kochen, damit die Sauce stärker einkocht, dann servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
