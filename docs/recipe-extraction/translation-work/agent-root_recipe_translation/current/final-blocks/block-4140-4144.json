      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 400 °F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Fisch entschuppen und ausnehmen, dann innen und außen mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eiweiß mit Meersalz zu einer Paste verrühren und Zitronensaft sowie gehackte Kräuter hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ein Drittel der Salzmischung auf dem Backpapier verteilen, den Fisch darauflegen und vollständig mit der restlichen Salzmischung bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "20–25 Minuten backen, bis die Salzkruste goldbraun und der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Salzkruste am Tisch aufbrechen, den Fisch vorsichtig filetieren und die Haut entfernen. Mit Olivenöl und Zitrone servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
