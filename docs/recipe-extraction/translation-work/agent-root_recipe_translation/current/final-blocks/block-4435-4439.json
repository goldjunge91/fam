      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln in dicke Ringe schneiden und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Jede Wurst an 3–4 Stellen mit einer Gabel einstechen, damit sie nicht platzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und Würste insgesamt etwa 8 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würste herausnehmen und beiseitestellen. Zwiebeln in derselben Pfanne etwa 5 Minuten goldbraun dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Senf einrühren und 1 Minute kochen, dann Bier und Rinderbrühe zugießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würste zurück in die Pfanne geben und Thymian sowie Lorbeerblatt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hitze reduzieren, abdecken und 20 Minuten köcheln lassen, bis die Würste durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen und mit knusprigem Brot oder Kartoffeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
