      "steps": [
        {
          "position": 0,
          "text": "Honig, Butter und braunen Zucker in einem Topf bei niedriger Hitze verrühren, bis alles geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vom Herd nehmen und 5 Minuten abkühlen lassen, dann das Ei einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Zimt, Anis, Natron, Salz und Muskatnuss in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trockene Zutaten zur Honigmischung geben und rühren, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In eine gefettete Kastenform von 8x4 Zoll füllen und die Oberfläche glatt streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 325 °F 35–40 Minuten backen, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen und vollständig auskühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aufschneiden und mit Butter oder Marmelade servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
