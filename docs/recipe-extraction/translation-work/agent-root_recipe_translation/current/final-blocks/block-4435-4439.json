      "steps": [
        {
          "position": 0,
          "text": "Butter in einem Topf schmelzen und Mehl einrühren, um eine Mehlschwitze herzustellen. 1 Minute kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderbrühe langsam unter ständigem Rühren zugießen, bis die Sauce eindickt, etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schinken und Senf einrühren, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mischung auf einem Teller verteilen, 15 Minuten abkühlen und anschließend 20 Minuten im Kühlschrank kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zu 12 Kugeln von etwa 1.5 Zoll Durchmesser formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eier in einer flachen Schüssel verquirlen und Semmelbrösel in eine zweite flache Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Kugel zuerst in Ei und dann gründlich in Semmelbröseln wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Öl in einem tiefen Topf auf 350 °F erhitzen und Bitterballen portionsweise 2–3 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit Senf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
