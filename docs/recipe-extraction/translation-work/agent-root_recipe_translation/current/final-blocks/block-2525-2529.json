      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Bohnen über Nacht in kaltem Wasser ein. Gieße sie ab und spüle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Schweineschulter in 2-inch große Stücke und bräune sie in einem großen Schmortopf bei mittelhoher Hitze. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bräune Wurststücke im selben Topf 5 Minuten. Nimm sie heraus und schneide sie in dicke Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste gewürfelte Zwiebel und gehackten Knoblauch im restlichen Fett 3 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinefleisch zurück in den Topf, füge Bohnen, Hühnerbrühe, Tomatenmark und Lorbeerblätter hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und gare ihn im auf 325°F vorgeheizten Ofen 2 Stunden. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege Entenconfit-Schenkel und Wurstscheiben in das Cassoulet. Bestreue alles mit Semmelbröseln, die mit geschmolzenem Fett vermischt sind, und backe es ohne Deckel 30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
