      "steps": [
        {
          "position": 0,
          "text": "Bringe Hühnerbrühe in einem großen Topf zum Kochen und gib zerdrücktes Zitronengras, Galgantscheiben und ganze Chilis dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass alles 5 Minuten köcheln, damit sich die Aromen entfalten. Gib dann gehackten Knoblauch und Pilze hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Garnelen dazu und lass sie 3-4 Minuten köcheln, bis sie rosa und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Fischsauce und Limettensaft ein. Gib dann Kirschtomaten dazu und erhitze alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Topf vom Herd, entferne Zitronengras und Galgantstücke, garniere die Suppe mit Koriander und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
