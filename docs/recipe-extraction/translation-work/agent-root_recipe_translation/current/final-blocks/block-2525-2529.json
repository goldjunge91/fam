      "steps": [
        {
          "position": 0,
          "text": "Gare Schweinehackfleisch in einer Pfanne bei mittlerer Hitze etwa 5 Minuten, bis es gebräunt ist. Zerteile es während des Garens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute. Rühre dann Krabbenfleisch, gekochte Nudeln, geraspelte Karotte, Pilze, Fischsauce und schwarzen Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tauche Reispapierblätter 3 Sekunden in warmes Wasser und lege sie auf eine feuchte Fläche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 2 Esslöffel Füllung auf das untere Drittel jedes Blatts. Klappe die Seiten ein und rolle es fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem schweren Topf auf 350°F und frittiere die Rollen portionsweise 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie heiß mit süß-saurer Sauce oder Fischsauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
