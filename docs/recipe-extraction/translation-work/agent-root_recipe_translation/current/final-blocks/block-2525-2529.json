      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste gewürfelten Fenchel, Zwiebel und gehackten Knoblauch 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Tomatenmark ein und gare es 2 Minuten. Gib dann Safran und Fischbrühe dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass die Brühe 15 Minuten köcheln, damit sich die Aromen entfalten. Gib dann Fischfilets und Miesmuscheln in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare alles 5 Minuten, gib dann Garnelen dazu und lass die Suppe weitere 3 Minuten köcheln, bis alle Meeresfrüchte gar und die Muscheln geöffnet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wirf alle ungeöffneten Muscheln weg und würze die Brühe nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste Brotscheiben goldbraun. Schöpfe die Suppe in Servierschalen und reiche das geröstete Brot dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
