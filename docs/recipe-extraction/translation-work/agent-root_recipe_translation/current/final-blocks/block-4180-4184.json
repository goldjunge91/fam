      "steps": [
        {
          "position": 0,
          "text": "Yuca schälen und mit einer Vierkantreibe oder Küchenmaschine fein raspeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geraspelte Yuca in ein sauberes Küchentuch geben und über einer Schüssel kräftig ausdrücken, um überschüssige Flüssigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Flüssigkeit in der Schüssel auffangen und 30 Minuten stehen lassen, bis sich Stärke am Boden absetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser vorsichtig abgießen und die Stärke am Schüsselboden zurückbehalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ausgedrückte Yuca mit der zurückbehaltenen Stärke und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine große gusseiserne Pfanne oder Grillplatte ohne Öl bei mittelhoher bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Yuca-Mischung gleichmäßig in der Pfanne zu einem etwa 0.25-inch dicken Fladen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "8-10 Minuten garen, bis die Unterseite goldbraun und knusprig ist, dann vorsichtig wenden und die andere Seite ebenfalls goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Herausnehmen, auf einem Kuchengitter abkühlen lassen und dann in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
