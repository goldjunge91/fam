      "steps": [
        {
          "position": 0,
          "text": "Butternusskürbis schälen, Kerne entfernen und in 2-inch große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wasser, braunen Zucker, Zimtstangen und Nelken in einem großen Topf vermengen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze auf mittlere Stufe reduzieren, Kürbisstücke hinzufügen und vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ohne Deckel 20-25 Minuten köcheln lassen, bis der Kürbis sehr weich ist, aber seine Form behält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter, Vanilleextrakt und Salz hinzufügen und vorsichtig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 3-5 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In eine Servierschüssel geben und etwas abkühlen lassen; warm oder bei Raumtemperatur mit der süßen Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
