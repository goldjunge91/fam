      "steps": [
        {
          "position": 0,
          "text": "Schneide den Tofu in 3 Zoll große Würfel und höhle jeden mit einem kleinen Löffel vorsichtig aus, sodass eine Tasche für die Füllung entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 Esslöffel Öl in einem Wok oder einer Pfanne und brate Hackfleisch mit Schalotten und Knoblauch an. Gieße überschüssiges Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Sojasauce und Sesamöl unter das Fleisch und lasse es leicht abkühlen. Fülle damit die Tofuwürfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze das übrige Öl im Wok bei mittelhoher Hitze und lege die gefüllten Tofuwürfel vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate sie auf jeder Seite 3-4 Minuten goldbraun und gieße dann Wasser um den Tofu herum dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Wok ab und lasse alles 8-10 Minuten köcheln, bis der Tofu zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verrühre Speisestärke mit 1 Esslöffel Wasser und rühre sie zum Andicken in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere mit Frühlingszwiebeln und serviere heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
