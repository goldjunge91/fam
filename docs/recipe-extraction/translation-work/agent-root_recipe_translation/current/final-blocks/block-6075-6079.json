      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor, spüle das Hähnchen gründlich ab und tupfe es trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fülle die Hähnchenhöhle mit Ingwerscheiben und Frühlingszwiebelstücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Salz und Wasser zu einer Paste, die beim Zusammendrücken zusammenhält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile eine Schicht Salzpaste auf dem Boden einer großen Auflaufform und setze das Hähnchen darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bedecke das gesamte Hähnchen vollständig mit der übrigen Salzpaste und drücke sie fest an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe es 1 Stunde, bis die Salzkruste hart und das Hähnchen gar ist (Kerntemperatur 165°F).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brich die Salzkruste vorsichtig auf und nimm das Hähnchen heraus. Bürste überschüssiges Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische Sojasauce und Sesamöl und serviere sie als Dip zum Hähnchen.",
