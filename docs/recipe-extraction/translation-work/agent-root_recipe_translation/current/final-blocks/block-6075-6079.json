      "steps": [
        {
          "position": 0,
          "text": "Röste Grünteeblätter in einer trockenen Pfanne bei niedriger Hitze 1-2 Minuten und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Erdnüsse, Sesam, Sonnenblumenkerne und Kokosnuss dazu und röste alles weitere 2-3 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib alle Zutaten in einen Mörser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerstoße die Mischung vorsichtig 5-7 Minuten. Zerkleinere Nüsse und Samen, aber mahle sie nicht zu feinem Pulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die zerstoßene Mischung auf 4 Tassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße jeweils 1/2 Tasse heißes Wasser hinein und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse den Tee vor dem Trinken 2 Minuten ziehen; etwas Satz bleibt am Boden zurück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
