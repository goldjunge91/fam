      "steps": [
        {
          "position": 0,
          "text": "Gib nach und nach warmes Wasser zum Klebreismehl und rühre, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 2-3 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Erdnussbutter, braunen Zucker, Öl, gemahlene Erdnüsse und Salz in einer kleinen Schüssel zu einer Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 12 gleich große Portionen und rolle jede zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke jede Kugel zu einer dünnen Scheibe flach, gib 1 Teelöffel Füllung in die Mitte, schlage die Ränder darüber und rolle sie zu einer glatten Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Wasser in einem Topf zum Kochen und gib die Reisbällchen vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre vorsichtig um und gare sie 5-7 Minuten, bis sie an die Oberfläche steigen und dort 2 Minuten bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß in der Kochflüssigkeit oder gieße sie ab und serviere sie pur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
