          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre grüne Bohnen, Dosentomaten samt Saft, Salz und schwarzen Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
