    {
      "externalId": "waivy:mfr-nafr2-shakshuka-classic",
      "slug": "mfr-nafr2-shakshuka-classic",
      "title": "Klassische rote Shakshuka",
      "instructions": "Das zeitlose nordafrikanische Eiergericht: Eier pochieren in einer gewürzten Tomatensauce mit süßer Paprika, Knoblauch, Kreuzkümmel und Paprikapulver, bis das Eiweiß gestockt und das Eigelb cremig ist. Serviert mit knusprigem Brot zum Auftunken und zerbröseltem Feta ergibt es ein herzhaftes Frühstück oder Abendessen.",
      "prepTimeMinutes": 8,
      "cookTimeMinutes": 22,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Eine Dose gehackte Tomaten und 6 Eier reichen für 3 Personen und kosten weniger als 3 Dollar.",
        "Mit zusätzlichen Chiliflocken wird das Gericht schärfer. Die Schärfe kostet nichts extra.",
        "Shakshuka lässt sich gut aufwärmen. Bereite mehr Sauce vor und pochier beim nächsten Mal frische Eier darin."
      ],
      "substitutions": [
        {
          "forIngredientId": "feta",
          "swap": "Ziegenkäse oder für eine milchfreie Variante weglassen"
        },
        {
          "forIngredientId": "crushed-tomatoes",
          "swap": "Frische Tomaten würfeln und verwenden, wenn sie günstig sind"
        }
      ],
