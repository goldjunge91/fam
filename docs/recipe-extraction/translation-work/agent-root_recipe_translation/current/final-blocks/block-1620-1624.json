      "steps": [
        {
          "position": 0,
          "text": "Würze das Hähnchen mit Kurkuma, Kreuzkümmel, Koriander, Zimt und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune es im Schmortopf in Öl 4 Minuten pro Seite und nimm es heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Zwiebel 5 Minuten an. Gib Knoblauch und Ingwer dazu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das Hähnchen zurück in den Topf und gib Brühe, Safran und die in Streifen geschnittene Schale der Salzzitrone dazu. Entferne das Fruchtfleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmore alles zugedeckt bei 325°F 45 Minuten. Gib die Oliven in den letzten 10 Minuten dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere mit Koriander und serviere das Gericht mit Couscous.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
