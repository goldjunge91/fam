      "steps": [
        {
          "position": 0,
          "text": "Brate die Zwiebel 4 Minuten in Öl an. Gib Paprika dazu und gare sie 3 Minuten. Füge Knoblauch hinzu und gare ihn 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Gewürze dazu und gare sie 1 Minute. Füge die Tomaten hinzu und lass alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke 6 Mulden in die Sauce und schlage jeweils ein Ei hinein. Decke die Pfanne ab und gare die Eier 5–7 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerbrösele Feta darüber und garniere mit Koriander. Serviere direkt aus der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
