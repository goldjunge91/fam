    {
      "externalId": "waivy:mfr-nafr2-chicken-tagine",
      "slug": "mfr-nafr2-chicken-tagine",
      "title": "Marokkanische Hähnchen-Tajine mit Salzzitrone",
      "instructions": "Ein langsam geschmortes Hähnchengericht voller aromatischer Gewürze: Hähnchenoberkeulen köcheln mit grünen Oliven, Salzzitrone, Safran, Ingwer und einer Fülle marokkanischer Gewürze, bis die Sauce glänzt und sich das Fleisch vom Knochen löst. Authentisch marokkanisch und einfach im Schmortopf zuzubereiten.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 60,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Salzzitronen lassen sich zu Hause aus Salz, Zitronen und einem Glas in 3 Wochen selbst herstellen.",
        "Safran kannst du weglassen und für mehr Farbe einfach mehr Kurkuma verwenden.",
        "Hähnchenoberkeulen sind viel günstiger als die als Tajine-Fleischstücke verkauften Teile."
      ],
      "substitutions": [
        {
          "forIngredientId": "preserved-lemon",
          "swap": "Frische Zitronenschale und 1 TL Salz"
        },
        {
          "forIngredientId": "saffron",
          "swap": "1 TL Kurkuma und eine Prise Paprikapulver für die Farbe"
        }
      ],
