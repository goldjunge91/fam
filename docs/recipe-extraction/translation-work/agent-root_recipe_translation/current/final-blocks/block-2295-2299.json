      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf mit schwerem Boden erhitzen. Zwiebeln dazugeben und bei niedriger Hitze 5–10 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauch, Gewürze, getrockneten Thymian, Karotten, Sellerie und Paprika dazugeben und 5 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomaten, Brühe, Zucchini und frischen Thymian hinzufügen und 20–25 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Thymianzweige herausnehmen. Linsen einrühren und erneut zum Köcheln bringen. Mit Wildreis, weißem Basmatireis, Kartoffelpüree oder Quinoa servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
