      "steps": [
        {
          "position": 0,
          "text": "Erhitze die Rinderbrühe in einem Topf bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere die Zwiebel und gib sie zusammen mit dem geschnittenen Ingwer, Sternanis und der Zimtstange zur Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass die Brühe 15 Minuten köcheln, damit sich die Aromen entfalten, und seihe dann die Gewürze ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Rinderlende quer zur Faser in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche die Reisnudeln nach Packungsanweisung, gieße sie ab und kühle sie in kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze die Brühe mit Fischsauce und lass sie auf Zimmertemperatur abkühlen. Stelle sie dann mindestens 1 Stunde in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die gekühlten Nudeln und das Rindfleisch auf Schüsseln und gieße die kalte Brühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht mit frischer Minze, Koriander, Limettenspalten und geschnittenen Jalapeños als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
