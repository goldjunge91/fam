      "steps": [
        {
          "position": 0,
          "text": "Koche Wasser in einem Topf auf und gib die Eier vorsichtig hinein. Gare sie 7 Minuten für weich gekochte Eier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Eier sofort in Eiswasser und lass sie 5 Minuten abkühlen. Schäle sie anschließend vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasauce, Mirin, Zucker und Wasser in einem kleinen Topf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe die Marinade zum Kochen und rühre dabei, bis sich der Zucker aufgelöst hat. Nimm sie dann vom Herd und lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die geschälten Eier in einen Behälter oder einen wiederverschließbaren Beutel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die abgekühlte Marinade über die Eier und achte darauf, dass sie vollständig bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Eier mindestens 4 Stunden oder über Nacht in den Kühlschrank, damit sie ihr volles Aroma entwickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Halbiere die Eier zum Servieren und beträufle sie nach Belieben mit zusätzlicher Marinade.",
