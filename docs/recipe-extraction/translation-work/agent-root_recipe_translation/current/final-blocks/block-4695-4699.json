      "steps": [
        {
          "position": 0,
          "text": "Schneide die Rinderlende in dünne Streifen, vermische sie mit Maisstärke und 1 Esslöffel Sojasauce und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Blanchiere die Brokkoliröschen 3 Minuten in kochendem Salzwasser und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 Esslöffel Pflanzenöl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Rindfleisch portionsweise jeweils 2-3 Minuten, bis es gebräunt ist. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das restliche Öl hinzu und brate den gehackten Knoblauch und Ingwer 30 Sekunden unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den Brokkoli zurück in die Pfanne und brate ihn 2 Minuten unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Rindfleisch zurück in die Pfanne und füge Sojasauce, Austernsauce, Wasser und Sesamöl hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vermische alles und gare es 2 Minuten, bis die Sauce eindickt. Serviere das Gericht anschließend auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
