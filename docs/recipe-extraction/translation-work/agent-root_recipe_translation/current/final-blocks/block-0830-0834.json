      "steps": [
        {
          "position": 0,
          "text": "Koche 4 Eier hart, schäle sie und ritze die Oberfläche mit einem Messer leicht ein, damit die Soße einziehen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Karamellisiere 3 Zwiebeln in Butter bei mittlerer bis niedriger Hitze 20 Minuten lang. Das ist die Grundlage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch, Ingwer und alle Gewürze dazu und gare alles 3 Minuten. Rühre Tomatenmark ein und gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchenoberkeulen und Brühe dazu. Lass alles 20 Minuten köcheln, bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die eingeritzten Eier dazu und lass alles weitere 5 Minuten köcheln. Serviere den Eintopf mit Reis und zusätzlicher Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
