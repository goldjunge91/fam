      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze braunen Zucker mit einem winzigen Schuss Wasser in einem großen Topf, bis er bernsteinfarben karamellisiert. Gib die Hähnchenstücke dazu; sie brutzeln kräftig. Wende sie 1–2 Minuten im Karamell.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Zwiebel, Knoblauch und Paprika dazu und rühre 2 Minuten. Gib Thymian, Frühlingszwiebel und Cayennepfeffer dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Reis, abgetropfte Kidneybohnen, Brühe und die Hälfte der Kokosmilch dazu. Verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, decke den Topf fest ab und gare das Gericht bei niedrigster Hitze 25 Minuten, bis der Reis gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Deckel ab und lockere den Reis mit einer Gabel auf. Serviere das Gericht mit Krautsalat oder einem einfachen Salat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
