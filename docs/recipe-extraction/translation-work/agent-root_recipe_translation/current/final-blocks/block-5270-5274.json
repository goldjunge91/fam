      "steps": [
        {
          "position": 0,
          "text": "Brate das Rinderhackfleisch in einer Pfanne bei mittelhoher Hitze an und zerkleinere es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße überschüssiges Fett ab und würze das Fleisch mit Salz, Pfeffer und Taco-Gewürz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile die Tortillachips auf einer großen ofenfesten Platte oder in einer flachen Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile das gegarte Fleisch auf den Chips und bestreue alles gleichmäßig mit Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Überbacke die Nachos 3-4 Minuten auf hoher Stufe, bis der Käse vollständig geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie aus dem Ofen und gib Jalapeños, Oliven, Frühlingszwiebeln und etwas Salsa darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Nachos sofort mit saurer Sahne zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
