      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem schweren Topf zum Frittieren auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Zucker, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Ei und Milch, gib sie zu den trockenen Zutaten und verrühre alles zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Teig in einen Spritzbeutel und spritze vorsichtig Ringe mit 3-inch Durchmesser direkt ins heiße Öl. Frittiere sie 1-2 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Donuts mit einem Schaumlöffel heraus und lass sie auf Küchenpapier abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze die Schokoladenstückchen mit der Sahne bei niedriger Hitze, bis die Glasur glatt ist. Lass sie leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die abgekühlten Donuts mithilfe eines Spritzbeutels seitlich mit Vanillepudding.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tauche die Oberseite jedes Donuts in die Schokoladenglasur und lass sie auf einem Kuchengitter fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
