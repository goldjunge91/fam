      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffeln in dünne Stifte und weiche sie 30 Minuten in kaltem Wasser ein, um die Stärke zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem schweren Topf auf 325°F und frittiere die eingeweichten Pommes 5 Minuten, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhöhe die Hitze auf 375°F und frittiere sie erneut 2-3 Minuten, bis sie knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass die Pommes auf Küchenpapier abtropfen und würze sie leicht mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Mayonnaise mit Gochujang und Kimchi-Saft zu einer scharfen Mayonnaise-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge die heißen Pommes in einer Schüssel mit gehacktem Kimchi.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib sie auf einen Servierteller und beträufle sie mit Gochujang-Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue sie vor dem Servieren mit Frühlingszwiebeln und Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
