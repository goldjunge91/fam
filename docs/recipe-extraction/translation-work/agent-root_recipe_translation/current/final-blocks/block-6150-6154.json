      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Zwiebeln in dünne Scheiben und hacke Knoblauch und grüne Chilischoten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Kokosöl in einer großen Pfanne und röste darin schwarze Senfsamen an, bis sie aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Curryblätter dazu und rühre sofort gehackten Knoblauch und Ingwer ein. Gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Zwiebeln dazu und gare sie, bis sie glasig werden und sich goldbraun färben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kurkuma, Chilipulver und grüne Chilischoten dazu und rühre 1 Minute ständig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Hähnchenstücke dazu und gare sie bei hoher Hitze 5 Minuten unter häufigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße Wasser dazu, reduziere die Hitze auf mittlere Stufe und lass alles zugedeckt 15-20 Minuten köcheln, bis das Hähnchen vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Würze mit Salz und serviere das Gericht heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
