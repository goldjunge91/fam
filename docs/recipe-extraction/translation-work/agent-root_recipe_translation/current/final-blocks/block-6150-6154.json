      "steps": [
        {
          "position": 0,
          "text": "Zerstoße die Kardamomkapseln, entferne die Samen und mahle sie fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Esslöffel Ghee in einer Pfanne und röste das Kichererbsenmehl bei niedriger Hitze 3-4 Minuten unter ständigem Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Grieß dazu und röste alles weitere 2 Minuten. Nimm die Mischung heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze die restlichen 2 Esslöffel Ghee in derselben Pfanne und brate Cashewkerne und Rosinen goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die geröstete Mehlmischung, geraspelte Kokosnuss und Kardamompulver in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerbrösele den Palmzucker unter ständigem Rühren in die Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare alles bei niedriger Hitze 3-4 Minuten, bis alle Zutaten gut vermengt und durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Masse auf einem Teller und lass sie leicht abkühlen. Forme sie, sobald sie sich anfassen lässt, zu kleinen Kugeln oder Rauten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
