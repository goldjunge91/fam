      "steps": [
        {
          "position": 0,
          "text": "Die Schweineschulter rundherum großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Fleisch mit geviertelter Zwiebel und ganzen Knoblauchzehen in einen Schongarer legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "BBQ-Sauce, Apfelessig und braunen Zucker verrühren. Die Hälfte der Mischung über das Fleisch gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf niedriger Stufe 8 Stunden oder auf hoher Stufe 5–6 Stunden garen, bis sich das Fleisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Fleisch herausnehmen, mit zwei Gabeln zerpflücken und überschüssiges Fett entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das zerpflückte Fleisch mit der restlichen Sauce zurück in den Schongarer geben und weitere 30 Minuten auf hoher Stufe garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Krautsalatmischung und Mayonnaise zu einem schnellen Krautsalat verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Hamburgerbrötchen toasten und jeweils mit Pulled Pork und einem großzügigen Löffel Krautsalat belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
