      "steps": [
        {
          "position": 0,
          "text": "Paniermehl, gehackte Petersilie und fein gehackten Knoblauch in einer flachen Schüssel vermengen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Lammkoteletts trocken tupfen und auf beiden Seiten großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen. Die Koteletts auf jeder Seite 3–4 Minuten scharf anbraten, bis sie schön gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Koteletts vom Herd nehmen und die Oberseite jedes Stücks mit Dijon-Senf bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eigelb und 1 Esslöffel Wasser in einer kleinen Schüssel verrühren und die Mischung auf den Senf streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Paniermehl-Petersilien-Mischung fest auf die Oberseite und die Seiten der Koteletts drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Butter in derselben Pfanne bei mittlerer Hitze schmelzen. Die Koteletts vorsichtig mit der Kruste nach oben zurück in die Pfanne legen und 2–3 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren und nach Wunsch etwas frischen Zitronensaft darübergeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
