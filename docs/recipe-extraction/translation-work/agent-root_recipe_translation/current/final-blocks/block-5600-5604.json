      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 375°F vorheizen und ein Backblech mit Alufolie auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Speck in einer Pfanne bei mittlerer Hitze etwa 8 Minuten knusprig braten und anschließend zerkrümeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jede Jalapeño längs halbieren und Kerne sowie die weißen Häutchen vorsichtig mit einem kleinen Löffel entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Frischkäse, geriebenen Cheddar, Speckkrümel, Knoblauchpulver, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Käsemischung großzügig in die Jalapeño-Hälften füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die gefüllten Jalapeños auf das vorbereitete Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15–18 Minuten backen, bis der Käse geschmolzen und blasig ist und die Paprikaschoten weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 2–3 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
