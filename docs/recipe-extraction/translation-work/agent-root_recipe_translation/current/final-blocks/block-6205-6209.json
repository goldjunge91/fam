      "steps": [
        {
          "position": 0,
          "text": "Zerkleinere Schalotten, Knoblauch, rote Chilis und Galgant mit einer Küchenmaschine zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge das Hackfleisch mit der Gewürzpaste, geriebener Kokosnuss, Kurkuma, Limettensaft und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Mischung in Portionen und forme jede um einen Zitronengrasstängel zu einem ovalen Spieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille die Spieße über Holzkohle oder in einer heißen Grillpfanne 4-5 Minuten pro Seite, bis sie durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche sie beim Grillen mit Öl, damit sie saftig bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie heiß mit Sambal (Chilipaste) und Limettenspalten als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
