      "steps": [
        {
          "position": 0,
          "text": "Mahle Schalotten, Knoblauch, rote Chilis und Kurkuma zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne und brate die Paste 2-3 Minuten an, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hackfleisch dazu und brate es unter Zerteilen mit einem Löffel durch (8 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge geriebene Kokosnuss, lange Bohnen und Kohl hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare alles 5-7 Minuten, bis das Gemüse weich ist, aber noch Biss hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Limettensaft und Salz dazu und vermenge alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke das Gericht ab und serviere es warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
