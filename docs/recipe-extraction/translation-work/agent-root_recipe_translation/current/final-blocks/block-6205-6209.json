      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 tbsp Öl in einem Wok und rühre die Eier, bis sie gar sind. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 1 tbsp Öl in denselben Wok und brate gehackten Knoblauch und Schalotten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hackfleisch dazu und brate es unter Zerteilen, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge lange Bohnen und Kohl hinzu und brate alles 5 Minuten unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gekochten Reis und Sojasauce dazu. Vermenge alles gut und löse Reisklumpen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre rote Chili und die gegarten Eier vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
