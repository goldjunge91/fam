      "steps": [
        {
          "position": 0,
          "text": "Röste Koriander- und Kreuzkümmelsamen leicht an und mahle sie grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mahle Kurkuma, Galgant, Knoblauch, Schalotten und rote Chilis zusammen zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge die gemahlenen Gewürze mit der Kräuterpaste und reibe das ganze Schweinefleisch gründlich damit ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass das Schweinefleisch mindestens 2 hours, am besten über Nacht, marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem großen Bräter und brate das Schweinefleisch rundherum braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kokosmilch dazu und decke den Bräter mit Folie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate das Fleisch bei 325°F 3-4 hours. Übergieße es gelegentlich mit Bratensaft, bis es zart und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Entferne die Folie für die letzten 30 Minuten, damit die Haut knusprig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schneide das Fleisch in Scheiben und serviere es mit Reis, Sambal und Lawar (gehacktem Gemüsesalat).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
