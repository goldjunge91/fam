      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und lege ein großes Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Süßkartoffeln, Karotten und Pastinaken in 1-inch große Stücke und viertle die Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile das Gemüse auf dem Blech, beträufle es mit 2 tbsp Olivenöl und bestreue es mit Salz, Pfeffer und Rosmarin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste das Gemüse 15 Minuten vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tupfe die Hähnchenschenkel trocken und lege sie mit der Hautseite nach oben zwischen das Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche das Hähnchen mit dem übrigen 1 tbsp Olivenöl und bestreue es mit gehacktem Knoblauch, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle das Blech zurück in den Ofen und röste alles 15 bis 18 Minuten, bis die Haut goldbraun ist und das Hähnchen eine Kerntemperatur von 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
