      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebel und hacke die Knoblauchzehen fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste die Zwiebel etwa 3 Minuten glasig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Kreuzkümmel dazu und rühre 30 Sekunden, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis dazu und rühre 2 Minuten, damit er mit Öl überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße 2 cups Wasser dazu und bringe alles zum Kochen. Reduziere dann die Hitze, decke den Topf ab und lass den Reis 18-20 Minuten köcheln, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die schwarzen Bohnen aus der Dose abtropfen, spüle sie ab und rühre sie unter den gekochten Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche alles weitere 2 Minuten bei niedriger Hitze, bis die Bohnen warm sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Presse etwas Limettensaft darüber, gib frischen Koriander dazu und schmecke mit Salz ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
