      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 400 °F vor und legen Sie eine Muffinform mit Papierförmchen oder Fettmulden aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer großen Schüssel Mehl, Zucker, Backpulver, Salz und Zitronenschale vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer anderen Schüssel Ei, Milch, Öl und Vanilleextrakt verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie die feuchten Zutaten in die trockenen Zutaten und rühren Sie, bis alles gut vermischt ist. nicht übermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Blaubeeren vorsichtig unterheben, bis sie gleichmäßig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Teig auf die Muffinförmchen verteilen und jedes zu etwa zwei Dritteln füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "18–22 Minuten backen, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
