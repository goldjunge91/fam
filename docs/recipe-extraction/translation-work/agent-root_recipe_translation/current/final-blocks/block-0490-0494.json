      "steps": [
        {
          "position": 0,
          "text": "Richte eine Panierstraße ein: Gib Mehl in eine flache Schüssel, das verquirlte Ei in eine zweite und verrühre die Semmelbrösel mit dem geriebenen Parmesan in einer dritten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Klopfe jede Hähnchenbrust auf eine gleichmäßige Dicke von 1/2-inch und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Schnitzel in Mehl und schüttle überschüssiges Mehl ab. Tauche es ins Ei und drücke es dann in die Parmesan-Semmelbrösel-Mischung, bis es vollständig bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate das Hähnchen etwa 4 bis 5 Minuten pro Seite, bis die Panade goldbraun und das Hähnchen durchgegart ist und innen kein Rosa mehr zeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Toaste die halbierten Brötchen nach Wunsch, damit sie besonders knusprig und aromatisch werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege je ein Schnitzel in ein Brötchen, gib eine Scheibe Provolone darauf und löffle vor dem Servieren warme Marinarasoße darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
