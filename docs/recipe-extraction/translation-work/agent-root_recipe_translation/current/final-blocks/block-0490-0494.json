      "steps": [
        {
          "position": 0,
          "text": "Brate das Rinderhack mit dem gehackten Knoblauch in einem großen Suppentopf bei mittlerer Hitze an. Zerteile das Fleisch beim Garen und brate es etwa 6 bis 8 Minuten, bis kein Rosa mehr zu sehen ist. Gieße das Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Rinderbrühe und die Tomaten samt Flüssigkeit dazu und würze alles mit Basilikum, Oregano, Salz und Pfeffer. Bringe die Suppe zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die trockenen Schleifennudeln dazu, bringe die Suppe erneut zum Kochen und gare sie ohne Deckel etwa 7 bis 9 Minuten, bis die Pasta weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre den gehackten Spinat ein und lass ihn in der Suppe zusammenfallen. Schöpfe die Suppe in Schüsseln und bestreue sie mit geriebenem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
