      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375 F vor. Verrühre in einer Schüssel das verquirlte Ei, Ricotta und etwa 1-1/4 Tassen italienische Käsemischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche 12 Mulden einer Muffinform großzügig mit Olivenöl und drücke dann je ein Wan-Tan-Blatt hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib ungefähr 1 Esslöffel Ricottamischung und 1-1/2 Esslöffel Marinara in jedes Wan-Tan-Blatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege ein zweites Wan-Tan-Blatt auf jede Mulde. Drehe es um 90 Grad zum ersten Blatt und drücke die Mitte nach unten, sodass ein stabiler Becher entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib eine weitere Schicht Ricotta und Marinara in jede Mulde und streue die restliche Käsemischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Häppchen 20 bis 25 Minuten, bis der Käse blubbert und geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie ein paar Minuten abkühlen, garniere sie nach Wunsch mit frischer Petersilie und hebe sie aus der Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
