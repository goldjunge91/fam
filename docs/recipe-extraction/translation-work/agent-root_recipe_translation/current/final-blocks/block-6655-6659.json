        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz mischen; Warmes Wasser und 1 EL Öl hinzufügen und kneten, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig in 4 Kugeln teilen und 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Restliches Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Teigkugel zu einem dünnen Oval flach drücken und auf jeder Seite 2 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärmen Sie die Bohnen und verteilen Sie sie noch warm auf jeder Tortilla.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Queso-Fresko, Sauerrahm, Avocadoscheiben und Koriander belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tortilla halbieren und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
