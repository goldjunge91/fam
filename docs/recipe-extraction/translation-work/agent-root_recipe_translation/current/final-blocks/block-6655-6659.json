      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Rindfleischwürfel von allen Seiten etwa 5 Minuten lang anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Knoblauch im selben Topf etwa 2 Minuten lang anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie das Rindfleisch wieder in den Topf und fügen Sie Brühe hinzu. zum Kochen bringen, dann die Hitze reduzieren und 30 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffeln und Karotten hinzufügen; 15 Minuten köcheln lassen, bis es teilweise weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mais und Kohl unterrühren und dann 10–15 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer würzen, Koriander unterrühren und heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
