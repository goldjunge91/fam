      "steps": [
        {
          "position": 0,
          "text": "Die Schweineschulter großzügig von allen Seiten mit Meersalz, Knoblauchpulver und schwarzem Pfeffer einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Schweinefleisch in einen Schongarer oder einen großen ofenfesten Topf geben und mit Flüssigrauch beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Abdecken und im Schongarer bei niedriger Stufe 7-8 Stunden garen oder in einem 300°F heißen Ofen abgedeckt 4-5 Stunden garen, bis sich das Fleisch leicht zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Schweinefleisch vom Herd nehmen und mit zwei Gabeln zerpflücken; dabei den Bratensaft untermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tortillas in einer trockenen Pfanne bei mittlerer Hitze etwa 1 Minute pro Seite erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tacos zubereiten, indem du das zerpflückte Kalua-Schweinefleisch auf jede Tortilla gibst und anschließend mit zerkleinertem Kohl und Frühlingszwiebeln belegst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frischen Limettensaft über jeden Taco träufeln und mit Salsa servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
