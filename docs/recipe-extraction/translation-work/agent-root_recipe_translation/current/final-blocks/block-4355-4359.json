      "steps": [
        {
          "position": 0,
          "text": "Taro schälen und in 2-Zoll große Stücke würfeln, dabei die faserige Schale vollständig entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Tarostücke in einen großen Topf geben und mit Wasser bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zum Kochen bringen und 20-25 Minuten kochen, bis der Taro sehr weich ist und sich leicht mit einer Gabel zerdrücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Taro abgießen und 1 Tasse Kochwasser auffangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Taro in einer Schüssel mit einem Kartoffelstampfer zerdrücken und nach und nach das aufgefangene Kochwasser hinzufügen, bis eine glatte, puddingartige Konsistenz erreicht ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Salz nach Geschmack einrühren und warm oder bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
