          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zum Kochen bringen und 2-3 Minuten kochen, bis sich das Fleisch leicht aus der Schale löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Opihi abgießen und das Fleisch mit einer kleinen Gabel aus jeder Schale lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Opihi-Fleisch in eine Schüssel geben und mit Zitronensaft und weißem Essig beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Meersalz und einer Prise Chilipulver würzen und sofort warm oder gekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
