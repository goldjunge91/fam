      "steps": [
        {
          "position": 0,
          "text": "Den Reis nach Packungsanweisung kochen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rinderhackfleisch in einer großen Pfanne bei mittlerer bis hoher Hitze anbraten, dabei in kleine Krümel zerteilen, etwa 5-7 Minuten; anschließend mit Salz, Pfeffer und Knoblauchpulver würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das gegarte Rinderhackfleisch zu zwei Hackfleischbratlingen formen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne die Butter schmelzen und die gewürfelte Zwiebel etwa 3 Minuten anbraten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Mehl über die Zwiebeln streuen und 1 Minute ständig rühren, damit eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Rinderbrühe langsam unter Rühren zugießen, bis eine glatte Bratensauce entsteht, dann 5 Minuten köcheln lassen, bis sie andickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einer separaten Pfanne die zwei Eier mit der Sonnenseite nach oben braten, bis das Eiweiß fest ist, das Eigelb aber noch flüssig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Reis auf zwei Schüsseln verteilen, jeweils einen Hackfleischbratling darauflegen und mit einem Spiegelei und reichlich Bratensauce garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
