      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Reisnudeln 15 Minuten in warmem Wasser ein, bis sie weich sind, und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze einen großen Topf bei mittlerer bis hoher Hitze und gib gehackten Knoblauch und Ingwer hinein. Gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Hähnchenstücke hinzu und gare sie etwa 5 Minuten, bis sie nicht mehr rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Hühnerbrühe und Sojasauce hinzu und bringe alles zum Kochen. Gib dann die eingeweichten Nudeln hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze und lasse alles 10-15 Minuten köcheln, bis die Nudeln zart und das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreue das Gericht mit geschnittenen Frühlingszwiebeln und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
