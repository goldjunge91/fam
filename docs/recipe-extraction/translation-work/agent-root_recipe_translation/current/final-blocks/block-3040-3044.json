      ],
      "steps": [
        {
          "position": 0,
          "text": "Ritze die Fettschicht der Schweineschulter rautenförmig ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Flüssigrauch, Pfeffer und gehackten Knoblauch zu einer Paste und reibe das Schweinefleisch rundherum damit ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Fleisch in einen großen Bräter oder Schmortopf und gieße Hühnerbrühe auf den Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Topf fest mit Folie ab und brate das Fleisch bei 325°F 3-4 Stunden, bis es sich leicht mit einer Gabel zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hacke den Kohl und gib ihn in den letzten 30 Minuten Garzeit mit dem zerpflückten Schweinefleisch in den Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische alles und serviere es heiß mit der Garflüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
