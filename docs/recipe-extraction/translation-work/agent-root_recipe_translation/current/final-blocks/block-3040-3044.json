      "steps": [
        {
          "position": 0,
          "text": "Erhitze Butter in einer großen Pfanne bei mittlerer bis hoher Hitze und gib gehackten Knoblauch hinzu. Gare ihn 1 Minute, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Garnelen, Salz und Chiliflocken hinzu und gare sie 2 Minuten pro Seite, bis sie sich rosa zu färben beginnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Weißwein hinzu und presse Zitronensaft in die Pfanne. Kratze die Bratrückstände vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare alles weitere 2-3 Minuten, bis die Garnelen vollständig gar und undurchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre frisch gehackte Petersilie ein und serviere die Garnelen sofort auf gekochtem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
