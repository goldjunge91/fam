      "steps": [
        {
          "position": 0,
          "text": "Vermische gemahlene Mandeln, Puderzucker, Zimt, Salz und Eiweiß in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege ein Filoteigblatt auf die Arbeitsfläche und bestreiche es leicht mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 2 tablespoons Mandelfüllung waagerecht etwa 1 inch vom unteren Rand entfernt darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe den unteren Rand über die Füllung, schlage dann die Seiten ein und rolle den Teig fest zu einer Rolle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl auf 350°F und frittiere die Briouats portionsweise 1-2 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die frittierten Briouats auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Honig in einem kleinen Topf und tauche jeden warmen Briouat kurz hinein oder beträufle ihn mit Honig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestäube das Gebäck nach Wunsch mit zusätzlichem Zimt und Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere es warm oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
