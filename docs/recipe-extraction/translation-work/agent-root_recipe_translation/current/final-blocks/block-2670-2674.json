          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht und passe die Würzung mit Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere es mit frischem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
