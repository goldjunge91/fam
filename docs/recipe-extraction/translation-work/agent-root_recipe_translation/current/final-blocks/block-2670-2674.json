      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver, Salz und Orangenabrieb in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Arbeite weiche Butter in die Mehlmischung ein, bis sie groben Streuseln ähnelt. Gib dann Eigelb dazu und vermische alles zu einem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig 5 Minuten glatt, wickle ihn ein und stelle ihn 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig dünn zwischen Backpapier aus und schneide Rauten oder Blumenformen aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste Sesam 2 Minuten in einer trockenen Pfanne und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F und frittiere die Teigstücke 1-2 Minuten pro Seite goldbraun. Lasse sie dann auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Honig mit Zimt bei niedriger Hitze in einem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Tauche das frittierte Gebäck in den warmen Honig und bestreue es großzügig mit geröstetem Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Richte es auf einer Platte an und serviere es bei Raumtemperatur oder warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
