      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und bräune die Hähnchenschenkel pro Seite 4 Minuten an. Stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare im selben Topf gewürfelte Zwiebel und Knoblauch mit Bockshornkleesamen, Ingwer und Safran 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen zurück in den Topf, füge Hühnerbrühe und Linsen hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze und lasse alles zugedeckt 35-40 Minuten köcheln, bis die Linsen weich und das Hähnchen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerreiße das Fladenbrot in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen aus dem Topf, zerpflücke oder schneide es in Stücke und gib es zurück in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile Fladenbrotstücke auf Servierschalen und schöpfe die heiße Hühner-Linsen-Brühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischem Koriander und serviere es sofort, solange das Brot noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
