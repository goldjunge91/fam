      "steps": [
        {
          "position": 0,
          "text": "Zerpflücke oder hacke Khlii oder Beef Jerky in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer Hitze und brate gehackte Zwiebel und Knoblauch 2 Minuten an.",
