      "steps": [
        {
          "position": 0,
          "text": "Vermische Hackfleisch, gehackte Zwiebel, Knoblauch, Koriander, Petersilie, Paprikapulver, Kreuzkümmel, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme aus der Fleischmasse 12-16 ovale Frikadellen von etwa 3 inches Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittelhoher Hitze und bräune die Kefta-Frikadellen pro Seite 2 Minuten an. Stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare in derselben Pfanne die übrige gehackte Zwiebel 2 Minuten, gib dann Tomatenmark hinzu und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Dosentomaten samt Saft dazu und rühre gut um, bis die Sauce köchelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Kefta-Frikadellen zurück in die Pfanne und lasse sie 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Forme Mulden in der Sauce und schlage die Eier hinein. Decke die Pfanne ab und gare alles 5-7 Minuten, bis die Eier nach Wunsch gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit frischem Koriander und serviere es heiß mit Brot oder zu Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
