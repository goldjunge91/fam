      "steps": [
        {
          "position": 0,
          "text": "Garen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lauch mit einem kleinen Schuss Olivenöl einige Minuten braten, bis er anfängt zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebeln und Hackfleisch dazugeben und braten, bis alles gebräunt ist. Dabei ständig rühren, damit der Lauch nicht ansetzt und anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reis dazugeben und einige Minuten umrühren, damit er gut vermengt und mit dem Bratensaft überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lammbrühe, Salz und Pfeffer dazugeben. Gut umrühren und zum Kochen bringen. 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mischung auf ein großes Backblech geben und auf die unterste Schiene des auf 180 Grad vorgeheizten Ofens stellen. Bis zu 1 Stunde backen. Das Gericht ist fertig, wenn die Flüssigkeit verdampft und der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nach dem Garen den Ofen ausschalten und den Lauch-Reis-Auflauf bei geöffneter Ofentür 10 Minuten abkühlen lassen, bevor er serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
