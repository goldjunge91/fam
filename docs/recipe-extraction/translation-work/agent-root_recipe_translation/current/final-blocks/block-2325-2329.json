          "images": []
        },
        {
          "position": 1,
          "text": "Safranfäden in 2 Esslöffeln warmer Brühe 5 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einer großen flachen Pfanne erhitzen und gehackte Zwiebel etwa 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Arborio-Reis dazugeben und unter häufigem Rühren 1–2 Minuten anrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weißwein angießen und etwa 2 Minuten rühren, bis er aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiße Brühe schöpflöffelweise dazugeben und ständig rühren. Jede Zugabe erst aufnehmen lassen, bevor die nächste folgt. Insgesamt etwa 18–20 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn der Reis cremig und bissfest ist, Safranbrühe, Butter und Parmesan einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
