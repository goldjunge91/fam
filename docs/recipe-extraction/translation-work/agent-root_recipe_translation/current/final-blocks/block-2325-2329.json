      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und gehackte Zwiebel etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhack dazugeben und etwa 8 Minuten unter Zerteilen braten, bis es gebräunt ist. Tomatenmark einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Béchamelsauce zubereiten: Butter in einem Topf schmelzen und Mehl 1 Minute einrühren. Milch langsam unter ständigem Rühren hinzufügen und etwa 8 Minuten eindicken lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasagneblätter nach Packungsanleitung kochen, abgießen und flach auf Backpapier legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine dünne Schicht Béchamel auf dem Boden einer Backform von 9x13 verteilen. Lasagneblätter, Fleischsauce, Béchamel und Parmesan abwechselnd schichten, bis die Form gefüllt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einer letzten Schicht Béchamel und Parmesan abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abgedeckt bei 375°F 25 Minuten backen, dann weitere 15 Minuten ohne Abdeckung goldbraun und blubbernd backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
