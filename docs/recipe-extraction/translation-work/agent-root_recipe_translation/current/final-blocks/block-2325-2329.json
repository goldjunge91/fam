      "steps": [
        {
          "position": 0,
          "text": "1. Kartoffeln vorbereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln schälen und fein reiben. Für extra Knusprigkeit möglichst viel Feuchtigkeit mit einem sauberen Geschirrtuch ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2. Zutaten vermengen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geriebene Kartoffeln, gehackte Zwiebel, gehackten Knoblauch, Eier, Mehl, Majoran, Salz und schwarzen Pfeffer in einer großen Rührschüssel vermengen. Gut rühren, bis ein dicker, gleichmäßiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "3. Öl erhitzen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine großzügige Menge Öl in einer großen Pfanne bei mittlerer Hitze erhitzen. Das Öl sollte heiß sein, aber nicht rauchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "4. Kartoffelpuffer braten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Portionen des Teigs in die Pfanne geben und jeweils zu einem dünnen Puffer flach drücken. Goldbraun und knusprig braten, dann wenden und die andere Seite ebenso goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "5. Abtropfen lassen und servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gegarte Puffer auf einen mit Küchenpapier ausgelegten Teller legen, damit überschüssiges Öl aufgesogen wird. Sofort heiß mit saurer Sahne, Knoblauchdip oder als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
