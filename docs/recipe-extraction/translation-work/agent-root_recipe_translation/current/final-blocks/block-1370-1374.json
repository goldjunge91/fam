    {
      "externalId": "waivy:mfr-euro-soup-fasolada",
      "slug": "mfr-euro-soup-fasolada",
      "title": "Griechische Fasolada (Suppe mit weißen Bohnen)",
      "instructions": "Griechenlands Nationalsuppe: weiße Bohnen, langsam mit Karotten, Sellerie, Tomaten und reichlich Olivenöl gekocht, bis sie cremig sind. Serviert mit einem Schuss rohem Olivenöl, Oliven und knusprigem Brot. Griechisches Soulfood.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 60,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Getrocknete Bohnen sind am günstigsten, aber auch aus der Dose gelingt Fasolada hervorragend.",
        "Der letzte Schuss rohes Olivenöl macht diese Suppe typisch griechisch. Lass ihn nicht weg.",
        "Am nächsten Tag schmeckt die Suppe besser, wenn sich die Aromen entfaltet haben."
      ],
      "substitutions": [
        {
          "forIngredientId": "dried-white-beans",
          "swap": "2 Dosen weiße Marinebohnen oder Cannellini-Bohnen"
        },
        {
