      "steps": [
        {
          "position": 0,
          "text": "Richte die geschnittenen alten Tomatensorten auf einer Servierplatte an und lasse die Scheiben leicht überlappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere jede Burrata vorsichtig, damit die cremige Mitte sichtbar wird, und lege sie auf die Tomaten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile abgezupfte frische Basilikumblätter auf der Platte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Olivenöl, Balsamicoessig, gehackten Knoblauch (falls verwendet), Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle Tomaten und Burrata gleichmäßig mit dem Dressing.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib zum Schluss eine weitere Prise Fleur de Sel und frisch gemahlenen schwarzen Pfeffer darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere den Salat für den besten Geschmack sofort bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
