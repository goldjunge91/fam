      "steps": [
        {
          "position": 0,
          "text": "Schneide Mozzarella in 4 gleich große Scheiben, lege sie zwischen Brotscheiben und schneide die Ränder ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Eier in einer flachen Schüssel und gib Mehl und Paniermehl jeweils in separate Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Sandwich in Mehl, tauche es dann in verquirltes Ei und bedecke es anschließend gründlich mit Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F oder prüfe die Temperatur mit einem Thermometer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere die Sandwiches je Seite 2-3 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie sofort, solange der Käse noch warm und geschmolzen ist.",
