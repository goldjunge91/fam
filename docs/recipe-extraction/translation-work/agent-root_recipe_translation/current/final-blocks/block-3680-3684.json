      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze, bräune die Hähnchenstücke rundherum und nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gare die schwarze Recado-Paste unter ständigem Rühren 2 Minuten im selben Topf, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib rote Recado-Paste hinzu und rühre eine weitere Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Hähnchen zurück in den Topf, gieße Hühnerbrühe an und lasse alles zugedeckt 30 Minuten köcheln, bis das Hähnchen zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Hähnchen aus der Brühe, zupfe das Fleisch und entferne Knochen und Haut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hacke hartgekochte Eier und vermische sie mit Oliven und Rosinen zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gezupftes Hähnchen mit Tomatensauce und der Ei-Oliven-Rosinen-Mischung zurück in den Topf und rühre vorsichtig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse alles weitere 10 Minuten köcheln, damit sich die Aromen verbinden. Würze mit Salz und Pfeffer und serviere es mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
