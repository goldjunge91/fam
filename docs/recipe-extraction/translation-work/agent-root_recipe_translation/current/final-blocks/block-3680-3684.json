      "steps": [
        {
          "position": 0,
          "text": "Koche Eier 10 Minuten in Wasser hart, kühle sie ab, schäle sie und hacke sie klein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Kürbiskerne 2-3 Minuten in einer trockenen Pfanne bei mittlerer Hitze, bis sie duften, und gib sie dann in eine Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gehackten Knoblauch, bei Verwendung Jalapeño und Gemüsebrühe zu den Kürbiskernen und püriere alles zu einer glatten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne und brate die Kürbiskernsauce 2 Minuten. Würze sie dann mit Salz und weißem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erwärme die Tomatensauce in einem separaten Topf bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Tortillas kurz in einer Pfanne oder über offener Flamme, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege gehackte Eier in die Mitte jeder Tortilla, rolle sie fest auf und ordne sie mit der Naht nach unten in einer Auflaufform an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße Kürbiskernsauce über die Tortillarollen, beträufle sie mit Tomatensauce und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
