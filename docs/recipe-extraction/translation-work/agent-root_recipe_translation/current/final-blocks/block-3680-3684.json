      "steps": [
        {
          "position": 0,
          "text": "Verquirle in einer Schüssel frischen Orangensaft, Limettensaft, gehackten Knoblauch, Kreuzkümmel, Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege Schweinesteaks in eine flache Schale und gieße die Zitrusmarinade darüber, sodass sie gut bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mariniere das Schweinefleisch mindestens 2 Stunden im Kühlschrank oder für ein intensiveres Aroma bis zu 8 Stunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch aus der Marinade und tupfe es mit Küchenpapier trocken. Bewahre die Marinade auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate die Steaks je Seite 5-6 Minuten, bis sie gar und leicht karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die aufbewahrte Marinade in die Pfanne, gib geschnittene rote Zwiebel hinzu und lasse alles 3-4 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Fleisch mit der Pfannensauce und eingelegten roten Zwiebeln, dazu warme Tortillas.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
