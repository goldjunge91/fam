      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Guajillo- und Pasilla-Chilis in einer trockenen Pfanne 1-2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein. Püriere sie anschließend mit 1.5 cups Einweichwasser, Zwiebel, Knoblauch, Essig, Kreuzkümmel und Oregano glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze das Ziegenfleisch mit Salz und Pfeffer und bräune es in einem großen Topf bei mittlerer bis hoher Hitze 10-12 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Chilisauce durch ein feines Sieb über das Fleisch. Gib Hühnerbrühe und Lorbeerblätter dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf ab und lasse das Ziegenfleisch 3-3.5 Stunden köcheln, bis es ganz zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Fleisch heraus, zupfe es auseinander und lasse es weitere 10 Minuten im Topf köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere gezupftes Ziegenfleisch und Consomé in flachen Schüsseln, dazu warme Tortillas, Limette und Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
