      "steps": [
        {
          "position": 0,
          "text": "Bringe die Hühnerbrühe in einem großen Topf zum Kochen und gib geviertelte Zwiebel sowie zerdrückte Knoblauchzehen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gewürfelte Hähnchenbrust, Karotten und Kartoffeln dazu. Reduziere die Hitze und lasse alles 25-30 Minuten köcheln, bis das Hähnchen gar und das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm 1 cup heiße Brühe heraus und püriere sie mit Chipotle-Chilis und Adobo-Sauce glatt. Seihe die Mischung zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze den Caldo nach Geschmack mit Salz und Pfeffer und rühre den Sauerrahm ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib frischen Koriander in den Topf und presse den Saft einer Limette in die Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe den Caldo in Schüsseln und gib Tortillastreifen, geschnittene Avocado, zusätzlichen Koriander und eine Limettenspalte darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sofort heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
