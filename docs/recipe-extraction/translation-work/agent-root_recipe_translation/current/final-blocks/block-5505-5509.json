      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Guajillo- und Ancho-Chilis 1-2 Minuten in einer trockenen Pfanne an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein. Püriere sie anschließend mit 1 cup Einweichwasser, Zwiebel, Knoblauch, Essig, Kreuzkümmel und Oregano glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Seihe die Chilipaste durch ein feines Sieb in eine große Bratform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze große Stücke Lammschulter mit Salz und Pfeffer und lege sie in die Form. Wende sie in der Chilipaste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Brühe und Lorbeerblätter dazu, decke die Form fest mit Folie ab und stelle sie in den auf 325°F vorgeheizten Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate das Lamm 4-4.5 Stunden, bis es sehr zart ist und sich leicht zupfen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Lamm aus der Form und zupfe es mit Gabeln auseinander. Gib es zurück in die Form und lasse es 15 Minuten den Bratensaft aufnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das gezupfte Barbacoa auf warmen Tortillas mit Limette, Zwiebel und Koriander. Reiche die eingekochte Kochflüssigkeit dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
