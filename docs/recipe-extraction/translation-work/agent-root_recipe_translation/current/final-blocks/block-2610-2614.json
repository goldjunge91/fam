      "steps": [
        {
          "position": 0,
          "text": "Halbiere die Auberginen längs, höhle sie aus, sodass eine ½ Zoll dicke Schale bleibt, und hebe das gehackte Fruchtfleisch auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze ¼ Tasse Olivenöl in einer Pfanne und brate die Auberginenschalen kurz auf beiden Seiten, bis sie leicht gebräunt sind. Lege sie mit der Hautseite nach unten in eine Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste in derselben Pfanne Zwiebeln und Knoblauch im restlichen Öl etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das gehackte Aubergineninnere, Tomatenmark und Tomaten hinzu und gare alles 10 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Petersilie, Pinienkerne und Korinthen ein und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Auberginenschalen mit der Mischung und beträufle sie mit dem restlichen Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Form mit Folie ab und backe die Auberginen bei 375°F 25-30 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm oder bei Zimmertemperatur mit Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
