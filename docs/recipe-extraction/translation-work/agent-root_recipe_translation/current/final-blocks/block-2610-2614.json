      "steps": [
        {
          "position": 0,
          "text": "Bräune Lammhackfleisch in einer Pfanne bei mittlerer bis hoher Hitze und zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackte Zwiebel und Knoblauch zum Lamm und gare alles 3 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark, Zitronensaft, Salz und Pfeffer ein und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Pfanne vom Herd und hebe frische Petersilie und Pinienkerne unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 425°F vor und lege das Naan auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Lammfleischmischung gleichmäßig auf den beiden Naan-Stücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle sie mit Olivenöl und backe sie 8-10 Minuten, bis die Ränder knusprig und der Belag heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide die Pizza in Stücke und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
