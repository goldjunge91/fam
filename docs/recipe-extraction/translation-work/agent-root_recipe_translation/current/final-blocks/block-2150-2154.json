      "steps": [
        {
          "position": 0,
          "text": "Für die Satee-Marinade gib die folgenden Zutaten in den Behälter eines elektrischen Mixers:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 große Zwiebel, grob gehackt 2 Knoblauchzehen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Saft von 2 Zitronen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "2Tbs. Zucker 1 cup Sojasauce",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1 tsp Salz 1 tsp gemahlener Koriander für Rind (oder Hähnchen) oder 1 tsp gemahlener Ingwer für Schweinefleisch",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1 cup Öl",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Püriere alles gründlich und gieße es über:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
