      "steps": [
        {
          "position": 0,
          "text": "Weiche den Stockfisch über Nacht ein und wechsle das Wasser einige Male.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße den Fisch ab, gib ihn in einen großen Topf mit frischem Wasser und bringe alles zum Kochen. Gieße das Wasser erneut ab, gib frisches Wasser dazu und bringe es wieder zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lass den Fisch etwa fünf Minuten köcheln, bis er gar ist. Gieße ihn ab und zerteile ihn in große Stücke. Entferne Haut und Gräten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für die Klöße vermische Mehl und Nierenfett mit einer Prise Salz und 250ml/9fl oz Wasser zu einem Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wickle die Mischung in Frischhaltefolie und lass sie im Kühlschrank ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öffne die Ackee-Dose, gieße sie ab, spüle die Früchte und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze einen Esslöffel Olivenöl in einer Pfanne und brate die Zwiebel weich, ohne sie zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Gewürze, Würze, Pfeffersauce und geschnittene Paprika dazu. Brate alles weiter, bis die Paprika weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib gehackte Tomaten und anschließend Stockfisch dazu und vermische alles. Rühre zuletzt sehr vorsichtig Ackee ein und lass das Gericht bis zum Servieren köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Wenn du bald essen möchtest, erhitze etwa 1cm/½in Pflanzenöl in einer Pfanne, bis es gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Forme aus der Klößchenmischung pflaumengroße Kugeln und brate sie in wenig Öl goldbraun. (VORSICHT: Heißes Öl ist gefährlich. Lass die Pfanne nicht unbeaufsichtigt.)",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Lass die Klöße auf Küchenpapier abtropfen und serviere sie mit Stockfisch und Ackee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
