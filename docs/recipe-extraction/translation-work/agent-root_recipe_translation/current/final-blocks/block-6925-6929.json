      "steps": [
        {
          "position": 0,
          "text": "Braunen Zucker, Paprika, Knoblauchpulver, Zwiebelpulver, Pfeffer und Salz zu einer Gewürzmischung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Schweineschulter in 1.5 Zoll große Würfel schneiden und gründlich mit der Gewürzmischung einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 325 °F vor und legen Sie die Würfel auf ein mit Folie ausgelegtes Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1.5 Stunden backen, bis die Außenseite karamellisiert und die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die verbrannten Enden in einer Schüssel mit Barbecuesauce und Butter vermengen und vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zurück auf das Backblech legen und weitere 30 Minuten backen, bis der Teig glasig und klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "5 Minuten abkühlen lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
