      "steps": [
        {
          "position": 0,
          "text": "Die Rinderzunge in einen großen Topf geben und mit kaltem Wasser bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbierte Zwiebeln, Karotten, Sellerie, Salz und Pfeffer in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 2.5 Stunden köcheln lassen, bis die Zunge weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Entfernen Sie die Zunge und lassen Sie sie leicht abkühlen. Ziehen Sie dann die äußere Membran unter fließendem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Zunge gegen die Faserrichtung dünn einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Roggenbrot leicht rösten und jede Scheibe mit Senf bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Scheiben geschnittene Zungen- und Gurkenscheiben auf das Brot legen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
