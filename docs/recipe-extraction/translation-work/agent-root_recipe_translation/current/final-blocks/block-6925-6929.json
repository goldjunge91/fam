      "steps": [
        {
          "position": 0,
          "text": "Butter in einem großen Topf bei mittlerer Hitze schmelzen und Zwiebeln, Sellerie und Karotten 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streuen Sie Mehl über das Gemüse und rühren Sie es 2 Minuten lang ständig um, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hühnerbrühe und Bier hinzufügen und umrühren, um Klümpchen zu glätten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zum Kochen bringen und 10 Minuten kochen lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und rühren Sie den geriebenen Cheddar-Käse unter, bis er geschmolzen und glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Milch hinzufügen und vorsichtig umrühren, dann mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Weitere 5 Minuten köcheln lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
