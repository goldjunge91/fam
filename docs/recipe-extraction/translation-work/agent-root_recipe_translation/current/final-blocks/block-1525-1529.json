      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in dünne Streifen. Verrühre für die Marinade Gochujang, Sojasauce, Sesamöl, Knoblauch, Ingwer und braunen Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass das Hähnchen 20 Minuten oder über Nacht marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate es mit Zwiebel in einer sehr heißen Pfanne an, bis die Sauce leicht karamellisiert; lass es nicht dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Serviere das Gericht mit Reis und bestreue es mit Sesam und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
