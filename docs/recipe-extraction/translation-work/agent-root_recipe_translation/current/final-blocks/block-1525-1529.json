      "steps": [
        {
          "position": 0,
          "text": "Bei getrockneten Algen (Wakame oder Kelp): Weiche sie 10 Minuten in kaltem Wasser ein, gieße sie ab und drücke sie aus. Schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Algen mit Knoblauch 2 Minuten in Sesamöl an; so entwickelt sich ein kräftiges Aroma.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Brühe, Ingwer und Hähnchen dazu und lass alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Hähnchen heraus und zerpflücke es. Gib es zurück in die Suppe und schmecke sie mit Sojasauce ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Suppe mit Reis und bestreue sie mit Frühlingszwiebeln.",
