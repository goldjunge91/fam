    {
      "externalId": "waivy:mfr-kor2-galbijjim",
      "slug": "mfr-kor2-galbijjim",
      "title": "Geschmortes Hähnchen nach Galbijjim-Art",
      "instructions": "Inspiriert vom koreanischen Klassiker aus geschmorter Rinderrippe: Hähnchenschenkel langsam in einer Soße aus Soja, Birne und Sesam mit Kastanien, Möhren und Rettich schmoren, bis sie zart sind und von einer reichhaltigen, leicht süßen Glasur überzogen werden. Ein festliches koreanisches Gericht mit Hähnchen für den Alltag.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 50,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Das vorherige Blanchieren des Hähnchens ist ein traditioneller koreanischer Schritt: Es reinigt das Fleisch und strafft die Haut.",
        "Hähnchenschenkel werden in 45 Minuten wunderbar zart; Rinderrippchen brauchen 3 Stunden.",
        "Dieses Rezept ist wie Galbijjim, aber 3x schneller zubereitet."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-thighs",
          "swap": "Hähnchenkeulenviertel mit Knochen für noch mehr Geschmack durch den Knochen"
        },
