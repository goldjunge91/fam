    {
      "externalId": "waivy:mfr-kor2-miyeok-guk",
      "slug": "mfr-kor2-miyeok-guk",
      "title": "Miyeok Guk (koreanische Algensuppe mit Hühnchen)",
      "instructions": "Koreas Geburtstagssuppe: zarte, eingeweichte Algen in einer klaren Brühe aus Sardellen und Rindfleisch mit geschnittenem Rindfleisch oder Hähnchen sowie Sesamöl. Nahrhaft, wohltuend und eine der feinsten Suppen der koreanischen Küche. Traditionell an Geburtstagen und von frischgebackenen Müttern gegessen.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 20,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Getrocknete Algen nehmen beim Einweichen das 6-Fache ihres trockenen Volumens an; mit einer kleinen Packung lassen sich viele Portionen zubereiten.",
        "Diese Suppe liefert besonders viele Nährstoffe pro Kalorie; Algen sind sehr mineralstoffreich.",
        "Das Anbraten der Algen in Sesamöl ist ein wichtiger Schritt, durch den sich ihr Aroma entfaltet."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-breast",
          "swap": "Dünn geschnittene Rinderbrust; traditioneller"
        },
        {
          "forIngredientId": "tofu",
          "swap": "Für eine einfachere Variante weglassen; Algen und Hähnchen geben der Suppe bereits genug Geschmack."
        }
      ],
