      "steps": [
        {
          "position": 0,
          "text": "Rühre Mehl, Ei und kaltes Wasser zu einem Teig; rühre nur kurz, denn Klümpchen sorgen für mehr Knusprigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe die gehackten Frühlingszwiebeln und Garnelen unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße den Teig in eine gut geölte, heiße Pfanne und verstreiche ihn dünn. Brate ihn bei mittlerer bis hoher Hitze 5 Minuten, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende den Pfannkuchen vorsichtig und brate ihn weitere 3 Minuten, bis die zweite Seite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre für die Dipsauce Sojasauce, Reisessig, Sesamöl und Chiliflocken zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
