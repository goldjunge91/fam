      "steps": [
        {
          "position": 0,
          "text": "Zwiebel fein hacken und mit Rinderhack, Panko und Ei nur so lange vermengen, bis alles gerade verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Masse zu 12–16 Fleischbällchen mit etwa 1.5 Zoll Durchmesser rollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Einen Topf bei mittlerer bis hoher Hitze erwärmen und die Fleischbällchen insgesamt 6–8 Minuten rundherum anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Überschüssiges Fett abgießen, dann Wasser, Sojasauce, Mirin und Zucker in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Aufkochen lassen, abdecken und 15–18 Minuten garen, bis die Fleischbällchen durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Frühlingszwiebelringen garnieren und heiß auf Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
