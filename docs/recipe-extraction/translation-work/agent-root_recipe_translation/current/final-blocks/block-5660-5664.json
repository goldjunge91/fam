          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Surimi, Gurke und Avocado waagerecht im mittleren Drittel des Reises anordnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit der Matte von der unteren Kante her fest aufrollen und dabei leichten Druck ausüben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Außenseite der Rolle vor dem Schneiden mit Sesam bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem scharfen, angefeuchteten Messer in 6–8 Stücke schneiden und mit Sojasauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
