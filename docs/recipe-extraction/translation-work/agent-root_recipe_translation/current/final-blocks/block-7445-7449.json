      "externalId": "waivy:bake-millionaires-shortbread",
      "slug": "bake-millionaires-shortbread",
      "title": "Millionaire's Shortbread (deutsche Fassung)",
      "instructions": "der klassisch British tray backen done right: ein crisp, buttery shortbread base, ein dick layer von proper stovetop caramel made aus condensed Milch und golden syrup gegart zu ein deep amber, und ein snappy dark Schokolade top. schneiden in neat squares für der ultimate süß treat.",
      "prepTimeMinutes": 25,
      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "aufbewahren-brand condensed Milch und Schokolade are far cheaper than name brands und taste identical once gebacken.",
        "Light corn syrup stands in perfectly für pricier imported golden syrup in der caramel.",
        "One batch makes 16 squares, so der cost per Stück is tiny compared zu buying these aus ein bakery."
      ],
      "substitutions": [
        {
          "forIngredientId": "corn-syrup",
          "swap": "verwenden maple syrup oder Honig für der caramel binder",
          "savings": "Ein vorhandenes Süßungsmittel verwenden statt hellem Zucker- oder Maissirup"
        },
        {
          "forIngredientId": "dark-chocolate",
          "swap": "Semi-süß oder Milch Schokolade chips, geschmolzen mit ein Teelöffel von Öl",
          "savings": "Spart ~$2 gegenüber einer Tafel guter dunkler Schokolade"
        },
        {
          "forIngredientId": "brown-sugar",
          "swap": "White Zucker plus ein Teelöffel von molasses",
          "savings": "Den Kauf eines zusätzlichen Beutels braunen Zuckers sparen"
        }
      ],
