        },
        {
          "position": 3,
          "text": "Scatter der Schokolade chips evenly über der crust, followed by der optional white Schokolade chips, dann der gehackt Walnüsse, und finally ein even blanket von shredded coconut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Slowly und evenly drizzle der entire can von sweetened condensed Milch über der top so it seeps in all der layers - do not umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "backen für 25 zu 30 Minuten, bis der coconut auf top is golden brown und der edges are bubbling.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "abkühlen der Pfanne completely auf ein rack, dann chill at least 1 Stunde so der condensed Milch sets - cutting warm gives ein gooey mess.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lift out using der foil overhang und schneiden in 16 squares mit ein sharp knife, wiping der blade between cuts für clean edges.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
