    {
      "externalId": "waivy:bake-russian-tea-cakes",
      "slug": "bake-russian-tea-cakes",
      "title": "Russian Tea Cakes (deutsche Fassung)",
      "instructions": "Tender, buttery shortbread-style cookies packed mit finely gehackt pecans und rolled twice in powdered Zucker so they look like little snowballs. They melt in dein mouth und come together mit five pantry staples.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 14,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "kaufen pecans oder Walnüsse in bulk und toast ein big batch at once; finely gehackt nuts go further und taste richer.",
        "machen dein own powdered Zucker by blitzing granulated Zucker mit ein Teelöffel von cornstarch in ein blender wenn du run out.",
        "der Teig freezes well rolled in balls; backen straight aus gefroren, adding 1-2 Minuten, so du only dirty one Schüssel per holiday season."
      ],
      "substitutions": [
        {
          "forIngredientId": "pecans",
          "swap": "Finely gehackt Walnüsse oder toasted Mandeln",
          "savings": "Walnüsse sind oft günstiger als Pekannüsse und ebenso traditionell"
        },
        {
          "forIngredientId": "butter",
          "swap": "Plant Butter (vegan Backen stick)",
          "savings": "Ergibt bei ähnlichem Preis vegane Kekse"
        },
        {
          "forIngredientId": "vanilla-extract",
          "swap": "1/2 tsp almond extract (deutsche Fassung)",
          "savings": "Schon wenig genügt, daher reicht eine Flasche für Dutzende Zubereitungen"
        }
      ],
