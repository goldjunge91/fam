    {
      "externalId": "waivy:bake-blondies",
      "slug": "bake-blondies",
      "title": "Brown Butter Blondies (deutsche Fassung)",
      "instructions": "Dense, chewy, butterscotch-rich blondies built auf browned Butter und dark brown Zucker, studded mit Schokolade chips und toasted Walnüsse. Crackly top, gooey center, und that deep toffee flavor ein real blondie is all etwa — no cocoa, no cake-y crumb.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 27,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Browning Butter costs nothing und is der single biggest flavor upgrade — never weglassen it für ein deeper toffee taste.",
        "kaufen ein Backen Schokolade bar und chop it anstatt chips; it's usually cheaper per ounce und melts in better pools.",
        "weglassen der extra yolk wenn du want — verwenden 2 whole Eier. der yolk just adds ein touch mehr chew."
      ],
      "substitutions": [
        {
          "forIngredientId": "walnuts",
          "swap": "verwenden pecans oder just leave nuts out und hinzufügen mehr Schokolade",
          "savings": "Spart etwa $1.50 pro Zubereitung"
        },
        {
          "forIngredientId": "semi-sweet-chocolate-chips",
          "swap": "White Schokolade chips oder gehackt dark Schokolade bar",
          "savings": "Tafelschokolade ist pro Unze oft 20-30% günstiger"
        },
        {
          "forIngredientId": "brown-sugar",
          "swap": "White Zucker plus 1 tbsp molasses per cup",
          "savings": "Spart einen zusätzlichen Einkauf für braunen Zucker"
        }
      ],
