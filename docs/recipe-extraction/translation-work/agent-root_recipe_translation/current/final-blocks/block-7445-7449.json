      "steps": [
        {
          "position": 0,
          "text": "erhitzen der Ofen zu 350F (175C) und line two Backen sheets mit parchment paper.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "in einer großen Schüssel, beat der weich Butter mit 1/2 cup powdered Zucker bis light, pale, und fluffy, etwa 2 Minuten. Beat in der vanilla.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "auf niedrig speed, gradually hinzufügen der Mehl und Salz, mixing just bis ein soft Teig forms, dann unterheben in der finely gehackt pecans bis evenly distributed.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Scoop der Teig in 1-inch balls (etwa 1 level Esslöffel je) und ausrollen between dein palms bis glatt; space them 1 inch apart auf der vorbereitet sheets.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "backen für 12 zu 14 Minuten, bis der bottoms are lightly golden but der tops are still pale. lassen der cookies rest auf der sheet für 5 Minuten so they firm up.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "While der cookies are still warm, ausrollen je one in der reserved powdered Zucker zu coat fully, dann transfer zu ein rack zu abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Once completely abkühlen, ausrollen der cookies ein second time in powdered Zucker für der klassisch snowy, fully-coated finish.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
