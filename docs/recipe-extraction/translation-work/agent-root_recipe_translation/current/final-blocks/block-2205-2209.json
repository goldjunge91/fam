      "steps": [
        {
          "position": 0,
          "text": "Verrühre alle Zutaten für das Dressing mit 1 tbsp Wasser in einer Schüssel, bis sich der Zucker aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Nudeln nach Packungsanweisung und tauche sie dann in eine Schüssel mit kaltem Wasser, bis sie vollständig abgekühlt sind. Gieße sie ab, gib Karotte, Kohl, Frühlingszwiebel und Dressing hinzu und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Öl in einer Pfanne bei hoher Hitze. Würze das Steak und gare es nach Wunsch; für rosa gebraten 2-3 Minuten pro Seite. Lasse es 5 Minuten ruhen und schneide es dann in Scheiben. Verteile Salat und Steakscheiben auf Schüsseln und streue zum Servieren Koriander darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
