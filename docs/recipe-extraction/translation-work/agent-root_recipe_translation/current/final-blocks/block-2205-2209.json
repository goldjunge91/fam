      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200C/180C Umluft/Gasstufe 6 vor. Lege Kürbis und Knoblauch auf ein Backblech und beträufle sie mit Olivenöl. Röste sie 35-40 mins, bis sie weich sind. Würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Nudeln nach Packungsanweisung. Gieße sie ab und bewahre das Kochwasser auf. Püriere den Kürbis mit 400ml Kochwasser mit einem Stabmixer. Erhitze etwas Öl in einer Pfanne und brate den Salbei knusprig. Lasse ihn auf Küchenpapier abtropfen. Gib Nudeln und Soße in die Pfanne und erwärme alles. Mit Salbei bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
