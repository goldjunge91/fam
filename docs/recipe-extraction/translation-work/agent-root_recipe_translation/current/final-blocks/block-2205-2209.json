      "steps": [
        {
          "position": 0,
          "text": "Wasche und schäle die Kartoffeln und schneide sie in ähnlich große Stücke, damit sie gleichmäßig garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Kartoffeln und Lorbeerblätter in einem großen Suppentopf mit Salzwasser 20 Minuten. Entferne die Lorbeerblätter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wenn du keinen fertig geschnittenen Grünkohl verwendest, wasche die Blätter gründlich unter kaltem fließendem Wasser, um Erde zu entfernen. Niemand möchte ein sandiges Gericht. Entferne grobe Stiele und braune Blätter. Schneide den Grünkohl mit einem scharfen Messer in dünne Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schäle und hacke die Schalotten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmilz 1 tbsp Butter in einer Pfanne und brate die Schalotten einige Minuten an. Gib dann Grünkohl und 2 tbsp Wasser hinzu. Würze alles und gare es etwa 10 Minuten oder bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme die Milch auf dem Herd oder in der Mikrowelle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Kartoffeln ab, schüttle sie trocken und tupfe sie mit Küchenpapier ab. Zerdrücke sie mit einem Kartoffelstampfer oder einer Kartoffelpresse. Arbeite zügig und gib warme Milch sowie die restliche Butter hinzu. Mit Muskatnuss, Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mische den gegarten Grünkohl unter den Kartoffelstampf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Belege das Gericht mit Scheiben der geräucherten Wurst und serviere es heiß mit deinem Lieblingssenf oder Bratensoße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Servieren und genießen!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
