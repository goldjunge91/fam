      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf mit Salzwasser zum Kochen bringen und die Pasta nach Packungsanweisung bissfest kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Während die Pasta kocht, Olivenöl in einer großen Pfanne bei mittlerer Hitze erhitzen. Gehackten Knoblauch hinzufügen und 1 Minute braten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbierte Kirschtomaten, Oregano und Chiliflocken in die Pfanne geben und 5–7 Minuten garen, bis die Tomaten aufplatzen und zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Pasta abgießen, dabei 1 Tasse Nudelwasser auffangen. Dann die Pasta zur Tomatenmischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Feta über die Pasta bröseln und vorsichtig vermengen. Nach und nach etwas Nudelwasser hinzufügen, bis eine leichte Sauce entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zitronensaft und frisches Basilikum hinzufügen und vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren und nach Wunsch mit etwas Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
