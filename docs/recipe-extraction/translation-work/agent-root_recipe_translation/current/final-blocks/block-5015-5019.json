      "steps": [
        {
          "position": 0,
          "text": "Lauwarmes Wasser, Hefe und eine Prise Zucker in einer Schüssel verrühren und 5 Minuten stehen lassen, bis die Mischung schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermengen. Hefemischung und 1 EL Olivenöl hinzufügen und rühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig auf einer bemehlten Fläche 8 Minuten kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in eine geölte Schüssel legen, mit Frischhaltefolie abdecken und 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Backofen auf 475 °F vorheizen und den Teig auf einer Pizzapfanne oder einem Backblech zu einem dünnen Kreis ausziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die stückigen Tomaten mit gehacktem Knoblauch auf dem Teig verteilen und dabei am Rand 1 Zoll frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mozzarella in Stücke zupfen und auf der Sauce verteilen. Mit dem restlichen Olivenöl beträufeln und schwarzen Pfeffer darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "12–15 Minuten backen, bis der Rand goldbraun und der Käse blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort nach dem Herausnehmen aus dem Ofen mit frischen Basilikumblättern belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
