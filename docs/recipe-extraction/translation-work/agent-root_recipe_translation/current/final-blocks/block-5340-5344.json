      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in 1 Zoll große Würfel und tupfe sie trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne oder einem Wok bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen hinein und brate es unter Rühren etwa 6–7 Minuten, bis es fast gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den gehackten Ingwer dazu und brate ihn 1 Minute an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Sojasauce, Sesamöl, Mirin, Reisessig und Brühe ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die ganzen Zehen schwarzen Knoblauchs dazu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze auf mittlere Stufe, decke die Pfanne ab und lass alles 10–12 Minuten köcheln, bis das Hähnchen gar und die Sauce reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke das Gericht ab und fülle es in eine Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Garniere mit geschnittenen Frühlingszwiebeln und serviere es auf Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
