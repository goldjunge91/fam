      "steps": [
        {
          "position": 0,
          "text": "Röste Auberginen direkt über einer Gasflamme oder unter dem Ofengrill und wende sie, bis sie vollständig schwarz sind (25 Minuten). Lass sie abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ziehe die verkohlte Schale ab und zerdrücke das Fruchtfleisch mit einer Gabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl, gib Kreuzkümmelsamen dazu und lass sie aufspringen. Gib Zwiebel hinzu und gare sie 8 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und Ingwer dazu und gare alles 2 Minuten. Füge Tomaten hinzu und gare sie 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die Gewürze unter und gare sie 1 Minute. Gib Auberginenfruchtfleisch dazu und koche alles unter Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verfeinere das Gericht mit Koriander und serviere es mit Roti oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
