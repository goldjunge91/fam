      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis zu 70 % gar und gieße ihn ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Zwiebelringe 20 Minuten, bis sie dunkel karamellisiert sind. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mariniere das Gemüse 15 Minuten in Joghurt und Gewürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare das marinierte Gemüse, bis es zu 80 % gar ist, etwa 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte in einem Topf die Hälfte des Reises, Gemüse, Röstzwiebel, Minze, den übrigen Reis, Safranmilch und Ghee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verschließe den Topf mit Folie und backe alles bei 375°F 25 Minuten. Lass es vor dem Servieren 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
