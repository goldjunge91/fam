        {
          "position": 0,
          "text": "Masa Harina, warmes Wasser und Salz vermengen, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig 5 Minuten ruhen lassen und dann glatt kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Handvoll Teig in der Handfläche zu einer dünnen Scheibe flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Einen Löffel Füllung (Käse, Bohnen oder Chicharrón) in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ränder über die Füllung klappen und erneut vorsichtig zu einer dicken Scheibe flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl auf einer Grillplatte oder in einer großen Pfanne bei mittelhoher bis hoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pupusas je Seite 3-4 Minuten goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Curtido (eingelegtem Kohlsalat) und Tomatensauce servieren.",
