          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schiebe die Rösti an den Pfannenrand und gib Paprika und Zwiebel in die Mitte. Gare sie 4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Knoblauch dazu und würze alles. Forme 3 Mulden und schlage je ein Ei hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pfanne ab und gare die Eier 3–4 Minuten. Streue Käse darüber und decke sie für 1 weitere Minute ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
