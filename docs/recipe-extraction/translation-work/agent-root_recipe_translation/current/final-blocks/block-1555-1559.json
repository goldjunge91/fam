      "steps": [
        {
          "position": 0,
          "text": "Schneide das Schweinefilet in 1 Zoll dicke Medaillons und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Medaillons in Öl bei hoher Hitze 3 Minuten pro Seite scharf an und nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Zwiebel dazu und gare sie 3 Minuten. Gib Äpfel und Thymian dazu und gare alles weitere 3 Minuten, bis die Äpfel gerade weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch dazu und gare ihn 30 Sekunden. Gieße Brühe dazu und rühre Dijon-Senf ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Schweinefilet zurück in die Pfanne und lass es 2 Minuten köcheln, bis die Sauce eindickt und das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
