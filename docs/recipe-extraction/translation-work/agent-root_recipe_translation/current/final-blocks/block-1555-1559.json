      "steps": [
        {
          "position": 0,
          "text": "Weiche die Steinpilze 15 Minuten in heißem Wasser ein. Drücke sie aus und hacke sie. Stelle das Einweichwasser beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Zwiebel 4 Minuten in Öl und Butter an. Gib die Pilze dazu und gare sie 5 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Thymian dazu und gare alles 1 Minute. Rühre den Reis ein und röste ihn 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße den Wein dazu und rühre, bis er aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die warme Brühe schöpflöffelweise dazu und rühre dabei ununterbrochen 18–20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Parmesan und kalte Butter ein. Würze das Risotto und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
