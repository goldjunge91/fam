      "steps": [
        {
          "position": 0,
          "text": "Rasple die Kartoffeln und presse mit einem Tuch das GESAMTE Wasser heraus; das ist entscheidend für die Knusprigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass Butter in einer Pfanne bei mittlerer bis hoher Hitze schmelzen. Verteile die Kartoffeln gleichmäßig darin und drücke sie an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate sie 8 Minuten ungestört. Wende sie portionsweise und brate sie weitere 6 Minuten, bis sie knusprig sind.",
