      "steps": [
        {
          "position": 0,
          "text": "Lass Pancetta in Öl knusprig aus; nimm sie mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Zwiebel im ausgelassenen Fett 4 Minuten an. Gib Chiliflocken dazu und gieße den Wein hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Tomaten dazu und lass die Sauce 15 Minuten köcheln, bis sie kräftig schmeckt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Bucatini, hebe etwas Nudelwasser auf und gieße die Nudeln ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die Nudeln mit der Sauce, der beiseitegestellten Pancetta und Pecorino. Lockere die Sauce nach Bedarf mit Nudelwasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
