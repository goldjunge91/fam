      "steps": [
        {
          "position": 0,
          "text": "Maisblätter 30 Minuten in warmem Wasser einweichen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter mit Masa Harina und Hühnerbrühe luftig aufschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel und Knoblauch anbraten, dann Hähnchen, Oliven und Rosinen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Je 2 Esslöffel Masa in die Mitte jedes Maisblatts streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 Esslöffel Füllung in die Mitte geben und die Seiten des Blatts über die Füllung falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Unteres und oberes Ende des Blatts einklappen, sodass es vollständig verschlossen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tamales in einen Dämpftopf mit Wasser unterhalb des Einsatzes legen und 45 Minuten dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vorsichtig auswickeln und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
