      "steps": [
        {
          "position": 0,
          "text": "Lasse Pizzateig 30 Minuten auf Raumtemperatur kommen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Ricotta, Mozzarella, Ei, Parmesan, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke Prosciutto und Spinat und hebe beides unter die Käsemischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in zwei Hälften und ziehe jede auf einer bemehlten Fläche zu einem Kreis von 10 inches auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Füllung auf einer Hälfte jedes Kreises und lasse einen Rand von 1 inch frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe den Teig über die Füllung und drücke die Ränder fest zu. Drücke sie dann mit einer Gabel zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Calzoni auf ein mit Backpapier ausgelegtes Blech, bestreiche sie mit Olivenöl und backe sie bei 400°F 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
