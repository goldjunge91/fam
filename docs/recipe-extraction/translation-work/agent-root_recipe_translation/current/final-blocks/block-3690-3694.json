      "steps": [
        {
          "position": 0,
          "text": "Schrubbe Muscheln unter kaltem fließendem Wasser ab und wirf alle weg, die sich nicht schließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und koche Spaghetti bissfest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide währenddessen Knoblauch in dünne Scheiben und erhitze Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und rote Chiliflocken dazu und gare sie 1-2 Minuten, bis sie duften, aber nicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Muscheln und Weißwein dazu, decke die Pfanne ab und dämpfe sie 6-8 Minuten, bis sie sich öffnen. Wirf alle geschlossenen Muscheln weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bewahre vor dem Abgießen der Spaghetti 1 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die abgetropften Spaghetti zur Muschelsauce und vermische alles gut. Gib nach Bedarf Nudelwasser dazu, bis die Sauce seidig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht mit gehackter Petersilie und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
