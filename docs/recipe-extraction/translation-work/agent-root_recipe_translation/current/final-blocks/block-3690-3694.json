      "steps": [
        {
          "position": 0,
          "text": "Reinige Miesmuscheln unter kaltem Wasser, entferne die Bärte und wirf alle beschädigten oder offenen Muscheln weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Knoblauch in dünne Scheiben und erhitze Olivenöl in einem großen Topf bei mittelhoher bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und schwarzen Pfeffer dazu und gare sie 1-2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Miesmuscheln und Weißwein dazu, decke den Topf ab und dämpfe sie 5-7 Minuten, bis sie sich öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wirf alle Muscheln weg, die sich nicht geöffnet haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd, presse Zitronensaft über die Muscheln und streue Petersilie darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie sofort in Schalen mit Kochsud und knusprigem Brot zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
