      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl, Urad-Dal-Mehl, Kreuzkümmelsamen, Ajowan, Chilipulver, Kurkuma, Salz und Sesam in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 2 tablespoons Öl dazu und vermische es mit den Fingern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib unter Rühren nach und nach Wasser dazu, bis ein glatter, dickflüssiger Teig entsteht (die Konsistenz sollte wie fester Teig sein).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf auf 325°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle den Teig in einen Chakli-Maker (Spiralform) und drücke ihn vorsichtig in kreisenden Bewegungen direkt ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Chakli 30 Sekunden pro Seite goldbraun und knusprig und nimm sie dann mit einer Schaumkelle heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und vollständig abkühlen, damit sie weiter knusprig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
