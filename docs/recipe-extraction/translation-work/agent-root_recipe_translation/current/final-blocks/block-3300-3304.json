      "steps": [
        {
          "position": 0,
          "text": "Weiche Reis und Urad Dal getrennt 4 Stunden ein, gieße sie ab und mahle sie dann zusammen mit Wasser zu einem glatten Teig (der Teig muss 2-3 Stunden fermentieren).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche Kartoffeln, zerstampfe sie mit Kurkuma und Salz und vermische sie dann mit angebratenen Zwiebeln, Senfkörnern, Curryblättern und Chana Dal.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl auf einer beschichteten Grillplatte oder Dosa-Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Teig auf die Grillplatte und verteile ihn mit der Löffelrückseite in kreisenden Bewegungen dünn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Beträufle die Ränder mit Öl und gare den Dosa etwa 2 Minuten, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib einen Löffel Kartoffelfüllung in die Mitte und klappe den Dosa zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare ihn weitere 30 Sekunden und lege ihn auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn heiß mit Sambar und Kokos-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
