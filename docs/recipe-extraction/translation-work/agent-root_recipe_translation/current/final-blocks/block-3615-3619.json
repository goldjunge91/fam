      "steps": [
        {
          "position": 0,
          "text": "Schneide überschüssiges Fett vom Rindfleisch ab und schneide es quer zur Faser in etwa 1/4 Zoll dicke Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Streifen mit Salz und Oregano und lasse sie 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher Hitze und brate das Fleisch portionsweise insgesamt etwa 15 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch heraus und stelle es beiseite. Dünste Zwiebel und Knoblauch in derselben Pfanne weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelte Tomaten und Serrano-Chilis hinzu und gare sie etwa 5 Minuten, bis die Tomaten zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Rindfleisch zurück in die Pfanne und vermische es gut mit der Tomatensauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Tortillas und serviere Tasajo mit darübergelöffelter Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
