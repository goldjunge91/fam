      "steps": [
        {
          "position": 0,
          "text": "Koche Hähnchenschenkel mit Zwiebel und Salz 25 Minuten in einem Topf. Zupfe das Fleisch und stelle es mit 2 Tassen Brühe beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Entferne Stiele und Kerne aus den getrockneten Chilis und röste sie 1 Minute leicht in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche die gerösteten Chilis 10 Minuten in heißem Wasser ein und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere eingeweichte Chilis, Knoblauch, Tomaten, Zimt und 1 Tasse Brühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem großen Topf und brate die Chilimischung unter ständigem Rühren 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die zurückbehaltene Hühnerbrühe langsam unter Rühren hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gezupftes Hähnchen und Schokolade hinzu und lasse alles 15 Minuten köcheln, bis sich die Aromen verbinden und die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit warmen Tortillas oder Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
