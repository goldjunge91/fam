      "steps": [
        {
          "position": 0,
          "text": "Verrühre Dashi, Sojasauce, Mirin und Salz in einer Schüssel und lasse die Mischung auf Zimmertemperatur abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle 3 Eier in einer separaten Schüssel leicht, ohne Schaum zu schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die abgekühlte Dashi-Mischung langsam unter vorsichtigem Rühren zu den Eiern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Mischung durch ein feines Sieb, um Klümpchen und Luftblasen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile Hähnchen, Pilze und Frühlingszwiebeln auf zwei hitzebeständige Schalen oder Teetassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Ei-Dashi-Mischung vorsichtig darüber, bis die Schalen zu drei Vierteln gefüllt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Schalen in einen Dämpfeinsatz über kochendes Wasser, decke sie ab und dämpfe sie 12-15 Minuten, bis das Ei gerade gestockt, in der Mitte aber noch leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß in den Schalen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
