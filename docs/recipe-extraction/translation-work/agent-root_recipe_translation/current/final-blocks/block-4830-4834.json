      "steps": [
        {
          "position": 0,
          "text": "Raspel die Gurke und drücke die überschüssige Flüssigkeit mit einem sauberen Küchentuch aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke die Knoblauchzehe fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre griechischen Joghurt, geraspelte Gurke, Knoblauch, Zitronensaft, Dill, Salz und Pfeffer in einer Schüssel. Stelle den Tzatziki bis zum Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage 4 Eier in das heiße Öl und brate sie etwa 4 Minuten, bis das Eiweiß gestockt und die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze die Spiegeleier mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme das Fladenbrot in einer trockenen Pfanne oder über einer offenen Flamme, jeweils 30 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile den Tzatziki auf zwei Tellern, lege je 2 Spiegeleier darauf und serviere das warme Fladenbrot dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
