      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinefleisch mit Ingwer, Fischsauce und weißem Pfeffer und forme kleine Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass den Reis 25 Minuten in der Brühe köcheln, bis er zu einem Brei zerfallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Schweinefleischbällchen in den köchelnden Jok und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate Knoblauch in Öl goldbraun an. Brate die Eier. Belege den Jok mit Ei, frittiertem Knoblauch und Koriander.",
