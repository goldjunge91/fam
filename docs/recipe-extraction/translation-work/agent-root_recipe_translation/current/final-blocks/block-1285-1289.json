      "steps": [
        {
          "position": 0,
          "text": "Koche den Reis. Erwärme Olivenöl in einer breiten Pfanne bei niedriger bis mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib geschnittenen Knoblauch und Chiliflocken dazu. Gare sie 3 Minuten sanft, bis sie duften, aber noch nicht braun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhöhe die Hitze und gib Garnelen und Paprikapulver dazu. Brate alles auf jeder Seite 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib einen Schuss Sherryessig dazu und schwenke die Pfanne. Serviere die Garnelen auf Reis mit Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
