      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 375°F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Äpfel schälen, entkernen und in dünne Scheiben schneiden. Mit Zucker, braunem Zucker, Rosinen, Zimt und Zitronensaft vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Filoteigblatt auf die Arbeitsfläche legen, dünn mit geschmolzener Butter bestreichen und mit Paniermehl bestreuen. 3 weitere Blätter darauf schichten und den Vorgang wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hälfte der Apfelmischung entlang einer langen Kante verteilen und rundherum einen 2-Zoll-Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fest aufrollen, dabei die Seiten einschlagen, und mit der Naht nach unten auf das Blech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit den übrigen Teigblättern und der restlichen Apfelmischung einen zweiten Strudel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beide Strudel mit der restlichen geschmolzenen Butter bestreichen und 25–30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten abkühlen lassen, vor dem Servieren mit Puderzucker bestäuben und in Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
