      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz auf einer Arbeitsfläche mischen, eine Mulde formen und die Eier hineinschlagen. Mit einer Gabel nach und nach Mehl einarbeiten, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 8–10 Minuten glatt und elastisch kneten, bei Bedarf Mehl hinzufügen. Einwickeln und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kürbispüree, Ricotta, Parmesan, Muskatnuss und schwarzen Pfeffer in einer Schüssel zur Füllung verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig mit einer Nudelmaschine oder einem Nudelholz dünn ausrollen. Nicht verwendeten Teig abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeweils 1 Teelöffel Füllung mit 2 Zoll Abstand auf ein Teigblatt setzen. Ein zweites Blatt darüberlegen und den Teig um die Füllung herum festdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem Teigrädchen oder scharfen Messer 2-Zoll-Quadrate ausschneiden. Ränder bei Bedarf mit Wasser versiegeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Einen großen Topf Salzwasser zum Kochen bringen. Ravioli portionsweise hineingeben und garen, bis sie an die Oberfläche steigen; weitere 2 Minuten kochen. Mit einer Schaumkelle herausnehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Butter in einer Pfanne schmelzen und Salbeiblätter darin braten, bis sie duften. Ravioli vorsichtig in der Salbeibutter schwenken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort mit zusätzlichem Parmesan und schwarzem Pfeffer servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
