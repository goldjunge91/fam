      "steps": [
        {
          "position": 0,
          "text": "Den Butternusskürbis halbieren, Kerne entfernen und bei 375°F etwa 35 Minuten weich rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das gegarte Fruchtfleisch in eine Schüssel geben, glatt stampfen und 5 Minuten abkühlen lassen.",
