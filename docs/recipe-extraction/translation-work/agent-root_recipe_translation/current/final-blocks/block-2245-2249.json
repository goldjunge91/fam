      "steps": [
        {
          "position": 0,
          "text": "Gericht vorbereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate den Lauch mit einem kleinen Schuss Olivenöl einige Minuten, bis er leicht bräunt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gericht vorbereiten",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib geröstete rote Paprika, Knoblauch, Brühe, Kräuter, Salz, Pfeffer und Paprikapulver dazu. Rühre gut um, füge den Reis hinzu und rühre erneut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lass die Mischung aufkochen und anschließend 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Mischung in ein mindestens 2 inches tiefes Backblech. Vermische alles gründlich und verteile es gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garen",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle das Blech auf die untere Schiene des vorgeheizten Ofens bei 180 Grad. Backe den Auflauf 1 Stunde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Servieren",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schalte nach dem Garen den Ofen aus und lass den Lauchauflauf bei geöffneter Ofentür 10 Minuten abkühlen, bevor du ihn servierst.",
