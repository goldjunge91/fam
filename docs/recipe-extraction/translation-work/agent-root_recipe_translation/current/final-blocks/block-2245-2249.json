      "steps": [
        {
          "position": 0,
          "text": "Schritt 1\nErhitze einen Wok oder eine große Pfanne, bis sie rauchend heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße das Öl hinein und schwenke es in der Pfanne. Gib dann Rindfleischstreifen und Chili dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gare alles unter ständigem Rühren, bis das Fleisch leicht gebräunt ist, etwa 3 mins. Gieße dann Austernsauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare alles, bis es durchgewärmt ist und die Sauce das Fleisch überzieht. Rühre Basilikumblätter ein und serviere das Gericht mit schlichtem Reis.",
