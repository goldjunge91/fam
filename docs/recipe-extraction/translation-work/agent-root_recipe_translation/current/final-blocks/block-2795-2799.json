      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und bräune die Hähnchenteile insgesamt etwa 8 Minuten auf beiden Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch und Zwiebelscheiben in die Pfanne und gare sie etwa 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Sojasauce, Essig und Wasser hinzu und gib Lorbeerblätter und schwarzen Pfeffer dazu. Rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere die Hitze auf niedrig, decke die Pfanne ab und lasse das Hähnchen 30 Minuten köcheln, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Deckel ab und lasse die Sauce weitere 5 Minuten leicht einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Probiere das Gericht und passe die Würzung bei Bedarf mit Sojasauce oder Essig an. Serviere es mit weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
