      "steps": [
        {
          "position": 0,
          "text": "Gib Schweinefleischstücke mit Wasser in einen großen Topf und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche das Fleisch 5 Minuten, damit sich Schaum löst. Gieße es dann ab und spüle es gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Schweinefleisch mit 8 Tassen frischem Wasser, Zwiebel und Knoblauch zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze, decke den Topf ab und gare das Fleisch 30 Minuten, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kartoffeln und Karotten hinzu und lasse alles zugedeckt 20 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kohlspalten hinzu und lasse alles weitere 8-10 Minuten ohne Deckel köcheln, bis alles Gemüse zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze großzügig mit Salz und schwarzem Pfeffer und serviere das Gericht heiß mit gedämpftem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
