      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser in einem großen Topf zum Kochen, gib Schweinefleischstücke hinzu und koche sie 10 Minuten. Gieße sie ab und spüle sie unter kaltem Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib 8 Tassen frisches Wasser in denselben Topf, lege das Schweinefleisch zurück hinein und bringe alles zum Kochen. Reduziere dann die Hitze, decke den Topf ab und lasse alles 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die Zwiebel in Scheiben, hacke den Knoblauch und schneide den Ingwer in Scheiben. Gib alles in den Topf und lasse es weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tamarindenpaste ein, gib Rettich, Taro und grüne Bohnen hinzu und lasse alles 15 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze nach Geschmack mit Salz, Pfeffer und Fischsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere das Gericht heiß in Schalen mit Brühe und Reis als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
