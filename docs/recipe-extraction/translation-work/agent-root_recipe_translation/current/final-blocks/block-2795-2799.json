      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Bananenblätter 1-2 Minuten in kochendem Wasser, damit sie weich werden, und tupfe sie dann trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer kleinen Pfanne und dünste Knoblauch, Ingwer und Zwiebel 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Kokosmilch und geschnittene Chilischoten ein und lasse alles 3-4 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Würze die Fischfilets auf beiden Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege je ein Fischfilet auf ein Bananenblatt und gib die Kokos-Chili-Mischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe die Bananenblätter zu festen Päckchen zusammen und lege sie mit der Nahtseite nach unten auf ein Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Päckchen im vorgeheizten Ofen bei 375°F 15-18 Minuten, bis der Fisch gar ist und sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
