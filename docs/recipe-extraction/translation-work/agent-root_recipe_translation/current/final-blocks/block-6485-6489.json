      "steps": [
        {
          "position": 0,
          "text": "Jede Pflaume entkernen, indem man sie der Länge nach aufschneidet und den Stein entfernt, damit die Früchte so weit wie möglich intakt bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Legen Sie eine Mandel in jede Pflaume, wo der Kern entfernt wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Speckstreifen quer halbieren und ein Stück um jede gefüllte Pflaume wickeln, bei Bedarf mit einem Zahnstocher fixieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis sie geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die eingewickelten Pflaumen hinzufügen und pro Seite 3–4 Minuten braten, bis der Speck knusprig und die Pflaumen heiß sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
