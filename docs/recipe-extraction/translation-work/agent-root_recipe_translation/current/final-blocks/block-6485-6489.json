      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie die Brezeln horizontal in Scheiben, um sie zu öffnen, ohne sie vollständig zu trennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Käse in dünne Stücke schneiden und zwischen die Brezelhälften legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jede gefüllte Brezel locker in Folie wickeln und im auf 350 °F vorgeheizten Ofen 5–7 Minuten erwärmen, bis der Käse zu schmelzen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Aus dem Ofen nehmen und warme Brezeln mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nach Geschmack mit Kümmel und schwarzem Pfeffer bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort servieren, solange der Käse noch warm ist und weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
