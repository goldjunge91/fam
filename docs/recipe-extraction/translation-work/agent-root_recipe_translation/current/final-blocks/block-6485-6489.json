      "steps": [
        {
          "position": 0,
          "text": "Hefe, warmes Wasser und Zucker mischen; 5 Minuten ruhen lassen, bis es schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Salz und Öl zur Hefemischung geben und kneten, bis ein glatter Teig entsteht; 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 12 Stücke, rollen Sie jedes zu einem Strang und formen Sie es dann zu einer Brezel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bringen Sie die Lauge oder Natronlösung zum Kochen (oder kochen Sie Wasser mit 1 EL Natron pro Tasse).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauchen Sie jede Brezel kurz 30 Sekunden lang in heiße Laugenlösung und legen Sie sie dann auf Pergamentpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brezeln großzügig mit grobem Salz bestreuen und bei 425 °F 12–15 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
