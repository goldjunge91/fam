        {
          "position": 1,
          "text": "Eier, Milch, Mehl, Zucker und Salz verrühren, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 EL Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, bis sie schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Apfelscheiben hinzufügen und 3-4 Minuten anbraten, bis sie weich und hellgolden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig über die Äpfel gießen und ohne Rühren 2-3 Minuten kochen lassen, bis der Boden fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pfannkuchen mit einem Holzlöffel in mundgerechte Stücke reißen und weitere 3–4 Minuten backen, bis er goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einen Teller geben, mit Puderzucker bestäuben und warm mit Apfelmus oder Schlagsahne servieren.",
