      "steps": [
        {
          "position": 0,
          "text": "Schneide das Brot in Scheiben und röste es leicht, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere die Knoblauchzehe und reibe mit der Schnittfläche vorsichtig über jede warme Toastscheibe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Halbiere die Tomate und reibe die Schnittfläche auf das geröstete Brot, damit der Saft einzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle jedes Toaststück mit Olivenöl und bestreue es mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege dünne Scheiben Jamón Ibérico auf jedes Toaststück und serviere es sofort.",
          "timerMinutes": null,
