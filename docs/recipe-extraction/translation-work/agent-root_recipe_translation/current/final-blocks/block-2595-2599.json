      "steps": [
        {
          "position": 0,
          "text": "Schmilz Butter in einem Topf und rühre Mehl zu einer Mehlschwitze ein. Gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach unter ständigem Rühren Milch dazu, damit keine Klümpchen entstehen. Lasse alles 5 Minuten köcheln, bis die Masse dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke den Schinken fein und rühre ihn mit Muskatnuss, Salz und Pfeffer unter die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Masse auf einem Backblech und stelle sie 30 Minuten kalt, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme aus der gekühlten Masse 12-16 ovale Stücke von etwa 2 inches Länge.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle drei Schüsseln bereit: eine mit verquirlten Eiern und zwei mit Paniermehl. Wende die Kroketten erst im Ei und dann im Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze das Öl auf 350°F und frittiere die Kroketten 2-3 Minuten goldbraun. Lasse sie anschließend auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
