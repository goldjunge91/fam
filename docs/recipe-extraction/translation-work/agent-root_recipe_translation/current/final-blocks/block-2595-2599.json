      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf oder Schmortopf bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze das Schweinefleisch mit Salz und Pfeffer und bräune es rundherum 8-10 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm das Fleisch heraus und brate gewürfelte Zwiebel und gehackten Knoblauch 5 Minuten an, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Streue geräuchertes Paprikapulver über die Zwiebeln und rühre 1 Minute ständig, damit sich das Gewürz entfaltet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomaten, Rotwein und Hühnerbrühe dazu und lege das Schweinefleisch zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und lasse alles 30 Minuten köcheln, bis das Fleisch zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Probiere das Gericht und passe die Würzung mit Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß mit knusprigem Brot oder zu Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
