      "steps": [
        {
          "position": 0,
          "text": "Teile das Rinderhackfleisch in 4 gleiche Portionen und forme etwa 3/4 inch dicke Patties. Drücke mit dem Daumen eine kleine Vertiefung in die Mitte jedes Pattys.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Jalapeños in dünne Ringe. Entferne nach Wunsch die Kerne, wenn du es milder magst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze und brate die Patties pro Seite 3-4 Minuten, bis ein Thermometer 160°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege in der letzten Minute der Garzeit je eine Scheibe Cheddar auf die Patties und decke die Pfanne ab, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Hamburgerbrötchen leicht in der Pfanne oder im Toaster.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche beide Brötchenhälften mit Mayonnaise und belege die untere Hälfte mit Salat, Tomatenscheibe und roter Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das Cheeseburger-Patty und Jalapeño-Scheiben darauf, setze die obere Brötchenhälfte auf und serviere den Burger sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
