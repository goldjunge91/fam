      "steps": [
        {
          "position": 0,
          "text": "Nimm die Steaks 15 Minuten vor dem Braten aus dem Kühlschrank und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze beide Seiten der Steaks großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine gusseiserne Pfanne bei mittlerer bis hoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Steaks pro Seite 3-4 Minuten für eine eher blutige Garstufe. Übergieße sie dabei mit 1 Esslöffel Butter, Knoblauch und Thymian.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Steaks auf einen Teller, decke sie locker mit Alufolie ab und lass sie 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die übrige Butter in derselben Pfanne bei mittlerer Hitze schmelzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schlage die Eier in die Pfanne und brate sie etwa 4 Minuten, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile Steaks und Eier auf zwei Tellern und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
