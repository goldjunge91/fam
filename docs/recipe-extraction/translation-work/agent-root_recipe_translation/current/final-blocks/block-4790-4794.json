      "steps": [
        {
          "position": 0,
          "text": "Erwärme die Tortillas in einer trockenen Pfanne pro Seite 15 Sekunden, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege jede Tortilla flach hin und verstreiche 2 tablespoons Hummus gleichmäßig darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Belege jede Tortilla mit der Hälfte der Putenscheiben und einer Scheibe Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege Blattsalat, geschnittene Gurke, gewürfelte Paprika und Tomatenscheiben in einer Linie in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe die linke und rechte Seite der Tortilla etwa 2 inches nach innen und rolle sie dann von unten fest auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wickle den Wrap zum späteren Essen in Folie oder serviere ihn sofort, diagonal halbiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
