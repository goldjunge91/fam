            },
            {
              "key": "fe5a7f9b-73a4-5fde-a8ea-94c349b8b50c",
              "ingredientName": "Tortilla",
              "grams": 240,
              "quantity": 6,
              "unit": "piece",
              "position": 2,
              "optional": false,
