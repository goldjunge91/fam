            },
            {
              "key": "76bfef55-1e7c-5db1-9cda-8942f7442838",
              "ingredientName": "Hähnchenbrust",
              "grams": 200,
              "quantity": 2,
              "unit": "portion",
              "position": 3,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Schneide jede Hähnchenbrust in etwa 3 Stücke, damit sie schneller gart, und gib sie in einen kleinen Topf. Gieße Enchilada-Sauce darüber und gare alles zugedeckt bei niedriger bis mittlerer Hitze etwa 20 Minuten, bis das Hähnchen gar ist. Kein Wasser nötig; das Hähnchen gart in der Sauce. Rühre gelegentlich um, damit nichts am Boden ansetzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen aus dem Topf und zerpflücke es mit zwei Gabeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 375 F Grad vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beginne den Auflauf zu schichten. Verteile etwa ¼ cup der übrigen Enchilada-Sauce auf dem Boden einer Auflaufform. In einer längeren Form passen 2 Maistortillas nebeneinander. Lege 2 Tortillas auf den Boden und gib ⅓ des Hähnchens, ⅓ der übrigen Sauce und ⅓ des Käses darüber. Wiederhole die Schichten mit jeweils 2 weiteren Tortillas, Hähnchen, Sauce und Käse. Schließe mit der letzten Schicht aus den restlichen Zutaten ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Auflauf ohne Deckel 20 to 30 Minuten, bis er blubbert und der Käse geschmolzen und oben leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
