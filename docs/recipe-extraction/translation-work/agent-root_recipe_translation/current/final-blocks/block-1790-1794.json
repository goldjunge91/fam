      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 Esslöffel Butter und 2 Esslöffel Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze beide Seiten jeder Hähnchenbrust mit gewürztem Salz und einer Prise Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Hähnchen in die Pfanne und gare es je Seite 5-7 Minuten, bis es vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Währenddessen einen großen Topf Wasser zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze das kochende Wasser mit einigen großzügigen Prisen koscherem Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Pasta dazu und rühre um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare sie unter gelegentlichem Rühren etwa 12 Minuten, bis sie al dente ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bewahre vor dem Abgießen 1/2 cup Nudelwasser auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm das Hähnchen aus der Pfanne und lege es auf ein Schneidebrett; lass es ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Reduziere die Hitze auf mittel und gib den restlichen 1 Esslöffel Butter und Olivenöl in dieselbe Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib Gemüse (ohne Knoblauch) und Chiliflocken dazu und rühre um, bis alles mit Öl und Butter bedeckt ist. Würze das Gemüse erst nach dem Bräunen mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Gare das Gemüse unter häufigem Rühren etwa 5 Minuten, bis es weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 12,
          "text": "Gib Knoblauch sowie eine großzügige Prise Salz und Pfeffer dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 13,
          "text": "Lösche die Pfanne mit Weißwein ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
