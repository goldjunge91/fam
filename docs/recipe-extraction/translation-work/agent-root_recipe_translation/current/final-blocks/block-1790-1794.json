        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Hähnchen marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Hähnchen, Salz, weißen Pfeffer und Ingwersaft in einer Schüssel gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle das Hähnchen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weißen Reis spülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Spüle den Reis ein paar Mal in einer Metallschüssel oder einem Topf und gieße das Wasser ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weißen Reis kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib 8 cups Wasser dazu und erhitze den Topf auf hoher Stufe, bis es kocht. Sobald der Reisbrei kocht, reduziere die Hitze und rühre alle 8-10 Minuten etwa 20-25 Minuten um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nach 25 Minuten kannst du optional etwas mehr Wasser hinzufügen, wenn du den Reisbrei dünner magst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib das marinierte Hähnchen zum Reisbrei und gare es weitere 10 Minuten bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gib nach weiteren 10 Minuten Frühlingszwiebeln, geschnittenen Ingwer, 1 Prise Salz und 1 Prise weißen Pfeffer dazu. Rühre 10 seconds um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Serviere den Reisbrei in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Optional: Gib Koriander obenauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
