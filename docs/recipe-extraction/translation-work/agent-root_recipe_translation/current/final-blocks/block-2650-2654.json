      "steps": [
        {
          "position": 0,
          "text": "Zerkleinere Rinderhackfleisch, Lammhackfleisch, gehackte Zwiebel, Knoblauch, Paprikapulver, Kreuzkümmel, Pfeffer und Salz in einer Küchenmaschine, bis die Masse klebrig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete die Masse 2 Minuten von Hand, damit sie bindet, und stelle sie dann 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Ofen auf 400°F vor und drücke die Fleischmasse fest auf einen vertikalen Drehspieß oder in eine mit Folie ausgelegte Kastenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate sie 45-50 Minuten im Ofen und wende Spieß oder Form alle 10 Minuten, bis die Außenseite gebräunt und das Fleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse das Fleisch 5 Minuten abkühlen und schneide es dann mit einem scharfen Messer in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme das Pitabrot in einer trockenen Pfanne 20 Sekunden pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würfle Tomate und weiße Zwiebel fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Tomaten- und Zwiebelwürfel auf das Pitabrot, belege es mit Dönerfleisch und beträufle es großzügig mit Tahinisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
