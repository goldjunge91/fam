      "steps": [
        {
          "position": 0,
          "text": "Teile den Blumenkohl in kleine Röschen und würfle die Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tablespoons Olivenöl in einer großen Pfanne und brate die gewürfelten Zwiebeln goldbraun an. Gib dann Rinderhackfleisch dazu und brate es krümelig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Blumenkohlröschen zur Fleischmischung und würze mit Salz, Pfeffer und Piment.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze in einem separaten Topf das restliche Öl, röste die Pinienkerne goldbraun und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Reis zum Fleisch und Gemüse und rühre 2 Minuten, damit er mit Öl überzogen wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Rinderbrühe über den Reis und bringe alles zum Kochen. Reduziere dann die Hitze auf niedrig und decke den Topf ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles 25 Minuten köcheln, bis der Reis weich und die Flüssigkeit aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stürze den Reis auf eine große Platte, sodass Blumenkohl und Fleisch oben liegen, und bestreue ihn mit gerösteten Pinienkernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
