      "steps": [
        {
          "position": 0,
          "text": "Weiche Bulgur 10 Minuten in warmem Wasser ein, bis er weich ist, und gieße ihn dann gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Zwiebel, Minze und Petersilie zusammen auf einem Schneidebrett fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Lammhackfleisch, eingeweichten Bulgur, gehackte Kräuter und Zwiebel, Zitronensaft, 2 tablespoons Olivenöl, Salz, Pfeffer und Piment in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermenge alles vorsichtig mit den Händen, bis die Zutaten gleichmäßig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme aus der Masse kleine ovale Frikadellen von etwa 2 inches Länge und 1 inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege Salatblätter auf eine Servierplatte und richte die Kibbeh darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle die Kibbeh vor dem Servieren mit dem restlichen Olivenöl und zusätzlichem Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
