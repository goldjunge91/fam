      "steps": [
        {
          "position": 0,
          "text": "Schneide die Rinderhüfte in 1.5-inch große Würfel und gib sie in eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Olivenöl, Zitronensaft, gehackten Knoblauch, Paprikapulver, Kreuzkümmel, Salz und Pfeffer zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Marinade über das Rindfleisch, vermische alles gut, decke die Schüssel ab und stelle sie mindestens 1 Stunde kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Paprika, Zwiebeln und Tomaten in 1.5-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stecke mariniertes Rindfleisch und Gemüse abwechselnd auf Metallspieße. Beginne und ende mit Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Grill oder Grillpfanne auf mittelhohe Hitze und grille die Spieße 12-15 Minuten. Wende sie alle 2-3 Minuten, bis das Fleisch nach gewünschtem Gargrad gegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie vom Herd und lasse sie vor dem Servieren 2 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
