      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350F vor. Fette eine Springform mit 9in Durchmesser leicht mit Butter ein und bestäube sie mit Zucker; überschüssigen Zucker ausklopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Schokolade, Öl und 1/2 cup (8 EL) Butter in einer großen hitzebeständigen Schüssel. Stelle sie über einen Topf mit leicht köchelndem Wasser und erhitze alles unter häufigem Rühren, bis es geschmolzen ist. Nimm die Schüssel vom Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Trenne 4 Eier und gib Eiweiß und Eigelb in zwei mittelgroße Schüsseln. Gib Kakaopulver, Vanille, Salz, 1/4 cup Zucker und die 2 übrigen ganzen Eier zum Eigelb und verquirle alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die Eigelbmischung nach und nach unter die Schokoladenmischung und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage das Eiweiß mit einem elektrischen Mixer auf hoher Stufe schaumig. Während der Mixer weiterläuft, gib nach und nach 1/2 cup Zucker dazu und schlage, bis feste Spitzen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe das Eiweiß in 2 Portionen vorsichtig unter die Schokoladenmischung und falte es nach jeder Zugabe nur so lange ein, bis es gerade vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schabe den Teig in die vorbereitete Form, streiche die Oberfläche glatt und streue die übrigen 2 EL Zucker darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Kuchen 35-45 Minuten, bis die Oberfläche aufgegangen ist und Risse bekommt und der Kuchen sich vom Rand der Form löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Stelle die Form auf ein Kuchengitter und lass den Kuchen vollständig darin abkühlen; die Mitte sinkt zusammen und bekommt beim Abkühlen weitere Risse. (Lässt sich 1 Tag vorher zubereiten, abgedeckt und luftdicht bei Zimmertemperatur.)",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schlage Schlagsahne, Mascarpone und Puderzucker mit einem elektrischen Mixer auf mittlerer bis hoher Stufe, bis weiche Spitzen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Löse den Rand der Springform und häufe die Schlagsahnemischung zum Servieren in der Mitte des Kuchens auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
