      "steps": [
        {
          "position": 0,
          "text": "Stelle einen Rost in die Mitte des Ofens und heize ihn auf 425°F vor. Halbiere die Zitrone quer und entferne sichtbare Kerne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Halbiere den Knoblauchkopf quer (es ist in Ordnung, wenn er etwas auseinanderfällt).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz die Butter in einem kleinen Topf oder in der Mikrowelle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das ganze Hähnchen auf ein Schneidebrett und tupfe es mit Papiertüchern vollständig trocken – Trockenheit ist entscheidend für gute Bräunung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Hähnchen mit der Brust nach oben und den Keulen zu dir. Schneide durch die lose Haut, die jede Keule mit der Brust verbindet, und mache einen etwa 3-inch langen Einschnitt bis zum Keulengelenk. So liegt das Gelenk frei und lässt sich leicht auf Gargrad prüfen. Auf der anderen Seite wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze alle Flächen großzügig mit Salz und Pfeffer – Haut, Bauchhöhle, unter den Flügeln und die freigelegten Keulengelenke. Rechne insgesamt mit etwa 4 TL Koschersalz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege das Hähnchen mit der Brustseite nach oben in eine große ofenfeste Pfanne. Lege Zitrone und Knoblauch mit der Schnittseite nach unten um das Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle das Hähnchen überall mit der geschmolzenen Butter und stelle es in den Ofen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Brate es, bis es schön gebräunt und durchgegart ist, und prüfe den Gargrad nach 45 Minuten. Steche ein Messer in ein Keulengelenk: Läuft klarer Saft heraus, ist es fertig; ist der Saft rosa, weitere 5 Minuten braten und erneut prüfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Lass das Hähnchen mindestens 15 Minuten in der Pfanne ruhen. Lege es auf eine Platte, gieße den buttrigen Bratensaft darüber und serviere es mit gerösteter Zitrone und Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
