          "position": 0
        }
      ]
    },
    {
      "externalId": "waivy:ba-no-fail-roast-chicken-with-lemon-and-garlic",
      "slug": "ba-no-fail-roast-chicken-with-lemon-and-garlic",
      "title": "Gelingsicheres Brathähnchen",
      "instructions": "Ein ganzes Brathähnchen mit goldener, knuspriger Haut, das nach karamellisierter Zitrone und Knoblauch duftet und mit buttrigem Bratensaft über jedes Stück serviert wird. Rezept von Bon Appétit: https://www.bonappetit.com/recipe/no-fail-roast-chicken-with-lemon-and-garlic",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 45,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Ein ganzes Hähnchen gehört zu den günstigsten Eiweißquellen pro Pfund – im Angebot kaufen und einfrieren.",
        "Hebe die Karkasse und den Bratensaft auf und koche daraus eine Portion selbst gemachte Brühe, die nichts kostet.",
        "Ersetze Butter durch Olivenöl, um Kosten zu sparen, ohne die knusprige goldene Haut zu verlieren."
      ],
      "substitutions": [
        {
          "forIngredientId": "unsalted-butter",
          "swap": "Olivenöl für ebenso knusprige Haut verwenden (milchfrei)",
          "savings": "etwa gleich teuer Kosten"
        },
        {
          "forIngredientId": "lemon",
          "swap": "Meyer-Zitrone für eine süßere, blumige Note verwenden",
          "savings": "etwas teurer"
        },
        {
          "forIngredientId": "kosher-salt",
          "swap": "Feines Meersalz eignet sich ebenfalls – wegen der höheren Dichte etwa die Hälfte der Menge verwenden",
          "savings": "ungefähr gleich teuer"
        }
      ],
