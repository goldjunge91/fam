      "steps": [
        {
          "position": 0,
          "text": "Entkernte Pflaumen 10 Minuten in Rum oder Wasser einweichen, bis sie weich sind, dann abgießen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Zucker und Salz in einer großen Schüssel vermischen und in der Mitte eine Mulde formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fügen Sie der Mehlmischung nacheinander ein Ei hinzu und verrühren Sie es vorsichtig, damit keine Klumpen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Unter Rühren nach und nach Milch einrühren, dann geschmolzene Butter und Vanilleextrakt einrühren, bis eine glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eine runde 9 Zoll große Auflaufform oder eine ähnlich große Form einfetten. Die Hälfte des Teigs hineingießen, die Pflaumen gleichmäßig darauf verteilen und den restlichen Teig darübergeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Im auf 350 °F vorgeheizten Ofen 40–45 Minuten backen, bis der Pudding am Rand fest, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Aus dem Ofen nehmen und 10 Minuten bei Zimmertemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm oder bei Zimmertemperatur servieren, da der Vanillepudding beim Abkühlen weiter fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
