      "steps": [
        {
          "position": 0,
          "text": "Die Zwiebel fein hacken und in einer Pfanne anbraten, bis sie weich ist. Dann das Rinderhackfleisch dazugeben und anbraten, bis es braun ist, wobei man es beim Kochen auseinanderbricht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spinat fein hacken und mit gekochtem Rindfleisch, Semmelbröseln, Ei, Salz, Pfeffer und Muskatnuss zu einer Füllung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Machen Sie einen Teig, indem Sie Mehl, 3/4 Tasse Wasser, 1 Ei und Salz vermischen. glatt kneten und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig zwischen Frischhaltefolie dünn ausrollen und in 3 Zoll große Quadrate schneiden. Jeweils 1 Esslöffel Fleischfüllung daraufgeben, zu Dreiecken falten und die Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Rinderbrühe zum Kochen bringen und die Maultaschen vorsichtig hineingeben und 8–10 Minuten kochen lassen, bis sie an der Oberfläche schwimmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Maultaschen in heißer Brühe servieren, garniert mit geriebenem Parmesan und gehackter Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
