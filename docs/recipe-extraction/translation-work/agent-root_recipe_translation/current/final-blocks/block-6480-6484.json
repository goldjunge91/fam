      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln kochen, bis sie weich sind, abtropfen lassen, schälen und noch warm pürieren, bis eine völlig glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffelpüree mit Mehl, Ei und Salz vermischen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig zu kleinen fingergroßen Stücken von etwa 3 Zoll Länge und 1/2 Zoll Dicke formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schupfnudeln in Salzwasser kochen, bis sie an die Oberfläche steigen, dann weitere 2–3 Minuten garen und abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zwiebel in dünne Scheiben schneiden und in Butter goldbraun anbraten, dann Sauerkraut dazugeben und erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Schupfnudel in der restlichen Butter von allen Seiten goldbraun braten, dann mit der Sauerkrautmischung vermengen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
