      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf erhitzen und die Rindfleischwürfel darin portionsweise von allen Seiten anbraten, dann beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zwiebeln würfeln und im selben Topf anbraten, bis sie weich sind, dann Tomatenmark einrühren und 1 Minute kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Rindfleisch wieder in den Topf geben, Brühe, Majoran, Kümmel, Salz und Pfeffer hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze reduzieren und abgedeckt 30 Minuten köcheln lassen, bis das Rindfleisch fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Kartoffeln in den Topf geben und ohne Deckel 20 Minuten köcheln lassen, bis die Kartoffeln gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und nachwürzen, dann heiß in Schüsseln mit knusprigem Brot als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
