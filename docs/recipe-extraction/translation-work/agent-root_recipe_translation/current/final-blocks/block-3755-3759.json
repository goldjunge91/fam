      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einer breiten flachen Pfanne bei mittlerer Hitze und dünste gehackten Knoblauch 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe Kokotxas trocken und gib sie vorsichtig ins heiße Öl. Gare sie sanft 2 Minuten pro Seite, ohne sie zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Weißwein dazu und lasse ihn 5 Minuten köcheln. Füge dann Fischfond und Muschelsaft hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse alles sehr sanft 5-8 Minuten köcheln, bis Kokotxas gar sind und die Sauce zu emulgieren beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hacke frische Petersilie fein und rühre sie mit Zitronensaft in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sofort in flachen Schalen mit reichlich Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
