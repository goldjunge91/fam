      "steps": [
        {
          "position": 0,
          "text": "Töte die Krabbe tierschutzgerecht, indem du sie zuerst kühlst und dann mit einem scharfen Messer durch die Mitte das Nervensystem zerstörst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Krabbe 20 Minuten in Salzwasser, nimm sie heraus und lasse sie so weit abkühlen, dass du sie anfassen kannst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Trenne den Körper von der Schale, löse das Fleisch heraus und reinige die Schale gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste gewürfelte Zwiebel und Knoblauch in Butter, gib Tomatenmark dazu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche mit Weißwein ab und gib Fischfond dazu. Lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Krabbenfleisch ein und gare es 5 Minuten. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Mischung zurück in die Krabbenschale, bestreue sie mit Semmelbröseln und Parmesan und überbacke sie 3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
