          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße sie in einem Sieb gründlich ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl mit geschnittenem Knoblauch, Paprikapulver und Chiliflocken in einer kleinen Pfanne bei mittlerer Hitze 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte Percebes auf einer Servierplatte an und gieße die heiße Knoblauch-Öl-Mischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie sofort mit Zitronenspalten zum Auspressen.",
