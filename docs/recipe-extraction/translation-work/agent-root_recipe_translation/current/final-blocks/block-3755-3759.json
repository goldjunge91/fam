      "steps": [
        {
          "position": 0,
          "text": "Weiche Stockfisch 24 Stunden in kaltem Wasser ein und wechsle das Wasser 3 Mal, um überschüssiges Salz zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Kabeljau in große Stücke und lege ihn mit der Hautseite nach unten in einen flachen Tontopf oder eine breite Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bedecke Kabeljau mit Wasser und pochier ihn bei niedriger Hitze 10-12 Minuten sanft, bis er gerade gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm Kabeljau mit einer Schaumkelle heraus und stelle ihn beiseite. Bewahre 0.5 cup Pochierflüssigkeit auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl in einem kleinen Topf bei niedriger Hitze und gare geschnittenen Knoblauch mit roten Chiliflocken 3 Minuten, bis er weich, aber nicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kabeljau mit der beiseitegestellten Pochierflüssigkeit zurück in die Pfanne und schüttle sie vorsichtig, um eine Emulsion zu bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schüttle und erhitze alles weitere 2-3 Minuten, bis die Sauce cremig und hell wird. Verfeinere sie mit Petersilie und Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
