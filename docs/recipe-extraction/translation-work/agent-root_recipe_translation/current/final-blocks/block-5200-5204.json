      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Hähnchenbrust trocken und würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer Grillpfanne oder einer normalen Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Grille das Hähnchen je Seite 6–7 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege es auf ein Schneidebrett, lass es 5 Minuten ruhen und schneide es dann in Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den gehackten Römersalat in eine große Schüssel, beträufle ihn mit Caesar-Dressing und vermenge alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den Salat auf zwei Teller und belege ihn mit Hähnchenstreifen, Croûtons und gehobeltem Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse Zitronensaft über die Salate und serviere sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
