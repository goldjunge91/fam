      "steps": [
        {
          "position": 0,
          "text": "1 EL Butter in einer Pfanne bei mittlerer Hitze schmelzen und die geschnittene Zwiebel etwa 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tiefgekühlte Kürbisblüten hinzufügen und 3–4 Minuten garen, bis sie aufgetaut ist und überschüssige Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit Salz, Pfeffer und gezupften Epazote-Blättern würzen, dann in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine Tortilla 20 Sekunden in einer trockenen Pfanne erwärmen, wenden und eine Handvoll Käse auf eine Hälfte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2–3 EL der Kürbisblütenmischung über dem Käse verteilen und die Tortilla zusammenklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "1–2 Minuten je Seite braten, bis sie goldbraun und knusprig ist. Dabei vorsichtig mit dem Pfannenwender andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit den übrigen Tortillas und der restlichen Füllung wiederholen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
