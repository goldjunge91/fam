      "steps": [
        {
          "position": 0,
          "text": "Den Reis unter kaltem Wasser abspülen, bis das Wasser klar abläuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hühnerbrühe zum Kochen bringen und Reis sowie Ingwerscheiben hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hitze reduzieren und 60–65 Minuten köcheln lassen. Häufig umrühren, bis der Reis sehr weich und cremig ist.",
