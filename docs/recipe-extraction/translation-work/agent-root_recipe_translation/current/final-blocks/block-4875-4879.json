          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Senfgrün unter den Reisbrei rühren und 2 Minuten erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nach Bedarf mit Sojasauce, Salz und weißem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Sesamöl beträufeln und in Schalen schöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mit zerstoßenen Erdnüssen und geschnittenen Frühlingszwiebeln belegen.",
