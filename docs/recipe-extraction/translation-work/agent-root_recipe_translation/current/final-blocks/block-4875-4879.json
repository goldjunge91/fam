      "steps": [
        {
          "position": 0,
          "text": "Den Reis gründlich abspülen und mit Ingwerscheiben in die kochende Meeresfrüchtebrühe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bei niedriger Hitze 60–70 Minuten köcheln lassen und häufig umrühren, bis der Reis zu einem cremigen Brei zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Garnelen schälen und entdarmen; die Jakobsmuscheln ebenfalls trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen und Jakobsmuscheln in den letzten 5 Minuten der Kochzeit zum Reisbrei geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Sojasauce, Salz und weißem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sesamöl kurz vor dem Servieren einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schalen schöpfen und großzügig mit Frühlingszwiebeln und Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
