        {
          "position": 0,
          "text": "Backofen auf 400°F vorheizen und Quinoa gemäß Packungsanweisung in einem Topf mit Wasser oder Brühe kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tilapiafilets auf ein mit Backpapier ausgelegtes Backblech legen und mit Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knoblauch, Dill, Salz und Pfeffer über die Filets streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zitronensaft über den Fisch pressen und Spargel darum herum anordnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "12-15 Minuten backen, bis sich der Tilapia leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Quinoa mit einer Gabel auflockern und auf Teller verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tilapia und Spargel zusammen mit zusätzlichem Zitronenspalten neben der Quinoa servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
