      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Putenhackfleisch mit gewürfelter Zwiebel 5-6 Minuten anbräunen und dabei zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch hinzufügen und 1 Minute anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Chilipulver, Kreuzkümmel, Salz und Pfeffer einrühren und 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dosentomaten samt Saft und abgetropfte Kidneybohnen hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Leicht köcheln lassen und Hitze auf mittelniedrig reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20-25 Minuten unter gelegentlichem Rühren köcheln lassen, bis sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abschmecken und nach Bedarf nachwürzen, dann mit saurer Sahne obendrauf servieren.",
