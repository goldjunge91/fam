      "steps": [
        {
          "position": 0,
          "text": "Butter in einem Topf mit schwerem Boden schmelzen und Zwiebel bei niedriger Hitze ohne Bräunung weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis dazugeben und rühren, bis alle Körner mit Butter überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wein dazugeben und bei niedriger Hitze unter Rühren garen, bis er aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heiße Brühe nach und nach dazugeben und rühren, bis jede Zugabe aufgenommen ist. Weiter rühren, bis der Reis zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Zitronensaft und -abrieb sowie Pfeffer nach Geschmack würzen. (Der Lachs dürfte ausreichend salzig sein, sodass vermutlich kein zusätzliches Salz nötig ist.) Vorsichtig umrühren und durchwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Parmesan und saisonalem Gemüse bestreut servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lachs grillen und vorsichtig zusammen mit Garnelen und Spargel auf das Risotto legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
