      "steps": [
        {
          "position": 0,
          "text": "Die Muscheln unter kaltem Wasser abbürsten, um Sand zu entfernen. Alle Muscheln entsorgen, die sich nicht schließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf erhitzen und den gehackten Knoblauch etwa 1 Minute lang anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Muscheln und Weißwein hinzufügen, abdecken und 5–7 Minuten garen, bis sich die Muscheln öffnen. Geschlossene Muscheln entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Muscheln mit einer Schaumkelle herausnehmen und beiseitestellen; die Kochflüssigkeit in einen Messbecher abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Fregola in denselben Topf geben und unter Rühren 2–3 Minuten anrösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fischfond, Muschelsud, Kirschtomaten und Chiliflocken hinzufügen. 12–15 Minuten köcheln lassen, bis die Fregola weich ist und den größten Teil der Flüssigkeit aufgenommen hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Muscheln zurück in den Topf geben, die beiseitegestellte Petersilie hinzufügen und 1 Minute vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen und sofort in flachen Schüsseln mit der restlichen Petersilie und etwas Olivenöl servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
