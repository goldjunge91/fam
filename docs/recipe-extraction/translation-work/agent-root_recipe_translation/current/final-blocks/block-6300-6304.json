      "steps": [
        {
          "position": 0,
          "text": "Safranfäden in 2 Esslöffeln warmem Wasser 5 Minuten ziehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Grießmehl und Salz in einer großen Schüssel vermischen, dann Safranwasser und das restliche warme Wasser nach und nach hinzufügen, bis ein steifer Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig zu einer 0.5 Zoll dicken Rolle formen und in 0.75 Zoll große Stücke schneiden. Jedes Stück mit einer Gabel eindrücken, sodass Rillen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zerkrümelte Wurst mit gehacktem Knoblauch in Olivenöl anbraten, dann Tomatensauce hinzufügen und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringen Sie einen großen Topf mit Salzwasser zum Kochen und kochen Sie die Malloreddus 8–10 Minuten lang, bis sie schwimmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Malloreddus abtropfen lassen und mit der Wurstsoße vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit geriebenem Pecorino Romano und frischem Basilikum garniert servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nach Belieben mit zusätzlichem Olivenöl beträufeln.",
