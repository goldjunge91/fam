      "steps": [
        {
          "position": 0,
          "text": "Mehl, Wasser, Salz und 1 Esslöffel Olivenöl zu einem weichen Teig verkneten; 30 Minuten abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln kochen und zerstampfen, dann mit gehacktem Knoblauch, Minze, Pecorino und Safran zu einer Füllung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig dünn ausrollen und in 3-Zoll-Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Je 1 Esslöffel Füllung auf ein Quadrat geben, zu einem Dreieck falten, die Ecken zusammenführen und zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringen Sie Salzwasser zum Kochen und kochen Sie die Culurgiones 4–5 Minuten lang, bis sie schwimmen, und lassen Sie sie noch 1 Minute lang stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vorsichtig abtropfen lassen und in eine Servierschüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit der mit gehacktem Knoblauch erwärmten Tomatensauce und dem restlichen Olivenöl vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm mit zusätzlichem Pecorino Romano servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
