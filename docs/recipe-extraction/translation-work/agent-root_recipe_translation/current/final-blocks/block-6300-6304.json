      ],
      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und die Rindfleischwürfel portionsweise von allen Seiten anbraten, insgesamt etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rindfleisch herausnehmen und die gewürfelten Zwiebeln und den gehackten Knoblauch anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tomatenmark einrühren und 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Topf mit Cannonau-Wein ablöschen und gebräunte Stücke abkratzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Rindfleisch wieder in den Topf geben, Brühe und Lorbeerblatt hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 45 Minuten köcheln lassen, bis das Rindfleisch fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Karotten- und Kartoffelstücke dazugeben und zugedeckt 30 Minuten weiter köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lorbeerblatt entfernen, mit Salz und Pfeffer würzen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
