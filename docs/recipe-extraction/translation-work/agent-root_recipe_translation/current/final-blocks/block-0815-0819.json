      "steps": [
        {
          "position": 0,
          "text": "Gare Glasnudeln oder ersatzweise Soba nach Packungsanleitung und spüle sie mit kaltem Wasser ab. Vermische sie mit 1 TL Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite die Japchae-Sauce zu: Vermische Sojasauce, Sesamöl, braunen Zucker und Knoblauch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das geschnittene Hähnchen 4–5 Minuten an und nimm es heraus. Brate Pilze, Karotte und Zwiebel 3 Minuten an. Gib den Spinat dazu und lass ihn zusammenfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Nudeln, Gemüse und Hähnchen zurück in die Pfanne. Füge die Sauce hinzu und schwenke alles bei mittlerer Hitze 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garniere das Gericht mit Sesamsamen und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
