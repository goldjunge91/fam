      "steps": [
        {
          "position": 0,
          "text": "Klopfe die Hähnchenbrüste auf eine Dicke von ½ Zoll. Würze sie mit Salz und Pfeffer und wende sie leicht in Mehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Hähnchen in Olivenöl bei mittlerer bis hoher Hitze pro Seite 3–4 Minuten goldbraun an. Nimm es heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Schalotte 2 Minuten in derselben Pfanne an. Gib Pilze und Knoblauch dazu und gare sie 4–5 Minuten, bis sie goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lösche die Pfanne mit ¼ Tasse Rotwein oder zusätzlicher Brühe ab. Gib Hühnerbrühe, Thymian und Butter dazu und lass alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Hähnchen zurück in die Pfanne und lass es 3 Minuten in der Sauce köcheln. Serviere es auf braunem Reis mit Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
