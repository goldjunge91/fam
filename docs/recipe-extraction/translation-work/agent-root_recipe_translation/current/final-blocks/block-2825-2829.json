      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Wasser, Ei und Salz zu einem glatten Teig und lasse ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Rinderhackfleisch mit Zwiebel und Knoblauch in einer Pfanne. Gib Sojasauce hinzu und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 6 gleich große Kugeln und rolle jede zu einem dünnen Quadrat aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile 2 Esslöffel Füllung auf einer Hälfte jedes Teigquadrats.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe den Teig über die Füllung und verschließe die Ränder, indem du sie fest zusammendrückst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer Hitze und gare die Martabak 3-4 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit süßer Chilisauce oder Kondensmilch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
