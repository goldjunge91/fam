      "steps": [
        {
          "position": 0,
          "text": "Hähnchenflügel mit Küchenpapier trocken tupfen und auf ein Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Backofen auf 425°F vorheizen und die Flügel 25-30 Minuten backen, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Während die Flügel backen, Ghost-Pepper-Sauce, Butter, Knoblauchpulver, Cayennepfeffer, Honig und Limettensaft in einem kleinen Topf bei niedriger Hitze verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Flügel aus dem Ofen nehmen und in eine große Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die heiße Saucenmischung über die Flügel gießen und gründlich vermengen. Auf einer Servierplatte anrichten und mit Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
