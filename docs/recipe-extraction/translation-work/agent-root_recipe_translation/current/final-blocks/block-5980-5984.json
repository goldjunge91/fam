      "steps": [
        {
          "position": 0,
          "text": "Gib Chilischoten, Knoblauch, Zitronensaft, Olivenöl, Salz, schwarzen Pfeffer, Paprikapulver und Lorbeerblätter in eine Küchenmaschine und püriere alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Hähnchenschenkel in eine große Schüssel und überziehe sie gründlich mit der Piri-Piri-Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke die Schüssel ab und stelle das Fleisch mindestens 4 Stunden, vorzugsweise über Nacht, kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize Grill oder Grillpfanne auf mittelhohe Hitze vor und bestreiche sie mit Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Hähnchenschenkel mit der Hautseite nach unten auf den Grill und grille sie 6–7 Minuten, bis die Haut angekohlt ist. Wende sie dann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille weitere 8–10 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse das Fleisch 5 Minuten ruhen und serviere es heiß mit gegrilltem Gemüse oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
