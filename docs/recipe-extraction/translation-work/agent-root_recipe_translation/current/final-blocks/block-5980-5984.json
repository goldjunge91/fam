      "steps": [
        {
          "position": 0,
          "text": "Vermenge Rinderhackfleisch, geriebene Zwiebel, Petersilie, Salz und schwarzen Pfeffer in einer Schüssel und knete alles, bis die Masse klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teile die Masse in 8 Portionen und forme jede länglich um einen Metallspieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine Grillpfanne oder einen Außengrill auf mittelhohe Hitze und öle die Fläche leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille die Koobideh 10–12 Minuten und wende sie alle 2–3 Minuten, bis sie durchgegart und an den Rändern angekohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die fertigen Koobideh auf eine Platte und gieße geschmolzene Butter mit Safran darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere sie auf lockerem Basmatireis mit Zitronenspalten als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
