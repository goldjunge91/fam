        {
          "position": 0,
          "text": "Verrühre Zitronensaft, Olivenöl, Knoblauch, Paprikapulver, Kreuzkümmel und Salz in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die Rindfleischwürfel in eine große Form und gieße die Marinade darüber. Wende das Fleisch, bis es gleichmäßig bedeckt ist, und stelle es mindestens 4 Stunden oder über Nacht kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke Rindfleisch, Zwiebel und Paprika abwechselnd auf 8 Metallspieße und verteile die Zutaten gleichmäßig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Grill auf mittelhohe Hitze vor und öle den Rost gut ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Spieße auf den Grill und gare sie 8–10 Minuten. Wende sie alle 2–3 Minuten, bis das Rindfleisch den gewünschten Gargrad erreicht und das Gemüse angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme das Pitabrot auf jeder Seite 1 Minute auf dem Grill.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Ziehe Fleisch und Gemüse von den Spießen auf das warme Pitabrot und serviere es mit Tahinisauce und Tomaten-Gurken-Salat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
