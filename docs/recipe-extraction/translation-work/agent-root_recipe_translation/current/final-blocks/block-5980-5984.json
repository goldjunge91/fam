      "steps": [
        {
          "position": 0,
          "text": "Vermische Sojasauce, Mirin, Sake, Knoblauch, Ingwer und Sesamöl in einer kleinen Schüssel zu einer Yakiniku-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die dünnen Rindfleischscheiben auf eine Platte und die Short Ribs auf eine zweite. Stelle beides bis 15 Minuten vor dem Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze einen Tischgrill oder Außengrill auf mittelhohe Temperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Grille die Rindfleischscheiben auf jeder Seite 30 Sekunden, bis sie leicht angekohlt sind. Tunke sie anschließend in Yakiniku-Sauce und iss sie sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille die Short Ribs auf jeder Seite 3–4 Minuten, bis sie außen angekohlt und innen medium-rare sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Frühlingszwiebelstücke auf jeder Seite 1–2 Minuten, bis sie angekohlt und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Richte alles Gegrillte auf einer Platte an, bestreue es mit Sesam und serviere es mit zusätzlicher Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
