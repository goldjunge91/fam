      "steps": [
        {
          "position": 0,
          "text": "Kokosöl in einem großen Topf erhitzen und Zwiebeln weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ingwer-Knoblauch-Paste hinzufügen und unter gutem Rühren 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenteile hinzufügen und 5 Minuten unter gelegentlichem Rühren garen, bis sie teilweise gekocht sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kartoffeln, Karotten, Kurkumapulver und grüne Chilis hinzufügen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wasser angießen und aufkochen, dann Hitze reduzieren und 20 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kokosmilch einrühren und weitere 5 Minuten köcheln lassen, bis das Hähnchen vollständig gar ist und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz würzen, Curryblätter hinzufügen und 1 Minute köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis oder Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
