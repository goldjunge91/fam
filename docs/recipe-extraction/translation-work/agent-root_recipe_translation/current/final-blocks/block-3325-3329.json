      "steps": [
        {
          "position": 0,
          "text": "Fisch säubern, auf beiden Seiten 2-3 diagonale Einschnitte machen und mit Salz sowie Kurkumapulver würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bananenblätter kurz in Wasser einweichen, damit sie weich werden, dann trocken wischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschnittene Zwiebeln, Tomaten, Ingwer und grüne Chilis auf jedem Bananenblatt schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürzten Fisch auf die Gemüseschicht legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kokosöl über den Fisch träufeln und rotes Chilipulver, Curryblätter sowie restliches Salz darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bananenblatt zu einem festen Päckchen falten und die Ränder gut einschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Päckchen mit der Nahtseite nach unten auf eine heiße Grillplatte oder Pfanne bei mittlerer Hitze legen und 15-18 Minuten pro Seite garen, bis der Fisch durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Päckchen vorsichtig am Tisch öffnen, auf austretenden Dampf achten und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
