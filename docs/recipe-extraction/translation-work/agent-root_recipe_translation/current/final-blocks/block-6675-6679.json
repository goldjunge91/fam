      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl hinzufügen und mit den Fingern in das Mehl einreiben, bis die Mischung wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Unter Rühren nach und nach warmes Wasser hinzufügen, bis ein weicher Teig entsteht, und 3–5 Minuten lang kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig mit einem feuchten Tuch abdecken und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teilen Sie den Teig in 3 gleiche Portionen, rollen Sie jede zu einer Kugel und drücken Sie sie dann auf einer geölten Oberfläche zu dünnen runden Scheiben flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitzen Sie eine schwere Pfanne oder Grillplatte bei mittlerer bis hoher Hitze und braten Sie jedes Roti 1–2 Minuten pro Seite, bis hellbraune Flecken erscheinen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Während des Kochens leicht mit Öl bestreichen und warm mit Curry, Eintopf oder Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
