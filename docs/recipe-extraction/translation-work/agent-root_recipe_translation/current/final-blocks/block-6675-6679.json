      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und braunen Zucker unter Rühren hinzufügen, bis er dunkelbraun karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchenstücke zum karamellisierten Zucker geben und unter gelegentlichem Rühren etwa 5 Minuten von allen Seiten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch dazugeben und 2 Minuten kochen lassen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark, grüne Gewürze und Thymian einrühren und gut vermischen, um das Huhn zu bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Hühnerbrühe aufgießen und bei Bedarf scharfe Paprika hinzufügen, dann zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduzieren Sie die Hitze auf einen niedrigen Wert, decken Sie es ab und lassen Sie es 30–35 Minuten köcheln, bis das Huhn zart und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit Roti, Reis oder Proviant servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
