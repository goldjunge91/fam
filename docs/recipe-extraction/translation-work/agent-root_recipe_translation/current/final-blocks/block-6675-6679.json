      "steps": [
        {
          "position": 0,
          "text": "Öl in einem Topf erhitzen und Zwiebel und Knoblauch 2 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackte Okra, Thymian und ggf. scharfe Paprika hinzufügen und 5 Minuten kochen lassen, bis die Okra ihre Flüssigkeit abgibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wasser oder Brühe mit Salz und Pfeffer zum Kochen bringen und dann langsam Maismehl unterrühren, um Klumpen zu vermeiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Unter ständigem Rühren Maismehl hinzufügen, um eine glatte Konsistenz zu gewährleisten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sobald das gesamte Maismehl eingearbeitet ist, reduzieren Sie die Hitze auf eine niedrige Stufe und rühren Sie die gekochte Okra-Mischung ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühren Sie 10–12 Minuten lang häufig weiter, bis die Mischung eindickt und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einen Servierteller gießen, zu einem Hügel formen und heiß mit gedünstetem Hähnchen oder Salzfisch servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
