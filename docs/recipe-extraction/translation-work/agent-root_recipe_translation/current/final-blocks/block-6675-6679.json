      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver, Salz und Zucker in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl und warmes Wasser hinzufügen und verrühren, bis ein weicher Teig entsteht, dann 2 Minuten lang kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kichererbsen grob zerdrücken und mit gewürfelten Zwiebeln, Knoblauch und grünen Gewürzen vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 4 Portionen teilen, dünn ausrollen und einen Löffel Kichererbsenmischung in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falten Sie den Teig über die Füllung und verschließen Sie die Ränder, indem Sie ihn leicht mit den Fingern andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und das Brot auf beiden Seiten goldbraun braten, insgesamt etwa 2–3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Papiertüchern abtropfen lassen und warm als Snack oder leichte Mahlzeit servieren.",
          "timerMinutes": null,
