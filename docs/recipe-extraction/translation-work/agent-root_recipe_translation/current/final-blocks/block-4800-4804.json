      "steps": [
        {
          "position": 0,
          "text": "Schweineleber und Zwiebel fein hacken und in einer Schüssel mit dem Schweinehackfleisch vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch, Semmelbrösel, Ei, Thymian, Salz und Pfeffer dazugeben. Vorsichtig mischen, bis alles gerade verbunden ist; nicht zu lange kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Schweinenetz 3–4 Minuten in warmem Wasser einweichen, bis es weich ist, und vorsichtig auf einem Brett ausbreiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Fleischmischung in 6 Portionen teilen und jeweils zu einem etwa 3 Zoll langen, kleinen ovalen Fladen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeden Fladen in ein Stück Schweinenetz wickeln und die Ränder darunterstecken, damit die Hülle hält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine Pfanne bei mittlerer Hitze erhitzen und die Crepinettes pro Seite 4–5 Minuten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Im auf 350°F vorgeheizten Ofen 10–12 Minuten fertig garen, bis die Kerntemperatur 160°F erreicht. Mit Bratensauce oder Senf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
