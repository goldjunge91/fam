      "steps": [
        {
          "position": 0,
          "text": "1 Esslöffel Pflanzenöl in einer großen Pfanne bei mittelhoher Hitze erhitzen. Das Schweinehackfleisch darin 5 Minuten krümelig anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauch und Ingwer fein hacken, zum Fleisch geben und 1 Minute mitbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Karotte raspeln. Kohl und Karotte mit Sojasauce und Sesamöl in die Pfanne geben und 3–4 Minuten braten, bis das Gemüse weich, aber noch leicht bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Füllung etwas abkühlen lassen. Jeweils etwa 2 Esslöffel davon in eine Ecke eines Teigblatts geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Ecke über die Füllung schlagen, die beiden Seiten einklappen und die Rolle fest aufrollen. Die letzte Kante mit etwas Wasser verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2 Tassen Pflanzenöl in einem tiefen Topf oder einer tiefen Pfanne auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Frühlingsrollen vorsichtig portionsweise, jeweils 3–4 Stück, in das heiße Öl geben und insgesamt etwa 3–4 Minuten von allen Seiten goldbraun frittieren. Auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
