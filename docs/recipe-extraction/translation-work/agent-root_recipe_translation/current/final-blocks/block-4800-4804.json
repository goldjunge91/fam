      "steps": [
        {
          "position": 0,
          "text": "Pflanzenöl in einem großen Topf oder einer Fritteuse auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Maisstärke, Salz und Ei in einer Schüssel verquirlen. Nach und nach Eiswasser einrühren, bis ein dünner, glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zucchini, Süßkartoffel und Karotte in 1/4 Zoll dicke Scheiben schneiden. Den Brokkoli in Röschen teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Gemüse vollständig in den Teig tauchen und vorsichtig in das heiße Öl geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2–3 Minuten goldbraun und knusprig frittieren, dabei einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einer Schaumkelle herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit Sojasauce zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
