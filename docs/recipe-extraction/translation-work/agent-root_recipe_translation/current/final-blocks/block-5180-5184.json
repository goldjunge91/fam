      "steps": [
        {
          "position": 0,
          "text": "Lege das Rinderfilet für 30-40 Minuten ins Gefrierfach, bis es teilweise angefroren und leichter in dünne Scheiben zu schneiden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide das Rindfleisch mit einem sehr scharfen Messer oder einer Aufschnittmaschine in hauchdünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ordne die Scheiben auf einem gekühlten Teller in einer Lage an und lasse sie bei Bedarf leicht überlappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Beträufle sie mit nativem Olivenöl extra und Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Kapern über dem Rindfleisch und würze es mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hoble mit einem Gemüseschäler oder scharfen Messer dünne Stücke Parmigiano-Reggiano über den Belag.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es sofort auf einem Bett aus frischem Rucola.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
