      "steps": [
        {
          "position": 0,
          "text": "Heize den Grill auf mittelhohe Hitze und den Ofen auf 400°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Paprika in große Stücke und die Zucchini in Scheiben; vermenge sie mit dem Brokkoli, 3 tbsp Olivenöl, Salz, Pfeffer und Knoblauchpulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verteile das Gemüse auf einem Backblech und röste es 25-30 Minuten, bis es goldbraun und weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tupfe die Hähnchenbrust trocken und bestreiche sie mit dem restlichen Olivenöl; würze sie mit Salz, Pfeffer und Paprika.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Hähnchen auf den heißen Grill und grille es 6-7 Minuten pro Seite, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass das Hähnchen 5 Minuten ruhen und schneide es dann nach Wunsch in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Presse frischen Zitronensaft über Hähnchen und Gemüse und serviere beides zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
