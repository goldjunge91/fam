      "steps": [
        {
          "position": 0,
          "text": "Heize den Grill auf mittelhohe Hitze vor (etwa 375-400°F) oder erhitze eine Grillpfanne auf dem Herd bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe die Lachsfilets trocken und bestreiche beide Seiten mit Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze den Lachs mit Salz, Pfeffer, gehacktem Knoblauch und der Hälfte des frischen Dills.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege den Lachs mit der Hautseite nach oben auf den Grill und grille ihn 6 Minuten, ohne ihn zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Wende den Lachs und grille ihn weitere 4-5 Minuten, bis sich das Fleisch leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege ihn auf einen Teller und presse frischen Zitronensaft über jedes Filet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere ihn mit dem restlichen frischen Dill und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
