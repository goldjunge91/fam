      "steps": [
        {
          "position": 0,
          "text": "Erhitze 3 cups Öl in einem tiefen Topf oder einer Fritteuse auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Dashi, Sojasauce und Mirin in einer kleinen Schüssel für die Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mehl, Maisstärke und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle in einer weiteren Schüssel das Eigelb mit Eiswasser, bis alles vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die flüssigen Zutaten zu den trockenen Zutaten und rühre vorsichtig, bis alles gerade eben vermischt ist; der Teig sollte noch leicht klumpig sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tupfe die Garnelen trocken und tauche sie vollständig in den Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Garnelen vorsichtig in das heiße Öl und frittiere sie portionsweise 2-3 Minuten, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass sie auf Küchenpapier abtropfen und serviere sie sofort mit der Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
