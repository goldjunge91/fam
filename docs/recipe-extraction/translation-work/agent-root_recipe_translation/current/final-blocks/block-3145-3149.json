      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375°F vor und koche Makkaroni nach Packungsanweisung. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem Topf bei mittlerer Hitze und rühre Mehl zu einer Mehlschwitze ein. Gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße nach und nach unter ständigem Rühren Milch dazu, damit keine Klümpchen entstehen. Koche die Sauce etwa 5 Minuten, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Topf vom Herd, rühre Cheddar und Gruyère ein, bis sie geschmolzen sind, und würze mit Salz, Pfeffer und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe gekochte Makkaroni unter die Käsesauce und fülle alles in eine gebutterte Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische Panko-Paniermehl mit 1 EL geschmolzener Butter und streue es gleichmäßig darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Auflauf 20-25 Minuten, bis er goldbraun ist und an den Rändern blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
