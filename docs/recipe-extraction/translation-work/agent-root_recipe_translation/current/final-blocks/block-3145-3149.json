      "steps": [
        {
          "position": 0,
          "text": "Spüle Reis unter kaltem Wasser ab, bis das Wasser klar bleibt, und gieße ihn dann gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und brate Zwiebel etwa 3 Minuten weich an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Karotten dazu und gare sie weitere 2 Minuten. Rühre dann Reis ein und röste ihn 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Brühe dazu, gib Zimtstange und Lorbeerblatt hinein und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf fest ab und lasse alles 15 Minuten köcheln, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Topf vom Herd und lasse alles zugedeckt 5 Minuten stehen. Lockere den Reis dann mit einer Gabel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Rosinen und Nüsse ein, würze mit Salz und Pfeffer und serviere den Pilaw.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
