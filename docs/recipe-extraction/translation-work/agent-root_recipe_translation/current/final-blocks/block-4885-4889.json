      "steps": [
        {
          "position": 0,
          "text": "2 EL Butter in einem großen Topf schmelzen und Schalotten sowie Knoblauch bei mittlerer Hitze 2 Minuten anschwitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weißwein hinzufügen und etwa 3 Minuten köcheln lassen, bis die Flüssigkeit auf die Hälfte reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Garnelen, Jakobsmuscheln und Fisch hinzufügen und 4–5 Minuten sanft pochieren, bis alles gerade gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sahne und Zitronensaft einrühren, mit Salz und Pfeffer würzen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Meeresfrüchtemischung in eine Gratinform geben und mit geriebenem Gruyère belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restlichen 2 EL Butter schmelzen und mit den Semmelbröseln vermengen. Über den Käse streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400 °F 12–15 Minuten backen, bis die Oberfläche goldbraun ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
