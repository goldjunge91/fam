      "steps": [
        {
          "position": 0,
          "text": "Butter und Olivenöl in einem großen Topf bei mittlerer Hitze schmelzen und die geschnittenen Zwiebeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Zwiebeln 25–30 Minuten unter häufigem Rühren braten, bis sie tief karamellisiert und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weißwein hinzufügen und die Bratrückstände vom Topfboden lösen. Dann 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe, Lorbeerblatt und Thymianzweig hinzufügen, mit Salz und Pfeffer würzen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Baguettescheiben im Toaster oder Backofen goldbraun rösten. Je eine Scheibe auf den Boden einer ofenfesten Schüssel legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die heiße Zwiebelsuppe in die Schalen über das Brot schöpfen und mit geriebenem Gruyère belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "2–3 Minuten unter dem Grill überbacken, bis der Käse geschmolzen ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
