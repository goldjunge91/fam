      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie die geräucherten Wurststücke in 1/2 Zoll dicke Münzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Paprika und Zwiebeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Gemüse 5–7 Minuten kochen, bis es weich ist, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehackten Knoblauch hinzufügen und noch 1 Minute kochen, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Wurstscheiben in die Pfanne geben und 5 Minuten braten, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "BBQ-Sauce, Apfelsaft, braunen Zucker, schwarzen Pfeffer und Salz in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Sauce über die Wurst und das Gemüse gießen und 10-12 Minuten köcheln lassen, bis die Sauce leicht einkocht und karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß über Reis oder mit Maisbrot als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
