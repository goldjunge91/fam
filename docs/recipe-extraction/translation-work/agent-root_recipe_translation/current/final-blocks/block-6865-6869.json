      "steps": [
        {
          "position": 0,
          "text": "BBQ-Sauce in einer großen Pfanne bei mittlerer Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geben Sie das geschnittene Rinderbrust in die Soße und rühren Sie es vorsichtig etwa 5–7 Minuten lang um, bis es durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mayonnaise und Senf vermischen und auf 4 Brotscheiben verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gurken und Zwiebeln auf die Senf-Mayo-Mischung schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die restlichen 4 Brotscheiben leicht einfetten und in einer separaten Pfanne goldbraun rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie mit einem Schaumlöffel eine großzügige Portion heißes Rinderbrust auf die Gurken und Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Etwas mehr Soße aus der Pfanne über das Rinderbrust träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit der gerösteten Butterbrotscheibe belegen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
