      "steps": [
        {
          "position": 0,
          "text": "Paprika, braunen Zucker, Knoblauchpulver, schwarzen Pfeffer, Zwiebelpulver und Cayennepfeffer in einer Schüssel vermischen, um eine Gewürzmischung herzustellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rinderbrust trocken tupfen und von allen Seiten großzügig trockenreiben, dabei fest andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 300 °F vor und legen Sie das Rinderbrust mit der Fettseite nach oben in eine große Bratpfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rinderbrühe, Apfelessig und Worcestershire-Sauce verrühren und dann um die Rinderbrust gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decken Sie die Pfanne fest mit Folie ab und schmoren Sie sie 4 Stunden lang, wobei Sie sie nach der Hälfte der Zeit einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Entfernen Sie die Folie, erhöhen Sie die Hitze auf 350 °F und garen Sie das Fleisch ohne Deckel noch 1 Stunde lang, bis es gabelweich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lassen Sie es 15 Minuten ruhen, bevor Sie es gegen die Faser aufschneiden und mit Bratensaft servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
