      "steps": [
        {
          "position": 0,
          "text": "Braunen Zucker, Paprika, Knoblauchpulver, schwarzen Pfeffer und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reiben Sie die Gewürzmischung innen und außen über das ganze Hähnchen und achten Sie dabei besonders auf die Haut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heizen Sie den Ofen auf 375 °F vor und legen Sie das Hähnchen mit der Brustseite nach oben auf einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 Stunde und 15 Minuten rösten, bis die Innentemperatur an der dicksten Stelle des Oberschenkels 165 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während der letzten 20 Minuten Butter, Ketchup, Apfelessig und Honig vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Während der letzten 20 Minuten des Garvorgangs das Huhn zweimal mit der Soße bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Schnitzen 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Servieren Sie das geschnitzte Hähnchen mit zusätzlicher Soße als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
