      "steps": [
        {
          "position": 0,
          "text": "Ritze die Haut der Entenbrust rautenförmig ein und würze sie großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Entenbrust mit der Hautseite nach unten in einer heißen Pfanne 3 Minuten an, bis das Fett ausgelassen und die Haut goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Honig und Orangensaft zu einer Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Räucherofen mit Kirschholzspänen auf 200°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Entenbrust mit der Hautseite nach oben auf den Rost und räuchere sie 45 bis 60 Minuten, bis die Kerntemperatur 130°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche die Ente während der letzten 15 Minuten des Räucherns mit der Glasur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Ente aus dem Räucherofen, decke sie locker mit Folie ab und lasse sie vor dem Aufschneiden 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
