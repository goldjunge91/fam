      "steps": [
        {
          "position": 0,
          "text": "Tupfe das Hähnchen trocken und vermische Paprikapulver, Knoblauchpulver, Zwiebelpulver, Pfeffer und Salz zu einer Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe das Hähnchen innen und außen damit ein und fülle die Bauchhöhle mit Zitronenhälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schiebe Butter unter die Haut der Hähnchenbrust.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Räucherofen mit Eichenholzspänen und einer Wasserschale auf 225°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Hähnchen mit der Brustseite nach oben auf den Rost und räuchere es 2.5 bis 3 Stunden, bis die Kerntemperatur an der Keule 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Hähnchen aus dem Räucherofen, decke es locker mit Folie ab und lasse es vor dem Tranchieren 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
