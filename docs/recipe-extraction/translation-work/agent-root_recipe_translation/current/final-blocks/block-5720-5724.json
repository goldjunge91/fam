      "steps": [
        {
          "position": 0,
          "text": "Öffne die Austern vorsichtig, indem du ein Austernmesser am Scharnier ansetzt und drehst, bis sich die Schale öffnet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Butter, gehackten Knoblauch, Petersilie, Zitronensaft und Pfeffer zu einer Kräuterbutter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib eine kleine Portion Kräuterbutter auf jede Auster.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Räucherofen mit Eichenholzspänen auf 150°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Austernschalen auf den Rost und räuchere sie 15 bis 20 Minuten, bis die Austern heiß und leicht fest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Austern vorsichtig aus dem Räucherofen und serviere sie sofort mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
