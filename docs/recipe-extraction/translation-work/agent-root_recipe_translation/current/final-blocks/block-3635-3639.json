      "steps": [
        {
          "position": 0,
          "text": "Vermische warmes Wasser, Hefe und 1 tbsp Mehl und lasse die Mischung 10 Minuten stehen, bis sie schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische restliches Mehl und Salz, gib dann Hefemischung und 2 tbsp Olivenöl dazu und knete alles zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig in einer geölten Schüssel 45 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste währenddessen geschnittene Zwiebeln in 2 tbsp Olivenöl goldbraun. Gib Tomaten aus der Dose dazu und lasse alles 15 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 425°F vor und öle eine 9x13 große Backform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Drücke den Teig in die vorbereitete Form und forme einen dicken Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verstreiche Tomaten-Zwiebel-Sauce auf dem Teig, verteile Sardellen darauf und streue Käse und Semmelbrösel darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe alles 20-25 Minuten, bis der Rand goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
