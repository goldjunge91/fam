      ],
      "steps": [
        {
          "position": 0,
          "text": "Erhitze 4 cups Wasser in einem großen Topf bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Kichererbsenmehl langsam und unter ständigem Rühren ein, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salz, schwarzen Pfeffer und Olivenöl dazu und rühre weiter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche alles 20-25 Minuten unter häufigem Rühren, bis die Mischung dick ist und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Mischung auf ein nasses, mit Backpapier ausgelegtes Blech und verstreiche sie 1/4-inch dick. Lasse sie vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneide die abgekühlte Masse in 2-inch große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Frittieröl auf 350°F und frittiere Panelle etwa 2 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
