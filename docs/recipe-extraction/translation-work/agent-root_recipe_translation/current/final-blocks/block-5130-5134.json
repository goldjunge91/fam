      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze und brate das Rinderhackfleisch 5-7 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebel und hacke den Knoblauch. Gib beides in den Topf und gare es 3 Minuten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark und Chilipulver ein und gare alles 1 Minute, damit die Gewürze ihr Aroma entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Dosentomaten samt Saft dazu. Lass beide Dosen Bohnen abtropfen, spüle sie ab und gib sie ebenfalls in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Kreuzkümmel ein und bringe das Chili zum Köcheln. Reduziere dann die Hitze und lass es ohne Deckel 25-30 Minuten köcheln. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke das Chili mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es heiß in Schüsseln, nach Wunsch mit geriebenem Käse oder saurer Sahne garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
