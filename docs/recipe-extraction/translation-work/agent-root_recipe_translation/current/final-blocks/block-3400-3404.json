      "steps": [
        {
          "position": 0,
          "text": "Vermische Senfpaste, Ingwer, grüne Chilis, Kokosnuss, Kurkuma, Salz und Senföl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste die Bananenblätter kurz über einer Flamme an, damit sie biegsam werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege jeweils ein Fischfilet in die Mitte eines Bananenblatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Senf-Kokos-Mischung großzügig auf jedem Fischfilet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage das Bananenblatt zu einem festen Päckchen um den Fisch und stecke die Ränder darunter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer großen Pfanne oder auf einer Grillplatte und lege die Päckchen mit der Naht nach unten hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare sie je Seite 10-12 Minuten, bis der Fisch gar ist. Öffne die Päckchen vorsichtig und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
