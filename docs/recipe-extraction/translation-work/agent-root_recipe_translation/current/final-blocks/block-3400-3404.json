      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze und brate die Entenbrust mit der Hautseite nach unten 4 Minuten an, bis sie gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wende die Ente und brate die andere Seite 3 Minuten an. Nimm sie heraus und schneide sie in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate im selben Topf gehackten Ingwer, zerdrückten Knoblauch und getrocknete Chilis 1 Minute, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sojasauce, Essig, Zucker, Sternanis und Wasser hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Entenstücke zurück in den Topf, bringe alles zum Kochen und lasse es ohne Deckel bei reduzierter Hitze 25 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre gelegentlich um, bis die Sauce eindickt und die Ente zart ist. Heiß mit gedämpftem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
