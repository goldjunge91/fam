      "steps": [
        {
          "position": 0,
          "text": "Lege die Fischfilets nebeneinander auf ein großes Stück Folie und streue Ingwer, Knoblauch, Chili und Limettenschale darüber. Beträufle sie mit Limettensaft und verteile Pak-Choi-Stücke um und auf dem Fisch. Gieße Sojasoße über den Pak Choi und verschließe die Folie locker zu einem Päckchen. Lasse oben Platz, damit der Dampf während des Garens zirkulieren kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dämpfe den Fisch 15 Minuten. (Falls du keinen Dämpfeinsatz hast, lege das Päckchen auf einen hitzebeständigen Teller über einen Topf mit sanft köchelndem Wasser, decke ihn ab und dämpfe den Fisch.)",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
