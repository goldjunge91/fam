      "steps": [
        {
          "position": 0,
          "text": "Koche die Nudeln nach Packungsanweisung. Schrecke sie mit kaltem Wasser ab und lasse sie gut abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Brühe in einen großen Topf und rühre Currypaste, Limettenblätter, Fischsoße und 250ml kaltes Wasser ein. Bringe alles zum Köcheln und gare es 5 mins.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide den Fisch in etwa 3cm große Würfel und gib sie in den Topf. Bringe alles erneut zum Köcheln und gare den Fisch ohne Deckel 2 mins.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Nudeln, Garnelen und Pak Choi ein und lasse alles 2-3 mins köcheln, bis Fisch und Garnelen gerade gar sind. In Schüsseln servieren und mit Koriander bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
