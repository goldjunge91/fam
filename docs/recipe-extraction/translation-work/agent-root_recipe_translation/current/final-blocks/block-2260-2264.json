      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 200C/400F/Gasstufe 6 (180C Umluft) vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die Kartoffeln in einen Topf mit kaltem Salzwasser. Bringe das Wasser zum Kochen und lasse die Kartoffeln köcheln, bis sie ganz weich sind. Gieße sie gut ab und zerdrücke sie mit Butter und Milch. Gib Pfeffer hinzu und probiere, ob die Würzung stimmt. Bei Bedarf Salz und mehr Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Für die Fischfüllung schmilz Butter in einem Topf, gib Lauch hinzu und rühre ihn über der Hitze um. Decke den Topf ab und lasse den Lauch 10 Minuten sanft köcheln, bis er weich ist. Miss Mehl in eine kleine Schüssel ab. Gib Wein dazu und verrühre alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Milch zum Lauch und bringe die Mischung zum Kochen. Rühre die Weinmischung ein und koche unter kräftigem Rühren, bis die Soße eindickt. Würze, gib Petersilie und Fisch dazu und rühre alles zwei Minuten über der Hitze um. Fülle die Mischung in eine ofenfeste Auflaufform und verteile die Eier darüber. Abkühlen lassen, bis die Füllung fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile Kartoffelstampf über der Fischmischung und ziehe mit einer Gabel ein Muster hinein. Mit Käse bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Pastete 30-40 Minuten, bis die Oberfläche leicht goldbraun ist und die Ränder blubbern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
