      "steps": [
        {
          "position": 0,
          "text": "Koche Kichererbsenhälften mit Wasser und einer Prise Salz 15-20 Minuten sehr weich und gieße sie dann gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerdrücke die gekochte Hülsenfrüchte zu einer glatten Paste und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zerkleinere Palmzucker und Kardamomkapseln zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische die zerdrückten Hülsenfrüchte mit Palmzucker, 1 Esslöffel Ghee und Kurkumapulver zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Knete Mehl mit Wasser, Salz und 1 Esslöffel Ghee zu einem glatten, weichen Teig und lass ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teile den Teig in 6 Kugeln. Rolle jede zwischen Frischhaltefolie sehr dünn aus und gib die Füllung in die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verschließe die Ränder vorsichtig und rolle den Fladen sanft aus, damit sich die Füllung verteilt, ohne dass der Teig reißt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze eine gusseiserne Platte oder Tawa bei mittlerer Hitze und backe die Poli pro Seite 2-3 Minuten, bis hellbraune Stellen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bestreiche sie beim Backen mit Ghee und serviere sie heiß, gefaltet oder aufgerollt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
