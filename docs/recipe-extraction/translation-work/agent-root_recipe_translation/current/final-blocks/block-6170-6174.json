      "steps": [
        {
          "position": 0,
          "text": "Koche die Kartoffeln weich, schäle sie und zerdrücke sie grob, sodass noch Stücke bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib grüne Chilischoten, Ingwer, Salz, Pfeffer und Kurkuma zu den Kartoffeln und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Forme aus der Masse 8-10 ovale oder runde Bällchen von etwa 2 Zoll Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Kichererbsenmehl, Reismehl und Salz mit Wasser zu einem glatten, dickflüssigen Teig, der gut haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tauche jedes Kartoffelbällchen in den Teig, überziehe es gleichmäßig damit und gib es vorsichtig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Bällchen portionsweise 3-4 Minuten, bis sie rundherum goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus, lass sie auf Küchenpapier abtropfen und serviere sie heiß mit trockenem Knoblauch-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
