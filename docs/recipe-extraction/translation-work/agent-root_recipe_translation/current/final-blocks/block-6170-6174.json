      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kochbananen, schneide sie längs in dünne Streifen und weiche sie 10 Minuten in Salzwasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße die Streifen ab und tupfe sie mit Küchenpapier gründlich trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Kokosöl in einer großen Pfanne bei mittlerer Hitze. Gib Kichererbsenhälften, Urdbohnen, rote Chilischoten und Curryblätter dazu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kochbananenstreifen und Kurkumapulver dazu und rühre 8-10 Minuten ständig um, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib geraspelte Kokosnuss und Salz dazu und gare alles unter Rühren weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schmecke ab, gib das Gericht auf eine Servierplatte und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
