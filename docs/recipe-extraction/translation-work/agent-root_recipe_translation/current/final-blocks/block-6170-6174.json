      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete rote Chilischoten, Koriandersamen, Kreuzkümmelsamen und Pfefferkörner 2 Minuten in einer trockenen Pfanne an, bis sie duften. Mahle sie dann mit 2 Esslöffeln Wasser zu einer groben Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Kokosöl in einem schweren Topf und brate geschnittene Zwiebeln goldbraun an. Gib Ingwer-Knoblauch-Paste dazu und gare sie 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Schweinefleischstücke dazu und brate sie bei hoher Hitze unter Rühren 5 Minuten an, damit sie rundherum Farbe bekommen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre die gemahlene Gewürzpaste ein und gare sie 2 Minuten, bis der rohe Geruch verschwunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte Tomaten und Salz dazu und gare alles 3 Minuten, bis die Tomaten weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Wasser dazu und bringe alles zum Kochen. Reduziere dann die Hitze auf niedrig, decke den Topf ab und lass alles 25-30 Minuten köcheln, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Deckel ab und lass alles weitere 5 Minuten köcheln, damit die Sauce etwas eindickt und das Fleisch überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke ab, würze bei Bedarf mit Salz und Gewürzen nach und serviere das Curry heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
