      "steps": [
        {
          "position": 0,
          "text": "Weiche Reis, Urdbohnen und Bockshornkleesamen zusammen 4 Stunden oder über Nacht in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße alles gut ab und mahle es in einem Nassmahlwerk oder Mixer zu einem glatten Teig. Gib nach und nach Wasser dazu, bis der Teig dickflüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Salz, zerstoßene Pfefferkörner und Kreuzkümmelsamen zum Teig und vermenge alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass den Teig 30 Minuten bei Zimmertemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine Appam-Pfanne oder beschichtete Pfanne bei mittlerer Hitze und fette die Mulden oder den Boden leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Mulden zu drei Vierteln mit Teig und gare die Appams zugedeckt 2-3 Minuten, bis die Unterseite goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende sie vorsichtig und gare die andere Seite 1-2 Minuten, bis sie leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie heraus und serviere sie warm mit Sambar, Chutney oder Curry.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
