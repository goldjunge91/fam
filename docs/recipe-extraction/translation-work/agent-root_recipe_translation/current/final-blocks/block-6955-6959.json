      "steps": [
        {
          "position": 0,
          "text": "Den Stängelkohl putzen und waschen, dann in 2 Zoll große Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Broccoli Rabe in Salzwasser 3-4 Minuten kochen, bis es leicht weich ist, dann abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitzen Sie 2 EL Olivenöl in einer Pfanne bei mittlerer bis hoher Hitze und braten Sie die Schweinekoteletts 3–4 Minuten pro Seite, bis sie gar sind. Mit Salz und Pfeffer würzen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In derselben Pfanne das restliche Olivenöl erhitzen und den gehackten Knoblauch 30 Sekunden lang anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Broccoli Rabe zurück in die Pfanne geben und 2 Minuten kochen lassen, dabei gelegentlich umrühren; Mit roten Paprikaflocken, Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Italienische Brötchen aufteilen und leicht toasten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf jedes Brötchen eine Scheibe Provolone schichten, Schweinekotelett und dann Broccoli Rabe darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
