      "steps": [
        {
          "position": 0,
          "text": "Milch in einem großen Topf unter gelegentlichem Rühren auf 180 °F erhitzen, damit sie nicht anbrennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vom Herd nehmen und unter leichtem Rühren langsam Essig hinzufügen, bis sich der Quark von der Molke trennt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "5 Minuten ruhen lassen, dann durch ein Käsetuch gießen, um den Quark aufzufangen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Quark unter kaltem Wasser abspülen und in ein feinmaschiges Sieb geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Quark salzen und vorsichtig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitzen Sie Bananenblätter über einer Flamme, um sie biegsam zu machen, und legen Sie dann eine Form oder Tasse aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Füllen Sie die mit Bananenblättern ausgelegte Form mit Quark und falten Sie die Blätter darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mindestens 30 Minuten im Kühlschrank lagern und mit Honig beträufelt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
