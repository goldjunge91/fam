          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomatensauce hinzufügen und 2 Minuten kochen lassen, dabei häufig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit der Brühe aufgießen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die in Stücke geschnittenen Fischfilets dazugeben und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Garnelen hinzufügen und 3 Minuten köcheln lassen, bis sie anfangen, rosa zu werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Muscheln und Venusmuscheln hinzufügen, abdecken und 5 Minuten kochen lassen, bis sich die Muscheln öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entsorgen Sie alle ungeöffneten Schalen und rühren Sie Koriander und Limettensaft unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Salz und Pfeffer würzen und heiß in Schüsseln servieren.",
