      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und braunen Zucker unter Rühren hinzufügen, bis er dunkelbraun und karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Schweinefleischwürfel portionsweise im karamellisierten Zucker pro Portion von allen Seiten 3–4 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sobald das gesamte Schweinefleisch gebräunt ist, fügen Sie gewürfelte Zwiebeln und Knoblauch hinzu und braten Sie es 2 Minuten lang an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomatenmark, grüne Gewürze und Thymian einrühren und 1 Minute kochen lassen, um die Aromen zu verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Rinderbrühe aufgießen und bei Bedarf scharfe Paprika hinzufügen, dann zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe, decken Sie es mit einem Deckel ab und lassen Sie es 45 Minuten köcheln, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit Roti, Reis oder Dhal und Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
