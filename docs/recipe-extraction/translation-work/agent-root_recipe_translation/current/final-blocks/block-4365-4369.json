      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 400°F vorheizen und ganze Rote Bete in Alufolie wickeln; 35-40 Minuten rösten, bis sie beim Einstechen weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Rote Bete abkühlen lassen, dann unter fließendem Wasser mit den Fingern oder Küchenpapier schälen und in Spalten schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "0.5 Tasse Walnüsse in einer trockenen Pfanne bei mittlerer Hitze 3-4 Minuten rösten, bis sie duften, dann zum Abkühlen beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3 EL Olivenöl, 1.5 EL Balsamico-Essig, 0.5 TL Senf, 0.5 TL Salz und 0.25 TL Pfeffer in einer kleinen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "4 Tassen gemischten Salat mit der Hälfte der Vinaigrette vermengen und auf Servierteller verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rote-Bete-Spalten und geschnittene rote Zwiebel auf dem Salat anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "4 Unzen Ziegenkäse zerbröseln und mit Walnüssen über die Salate verteilen, dann mit der restlichen Vinaigrette beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
