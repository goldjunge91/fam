      "steps": [
        {
          "position": 0,
          "text": "Handschuhe tragen, Brennnesseln gründlich abspülen und grob hacken, dicke Stiele entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 EL Butter in einem großen Topf bei mittlerer Hitze schmelzen und gewürfelte Zwiebel etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 gewürfelte mittelgroße Kartoffel und 4 Tassen Gemüsebrühe hinzufügen, zum Kochen bringen und dann 10 Minuten köcheln lassen, bis die Kartoffel weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3 Tassen gehackte Brennnesseln unterrühren und 2 Minuten köcheln lassen, bis sie zusammenfallen und leuchtend grün sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Suppe mit einem Stabmixer pürieren oder portionsweise in einen Mixer geben und glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "0.5 Tasse Schlagsahne, 0.5 TL Salz, 0.25 TL Pfeffer und eine Prise Muskatnuss unterrühren und ohne zu kochen erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In Schüsseln schöpfen und jede Portion mit einem Klecks saurer Sahne und etwas frisch gemahlenem schwarzem Pfeffer garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
