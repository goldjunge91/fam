      "steps": [
        {
          "position": 0,
          "text": "3 EL gemahlenen Kaffee, 1 EL braunen Zucker, 1.5 TL Salz, 0.75 TL Pfeffer und 0.5 TL Knoblauchpulver in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rindfleisch mit Küchenpapier trocken tupfen und die Kaffeemischung gleichmäßig auf allen Seiten einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 EL Olivenöl in einer gusseisernen Pfanne bei mittelhoher Hitze erhitzen, bis es gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Steak 3-4 Minuten pro Seite scharf anbraten, bis sich eine Kruste bildet, dann die Hitze auf mittlere Stufe reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2 EL Butter und 2 Rosmarinzweige hinzufügen, die Pfanne neigen und das Steak 2 Minuten mit der aufschäumenden Butter übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Steak auf ein Schneidebrett legen und 5 Minuten ruhen lassen, während 0.5 Tasse Rinderbrühe in die Pfanne gegossen und der Bratensatz gelöst wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Pfannensauce 2 Minuten köcheln lassen, dann über das aufgeschnittene Steak gießen und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
