      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350°F vorheizen und 4 Tassen Brombeeren in eine 9x13-Backform geben, mit 0.25 Tasse Zucker und 1 TL Zitronenabrieb bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einer Schüssel 1.5 Tassen Mehl, 1.5 TL Backpulver, 0.25 TL Salz und 0.25 Tasse Zucker verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "6 EL Butter schmelzen und 0.75 Tasse Milch und 0.5 TL Vanille unterrühren, bis alles verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die flüssigen Zutaten zu den trockenen geben und nur kurz verrühren, sodass ein dicker Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Löffelweise Teig auf die Brombeeren geben, vorsichtig verteilen und einige Beeren sichtbar lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "3 EL braunen Zucker gleichmäßig über den Teig streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "35-40 Minuten backen, bis der Belag goldbraun ist und ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem warmen Servieren 10 Minuten abkühlen lassen, optional mit Vanilleeis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
