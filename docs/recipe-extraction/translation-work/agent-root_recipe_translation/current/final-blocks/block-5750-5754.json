      "steps": [
        {
          "position": 0,
          "text": "Löse das Salz in 4 Tassen Wasser auf und stelle eine Lake her. Lege den Hering 30 Minuten hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Hering aus der Lake und tupfe ihn trocken. Schneide jeden Fisch entlang der Mittelgräte auf, ohne die Hälften zu trennen, und klappe ihn auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fixiere jeden aufgeklappten Hering mit Holzzahnstochern, damit er beim Räuchern seine Form behält.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Räuchere den Hering bei 80°C (175°F) 30-35 Minuten mit Eichenholz, bis das Fleisch fest und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Entferne die Zahnstocher und lege den Hering warm auf eine Servierplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib auf jeden Hering ein kleines Stück Butter, streue frische Petersilie darüber und beträufle ihn mit Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere ihn sofort mit geröstetem Brot und nach Wunsch mit einem pochierten Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
