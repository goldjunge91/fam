      "steps": [
        {
          "position": 0,
          "text": "Nimm die Pute 2 Stunden vor dem Räuchern aus dem Kühlschrank und tupfe sie innen und außen vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Pfeffer, Paprikapulver, Knoblauchpulver und Zwiebelpulver. Reibe die Mischung großzügig unter die Haut und in die Bauchhöhle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Pute mit der Brust nach oben auf den Rost des Räucherofens und räuchere sie bei 225°F mit Eichenholz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Räuchere sie etwa 3-4 Stunden (13-15 Minuten pro Pfund) und besprühe sie alle 45 Minuten mit einer Mischung aus Apfelessig und Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Prüfe die Temperatur an der dicksten Stelle der Keule. Nimm die Pute heraus, sobald die Kerntemperatur 165°F erreicht hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Pute locker mit Folie ab und lasse sie vor dem Tranchieren 20-30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tranchiere die Pute in Brust, Keulen und Schenkel und serviere sie mit dem Bratensaft als Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
