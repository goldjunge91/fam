      "steps": [
        {
          "position": 0,
          "text": "Schneide überschüssiges Fett vom Brustspitzenstück ab, bis es gleichmäßig dick ist, und tupfe es mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Pfeffer, Paprikapulver, Knoblauchpulver und 1 Esslöffel braunen Zucker und verteile die Mischung großzügig auf allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Räuchere das Brustspitzenstück bei 225°F mit Hickoryholz 3-3.5 Stunden, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Fleisch aus dem Räucherofen und schneide es in 1-Zoll große Würfel. Entferne sehr fettige Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge die Würfel in einer Einweg-Aluminiumschale mit Barbecue-Soße, Butter und dem restlichen braunen Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle die Schale zurück in den Räucherofen bei 275°F und räuchere sie 45-60 Minuten. Rühre alle 15 Minuten um, bis die Außenseite karamellisiert und klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Burnt Ends aus dem Räucherofen, sobald die Kruste dunkel und knusprig ist. Serviere sie heiß als kleinen Snack oder als Füllung für Sandwiches.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
