      "steps": [
        {
          "position": 0,
          "text": "Schneide den ausgenommenen Aal in 6-Zoll lange Stücke und tupfe sie mit Küchenpapier vollständig trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, braunen Zucker, Pfeffer und zerstoßene Wacholderbeeren und reibe die Mischung auf alle Aalstücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege die Stücke auf ein Gitter und lasse sie 2-3 Stunden unbedeckt im Kühlschrank liegen, bis ihre Oberfläche leicht klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Räuchere den Aal bei 160°F mit Eichenholz und Thymianzweigen 45-50 Minuten, bis das Fleisch undurchsichtig und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche den fertigen Aal noch warm dünn mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere ihn heiß oder auf Zimmertemperatur abgekühlt mit Roggenbrot und Meerrettichcreme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
