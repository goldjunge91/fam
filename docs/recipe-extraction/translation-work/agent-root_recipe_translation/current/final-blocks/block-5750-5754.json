      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische koscheres Salz, braunen Zucker, Pfeffer, Pökelsalz und Knoblauchpulver zu einer Pökelmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe die Mischung gründlich auf den ganzen Schweinebauch und wickle ihn anschließend fest in Frischhaltefolie ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege ihn für 5-7 Tage in den Kühlschrank. Wende den Schweinebauch alle 2 Tage und verteile dabei die ausgetretene Flüssigkeit erneut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Spüle den Schweinebauch unter kaltem Wasser ab, um die Pökelmischung zu entfernen. Tupfe ihn trocken und lege ihn auf ein Gitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse ihn 2-3 Stunden unbedeckt im Kühlschrank trocknen, bis sich eine trockene Haut auf der Oberfläche gebildet hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Räuchere den Schweinebauch bei 225°F mit Hickoryholz 90 Minuten und bestreiche ihn nach 45 Minuten mit Ahornsirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse ihn vollständig abkühlen, schneide ihn in ¼-Zoll dicke Streifen und brate sie in einer Pfanne knusprig oder friere sie für später ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
