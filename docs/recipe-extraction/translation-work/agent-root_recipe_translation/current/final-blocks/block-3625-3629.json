      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage in einer anderen Schüssel Eier mit Milch und Zucker gut auf. Gib sie zu den trockenen Zutaten und rühre, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Topf auf 350°F (175°C) und prüfe die Temperatur mit einem Thermometer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib löffelweise Teig ins heiße Öl, jeweils 4-5 Stück, und frittiere sie 1-2 Minuten pro Seite goldbraun. Lege sie dann auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische währenddessen Honig, Zimt und Piloncillo in einem kleinen Topf und erwärme alles bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Richte die frittierten Buñuelos auf einer Servierplatte an und beträufle sie großzügig mit warmem Honig-Zimt-Sirup.",
