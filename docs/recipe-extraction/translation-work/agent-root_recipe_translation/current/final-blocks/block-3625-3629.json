      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Pasilla-Chilischoten 1 Minute in einer trockenen Pfanne. Entferne Stiele und Kerne und weiche sie dann in 1 cup heißem Wasser 10 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere die weichen Chilischoten samt Einweichwasser mit Knoblauch und Zwiebel glatt und seihe die Mischung durch ein Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe Hühnerbrühe in einem großen Topf zum Kochen und rühre die abgesiebte Chilimischung gut ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchenbrust dazu und lasse alles 20 Minuten köcheln, bis das Fleisch gar ist. Nimm es heraus und zerpflücke es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das zerpflückte Hähnchen und Tomaten aus der Dose zurück in den Topf und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schöpfe die Suppe in Schalen und belege jede mit Avocadoscheiben, etwas Crema, Tortillachips, Koriander und einem Spritzer Limettensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
