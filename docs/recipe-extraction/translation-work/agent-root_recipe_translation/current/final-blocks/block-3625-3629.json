      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Maishülsen 20 Minuten in heißem Wasser ein, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste getrocknete Chilischoten leicht an, entferne Stiele und Kerne und weiche sie in 0.5 cup Brühe 10 Minuten ein. Püriere sie dann mit Knoblauch glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Schmalz mit einem elektrischen Mixer 5 Minuten luftig auf. Gib nach und nach Masa Harina mit Backpulver und Salz dazu und wechsle dabei mit Hühnerbrühe ab, bis ein leichter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verstreiche 2 tablespoons Masa auf der glatten Seite jeder eingeweichten Maishülse und lasse an allen Seiten einen Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermische zerpflücktes Hähnchen mit der pürierten Chilisauce und gib 1 EL davon in die Mitte jeder mit Masa bestrichenen Hülse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle die Hülse fest über die Füllung, klappe dann das spitze untere Ende um und lasse die Oberseite offen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle die Tamales mit der offenen Seite nach oben in einen Dämpftopf mit 2 inches Wasser unter dem Dämpfeinsatz. Decke sie mit zusätzlichen Maishülsen ab und dämpfe sie 45 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Prüfe den Garzustand, indem du eine Tamale herausnimmst. Die Masa sollte sich sauber von der Hülse lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
