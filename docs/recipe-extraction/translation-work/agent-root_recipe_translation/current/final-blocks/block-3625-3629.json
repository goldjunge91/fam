      "steps": [
        {
          "position": 0,
          "text": "Röste getrocknete Chilischoten in einer trockenen Pfanne 1 Minute pro Seite. Entferne Stiele und Kerne und weiche sie in 2 cups heißem Wasser 15 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Kreuzkümmelsamen und Zimtstange 30 Sekunden trocken in einer Pfanne, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere weiche Chilischoten samt Einweichwasser mit Knoblauch, Zwiebel, Tomaten und gerösteten Gewürzen vollständig glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einem großen Topf, seihe die Chilimischung vorsichtig ins heiße Öl und rühre 3 Minuten ständig, damit rohe Aromen verschwinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Hühnerbrühe zur Chilisauce und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Hähnchenschenkel in den Topf und lasse alles 35 Minuten köcheln, bis sie gar und zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und lasse alles weitere 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
