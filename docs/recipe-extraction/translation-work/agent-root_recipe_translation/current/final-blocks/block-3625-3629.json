      "steps": [
        {
          "position": 0,
          "text": "Erhitze Milch in einem großen Topf auf 90°F (32°C), gib langsam Essig dazu und rühre vorsichtig, bis sich erste Käsebruchstücke bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Mischung weiter auf 104°F (40°C) und rühre dabei 15 Minuten lang gelegentlich, bis sich Käsebruch und Molke klar getrennt haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße den Käsebruch in ein mit Käsetuch ausgelegtes Sieb und lasse ihn 10 Minuten abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Binde das Käsetuch zusammen und hänge es weitere 10 Minuten zum Abtropfen auf, bis der Käsebruch fester wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Käsebruch in eine mikrowellengeeignete Schüssel und erhitze ihn 1 Minute in der Mikrowelle. Gieße überschüssige Molke ab und erhitze ihn nochmals 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Knete und ziehe den warmen Käse, bis er glatt und glänzend wie Mozzarella wird. Gib dabei Salz und Oregano dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Forme den gezogenen Käse zu einer Kugel, lasse ihn leicht abkühlen, wickle ihn in Folie und stelle ihn kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere ihn bei Raumtemperatur mit in Öl sautierten Jalapeños und Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
