      "steps": [
        {
          "position": 0,
          "text": "2 Esslöffel Öl in einer Pfanne erhitzen und Schweinehack bei mittelhoher Hitze etwa 5 Minuten bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch hinzufügen und 30 Sekunden anbraten, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geschnittenen Kohl, gewürfelte Karotte, Sojasauce und Fischsauce hinzufügen und 3-4 Minuten unter Rühren braten, bis das Gemüse bissfest-zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vom Herd nehmen, geschnittene Frühlingszwiebel einrühren und die Füllung vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein Frühlingsrollenblatt mit einer Ecke zu dir zeigend auf eine ebene Fläche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2 Esslöffel Füllung in die Mitte geben, die untere Ecke über die Füllung falten, die Seiten einklappen und dann fest bis zur oberen Ecke aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "1 cup Öl auf 350°F erhitzen und Frühlingsrollen portionsweise 2-3 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und mit süßer Chilisauce oder Erdnusssauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
