      "steps": [
        {
          "position": 0,
          "text": "Tofublock in Küchenpapier wickeln und 10 Minuten zwischen zwei Tellern pressen, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gepressten Tofu in 1-inch große Würfel schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maisstärke, Mehl, Salz, Pfeffer und Knoblauchpulver in einer flachen Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jeden Tofuwürfel gleichmäßig in der Mehlmischung wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne oder einem Topf auf 350°F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tofuwürfel vorsichtig portionsweise hineingeben und je Portion 3-4 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und sofort mit süßer Chilisauce oder Sojasauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
