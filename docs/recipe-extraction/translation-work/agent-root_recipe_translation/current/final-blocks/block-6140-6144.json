      "steps": [
        {
          "position": 0,
          "text": "Wasche den Basmatireis und weiche ihn 15 Minuten ein. Gieße ihn anschließend ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Kartoffeln in kleine Würfel und hacke Zwiebeln und grüne Chilis fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Topf und gib die Senfkörner hinein. Röste sie, bis sie aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Curryblätter, Zwiebeln und grüne Chilis dazu und dünste alles, bis die Zwiebeln goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füge Kartoffelwürfel und Kurkuma hinzu, rühre gut um und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den abgetropften Reis in den Topf und rühre 2 Minuten ununterbrochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Wasser dazu, salze und bringe alles zum Kochen. Reduziere dann die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf ab und lasse alles 15–18 Minuten köcheln, bis Reis und Kartoffeln gar und das Wasser aufgenommen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
