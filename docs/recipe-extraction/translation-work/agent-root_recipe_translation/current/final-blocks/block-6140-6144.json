      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenschenkel in mundgerechte Stücke und blanchiere sie 3 Minuten in kochendem Wasser, um Verunreinigungen zu entfernen. Gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Schinken in dünne Scheiben, Karotten und Kartoffeln in mundgerechte Stücke und die Pilze in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schichte Hähnchenstücke, Schinken, Ingwerscheiben und Gemüse in einen speziellen Yunnan-Dampftopf oder einen abgedeckten Tontopf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 4 Tassen Wasser, Sojasauce und Reiswein in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verschließe den Topf fest und stelle ihn in einen größeren Topf mit kochendem Wasser, das bis zur halben Höhe des inneren Topfes reicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Dämpfe alles 35–40 Minuten, bis das Hähnchen durchgegart und das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm den Topf vorsichtig vom Herd und öffne den Deckel, damit der Dampf entweichen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Salz und Sesamöl, garniere mit Frühlingszwiebelringen und serviere das Gericht direkt aus dem Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
