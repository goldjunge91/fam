      "steps": [
        {
          "position": 0,
          "text": "Bringe die Brühe mit den Ingwerscheiben in einem großen Topf zum Kochen. Gib das dünn geschnittene Fleisch dazu und lasse es 5–7 Minuten köcheln, bis es gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche währenddessen die Reisnudeln in einem separaten Topf mit kochendem Wasser nach Packungsanweisung. Gieße sie ab und verteile sie auf zwei Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Sojasauce, weißen Pfeffer und Salz in die heiße Brühe und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die heiße Brühe mit dem gegarten Fleisch in die Schalen über die Nudeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneide Frühlingszwiebeln in Ringe und streue sie zusammen mit frischem Koriander über die Suppe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle jede Schale mit Sesamöl und serviere die Suppe sofort dampfend heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
