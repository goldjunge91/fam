      "steps": [
        {
          "position": 0,
          "text": "Wasche Reis und Linsen getrennt unter fließendem Wasser und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und gib die Senfkörner hinein. Röste sie, bis sie aufplatzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Curryblätter, gehackte Zwiebeln und grüne Chilis hinzu und dünste alles, bis die Zwiebeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge gewürfelte Tomate, Kurkuma und Salz hinzu und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die gewaschenen Linsen und den Reis in den Topf und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Wasser dazu und bringe alles zum Kochen. Reduziere dann die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke den Topf ab und lasse alles 18–20 Minuten köcheln, bis Linsen und Reis weich und das Wasser aufgenommen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lockere die Mischung vorsichtig mit einer Gabel auf und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
