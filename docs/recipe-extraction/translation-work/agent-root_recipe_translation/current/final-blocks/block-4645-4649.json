      "steps": [
        {
          "position": 0,
          "text": "Die Hähnchenbrüste auf eine gleichmäßige Dicke von etwa 1/4 Zoll klopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Mehl, die verquirlten Eier und das Paniermehl auf drei Schalen verteilen und jede Hähnchenbrust der Reihe nach darin wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer großen Pfanne erhitzen und das panierte Hähnchen 4-5 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Tomatensoße in einem Topf mit dem fein gehackten Knoblauch und Oregano 5 Minuten erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das gebratene Hähnchen auf ein Backblech legen und jeweils mit Tomatensoße und Mozzarella belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 400°F 8-10 Minuten backen, bis der Käse geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
