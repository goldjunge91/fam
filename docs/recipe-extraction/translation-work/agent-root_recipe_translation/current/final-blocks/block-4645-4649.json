      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter, Kalbfleisch und Leber in kleine Würfel schneiden und Schalotten und Knoblauch fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die gehackten Aromaten in einer Pfanne anbraten, bis sie duften, dann das Fleisch dazugeben und von allen Seiten bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Pfanne mit Weinbrand ablöschen, dabei die Röststoffe vom Boden lösen, dann Thymian und Lorbeerblatt dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung 20 Minuten köcheln lassen, bis sie durchgegart ist, dann die Sahne einrühren und vollständig abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Füllung auf eine mit etwas Blätterteig ausgelegte Terrinen- oder Kastenform verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit dem restlichen Teig bedecken, die Ränder durch kräftiges Andrücken verschließen und mit verquirltem Ei bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 45-50 Minuten backen, bis der Teig goldbraun ist und ein Fleischthermometer 165°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Aufschneiden und Servieren auf Zimmertemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
