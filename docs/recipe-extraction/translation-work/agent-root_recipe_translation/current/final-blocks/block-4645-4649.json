      "steps": [
        {
          "position": 0,
          "text": "Die Hähnchenbrüste 15 Minuten in Wasser pochieren, herausnehmen, abkühlen lassen und in mundgerechte Stücke zupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Butter in einem großen Topf schmelzen und die gewürfelte Zwiebel anbraten, bis sie glasig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Mehl unter ständigem Rühren einrühren, um eine Mehlschwitze herzustellen, und 1 Minute kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brühe und Sahne nach und nach unter Rühren hinzufügen, damit keine Klümpchen entstehen, und köcheln lassen, bis die Mischung eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das gezupfte Hähnchen, das Tiefkühlgemüse, den Thymian, Salz und Pfeffer einrühren und alles in eine Pastetenform geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Teig bedecken, die Ränder verschließen und Dampfschlitze einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400°F 25-30 Minuten backen, bis der Teig goldbraun ist und die Füllung an den Rändern blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
