      "steps": [
        {
          "position": 0,
          "text": "Die Schweineleber mit Schalotten und Knoblauch fein hacken, dann mit Schweinehackfleisch, Weinbrand, Thymian und den Gewürzen vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kalbfleisch oder Hähnchenbrust in kleine Stücke würfeln und zusammen mit den Pistazien unter die Farce heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Terrinenform mit Speckstreifen auslegen, sodass diese über die Ränder hängen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Terrine mit der Farce-Mischung füllen und jede Schicht fest andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Speckstreifen über die Oberseite schlagen, mit Alufolie abdecken und in ein Wasserbad stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 325°F 50-60 Minuten backen, bis die Kerntemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vollständig abkühlen lassen, dann über Nacht kalt stellen, bevor die Terrine aus der Form gelöst und in Scheiben geschnitten wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kalt mit knusprigem Brot und Cornichons servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
