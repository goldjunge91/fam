      "steps": [
        {
          "position": 0,
          "text": "Verquirle die Eier mit Salz, Pfeffer und einer Prise Muskatnuss in einer Schüssel, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 Esslöffel Butter in einer beschichteten Pfanne bei mittlerer Hitze und dünste die gehackte Zwiebel und den Knoblauch 1 Minute an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Spinat in die Pfanne und gare ihn etwa 2 Minuten, bis er zusammenfällt. Würze ihn leicht mit Salz und Pfeffer und stelle ihn dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den restlichen Esslöffel Butter in die Pfanne und erhitze sie bei mittelhoher Hitze, bis die Butter schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die verquirlten Eier hinein und lasse sie 2-3 Minuten ohne Rühren stocken, bis die Ränder fest werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe das bereits gestockte Ei vorsichtig zur Mitte und neige die Pfanne, damit noch flüssiges Ei an die Ränder läuft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wenn die Oberfläche noch leicht feucht ist, verteile den Spinat und den Käse auf einer Hälfte des Omeletts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Klappe das Omelett über der Füllung zusammen und schiebe es auf einen Servierteller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
