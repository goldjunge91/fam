      "steps": [
        {
          "position": 0,
          "text": "Spüle die Quinoa unter kaltem Wasser ab und koche sie etwa 15 Minuten in Hühnerbrühe nach Packungsanweisung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Hähnchenbrust auf beiden Seiten mit Salz, Pfeffer und Kreuzkümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 2 Esslöffel Olivenöl in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate das Hähnchen 6-7 Minuten pro Seite goldbraun, bis die Kerntemperatur 165°F erreicht. Nimm es heraus und lass es 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das restliche Olivenöl und den Knoblauch in dieselbe Pfanne und brate alles 30 Sekunden an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Quinoa, schwarze Bohnen und Mais ein und erhitze alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle die Quinoa-Mischung mit Limettensaft, bestreue sie mit Koriander und serviere das Hähnchen dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
