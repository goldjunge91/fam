      "steps": [
        {
          "position": 0,
          "text": "Schneide die Bagels waagerecht auf und röste sie im Toaster leicht an, bis sie warm sind, etwa 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bestreiche jede Bagelhälfte mit 2 Esslöffeln Frischkäse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege je 2 ounces Räucherlachs auf den Frischkäse jeder Bagelhälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Richte geschnittene Tomaten und Gurken neben den Bagels auf einer Servierplatte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib kleine Häufchen Kapern und geschnittene rote Zwiebel auf die Platte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Garniere alles mit frischem Dill und Zitronenspalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht sofort, damit sich alle nach Wunsch ihre Portion zusammenstellen können.",
