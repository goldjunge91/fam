      "steps": [
        {
          "position": 0,
          "text": "Brechbohnen waschen und schneiden. Mit Salzwasser in einen Topf geben und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bohnen etwa 10 Minuten oder bis sie bissfest sind kochen. Abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In der Zwischenzeit Kartoffeln dazugeben und weich kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine kleine Pfanne mit etwas Butter erhitzen und Zwiebel glasig dünsten. Knoblauch dazugeben und kurz garen. Brechbohnen dazugeben und einige Minuten unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Währenddessen Kartoffeln zerstampfen. Ein Stück Butter und einen Schuss Milch dazugeben. Bohnenmischung und geriebenen Käse unterheben. Mit Salz, Pfeffer und Senf abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Speck braten und mit dem Bohnenstampf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
