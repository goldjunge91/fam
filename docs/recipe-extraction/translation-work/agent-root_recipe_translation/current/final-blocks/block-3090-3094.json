      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser mit Hefe vermengen und 5 Minuten stehen lassen, bis sich Schaum bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer Schüssel vermengen, dann Hefemischung hinzufügen und etwa 8 Minuten kneten, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in einer geölten Schüssel mit einem feuchten Tuch abgedeckt 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 3 gleiche Stücke teilen und jedes zu einem dünnen Oval von etwa 1/4 inch Dicke ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mozzarella und Feta in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Käsemischung auf eine Hälfte jedes Teigovals geben, die andere Hälfte darüberklappen und die Ränder mit einer Gabel festdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer großen Pfanne bei mittlerer Hitze erhitzen und jedes Chatschapuri 3-4 Minuten pro Seite goldbraun braten, bis der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In die Mitte jedes Chatschapuri eine kleine Mulde drücken, ein Ei hineinschlagen und zugedeckt 2-3 Minuten garen, bis das Ei leicht gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
