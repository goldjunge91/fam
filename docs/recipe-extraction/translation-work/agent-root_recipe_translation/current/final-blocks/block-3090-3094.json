      "steps": [
        {
          "position": 0,
          "text": "Roggenbrotscheiben leicht toasten, bis sie fest, aber nicht zu knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Jede Scheibe dünn mit Butter und anschließend mit Frischkäse bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Räucherlachs auf zwei Scheiben legen und dünne Gurken- sowie rote Zwiebelscheiben darauf anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hart gekochte Eier in Scheiben schneiden und auf die übrigen zwei Scheiben legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frischen Dill über alle Smørrebrød streuen, mit Salz und Pfeffer würzen und etwas Zitronensaft darüberpressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sofort servieren, solange das Brot noch leicht warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
