        {
          "position": 0,
          "text": "Salzwasser in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maisgrieß langsam unter ständigem Rühren einrieseln lassen, damit keine Klumpen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze reduzieren und 20-25 Minuten köcheln lassen; häufig umrühren, bis die Mischung dick und cremig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter und den größten Teil des geriebenen Käses einrühren, bis alles geschmolzen und vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drei kleine Mulden in die Maisgrießmischung drücken und jeweils ein Ei hineinschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Topf abdecken und 3-4 Minuten garen, bis das Eiweiß fest ist, das Eigelb aber noch leicht flüssig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem restlichen Käse, schwarzem Pfeffer und nach Wunsch frischen Kräutern bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß direkt aus dem Topf servieren oder auf Schalen verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
