      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie eine 9 x 13 Zoll große Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch mit Zwiebelwürfeln und gehacktem Knoblauch in einer Pfanne bei mittlerer bis hoher Hitze etwa 8 Minuten lang anbraten, bis das Rindfleisch gebräunt ist, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Sauerrahm mit Hühnerbrühe in einer kleinen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Enchiladasauce in einer flachen Schüssel bei schwacher Hitze 2 Minuten lang erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauchen Sie jede Maistortilla in die warme Enchilada-Sauce, um beide Seiten zu bedecken, und füllen Sie sie dann mit gewürztem Rinderhackfleisch und 1 EL geriebenem Cheddar-Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tortillas rollen und mit der Nahtseite nach unten in die vorbereitete Auflaufform legen, die restliche Mischung aus Enchiladasauce und Sauerrahm über die gerollten Tortillas gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den restlichen Cheddar-Käse darüber streuen und 25–30 Minuten backen, bis Blasen entstehen und der Käse geschmolzen und leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
