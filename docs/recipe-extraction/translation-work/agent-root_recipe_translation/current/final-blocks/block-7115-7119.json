      "steps": [
        {
          "position": 0,
          "text": "Jede Bratwurst mit einer Gabel einstechen, damit sie nicht platzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Würstchen 8 Minuten lang von allen Seiten anbraten, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In die gleiche Pfanne geschnittene Zwiebeln und Paprika geben und etwa 6 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Rinderbrühe aufgießen und die Würstchen wieder in die Pfanne geben und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brotscheiben goldbraun rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jede Brotscheibe mit Senf bestreichen und mit einer Wurst sowie den karamellisierten Zwiebeln und Paprika belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit etwas Senf als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
