      "steps": [
        {
          "position": 0,
          "text": "Poblano-Paprikaschoten über einer Gasflamme oder unter dem Grill rösten, bis sie verkohlt sind, und dann zum Dämpfen 5 Minuten in eine Plastiktüte legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Von den Poblanos die verkohlte Haut abziehen, die Kerne entfernen und in Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine Bratpfanne bei mittlerer bis hoher Hitze erhitzen und Rinderhackfleisch mit Zwiebelwürfeln und gehacktem Jalapeño ca. 8 Minuten anbraten, bis das Rindfleisch gebräunt ist, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl-Tortillas in einer trockenen Pfanne oder über einer Flamme 20 Sekunden pro Seite erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Tortilla mit saurer Sahne bestreichen und dann gewürztes Rinderhackfleisch, Poblano-Streifen und geriebenen Cheddar-Käse hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit frischem Koriander belegen, falten oder rollen und mit Limettenschnitzen als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
