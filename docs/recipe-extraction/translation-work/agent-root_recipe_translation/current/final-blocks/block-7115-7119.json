      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie das Fett vom Bruststück ab, lassen Sie dabei etwa 0.25 Zoll übrig, und bestreichen Sie es anschließend großzügig mit Salz und Pfeffer von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitzen Sie einen Holzkohle-Räucherofen auf 225–250 °F und geben Sie zum Räuchern Eichenholzspäne hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie das Bruststück mit der Fettseite nach oben auf den Räucherofen und räuchern Sie es etwa 10–12 Stunden lang, bis die Innentemperatur 195 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Bruststück mit Butter und Rinderbrühe in Alufolie einwickeln und weitere 1–2 Stunden räuchern, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bruststück aus dem Räucherofen nehmen und 15 Minuten in Folie abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bruststück gegen die Faser in 0.25 Zoll dicke Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Toasten Sie das Brot leicht, schichten Sie die Rinderbrustscheiben auf das Brot und belegen Sie es mit Gewürzgurken und Zwiebelscheiben. Anschließend servieren Sie es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
