      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie die Kielbasa in 1/4 cm dicke Münzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Zwiebeln in dünne Halbmonde schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen und die geschnittenen Zwiebeln hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Zwiebeln unter gelegentlichem Rühren 25–30 Minuten kochen, bis sie tief goldbraun und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Braunen Zucker und Apfelessig zu den Zwiebeln geben, gut umrühren und weitere 2 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schieben Sie die Zwiebeln an den Rand der Pfanne, geben Sie Kielbasa-Scheiben hinzu und kochen Sie sie etwa 5 Minuten lang, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Kielbasa unter die karamellisierten Zwiebeln rühren und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf geschnittenem Roggenbrot mit Senf als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
