      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen, dann kalte Butter dazugeben, bis die Mischung groben Krümeln ähnelt; Eiswasser hinzufügen, bis der Teig zusammenkommt, und 15 Minuten kalt stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch, Kartoffelwürfel, Steckrüben, Zwiebeln, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den gekühlten Teig in zwei Hälften und rollen Sie jedes Stück auf einer bemehlten Oberfläche zu einer 8 cm großen Runde aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie die Füllung auf eine Hälfte jeder Teigrunde und lassen Sie dabei einen Rand von 1/2 cm frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falten Sie den Teig zu einem Halbmond und falten Sie die Ränder mit einer Gabel zusammen, um sie zu verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Gebäck auf ein mit Backpapier ausgelegtes Backblech legen und mit verquirltem Ei bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "375–35 Minuten bei 40 °C goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
