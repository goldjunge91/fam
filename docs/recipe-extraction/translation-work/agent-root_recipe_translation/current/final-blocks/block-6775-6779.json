      "steps": [
        {
          "position": 0,
          "text": "Urad-Dal-Mehl, Salz, Kreuzkümmel und Pfefferkörner in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nach und nach Wasser zugeben und zu einem festen Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 5-7 Minuten lang kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in kleine Kugeln teilen und auf Plastikfolie oder Pergament legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Kugel zwischen zwei Lagen Frischhaltefolie oder Backpapier zu einem hauchdünnen, durchscheinenden Kreis von etwa 6 Zoll Durchmesser ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Öl in einer tiefen Pfanne auf 350 °F erhitzen. Jedes Papadum 2–3 Sekunden frittieren, bis es aufgeht und knusprig wird; dabei einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und nach dem Abkühlen in einem luftdichten Behälter aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
