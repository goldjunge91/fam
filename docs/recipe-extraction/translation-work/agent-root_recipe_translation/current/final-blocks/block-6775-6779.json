          "text": "Den Jasminreis zweimal unter kaltem Wasser abspülen, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hühnerbrühe und Wasser in einem großen Topf zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den abgespülten Reis hinzufügen und gelegentlich 2-3 Minuten lang umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hitze reduzieren und den Reis ohne Deckel 30–40 Minuten bei niedriger Hitze köcheln lassen. Häufig umrühren, bis er zu einem cremigen Brei zerfällt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und weißem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In Schüsseln füllen und mit Frühlingszwiebeln, Röstschalotten und frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
