      "steps": [
        {
          "position": 0,
          "text": "Essig und Wasser in einem Topf vermischen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salz, braunen Zucker, Knoblauch, Ingwer, Chilischoten und Pfefferkörner hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühren, bis sich Zucker und Salz vollständig aufgelöst haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fischstücke vorsichtig in die kochende Mischung geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und 8–10 Minuten köcheln lassen, bis der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen und auf Raumtemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Fisch und die Beizflüssigkeit in ein Glas geben und im Kühlschrank aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gekühlt oder bei Zimmertemperatur als Vorspeise oder Beilage servieren. Im Kühlschrank hält sich der Fisch bis zu 2 Wochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
