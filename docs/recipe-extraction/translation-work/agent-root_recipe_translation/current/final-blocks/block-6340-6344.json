      "steps": [
        {
          "position": 0,
          "text": "Garnelen mit Papiertüchern trocken tupfen, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Salz, weißen Pfeffer und Knoblauchpulver in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl in einer tiefen Pfanne bei mittlerer bis hoher Hitze auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Garnelen gleichmäßig mit der Mehlmischung bestreichen und überschüssiges Mehl abschütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Garnelen vorsichtig ins heiße Öl geben und pro Seite 1.5–2 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie die gekochten Garnelen mit einem Schaumlöffel auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren, mit Limettenspalten zum Auspressen und gehackten Zwiebeln als Beilage.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort essen, solange die Garnelen knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
