      "steps": [
        {
          "position": 0,
          "text": "Reis nach Packungsanleitung kochen und noch warm in eine große Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis mit Sesamöl, Reisessig, Zucker und Salz vermengen und leicht abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spinat 2 Minuten in kochendem Wasser blanchieren, trocken ausdrücken und mit etwas Sesamöl und Salz würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Karotten und Gurke in dünne Streichholzstreifen schneiden. Krebs oder Thunfisch vorsichtig mit etwas Sesamöl in einer Pfanne garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier verquirlen und in einer Pfanne zu dünnen Omeletts garen. Dann in dünne Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Ein Nori-Blatt mit der glänzenden Seite nach unten auf eine Bambusmatte legen und eine dünne Schicht gewürzten Reis gleichmäßig darauf verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Je eine schmale Reihe jeder Füllung waagerecht in der Mitte des Reises anordnen: Spinat, Karotten, Gurke, Ei und Krebs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit der Bambusmatte fest aufrollen, Kante mit etwas Wasser verschließen und mit einem scharfen, angefeuchteten Messer in 6–8 Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf einer Platte anrichten, mit Sesamsamen bestreuen und bei Zimmertemperatur mit Sojasauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
