      "steps": [
        {
          "position": 0,
          "text": "Buchweizennudeln nach Packungsanleitung bissfest kochen, abgießen und gründlich mit kaltem Wasser abspülen, bis sie gekühlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderbrühe in einem Topf erhitzen und mit Gochugaru, Zucker, Reisessig, gehacktem Knoblauch sowie Sesamöl zu einer kalten Brühesauce verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brühesauce mindestens 15 Minuten im Kühlschrank kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rohes Rinderfilet dünn schneiden und Gurke in dünne Streichholzstreifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kalte Nudeln auf zwei Schalen verteilen und mit Rindfleischscheiben, Gurke und halbierten hartgekochten Eiern belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekühlte Brühesauce über die Nudeln gießen, bis die Schale fast voll ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Sesamsamen garnieren und sofort mit kleinen Beilagen wie Kimchi servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Essen alles vermischen und nach Geschmack mehr Essig oder Chilisauce dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
