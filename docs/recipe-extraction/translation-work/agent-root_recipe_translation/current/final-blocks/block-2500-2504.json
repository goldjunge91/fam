      "steps": [
        {
          "position": 0,
          "text": "Tintenfisch unter fließendem Wasser säubern, Innereien und Haut entfernen, dann den Körper in etwa 0.5 inch breite Ringe schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen Topf Wasser zum Kochen bringen und Tintenfischringe sowie Tentakel 1–2 Minuten blanchieren, bis sie undurchsichtig werden. Sofort abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gochugaru, Sojasauce, Sesamöl, Reisessig, Zucker und gehackten Knoblauch in einer großen Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gegarten Tintenfisch zum Dressing geben und gut wenden, damit alles gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tintenfisch 5–10 Minuten marinieren lassen, damit er die Aromen aufnimmt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehackte Frühlingszwiebeln dazugeben und vorsichtig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf eine Servierplatte geben und mit Sesamsamen, Salz und Pfeffer garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei Zimmertemperatur oder leicht gekühlt als Beilage oder Vorspeise servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
