      "steps": [
        {
          "position": 0,
          "text": "Krabben aus Tierschutzgründen 15 Minuten im Gefrierfach herunterkühlen, damit sie inaktiv werden. Dann rasch Beine und Körper in Stücke teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Sojasauce, Wasser, Zucker, gehackten Knoblauch, geschnittenen Ingwer, gehackte Frühlingszwiebeln, geschnittene rote Chilis und Reisessig in einem großen Glasbehälter oder einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Krabbenstücke in der Marinade anordnen, sodass sie untergetaucht sind, und Behälter abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mindestens 24 Stunden, vorzugsweise 2–3 Tage, im Kühlschrank marinieren. Einmal täglich vorsichtig umrühren, damit sie gleichmäßig durchziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Krabbenfleisch gart allmählich in der Sojasauce und entwickelt einen kräftigen Umami-Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einem luftdichten Behälter im Kühlschrank aufbewahren und innerhalb von 7–10 Tagen verzehren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zum Servieren Krabbenstücke auf einem Teller anrichten und mit Sesamsamen sowie frischen Frühlingszwiebelringen garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gekühlt mit der übrigen Marinade als Dip und warmem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
