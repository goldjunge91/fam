      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust in mundgerechte Stücke schneiden und mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maisstärke und Mehl in einer Schüssel vermengen und Hähnchenstücke gleichmäßig darin wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Pflanzenöl in einem tiefen Topf oder Wok auf 350°F erhitzen. Hähnchen portionsweise goldbraun und knusprig frittieren, insgesamt etwa 8–10 Minuten. Auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sojasauce, Zucker, Wasser, gehackten Knoblauch, gehackten Ingwer und Reisessig in einem kleinen Topf vermengen und 2 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiertes Hähnchen zurück in eine große Pfanne geben und Sauce darüber gießen. Vorsichtig wenden, damit alles gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei mittlerer Hitze 2–3 Minuten garen, bis die Sauce karamellisiert und das Hähnchen überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf eine Servierplatte geben und mit gehackten Frühlingszwiebeln sowie Sesamsamen garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange es noch warm und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
