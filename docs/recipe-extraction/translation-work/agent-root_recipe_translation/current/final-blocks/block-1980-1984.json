      "steps": [
        {
          "position": 0,
          "text": "Heize die Fritteuse auf 350°F vor. Vermische alle Zutaten für die Gewürzmischung gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die Gewürzmischung mit Mehl, braunem Zucker und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tauche die Hähnchenteile in Eiweiß, sodass sie leicht überzogen sind, und gib sie dann in die Mehlmischung. Wende sie einige Male und achte darauf, dass die Mehlmischung gut am Hähnchen haftet. Wiederhole dies mit allen Hähnchenteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Hähnchenteile 5 Minuten ruhen, damit die Kruste etwas trocknen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Frittiere das Hähnchen portionsweise. Bruststücke und Flügel brauchen 12-14 Minuten, Keulen und Schenkel einige Minuten länger. Das Hähnchen ist gar, wenn ein Fleischthermometer an der dicksten Stelle 165°F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse das Hähnchen nach dem Frittieren auf Küchenpapier abtropfen. Heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
