      "steps": [
        {
          "position": 0,
          "text": "Dressingzutaten in einer kleinen Schüssel vermengen, mit Salz und Pfeffer würzen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pasta nach Packungsanleitung kochen. Zuckerschoten etwa in der letzten Minute der Garzeit dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Inzwischen Öl in einem Wok oder einer großen Pfanne erhitzen. Knoblauch und Chili hineingeben und bei mäßiger Hitze etwa 30 Sekunden garen, ohne den Knoblauch zu bräunen. Garnelen dazugeben und bei starker Hitze unter häufigem Rühren etwa 3 Minuten garen, bis sie rosa werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomaten dazugeben und unter gelegentlichem Rühren 3 Minuten garen, bis sie gerade weich werden. Pasta und Zuckerschoten gut abgießen und unter die Garnelenmischung heben. Basilikumblätter zerpflücken und dazugeben. Umrühren und mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salatblättern servieren, die mit Limettendressing beträufelt sind, und warmem knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
