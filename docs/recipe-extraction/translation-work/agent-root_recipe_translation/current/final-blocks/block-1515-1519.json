    {
      "externalId": "waivy:mfr-eu-spanakopita-bake",
      "slug": "mfr-eu-spanakopita-bake",
      "title": "Spinat-Feta-Auflauf nach Spanakopita-Art",
      "instructions": "Alle Aromen der griechischen Spinat-Feta-Pastete – Dill, Zitrone und Muskatnuss – ohne Teigboden: Cremiger Feta, zusammengefallener Spinat und Eier werden in einer Auflaufform gebacken, bis die Masse gestockt ist. Schneller als mit Filoteig und trotzdem wunderbar sättigend.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 35,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Tiefgekühlter Spinat ist deutlich günstiger als frischer und eignet sich besser zum Backen.",
        "Drücke jeden Tropfen Wasser heraus, sonst wird der Auflauf matschig.",
        "Der Auflauf hält sich 4 Tage im Kühlschrank und schmeckt kalt oder bei Zimmertemperatur ausgezeichnet."
      ],
      "substitutions": [
        {
          "forIngredientId": "dill-fresh",
          "swap": "Getrockneter Dill, 1 TL verwenden, schmeckt ebenfalls ausgezeichnet"
        },
        {
          "forIngredientId": "frozen-spinach",
          "swap": "Frischer Spinat: Eine große Packung zusammenfallen lassen und das Wasser ausdrücken"
        }
      ],
