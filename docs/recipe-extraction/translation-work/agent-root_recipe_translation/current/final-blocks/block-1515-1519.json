      "steps": [
        {
          "position": 0,
          "text": "Drücke das gesamte Wasser aus dem aufgetauten Spinat. Dieser Schritt ist unverzichtbar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Zwiebel an, bis sie weich ist. Gib Knoblauch und Spinat dazu und gare alles trocken, bis das restliche Wasser verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die Masse mit zerbröseltem Feta, Dill, Zitronenschale und Muskatnuss.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle die Eier und vermenge sie mit der Spinatmischung. Fülle alles in eine geölte Auflaufform und bestreue es mit Parmesan.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe den Auflauf bei 375°F 30 Minuten, bis er gestockt und oben goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
