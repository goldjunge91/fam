      "steps": [
        {
          "position": 0,
          "text": "Hacke den Kohl grob. Gare die Zwiebel in Öl, bis sie goldbraun ist. Gib die Pilze dazu und gare sie, bis die Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die in Scheiben geschnittene Wurst und den Kohl dazu. Brate alles 5 Minuten zusammen an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark, Knoblauch, Paprikapulver, Lorbeerblatt und einen Schuss Essig ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die Brühe dazu und bringe alles zum Kochen. Lass den Eintopf zugedeckt 45 Minuten köcheln. Je länger, desto besser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze den Eintopf und serviere ihn mit dunklem Roggenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
