      "steps": [
        {
          "position": 0,
          "text": "Klopfe das Hähnchen zwischen Frischhaltefolie auf 1/4 Zoll Dicke. Würze es, wende es in Mehl, dann in Ei und schließlich in Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate es in 1/2 Zoll heißem Öl pro Seite 2–3 Minuten, bis es kräftig goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wärme den Kartoffelsalat zu: Koche gewürfelte Kartoffeln und vermische sie mit gegartem Speck, Essig, Dijon-Senf und Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für den Gurken-Dill-Salat schneide die Gurke in dünne Scheiben und vermische sie mit Dill, Essig und einer Prise Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte das Schnitzel neben warmem Kartoffelsalat und Gurkensalat an und presse Zitronensaft darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
