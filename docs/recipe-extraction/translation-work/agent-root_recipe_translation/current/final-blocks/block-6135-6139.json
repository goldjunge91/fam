      "steps": [
        {
          "position": 0,
          "text": "Bringe Hühnerbrühe in einem großen Topf sprudelnd zum Kochen und halte sie während der gesamten Mahlzeit stark kochend.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Richte geschnittenes Hähnchen, Garnelen, Fisch, Pilze, Pak Choi, Ingwer und Frühlingszwiebeln jeweils auf separaten Tellern an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koche die Reisnudeln nach Packungsangabe in kochendem Wasser, gieße sie ab und verteile sie auf zwei Servierschüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die kochend heiße Brühe in jede Schüssel, sodass die Nudeln tief in Flüssigkeit liegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib zuerst das geschnittene Hähnchen in die heiße Brühe und rühre um, damit die Stücke getrennt bleiben. Gare es 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Garnelen und Fischscheiben dazu und gare sie 1-2 Minuten, bis sie undurchsichtig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Pilze und Pak Choi hinzu und gare sie 1-2 Minuten, bis sie zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Würze mit Sojasoße und Sesamöl, garniere mit Frühlingszwiebeln und serviere sofort, solange das Gericht dampfend heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
