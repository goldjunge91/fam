      "steps": [
        {
          "position": 0,
          "text": "Spüle Bajra und Moong Dal getrennt unter kaltem Wasser ab, bis das Wasser klar bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Kartoffel und Karotte in kleine 0.5-inch große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf und gib die Kreuzkümmelsamen dazu. Lasse sie 30 Sekunden knistern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Ingwer und grüne Chili dazu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Bajra und Moong Dal in den Topf, rühre um und gare alles 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib gewürfelte Kartoffel und Karotte, Erbsen, Kurkumapulver und Salz dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße 4 Tassen Wasser hinein und bringe alles zum Kochen. Decke den Topf ab, reduziere die Hitze auf mittlere bis niedrige Stufe und gare alles 20-25 Minuten, bis Bajra und Dal weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre gelegentlich um und gib bei Bedarf mehr Wasser hinzu. Die Khichdi sollte am Ende dick und cremig sein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
