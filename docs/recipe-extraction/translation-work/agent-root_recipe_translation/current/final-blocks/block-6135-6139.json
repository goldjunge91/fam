          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge alles gründlich und teile die Masse in 9-10 Portionen. Rolle jede zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke jede Kugel zu einem runden Bratling von etwa 0.5 Zoll Dicke flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze, bis es heiß ist und schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Tikkis in das heiße Öl und brate sie 3-4 Minuten, bis die Unterseite goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wende sie vorsichtig und brate die andere Seite weitere 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse die Tikkis auf Küchenpapier abtropfen und serviere sie heiß mit Joghurt und Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
