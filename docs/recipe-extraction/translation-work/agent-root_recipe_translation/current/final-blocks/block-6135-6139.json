      "steps": [
        {
          "position": 0,
          "text": "Schneide 2 Zwiebeln in dünne Scheiben und brate sie in Öl tief goldbraun an. Nimm sie heraus und stelle sie zum Garnieren beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zimtstange, Kardamomkapseln und Lorbeerblatt in dasselbe Öl und lasse die Gewürze 1 Minute ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die gewürfelte restliche Zwiebel dazu und gare sie etwa 5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Ingwer-Knoblauch-Paste ein und gare sie 2 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib die Fleischstücke dazu und gare sie bei hoher Hitze 5-7 Minuten unter häufigem Rühren, bis sie rundum angebraten sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre den Joghurt portionsweise ein und gib dann Kurkuma, rotes Chilipulver und Korianderpulver hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Wasser und Salz dazu und bringe alles zum Kochen. Decke den Topf ab, reduziere die Hitze und lasse es 45-50 Minuten köcheln, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm den Deckel ab und lasse die Flüssigkeit 10-15 Minuten auf die Hälfte einkochen. Garniere das Gericht mit den beiseitegestellten Röstzwiebeln und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
