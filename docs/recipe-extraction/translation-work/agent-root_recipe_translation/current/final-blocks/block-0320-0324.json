      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350F vor. Verteile die Erdnüsse auf einem Backblech mit Rand und zerstoße sie mit einem Becher oder Nudelholz in grobe Stücke. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße etwa 1 inch Wasser in einen mittelgroßen Topf und bringe es bei mittlerer Hitze zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge Eiweiß, Puderzucker und Salz in der Schüssel einer Küchenmaschine. Stelle die Schüssel auf den Topf, sodass sie am Rand aufliegt, ohne das Wasser zu berühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle die Mischung ständig, bis sie sich heiß anfühlt (etwa 120F laut sofort ablesbarem Thermometer), ungefähr 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Setze die Schüssel auf die Küchenmaschine mit Schneebesenaufsatz und schlage die Masse auf hoher Stufe, bis weiche Spitzen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Vanille dazu und schlage weiter, bis das Baiser sehr dick und glänzend ist und feste Spitzen hält, insgesamt etwa 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe mit einem Teigschaber die Hälfte der beiseitegestellten Erdnüsse unter, gib dann den Rest dazu und falte nur so weit, dass Streifen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Setze sofort gehäufte Esslöffel der Masse als Häufchen mit 1 1/2 inch Durchmesser auf ein mit Backpapier ausgelegtes Blech. Lass etwa 1 inch Abstand zwischen ihnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Schiebe die Baisers in den Ofen und halte die Tür mit dem Griff eines Holzlöffels einen Spalt offen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Backe sie 15 bis 20 Minuten, bis sie leicht aufgehen, an den Seiten aufreißen und sich außen trocken, innen aber noch weich anfühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Lege sie auf ein Kuchengitter und lass sie abkühlen. In einem luftdichten Behälter bei Zimmertemperatur bis zu 2 Tage aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
