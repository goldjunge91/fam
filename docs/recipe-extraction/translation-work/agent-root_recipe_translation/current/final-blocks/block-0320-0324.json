      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400F vor. Würze die Hähnchenschenkel rundherum mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 Tbsp Butter in einer mittelgroßen gusseisernen Pfanne bei mittelhoher Hitze. Lege die Hähnchenschenkel mit der Hautseite nach unten in einer Lage hinein (Stücke, die zunächst nicht hineinpassen, später dazugeben, wenn das Hähnchen geschrumpft ist). Brate sie 6-8 Minuten, bis das Fleisch an den Rändern undurchsichtig und die Haut tief goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drehe das Hähnchen mit der Hautseite nach oben und stelle die Pfanne in den Ofen. Backe es ohne Deckel 10-15 Minuten, bis es durchgegart ist. Lege das Hähnchen auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle dieselbe Pfanne auf mittlere Hitze. Gib gehackte Fenchelknolle und Lauch hinein, würze mit Salz und Pfeffer und gare alles unter gelegentlichem Wenden etwa 5 Minuten, bis der Lauch an den Rändern goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den Orzo dazu und gare ihn etwa 3 Minuten, bis die Nudeln geröstet sind und stellenweise nussig braun werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Weißwein dazu und gare alles unter Rühren etwa 1 Minute, bis die Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Hühnerbrühe nach und nach in Portionen von 1/2 cup dazu. Rühre dabei ständig und lass jede Zugabe aufnehmen, bevor du mehr hineingießt. Gare den Orzo 10-15 Minuten, bis er weich und die Brühe größtenteils aufgenommen ist, die Pfanne aber noch nicht trocken ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Pfanne vom Herd. Probiere und passe Salz und Pfeffer an. Rühre Zitronensaft, die übrige 1 Tbsp Butter und gehacktes Fenchelgrün ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege das Hähnchen auf den Orzo und reibe zum Schluss Zitronenschale darüber. Servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
