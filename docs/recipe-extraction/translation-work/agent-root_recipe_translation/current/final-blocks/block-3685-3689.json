      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig zu: Vermische Mehl, Salz, Zucker und kalte Butter krümelig. Gib dann 2 Eigelb und 2 Esslöffel Wasser hinzu und knete, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wickle den Teig ein und kühle ihn 30 Minuten. Drücke ihn dann in eine Springform mit 9 Zoll Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage die übrigen Eier mit Zucker hell auf und hebe Ricotta, Weizenkörner, kandierte Früchte, Orangenschale und Vanille unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Füllung in den Boden und backe den Kuchen bei 350°F 50-60 Minuten, bis er fest, in der Mitte aber noch leicht wackelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse den Kuchen vollständig in der Form abkühlen und stelle ihn vor dem Servieren mindestens 4 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
