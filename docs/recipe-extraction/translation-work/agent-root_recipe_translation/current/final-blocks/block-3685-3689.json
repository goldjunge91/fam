          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Tauche die warmen Babà je Seite 10-15 Sekunden in den Sirup, bis sie durchtränkt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
