      "steps": [
        {
          "position": 0,
          "text": "Röste Grieß 5 Minuten in einer trockenen Pfanne bei mittlerer Hitze leicht goldbraun und lasse ihn dann abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Ricotta, Zucker, Ei, kandierte Schale und Schokoladenstückchen in einer Schüssel und hebe den abgekühlten Grieß unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege 2 Filoteigblätter übereinander, bestreiche jedes mit geschmolzener Butter und gib 2 Esslöffel Füllung auf das kurze Ende.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig wie einen Burrito fest auf, klappe die Seiten ein und forme ihn dann zu einem Halbmond.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche die Außenseite mit Butter und lege das Gebäck auf ein mit Backpapier belegtes Blech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe es bei 375°F 25-30 Minuten goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm das Gebäck aus dem Ofen und bestäube es noch warm großzügig mit Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse es vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
