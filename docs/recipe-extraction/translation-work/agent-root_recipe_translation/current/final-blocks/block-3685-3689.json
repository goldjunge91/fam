      "steps": [
        {
          "position": 0,
          "text": "Erhitze Brühe in einem Topf und halte sie während des gesamten Kochens bei niedriger Hitze warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebel in Butter weich, gib Reis hinzu und rühre 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib warme Brühe kellenweise hinzu und rühre häufig, bis der Reis nach etwa 18 Minuten cremig und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Parmesan ein, würze mit Salz und Pfeffer und verteile den Reis zum vollständigen Abkühlen auf einem Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Eier und schneide Mozzarella in kleine Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme golfballgroße Reisbällchen um je einen Mozzarellawürfel und wende sie in Ei und dann Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere die Arancini 3-4 Minuten goldbraun; wende sie vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
