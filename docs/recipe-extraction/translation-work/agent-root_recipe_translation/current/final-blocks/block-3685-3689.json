      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz, forme eine Mulde, gib Eier, Butter und Likör hinein und knete einen glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rolle den Teig zu einer dünnen Rolle und schneide ihn in kleine erbsengroße Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl auf 350°F und frittiere die Teigstücke portionsweise 2-3 Minuten goldbraun. Rühre häufig um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse sie auf Küchenpapier vollständig abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Honig und Zucker in einem großen Topf, bis sie geschmolzen und vermischt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die frittierten Teigstücke und kandierte Schale hinzu und schwenke alles vorsichtig, bis alles gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Forme die klebrige Masse noch warm auf einer Servierplatte zu einem Hügel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei Raumtemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
