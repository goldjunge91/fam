      "steps": [
        {
          "position": 0,
          "text": "Buchweizengrütze in einer trockenen Pfanne bei mittlerer Hitze 2-3 Minuten unter ständigem Rühren rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "In einem separaten Topf Wasser oder Brühe zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geröstete Grütze mit Salz in die kochende Flüssigkeit geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hitze reduzieren und zugedeckt 15 Minuten köcheln lassen, bis die Flüssigkeit weich und aufgesogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In der Zwischenzeit 1 Esslöffel Butter schmelzen und die gewürfelten Zwiebeln goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kascha mit einer Gabel auflockern und restliche Butter, sautierte Zwiebeln und schwarzen Pfeffer unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren, optional mit einem Spiegelei belegt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
