      "steps": [
        {
          "position": 0,
          "text": "Milch auf 110°F erwärmen und mit Hefe, Zucker, Salz und Ei vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl einrühren, dann nach und nach Mehl hinzufügen und 8 Minuten lang zu einem glatten Teig kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Abdecken und 45 Minuten gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In der Zwischenzeit Rinderhackfleisch mit gehackten Zwiebeln bei mittlerer Hitze anbraten, mit Salz und Pfeffer würzen und dann abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 12 gleiche Stücke teilen und jedes zu einem dünnen Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie 1 Esslöffel Füllung in die Mitte jedes Kreises, falten Sie ihn zur Hälfte und verschließen Sie die Ränder mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl auf 350°F erhitzen und Piroshki 2-3 Minuten pro Seite goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Papiertüchern abtropfen lassen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
