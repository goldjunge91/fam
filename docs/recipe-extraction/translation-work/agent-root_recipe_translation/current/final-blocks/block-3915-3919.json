      "steps": [
        {
          "position": 0,
          "text": "Zwiebeln in Butter anbraten, bis sie weich sind, Pilze hinzufügen und kochen, bis die Flüssigkeit verdampft ist, etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gekochten Reis, sautierte Pilzmischung, Lachsflocken, gehackte hartgekochte Eier und Dill in einer Schüssel vermengen. Mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Blätterteig ausrollen und auf ein mit Backpapier ausgelegtes Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Löffeln Sie die Füllung in die Mitte des Teigs und lassen Sie auf jeder Seite 2 Zoll übrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falten Sie die langen Seiten des Teigs über die Füllung und versiegeln Sie die Ränder mit Wasser. Die kurzen Enden nach unten falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Oberseite und Seiten mit geschlagenem Eigelb bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 400°F 30-35 Minuten backen, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lassen Sie 10 Minuten vor dem Schneiden und Servieren abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
