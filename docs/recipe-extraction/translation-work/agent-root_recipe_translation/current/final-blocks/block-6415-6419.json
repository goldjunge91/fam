      "steps": [
        {
          "position": 0,
          "text": "Bitte den Fischhändler, den Aal zu säubern und in 2 Zoll große Stücke zu schneiden. Alternativ kannst du hinter dem Kopf einen Schnitt machen und die Haut abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und brate die Aalstücke pro Seite 3 Minuten goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Aal heraus und stelle ihn beiseite. Dünste gewürfelte Zwiebel, Sellerie und Karotten 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Aal zurück in die Pfanne und gieße Weißwein dazu. Löse dabei die Bratrückstände vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomaten aus der Dose samt Saft und Lorbeerblätter dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf mittlere bis niedrige Stufe und lass alles 25-30 Minuten köcheln, bis der Aal zart und die Sauce eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab, garniere mit frischer Petersilie und serviere das Gericht mit weicher Polenta oder knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
