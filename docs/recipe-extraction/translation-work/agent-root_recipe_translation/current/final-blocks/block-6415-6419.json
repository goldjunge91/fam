      "steps": [
        {
          "position": 0,
          "text": "Schneide überschüssiges Fett von der Schweineschulter ab und forme sie zu einer kompakten Rolle, ohne das Fleisch zu zerteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Salz, Pökelsalz, zerstoßene Pfefferkörner, gehackten Knoblauch und gehackten Rosmarin in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Gewürzmischung gründlich in die Oberfläche der Schweineschulter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege das gewürzte Fleisch in einen nicht reaktiven Behälter, gieße Rotwein darüber, decke es ab und stelle es 7 Tage in den Kühlschrank. Wende es täglich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Fleisch aus der Lake und tupfe es trocken. Wickle es fest in Musselintuch und binde es mit Küchengarn zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hänge das eingewickelte Fleisch in einem kühlen (55-60°F), feuchten Raum mit guter Luftzirkulation 3-4 Wochen auf, bis die Oberfläche trocken und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wickle das Capocollo aus und schneide es zum Servieren hauchdünn auf, etwa zu Brot und Käse oder für Sandwiches.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
