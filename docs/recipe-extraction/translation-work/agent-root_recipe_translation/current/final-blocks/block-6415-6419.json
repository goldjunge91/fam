      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage weiche Butter und Zucker in einer großen Schüssel etwa 3 Minuten cremig und luftig auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Eier nacheinander unter und gib dann Vanilleextrakt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Mehl, Backpulver, Salz, Anissamen und Zitronenschale in einer separaten Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die trockenen Zutaten unter die feuchten, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle den Teig in einen Spritzbeutel und spritze etwa 3 Zoll lange Stäbchen auf das vorbereitete Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie 12-15 Minuten goldbraun und fest und lass sie dann auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie zum Eintunken mit Tee oder Kaffee oder bewahre sie bis zu einer Woche in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
