      "steps": [
        {
          "position": 0,
          "text": "Tupfe den Schweinebauch trocken und ritze die Schwarte mit einem scharfen Messer rautenförmig ein. Schneide dabei nur durch Schwarte und Fettschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische gehackte Fenchelblätter, Rosmarin, gehackten Knoblauch, Salz und schwarzen Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reibe die Kräutermischung auf die Fleischseite des Schweinebauchs. Rolle ihn mit der Schwarte nach außen auf und binde ihn in Abständen von 2 Zoll fest mit Küchengarn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reibe die Schwarte mit Olivenöl ein und lege die Porchetta mit der Naht nach unten in einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Brate sie bei 325°F 2.5-3 Stunden. Begieße sie alle 30 Minuten mit Weißwein, bis die Schwarte goldbraun und knusprig ist und das Fleisch eine Kerntemperatur von 160°F erreicht hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Porchetta vor dem Anschneiden 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide sie auf und serviere sie warm oder bei Zimmertemperatur mit knusprigem Brot und geröstetem Gemüse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
