      ],
      "steps": [
        {
          "position": 0,
          "text": "Mahle Schweinefleisch und Schweinefett in einer Küchenmaschine, bis alles gut vermischt ist. Halte die Masse dabei kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische in einer großen Schüssel das Hackfleisch mit Salz, Pökelsalz, zerstoßenen Pfefferkörnern, gehacktem Knoblauch und Weißwein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche Naturdärme 20 Minuten in lauwarmem Wasser ein, bis sie biegsam sind, und spüle sie dann vorsichtig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fülle den Darm mit einem Fleischwolf samt Wurstaufsatz oder einem Spritzbeutel mit der Fleischmischung. Lass an beiden Enden 2 Zoll frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Binde die Enden mit Küchengarn zu und stich mit einer Nadel kleine Löcher in den Darm, damit Luft entweichen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hänge die Salami an einem kühlen (55-60°F), feuchten Ort mit guter Luftzirkulation 4-6 Wochen auf, bis sie vollständig getrocknet und fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schneide sie zum Servieren dünn auf und serviere sie mit Brot oder Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
