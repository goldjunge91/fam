      "steps": [
        {
          "position": 0,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und dünste Zwiebel und Sellerie 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streue Mehl über das Gemüse und rühre 1-2 Minuten, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Kartoffeln, Mais und Brühe hinzu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse die Suppe 15-20 Minuten köcheln, bis die Kartoffeln weich sind. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Thymian, Salz und schwarzen Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Sahne langsam unter Rühren ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Suppe weitere 5 Minuten köcheln, ohne sie aufzukochen. Schmecke sie ab, würze bei Bedarf nach und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
