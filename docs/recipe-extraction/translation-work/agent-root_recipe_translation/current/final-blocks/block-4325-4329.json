      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Jakobsmuscheln mit Küchenpapier trocken und würze sie leicht mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einer Pfanne bei mittelhoher bis hoher Hitze und brate die Jakobsmuscheln pro Seite 2-3 Minuten, bis sie undurchsichtig sind. Lasse sie abkühlen und hacke sie grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Mayonnaise, Zitronensaft, Sellerie, Frühlingszwiebeln, Salz, Pfeffer und Paprikapulver in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe die gehackten Jakobsmuscheln unter die Mayonnaise-Mischung, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche die Innenseiten der aufgeschnittenen Brötchen leicht mit Butter und röste sie in einer Pfanne oder unter dem Backofengrill 2-3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jedes getoastete Brötchen mit der Jakobsmuschel-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit zusätzlichen Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
