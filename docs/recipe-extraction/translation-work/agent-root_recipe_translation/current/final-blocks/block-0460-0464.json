      "steps": [
        {
          "position": 0,
          "text": "Schmilz die Hälfte der Butter in einer großen Pfanne bei mittlerer Hitze und gib dann die Schweinekoteletts hinein. Achte darauf, dass die Pfanne nicht zu voll ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Koteletts etwa 4-5 Minuten pro Seite, bis ein sofort ablesbares Thermometer 145F anzeigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische währenddessen braunen Zucker, Zimt, Muskatnuss und Salz in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Koteletts auf einen Teller und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Apfelscheiben, Pekannüsse, die gewürzte Zuckermischung und die übrige Butter in dieselbe Pfanne. Löse dabei die gebräunten Röststoffe vom Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare alles unter Rühren, bis die Äpfel weich sind und der Zucker zu einem glänzenden Sirup geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Löffle Äpfel und Sirup über die Koteletts und serviere sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
