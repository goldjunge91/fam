    {
      "externalId": "waivy:toh-contest-winning-broccoli-chicken-casserole",
      "slug": "toh-contest-winning-broccoli-chicken-casserole",
      "title": "Hähnchen-Brokkoli-Auflauf",
      "instructions": "Ein wärmender Auflauf für viele: Zartes Hähnchen und leuchtend grüne Brokkoliröschen in cremiger Käsesoße, bedeckt mit herzhaft gewürzter Füllung und schmelzendem Cheddar. Dieses Wohlfühlessen ist schnell fertig und noch schneller aufgegessen. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/contest-winning-broccoli-chicken-casserole/",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 30,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Verwende übrig gebliebenes Hähnchen oder Hähnchen vom Drehspieß statt frische Hähnchenbrust zu kaufen und zu garen. So sparst du Geld und Zeit.",
        "Ersetze frischen Brokkoli durch tiefgekühlte Röschen. Sie sind das ganze Jahr über günstiger und müssen nur kurz aufgetaut werden.",
        "Kaufe ein Stück Cheddar und reibe ihn selbst. Das ist pro Unze günstiger als fertig geriebene Packungen."
      ],
      "substitutions": [
        {
          "forIngredientId": "rotisserie-chicken",
          "swap": "Hähnchen aus der Dose oder übrig gebliebener Truthahn",
          "savings": "~$0.50 pro Portion mit Konserven"
        },
        {
          "forIngredientId": "broccoli",
          "swap": "Tiefgekühlte Brokkoliröschen, aufgetaut und abgetropft",
          "savings": "~$0.05 pro Tasse"
        },
        {
          "forIngredientId": "breadcrumbs",
          "swap": "Zerbröselte Cracker oder Panko, mit geschmolzener Butter und Kräutern vermischt",
          "savings": "ähnliche Kosten, verwendet Vorratszutaten"
        }
