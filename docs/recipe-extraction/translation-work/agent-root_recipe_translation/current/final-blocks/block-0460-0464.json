      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 350F vor und fette eine 11x7-Zoll-Auflaufform leicht ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite die Füllung nach Packungsanleitung zu, verwende aber nur 1-1/2 Tassen Wasser, damit sie eher fest bleibt. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische gewürfeltes Hähnchen, Brokkoliröschen und die unverdünnte Brokkoli-Käsesuppe aus der Dose in einer großen Schüssel, bis alles gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Hähnchenmischung in einer gleichmäßigen Lage in der vorbereiteten Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die zubereitete Füllung darauf und bestreue die Oberfläche mit geriebenem Cheddar.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke die Form ab und backe den Auflauf 20 Minuten. Nimm dann den Deckel ab und backe ihn weitere 10 bis 15 Minuten, bis er heiß ist und überall blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass den Auflauf vor dem Servieren etwa 10 Minuten ruhen, damit er fest wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
