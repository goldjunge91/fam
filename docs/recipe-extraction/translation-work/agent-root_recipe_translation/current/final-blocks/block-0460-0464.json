      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 400 °F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre saure Sahne, gehackten Schnittlauch, Knoblauch und 1/2 TL Salz für den Dip. Decke ihn ab und stelle ihn bis zum Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Mehl, braunen Zucker, gemahlenen Senf, Pfeffer, 1/2 TL Salz und Cayennepfeffer in einer flachen Schüssel. Gib die verquirlten Eier in eine zweite flache Schüssel und die zerdrückten Barbecue-Chips in eine dritte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende jeden Hähnchenstreifen in der gewürzten Mehlmischung und schüttle überschüssiges Mehl ab. Tauche ihn dann ins Ei und drücke ihn anschließend in die zerdrückten Chips, damit die Kruste haftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die panierten Hähnchenstreifen auf ein Gitter in einem tiefen Backblech und besprühe sie mit Ölspray.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie 12 bis 15 Minuten, bis die Panade goldbraun und knusprig und das Hähnchen vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß mit dem gekühlten Dip aus saurer Sahne und Schnittlauch servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
