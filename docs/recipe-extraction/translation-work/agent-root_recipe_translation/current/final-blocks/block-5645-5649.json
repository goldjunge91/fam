      "steps": [
        {
          "position": 0,
          "text": "Speck in einer großen gusseisernen Pfanne bei mittlerer Hitze etwa 8 Minuten knusprig braten. Herausnehmen und zerkrümeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Kartoffeln in das Speckfett geben und bei mittlerer bis hoher Hitze 15 Minuten unter gelegentlichem Rühren goldbraun und weich braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel und Paprika hinzufügen und 3–4 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Speck zurück in die Pfanne geben und Paprikapulver, Salz sowie Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Hash an den Pfannenrand schieben und in der Mitte Platz lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Butter in die Mitte geben und Eier hineinschlagen. Etwa 5 Minuten garen, bis das Eiweiß gestockt, das Eigelb aber noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Alles vorsichtig vermengen oder mit den Eiern obenauf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
