      "steps": [
        {
          "position": 0,
          "text": "Brate Schweine- und Rinderhackfleisch in einer großen Pfanne bei mittelhoher bis hoher Hitze etwa 8 Minuten an und zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Kartoffeln und Zwiebel fein und gib sie zusammen mit Wasser, Zimt und Nelken zum Fleisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse alles ohne Deckel 15-20 Minuten köcheln, bis die Kartoffeln weich sind und die Flüssigkeit reduziert ist. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Ofen auf 400°F vor und lasse die Fleischfüllung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege einen Tortenboden in eine 9-inch Pieform und fülle ihn mit der Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege den zweiten Boden darauf, verschließe die Ränder, schneide Öffnungen hinein, bestreiche ihn mit verquirltem Ei und backe ihn 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Pastete vor dem Anschneiden und Servieren 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
