      "steps": [
        {
          "position": 0,
          "text": "Schrubbe Muscheln unter kaltem Wasser und entferne die Bärte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einem großen Topf und dünste fein gehackten Knoblauch an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Weißwein dazu und bringe ihn zum Köcheln. Gib Muscheln hinein, decke den Topf ab und gare sie 5-7 Minuten, bis sie sich öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm die Muscheln mit einer Schaumkelle heraus und seihe die Kochflüssigkeit durch ein Passiertuch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib im selben Topf Fischfilets und Garnelen mit der abgeseihten Flüssigkeit und Thymian hinein. Lasse alles 8-10 Minuten köcheln, bis die Meeresfrüchte gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Sahne unter und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Muscheln zurück in den Topf und vermische alle Meeresfrüchte vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile alles auf Schüsseln, garniere mit frischer Petersilie und serviere sofort mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
