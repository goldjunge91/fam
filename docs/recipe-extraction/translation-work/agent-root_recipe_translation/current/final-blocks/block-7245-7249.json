          "forIngredientId": "agave-syrup",
          "swap": "verwenden einfach syrup instead",
          "savings": "Günstiger und wahrscheinlich ohnehin vorrätig."
        },
        {
          "forIngredientId": "lime",
          "swap": "Bottled Limette juice in ein pinch",
          "savings": "Länger haltbar, weniger Reste"
