      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und ½ Esslöffel Öl in einer Schüssel. Gib nach und nach warmes Wasser dazu und knete, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig mit einem feuchten Tuch ab und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate Rinderhack mit gehackter Zwiebel, Knoblauchpulver, Pfeffer und Salz in einer Pfanne an. Gieße überschüssiges Fett ab und lasse die Füllung etwas abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8 Kugeln und rolle jede zu einem dünnen 4-inch großen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffel Fleischfüllung auf eine Hälfte jedes Kreises. Klappe den Teig zusammen und drücke die Ränder fest an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze ¼ Zoll Öl in einer tiefen Pfanne, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Khuushuur 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Essig oder Sojasoße zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
