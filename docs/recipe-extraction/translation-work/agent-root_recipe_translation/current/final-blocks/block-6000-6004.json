      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Ei, Wasser und ½ Teelöffel Salz zu einem festen Teig. Knete ihn 5 Minuten und lasse ihn zugedeckt 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Rinderhack mit gehackter Zwiebel, dem restlichen Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle den Teig auf einer bemehlten Fläche dünn aus und schneide ihn in 1-inch große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib eine kleine Prise Füllung in die Mitte jedes Quadrats. Falte es zu einem Dreieck und verbinde dann die Ecken zu einem kleinen Beutel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe die Brühe in einem großen Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Chuchvara vorsichtig in die kochende Brühe und rühre um, damit sie nicht festkleben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare sie 8-10 Minuten, bis die Teigtaschen an die Oberfläche steigen. Koche sie anschließend weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß in Schüsseln mit der Brühe und nach Möglichkeit mit frischen Kräutern bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
