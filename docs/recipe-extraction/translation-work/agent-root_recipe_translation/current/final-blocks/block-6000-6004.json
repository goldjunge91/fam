      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz. Gib warmes Wasser und Öl dazu und rühre, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knete den Teig 5 Minuten elastisch und lasse ihn dann zugedeckt 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Rinderhack mit gewürfelter Zwiebel, schwarzem Pfeffer, Knoblauchpulver und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 12 gleich große Stücke und rolle jedes zu einem dünnen 3-inch großen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1½ Esslöffel Füllung in die Mitte jedes Kreises. Klappe die Ränder zu einer Beutelform hoch und drücke die Spitze zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe einen großen Topf mit Salzwasser zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Buuz vorsichtig ins kochende Wasser und gare sie 8-10 Minuten, bis sie an die Oberfläche steigen. Koche sie anschließend weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und serviere sie heiß mit Sojasoße und etwas Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
