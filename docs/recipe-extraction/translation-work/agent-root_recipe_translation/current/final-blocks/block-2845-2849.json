      "steps": [
        {
          "position": 0,
          "text": "Erwärme Milch auf 110°F, vermische sie mit Hefe und Zucker und lasse sie 5 Minuten stehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl und Salz, gib die Hefemischung und geschmolzene Butter dazu und knete 7 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse den Teig 45 Minuten gehen, bis sich sein Volumen fast verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 4 Stücke, rolle jedes zu einem 18-inch langen Strang und forme Brezeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe Wasser mit Natron zum Kochen und tauche jede Brezel 20-30 Sekunden hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Brezeln auf ein Backblech, bestreiche sie mit Wasser und bestreue sie mit Brezelsalz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie bei 425°F 12-14 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide die warmen Brezeln auf und fülle sie mit Leberwurst und einer dünnen Schicht Senf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie sofort, solange sie noch warm sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
