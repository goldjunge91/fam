      "steps": [
        {
          "position": 0,
          "text": "Halte alle Zutaten und Geräte kalt, indem du sie 30 Minuten im Gefrierfach kühlst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Zwiebel und Knoblauch fein und hacke dann den kalten Schweinerückenspeck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Schweinehackfleisch mit gewürfeltem Speck, Zwiebel, Knoblauch, Salz, Pfeffer, Majoran und Kümmel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib langsam Eiswasser dazu und vermische es mit den Händen, bis die Masse leicht und luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Masse mit einem Wurstfüller in vorbereitete Schweinedärme und binde sie zu 5-inch langen Würsten ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Würste in Wasser bei 160°F 20 Minuten ziehen, bis die Kerntemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie zum Abkühlen 10 Minuten in ein Eisbad und stelle sie dann kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Grille, brate oder koche die Würste zum Servieren und reiche Sauerkraut oder Kartoffelsalat dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
