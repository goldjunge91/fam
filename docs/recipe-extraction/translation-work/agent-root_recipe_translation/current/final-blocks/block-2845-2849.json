      "steps": [
        {
          "position": 0,
          "text": "Kühle alle Geräte, Därme und das Fleisch 30 Minuten im Gefrierfach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Schweineleber, Schulter und Rückenspeck in 1-inch große Würfel und halte sie auf Eis kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mahle Leber, Schweineschulter und Speck gemeinsam durch eine feine Scheibe und halte die Masse dabei durchgehend sehr kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische das Hackfleisch mit gehackter Zwiebel, Knoblauch, Salz, Pfeffer und Majoran, bis alles gerade verbunden ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Masse in vorbereitete Schweinedärme und binde sie zu 6-inch langen Würsten ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Würste in Wasser bei 160-170°F 25-30 Minuten ziehen, bis die Kerntemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kühle die Würste 15 Minuten im Eisbad und stelle sie dann kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide sie in Scheiben und serviere sie kalt oder leicht in der Pfanne gebraten mit Senf und Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
