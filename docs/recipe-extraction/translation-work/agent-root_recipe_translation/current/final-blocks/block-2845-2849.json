      "steps": [
        {
          "position": 0,
          "text": "Würfle die Zwiebel und gare sie in geschmolzener Butter bei mittlerer Hitze etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle das Sauerkraut kurz unter kaltem Wasser ab und drücke überschüssige Flüssigkeit aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Sauerkraut, Kümmel, Lorbeerblätter und Wacholderbeeren zu den Zwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe dazu und bringe alles unter gelegentlichem Rühren zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schäle und entkerne den Apfel, reibe ihn und rühre ihn unter das Sauerkraut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles ohne Deckel 30-35 Minuten köcheln und rühre gelegentlich um, bis sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne die Lorbeerblätter und passe die Würzung mit Salz und Pfeffer an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Sauerkraut warm als Beilage zu Würstchen, Schweinefleisch oder anderen Hauptgerichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
