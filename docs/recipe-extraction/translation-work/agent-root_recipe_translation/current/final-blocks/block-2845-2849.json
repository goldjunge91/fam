      "steps": [
        {
          "position": 0,
          "text": "Lasse Schweineblut auf Raumtemperatur kommen und seihe es durch ein feines Sieb, um Klümpchen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle Zwiebeln und gare sie langsam in einer Pfanne mit etwas Schmalz weich. Lasse sie vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mahle Schweineschulter und Rückenspeck zusammen und vermische sie dann mit gekochten Zwiebeln, Graupen und Gewürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hebe das Blut portionsweise vorsichtig unter die Fleischmischung, bis alles verbunden ist. Nicht zu stark mischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Masse mit einem Wurstfüller in vorbereitete Schweinedärme und binde sie zu 6-inch langen Würsten ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die Würste in Wasser bei 160-165°F 20-25 Minuten ziehen, bis sie an die Oberfläche steigen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und lasse sie 10 Minuten auf einem Gitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm mit Senf, Brot und Sauerkraut oder schneide sie in Scheiben und brate sie, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
