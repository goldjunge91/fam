      "steps": [
        {
          "position": 0,
          "text": "Öl in einer großen Pfanne bei mittlerer Hitze erwärmen und Zwiebel, Knoblauch und Ingwer anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kichererbsenmehl mit Wasser zu einer dicken, glatten Paste verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mehlmischung in die Pfanne geben und ständig rühren, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Cayennepfeffer und Salz würzen und dabei kontinuierlich rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "15–20 Minuten unter häufigem Rühren kochen, bis die Masse eindickt und sich leicht verdunkelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf eine Servierplatte geben und mit einem geölten Pfannenwender zu einem Hügel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
