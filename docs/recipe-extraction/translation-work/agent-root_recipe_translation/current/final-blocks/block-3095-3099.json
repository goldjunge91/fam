      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einer beschichteten Pfanne bei mittlerer Hitze erhitzen und gewürfelte Chorizo 3-4 Minuten braten, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel zur Chorizo geben und 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier in eine Schüssel schlagen, mit Salz und Pfeffer verquirlen und dann in die Pfanne gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit einem Pfannenwender vorsichtig rühren und dabei von den Rändern zur Mitte schieben, bis die Eier nach 3-4 Minuten cremig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen, solange die Eier noch leicht weich sind, da sie weitergaren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf zwei Teller verteilen, mit frischer Petersilie garnieren und sofort mit warmem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
