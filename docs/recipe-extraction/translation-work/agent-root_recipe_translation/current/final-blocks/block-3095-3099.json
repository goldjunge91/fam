          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pitabrot in einer Pfanne oder direkt über einer Flamme pro Seite 30 Sekunden erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heißen Hummus mit warmem Pitabrot zum Dippen servieren oder auf Pitabrot streichen und für ein Frühstück unterwegs aufrollen.",
          "timerMinutes": null,
