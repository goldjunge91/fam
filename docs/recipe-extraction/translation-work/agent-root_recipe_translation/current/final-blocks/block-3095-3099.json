          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hummus in eine Servierschüssel geben und mit Olivenöl beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprikapulver und frische Petersilie darüberstreuen.",
