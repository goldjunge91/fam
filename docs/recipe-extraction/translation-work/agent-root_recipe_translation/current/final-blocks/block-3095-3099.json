      "steps": [
        {
          "position": 0,
          "text": "Vollkornmehl mit 1/2 Teelöffel Salz vermengen und nach und nach Wasser zugeben, bis ein weicher Teig entsteht; 5 Minuten kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig mit einem feuchten Tuch abdecken und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer separaten Schüssel Kartoffelpüree, gehackte Zwiebel, grüne Chili, Koriander, Kreuzkümmelsamen, 1/2 Teelöffel Salz und schwarzen Pfeffer vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 3 gleiche Teile teilen und jedes zu einem dünnen Kreis von etwa 6 inches Durchmesser ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffelfüllung in die Mitte jedes Teigkreises geben, Ränder zusammenführen und verschließen; vorsichtig zu einem dicken Fladen flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine gusseiserne Pfanne oder Grillplatte bei mittelhoher Hitze erhitzen und etwas Ghee daraufgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Paratha auf die Pfanne legen und 2 Minuten braten, bis hellbraune Flecken entstehen, dann wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die zweite Seite mit mehr Ghee bestreichen und weitere 2 Minuten braten, nochmals wenden und goldbraun sowie knusprig fertig garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß mit Joghurt, Pickles oder frischem Limettensaft servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
