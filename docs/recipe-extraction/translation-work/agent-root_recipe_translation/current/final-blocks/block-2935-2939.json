      "steps": [
        {
          "position": 0,
          "text": "Weiche die Hähnchenteile mindestens 30 Minuten bei Raumtemperatur in Buttermilch ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Mehl, Paprikapulver, Knoblauchpulver, Zwiebelpulver, Cayennepfeffer, Salz und schwarzen Pfeffer in einer flachen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer tiefen Pfanne oder einem Schmortopf auf 350°F (verwende ein Thermometer).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Hähnchen aus der Buttermilch und wende es gründlich in der gewürzten Mehlmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Hähnchenteile vorsichtig mit der Hautseite nach unten ins heiße Öl und frittiere sie 12-15 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende das Hähnchen und frittiere es weitere 8-10 Minuten, bis die Kerntemperatur 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege es zum Abtropfen auf einen mit Küchenpapier ausgelegten Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere es heiß mit Keksen, Blattkohl oder Krautsalat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
