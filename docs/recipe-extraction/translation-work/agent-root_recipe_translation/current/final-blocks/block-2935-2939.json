      "steps": [
        {
          "position": 0,
          "text": "Brate Speck in einer Pfanne knusprig an, nimm ihn heraus und hacke ihn. Lasse 2 tablespoons Speckfett in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Hühnerbrühe in einem Topf zum Kochen und rühre Maisgrieß langsam ein. Rühre 15 Minuten ständig, bis die Masse dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre 2 tablespoons Butter und Cheddar in die Maisgrütze und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate gewürfelte Zwiebel und gehackten Knoblauch 2 Minuten im Speckfett an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Garnelen dazu und gare sie 2-3 Minuten pro Seite, bis sie rosa und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Pfanne vom Herd und rühre die übrigen 2 tablespoons Butter, Zitronensaft, scharfe Sauce und gehackten Speck ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze die Garnelenmischung nach Geschmack mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die cremige Maisgrütze auf Schalen und gib Garnelenmischung und Sauce darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
