      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und fetten Sie eine Gugelhupfform gründlich mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker in einer großen Schüssel 2-3 Minuten lang schaumig rühren, bis sie leicht und locker sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier einzeln unterrühren, dann Vanilleextrakt hinzufügen und verrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl, Backpulver und Salz in einer separaten Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abwechselnd Mehlmischung und Sauerrahm in drei Portionen zur Buttermischung geben und nach jeder Zugabe vorsichtig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streuen Sie 1/3 der Mischung aus Zimt und braunem Zucker in die vorbereitete Form, geben Sie dann die Hälfte des Teigs, ein weiteres 1/3 der Mischung und den restlichen Teig hinzu und geben Sie die restliche Zimtmischung darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "45–50 Minuten backen, bis ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "15 Minuten in der Form abkühlen lassen, dann zum vollständigen Abkühlen auf ein Kuchengitter stürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
