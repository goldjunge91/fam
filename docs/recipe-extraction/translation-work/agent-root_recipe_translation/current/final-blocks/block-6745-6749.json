      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maniokstärke, geriebenen Käse und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier mit zerlassener Butter und Milch verquirlen, dann in die Stärkemischung gießen und verrühren, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gegebenenfalls Anissamen hinzufügen und 1-2 Minuten lang vorsichtig verkneten, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig zu langen ovalen Ringen oder Stäbchen formen, die etwa 4 cm lang und 1/2 cm dick sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit einem Abstand von 2 cm auf das vorbereitete Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "25–30 Minuten backen, bis es goldbraun und außen leicht knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf einem Kuchengitter abkühlen lassen und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
