      ],
      "steps": [
        {
          "position": 0,
          "text": "Warme Milch, Hefe und 1 Esslöffel Zucker in einer Schüssel vermischen und 5 Minuten schaumig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, restlichen Zucker, Salz und Gewürze in einer großen Schüssel vermischen, dann Hefemischung, geschmolzene Butter und Ei hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt ist, dann die Johannisbeeren unterheben und 1 Stunde abgedeckt gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 12 gleich große Kugeln teilen, auf ein mit Backpapier ausgelegtes Backblech legen, abdecken und 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heizen Sie den Ofen auf 400 °F vor und spritzen Sie mit einem Spritzbeutel mit glatter Spitze und dünner Mehlpaste ein Kreuz auf jedes Brötchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "20–25 Minuten backen, bis die Brötchen goldbraun sind und beim Klopfen hohl klingen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Noch warm mit einer Glasur aus 1/4 Tasse Wasser und 2 Esslöffeln erhitztem Zucker bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren leicht abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
