      "steps": [
        {
          "position": 0,
          "text": "Erhitze Pflanzenöl in einem Topf und brate gehackten Knoblauch und Ingwer 30 Sekunden an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Schweinehackfleisch dazu und brate es etwa 5 Minuten vollständig an. Zerteile es dabei in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Hühnerbrühe dazu und bringe sie zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre Tahini und Chiliöl in einer kleinen Schüssel und rühre die Mischung nach und nach in die köchelnde Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Sojasauce dazu und lasse die Brühe unter gelegentlichem Rühren 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche währenddessen die Ramen-Nudeln nach Packungsanleitung bissfest und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die gekochten Nudeln auf zwei Schüsseln und gieße die scharfe Sesambrühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib halbierte weich gekochte Eier und geschnittene Frühlingszwiebeln darauf und bestreue alles mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
