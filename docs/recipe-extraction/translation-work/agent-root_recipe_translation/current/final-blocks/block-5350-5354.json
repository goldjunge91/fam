      "steps": [
        {
          "position": 0,
          "text": "Koche die Ramen-Nudeln in einem großen Topf mit Wasser bissfest und gieße sie anschließend ab. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Hühnerbrühe in einem zweiten Topf bei mittlerer Hitze. Gib gehackten Knoblauch und Ingwer dazu und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Misopaste mit einer kleinen Menge heißer Brühe in einer Schöpfkelle glatt und gib sie zusammen mit Sojasauce und Mirin in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Butter und Sesamöl in die Brühe und lasse sie 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die gekochten Nudeln auf zwei Schüsseln und gieße die heiße Misobrühe darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib halbierte weich gekochte Eier, geschnittene Frühlingszwiebeln, Bambussprossen und nach Wunsch weitere Proteine oder Gemüse darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
