      "steps": [
        {
          "position": 0,
          "text": "Auf einer sauberen Arbeitsfläche einen Mehlhaufen bilden, in der Mitte eine Mulde formen, die Eier hineinschlagen und das Mehl nach und nach mit den Eiern vermengen, bis ein ungleichmäßiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 8-10 Minuten kneten, bis er glatt und elastisch ist, dann mit Frischhaltefolie abdecken und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ricotta, Parmesan, Hackfleisch oder Spinat, Salz, Pfeffer und Muskatnuss in einer Schüssel für die Füllung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig mit einem Nudelholz oder einer Nudelmaschine möglichst dünn zu etwa 3mm dicken Platten ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig mit einem Messer oder Teigrädchen in 2-inch-Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "0.5 TL Füllung in die Mitte jedes Quadrats geben, diagonal zu einem Dreieck falten und dann die beiden Spitzen zu einer Ringform zusammenführen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gesalzenes Wasser in einem großen Topf zum Kochen bringen und die Tortellini portionsweise hineingeben, dabei vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "3-5 Minuten garen, bis sie oben schwimmen, und weitere 1-2 Minuten kochen; dann mit einer Schaumkelle herausheben und mit Butter, Salbei oder deiner Lieblingssauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
