      "steps": [
        {
          "position": 0,
          "text": "Mu-Err-Pilze 5 Minuten in warmem Wasser einweichen, dann abtropfen lassen und fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinefleisch, Pilze, Frühlingszwiebeln, Fischsauce, Sesamöl und Knoblauch in einer Schüssel gründlich vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein rundes Teigblatt auf die Arbeitsfläche legen und 1 TL Füllung leicht außermittig daraufgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Rand mit Wasser befeuchten, in der Mitte falten, dann Falten legen und zum Verschließen andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Teigtaschen mit der flachen Seite nach unten hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2-3 Minuten braten, bis sie goldbraun sind, dann jede Teigtasche wenden und die andere Seite 1 Minute garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wasser in die Pfanne gießen, sofort mit einem Deckel abdecken und 5-6 Minuten dämpfen, bis es verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit einer vietnamesischen Dippsauce aus Fischsauce, Limettensaft, Wasser, Zucker und gehackten Chilischoten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
