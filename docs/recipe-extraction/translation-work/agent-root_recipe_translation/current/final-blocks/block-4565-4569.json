      "steps": [
        {
          "position": 0,
          "text": "Kohl fein hacken, salzen, 3 Minuten ruhen lassen und anschließend mit Küchenpapier überschüssige Flüssigkeit ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinefleisch, Kohl, Frühlingszwiebeln, Sojasauce, Sesamöl, Ingwer und Knoblauch gut vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein Teigtaschenblatt auf die Arbeitsfläche legen und 1 TL Füllung in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Rand mit Wasser befeuchten, in der Mitte zu einem Halbkreis falten, dann eine Seite in Falten legen und zum Verschließen andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Potsticker mit der flachen Seite nach unten nebeneinander hineinlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2-3 Minuten braten, bis die Unterseiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "0.33 Tassen Wasser dazugeben, die Pfanne mit einem Deckel abdecken und 6-8 Minuten dämpfen, bis das Wasser verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Den Deckel abnehmen und noch 1 Minute braten, damit die Unterseiten wieder knusprig werden, dann mit Dippsauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
