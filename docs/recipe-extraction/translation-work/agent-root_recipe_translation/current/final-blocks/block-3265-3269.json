      "steps": [
        {
          "position": 0,
          "text": "3/4 cup Butter und 1/2 cup braunen Zucker hell und luftig aufschlagen, dann Eier und Vanille einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Backpulver vermengen und unter die flüssigen Zutaten heben, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stroopwafel- oder Waffeleisen auf mittelhohe Hitze vorheizen und leicht einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kleine Portionen Teig in das Eisen drücken und backen, bis beide Seiten goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Noch warm die Waffelhälften sofort mit einer Füllung aus 1/4 cup geschmolzener Butter, 1/2 cup dunklem braunem Zucker, Zimt und Honig zusammensetzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gefüllte Waffel zwischen die beiden Hälften legen und leicht andrücken, dann auf einem Gitter abkühlen und fest werden lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem übrigen Teig und der Füllung wiederholen, bis alle Waffeln fertig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In einem luftdichten Behälter bis zu 5 Tage aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
