      "steps": [
        {
          "position": 0,
          "text": "Honig, 1/2 cup Butter und Zucker in einem Topf erhitzen, bis alles vermischt ist, dann leicht abkühlen lassen und Eier einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl mit Natron und Salz sieben und unter die Honigmischung heben, sodass ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 8-10 gleiche Portionen teilen und jede dünn zwischen Backpapier ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Schicht auf einem Backblech bei 375°F 5-7 Minuten hellgolden backen, dann auf Gittern abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Creme 1 cup Butter mit Kondensmilch und Puderzucker luftig aufschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abgekühlte Honigkuchen mit Creme dazwischen schichten, wie bei einer Torte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Oberseite und Seiten der zusammengesetzten Torte mit der restlichen Creme bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mindestens 4 Stunden kühlen, damit die Schichten weich werden und sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
