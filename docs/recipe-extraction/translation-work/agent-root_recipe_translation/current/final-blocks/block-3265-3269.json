      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350°F vorheizen und eine Gugelhupfform gründlich mit Butter einfetten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker hell und luftig aufschlagen, dann Eier einzeln einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mehl, Maisstärke und Backpulver vermischen und zusammen mit Vanilleextrakt unter die Eiermischung heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in einen Spritzbeutel füllen und konzentrische Kreise auf den Boden der Gugelhupfform spritzen, beginnend in der Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere Schichten aufeinander spritzen, bis die Form vollständig gefüllt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "45-55 Minuten backen, bis ein in die Mitte gesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15 Minuten in der Form abkühlen lassen, dann auf ein Kuchengitter stürzen und vollständig auskühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Geschmolzene Schokotropfen mit Puderzucker und Wasser zu einer Glasur verrühren und über den abgekühlten Kuchen gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
