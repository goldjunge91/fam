              "position": 6,
              "optional": false,
              "source_note": null
            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 190 C/Gasstufe 5 vor. Fette eine Springform mit 23cm Durchmesser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die harten Enden der Orange oben und unten ab. Schneide die Orange in Scheiben und entferne alle Kerne. Püriere die Orange samt Schale in einer Küchenmaschine. Gib ein Drittel des Zuckers und Olivenöl dazu und vermische alles gründlich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Siebe Mehl und Backpulver zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage Eier und restlichen Zucker mit einem elektrischen Handmixer mindestens fünf Minuten, bis die Mischung sehr luftig ist. Hebe die Hälfte der Mehlmischung unter, dann Orange und Vanille und anschließend das restliche Mehl. Vermische alles gut, aber nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße den Kuchenteig in die vorbereitete Form und streiche ihn glatt. Backe ihn im vorgeheizten Ofen 20 Minuten. Reduziere die Ofentemperatur auf 160 C/Gasstufe 2 und backe den Kuchen weitere 30 Minuten. Er sollte goldbraun sein und ein Holzspieß sauber herauskommen. Lass ihn auf einem Kuchengitter abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
