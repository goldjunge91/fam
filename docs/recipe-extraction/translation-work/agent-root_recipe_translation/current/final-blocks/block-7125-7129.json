      "steps": [
        {
          "position": 0,
          "text": "Basmatireis 30 Minuten in Wasser einweichen, dann in Salzwasser kochen, bis er zu 70 % gar ist, und abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Garnelen mit Joghurt, Ingwer-Knoblauch-Paste, Salz und Gewürzen vermischen und dann 20 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebeln in Scheiben schneiden und die Hälfte in Ghee anbraten, bis sie dunkelbraun und knusprig sind, dann beiseite stellen; Mit den restlichen Zwiebeln wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einem Topf mit dickem Boden das restliche Ghee erhitzen und die Hälfte des gekochten Reises auf den Boden legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die marinierten Garnelen gleichmäßig auf dem Reis verteilen und mit dem restlichen Reis belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röstzwiebeln, Koriander und Minze über die oberste Schicht streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decken Sie den Topf mit Folie ab, setzen Sie dann einen dicht schließenden Deckel auf und kochen Sie ihn bei mittlerer Hitze 15 Minuten lang, bis sich Dampf bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Reduzieren Sie die Hitze auf eine niedrige Stufe und lassen Sie es weitere 10 Minuten kochen. Schalten Sie dann die Hitze aus und lassen Sie es 5 Minuten ruhen, bevor Sie es servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
