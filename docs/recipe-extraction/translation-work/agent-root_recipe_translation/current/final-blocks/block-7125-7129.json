      "steps": [
        {
          "position": 0,
          "text": "Warmen Sushi-Reis mit Reisessig, Zucker und Salz würzen und dann auf Zimmertemperatur abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Thunfisch in Sushi-Qualität in kleine Würfel schneiden und mit Sriracha und Mayonnaise in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie ein Nori-Blatt mit der glänzenden Seite nach unten auf eine Bambus-Sushi-Matte und verteilen Sie eine dünne Schicht Reis darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ordnen Sie die würzige Thunfischmischung, die Gurke und die Avocado in einer Linie in der Mitte des Reises an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie die Matte eng von sich weg und versiegeln Sie den Rand mit einem Tupfer Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schneiden Sie die Rolle mit einem scharfen, nassen Messer in 8 Stücke, wobei Sie bei jedem Schnitt eine einzige, gleichmäßige Bewegung ausführen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit Sojasauce, eingelegtem Ingwer und Wasabi servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
