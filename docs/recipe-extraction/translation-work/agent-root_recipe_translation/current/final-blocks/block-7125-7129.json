      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Chilis in einer trockenen Pfanne 2 Minuten rösten, dann 10 Minuten in heißem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eingeweichte Chilis mit 1 Tasse Einweichflüssigkeit und Knoblauch glattrühren und dann durch ein feines Sieb passieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch in einem großen Topf bei mittlerer bis hoher Hitze anbraten und beim Garen auseinanderbrechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebeln dazugeben und ca. 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Chilipüree, Rinderbrühe, Kidneybohnen, Tomatenwürfel, Kreuzkümmel und Chilipulver hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zum Kochen bringen und ohne Deckel 60 Minuten kochen lassen, dabei gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß mit den gewünschten Belägen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
