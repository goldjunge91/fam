          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib die geschnittenen Zwiebeln dazu und brate sie etwa 8 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre die Ingwer-Knoblauch-Paste ein und brate sie 1 Minute, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Tomatenpüree dazu und gare es unter gelegentlichem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Blumenkohl- und Kartoffelstücke dazu, wende sie in der Mischung und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Sahne und Kokosmilch dazu und füge Garam Masala, Salz und schwarzen Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Pfanne ab und lass alles 15-18 Minuten köcheln, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Curry mit frischem Koriander und serviere es heiß mit Reis oder Naan-Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
