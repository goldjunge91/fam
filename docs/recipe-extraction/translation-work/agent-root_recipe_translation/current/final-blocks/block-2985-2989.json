      "steps": [
        {
          "position": 0,
          "text": "Salzwasser in einem großen Topf zum Kochen bringen, Pasta al dente kochen, dann abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einer großen Pfanne bei mittlerer Hitze schmelzen und gewürfelte Zwiebel sowie Knoblauch 3 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Flusskrebsschwanzfleisch hinzufügen und 2 Minuten unter vorsichtigem Rühren erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Sahne und Hühnerbrühe angießen, Cayennepfeffer einrühren und mit Salz sowie schwarzem Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "5 Minuten unter gelegentlichem Rühren köcheln lassen, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gekochte Pasta in die Pfanne geben und vorsichtig wenden, bis sie mit Sauce überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vom Herd nehmen und den größten Teil der Frühlingszwiebeln sowie Parmesan einrühren; etwas zum Garnieren zurückbehalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren und mit den restlichen Frühlingszwiebeln sowie Parmesan garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
