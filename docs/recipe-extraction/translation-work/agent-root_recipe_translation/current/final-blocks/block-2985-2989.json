      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust mit einem Fleischklopfer auf 0.75 inch Dicke klopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Paprikapulver, Cayennepfeffer, Oregano, Basilikum, Knoblauchpulver, Zwiebelpulver, schwarzen Pfeffer und Salz in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Beide Seiten der Hähnchenbrust gründlich mit der Gewürzmischung bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter in einer großen gusseisernen Pfanne bei mittelhoher Hitze erhitzen, bis sie gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen in die Pfanne legen und 3-4 Minuten braten, ohne es zu bewegen, bis sich eine dunkle Kruste bildet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hähnchen wenden und weitere 3-4 Minuten braten, bis es durchgegart und dunkel gewürzt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf einen Teller legen und sofort mit Reis oder Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
