      "steps": [
        {
          "position": 0,
          "text": "Schneide die Kartoffel klein und gare sie 3 Minuten in der Mikrowelle. Brate sie anschließend mit Butter, Knoblauchpulver und Paprika knusprig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre die Eier bei niedriger Hitze vorsichtig und nimm sie früh vom Herd, solange sie gerade gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege Eier, Kartoffeln und Käse in die Mitte einer warmen Tortilla.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Pico de Gallo und einen Löffel saure Sahne darauf. Rolle den Burrito fest auf und brate ihn mit der Naht nach unten in einer heißen, trockenen Pfanne auf jeder Seite 1 Minute an.",
          "timerMinutes": null,
