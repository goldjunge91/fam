      "steps": [
        {
          "position": 0,
          "text": "Blanchiere den Brokkoli 3 Minuten im gesalzenen Nudelwasser und nimm ihn heraus. Lass das Wasser im Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Koche die Pasta im selben Wasser. Bräune währenddessen die zerkrümelte Wurst in Olivenöl an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Chiliflocken dazu und gare alles 1 Minute. Füge Brokkoli hinzu und dünste ihn 5 Minuten, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib die abgetropfte Pasta mit einer Kelle Nudelwasser in die Pfanne und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verfeinere das Gericht mit Parmesan und etwas Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
