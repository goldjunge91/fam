      "steps": [
        {
          "position": 0,
          "text": "Dünste Knoblauch, Rosmarin und Chiliflocken in Olivenöl an, bis sie duften. Gib weiße Bohnen dazu und gare sie 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Brühe dazu und zerdrücke 1/3 der Bohnen, damit die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Spinat dazu und schwenke alles, bis er zusammenfällt. Würze mit Zitronensaft und abgeriebener Zitronenschale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche die Pasta und gib sie mit etwas Nudelwasser zu den Bohnen. Vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Serviere die Pasta großzügig mit Parmesan bestreut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
