      "steps": [
        {
          "position": 0,
          "text": "Schneide Zwiebeln in dünne Streifen und erhitze Olivenöl in einem großen Topf mit schwerem Boden bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zwiebeln hinzu und gare sie 10-15 Minuten langsam unter gelegentlichem Rühren, bis sie sehr weich und karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze Rindfleischstücke mit Salz und Pfeffer, lege sie in die Zwiebeln und bräune sie etwa 8 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein hinzu, löse die gebräunten Röststoffe vom Topfboden und lasse ihn köcheln, bis er größtenteils verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gewürfelten Sellerie, Karotten und Rinderbrühe hinzu. Decke den Topf ab und lasse alles 2 Stunden sanft köcheln, bis das Fleisch zart und die Sauce dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche Spaghetti in kochendem Salzwasser al dente, gieße sie ab und vermische sie mit dem Ragù.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Pasta in Schalen mit geriebenem Parmesan darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
