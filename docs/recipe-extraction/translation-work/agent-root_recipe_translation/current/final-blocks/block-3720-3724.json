      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittelhoher Hitze und dünste gewürfelte Zwiebel und Knoblauch etwa 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Rinder- und Schweinehackfleisch hinzu, zerteile es beim Garen und bräune es 8 Minuten, bis kein Rosa mehr sichtbar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatensauce und Rinderbrühe ein und lasse alles ohne Deckel 1 Stunde unter gelegentlichem Rühren köcheln, bis das Ragù reichhaltig und dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite Béchamelsauce zu: Schmilz Butter in einem Topf, rühre Mehl 1 Minute ein und gieße dann nach und nach warme Milch unter Rühren dazu, bis eine glatte Sauce entsteht. Lasse sie 5 Minuten köcheln und würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Heize den Ofen auf 375°F vor und verteile eine dünne Schicht Fleischragù auf dem Boden einer 9x13 Zoll großen Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte Lasagneplatten, Ragù, Béchamel, Mozzarella und Parmesan und wiederhole, bis alle Zutaten verwendet sind. Beende mit Béchamel und Käse.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Form mit Folie ab und backe sie 25 Minuten. Entferne die Folie und backe sie weitere 15-20 Minuten offen, bis die Oberfläche goldbraun ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse die Lasagne vor dem Anschneiden und Servieren 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
