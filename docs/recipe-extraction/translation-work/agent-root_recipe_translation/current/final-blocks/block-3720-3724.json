      ],
      "steps": [
        {
          "position": 0,
          "text": "Schneide Zwiebeln in dünne Halbmonde und erhitze Olivenöl in einem großen schweren Topf bei mittlerer bis niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zwiebeln hinzu und gare sie 15-20 Minuten langsam unter gelegentlichem Rühren, bis sie tief karamellisiert und weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würze das Rindfleischstück mit Salz und Pfeffer, lege es in die Zwiebeln und bräune es bei mittelhoher Hitze etwa 8 Minuten von allen Seiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Gieße dann Rinderbrühe an und gib gewürfelte Karotten und Sellerie hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 1.5 Stunden sanft köcheln, bis das Rindfleisch sehr zart und die Sauce dick und aromatisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm das Rindfleisch heraus, zupfe es mit zwei Gabeln auseinander und gib es zurück in die Sauce. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche Rigatoni in kochendem Salzwasser al dente, gieße sie ab und vermische sie mit der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Pasta in Schalen mit geriebenem Parmesan darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
