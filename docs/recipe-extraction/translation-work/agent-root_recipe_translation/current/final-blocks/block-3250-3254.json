      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Sahne in einem Topf, bis sie dampft, aber nicht kocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eigelb und Zucker, bis die Masse hell ist. Gieße dann unter ständigem Rühren langsam heiße Sahne hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Mischung durch ein feines Sieb in eine Schüssel, gib Vanille und Salz hinzu und lasse sie leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Creme in vier Förmchen und stelle sie in ein Wasserbad mit heißem Wasser, das bis zur halben Höhe der Förmchen reicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Förmchen 12-15 Minuten, bis die Ränder fest sind und die Mitte beim Rütteln leicht wackelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kühle die Förmchen mindestens 2 Stunden, am besten über Nacht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Streue 1/2 Esslöffel Zucker auf jede Creme und karamellisiere ihn mit einem Brenner goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort nach dem Karamellisieren servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
