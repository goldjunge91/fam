      "steps": [
        {
          "position": 0,
          "text": "Verquirle Eigelb und Zucker über einem Wasserbad, bis die Masse hell und warm ist (160°F), und nimm sie dann vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hebe Mascarpone und Vanilleextrakt unter, bis die Masse glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Sahne steif und hebe sie vorsichtig unter die Mascarpone-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische abgekühlten Espresso mit Kaffeelikör in einer flachen Schale.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauche jeden Löffelbiskuit pro Seite 1 Sekunde rasch in die Espressomischung und lege sie in einer Lage in eine 9x13 Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Hälfte der Mascarponecreme auf der Löffelbiskuitschicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte eine weitere Lage eingetauchter Löffelbiskuits darauf und verteile die restliche Creme darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke die Form ab und stelle sie mindestens 4 Stunden oder über Nacht in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Bestäube das Tiramisu kurz vor dem Servieren großzügig mit Kakaopulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
