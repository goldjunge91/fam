      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine 9x13 Backform mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische gehackte Walnüsse mit Zimt in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege ein Filoteigblatt in die Form und bestreiche es leicht mit geschmolzener Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wiederhole dies mit 5 weiteren Filoteigblättern und bestreiche jedes mit Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Streue 1/3 der Walnussmischung gleichmäßig über den Filoteig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schichte 3 weitere gebutterte Filoteigblätter und weitere 1/3 der Walnüsse darauf. Wiederhole dies mit den letzten 3 Filoteigblättern und den restlichen Walnüssen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege alles mit 5-6 abschließenden gebutterten Filoteigblättern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schneide Baklava mit einem scharfen Messer rauten- oder dreieckförmig bis ganz zum Boden ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Backe das Baklava 35-40 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Erhitze währenddessen Honig, Wasser, Zucker und Zitronensaft 5 Minuten sanft köchelnd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gieße den heißen Sirup sofort nach dem Herausnehmen aus dem Ofen über das heiße Baklava und lasse es vollständig abkühlen.",
