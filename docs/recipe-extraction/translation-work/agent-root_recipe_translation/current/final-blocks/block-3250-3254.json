      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette zwei runde 9-Zoll-Kuchenformen ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle Mehl, Kakaopulver, Zucker, Natron, Backpulver und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle in einer anderen Schüssel Eier, Buttermilch, Öl und Vanille glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die feuchten Zutaten zu den trockenen und rühre alles zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre heißen Kaffee ein, bis der Teig dünnflüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile den Teig auf die vorbereiteten Formen und backe die Kuchen 30-35 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Kuchen 15 Minuten in den Formen abkühlen, stürze sie dann auf Kuchengitter und lasse sie vollständig auskühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schlage Sahne mit Puderzucker steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege eine Kuchenschicht auf eine Tortenplatte, verteile Schlagsahne darauf und schichte abgetropfte Kirschen darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Lege die zweite Kuchenschicht darauf und bestreiche die ganze Torte mit der restlichen Schlagsahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Garniere Oberseite und Seiten mit Schokotropfen und ganzen Kirschen und stelle die Torte bis zum Servieren kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
