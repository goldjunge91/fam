      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 300°F vor und lege Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pulsere Mandelmehl und 1 Tasse Puderzucker, bis die Mischung sehr fein ist, und siebe sie dann, um Klumpen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Eiweiß zu weichen Spitzen und gib nach und nach Kristallzucker hinzu, während du weiterschlägst, bis steife Spitzen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Vanille und Lebensmittelfarbe zum Eiweiß und hebe beides vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die Mandelmehlmischung in drei Portionen unter das Eiweiß und rühre, bis der Teig wie Lava fließt und Spitzen verschwinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle den Teig in einen Spritzbeutel mit runder Tülle und spritze 1-Zoll-Kreise mit 1 Zoll Abstand auf das Backpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klopfe das Backblech fest auf die Arbeitsfläche, um Luftblasen zu lösen, und lasse die Macarons 30 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe sie 15-18 Minuten, bis die Schalen fest sind und Füßchen gebildet haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie 5 Minuten auf dem Blech abkühlen und setze sie dann auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schlage Butter mit 1/2 Tasse Puderzucker zur Füllung auf und spritze sie zwischen die abgekühlten Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
