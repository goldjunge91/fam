      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 180 °C (350 °F) vor. Fette eine Kuchenform ein und lege sie mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage die vier Eier in einer großen Schüssel mit dem Zucker auf, bis sich ihr Volumen verdreifacht hat und die Masse luftig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Siebe das selbsttreibende Mehl und gib es zur Eiermasse. Hebe es unter und erhalte dabei möglichst viel Luftigkeit. Füge die geschmolzene, leicht abgekühlte Butter hinzu und verrühre alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Zimt, eine Prise Salz und Vanilleextrakt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib den gewürfelten Apfel zum Teig und hebe ihn vorsichtig unter, damit die Apfelstücke gleichmäßig verteilt sind. Du kannst die Apfelstücke zusätzlich in etwas Zimt wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Teig in die vorbereitete Kuchenform und streiche die Oberfläche mit einem Teigschaber glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Apfelscheiben auf den Teig und drücke sie leicht an. Bestreue den Kuchen nach Wunsch mit gehobelten Mandeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe den Apfelkuchen im vorgeheizten Ofen etwa 45–50 Minuten, bis ein Holzstäbchen sauber herauskommt, wenn du es in die Mitte steckst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm den Kuchen aus dem Ofen und lass ihn einige Minuten in der Form abkühlen. Löse ihn dann vorsichtig aus der Form und lass ihn auf einem Kuchengitter vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Bestreue den abgekühlten Apfelkuchen mit Puderzucker.",
          "timerMinutes": null,
