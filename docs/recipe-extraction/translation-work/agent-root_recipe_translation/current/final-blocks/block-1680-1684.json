      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 180 °C/Umluft 160 °C/Gasstufe 4 vor. Gib Haferflocken, Kokos, Mehl und Zucker in eine Schüssel. Schmilz die Butter in einem kleinen Topf und rühre den Zuckerrübensirup ein. Löse das Natron in 2 EL kochendem Wasser auf und rühre es dann unter die Sirup-Butter-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drücke eine Mulde in die Mitte der trockenen Zutaten und gieße die Butter-Sirup-Mischung hinein. Rühre vorsichtig um, bis die trockenen Zutaten eingearbeitet sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Setze esslöffelgroße Portionen mit etwa 2.5 cm/1 Zoll Abstand auf gebutterte Backbleche, damit sie auseinanderlaufen können. Backe sie portionsweise 8–10 Minuten, bis sie goldbraun sind. Lege sie zum Abkühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
