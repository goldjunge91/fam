      "steps": [
        {
          "position": 0,
          "text": "Verrühre Milch, Öl und Ei. Siebe Mehl, Backpulver und Salz in die Mischung. Rühre alles gründlich um, bis sich die Zutaten gleichmäßig verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib etwas Teig in die Pfanne und verstreiche eine dünne Schicht bis zum Pfannenrand. Decke die Pfanne 30–60 Sekunden ab, bis kleine Luftbläschen sichtbar werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Butter, Maiscreme, zerstoßene Erdnüsse und Zucker auf den Pfannkuchen. Klappe ihn einmal zusammen, sobald die Unterseite gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide ihn in Stücke. Am besten schmeckt er warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
