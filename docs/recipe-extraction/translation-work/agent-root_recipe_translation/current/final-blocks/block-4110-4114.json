      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und belege ein Backblech mit Backpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Säubere und entschuppe den Fisch, lasse die Schuppen aber dran. Tupfe ihn innen und außen trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage Eiweiß schaumig und vermische es mit grobem Salz, bis die Mischung nassem Sand ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Hälfte der Salzmischung auf dem Backblech und lege den Fisch darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle den Bauch des Fisches mit Zitronenscheiben, Kräutern und Knoblauchzehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bedecke den Fisch vollständig mit der restlichen Salzmischung und drücke sie vorsichtig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe den Fisch 30-35 Minuten, bis die Salzkruste hart und leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Brich die Salzkruste vorsichtig auf und ziehe die Haut ab. Beträufle das Fleisch mit Olivenöl und geschmolzener Butter und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
