      "steps": [
        {
          "position": 0,
          "text": "Vermische Maismehl, warmes Wasser und Salz in einer Schüssel zu einem dicken Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse den Teig 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchte die Hände, forme 8 Kugeln und drücke jede zu einer 3-Zoll dicken Scheibe flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einer Pfanne bei mittelhoher Hitze und brate die Arepas 4-5 Minuten pro Seite goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Arepas aus der Pfanne und schneide sie mit einem scharfen Messer waagerecht auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Arepa mit zerbröseltem Queso Fresco und einem kleinen Stück Butter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Warm servieren, solange die Butter im Inneren schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
