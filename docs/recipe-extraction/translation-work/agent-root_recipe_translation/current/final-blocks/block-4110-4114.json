      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und gib getrocknete Pfirsiche, Zimtstange und Nelken dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lasse alles 15 Minuten köcheln, bis die Pfirsiche weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib braunen Zucker und Salz dazu und rühre, bis sich der Zucker aufgelöst hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Topf vom Herd und gib Zitronensaft dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Mischung vollständig abkühlen und stelle sie mindestens 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Maiskörner aus der Dose ab und verteile sie auf Servierschalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die gekühlte Pfirsichflüssigkeit mit den Pfirsichen über den Mais.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Eiskalt als Frühstück oder leichtes Getränk servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
