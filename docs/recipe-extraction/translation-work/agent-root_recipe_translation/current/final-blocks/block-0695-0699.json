      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375 °F (190 °C) vor. Besprühe eine Muffinform mit 12 Mulden großzügig mit Kochspray.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune das Putenhack in einer Pfanne bei mittlerer bis hoher Hitze und zerteile es dabei. Gib Knoblauch, gewürfelte Zwiebel und Paprika hinzu und gare alles 3 Minuten. Würze mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre den Spinat ein und gare ihn, bis er zusammenfällt. Nimm die Pfanne vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schlage alle 8 Eier in eine große Schüssel und verquirle sie. Rühre die Puten-Gemüse-Mischung und den geriebenen Käse unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteile die Mischung gleichmäßig auf die 12 Muffinmulden, etwa ⅓ Tasse pro Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe die Muffins 18–22 Minuten, bis die Mitte vollständig gestockt und die Oberfläche leicht goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Muffins 5 Minuten abkühlen, bevor du sie herausnimmst. Bewahre sie in einem luftdicht verschlossenen Behälter bis zu 5 Tage im Kühlschrank auf. Erwärme sie 30–45 Sekunden in der Mikrowelle.",
          "timerMinutes": null,
