      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und gewürfelte Zwiebeln und gehackten Knoblauch darin goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl über die angeschwitzten Zutaten streuen und 2 Minuten ständig rühren, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Unter Rühren nach und nach Fischbrühe zugießen, um Klumpenbildung zu vermeiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Safranfäden und Paprika dazugeben und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fisch in Stücke schneiden und vorsichtig in die Brühe geben. 10–12 Minuten garen, bis er undurchsichtig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer würzen und heiß als dicken Eintopf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
