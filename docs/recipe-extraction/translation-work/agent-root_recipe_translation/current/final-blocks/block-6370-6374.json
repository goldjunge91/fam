      "steps": [
        {
          "position": 0,
          "text": "Hefe mit warmem Wasser vermischen und 5 Minuten schaumig rühren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer Schüssel vermischen, dann Hefemischung und Olivenöl hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 8-10 Minuten lang kneten, bis er glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In eine geölte Schüssel geben, abdecken und 45 Minuten gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 3 Portionen teilen und zu flachen Ovalen von etwa 1/2 Zoll Dicke formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf ein mit Backpapier ausgelegtes Backblech legen und 20 Minuten ohne Deckel gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Oberfläche mit Olivenöl bestreichen, mit Rosmarin und grobem Meersalz bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 400 °F 15–18 Minuten backen, bis die Fladen goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
