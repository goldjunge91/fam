      "steps": [
        {
          "position": 0,
          "text": "Mehl, Paprikapulver und Salz in einer Schüssel mischen. Nach und nach Wasser und Olivenöl hinzufügen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 2 Minuten lang kneten, bis er glatt ist, dann 10 Minuten abgedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einem großen Topf Wasser zum Kochen bringen und den Teig in unregelmäßige Stücke reißen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geben Sie die Teigstücke in kochendes Wasser und rühren Sie sie häufig um, um ein Anhaften zu verhindern. Lassen Sie die Teigstücke 15 Minuten lang kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In einer separaten Pfanne gewürfelten Schinken und Knoblauch knusprig anbraten und zur Suppe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlagen Sie die Eier unter leichtem Rühren in den Topf, sodass Eierfäden entstehen, und lassen Sie sie dann weitere 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz würzen und heiß in Schüsseln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
