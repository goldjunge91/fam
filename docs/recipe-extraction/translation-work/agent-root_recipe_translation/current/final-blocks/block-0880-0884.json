      "steps": [
        {
          "position": 0,
          "text": "Dressing zubereiten: 2 EL Olivenöl, Mayonnaise, Zitronensaft, Sardellenpaste, Dijon-Senf, gehackten Knoblauch, Salz und Pfeffer glatt verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Grünkohlblätter von den Stielen streifen und in mundgerechte Stücke zupfen. Die Hälfte des Dressings darübergeben und 2–3 Minuten einmassieren, bis der Kohl weicher wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hähnchen mit Salz, Pfeffer und 1 EL Olivenöl würzen. In einer heißen Pfanne 5–6 Minuten pro Seite braten. Ruhen lassen und in Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Grünkohl auf zwei Schüsseln verteilen. Mit Hähnchenscheiben belegen, das übrige Dressing darüberträufeln und mit Parmesan abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
