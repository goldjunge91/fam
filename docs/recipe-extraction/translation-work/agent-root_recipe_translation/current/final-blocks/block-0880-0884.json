      "steps": [
        {
          "position": 0,
          "text": "Quinoa kochen: 2 Tassen Wasser und Quinoa aufkochen lassen, Hitze reduzieren, abdecken und 15 Minuten köcheln lassen. Mit einer Gabel auflockern und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hähnchenbrüste mit Salz, Pfeffer und gehacktem Knoblauch würzen. In 1 EL Olivenöl bei mittelhoher Hitze 5–6 Minuten pro Seite anbraten, bis sie durchgegart sind. 5 Minuten ruhen lassen, dann in Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das übrige Olivenöl, Zitronensaft, Rotweinessig, Salz und Pfeffer zu einem Dressing verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Spinat auf zwei Schüsseln verteilen. Mit Quinoa, Hähnchenscheiben, gewürfelter Tomate und Gurkenscheiben belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dressing darüberträufeln und Feta darüberbröseln. Sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
