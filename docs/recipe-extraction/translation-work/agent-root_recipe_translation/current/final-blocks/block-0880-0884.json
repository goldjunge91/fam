      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 425°F vorheizen. Süßkartoffeln würfeln und Paprika in Streifen schneiden. Auf einem Backblech mit 1 EL Olivenöl, Salz, Kreuzkümmel und der Hälfte des Knoblauchs vermengen. 25–30 Minuten rösten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Linsen mit 2.5 Tassen Wasser, dem restlichen Knoblauch und einer Prise Salz 20–25 Minuten köcheln lassen, bis sie weich sind. Abgießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das übrige Olivenöl, Rotweinessig, Dijon-Senf, Salz und Pfeffer zu einem Dressing verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Spinat unter die warmen Linsen heben, damit er leicht zusammenfällt. Das geröstete Gemüse dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Dressing über alles träufeln und vorsichtig vermengen. Warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
