      "steps": [
        {
          "position": 0,
          "text": "Verrühre Maisgrieß, Mehl, Zucker, Backpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle das Ei mit der Milch in einer zweiten Schüssel und rühre die Mischung unter die trockenen Zutaten, bis ein glatter Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stecke je einen Holzspieß in ein Ende jedes Würstchens.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf oder Schmortopf bei mittelhoher Hitze auf 375°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tauche jedes Würstchen vollständig in den Teig und gib es vorsichtig ins heiße Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere jeweils 3-4 Stück 2-3 Minuten, wende sie einmal, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Corn Dogs mit einer Zange heraus und lasse sie auf Küchenpapier abtropfen. Serviere sie warm mit Senf oder Ketchup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
