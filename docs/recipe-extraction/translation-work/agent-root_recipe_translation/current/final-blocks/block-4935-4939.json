      "steps": [
        {
          "position": 0,
          "text": "Löse Hefe und Zucker in warmem Wasser auf. Vermische die Flüssigkeit mit Mehl und Salz und knete den Teig 8 Minuten, bis er glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn an einem warmen Ort 1 Stunde gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das Schweinehackfleisch in einer Pfanne mit Öl bei mittlerer Hitze an. Gib Knoblauch und Ingwer dazu und gare alles weitere 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Sojasauce, Sesamöl und gehackte Frühlingszwiebeln unter das gegarte Fleisch und lasse die Füllung vollständig abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 12 Stücke und rolle jedes zu einem 3-Zoll-Kreis aus. Die Ränder sollten dünner sein als die Mitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1 Esslöffel Füllung in die Mitte jedes Teigkreises. Klappe die Ränder hoch und drücke sie oben zusammen, damit die Füllung eingeschlossen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Baozi mit der Naht nach unten auf Backpapierquadrate und lasse sie 20 Minuten ruhen. Dämpfe sie anschließend im Korb 12-15 Minuten, bis sie locker aufgegangen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
