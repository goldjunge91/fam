      "steps": [
        {
          "position": 0,
          "text": "Teile Rinderhackfleisch in zwei Frikadellen und würze sie großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Pfanne bei mittelhoher Hitze und brate die Frikadellen 3-4 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege während der letzten Minute eine Käsescheibe auf jede Frikadelle und decke die Pfanne ab, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste die Hamburgerbrötchen nach Wunsch leicht in der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche die unteren Brötchenhälften mit Mayo und Ketchup und belege sie mit Salat, Tomate und Zwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Cheeseburger-Frikadellen darauf und schließe die Burger mit den oberen Brötchenhälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
