      "steps": [
        {
          "position": 0,
          "text": "Vermische weiche Butter mit gehackter Petersilie, Dill, Knoblauch, Salz und Pfeffer. Stelle sie während der Vorbereitung des Hähnchens kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege Hähnchenbrustfilets zwischen Frischhaltefolie und klopfe sie mit einem Fleischklopfer auf 1/4-inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Kräuterbutter in 3 Portionen und lege jeweils eine in die Mitte eines flach geklopften Hähnchenfilets.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle jedes Filet fest um die Butter, schlage die Seiten ein und stelle es 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle drei flache Schüsseln mit Mehl, verquirlten Eiern und Paniermehl bereit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wende jede Hähnchenrolle erst in Mehl, dann in Ei und anschließend in Paniermehl. Drücke die Panade leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl in einer tiefen Pfanne auf 350°F und lege die panierten Rollen vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Frittiere sie 5-7 Minuten pro Seite, bis sie rundherum goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege sie zum Abtropfen auf Küchenpapier und serviere sie sofort, solange die Buttermitte noch warm ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
