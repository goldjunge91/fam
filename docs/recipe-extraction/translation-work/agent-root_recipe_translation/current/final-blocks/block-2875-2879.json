      "steps": [
        {
          "position": 0,
          "text": "Bringe einen großen Topf Salzwasser zum Kochen und tauche den Kohlkopf vorsichtig 10 Minuten hinein, bis die Blätter weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Kohl heraus und löse die Blätter vorsichtig ab. Lege die größten 10-12 Blätter beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Butter in einer Pfanne und brate gewürfelte Zwiebel weich an. Gib Rinderhackfleisch dazu und brate es krümelig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische gegartes Rindfleisch mit gekochtem Reis und würze großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2-3 tablespoons Füllung auf jedes Kohlblatt, rolle es fest auf und schlage dabei die Seiten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische gewürfelte Tomaten, Tomatenmark und Rinderbrühe in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Hälfte der Tomatenmischung in eine Auflaufform, lege die Rouladen mit der Naht nach unten in einer Lage hinein und gib die restliche Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke die Form mit Folie ab und backe sie bei 350°F 45-50 Minuten, bis die Rouladen durchgewärmt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere das Gericht heiß mit knusprigem Brot und nach Wunsch mit saurer Sahne beträufelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
