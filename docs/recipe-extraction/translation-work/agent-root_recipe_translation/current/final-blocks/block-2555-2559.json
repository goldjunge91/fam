      "steps": [
        {
          "position": 0,
          "text": "Sauerkraut unter kaltem Wasser abspülen und überschüssige Feuchtigkeit ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hälfte des Sauerkrauts in einen großen schweren Topf schichten. Bratwürste, Schweinebauch, Eisbein, geschnittene Zwiebel und Kümmelsamen darauf anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit übrigem Sauerkraut bedecken, Wein, Brühe und Lorbeerblatt hinzufügen. Abdecken und 40–45 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Geschälte Kartoffeln in Stücke schneiden, dazugeben und weitere 15–20 Minuten garen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Alles zusammen in einer großen Schüssel servieren und etwas Garflüssigkeit darüberlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
