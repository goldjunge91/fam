      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 325°F vorheizen und ein großes Blatt Backpapier auf ein Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlitze ins Lamm schneiden und ganze Knoblauchzehen sowie Rosmarinzweige im Fleisch verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lamm von allen Seiten mit Olivenöl, Zitronensaft, Oregano, Salz und Pfeffer einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lamm mittig auf das Backpapier legen, mit geschnittenen Tomaten und Zwiebeln umgeben und mit zerbröckeltem Feta belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backpapier fest um das Lamm falten, sodass ein dichtes Päckchen entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2.5–3 Stunden backen, bis sich das Lamm leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Päckchen vorsichtig von dir weg öffnen, damit der Dampf entweichen kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lamm und Gemüse auf eine Servierplatte geben und Bratensaft darüber gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
