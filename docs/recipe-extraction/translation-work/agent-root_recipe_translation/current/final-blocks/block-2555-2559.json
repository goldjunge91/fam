      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 375°F vorheizen und eine Auflaufform leicht einölen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomaten und Paprika halbieren und mit der Schnittseite nach oben in die Auflaufform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Knoblauch würfeln und über den Gemüsehälften verteilen, zusammen mit ungekochtem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Alles mit Olivenöl beträufeln und mit Oregano, Salz und Pfeffer bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gemüsebrühe vorsichtig um das Gemüse herum angießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Folie abdecken und 50–60 Minuten backen, bis der Reis weich und das Gemüse gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Folie entfernen und weitere 10 Minuten backen, damit die Oberseiten leicht bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit frischer Petersilie garnieren und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
