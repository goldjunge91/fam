          "swap": "weglassen it und hinzufügen ein splash von Wasser plus ein squeeze von Zitrone",
          "savings": "~$0.30"
        },
        {
          "forIngredientId": "shallot",
          "swap": "ein quarter von ein normal yellow Zwiebel",
          "savings": "~$0.40"
        }
      ],
