      "steps": [
        {
          "position": 0,
          "text": "Schneide die Enden der Gurken ab. Drücke jede Gurke auf einem Brett mit der flachen Messerseite oder einem Nudelholz leicht an, bis sie aufplatzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerteile die angedrückten Gurken in grobe, mundgerechte Stücke und gib sie in ein Sieb oder eine Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge die Stücke mit Salz und lasse sie 10-15 Minuten ziehen. Gieße das ausgetretene Wasser ab und tupfe die Gurken trocken, damit der Salat knackig bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verrühre gehackten Knoblauch, Sojasauce, Reisessig, Chiliöl, Sesamöl und Zucker in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße das Dressing über die abgetropften Gurken und vermische alles gründlich, sodass jede aufgebrochene Stelle bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Stelle den Salat für besten Geschmack mindestens 10 Minuten kalt. Bestreue ihn vor dem Servieren mit geröstetem Sesam und Frühlingszwiebel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
