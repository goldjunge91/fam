    {
      "externalId": "waivy:smashed-cucumber-salad",
      "slug": "smashed-cucumber-salad",
      "title": "Gurkensalat mit angedrückten Gurken",
      "instructions": "Kühle, knackige Gurken werden angedrückt und mit einem kräftigen Dressing aus Knoblauch, Sojasauce und Chiliöl vermischt, das in jede aufgebrochene Stelle zieht.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": null,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
