      "steps": [
        {
          "position": 0,
          "text": "Hefe und Zucker in warmem Wasser auflösen und 5 Minuten schaumig rühren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz vermischen, dann mit der Hefemischung vermischen und 8 Minuten lang kneten, bis eine glatte und elastische Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in eine leicht geölte Schüssel geben, mit einem feuchten Tuch abdecken und 30 Minuten gehen lassen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig zusammendrücken und in 4 gleich große Stücke teilen. Jedes Stück zu einem 20-Zoll-Strang rollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Formen Sie jedes Seil in eine Brezelform (ein umgedrehtes U mit gekreuzten und nach unten gedrückten Enden).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Ofen auf 425 °F vorheizen und einen Topf Wasser zum Kochen bringen; das Natron darin auflösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Kochen Sie jede Brezel 30 Sekunden pro Seite, legen Sie sie dann auf ein gefettetes Backblech, bestreichen Sie sie mit zerlassener Butter und bestreuen Sie sie mit Brezelsalz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "12–14 Minuten backen, bis es tief goldbraun ist, und warm mit gelbem Senf zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
