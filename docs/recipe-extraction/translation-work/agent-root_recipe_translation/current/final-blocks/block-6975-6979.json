      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 375 °F vor und legen Sie den gefrorenen Tortenboden in eine 9-Zoll-Kuchenform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomatenscheiben mit Papiertüchern trocken tupfen, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer kleinen Schüssel Mayonnaise, Mozzarella, Frühlingszwiebeln, Basilikum, Knoblauchpulver, Salz und Pfeffer vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hälfte der Käsemischung gleichmäßig auf dem Boden des Tortenbodens verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Hälfte der Tomatenscheiben über die Käsemischung schichten, dann die restliche Käsemischung darauf verteilen und mit den restlichen Tomatenscheiben abschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streuen Sie geriebenen Cheddar-Käse über den Kuchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "30-35 Minuten backen, bis die Kruste goldbraun ist und die Füllung an den Rändern Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Schneiden 10 Minuten abkühlen lassen und warm oder bei Zimmertemperatur servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
