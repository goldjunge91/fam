      "steps": [
        {
          "position": 0,
          "text": "Koche die Reisnudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verrühre Fischsauce, Wasser, Zucker und Limettensaft zu einer Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und brate die Schweinebauchwürfel etwa 8 Minuten knusprig und goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm das Schweinefleisch heraus und stelle es beiseite. Brate anschließend die Fischfilets in der Pfanne 6-8 Minuten, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dünste im selben Pfannenöl gehackten Knoblauch und geschnittene Schalotten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Schweinefleisch zurück in die Pfanne und vermische es mit Knoblauch und Schalotten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile Reisnudeln und Salat auf Schüsseln und belege sie mit der Fisch-Schweinefleisch-Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die Fischsauce darüber und serviere das Gericht mit frischen Kräutern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
