      "steps": [
        {
          "position": 0,
          "text": "Mehl und Eier auf einer Arbeitsfläche vermischen, bis ein glatter Teig entsteht, 10 Minuten lang kneten, bis er elastisch ist, dann 30 Minuten zugedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinder- und Schweinehackfleisch in einer Pfanne bei mittlerer bis hoher Hitze anbraten, dann 2 Esslöffel Parmesan, Salz und Pfeffer unterrühren, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nudelteig mit einer Nudelmaschine sehr dünn ausrollen und in 2 Zoll große Quadrate schneiden. Je einen kleinen Löffel Füllung in die Mitte geben und die Quadrate diagonal zu Dreiecken falten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die beiden Ecken zusammendrücken, sodass die typische Plin-Form entsteht. Auf eine bemehlte Fläche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Salzwasser in einem großen Topf zum Kochen bringen, Agnolotti portionsweise hinzufügen und kochen, bis sie schwimmen, und dann noch 1 Minute weiterkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rinderbrühe und Butter mit Salbeiblättern in einer großen flachen Schüssel erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Agnolotti mit einem Schaumlöffel in die Brühe geben und vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß servieren, mit restlichem Parmesankäse und frischem schwarzem Pfeffer garniert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
