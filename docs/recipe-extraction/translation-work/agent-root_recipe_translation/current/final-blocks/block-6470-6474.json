      "steps": [
        {
          "position": 0,
          "text": "Rinderfilet mit einem scharfen Messer oder einer Aufschnittmaschine in hauchdünne Scheiben schneiden. Alternativ den Metzger darum bitten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Rindfleischscheiben in einer einzigen überlappenden Schicht auf einer gekühlten Platte anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einer kleinen Schüssel natives Olivenöl extra, frischen Zitronensaft, Meersalz und schwarzen Pfeffer verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Olivenölmischung gleichmäßig über die Rindfleischscheiben träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schneiden Sie den Parmesankäse mit einem Sparschäler direkt über dem Rindfleisch in dünne Locken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit frisch gehackter Petersilie bestreuen und bei Bedarf mit einem leichten Spritzer weißem Trüffelöl bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort bei Zimmertemperatur mit knusprigem Brot als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
