      "steps": [
        {
          "position": 0,
          "text": "Kalbshaxen mit Küchenpapier trocken tupfen, mit Salz und Pfeffer würzen, dann leicht im Mehl wenden und überschüssiges Mehl abklopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einem großen Topf mit schwerem Boden oder Schmortopf bei mittlerer bis hoher Hitze erhitzen. Die Kalbshaxen pro Seite 3 Minuten anbraten, dann herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im gleichen Topf gewürfelte Zwiebeln, Sellerie und Karotten etwa 5 Minuten lang anbraten, bis sie weich sind, dann den gehackten Knoblauch 30 Sekunden lang unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Weißwein ablöschen und die gebräunten Reste vom Topfboden lösen. 3 Minuten köcheln lassen, bis der Wein leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kalbshaxen zurück in den Topf geben, gewürfelte Tomaten und Rinderbrühe hinzufügen und aufkochen lassen. Zugedeckt bei 325 °F 2 Stunden im Ofen schmoren, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aus dem Ofen nehmen, das Kalbfleisch auf eine Servierplatte legen und mit Alufolie warm halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Schmorflüssigkeit auf dem Herd bei mittlerer Hitze 5 Minuten köcheln lassen, um die Aromen zu konzentrieren, dann die Soße über das Kalbfleisch löffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Gremolata aus gehackter frischer Petersilie, Zitronenschale und gehacktem Knoblauch belegen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
