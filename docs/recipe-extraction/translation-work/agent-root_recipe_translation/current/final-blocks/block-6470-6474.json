          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Auf ein Papiertuch geben, um überschüssiges Öl abtropfen zu lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Noch warm mit Puderzucker bestäuben und sofort mit Marmelade oder frischen Beeren servieren.",
