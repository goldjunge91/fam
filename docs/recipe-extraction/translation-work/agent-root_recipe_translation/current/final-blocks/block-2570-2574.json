      "steps": [
        {
          "position": 0,
          "text": "Weinblätter unter kaltem Wasser abspülen, trocken tupfen und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel und Knoblauch in einer Pfanne bei mittlerer Hitze 2 Minuten dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hackfleisch dazugeben und etwa 5 Minuten unter Zerteilen anbraten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ungekochten Reis, Minze, Dill, Salz und Pfeffer einrühren und vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ein Weinblatt mit der glänzenden Seite nach unten legen, 1 Esslöffel Füllung nahe am Stiel daraufgeben, Seiten einklappen und fest aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gerollte Dolmades mit der Naht nach unten dicht an dicht in einen Topf legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rinderbrühe und Zitronensaft über die Dolmades gießen und einen Teller darauflegen, damit sie an ihrem Platz bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Zum Kochen bringen, dann Hitze reduzieren, abdecken und 35–40 Minuten köcheln lassen, bis der Reis weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Warm oder bei Zimmertemperatur mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
