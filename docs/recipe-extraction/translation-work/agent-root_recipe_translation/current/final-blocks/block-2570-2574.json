      "steps": [
        {
          "position": 0,
          "text": "Gehackte Zwiebel und Knoblauch in einer Küchenmaschine fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch, Zwiebel-Knoblauch-Mischung, Semmelbrösel, Oregano, Paprika, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung zu einem Laib formen und auf ein mit Folie ausgelegtes Backblech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Olivenöl beträufeln und bei 375°F 35–40 Minuten backen, bis das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gegartes Gyrosfleisch in dünne Streifen schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pitabrot 2 Minuten im Ofen oder in einer Pfanne erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jedes Pitabrot mit Gyrosfleisch, Tomatenscheiben, Zwiebel und einem großzügigen Klecks Tzatziki füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
