      "steps": [
        {
          "position": 0,
          "text": "Tiefgekühlten Spinat auftauen und gründlich ausdrücken, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel und Knoblauch in Olivenöl bei mittlerer Hitze etwa 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Spinat dazugeben und 2 Minuten garen, dann vom Herd nehmen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gegarten Spinat, zerbröselten Feta, Ei, Dill, Salz, Pfeffer und Muskatnuss in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backofen auf 375°F vorheizen und eine Backform von 9x9 mit Olivenöl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "4 Filoteigblätter in die Form legen und jedes mit Olivenöl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Spinat-Feta-Füllung gleichmäßig auf dem Filoteig verteilen, dann die übrigen 4 Filoteigblätter darauflegen und jedes mit Olivenöl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Oberseite in 4 Quadrate einschneiden und 30 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
