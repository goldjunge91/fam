      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Joghurt, Salz, Natron und 2 Esslöffel Öl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach warmes Wasser hinzu und knete einen glatten, weichen Teig. Lasse ihn abgedeckt 45 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische gehackte Zwiebel, grüne Chili, Koriander und Amchur-Pulver in einer kleinen Schüssel zur Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 4 gleich große Portionen und rolle jede zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffel Füllung in die Mitte jedes Kreises, klappe die Ränder ein und drücke den Fladen vorsichtig flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze 1 Esslöffel Öl in einer gusseisernen Pfanne oder auf einer Grillplatte bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gare den Kulcha je Seite 3-4 Minuten goldbraun und aufgegangen; drücke ihn dabei leicht mit dem Pfannenwender an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Butter, Pickles und Chole (Kichererbsen) servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
