      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Maismehl, Weizenmehl, Salz, grüne Chilis und Kreuzkümmelsamen in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Ghee hinzu und verreibe es mit der Mehlmischung, bis sie an Semmelbrösel erinnert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib nach und nach warmes Wasser hinzu und knete einen weichen Teig. Füge bei Bedarf mehr Wasser hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 6-8 gleich große Portionen und forme Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine gusseiserne Pfanne oder Grillplatte bei mittelhoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege eine Teigkugel zwischen zwei Stücke Frischhaltefolie und drücke sie zu einer dünnen Scheibe von etwa 8 Zoll Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie in die heiße Pfanne und gare sie 1-2 Minuten, bis goldene Flecken entstehen. Wende sie und gare die andere Seite knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreiche sie direkt nach dem Garen mit Ghee und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
