      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schweinehackfleisch hinzu und zerteile es mit einem Pfannenwender. Brate es etwa 5 Minuten, bis es gebräunt und gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch und Ingwer hinzu und brate alles 30 Sekunden unter Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehacktes eingelegtes Gemüse hinzu und brate es 2 Minuten unter Rühren, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Sojasauce, Zucker und Wasser hinzu und lasse alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Beträufle das Gericht mit Sesamöl und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib es auf eine Servierplatte und garniere es vor dem Servieren mit gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
