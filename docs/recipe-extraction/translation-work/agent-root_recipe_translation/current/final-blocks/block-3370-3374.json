      "steps": [
        {
          "position": 0,
          "text": "Vermische Joghurt, Ingwer-Knoblauch-Paste, rotes Chilipulver, Kurkuma, Garam Masala, Zitronensaft und Salz in einer Schüssel zu einer Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide Paneer in 1 Zoll große Würfel, gib sie zur Marinade und vermische alles gut. Stelle es mindestens 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Paprika und rote Zwiebel in 1 Zoll große Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke marinierten Paneer, Paprika und Zwiebel abwechselnd auf Metallspieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl in einer großen gusseisernen Pfanne oder Grillpfanne bei mittelhoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Spieße in die heiße Pfanne und gare sie 8-10 Minuten. Wende sie alle 2 Minuten, bis Paneer goldbraune Röststellen bekommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie auf eine Servierplatte und serviere sie heiß mit Zitronenspalten und Minz-Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
