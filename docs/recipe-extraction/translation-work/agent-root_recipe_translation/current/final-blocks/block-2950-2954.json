      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz, Kondensmilch und 2 tablespoons Öl mit warmem Wasser zu einem weichen Teig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig 10 Minuten glatt kneten und dann abgedeckt 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 3 gleiche Portionen teilen und jede zu einer Kugel rollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf einer geölten Fläche eine Kugel von der Mitte nach außen sehr dünn ziehen, bis sie fast durchsichtig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den gezogenen Teig zu einem Quadrat falten und dann fest zu einer Spirale aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Restliches Öl in einer großen Pfanne bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Spirale 1-2 Minuten pro Seite goldbraun und knusprig braten und dabei vorsichtig mit einem Pfannenwender flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier legen und warm mit Currysauce zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
