      "steps": [
        {
          "position": 0,
          "text": "Ochsenschwanzstücke 2 Minuten in kochendem Wasser blanchieren, dann abgießen und gründlich unter kaltem Wasser abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "10 cups frisches Wasser in einem großen Topf zum Kochen bringen und die gereinigten Ochsenschwanzstücke hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ohne Deckel 30 Minuten köcheln lassen und Schaum sowie Verunreinigungen von der Oberfläche abschöpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Karotten, Kartoffeln und Zwiebel in Stücke schneiden; Knoblauch und Ingwer zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gemüse, Knoblauch, Ingwer, Sternanis und Zimt in die Brühe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 60-75 Minuten köcheln lassen, bis der Ochsenschwanz sehr zart ist und sich das Fleisch leicht vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zimtstange und Sternanis entfernen, dann mit Sojasauce, Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In Schalen schöpfen und mit geschnittenen Frühlingszwiebeln garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
