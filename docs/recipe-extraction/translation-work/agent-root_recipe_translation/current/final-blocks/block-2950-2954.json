      "steps": [
        {
          "position": 0,
          "text": "Rote Chilis, Schalotten, Knoblauch, Ingwer und Galgant mit 1/4 cup Wasser glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf mit schwerem Boden oder Schmortopf erhitzen und die Paste 3-4 Minuten anbraten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hähnchenteile hinzufügen und 5 Minuten pfannenrühren, bis sie teilweise gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kokosmilch angießen und zerdrücktes Zitronengras, Salz sowie braunen Zucker hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Leicht köcheln lassen und ohne Deckel 50-60 Minuten garen; gelegentlich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitergaren, bis die Sauce einkocht und das Hähnchen mit einer kräftigen, dunkelbraunen Schicht überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zitronengrasstängel entfernen, abschmecken und mit Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
