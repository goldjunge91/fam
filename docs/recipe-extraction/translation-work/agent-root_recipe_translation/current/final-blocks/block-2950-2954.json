      "steps": [
        {
          "position": 0,
          "text": "Chinesische Wurst dünn schneiden und in kleine Stücke würfeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1 Esslöffel Öl in einem großen Wok oder einer Pfanne bei starker Hitze erhitzen und die Wurst braten, bis sich die Ränder kräuseln; dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "1 Esslöffel Öl hinzufügen und Garnelen 2-3 Minuten rosa braten; beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier mit einer Gabel verquirlen und im restlichen Öl auf einer Seite des Woks stocken lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Alle Zutaten an den Rand schieben, Reisnudeln und die restlichen 2 tablespoons Öl dazugeben und die Nudeln beim Erwärmen auseinanderziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehackten Knoblauch hinzufügen und alles 1 Minute vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sojasauce und dunkle Sojasauce über die Nudeln gießen und 2-3 Minuten ständig wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garnelen und Wurst zurück in den Wok geben, Sojasprossen und Schnittlauch hinzufügen und noch kurz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Mit weißem Pfeffer würzen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
