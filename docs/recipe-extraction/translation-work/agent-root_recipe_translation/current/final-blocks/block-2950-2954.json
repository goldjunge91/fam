      "steps": [
        {
          "position": 0,
          "text": "Eiernudeln nach Packungsanweisung kochen, abgießen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rote Chilis mit Knoblauch und 2 tablespoons Wasser glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel würfeln, Karotte in feine Streifen schneiden und Kohl fein hobeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einem Wok oder einer großen Pfanne bei mittelhoher Hitze erhitzen und die Chili-Knoblauch-Paste 1 Minute anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "An den Rand schieben, Eier in den Wok schlagen und stocken lassen, bis sie teilweise gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zwiebel, Karotte und Kohl hinzufügen und 2-3 Minuten rühren, bis das Gemüse weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gekochte Nudeln, Sojasauce und Chilisauce hinzufügen und alles 2 Minuten vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Limettensaft und geschnittenen Frühlingszwiebeln abschließen und vor dem Servieren vorsichtig wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
