          "position": 0,
          "text": "Stiele und Samen der getrockneten Chilis entfernen. Chilis 1 Minute in einer trockenen Pfanne rösten und anschließend 15 Minuten in heißem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die eingeweichten Chilis mit 0.5 cup Einweichwasser, Knoblauch und Essig zu einer Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Schweinefleischscheiben mit der Chilipaste bestreichen und 10 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer Pfanne bei mittlerer bis hoher Hitze erhitzen. Das Fleisch darin 8-10 Minuten braten, bis es gebräunt und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In den letzten 2 Minuten der Garzeit Ananas und Zwiebel dazugeben und erwärmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Tortillachips auf einer Platte anrichten, die Schweinefleisch-Ananas-Mischung darauf verteilen und mit Cotija bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Koriander garnieren, Limettensaft darüberpressen und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
