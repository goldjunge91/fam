      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Chilis 1 Minute in einer trockenen Pfanne rösten, entkernen und 20 Minuten in heißem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die weichen Chilis mit 1 cup Einweichwasser, Tomatenmark, Essig und Kreuzkümmel zu einer Soße pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderschulter mit Salz und Pfeffer würzen und in einer heißen Pfanne von allen Seiten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Fleisch mit Rinderbrühe in einen Schongarer geben, Chilisauce darüber gießen und 6-8 Stunden auf niedriger Stufe garen, bis es zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Fleisch direkt in der Garflüssigkeit zerpflücken. Die Flüssigkeit ist die Birria-Brühe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pommes nach Packungsanweisung goldbraun und knusprig backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die heißen Pommes mit zerpflücktem Birria-Fleisch, geschmolzenem Käse, gewürfelter Zwiebel und Koriander belegen. Mit einer Tasse Birria-Brühe zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
