      "steps": [
        {
          "position": 0,
          "text": "Griechischen Joghurt, Tandoori-Paste, Zitronensaft, gehackten Knoblauch und Ingwer in einer Schüssel verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Lachsfilets trocken tupfen und beide Seiten großzügig mit der Tandoori-Mischung bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bei Zimmertemperatur 10–15 Minuten marinieren lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer Pfanne bei mittelhoher Hitze erhitzen, bis es leicht zu schimmern beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Lachs mit der Hautseite nach oben in die Pfanne legen und 4–5 Minuten braten, ohne ihn zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Den Lachs wenden und weitere 3–4 Minuten braten, bis er durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Tellern anrichten, mit Koriander und Limettenspalten garnieren und mit Gurkenscheiben servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
