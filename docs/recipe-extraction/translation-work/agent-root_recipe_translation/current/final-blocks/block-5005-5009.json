          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Das Ceviche in Schalen anrichten und jeweils mit geschnittener Avocado belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit gekochten Süßkartoffelwürfeln und Maiskörnern als Beilage servieren.",
