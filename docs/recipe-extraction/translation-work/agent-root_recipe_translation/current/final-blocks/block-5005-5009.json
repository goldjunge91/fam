      "steps": [
        {
          "position": 0,
          "text": "Das Hähnchen in mundgerechte Stücke schneiden und mit Maisstärke, Mehl, Salz und Pfeffer vermengen, bis alles überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Wok oder einer Pfanne bei starker Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hähnchenstücke hineingeben und rundherum etwa 8–10 Minuten goldbraun braten. Herausnehmen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Im selben Wok gehackten Knoblauch und Ingwer 30 Sekunden unter Rühren braten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Zwiebeln und ganze rote Chilis hinzufügen und 2 Minuten garen, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Hähnchen zurück in den Wok geben. Sojasauce, Essig und Hühnerbrühe hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Alles 2–3 Minuten vermengen, bis die Sauce das Hähnchen gleichmäßig überzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit gedämpftem Reis oder Nudeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
