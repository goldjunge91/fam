      "steps": [
        {
          "position": 0,
          "text": "Lauwarme Milch, Hefe und 1 EL Zucker verrühren und 5 Minuten stehen lassen, bis die Mischung schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, restlichen Zucker und Salz vermengen. Hefemischung und 2 EL geschmolzene Butter hinzufügen und 10 Minuten kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in einer geölten Schüssel 45 Minuten gehen lassen, bis er sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schweinefleisch mit Zwiebel und Fischsauce in einer Pfanne 8 Minuten anbraten. Abkühlen lassen und mit Frühlingszwiebeln vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 8 Portionen teilen, jeweils flach ausrollen und mit der Schweinefleischmischung sowie einer halben Eihälfte füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Teigtaschen gut verschließen, mit der Naht nach unten auf Backpapierquadrate setzen und 20 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einem Bambusdämpfer oder in einem Topf mit Dämpfeinsatz über kochendem Wasser 15 Minuten dämpfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Herausnehmen, mit der restlichen geschmolzenen Butter bestreichen und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
