          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jedes warme Fladenbrot mit Tzatziki bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Pitas mit gebratenem Hähnchen, Tomate, Gurke und roter Zwiebel füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fest aufrollen, in Folie einwickeln und sofort servieren.",
