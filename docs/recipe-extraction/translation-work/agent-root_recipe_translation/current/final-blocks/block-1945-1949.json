      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 350 °F (180 °C) vorheizen und ein großes Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter, weißen Zucker und Ei in einer Küchenmaschine mit Flachrührer cremig schlagen. Melasse und Vanille dazugeben und glatt rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Natron-Wasser-Mischung dazugeben und weitere eine Minute verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Trockene Zutaten vermischen: Backpulver, Zimt, Mehl und Salz in einer separaten Schüssel verrühren, dann nach und nach bei niedriger Geschwindigkeit unter die feuchten Zutaten mischen. Schüsselrand abkratzen, bis alles gut vermengt ist. Der Teig sollte sich gut formen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig mit einem kleinen Löffel portionieren, zu Kugeln rollen und auf das Blech legen. Mit einem bemehlten Glas oder der angefeuchteten Handfläche zu flachen Scheiben drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kekse auf mit Backpapier ausgelegte Bleche legen und 10-12 Minuten backen. Aus dem Ofen nehmen und mindestens 10 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nach dem Abkühlen zwei Kekse mit mindestens zwei Teelöffeln Lieblingsmarmelade zu einem Sandwich zusammensetzen. Wiederholen und mit einer Tasse Tee genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
