    {
      "externalId": "waivy:toh-sweet-n-spicy-chicken",
      "slug": "toh-sweet-n-spicy-chicken",
      "title": "Süß-scharfes Hähnchen",
      "instructions": "Zarte Hähnchenwürfel mit Taco-Gewürz und glänzender Glasur aus stückiger Salsa und Fruchtkonfitüre, über lockerem Reis serviert: ein schnelles Abendessen für unter der Woche, in 20 Minuten fertig. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/sweet-n-spicy-chicken/",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Verwende Hähnchenschenkel statt Hähnchenbrust. Sie sind pro Pfund günstiger und bleiben beim Anbraten saftiger.",
        "Nimm eine beliebige Fruchtkonfitüre, die du schon zu Hause hast, statt nur für dieses Gericht Pfirsichkonfitüre zu kaufen.",
        "Koche eine große Menge einfachen Reis und friere Portionen ein. So brauchst du an hektischen Abenden kein Essen zu bestellen."
      ],
      "substitutions": [
        {
          "forIngredientId": "chicken-breast",
          "swap": "Hähnchenschenkel für ein saftigeres, günstigeres Stück",
          "savings": "~$0.20 pro Portion"
        },
        {
          "forIngredientId": "apricot-jam",
          "swap": "Beliebige Pfirsich- oder Aprikosenkonfitüre oder sogar Orangenmarmelade",
          "savings": "Verwende, was du hast"
        },
        {
          "forIngredientId": "canola-oil",
          "swap": "Beliebiges neutrales Öl wie Pflanzen- oder Reiskleieöl",
          "savings": "Vorratszutat"
        }
      ],
