      "steps": [
        {
          "position": 0,
          "text": "Brate das Rinderhack in einer großen schweren oder gusseisernen Pfanne bei mittlerer Hitze, bis es gar ist. Gieße dann das Fett ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Taco-Gewürz ins Rindfleisch. Nimm die Mischung aus der Pfanne und stelle sie beiseite. Wische die Pfanne sauber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme Bohnenmus in einem kleinen Topf bei mittelniedriger Hitze 2 bis 3 Minuten, bis es heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verstreiche etwa 1/3 cup Bohnen leicht seitlich mittig auf jeder warmen Tortilla, gib etwa 1/4 cup gewürztes Rindfleisch darauf und bestreue es mit geriebenem Colby-Jack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Klappe Seiten und Enden jeder Tortilla ein und rolle sie dann fest auf, sodass die Füllung eingeschlossen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Rapsöl in derselben Pfanne bei mittelhoher Hitze und bräune die Burritos rundherum, bis sie goldbraun und knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm mit saurer Sahne und Salsa oder deinen Lieblingsbeilagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
