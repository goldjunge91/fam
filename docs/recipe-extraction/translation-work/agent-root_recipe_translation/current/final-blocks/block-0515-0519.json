    {
      "externalId": "waivy:toh-tasty-burritos",
      "slug": "toh-tasty-burritos",
      "title": "Herzhafte Burritos",
      "instructions": "Deftige Burritos mit Rindfleisch und Bohnen, knusprig in der Pfanne gebräunt und innen mit geschmolzenem Colby-Jack-Käse gefüllt. Schnell genug für unter der Woche und einfach zu rollen. Dazu passen saure Sahne und ein Löffel Salsa. Rezept von Taste of Home: https://www.tasteofhome.com/recipes/tasty-burritos/",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 10,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Mische Taco-Gewürz selbst aus Chilipulver, Kreuzkümmel, Knoblauchpulver und Paprika aus dem Vorrat und spare dir die Gewürzpackung.",
        "Kaufe Rinderhack in einer größeren Familienpackung und friere es in Portionen zu 1 pound ein. So sinken die Kosten pro Mahlzeit.",
        "Ersetze die Hälfte des Rindfleischs durch eine zusätzliche Dose Bohnen. Das streckt die Füllung und senkt den Preis weiter."
      ],
      "substitutions": [
        {
          "forIngredientId": "ground-beef",
          "swap": "Putenhack oder gewürzte schwarze Bohnen",
          "savings": "Pute ist magerer; Bohnen senken die Kosten um ~$1 pro Portion"
        },
        {
          "forIngredientId": "colby-jack",
          "swap": "Geriebener Cheddar",
          "savings": "Ähnlicher Preis, oft ein paar Cent günstiger"
        },
        {
          "forIngredientId": "canola-oil",
          "swap": "Pflanzen- oder Avocadoöl",
          "savings": "Verwende ein neutrales Öl, das du bereits hast"
        }
      ],
