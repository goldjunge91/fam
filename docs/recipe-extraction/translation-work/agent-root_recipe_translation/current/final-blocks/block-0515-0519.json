      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in 1/2-inch-Würfel und wende sie in einer flachen Schüssel im Taco-Gewürz, bis jedes Stück bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Rapsöl in einer großen Pfanne bei mittelhoher Hitze und brate das Hähnchen unter Rühren, bis es gar und in der Mitte nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Salsa und Aprikosen- (oder Pfirsich-)konfitüre und gieße die Mischung mit dem Hähnchen in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bring alles zum Kochen, reduziere dann die Hitze, decke die Pfanne ab und lass es 2 bis 3 Minuten köcheln, bis es heiß ist und glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Löffle das süß-scharfe Hähnchen über heißen gekochten Reis und serviere es.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
