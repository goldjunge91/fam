      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Eier, Milch, Salz, Zucker und 2 Esslöffel geschmolzene Butter zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine beschichtete Pfanne bei mittelhoher Hitze und fette sie leicht mit Öl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße 1/4 Tasse Teig in die Mitte und schwenke die Pfanne sofort, damit sich der Teig dünn zu einem 7 Zoll großen Kreis verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe den Palatschinken 1–2 Minuten, bis die Unterseite hell goldbraun ist. Wende ihn und backe die andere Seite 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege ihn auf einen Teller und wiederhole den Vorgang mit dem restlichen Teig, bis 8–10 Palačinke entstanden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreiche jede warme Palačinka mit 1–2 Esslöffeln Marmelade oder Nutella, falte sie zu Vierteln und bestäube sie vor dem Servieren mit Puderzucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
