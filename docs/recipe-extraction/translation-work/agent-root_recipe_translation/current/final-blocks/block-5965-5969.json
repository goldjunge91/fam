      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Wasser, Salz und 1 Esslöffel geschmolzene Butter zu einem weichen Teig. Knete ihn 3 Minuten und lasse ihn zugedeckt 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Rinderhackfleisch, gehackte Zwiebel, Salz und schwarzen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 8 gleich große Kugeln. Rolle jede dünn zu einem 6 Zoll großen Kreis aus und gib 2 Esslöffel Füllung auf eine Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Klappe den Teig über der Füllung zusammen, drücke die Ränder fest zu und versiegle sie mit einer Gabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das Öl in einer tiefen Pfanne auf 350 °F und frittiere die Tschebureki auf jeder Seite 2–3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm mit saurer Sahne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
