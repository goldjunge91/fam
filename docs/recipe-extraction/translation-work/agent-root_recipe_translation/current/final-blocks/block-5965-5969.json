      "steps": [
        {
          "position": 0,
          "text": "Entferne die Silberhaut auf der Rückseite der Rippchen und schneide den überstehenden Fleischlappen an der Unterseite ab, damit die typische St.-Louis-Form entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische braunen Zucker, Paprikapulver, schwarzen Pfeffer, Knoblauchpulver und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche beide Seiten der Rippchen mit gelbem Senf und bedecke sie anschließend großzügig mit der Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Grill oder Ofen auf 300 °F vor und lege die Rippchen mit der Fleischseite nach oben darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare sie 2-2.5 Stunden, bis das Fleisch zart ist, sich aber noch nicht vom Knochen löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische BBQ-Sauce mit Apfelessig und bestreiche die Rippchen damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Grille oder backe sie weitere 15–20 Minuten, bis die Sauce karamellisiert ist. Nimm sie heraus und lasse sie 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
        {
          "storagePath": null,
          "localPath": null,
