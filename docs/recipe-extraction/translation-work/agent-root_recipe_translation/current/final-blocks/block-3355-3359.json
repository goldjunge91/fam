        {
          "position": 0,
          "text": "Süßkartoffeln dämpfen oder kochen, bis sie vollständig gar sind, dann ganz abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gekochte Süßkartoffeln gründlich zerstampfen und in einem sauberen Glas mit Koji-Sporen vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mischung bei Raumtemperatur (68-75°F) 48 Stunden mit Käsetuch abgedeckt stehen lassen und täglich umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hefe und Zucker zur Koji-Mischung geben und gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Locker abdecken und 7-14 Tage bei Raumtemperatur fermentieren lassen; alle 2-3 Tage umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Durch ein Käsetuch in saubere Flaschen abseihen und verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Verzehr an einem kühlen, dunklen Ort mindestens 3 Monate reifen lassen.",
