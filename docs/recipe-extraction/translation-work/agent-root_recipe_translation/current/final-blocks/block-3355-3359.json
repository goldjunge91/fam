      "steps": [
        {
          "position": 0,
          "text": "Schweinefleisch in 3-inch-Würfel schneiden und 3 Minuten in kochendem Wasser blanchieren, dann abgießen und abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Einen Topf bei mittelhoher Hitze erhitzen und Schweinefleisch hineingeben; etwa 4 Minuten von allen Seiten leicht anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ingwer und Knoblauch hinzufügen und 1 Minute rühren, bis alles duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wasser, Sojasauce, Mirin und Sake angießen, aufkochen und dann die Hitze auf mittelniedrig reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "20 Minuten köcheln lassen, dann Daikon-Rettich hinzufügen und weitere 8 Minuten köcheln lassen, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abschmecken und vor dem Servieren mit geschnittener Frühlingszwiebel garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
