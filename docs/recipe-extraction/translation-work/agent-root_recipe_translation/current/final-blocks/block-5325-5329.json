      "steps": [
        {
          "position": 0,
          "text": "Klopfe die Hähnchenbrust flach, schneide sie in mundgerechte Stücke und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Hähnchenstücke kurz in Öl, bis sie gar sind, und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage die Eier gründlich auf und gieße sie für eine glatte Konsistenz durch ein feines Sieb.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze die Butter in einer beschichteten Pfanne bei mittlerer Hitze und gieße eine dünne Schicht Ei hinein. Lass sie gerade eben stocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege eine Reihe gegarter Hähnchenstücke mittig auf die Eierschicht, rolle sie fest auf, schneide die Rolle in Scheiben und richte sie auf einem Teller an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verrühre Sojasauce und Reisessig zu einer leichten Dip-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
