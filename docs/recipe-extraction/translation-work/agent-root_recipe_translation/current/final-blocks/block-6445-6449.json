      "steps": [
        {
          "position": 0,
          "text": "Schrubbe die Muscheln unter kaltem fließendem Wasser ab, um Sand und Schmutz zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dämpfe die Muscheln mit 1/4 cup Wasser etwa 8 Minuten in einem Topf, bis sie sich öffnen. Wirf geschlossene Muscheln weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Löse die Muscheln aus den Schalen, bewahre die 12 tiefsten Schalenhälften auf und hacke das Muschelfleisch grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz Butter in einer Pfanne und dünste Zwiebel und Knoblauch etwa 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Semmelbrösel, Petersilie, gehacktes Muschelfleisch, Weißwein, Zitronensaft, Salz und Pfeffer unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Muschelschalen auf ein Backblech und fülle jede mit etwa 2 Esslöffeln der Mischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Muscheln bei 425°F 12 Minuten, bis die Füllung goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere heiß mit zusätzlichen Zitronenspalten.",
