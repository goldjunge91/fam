      "steps": [
        {
          "position": 0,
          "text": "Koche die Hummerschwänze 8 Minuten in Salzwasser. Lass sie leicht abkühlen, löse das Fleisch aus und bewahre die Schalen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 Esslöffel Butter in einer Pfanne und brate Schalotten und Pilze etwa 5 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Weißwein und Fischbrühe dazu und lasse die Flüssigkeit etwa 5 Minuten bis auf die Hälfte einkochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Sahne, Eigelb und Senf in einer Schüssel. Rühre die Mischung langsam unter ständigem Rühren in die Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die übrigen 2 Esslöffel Butter, Salz und Cayennepfeffer ein und hebe das Hummerfleisch unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Hummermischung auf die aufbewahrten Schalen und bestreue sie mit Gruyère.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die gefüllten Schalen bei 400°F 8 Minuten, bis die Oberfläche goldbraun ist und blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sofort auf vorgewärmten Tellern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
