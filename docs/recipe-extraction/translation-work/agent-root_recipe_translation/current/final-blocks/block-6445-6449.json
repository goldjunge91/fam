      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und lege Backbleche mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter in einem Topf bei niedriger Hitze. Rühre Zucker, Mehl, Salz und Honig glatt ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Topf vom Herd und hebe die Sahne vorsichtig unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze teelöffelgroße Teigportionen mit 3 inches Abstand auf die vorbereiteten Bleche.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe sie 8-10 Minuten, bis die Ränder goldbraun, die Mitte aber noch leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Crêpes 30 Sekunden auf dem Blech abkühlen und rolle jede dann rasch um den Stiel eines Kochlöffels zu einer Rolle.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass sie auf einem Kuchengitter vollständig abkühlen und knusprig werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bewahre sie bis zu 5 Tage in einem luftdichten Behälter auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
