      "steps": [
        {
          "position": 0,
          "text": "Zerkleinere die Schweineleber in einem Mixer grob und vermische sie anschließend mit Hackfleisch und Rückenspeck.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste Schalotten und Knoblauch etwa 3 Minuten in einer Pfanne weich und gib sie zur Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Thymian, Cognac, Salz und Pfeffer gründlich unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege eine Kastenform oder Terrinenform leicht überlappend mit Schweinebauchstreifen aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die Pastetenmasse ein und drücke sie fest, damit keine Luftlöcher bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe die Schweinebauchstreifen über die Masse und lege ein Lorbeerblatt darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke die Form mit Folie ab, stelle sie in ein Wasserbad und backe die Pastete bei 325°F 50 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Form aus dem Ofen und lass die Pastete auf Zimmertemperatur abkühlen. Stelle sie vor dem Servieren mindestens 8 Stunden kalt und serviere sie mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
