      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter in 2-inch große Würfel schneiden und mit Schmalz, Salz, Knoblauch und Oregano in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ohne Deckel bei mittlerer bis niedriger Hitze 2 Stunden garen. Dabei gelegentlich umrühren, bis das Fleisch sehr zart ist und das Fett ausgelassen wurde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Hitze auf mittlere bis hohe Stufe erhöhen und weitere 30 Minuten unter häufigem Rühren garen, bis die Ränder knusprig und goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Carnitas auf Küchenpapier abtropfen lassen und in mundgerechte Stücke zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Ofen auf 375°F vorheizen und Tortillachips auf einem Backblech verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Chips mit zerpflückten Carnitas und Oaxaca-Käse belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "8-10 Minuten backen, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren mit eingelegten Jalapeños, gewürfelter Zwiebel, Koriander und Limettensaft belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
