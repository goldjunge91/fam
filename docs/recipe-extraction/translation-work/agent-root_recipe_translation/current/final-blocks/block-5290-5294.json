      "steps": [
        {
          "position": 0,
          "text": "Speck in einer Pfanne knusprig braten, auf Küchenpapier abtropfen lassen und zerbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kartoffeln in Pommes schneiden, 15 Minuten in kaltem Wasser einweichen und trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Öl auf 350°F erhitzen. Pommes portionsweise 12-15 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Auf Küchenpapier abtropfen lassen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "In derselben Speckpfanne die Butter schmelzen und die Eier bei mittlerer Hitze etwa 4 Minuten fluffig zu Rührei braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Pommes auf Serviertellern anrichten und mit geriebenem Cheddar belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rührei daraufgeben und mit zerbröseltem Speck und frischem Schnittlauch bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
