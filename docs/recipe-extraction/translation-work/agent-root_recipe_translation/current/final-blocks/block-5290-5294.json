      "steps": [
        {
          "position": 0,
          "text": "Rinderschulter mit Rinderbrühe, Apfelessig, Kreuzkümmel und Oregano in einen Schongarer geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Auf niedriger Stufe 6 Stunden oder auf hoher Stufe 4 Stunden garen, bis sich das Fleisch leicht mit einer Gabel zerpflücken lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Fleisch herausnehmen und mit zwei Gabeln zerpflücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Ofen auf 375°F vorheizen und Tortillachips auf einem Backblech verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Chips mit zerpflücktem Barbacoa und Oaxaca-Käse belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "8-10 Minuten backen, bis der Käse geschmolzen ist und Blasen wirft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit eingelegten Zwiebeln, Jalapeños, Koriander und Limettensaft belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit zusätzlichen Limettenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
