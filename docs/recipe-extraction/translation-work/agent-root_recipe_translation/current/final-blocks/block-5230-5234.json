      "steps": [
        {
          "position": 0,
          "text": "Teile das Rinderhackfleisch in zwei Portionen und forme daraus vorsichtig quadratische Pattys, die etwas größer als die Brötchen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze beide Seiten mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine flache Grillplatte oder Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate die Pattys je Seite 2.5–3 Minuten, bis die Kerntemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege in den letzten 30 Sekunden je eine Scheibe Käse auf jedes Patty.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Brötchen leicht auf der Grillplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche die unteren Brötchenhälften mit Senf und Ketchup und belege sie mit Patty, Käse, Tomate, Salat und Gewürzgurken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
