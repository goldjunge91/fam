      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweineschulter in 2 Zoll große Würfel und bräune sie in Öl bei mittelhoher Hitze je Seite 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Schweinefleisch heraus und stelle es beiseite. Bewahre den Bratensatz im Topf auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weiche getrocknete Ancho- und Pasilla-Chilis 15 Minuten in heißem Wasser ein und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Püriere eingeweichte Chilis mit Knoblauch, Zwiebel, Tomate und 1 Tasse Brühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Seihe die Sauce durch ein feines Sieb zurück in den Topf zum Bratensatz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Sauce 3 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib gebräuntes Schweinefleisch, die restliche Brühe, Ananasstücke und gewürfelten Apfel hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse alles zugedeckt 30-35 Minuten köcheln, bis das Schweinefleisch zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Probiere das Gericht, passe Salz und Pfeffer an und serviere es heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
