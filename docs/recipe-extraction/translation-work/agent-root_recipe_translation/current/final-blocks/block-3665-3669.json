      "steps": [
        {
          "position": 0,
          "text": "Koche Hähnchen mit der Hälfte der Zwiebel und Salz etwa 20 Minuten, bis es vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Röste Poblano-Chilis direkt über einer Flamme, bis sie verkohlt sind. Lege sie 5 Minuten in eine Plastiktüte und ziehe dann die Haut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Pepitas, geröstete Poblanos, Knoblauch, Koriander und 1 Tasse Brühe glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem großen Topf und dünste die übrige Zwiebel weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die Kernmischung hinzu und gare sie 3 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die restliche Brühe und gezupftes Hähnchen hinzu und lasse alles 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verfeinere mit Limettensaft, Salz und Pfeffer nach Geschmack.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Reis oder warmen Tortillas servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
