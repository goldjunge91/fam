      "steps": [
        {
          "position": 0,
          "text": "Röste Poblano-Chilis direkt über einer Flamme, bis sie vollständig verkohlt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lege die verkohlten Chilis 5 Minuten in eine Plastiktüte, damit sie dämpfen, und ziehe dann die schwarze Haut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide die geschälten Chilis in Streifen und entferne die Kerne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide Karotten in dünne Stifte und Zwiebel in Ringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Olivenöl in einem Topf, gib Knoblauch und Zwiebel hinzu und gare sie 2 Minuten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Essig, Wasser, Lorbeerblätter, Oregano, Salz und Pfeffer hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Karottenstifte hinzu und gare sie 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schichte Poblano-Streifen und gegartes Gemüse in Gläser oder eine Schüssel und gieße die heiße Essigmischung darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse alles auf Raumtemperatur abkühlen und stelle es vor dem Servieren mindestens 2 Stunden kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
