      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Wasser, bis ein grober Teig entsteht. Knete ihn 8-10 Minuten glatt und elastisch und lasse ihn zugedeckt 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Hühnerbrühe, löse Gelatine darin auf, lasse sie abkühlen und stelle sie etwa 1 Stunde kalt, bis sie geliert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Schweinehack, gehackten Ingwer, Frühlingszwiebeln, Sojasauce, Sesamöl und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide das kalte gelierte Brühegelee in kleine Würfel und hebe sie vorsichtig unter die Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 12 Stücke und rolle jedes zu einem dünnen Kreis von 3 inches Durchmesser aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib 1 Esslöffel Schweinefleisch-Gelee-Mischung in die Mitte jedes Teigkreises. Ziehe die Ränder nach oben und drehe sie zum Verschließen zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Teigtaschen vorsichtig in einen mit Backpapier ausgelegten Bambusdämpfer und dämpfe sie 10-12 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie sofort im Bambusdämpfer mit schwarzem Essig und Sojasauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
