      "steps": [
        {
          "position": 0,
          "text": "Rühre die Eier in einer Pfanne und lasse sie abkühlen. Schneide sie anschließend in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische die abgekühlten Rühreier, Schnittlauch, zerbröselten Tofu, Sesamöl, Sojasauce, Knoblauch, Salz und weißen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib 1 Esslöffel Füllung in die Mitte jedes Wan-Tan-Blatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Befeuchte die Ränder mit Wasser und falte das Blatt zu einem Dreieck. Führe die beiden Ecken zusammen und drücke sie fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe einen großen Topf Wasser zum Kochen und gib die Teigtaschen vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse sie 5 Minuten köcheln, bis sie oben schwimmen, und koche sie dann weitere 1-2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus und serviere sie heiß mit Sojasauce, Essig oder Chiliöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
