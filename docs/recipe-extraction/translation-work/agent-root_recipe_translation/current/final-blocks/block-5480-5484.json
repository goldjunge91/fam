      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Wasser, bis ein grober Teig entsteht. Knete ihn 8 Minuten glatt und elastisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig ab und lasse ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische währenddessen Schweinehack, Kohl, Frühlingszwiebeln, Sojasauce, Sesamöl, Ingwer, Knoblauch und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 12 gleich große Stücke und rolle jedes zu einem dünnen Kreis von etwa 3 inches Durchmesser aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 1 Esslöffel Füllung in die Mitte jedes Teigkreises. Falte ihn halbmondförmig zusammen und drücke die Ränder fest zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe einen großen Topf Wasser zum Kochen und gib die Teigtaschen vorsichtig hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse sie 5-7 Minuten köcheln, bis sie oben schwimmen, und koche sie dann weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm sie mit einer Schaumkelle heraus und serviere sie heiß mit Sojasauce oder Essig zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
