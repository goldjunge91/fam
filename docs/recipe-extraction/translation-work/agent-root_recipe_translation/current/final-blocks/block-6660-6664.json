      "steps": [
        {
          "position": 0,
          "text": "Butter in einem großen Topf bei mittlerer Hitze schmelzen und Zwiebeln, Karotten und Sellerie 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehacktes Kegelschneckenfleisch hinzufügen und unter gelegentlichem Rühren 3 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit Hühnerbrühe aufgießen und zum Kochen bringen, dann die Hitze reduzieren und 30 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Kartoffeln dazugeben und 20 Minuten weiter köcheln lassen, bis die Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koriander und Limettensaft einrühren und mit Salz und schwarzem Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Weitere 5 Minuten köcheln lassen, damit sich die Aromen vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Suppe in Schüsseln füllen und heiß mit knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
