      "steps": [
        {
          "position": 0,
          "text": "Für den Fry-Jack-Teig Mehl, Backpulver und Salz vermischen und mit Wasser zu einem glatten Teig verkneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig in 8 Portionen teilen, abdecken und 15 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In der Zwischenzeit 2 Esslöffel Öl in einer Pfanne erhitzen und die Zwiebeln darin anbraten, bis sie weich sind. Anschließend die Kabeljaufilets dazugeben und auf jeder Seite 5–7 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Tomaten, Koriander und Limettensaft zum gekochten Kabeljau geben und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitzen Sie 3 Tassen Öl in einer tiefen Pfanne auf 350 °F und drücken Sie jede Teigportion dünn aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Teigstücke auf jeder Seite 2–3 Minuten goldbraun braten und dann auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die heißen Fry Jacks zusammen mit dem Kabeljau-Eintopf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
