          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Abgetropfte Tomaten in eine Rührschüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebeln, Jalapeños, Koriander und Knoblauch in die Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Limettensaft über die Mischung gießen und vorsichtig verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit Salz und schwarzem Pfeffer würzen, dann abschmecken und nach Bedarf anpassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lassen Sie Chimol 5 Minuten ruhen, damit sich die Aromen vermischen können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort mit Tortillachips zum Dippen servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
