      "steps": [
        {
          "position": 0,
          "text": "Die Hähnchenstücke mit Küchenpapier trocken tupfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ingwer-Knoblauch-Paste, Sojasauce, Essig und rotes Chilipulver vermengen. Das Hähnchen darin 15 Minuten marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maisstärke, Mehl und Salz in einer Schüssel vermischen. Das Ei in einer zweiten Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jedes Hähnchenstück zuerst in Ei tauchen und dann gründlich in der Maisstärke-Mehl-Mischung wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen. Alternativ prüfen, ob ein kleines Stück Hähnchen beim Hineingeben sofort brutzelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hähnchenstücke portionsweise 6–8 Minuten frittieren, bis sie tief goldbraun und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und noch heiß mit geschnittenen Frühlingszwiebeln und Sesamsamen vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort mit einer würzigen Dip-Sauce, zum Beispiel Sriracha-Mayonnaise oder süßer Chilisauce, servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
