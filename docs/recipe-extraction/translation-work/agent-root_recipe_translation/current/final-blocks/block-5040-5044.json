      "steps": [
        {
          "position": 0,
          "text": "Hähnchenhackfleisch mit der Hälfte von Knoblauch, Ingwer, gewürfelter Zwiebel, Maisstärke, 1 EL Sojasauce und Salz zu einer Masse vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Hähnchenmischung zu kleinen Kugeln von etwa 1 Zoll Durchmesser formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "3 EL Öl in einer tiefen Pfanne erhitzen und die Hähnchenkugeln portionsweise insgesamt etwa 8–10 Minuten rundherum goldbraun braten. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das restliche 1 EL Öl in derselben Pfanne erhitzen. Restlichen Knoblauch, Ingwer und grüne Chili hinzufügen und 30 Sekunden unter Rühren braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatensauce, restliche Sojasauce, Essig und Wasser hinzufügen und gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hähnchenkugeln zurück in die Pfanne geben und 5 Minuten köcheln lassen, bis die Sauce leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und bei Bedarf nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und mit Reis oder Nudeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
