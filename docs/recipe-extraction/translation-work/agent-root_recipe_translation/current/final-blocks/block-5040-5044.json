      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermengen. Nach und nach Wasser hinzufügen und zu einem weichen Teig verarbeiten. 5 Minuten kneten, bis er glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig abdecken und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hackfleisch mit gehackter Zwiebel, Knoblauch, Ingwer, Sojasauce, grüner Chili, Koriander und Salz zu einer Füllung vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 12–16 gleich große Stücke teilen und jedes zu einem dünnen, etwa 3 Zoll breiten Kreis ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1 EL Füllung in die Mitte jedes Teigkreises geben. Die Ränder zu einem Säckchen zusammenführen und oben fest zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Einen Topf mit Wasser zum Kochen bringen und die Momos portionsweise hineingeben. Kochen, bis sie an die Oberfläche steigen, dann weitere 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einer Schaumkelle herausnehmen und auf einem Teller anrichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit einer Dip-Sauce aus Sojasauce, Essig, gehacktem Knoblauch und gehackter grüner Chili servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
