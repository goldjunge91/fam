      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 180 C / Gas 4 vor. Lege ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge Cashewkerne und Puderzucker in einer Schüssel. Gib Eigelbe und Orangenblütenwasser hinzu und verrühre alles zu einer glatten, homogenen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm Portionen der Cashewpaste und forme kleine Kugeln. Rolle sie in Puderzucker und lege sie auf das Backblech. Drücke je eine Mandel in die Mitte jedes Ghribia-Kekses.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backe die Kekse etwa 20 Minuten, bis sie leicht goldbraun sind. Behalte sie im Auge, sie verbrennen schnell.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
