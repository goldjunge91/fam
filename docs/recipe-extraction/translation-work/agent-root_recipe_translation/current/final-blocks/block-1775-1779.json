      "steps": [
        {
          "position": 0,
          "text": "Für den Karottenkuchen den Ofen auf 160C/325F/Gas 3 vorheizen. Eine 26cm/10in-Springform einfetten und mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Alle Zutaten für den Karottenkuchen außer Karotten und Walnüssen in einer Schüssel vermengen. Karotten und Walnüsse unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in die Form geben und 1 hour 15 Minuten backen, bis ein Holzstäbchen aus der Mitte sauber herauskommt. Den Kuchen aus dem Ofen nehmen und 10 Minuten abkühlen lassen. Vorsichtig aus der Form lösen und auf einem Kuchengitter vollständig auskühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Für die Glasur Frischkäse, Puderzucker und Butter in einer Schüssel luftig aufschlagen. Die Glasur mit einer Palette auf dem Kuchen verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
