      ],
      "steps": [
        {
          "position": 0,
          "text": "Gib Tamarindenpaste und 1 cup Kristallzucker in eine Schüssel und zerdrücke alles mit einem Löffel oder einer Gabel. Nimm kleine Portionen der Mischung und forme sie in den Händen zu Kugeln, etwa in Murmelgröße oder etwas größer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den restlichen Zucker auf einen flachen Teller oder ein Backblech. Rolle die Tamarindenkugeln darin, bis sie rundum mit Zucker überzogen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Du kannst die Kugeln sofort essen oder einige Stunden beziehungsweise über Nacht fest werden lassen. Dann bekommen sie eine festere Konsistenz und eine stärker kristallisierte Zuckerschicht. Guten Appetit!",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
