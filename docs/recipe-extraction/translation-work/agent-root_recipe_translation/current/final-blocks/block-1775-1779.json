      ],
      "steps": [
        {
          "position": 0,
          "text": "Rindfleisch anbraten: Bräune die Rindfleischwürfel in einem großen Topf rundum an. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gemüse dünsten: Gare im selben Topf die Zwiebel glasig. Gib Karotten, Kartoffeln und Kürbis dazu und gare sie einige Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Köcheln lassen: Gib das Rindfleisch zurück in den Topf. Füge Brühe und getrocknete Aprikosen hinzu. Würze mit Salz und Pfeffer. Lass alles 1-2 hours köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Servieren: Heiß mit einem Stück knusprigem Brot servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tipps:",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bräune das Rindfleisch portionsweise an, damit es eine gute Kruste bekommt, die dem Eintopf mehr Geschmack gibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Früchte erst gegen Ende der Garzeit dazu, damit sie ihre Konsistenz behalten und dem Gericht eine feine Süße verleihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
