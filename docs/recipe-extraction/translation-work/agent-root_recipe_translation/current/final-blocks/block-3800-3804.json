      "steps": [
        {
          "position": 0,
          "text": "Schneide Auberginen längs in 0.5-inch dicke Scheiben, bestreue sie mit Salz und lasse sie 15 Minuten stehen, damit Wasser austritt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe Auberginenscheiben mit Küchenpapier trocken und bestreiche beide Seiten leicht mit Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das restliche Olivenöl in einer großen Pfanne bei mittelhoher bis hoher Hitze und brate Auberginenscheiben portionsweise 4-5 Minuten pro Seite goldbraun. Lege sie dann auf Küchenpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste gehackten Knoblauch in derselben Pfanne 1 Minute. Gib dann Honig und Essig dazu und rühre alles zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte gebratene Auberginenscheiben auf einer Servierplatte und beträufle sie mit der Honig-Essig-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue sie mit Sesam und lasse sie auf Raumtemperatur abkühlen, bevor du sie warm oder kalt als Vorspeise servierst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
