      "steps": [
        {
          "position": 0,
          "text": "Röste Mandeln 3 Minuten in einer trockenen Pfanne, bis sie duften, und mahle dann 0.5 cup davon fein in einer Küchenmaschine.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Rinderhackfleisch, gehackte Zwiebel, Knoblauch, Semmelbrösel, Ei, gemahlene Mandeln, Salz und Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle die Mischung zu 12-16 walnussgroßen Bällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer großen Pfanne und bräune die Fleischbällchen 5 Minuten von allen Seiten. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Püriere die übrigen ganzen Mandeln mit Rinderbrühe und Safran glatt und gieße die Mischung mit den Fleischbällchen in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Köcheln und gare es ohne Deckel 20 Minuten, bis die Fleischbällchen durchgegart und die Sauce leicht eingedickt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit gehackter Petersilie und serviere es heiß mit Brot oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
