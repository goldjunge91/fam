      "steps": [
        {
          "position": 0,
          "text": "Koche ungeschälte Rote Bete 35-40 Minuten in Salzwasser, bis sie beim Einstechen mit einer Gabel zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße Rote Bete ab, lasse sie leicht abkühlen, schäle sie unter fließendem Wasser und schneide sie in dünne Scheiben oder Spalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schäle Orangen und filetiere sie über einer Schüssel, um den Saft aufzufangen. Entferne die weiße Haut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Olivenöl, Essig, Kreuzkümmel, Salz und Pfeffer in einer kleinen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Richte Rote Bete und Orangenfilets abwechselnd auf einer Platte an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Dressing über den Salat und bestreue ihn mit frischer Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse ihn vor dem Servieren 10 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
