      ],
      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 160C/Gasstufe 3/Umluft 140C vor. Lege Boden und lange Seiten einer 900g/2lb-Kastenform mit Backpapier aus und fette Form und Papier mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Mehl, Zimt, Butter, Zucker, 2 tablespoons Honig und Eier in eine große Rührschüssel. Zerdrücke die Bananen, hacke die Datteln (am einfachsten geht es mit einer Küchenschere) und gib beides in die Schüssel. Schlage die Mischung 2-3 Minuten mit einem Holzlöffel oder Handrührgerät, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle den Teig in die vorbereitete Form und streiche die Oberfläche glatt. Streue Walnussstücke darüber. Backe den Kuchen 1 hour und drücke dann leicht auf die Oberfläche. Wenn er gar ist, fühlt er sich fest an. Falls nicht, backe ihn weitere 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse den Kuchen 15 Minuten abkühlen und hebe ihn dann mithilfe des Backpapiers aus der Form. Sobald er kalt ist, träufle den restlichen Honig darüber. In dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
