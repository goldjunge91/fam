      "steps": [
        {
          "position": 0,
          "text": "Schritt 1\nErhitze das Öl in einem mittelgroßen Topf mit Deckel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Ingwer und Knoblauch hinzu und brate sie etwa 5 mins unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Füge Kürbis, Sojasoße, Zucker und Brühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Topf ab und lasse alles 10 mins köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Deckel ab, gib grüne Bohnen dazu und gare alles weitere 3 mins, bis Kürbis und Bohnen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre in der letzten Minute Frühlingszwiebeln ein, bestreue das Gericht mit Koriander und serviere es mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
