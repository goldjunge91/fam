      "steps": [
        {
          "position": 0,
          "text": "Schneide Schweinelende in etwa 0.25 Zoll dünne Scheiben und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze und gib gehackten Knoblauch hinzu. Gare ihn 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Schweinefleischscheiben hinzu und brate sie 2 Minuten pro Seite, bis sie gebräunt sind. Würze mit Salz, Pfeffer und Paprikapulver.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein oder Essig hinzu, gib Lorbeerblätter dazu und reduziere die Hitze. Lasse alles 5 Minuten köcheln, bis die Sauce leicht reduziert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Brötchen nach Wunsch in einer separaten Pfanne oder im Ofen leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Brötchen großzügig mit Schweinefleisch und Sauce und serviere sie sofort. Stelle nach Wunsch Chilisauce dazu.",
          "timerMinutes": null,
