      ],
      "steps": [
        {
          "position": 0,
          "text": "Verquirle Mehl, Zucker und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme in der Mitte eine Mulde, gib Eier und die Hälfte der Milch hinein und rühre alles um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße nach und nach die restliche Milch und geschmolzene Butter hinzu und rühre, bis der Teig glatt und dünn ist. Lasse ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze eine beschichtete 8-Zoll-Pfanne oder Crêpe-Pfanne bei mittlerer bis hoher Hitze und fette sie leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße etwa 0.25 Tasse Teig in die Mitte und neige die Pfanne sofort kreisförmig, damit sich der Teig dünn verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gare den Crêpe etwa 1 Minute, bis die Unterseite hellgolden ist. Wende ihn und gare die andere Seite 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege ihn auf einen Teller und wiederhole den Vorgang mit dem restlichen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle jeden Crêpe mit Marmelade und frischen Beeren, falte ihn zweimal zu einem Viertel und serviere ihn warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
