      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz, gib dann 0.25 Tasse Öl hinzu und verreibe es mit den Fingerspitzen, bis die Mischung Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser hinzu und knete, bis ein fester Teig entsteht. Knete ihn 5 Minuten und lasse ihn zugedeckt 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze 1 Esslöffel Öl in einer Pfanne und gib Kreuzkümmelsamen sowie Ingwer-Knoblauch-Paste hinzu. Gare alles 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zwiebel hinzu und gare sie goldbraun. Füge gekochte Kartoffeln, Erbsen, Garam Masala, Chilipulver, Koriander und Limettensaft hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gare die Füllung 3-4 Minuten, bis alles vermischt ist, und lasse sie leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Teile den Teig in 12 gleich große Kugeln und rolle jede zu einem dünnen Oval aus. Schneide es dann in zwei Hälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Forme jedes Teigstück zu einem Dreieck, gib 1 Esslöffel Kartoffelfüllung hinein und verschließe die Ränder mit etwas Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze Öl in einem tiefen Topf bei mittlerer Hitze und frittiere die Samosas portionsweise 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie heiß mit Tamarinden-Chutney oder Minz-Joghurtsauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
