      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Zucker, Hefe, Backpulver und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib warmes Wasser und Öl hinzu, vermische alles und knete den Teig 10 Minuten glatt und elastisch. Lasse ihn an einem warmen Ort 40 Minuten gehen, bis sich sein Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate währenddessen Schweinefleisch in einer Pfanne bei mittlerer bis hoher Hitze und zerteile es dabei. Rühre Hoisinsauce, Sojasauce und Frühlingszwiebeln ein und stelle die Füllung beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Drücke den Teig zusammen, teile ihn in 8 gleich große Stücke und forme daraus Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke jede Kugel zu einem dünnen Oval flach, bestreiche sie leicht mit Öl, falte sie in der Mitte und lege sie auf ein kleines Stück Backpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse die gefalteten Buns auf einem Blech 20 Minuten gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bringe Wasser in einem Dampfgarer zum Kochen, lege die Buns samt Backpapier auf den Dampfeinsatz und dämpfe sie 12-15 Minuten, bis sie aufgegangen und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Nimm die Buns vorsichtig aus dem Dampfgarer, fülle sie mit der Schweinefleischmischung und Gurkenscheiben und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
