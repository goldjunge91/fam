      "steps": [
        {
          "position": 0,
          "text": "Vermische Maismehl, Salz und warmes Wasser in einer Schüssel und lasse die Mischung 5 Minuten stehen, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Pfanne oder Grillplatte bei mittlerer Hitze und fette die Oberfläche leicht mit Butter oder Öl ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Befeuchte deine Hände, forme etwa 0.25 Tasse Teig zu einer Kugel und drücke sie zu einer etwa 0.5 Zoll dicken Scheibe flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die Arepas auf die heiße Pfanne und gare sie 4-5 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm sie vom Herd und schneide jede Arepa vorsichtig mit einem Messer waagerecht in zwei Hälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jede Arepa mit geriebenem Käse, gegartem Hähnchen, Avocadoscheiben, Tomate und einem Klecks Mayonnaise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren und sofort genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
