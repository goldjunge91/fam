      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 350°F vor und fette eine quadratische 9-inch-Backform ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schlage Eier und Palmzucker etwa 3 Minuten schaumig und hell auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hebe geschmolzene Butter und Vanilleextrakt unter, bis alles vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Siebe Mehl, Backpulver und Salz in einer separaten Schüssel zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe die trockenen Zutaten vorsichtig unter die feuchten und gib dabei abwechselnd in drei Portionen Kokosmilch dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe die Kokosraspeln unter, bis sie gleichmäßig verteilt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße den Teig in die vorbereitete Form und backe ihn 25-30 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass den Kuchen 10 Minuten in der Form abkühlen. Stürze ihn dann auf ein Kuchengitter, lass ihn vollständig abkühlen und schneide ihn in Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
