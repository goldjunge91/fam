      "steps": [
        {
          "position": 0,
          "text": "Presse den Tofu zwischen Küchenpapier 15 Minuten aus, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 3 cups Öl auf 350°F und frittiere die Tofuwürfel insgesamt etwa 6 Minuten rundherum goldbraun. Lass sie auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze in einem separaten Topf 2 Esslöffel Öl und brate Knoblauch, Schalotten und Ingwer etwa 2 Minuten an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Gemüsebrühe, Sojasauce und Kurkuma dazu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verrühre Maisstärke mit 3 Esslöffeln Wasser und rühre die Mischung in die Brühe, damit sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib frittierte Tofuwürfel, Salz und Pfeffer dazu und lass alles 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere das Gericht mit Frühlingszwiebeln und serviere es heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
