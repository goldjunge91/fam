      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Wok oder einer großen Pfanne bei starker Hitze, bis es sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib das Rindfleisch dazu und brate es etwa 4 Minuten unter Rühren braun an. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch, Schalotten und Ingwer in den Wok und brate sie 1 Minute unter Rühren an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füge Kohl, Karotten und lange Bohnen hinzu und brate alles 5 Minuten, bis das Gemüse bissfest und zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib das Rindfleisch zurück in den Wok und füge Sojasauce, Kurkuma, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schwenke alles 2 Minuten durch, bis es gut vermischt und heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht sofort mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
