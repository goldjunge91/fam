      "steps": [
        {
          "position": 0,
          "text": "2 TL Matcha in eine kleine Schüssel oder einen Messbecher sieben, damit keine Klümpchen bleiben. Etwa 2 oz heißes, nicht kochendes Wasser (ca. 175 °F) oder Wasser mit Raumtemperatur sowie den Honig dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "20–30 Sekunden in zickzackförmigen W-Bewegungen kräftig mit einem Bambusbesen oder kleinen elektrischen Milchaufschäumer schlagen, bis die Mischung glatt und schaumig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Ein hohes Glas mit Eis füllen und 8 oz kalte Milch hineingießen. Nach Wunsch Vanilleextrakt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den aufgeschlagenen Matcha langsam über die Milch gießen, sodass sich Schichten bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vor dem Trinken gut umrühren und kalt genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
