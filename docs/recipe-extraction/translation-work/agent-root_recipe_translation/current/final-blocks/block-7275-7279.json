    {
      "externalId": "waivy:drink-iced-matcha-latte",
      "slug": "drink-iced-matcha-latte",
      "title": "Matcha-Latte auf Eis",
      "instructions": "Matcha in zeremonieller Qualität wird glatt aufgeschlagen und über eiskalte Milch gegossen. Ein cremiges, leicht süßes Getränk mit feiner, erdiger Note.",
      "prepTimeMinutes": 5,
      "cookTimeMinutes": null,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Matcha in einer Dose statt in Einzelportionen kaufen. Das ist pro Getränk günstiger und reicht für viele Latte.",
        "Ein günstiger Handmilchaufschäumer schlägt Matcha genauso glatt wie ein Bambusbesen und kostet nur wenige Euro.",
        "Mit normalem Zucker oder Zuckersirup statt Honig süßen, um pro Tasse etwas zu sparen."
      ],
      "substitutions": [
        {
          "forIngredientId": "milk",
          "swap": "verwenden oat Milch oder almond Milch für ein dairy-free, vegan version",
          "savings": "Etwa gleiche Kosten; Hafermilch lässt sich gut aufschäumen"
        },
        {
          "forIngredientId": "honey",
          "swap": "Swap in einfach syrup oder agave syrup",
          "savings": "Pro Drink günstiger und löst sich auch kalt sofort auf"
        },
        {
          "forIngredientId": "vanilla-extract",
          "swap": "Leave it out entirely (deutsche Fassung)",
          "savings": "Spart etwas; das Matcha-Aroma kommt auch ohne Zugabe gut zur Geltung"
        }
      ],
