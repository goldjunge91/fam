      "steps": [
        {
          "position": 0,
          "text": "Kartoffeln etwa 20 Minuten weich kochen, abgießen und mit Butter und Milch zerstampfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer Pfanne erhitzen und Rinderhackfleisch anbraten. Zwiebel und Knoblauch hinzufügen und weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Fleischmischung mit Kreuzkümmel, Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hälfte des Kartoffelpürees in eine gefettete Auflaufform streichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Fleischmischung darauf verteilen und anschließend Oliven sowie Scheiben hart gekochter Eier darauflegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das restliche Kartoffelpüree darüber verteilen und bei 375 °F 20 Minuten goldbraun backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
