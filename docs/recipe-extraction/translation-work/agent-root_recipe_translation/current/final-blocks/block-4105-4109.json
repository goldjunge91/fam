        {
          "position": 0,
          "text": "Das Flankensteak auf etwa 0.5 Zoll Dicke dünn und gleichmäßig klopfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Karottenstreifen, Eihälften und Petersilie mittig auf dem Steak verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Steak fest aufrollen und mit Küchengarn oder Zahnstochern fixieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Olivenöl in einem großen Topf erhitzen und die Rolle 8 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle herausnehmen und gewürfelte Zwiebel weich anbraten. Tomatenmark hinzufügen und 2 Minuten garen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rinderbrühe, Rotwein und Paprikapulver hinzufügen und die Rolle zurück in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 45 Minuten köcheln lassen, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garn entfernen, die Rolle in Scheiben schneiden und mit der Pfannensauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
