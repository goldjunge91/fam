      "steps": [
        {
          "position": 0,
          "text": "Öl in einem großen, schweren Topf oder Schmortopf erhitzen und die Hähnchenschenkel auf jeder Seite 6 Minuten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hähnchen herausnehmen und Chorizoscheiben 3 Minuten anbräunen. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Knoblauch im Topf etwa 4 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hühnerbrühe und Weißwein hinzufügen und die gebräunten Reste vom Topfboden lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchen zurück in den Topf geben und Kartoffeln, Mais und Chorizo hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 30 Minuten köcheln lassen, bis die Kartoffeln fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Miesmuscheln und Garnelen obenauf geben, abdecken und 8–10 Minuten garen, bis sich die Muscheln öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Geschlossene Muscheln entsorgen, mit Salz und Pfeffer würzen und mit Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
