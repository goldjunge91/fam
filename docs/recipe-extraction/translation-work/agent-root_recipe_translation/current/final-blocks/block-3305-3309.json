      "steps": [
        {
          "position": 0,
          "text": "Koche Eier 8 Minuten in einem Topf mit Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm die Eier heraus und lasse sie abkühlen. Klopfe dann vorsichtig die Schalen rundherum auf, ohne sie zu schälen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse Teebeutel in 4 cups kochendem Wasser 5 Minuten ziehen und nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sojasauce, Sternanis, Zimt, Ingwer und Salz zum Tee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die aufgeschlagenen Eier zurück in den Topf und lasse sie mindestens 8 Stunden oder über Nacht köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Eier aus der Flüssigkeit und schäle sie vorsichtig, sodass das Marmormuster sichtbar wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie gekühlt oder bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
