      "steps": [
        {
          "position": 0,
          "text": "Schäle Taro und schneide ihn in 1/2-inch große Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Tapiokastärke, Mehl, Zucker und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße kochendes Wasser über die trockene Mischung und rühre, bis ein grober Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knete den Teig glatt und forme daraus kleine Kugeln mit etwa 3/4 inch Durchmesser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe 3 cups Wasser mit braunem Zucker und Ingwer in einem Topf zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Taro-Bällchen in den kochenden Sirup und lasse sie 15 Minuten köcheln, bis sie aufsteigen und durchscheinend werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie warm in Schalen mit Sirup und Ingwerscheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
