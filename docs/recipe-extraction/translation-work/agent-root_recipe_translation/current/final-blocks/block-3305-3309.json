      "steps": [
        {
          "position": 0,
          "text": "Blanchiere Schweinerippchen 3 Minuten in kochendem Wasser, gieße sie ab und spüle sie mit kaltem Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche getrocknete Pilze 20 Minuten in heißem Wasser ein und schneide sie dann in Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bringe 8 cups Wasser in einem großen Topf zum Kochen und gib blanchierte Rippchen und Ingwerscheiben dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib rote Datteln, Pilze und nach Wunsch Ginseng hinzu und reduziere die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und lasse alles 90 Minuten köcheln, bis die Rippchen zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Gojibeeren während der letzten 10 Minuten der Garzeit dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und garniere die Suppe mit gehackten Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
