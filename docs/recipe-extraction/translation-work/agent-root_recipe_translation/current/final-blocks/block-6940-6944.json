      "steps": [
        {
          "position": 0,
          "text": "Braunen Zucker, Paprika, Knoblauchpulver und schwarzen Pfeffer zu einer trockenen Mischung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rippen, Bruststück und Hähnchenschenkel von allen Seiten trocken einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lassen Sie das Bruststück 225 Stunden lang in einem Räucherofen oder Ofen bei 3 °F backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nach 2 Stunden die Rippchen in den Räucherofen geben und beides noch 1 weitere Stunde räuchern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hähnchenschenkel für die letzten 45 Minuten in den Smoker geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Während des Räucherns Ketchup, Apfelessig, Melasse, Worcestershire-Sauce und Butter in einem Topf vermischen und 15 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Während der letzten 30 Minuten des Garvorgangs alle Fleischstücke alle 10 Minuten mit der Barbecue-Sauce bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wenn das Fleisch vollständig gegart ist, nehmen Sie es heraus, lassen Sie es 10 Minuten ruhen, schneiden Sie es in Scheiben oder schneiden Sie es in Portionen und legen Sie es auf einer Platte mit zusätzlicher Soße an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
