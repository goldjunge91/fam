          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die geräucherte Rinderbrust in 1 Zoll große Würfel schneiden und in eine Aluschale legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rinderbrühe über die Würfel gießen und mit Butter beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decken Sie die Pfanne mit Folie ab und stellen Sie sie 225 Stunden lang bei 1.5 °F in den Räucherofen, bis die Ränder karamellisieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Barbecue-Sauce mit Apfelessig vermischen und mit den verbrannten Enden vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "30 Minuten lang ohne Deckel in den Räucherofen stellen, damit die Glasur fest wird, und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
