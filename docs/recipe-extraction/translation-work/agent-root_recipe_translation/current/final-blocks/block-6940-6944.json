      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 275 °F vorheizen und ein Backblech mit Folie auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Entfernen Sie die Membran von der Rückseite der Rippchen und mischen Sie braunen Zucker, Paprika, Knoblauchpulver und schwarzen Pfeffer zu einer Gewürzmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tragen Sie die Gewürzmischung gleichmäßig auf beide Seiten der Rippen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Rippchen auf das Backblech legen und mit Alufolie abgedeckt 2 Stunden backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Während die Rippchen garen, Ketchup, Apfelessig, Melasse, Zwiebelpulver und Worcestershire-Sauce in einem Topf bei schwacher Hitze vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nach 2 Stunden die Folie entfernen und die Rippchen großzügig mit Barbecuesauce bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Geben Sie die Rippchen für 30 Minuten ohne Deckel in den Ofen und bestreichen Sie sie alle 10 Minuten mit Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen und vor dem Schneiden und Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
