      "steps": [
        {
          "position": 0,
          "text": "Nehmen Sie die Hochrippe 1 Stunde vor dem Garen aus dem Kühlschrank, um sie auf Zimmertemperatur zu bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Heizen Sie den Ofen auf 450 °F vor und tupfen Sie den Braten mit Papiertüchern trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Koscheres Salz, schwarzen Pfeffer und gehackten Knoblauch vermischen und den Braten damit einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Braten mit der Knochenseite nach unten in einen Bräter legen und mit Rosmarin und Thymian bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Braten im auf 450 °F vorgeheizten Ofen 15 Minuten scharf anbraten, bis die Außenseite gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduzieren Sie die Ofentemperatur auf 325 °F und rösten Sie es 1 Stunde und 15 Minuten lang weiter (Medium-Rare), wobei Sie alle 20 Minuten Butter auftragen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Geben Sie Rinderbrühe in die Pfanne und begießen Sie weiter, bis die Innentemperatur 130 °F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen, mit Folie abdecken und 15 Minuten ruhen lassen, bevor es angeschnitten und serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
