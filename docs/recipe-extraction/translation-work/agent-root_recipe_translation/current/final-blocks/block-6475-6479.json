      "steps": [
        {
          "position": 0,
          "text": "Tomaten würfeln, überschüssigen Saft abgießen und die Würfel in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch, gehacktes frisches Basilikum, Salz und Pfeffer zur Tomatenmischung hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mit nativem Olivenöl extra und Balsamico-Essig beträufeln und vorsichtig vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lassen Sie die Tomatenmischung 5 Minuten ruhen, damit sich die Aromen vermischen können.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ciabatta schräg in 0.5 Zoll dicke Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brotscheiben in einer Pfanne bei mittlerer Hitze 1 Minute pro Seite leicht rösten, bis sie gerade Farbe haben, innen aber noch leicht weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belegen Sie jede warme Brotscheibe mit einem großzügigen Löffel Tomatenmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Sofort servieren, solange das Brot noch warm und die Tomaten frisch sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
