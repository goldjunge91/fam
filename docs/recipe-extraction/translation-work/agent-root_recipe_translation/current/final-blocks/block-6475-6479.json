      "steps": [
        {
          "position": 0,
          "text": "Warmes Wasser, Hefe und Salz in einer Schüssel vermischen und dann 2 Minuten ruhen lassen, bis eine schaumige Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl einrühren, dann unter Rühren nach und nach Mehl dazugeben, bis ein fester Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 8-10 Minuten mit den Händen glatt und elastisch kneten und dann 15 Minuten zugedeckt ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Teig in 24 gleich große Stücke teilen. Jedes Stück zu einer dünnen Rolle von etwa 10 Zoll Länge und 0.5 Zoll Dicke formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grissini auf geölte Backbleche legen, leicht mit Olivenöl bestreichen und nach Belieben mit Sesam bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Stangen ohne Abdeckung 15 Minuten gehen lassen und währenddessen den Ofen auf 400 °F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "15–18 Minuten backen, bis sie goldbraun und knusprig sind, dabei nach der Hälfte der Backzeit einmal wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Gitterrosten abkühlen lassen und dann in einem luftdichten Behälter aufbewahren, um die Knusprigkeit zu bewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
