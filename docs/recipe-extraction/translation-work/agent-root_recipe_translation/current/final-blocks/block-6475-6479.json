      "steps": [
        {
          "position": 0,
          "text": "Heizen Sie den Ofen auf 350 °F vor und legen Sie ein Backblech mit Backpapier aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche Butter und Zucker in einer Schüssel etwa 3 Minuten lang schaumig rühren, bis die Masse leicht und locker ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier einzeln unterrühren, dann Vanilleextrakt unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "In einer anderen Schüssel Mehl, Backpulver und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Abwechselnd trockene Zutaten und Milch zur Buttermischung geben und vorsichtig umrühren, bis ein dicker Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jeweils gehäufte Esslöffel Teig mit 2 Zoll Abstand auf das vorbereitete Backblech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20–25 Minuten backen, bis der Teig goldbraun ist und ein Zahnstocher in der Mitte sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten auf dem Backblech abkühlen lassen, dann zum vollständigen Abkühlen auf einen Rost legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
