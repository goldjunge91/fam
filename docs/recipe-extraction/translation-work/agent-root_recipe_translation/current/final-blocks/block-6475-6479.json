      "steps": [
        {
          "position": 0,
          "text": "Buchweizenmehl, Allzweckmehl und Salz in einer Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Unter ständigem Rühren nach und nach Wasser einrühren, bis ein glatter, dünner Teig mit der Konsistenz von Sahne entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine leicht gebutterte beschichtete 8 Zoll große Pfanne oder Crêpe-Platte bei mittlerer bis hoher Hitze gut vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "0.5 Tasse Teig in die Mitte gießen und die Pfanne sofort kippen und drehen, damit sich der Teig dünn und gleichmäßig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "1 Minute kochen lassen, bis der Boden fest, die Oberseite aber noch leicht feucht ist. Dann eine Schinkenscheibe in die Mitte legen, Käse darüber streuen und ein Ei in die Mitte aufschlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falten Sie die vier Ecken der Galette wie einen Umschlag über das Ei, sodass eine quadratische Form entsteht, in deren Mitte das Ei sichtbar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "2-3 Minuten kochen, bis das Eiweiß fest ist, das Eigelb jedoch flüssig bleibt, dann auf einen Teller gleiten lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Wiederholen Sie den Vorgang mit dem restlichen Teig und den Füllungen und würzen Sie jede Galette mit schwarzem Pfeffer, bevor Sie sie heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
