      "steps": [
        {
          "position": 0,
          "text": "Bereiten Sie die Frösche vor, indem Sie sie trocken tupfen und innen und außen mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kalbshackfleisch, gehackten Prosciutto, frische Kräuter, Parmesan und Ei in einer Schüssel vermischen, bis alles gut vermischt ist, und dann jede Froschhöhle mit dieser Mischung füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter und Olivenöl in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen, dann die gefüllten Frösche vorsichtig mit der Brustseite nach unten hineinlegen und auf jeder Seite 4 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gießen Sie Weißwein um die Frösche herum, kratzen Sie alle gebräunten Stücke ab und lassen Sie sie dann 3 Minuten lang köcheln, bis der Wein leicht einkocht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fügen Sie Hühnerbrühe rund um die Frösche hinzu, lassen Sie sie köcheln, decken Sie sie locker ab und kochen Sie sie 45–50 Minuten lang, bis die Frösche zart und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Frösche vorsichtig auf eine Servierplatte legen und locker mit Alufolie abdecken, damit sie warm bleiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Schmorflüssigkeit bei mittlerer Hitze 5 Minuten köcheln lassen, um die Aromen etwas zu konzentrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gießen Sie reduzierte Soße über die Frösche und servieren Sie sie heiß mit knusprigem Brot, um die Brühe aufzusaugen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
