      "steps": [
        {
          "position": 0,
          "text": "Masa Harina mit warmem Wasser und Salz zu einem weichen, formbaren Teig vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tomaten, Zwiebel und Koriander fein hacken und mit Loroco vermengen, falls verwendet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in 8 Portionen teilen und zu Kugeln formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jede Kugel zwischen Frischhaltefolie zu einer dünnen Scheibe von etwa 3 Zoll Durchmesser drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Käse und 1 Esslöffel der Tomatenmischung auf eine Hälfte der Scheibe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Masa darüberklappen, sodass eine Halbmondform entsteht, und die Ränder verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer Pfanne bei mittlerer Hitze erhitzen und Quesadillas pro Seite 3–4 Minuten goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und warm mit Tomatensauce dazu servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
