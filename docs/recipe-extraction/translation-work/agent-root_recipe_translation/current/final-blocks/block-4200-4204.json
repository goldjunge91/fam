      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 350 °F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter und Zucker etwa 3 Minuten cremig und luftig schlagen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eier nacheinander einrühren und anschließend Vanilleextrakt hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mehl, Backpulver, Salz und Anissamen in einer separaten Schüssel verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trockene Zutaten und Milch abwechselnd zur Buttermischung geben, dabei mit den trockenen Zutaten beginnen und enden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gehäufte Esslöffel Teig mit 2 Zoll Abstand auf das vorbereitete Blech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20–25 Minuten backen, bis die Ränder goldbraun sind und ein hineingesteckter Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten auf dem Blech abkühlen lassen und dann auf ein Kuchengitter legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
