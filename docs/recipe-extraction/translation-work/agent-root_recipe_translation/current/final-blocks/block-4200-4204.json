      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz vermischen. Kalte Butter mit einer Gabel einarbeiten, bis die Mischung groben Krümeln ähnelt, dann Eiswasser hinzufügen, bis sich der Teig gerade verbindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig in Frischhaltefolie wickeln und 15 Minuten kühlen, während die Füllung zubereitet wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhackfleisch in einer Pfanne bräunen, Sofrito, Oliven und Rosinen hinzufügen und 5 Minuten garen, bis es durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den gekühlten Teig zwischen zwei Lagen Frischhaltefolie dünn ausrollen und mit einem Glas oder Ausstecher Kreise von 3 Zoll Durchmesser ausstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeweils einen Teelöffel Rinderfüllung auf einen Teigkreis geben, halbieren und die Ränder mit einer Gabel fest verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und die Empanadillas portionsweise pro Seite 2–3 Minuten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Auf Küchenpapier abtropfen lassen und warm mit Ketchup, scharfer Sauce oder Adobo-Sauce servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
