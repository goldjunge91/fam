      "steps": [
        {
          "position": 0,
          "text": "Milch und Butter in einem Topf bei mittlerer bis hoher Hitze zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl langsam unter ständigem Rühren in die kochende Milch einstreuen, damit keine Klümpchen entstehen, dann die Hitze auf mittlere bis niedrige Stufe reduzieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "5–7 Minuten weiterrühren, bis die Mischung dick ist und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vom Herd nehmen und Salz, Zucker sowie geriebenen Mozzarella einrühren, bis der Käse geschmolzen und vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mischung auf einen angefeuchteten Teller oder ein Brett geben und etwa 5 Minuten abkühlen lassen, bis sie sich anfassen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zu 3 Zoll langen, fingerdicken Zylindern formen und auf einem Teller beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und Sorullitos pro Seite 2–3 Minuten goldbraun und knusprig frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß mit etwas Salz oder süßen Rosinen als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
