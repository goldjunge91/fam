      "steps": [
        {
          "position": 0,
          "text": "Schweinedärme 30 Minuten in warmem Wasser einweichen, bis sie weich und geschmeidig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauchzehen sehr fein hacken und mit Adobo, Kreuzkümmel, Oregano, schwarzem Pfeffer und Salz vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinehackfleisch und Schweinefett in einer großen Schüssel vermengen, Knoblauch-Gewürz-Mischung hinzufügen und gründlich mit den Händen einarbeiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Wurstfüller-Aufsatz am Fleischwolf befestigen oder einen manuellen Wurstfüller verwenden und die eingeweichten Därme vorsichtig auf die Tülle ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Schweinemischung langsam einfüllen und die gefüllte Wursthülle auf ein Backblech führen, dabei etwa 4–5 Zoll lange Würste formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Enden mit Küchengarn abbinden oder verdrehen, sodass einzelne Würste entstehen. Mindestens 4 Stunden oder über Nacht kühlen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Longaniza in einer Pfanne bei mittlerer Hitze 8–10 Minuten braten, bis die Hülle kräftig gebräunt und das Fleisch gar ist. Gelegentlich wenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß zum Frühstück mit Brot, Eiern und frischem Limettensaft servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
