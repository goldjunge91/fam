      "steps": [
        {
          "position": 0,
          "text": "Schäle den Flaschenkürbis, schneide ihn in mittelgroße Stücke und entferne die Kerne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer Hitze, bis es glänzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Senf- und Kreuzkümmelsamen dazu und lass sie etwa 30 Sekunden knistern und aufspringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib getrocknete rote Chilischoten und Curryblätter dazu und gare alles weitere 30 Sekunden, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden, ohne ihn braun werden zu lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kürbisstücke, Kurkumapulver und Salz dazu und rühre um, bis alles gleichmäßig überzogen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße Wasser dazu, decke die Pfanne ab und lass alles 15-20 Minuten köcheln, bis der Kürbis weich ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht heiß als Beilage zu Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
