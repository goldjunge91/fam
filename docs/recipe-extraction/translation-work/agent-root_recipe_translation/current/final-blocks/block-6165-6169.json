      "steps": [
        {
          "position": 0,
          "text": "Schneide die Fischfilets in mittelgroße Stücke und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Tomaten, Zwiebeln und grüne Chilischoten grob.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer Pfanne und gib gehackten Knoblauch und Ingwer dazu. Gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackte Zwiebeln dazu und gare sie etwa 3-4 Minuten, bis sie weich und glasig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gehackte Tomaten und grüne Chilischoten dazu und gare sie etwa 5 Minuten, bis die Tomaten zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Kurkuma und Salz dazu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib die Fischstücke dazu und wende sie vorsichtig in der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße Wasser dazu, bringe alles zum Köcheln, decke die Pfanne ab und gare das Gericht 12-15 Minuten, bis der Fisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere es heiß mit gedämpftem Reis.",
