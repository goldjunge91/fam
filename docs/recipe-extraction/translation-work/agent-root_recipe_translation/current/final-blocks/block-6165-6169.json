      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig aus Mehl, Wasser und einer Prise Salz zu. Knete ihn glatt und lass ihn 15 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerkleinere Hähnchenbrust, Zwiebeln, Knoblauch, Ingwer und grüne Chilischoten zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische die Hähnchenfüllung mit Salz, Pfeffer, Koriander und Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig dünn aus und schneide mit einem Glas oder Ausstecher 3 Zoll große Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib einen Teelöffel Füllung auf jeden Kreis, ziehe die Ränder zusammen und falte sie zu einem verschlossenen Säckchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Wasser in einem großen Topf zum Kochen und setze einen Dämpfeinsatz oder ein Sieb darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Momos in den Dämpfeinsatz, decke ihn ab und dämpfe sie 15-18 Minuten, bis sie durchscheinend sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie heiß mit Chilisauce oder einem Dip aus Sojasauce, Knoblauch und Essig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
