      "steps": [
        {
          "position": 0,
          "text": "Schneide das Hähnchen in mittelgroße Stücke und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Senföl in einem Topf mit schwerem Boden bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste geschnittene Zwiebeln goldbraun an. Gib gehackten Knoblauch und Ingwer dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hähnchenstücke dazu und brate sie unter gelegentlichem Rühren 5-7 Minuten leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Kurkumapulver dazu und vermenge alles gut. Füge anschließend gehackte Tomaten und grüne Chilischoten hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze auf niedrige Stufe, decke den Topf ab und lass alles 25-30 Minuten köcheln, bis das Hähnchen zart ist. Rühre gelegentlich um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Geschmack mit Salz und Pfeffer und serviere das Gericht heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
