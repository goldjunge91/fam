      ],
      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und 1/4 Tasse Ghee vermischen und dann nach und nach warmes Wasser hinzufügen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 10 Minuten lang kneten, bis er glatt und elastisch ist, dann abgedeckt 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teilen Sie den Teig in 8 gleiche Portionen und rollen Sie jede zu einem dünnen Kreis aus und dehnen Sie sie vorsichtig mit Ihren Händen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eine 9x13 Auflaufform großzügig mit geschmolzenem Ghee bestreichen und 4 Teigkreise darüber schichten und jeweils mit Ghee bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier verquirlen und gleichmäßig über den geschichteten Teig gießen, dann die restlichen 4-Teigkreise mit Ghee dazwischen schichten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die oberste Schicht mit restlichem Ghee bestreichen und mit Sesamkörnern und Schwarzkümmelsamen bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 30-35 Minuten backen, bis die Oberfläche goldbraun und knusprig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Aus dem Ofen nehmen und sofort warmen Honig über das gesamte Gericht gießen, dann vor dem Servieren 5 Minuten abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
