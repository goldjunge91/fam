      "steps": [
        {
          "position": 0,
          "text": "Erhitzen Sie 2 Esslöffel Ghee in einer großen Pfanne bei mittlerer Hitze und braten Sie die gewürfelten Zwiebeln etwa 8 Minuten an, bis sie tief karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geben Sie in einer separaten Schüssel unter Rühren nach und nach Wasser zum Mehl hinzu, bis eine dicke Paste entsteht, und mischen Sie dann Salz hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie die Mehlmischung mit den karamellisierten Zwiebeln in die Pfanne und beginnen Sie unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fügen Sie das restliche Ghee schrittweise hinzu und rühren Sie die Mischung 8 Minuten lang weiter, bis ein zusammenhängender Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Formen Sie die Samen auf einem Servierteller zu einem Hügel und formen Sie in der Mitte eine Mulde.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Streuen Sie Honig in die Mulde und schlagen Sie die Eier oben auf dem Hügel auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort noch warm servieren und den cremigen Teig und die Eier zusammen essen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
