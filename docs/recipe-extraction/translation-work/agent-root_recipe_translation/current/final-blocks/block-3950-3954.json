      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz, Hefe und Zucker in einer Schüssel vermischen, dann warmes Wasser und Öl hinzufügen und rühren, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 8 Minuten lang kneten, bis er glatt und elastisch ist, dann in eine mit Öl bedeckte Schüssel geben und 45 Minuten lang verdoppeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig ausstanzen und auf einer bemehlten Oberfläche zu einem dünnen Rechteck von etwa 10x14 Zoll ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Weiche Butter auf der gesamten Oberfläche verteilen und dann gleichmäßig mit braunem Zucker und Zimt bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rollen Sie den Teig von der Längsseite aus fest zu einer Rolle und schneiden Sie ihn dann in 8 gleich große Spiralstücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Legen Sie die Spiralen mit der Schnittseite nach oben in eine gefettete 9x13 Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "2 Eier schlagen und die Oberseite jedes Brötchens damit bestreichen, dann bei 375°F 25-30 Minuten backen, bis es goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "5 Minuten in der Pfanne abkühlen lassen, bevor es warm mit Honig oder Konfitüre serviert wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
