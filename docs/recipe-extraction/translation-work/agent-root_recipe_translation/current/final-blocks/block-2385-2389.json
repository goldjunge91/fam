      "steps": [
        {
          "position": 0,
          "text": "Hähnchenbrust in mundgerechte Stücke und Zwiebel in dünne Spalten schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Pfanne bei mittelhoher Hitze erhitzen und geschnittenes Hähnchen dazugeben. Garen, bis es fast durch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebelscheiben zum Hähnchen in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dashi-Brühe, Sojasauce, Mirin und Zucker in die Pfanne gießen und 5 Minuten köcheln lassen, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Eier in einer Schüssel verquirlen und langsam unter Rühren in die Pfanne gießen, sodass Eierbänder entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reis auf zwei Schalen verteilen und mit der Hähnchen-Ei-Mischung belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit geschnittenen Frühlingszwiebeln garnieren und sofort servieren.",
