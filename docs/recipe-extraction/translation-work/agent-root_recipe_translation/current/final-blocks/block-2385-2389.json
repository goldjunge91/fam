          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rindfleisch zurück in den Wok geben und Sojasauce, braunen Zucker und Chiliflocken hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Alles 2 Minuten vermengen, bis das Rindfleisch überzogen ist und die Sauce eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Frühlingszwiebeln und Sesamsamen abschließen und über Reis servieren.",
