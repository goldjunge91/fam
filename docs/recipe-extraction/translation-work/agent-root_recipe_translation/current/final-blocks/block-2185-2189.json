      ],
      "steps": [
        {
          "position": 0,
          "text": "Setze einen großen Topf Wasser auf und bringe es zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke 100g Pancetta fein und entferne zuvor die Schwarte. Reibe 50g Pecorino und 50g Parmesan fein und vermische die Käsesorten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle 3 große Eier in einer mittelgroßen Schüssel und würze sie mit frisch gemahlenem schwarzem Pfeffer. Stelle alles beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib 1 tsp Salz in das kochende Wasser, füge 350g Spaghetti hinzu und gare sie nach erneutem Aufkochen zugedeckt bei konstantem Köcheln 10 Minuten oder bis sie bissfest sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Drücke 2 geschälte Knoblauchzehen mit der Messerklinge leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate während die Spaghetti garen Pancetta und Knoblauch an. Gib 50g ungesalzene Butter in eine große Pfanne oder einen Wok. Sobald sie geschmolzen ist, füge Pancetta und Knoblauch hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass alles bei mittlerer Hitze etwa 5 Minuten garen und rühre oft um, bis Pancetta goldbraun und knusprig ist. Der Knoblauch hat sein Aroma abgegeben. Nimm ihn mit einer Schaumkelle heraus und wirf ihn weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lass die Pancetta bei niedriger Hitze weiterbraten. Wenn die Pasta fertig ist, hebe sie mit einer Pastagabel oder Zange aus dem Wasser und gib sie zur Pancetta in die Pfanne. Es darf etwas Wasser mit in die Pfanne tropfen. Gieße das Nudelwasser noch nicht weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rühre den Großteil des Käses unter die Eier und bewahre eine kleine Handvoll zum Bestreuen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Nimm die Pfanne mit Spaghetti und Pancetta vom Herd. Gieße rasch Ei und Käse dazu. Hebe die Spaghetti mit einer Zange oder langen Gabel an, damit sie sich mit der Eiermischung vermengen. Diese dickt ein, ohne zu stocken, und überzieht alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Gib zusätzliches Nudelwasser dazu, damit die Sauce geschmeidig bleibt (einige Esslöffel sollten reichen). Sie soll feucht, aber nicht wässrig sein. Würze bei Bedarf mit etwas Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 11,
          "text": "Drehe die Pasta mit einer langzinkigen Gabel auf einen Servierteller oder in eine Schüssel. Sofort mit restlichem Käse und schwarzem Pfeffer servieren. Wird das Gericht vor dem Servieren trocken, gib etwas heißes Nudelwasser dazu, damit die glänzende Sauce wieder geschmeidig wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
