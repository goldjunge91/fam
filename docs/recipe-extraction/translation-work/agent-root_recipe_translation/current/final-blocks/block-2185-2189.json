      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche die Bohnen mindestens 4 hrs oder über Nacht in einer großen Schüssel mit reichlich Wasser ein. Spüle sie am nächsten Tag ab und gieße sie ab. Gib sie mit Zwiebel, Paprikapulver, Kräuterbündel und Hähnchen in einen großen Topf mit schwerem Boden. Bedecke alles mit Wasser oder Brühe, bringe es zum Kochen, reduziere dann die Hitze, decke den Topf ab und lass alles 45 mins köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm das Hähnchen auf einen Teller und gib Kartoffeln und Chorizo in den Topf. Gare alles weitere 30 mins, bis Bohnen und Kartoffeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Entferne Haut und Knochen vom Hähnchen und zerteile es in große Stücke. Gib es mit Spinat zurück in den Topf und lass alles 5 mins köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
