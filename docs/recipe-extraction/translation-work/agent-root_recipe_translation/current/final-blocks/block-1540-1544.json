    {
      "externalId": "waivy:mfr-bbq-dry-rub-ribs",
      "slug": "mfr-bbq-dry-rub-ribs",
      "title": "Hähnchenrippchen mit Memphis-Trockenwürzung",
      "instructions": "Der Zauber der Memphis-Trockenwürzung: Geräuchertes Paprikapulver, brauner Zucker, Kreuzkümmel und schwarzer Pfeffer werden auf Hähnchenoberkeulen verteilt, die im Ofen backen, bis die Kruste karamellisiert, und anschließend unter dem Grill kräftig gebräunt werden. Der ganze Geschmack einer Memphis-Rippchen-Bar, ganz ohne Räucherofen.",
      "prepTimeMinutes": 10,
      "cookTimeMinutes": 45,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Die Gewürze für die Trockenwürzung kosten pro Portion nur wenige Cent. Mische ein großes Glas für mehr als 10 Anwendungen.",
        "Hähnchenoberkeulen ergeben die saftigste Variante nach Rippchenart.",
        "Die Glasur aus Apfelessig ist der typische Abschluss nach Memphis-Art. Lass sie nicht weg."
      ],
      "substitutions": [
        {
          "forIngredientId": "mustard-powder",
          "swap": "Zusätzliches geräuchertes Paprikapulver, falls kein Senfpulver verfügbar ist"
        },
        {
          "forIngredientId": "cayenne",
          "swap": "Mehr schwarzer Pfeffer für Schärfe ohne die Spitze von Cayennepfeffer"
        }
