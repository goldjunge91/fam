      "steps": [
        {
          "position": 0,
          "text": "Forme das Rinderhackfleisch zu lockeren Kugeln von 2 oz und drücke sie nicht fest zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine gusseiserne Pfanne, bis sie raucht, und gib etwas Öl hinein. Lege eine Fleischkugel hinein und drücke sie sofort 10 Sekunden lang mit einem Pfannenwender flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate das Fleisch 2 Minuten, ohne es zu bewegen, bis die Ränder spitz und dunkel sind. Salze es direkt nach dem Andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende das Patty, gib Käse darauf und decke die Pfanne 30 Sekunden ab, damit der Käse schmilzt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre für die Spezialsoße Mayonnaise, Ketchup, Senf und einen Schuss Gurkenlake zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Röste die Brötchen in Butter und belege sie mit Zwiebel, Gewürzgurken und Soße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
