      "steps": [
        {
          "position": 0,
          "text": "Klopfe das Hähnchen dünn. Vermische für die Panade Mehl, die Hälfte des Cayennepfeffers, Paprikapulver, Knoblauchpulver und Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tauche das Hähnchen in Ei und wende es in der gewürzten Mehlmischung. Frittiere es in 1/2 Zoll Öl 4–5 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre für die scharfe Paste 2 EL heißes Öl mit Cayennepfeffer, geräuchertem Paprikapulver und Zucker zusammen und bestreiche damit das frittierte Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Bereite einen schnellen Krautsalat aus Kohl, Mayonnaise und Essig zu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schichte das Hähnchen mit Gewürzgurken und Krautsalat auf Weißbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
