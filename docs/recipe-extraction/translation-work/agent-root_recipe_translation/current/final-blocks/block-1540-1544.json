    {
      "externalId": "waivy:mfr-bbq-nashville-hot",
      "slug": "mfr-bbq-nashville-hot",
      "title": "Nashville-Hot-Chicken-Sandwich",
      "instructions": "Die feurige Spezialität aus Tennessee: Frittiertes Hähnchen wird mit einer Paste aus Cayennepfeffer und Schmalz überzogen, die die Kruste leuchtend rot-orange färbt. Auf Weißbrot mit Gewürzgurken und Krautsalat gestapelt, die die Schärfe mildern. Ein Sandwich, bei dem man gleichzeitig schwitzt und lächelt.",
      "prepTimeMinutes": 20,
      "cookTimeMinutes": 15,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "Die Cayennepaste macht dieses Gericht zu Nashville Hot. Sei damit nicht zu sparsam.",
        "Dünn geklopfte Hähnchenbrust frittiert schneller und bleibt saftig.",
        "Gewürzgurken und Krautsalat gleichen die Schärfe aus. Lass sie nicht weg."
      ],
      "substitutions": [
        {
          "forIngredientId": "cayenne",
          "swap": "Koreanisches Gochugaru für eine andere Art von Schärfe"
