      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 325°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide den Speck klein und brate ihn in einem großen Schmortopf bei mittlerer Hitze knusprig. Nimm ihn heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe das Rindfleisch trocken und bräune es im Speckfett von allen Seiten an, insgesamt etwa 10 Minuten. Nimm es heraus und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Dünste gewürfelte Zwiebel, Karotten und Sellerie im Topf 5 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lösche mit Rotwein ab, löse die Bratrückstände vom Topfboden und lass alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Rindfleisch zurück in den Topf und füge Rinderbrühe, Lorbeerblätter, Thymian und den gebratenen Speck hinzu. Bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Decke den Topf ab und schmorte das Fleisch 2.5 bis 3 Stunden im Ofen, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm das Rindfleisch heraus und seihe Gemüse und Sauce ab. Serviere das Fleisch mit dem Gemüse und der darüber gelöffelten Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
