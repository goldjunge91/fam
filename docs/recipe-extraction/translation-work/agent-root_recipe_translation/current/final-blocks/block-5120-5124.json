      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erwärme die Hühnerbrühe und lass die Safranfäden darin 5 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide das Hähnchen in mundgerechte Stücke, die Wurst in Scheiben und Paprika und Zwiebel in Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einem großen Backblech oder einer Paellapfanne bei mittlerer bis hoher Hitze. Bräune Hähnchen und Wurst etwa 5 Minuten an und nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Dünste Paprika und Zwiebel etwa 4 Minuten weich. Gib gehackten Knoblauch dazu und gare ihn 30 Sekunden mit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib den Reis dazu und rühre 2 Minuten, bis er leicht geröstet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gieße die Safranbrühe dazu, gib Hähnchen und Wurst zurück in die Pfanne und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle die Pfanne in den Ofen und backe alles ohne Abdeckung 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rühre Garnelen und Erbsen ein und backe alles weitere 8 bis 10 Minuten, bis die Garnelen rosa und der Reis weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
