      "steps": [
        {
          "position": 0,
          "text": "Gare den Speck in einem großen Topf bei mittlerer bis hoher Hitze knusprig und nimm ihn dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune im selben Topf die gewürfelte Schweineschulter portionsweise etwa 5-7 Minuten pro Portion und stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste gewürfelte Zwiebel und gehackten Knoblauch im restlichen Öl und Fett etwa 5 Minuten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute, damit es karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Schweinefleisch und Speck zurück in den Topf und füge schwarze Bohnen, Lorbeerblätter und Gemüsebrühe hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere dann die Hitze und lasse alles zugedeckt 45-50 Minuten köcheln, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze großzügig mit Salz und Pfeffer und serviere das Gericht heiß mit weißem Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
