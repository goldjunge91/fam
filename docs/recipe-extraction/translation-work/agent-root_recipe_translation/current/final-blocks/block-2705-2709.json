      "steps": [
        {
          "position": 0,
          "text": "Vermische Knoblauch, Petersilie, Koriander, Olivenöl, Limettensaft, Salz, Pfeffer und Chiliflocken in einer Schüssel zu einer Chimichurri-Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tupfe das Fleisch trocken und ritze die Oberfläche leicht mit einem Messer ein, damit die Marinade besser einzieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bestreiche das Rindfleisch großzügig mit der Marinade und lasse es 20 Minuten bei Raumtemperatur oder bis zu 4 Stunden im Kühlschrank ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Grill auf hohe Hitze vor oder verwende eine gusseiserne Pfanne bei hoher Herdhitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille das Fleisch 4-5 Minuten pro Seite für einen halb-rohen Gargrad oder bis zum gewünschten Gargrad.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege es auf ein Schneidebrett und lasse es 5 Minuten ruhen, bevor du es quer zur Faser aufschneidest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle das Fleisch mit zusätzlicher Chimichurri-Sauce und serviere es mit gegrilltem Gemüse oder Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
