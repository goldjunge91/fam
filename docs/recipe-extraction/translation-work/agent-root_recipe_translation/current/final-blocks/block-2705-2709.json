      "steps": [
        {
          "position": 0,
          "text": "Spüle die braunen Linsen gründlich unter kaltem Wasser ab und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle die Zwiebeln sehr fein und hacke Knoblauch und frischen Ingwer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste die Zwiebel 5-7 Minuten, bis sie goldbraun und weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Knoblauch und Ingwer hinzu und gare alles 1 Minute, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre Paprikapulver und Kreuzkümmel ein und gare alles 1 Minute, damit sich die Aromen entfalten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Linsen, Wasser, Salz und Cayennepfeffer hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 30-35 Minuten köcheln, bis die Linsen weich, aber nicht matschig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Rühre gelegentlich um und gib bei Bedarf mehr Wasser hinzu. Serviere das Gericht heiß mit Injera.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
