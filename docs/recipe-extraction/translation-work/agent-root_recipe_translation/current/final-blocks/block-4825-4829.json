      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor und fette ein Muffinblech mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rolle jede Brotscheibe mit einem Nudelholz flach, damit sie biegsam wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke je eine flach gerollte Brotscheibe in jede Muffinmulde und forme sie zu einem Nest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verteile die Hälfte des geriebenen Käses gleichmäßig auf die Brotnester.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage vorsichtig je ein Ei über dem Käse in die Mitte jedes Nests.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bestreue die Nester mit dem restlichen Käse, Salz, Pfeffer und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe sie 12-15 Minuten, bis das Eiweiß gestockt, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse die Nester 2 Minuten abkühlen. Löse sie mit einer Gabel aus dem Blech und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
