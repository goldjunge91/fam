      "steps": [
        {
          "position": 0,
          "text": "Verrühre Milch und Maisstärke in einem Topf, bis die Mischung glatt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Schlagsahne, Zucker und Salz dazu. Erhitze die Mischung bei mittlerer Hitze unter ständigem Rühren etwa 5 Minuten, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den Topf vom Herd und rühre Rosenwasser ein. Gieße die Ashta anschließend zum Abkühlen auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz 2 EL Butter in einer großen Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage vorsichtig alle 4 Eier in die Pfanne und gare sie etwa 4 Minuten, bis das Eiweiß gestockt und das Eigelb noch weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die abgekühlte Ashta auf drei Servierschalen oder Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Setze auf jede Portion ein Ei und bestreue es mit gehackten Pistazien.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht warm mit Fladenbrot oder Pita zum Auftunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
