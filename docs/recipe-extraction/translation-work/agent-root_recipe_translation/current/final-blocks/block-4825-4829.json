      "steps": [
        {
          "position": 0,
          "text": "Schäle die Kartoffeln und schneide sie mit einem Gemüsehobel oder Messer in dünne Scheiben von 0.125 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Zwiebel in dünne Halbringe.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze das Olivenöl in einer beschichteten 10-Zoll-Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kartoffeln und Zwiebeln in das heiße Öl, würze mit Salz und Pfeffer und gare sie unter gelegentlichem Rühren 10 Minuten, bis die Kartoffeln weich zu werden beginnen, aber noch nicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Währenddessen verquirle 6 Eier mit einer Prise Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße Kartoffeln und Zwiebeln durch ein Sieb ab und lasse 2 EL Öl in der Pfanne zurück.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib Kartoffeln und Zwiebeln zurück in die Pfanne und gieße die verquirlten Eier darüber. Gare alles bei mittlerer bis niedriger Hitze 5 Minuten ohne Rühren, bis die Ränder gestockt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege einen Teller auf die Pfanne und stürze die Tortilla vorsichtig darauf. Schiebe sie zurück in die Pfanne und gare die andere Seite 2-3 Minuten, bis sie goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gib die Tortilla auf eine Servierplatte, garniere sie mit Petersilie und lasse sie leicht abkühlen. Schneide sie in Stücke und serviere sie warm oder bei Zimmertemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
