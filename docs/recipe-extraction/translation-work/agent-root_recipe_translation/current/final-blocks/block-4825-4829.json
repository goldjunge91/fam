      "steps": [
        {
          "position": 0,
          "text": "Heize den Backofen auf 375°F vor und fette eine 2-Tassen-Souffléform oder mehrere kleine Formen mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz 2 EL Butter in einem Topf. Rühre das Mehl ein und gare die Mehlschwitze 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße nach und nach die Milch unter ständigem Rühren dazu, damit sich keine Klümpchen bilden. Lasse die Sauce anschließend 2 Minuten köcheln, bis sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nimm den Topf vom Herd und rühre Käse, Salz, Pfeffer und Muskatnuss ein, bis der Käse geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Trenne die Eier und rühre die Eigelbe unter die Käsesauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schlage das Eiweiß in einer sauberen Schüssel mit einer Prise Salz steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Hebe das Eiweiß in zwei Portionen vorsichtig unter die Käsemischung, bis keine weißen Streifen mehr zu sehen sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Fülle die Masse in die vorbereitete Form und backe das Soufflé 20-25 Minuten, bis es aufgegangen und oben leicht gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Sofort servieren, solange das Soufflé noch aufgegangen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
