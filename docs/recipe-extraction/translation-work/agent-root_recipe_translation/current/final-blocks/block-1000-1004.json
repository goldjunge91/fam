      "steps": [
        {
          "position": 0,
          "text": "Schneide das Schweinefleisch in dünne Scheiben. Mariniere es 5 Minuten in Gochujang, Sojasoße, Knoblauch, Ingwer und Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate das Fleisch bei hoher Hitze 10–12 Minuten unter Rühren an, bis es karamellisiert ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bereite die schnelle Gurkenpickle zu: Vermenge die Gurke mit Reisessig und einer Prise Salz und lass sie 5 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Serviere das Fleisch auf Reis mit eingelegter Gurke und Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
