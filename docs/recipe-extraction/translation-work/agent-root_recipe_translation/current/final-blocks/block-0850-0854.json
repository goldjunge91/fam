      "steps": [
        {
          "position": 0,
          "text": "Grundmischung für alle 4 Gläser: ½ Tasse Haferflocken + ½ Tasse griechischer Joghurt + ½ Tasse Milch + 1 Messlöffel Eiweißpulver (aufgeteilt) + etwas Honig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Glas 1 (Erdnussbutter-Banane): 1 EL Erdnussbutter und eine halbe geschnittene Banane dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Glas 2 (Blaubeere): ¼ Tasse Blaubeeren und eine Prise Vanille dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Glas 3 (Apfel-Zimt): ¼ Tasse gewürfelten Apfel und ½ TL Zimt dazugeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Glas 4 (Schokolade): 1 EL Kakaopulver, 1 EL Erdnussbutter und etwas Honig dazugeben. Alle 4 Gläser verschließen und über Nacht in den Kühlschrank stellen. Morgens sind sie fertig.",
