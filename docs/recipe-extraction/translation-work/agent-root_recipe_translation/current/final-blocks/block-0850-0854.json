      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor. Lass die Kichererbsen abtropfen, spüle sie ab und tupfe sie sehr gründlich trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermenge die Kichererbsen mit Olivenöl, geräuchertem Paprikapulver, Kreuzkümmel und Salz. Verteile sie auf einer Hälfte des Backblechs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermenge gewürfelte Süßkartoffel und Brokkoli mit Olivenöl und Salz auf der anderen Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Röste alles 25–28 Minuten, bis die Kichererbsen knusprig und das Gemüse goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Quinoa. Verrühre für das Tahini-Dressing Tahini, Zitrone, Knoblauch, Wasser und Salz. Fülle 4 Behälter mit Getreide, Gemüse und Kichererbsen. Gib das Dressing separat dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
