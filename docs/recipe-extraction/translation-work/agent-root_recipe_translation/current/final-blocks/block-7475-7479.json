    {
      "externalId": "waivy:bake-lemon-poppy-seed-muffins",
      "slug": "bake-lemon-poppy-seed-muffins",
      "title": "Zitrone Poppy Seed Muffins",
      "instructions": "Tender, bakery-style muffins bursting mit bright Zitronenschale und crunchy poppy seeds, topped mit ein tangy Zitrone glaze. Buttermilk keeps der crumb soft und moist while der zest does der real flavor work.",
      "prepTimeMinutes": 15,
      "cookTimeMinutes": 21,
      "storageInstructions": null,
      "reheatingInstructions": null,
      "cheapTips": [
        "kaufen whole lemons und verwenden both der zest und juice, it is far cheaper und brighter than bottled juice.",
        "No buttermilk? umrühren 1/2 Esslöffel Zitronensaft oder vinegar in 3/4 cup normal Milch und lassen it sit 5 Minuten.",
        "Poppy seeds go rancid fast, so kaufen ein klein amount und aufbewahren them in der freezer."
      ],
      "substitutions": [
        {
          "forIngredientId": "buttermilk",
          "swap": "3/4 cup Milch soured mit 1/2 tbsp Zitronensaft",
          "savings": "Keine ganze Packung kaufen, die nicht aufgebraucht wird"
        },
        {
          "forIngredientId": "lemon-juice-bottled",
          "swap": "frisch juice aus der lemons du already zested",
          "savings": "Kostet nichts extra und schmeckt viel besser."
        },
        {
          "forIngredientId": "butter",
          "swap": "gleich amount neutral Pflanzenöl",
          "savings": "Günstiger und hält Muffins länger saftig"
        }
      ],
