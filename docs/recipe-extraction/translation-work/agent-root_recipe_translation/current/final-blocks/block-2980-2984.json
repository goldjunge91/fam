      "steps": [
        {
          "position": 0,
          "text": "Backofen auf 375°F vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Butter in einem Topf schmelzen, Mehl einrühren und unter ständigem Rühren 3 Minuten hellbraun rösten, bis eine Mehlschwitze entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel, Sellerie, Paprika und Knoblauch zur Mehlschwitze geben und 5 Minuten garen, bis das Gemüse weich wird.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hühnerbrühe und Sahne angießen und gut rühren, damit keine Klumpen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Flusskrebsschwänze, Cajun-Gewürz und Thymian hinzufügen und 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Einen Teigboden in eine Pieform von 9-inch legen und mit der Flusskrebsmischung füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit dem zweiten Teigboden bedecken, die Ränder verschließen und mit verquirltem Eigelb bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 375°F 35-40 Minuten backen, bis der Teig goldbraun ist und die Füllung an den Rändern blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
