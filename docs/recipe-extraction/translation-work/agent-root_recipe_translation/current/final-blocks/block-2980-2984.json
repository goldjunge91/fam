      "steps": [
        {
          "position": 0,
          "text": "Paprikapulver, Cayennepfeffer, Thymian, Oregano, Knoblauchpulver, Zwiebelpulver, schwarzen Pfeffer und Salz in einer flachen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Welsfilets trocken tupfen und beide Seiten großzügig mit der Gewürzmischung bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer gusseisernen Pfanne bei mittelhoher Hitze stark erhitzen, bis sie sehr heiß ist und gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schwarz gewürzten Wels in die heiße Pfanne legen und 3 Minuten braten, ohne ihn zu bewegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Filets vorsichtig wenden und weitere 2-3 Minuten braten, bis die Gewürze eine dunkle Kruste bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fisch auf eine Servierplatte legen und sofort mit Zitronenspalten servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
