      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Zucker, Backpulver, Salz und Kreuzkümmelsamen in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verreibe Butter mit der Mehlmischung, bis sie wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Ei mit Milch und gib es zur Mehlmischung. Rühre, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knete den Teig auf einer bemehlten Fläche 1-2 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig etwa 1/4 Zoll dick aus und schneide ihn in Streifen oder kleine Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einem tiefen Topf auf 350°F (175°C).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Frittiere die Teigstücke portionsweise auf jeder Seite 1-2 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm oder bei Zimmertemperatur mit Tee.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
