      "steps": [
        {
          "position": 0,
          "text": "Brate Rinderhackfleisch mit Zwiebel in einer Pfanne bei mittelhoher Hitze 8 Minuten krümelig an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rühre Koriander, Paprikapulver, Zimt, Salz und Pfeffer ein. Nimm die Pfanne vom Herd und lasse die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle 1 Ei in einer Schüssel und rühre es unter die abgekühlte Fleischmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege ein Filoteigblatt auf die Arbeitsfläche und bestreiche es leicht mit Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffel Fleischfüllung auf die linke untere Ecke des Teigblatts.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Falte die untere Ecke über die Füllung und weiter in Dreiecken nach oben, sodass ein dreieckiges Gebäck entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole den Vorgang mit den übrigen Filoteigblättern und der Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze das übrige Olivenöl in einer Pfanne bei mittlerer Hitze und brate die Briouat auf jeder Seite 3-4 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lasse sie auf Küchenpapier abtropfen und bestäube sie vor dem Servieren mit Puderzucker und Zimt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
