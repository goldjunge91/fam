        {
          "position": 0,
          "text": "Vermische Mehl, Backpulver, Salz und Anis in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach Wasser dazu und rühre, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Knete den Teig 2 Minuten glatt und lasse ihn zugedeckt 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl in einem tiefen Topf oder Wok auf 350°F.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in walnussgroße Kugeln und drücke sie vorsichtig zu flachen Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Frittiere die Scheiben auf jeder Seite 2-3 Minuten goldbraun und luftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie zum Abtropfen auf Küchenpapier.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle das warme Gebäck mit Honig und bestreue es noch warm mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
