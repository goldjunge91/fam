      "steps": [
        {
          "position": 0,
          "text": "Vermische Rinderhackfleisch mit der Hälfte der Zwiebeln, Koriander, Petersilie, Eiern, Paprikapulver, Kreuzkümmel, Salz und Pfeffer und forme Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einem Tajine oder schweren Topf bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste die übrigen Zwiebeln 3 Minuten weich. Rühre Tomatenmark ein und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackte Tomaten, Wasser und die übrigen Gewürze dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Fleischbällchen vorsichtig in die Sauce, sodass sie teilweise bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und lasse alles 25-30 Minuten köcheln. Rühre gelegentlich um, bis die Fleischbällchen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke ab und würze bei Bedarf nach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
