      "steps": [
        {
          "position": 0,
          "text": "Koche Oktopus 25 Minuten in Salzwasser weich und gieße ihn ab. Stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Spüle Basmatireis unter kaltem Wasser, bis es klar abläuft, und weiche ihn 15 Minuten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schneide Zwiebeln dünn und frittiere sie in 2 Esslöffeln Öl knusprig goldbraun. Nimm sie heraus und lasse sie abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Joghurt mit gehacktem Knoblauch, Ingwer, Salz und Pfeffer. Mariniere den Oktopus 10 Minuten darin.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze das übrige Öl in einem schweren Topf und gib ganze Gewürze (Kreuzkümmel, Zimt, Kardamom, Nelken) hinein. Röste sie 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe Wasser mit Salz in einem separaten Topf zum Kochen, gib den abgetropften Reis dazu und gare ihn, bis er zu 70% gar ist. Gieße ihn ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte die Hälfte des gekochten Reises mit den Gewürzen auf den Topfboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege den marinierten Oktopus als mittlere Schicht darauf und bedecke ihn mit dem übrigen Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Streue Röstzwiebeln darüber und decke den Topf fest mit Folie und anschließend mit dem Deckel ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gare alles bei hoher Hitze 2-3 Minuten, bis Dampf entsteht. Reduziere die Hitze und gare weitere 15 Minuten, ohne den Deckel zu öffnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Schalte die Hitze aus und lasse den Biryani 5 Minuten ruhen. Lockere den Reis vorsichtig mit einer Gabel auf und garniere ihn vor dem Servieren mit Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
