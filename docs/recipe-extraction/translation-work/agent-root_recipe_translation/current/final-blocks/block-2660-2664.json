      "steps": [
        {
          "position": 0,
          "text": "Mehl, Ei, Wasser und 1/4 tsp Salz zu einem Teig verkneten; 5 Minuten kneten, abdecken und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch mit fein gewürfelter Zwiebel und Zimt vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig dünn ausrollen und in 2-inch-Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jeweils 1 Teelöffel Füllung in die Mitte setzen, zum Dreieck falten und dann die Ecken zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Einen großen Topf Salzwasser zum Kochen bringen und Manti portionsweise garen, bis sie an die Oberfläche steigen, dann weitere 2 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Joghurt mit gehacktem Knoblauch und 1/4 tsp Salz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Manti abgießen, in eine Servierschüssel geben und mit Joghurtsauce bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "2 tbsp Butter mit getrockneter Minze erhitzen, darüberträufeln und sofort servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
