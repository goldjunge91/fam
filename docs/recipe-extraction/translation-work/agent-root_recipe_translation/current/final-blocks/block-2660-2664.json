          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Fleischmischung 5 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backofen auf 425°F vorheizen und Naan-Brote auf Backbleche legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Fleischmischung gleichmäßig auf jedem Naan-Brot verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "12-15 Minuten backen, bis das Brot knusprig und die Ränder goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Heiß servieren, nach Wunsch mit Zitronensaft und frischen Kräutern.",
