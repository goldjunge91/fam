      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch, Semmelbrösel, Ei, fein gewürfelte Zwiebel, Minze, Piment, Salz und Pfeffer in einer Schüssel vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vorsichtig mischen und zu 16-20 kleinen Fleischbällchen formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Olivenöl in einem großen Topf bei mittelhoher Hitze erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Fleischbällchen rundherum etwa 8 Minuten anbraten und bei Bedarf portionsweise arbeiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Tomatensauce und Hühnerbrühe in die Pfanne geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hitze auf mittelniedrig reduzieren und 15 Minuten köcheln lassen, bis die Fleischbällchen durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nach Bedarf nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Mit Reis, Brot oder Nudeln servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
