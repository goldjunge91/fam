      "steps": [
        {
          "position": 0,
          "text": "Frischen Spinat hacken und in einer Pfanne zusammenfallen lassen, dann ausdrücken; tiefgekühlten Spinat auftauen und ebenfalls ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Fetakäse zerkrümeln und mit Spinat, Ei, gewürfelter Zwiebel, schwarzem Pfeffer, Dill und Salz vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backofen auf 375°F vorheizen und ein Backblech mit Backpapier auslegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ein Filoteigblatt auf die Arbeitsfläche legen und leicht mit geschmolzener Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "2-3 tablespoons Füllung an einem Ende platzieren und den Filoteig wiederholt über die Füllung zu einem Dreieck falten, bis das Blatt vollständig gefaltet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Das Dreieck mit der Naht nach unten auf das Backblech legen und die Oberseite mit Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit den übrigen Filoteigblättern und der Füllung wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "20-25 Minuten goldbraun und knusprig backen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
