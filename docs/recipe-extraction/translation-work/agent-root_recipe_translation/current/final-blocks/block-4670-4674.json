      "steps": [
        {
          "position": 0,
          "text": "Von jeder Tomate oben eine dünne Scheibe abschneiden und das Innere mit einem kleinen Löffel aushöhlen. Das Fruchtfleisch beiseitelegen und die Kerne entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Olivenöl in einer Pfanne erhitzen und Zwiebel sowie Knoblauch etwa 2 Minuten anbraten, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Hackfleisch dazugeben und etwa 5 Minuten anbraten, dabei zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vom Herd nehmen und Paniermehl, das beiseitegelegte Tomatenfruchtfleisch, Basilikum, Thymian, Ei, Salz und Pfeffer unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Tomatenschalen großzügig mit der Fleischmischung füllen und aufrecht in eine geölte Auflaufform stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwas Olivenöl über jede gefüllte Tomate träufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 375°F 25-30 Minuten backen, bis die Tomaten weich und die Füllung durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Warm oder bei Zimmertemperatur servieren und nach Belieben mit frischem Basilikum garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
