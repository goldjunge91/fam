      "steps": [
        {
          "position": 0,
          "text": "Von den Paprikaschoten die Deckel abschneiden, Kerne und Trennwände entfernen und eine Paprikaschote für die Soße beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und die gewürfelte Zwiebel etwa 3 Minuten anbraten, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schweinehackfleisch dazugeben und etwa 5 Minuten krümelig braten, bis es gebräunt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Paprikapulver einrühren und 1 Minute anrösten, bis es duftet. Dann den Reis dazugeben und 1 Minute mitrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rinderbrühe und Dosentomaten samt Saft angießen, dann Salz und Pfeffer hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Aufkochen lassen, dann die Hitze reduzieren und 12 Minuten köcheln lassen, bis der Reis teilweise gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jede Paprikaschote mit der Fleisch-Reis-Mischung füllen und aufrecht in den Topf stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Abdecken und 30 Minuten köcheln lassen, bis die Paprikaschoten weich und die Füllung vollständig gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Die Paprikaschoten heiß servieren, mit einem Klecks saurer Sahne garnieren und etwas Brühe darumlöffeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
