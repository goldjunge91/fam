      "steps": [
        {
          "position": 0,
          "text": "Getrocknete Maisblätter 15 Minuten in heißem Wasser einweichen, bis sie biegsam sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maiskörner mit Milch zu einem stückigen Püree pürieren und nach Wunsch abseihen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gewürfelte Zwiebel in Butter weich dünsten und mit Käse, Eiern, Kreuzkümmel, Salz und Pfeffer unter das Maispüree rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jeweils 2 Esslöffel Maismischung auf ein weiches Maisblatt geben und die Seiten nach innen falten, die Oberseite leicht offen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jeweils 2–3 eingewickelte Humitas mit Streifen aus Maisblättern zu Bündeln binden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bündel aufrecht in einen Topf mit Gemüsebrühe stellen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abdecken und 25–30 Minuten dämpfen, bis die Maismischung fest ist und sich leicht von den Blättern löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
