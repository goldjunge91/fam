      "steps": [
        {
          "position": 0,
          "text": "1 Zwiebel, Knoblauch, Koriander und 1/2 Tasse Wasser zu einer glatten Paste pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einem großen Topf erhitzen und Fleischstücke insgesamt etwa 8 Minuten von allen Seiten anbräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die restliche gewürfelte Zwiebel hinzufügen und weich dünsten, dann Koriander-Knoblauch-Paste einrühren und 2 Minuten kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hühnerbrühe zugießen, zum Köcheln bringen, abdecken und 60–75 Minuten garen, bis das Fleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Kartoffelwürfel hinzufügen und weitere 20–25 Minuten köcheln lassen, bis sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Mit Salz und Pfeffer abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Eintopf mit Fleisch und Kartoffeln in der reichhaltigen Koriandersauce über weißem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
