      "steps": [
        {
          "position": 0,
          "text": "Schweinefüße unter fließendem Wasser gründlich reinigen und Haare abschaben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Füße mit 8 Tassen Wasser in einen großen Topf geben, aufkochen, abgießen und abspülen, um Verunreinigungen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gereinigte Füße mit Rinderbrühe, halbierten Zwiebeln und Knoblauchzehen in einen frischen Topf geben und 2 Stunden köcheln lassen, bis das Fleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füße herausnehmen und leicht abkühlen lassen. Fleisch von den Knochen lösen und die Knochen entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Zerpflücktes Fleisch zurück in die Brühe geben und gewürfelte Kartoffeln sowie abgetropften Hominy hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "25–30 Minuten köcheln lassen, bis die Kartoffeln weich sind, dann mit Salz, Pfeffer und Kreuzkümmel würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß in Schalen servieren und mit frischem Koriander sowie Limettenspalten garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
