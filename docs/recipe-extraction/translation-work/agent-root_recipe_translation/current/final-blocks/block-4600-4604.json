      "steps": [
        {
          "position": 0,
          "text": "Mehl, Salz und 1 Esslöffel Öl in einer Schüssel vermischen, dann nach und nach Wasser hinzufügen, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den Teig 5 Minuten kneten, bis er glatt ist, mit einem feuchten Tuch abdecken und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in 4 Kugeln teilen und jede zu einem dünnen Kreis von etwa 6 Zoll Durchmesser ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gewürfelte Zwiebel, Chili, Koriander und eine Prise Salz vermischen und auf jedem Teigkreis verteilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig zur Hälfte falten, dann erneut zur Hälfte falten, sodass ein Dreieck entsteht, und vorsichtig andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine Pfanne oder Tawa bei mittlerer bis hoher Hitze erhitzen und mit Ghee oder Öl bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Jedes Paratha 2-3 Minuten pro Seite backen, bis goldbraune Flecken entstehen, dabei vorsichtig mit einem Pfannenwender andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die fertigen Parathas mit zerlassener Butter bestreichen und heiß mit Joghurt oder Curry servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
