      "steps": [
        {
          "position": 0,
          "text": "Wasser mit Dashipulver zum Köcheln bringen, dann vom Herd nehmen und etwas abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Tofu würfeln und Nori in kleine Stücke reißen, dann die Pilze in dünne Scheiben schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "In einem separaten kleinen Topf Wasser aufkochen und die Eier pochieren, bis das Eiweiß fest, das Eigelb aber noch flüssig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Misopaste auf die Schüsseln verteilen, unter Rühren vorsichtig heiße Dashibrühe angießen und Tofuwürfel hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Jede Schüssel mit Spinat, Pilzen, einem pochierten Ei, Frühlingszwiebeln, Nori-Streifen und Sesam garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
