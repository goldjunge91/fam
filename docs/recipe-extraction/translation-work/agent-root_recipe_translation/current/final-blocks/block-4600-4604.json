      "steps": [
        {
          "position": 0,
          "text": "Hefe und Zucker in warmem Wasser auflösen und 5 Minuten stehen lassen, bis die Mischung schäumt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl und Salz in einer großen Schüssel vermischen, eine Mulde formen und die Hefemischung sowie Olivenöl hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig 8 Minuten kneten, bis er glatt und elastisch ist, dann in eine geölte Schüssel legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Frischhaltefolie abdecken und 1 Stunde an einem warmen Ort gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig in 6 gleich große Kugeln teilen und jede auf eine Dicke von etwa 1/4 Zoll flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die flach gedrückten Teigfladen auf Backpapier legen, abdecken und 30 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Ofen auf 475°F vorheizen und ein Backblech darin 10 Minuten erhitzen.",
