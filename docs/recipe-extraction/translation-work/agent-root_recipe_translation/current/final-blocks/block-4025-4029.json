          "position": 0,
          "text": "Mandelpaste, Puderzucker, Eiweiß, Orangenblütenwasser und Salz in einer Schüssel zu einer formbaren Füllung vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Ein Filoteigblatt auslegen und leicht mit geschmolzener Butter bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2 Esslöffel Füllung entlang einer langen Kante des Filoteigs verteilen und an den Seiten 1 Zoll Rand lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den Filoteig fest um die Füllung rollen und dann zu einer Mondsichel (Gazellenhorn) biegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer tiefen Pfanne auf 350 °F erhitzen und Kaab El Ghzal vorsichtig hineingeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "2–3 Minuten goldbraun frittieren, einmal wenden und anschließend auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Noch warm großzügig mit Puderzucker bestäuben und nach Wunsch mit Honig beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
