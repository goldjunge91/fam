      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermischen. Nach und nach Wasser hinzufügen und zu einem weichen Teig kneten. Abgedeckt 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hackfleisch mit gewürfelter Zwiebel, Koriander, Kümmelsamen und Salz in einer Pfanne bräunen. Die Füllung beiseitestellen und abkühlen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Den Teig in 6 Kugeln teilen und jede auf einer bemehlten Fläche sehr dünn ausrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Den ausgerollten Teig mit Öl bestreichen, dünn mit Fleischfüllung belegen und fest zu einer Rolle aufwickeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Rolle auf Backpapier oder einer geölten Fläche zu einer Spirale formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Öl in einer großen Pfanne auf mittlere Temperatur erhitzen und die Matlouh-Spiralen pro Seite 3–4 Minuten goldbraun und knusprig braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Heiß servieren, nach Wunsch mit Honig oder Harissasauce beträufeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
