      "steps": [
        {
          "position": 0,
          "text": "Wasser oder Brühe in einem großen Topf zum Kochen bringen und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Maismehl langsam unter ständigem Rühren mit einem Holzlöffel in die kochende Flüssigkeit schütten, damit keine Klümpchen entstehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hitze auf mittlere bis niedrige Stufe reduzieren und 10–15 Minuten ständig weiterrühren, bis die Masse dick wird und sich vom Topfrand löst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Butter einrühren, bis sie vollständig aufgenommen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Ugali auf eine Servierplatte geben oder zu einer Kuppel formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Heiß mit gegartem Gemüse, Bohnen oder einem Eintopf zum Auftunken servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
