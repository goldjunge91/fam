      "steps": [
        {
          "position": 0,
          "text": "Rindfleischwürfel mit Küchenpapier trocken tupfen und großzügig mit Salz, Pfeffer und Knoblauchpulver würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Öl in einer großen Pfanne oder Grillpfanne bei hoher Hitze erhitzen, bis es sehr heiß ist und gerade zu rauchen beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Das Fleisch portionsweise anbraten, damit die Pfanne nicht überfüllt wird: pro Seite 2–3 Minuten, bis die Würfel kräftig gebräunt und nach Wunsch gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das gegarte Fleisch auf eine Servierplatte geben und frischen Zitronen- oder Limettensaft darüberpressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Sofort heiß servieren, nach Wunsch mit gegrillten Zwiebeln und Tomaten als Beilage.",
          "timerMinutes": null,
