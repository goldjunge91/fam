      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Kaninchenstücke mit Küchenpapier trocken und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz die Butter in einem großen Topf bei mittlerer bis hoher Hitze und bräune die Kaninchenstücke 4 Minuten pro Seite an; nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate im selben Topf Perlzwiebeln und Pilze an, bis sie leicht gebräunt sind, gib dann das Tomatenmark dazu und rühre 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kriek-Bier, Brühe, Lorbeerblätter und Thymian dazu und lege das Kaninchen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bringe alles zum Köcheln, decke den Topf teilweise ab und gare das Kaninchen 45 Minuten, bis es fast zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die in Stücke geschnittenen Karotten dazu und lasse alles ohne Deckel weitere 15 Minuten köcheln, bis das Kaninchen sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze nach Belieben mit zusätzlichem Salz und Pfeffer und serviere das Kaninchen mit Sauce und Gemüse in Schüsseln.",
