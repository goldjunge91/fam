      "steps": [
        {
          "position": 0,
          "text": "Schneide das Gemüse in Stücke: Karotten in 2 Zoll lange Stücke, Kartoffeln in Viertel, Zwiebeln in Viertel und Sellerie in 2 Zoll lange Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze einen großen Topf bei mittlerer bis hoher Hitze und bräune die Rindfleischstücke portionsweise jeweils 3-4 Minuten pro Seite an; nimm sie dann heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lege das Rindfleisch zurück in den Topf und gib Brühe, Lorbeerblätter und Thymian dazu; bringe alles zum Kochen und reduziere die Hitze auf niedrig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lasse alles ohne Deckel 45 Minuten köcheln und schöpfe den aufsteigenden Schaum ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Karotten, Sellerie und Zwiebeln dazu und lasse alles 20 Minuten köcheln, bis das Gemüse weich zu werden beginnt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Kartoffeln dazu und lasse alles weitere 15 Minuten köcheln, bis das gesamte Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab und serviere den Eintopf mit der Brühe in Schüsseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
