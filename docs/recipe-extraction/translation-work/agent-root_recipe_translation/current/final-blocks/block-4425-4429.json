      "steps": [
        {
          "position": 0,
          "text": "Trenne die Eier, stelle die Eigelbe für die Creme beiseite und gib die Eiweiße in eine saubere Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze die Milch mit der Vanille in einem großen Topf, bis sich am Rand kleine Bläschen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schlage das Eiweiß mit 0.5 Tasse Zucker und Salz mithilfe eines elektrischen Mixers steif.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Setze löffelweise Baisermasse in die heiße Milch und poche sie vorsichtig 2 Minuten pro Seite; hebe sie dann mit einer Schaumkelle auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schlage die Eigelbe mit dem restlichen Zucker hellcremig auf, verrühre die Maisstärke mit Wasser und vermenge beides.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Seihe 1.5 Tassen der Pochiermilch zur Eigelbmasse und rühre sie bei mittlerer Hitze ständig, bis sie nach etwa 5 Minuten eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Vanillesauce auf vier Schüsseln, setze jeweils ein pochiertes Baiser-Ei darauf und stelle sie vor dem Servieren 15 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
