      "steps": [
        {
          "position": 0,
          "text": "Plattiere die Kalbfleischstücke zwischen Frischhaltefolie mit einem Fleischklopfer auf ein Viertel Zoll Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite drei Schüsseln vor: Mehl in die eine, verquirlte Eier in die zweite und Paniermehl in die dritte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Wende jedes Stück im Mehl, schüttle überschüssiges Mehl ab, tauche es dann in Ei und drücke es beidseitig in Paniermehl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze 2 EL Butter in einer großen Pfanne bei mittlerer bis hoher Hitze und brate die Stücke 3 Minuten pro Seite goldbraun an; lege sie dann auf einen Teller.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Schmilz in derselben Pfanne die restliche Butter, brate die Pilze 3 Minuten an, gib dann die Garnelen dazu und gare sie 2 Minuten, bis sie rosa sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib das Kalbfleisch zurück in die Pfanne, würze alles mit Salz und Pfeffer und gare es 1 Minute gemeinsam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege alles auf Teller und beträufle es vor dem Servieren mit frischem Zitronensaft.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
