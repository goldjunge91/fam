      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 400°F vor und verteile die Flügel auf einem mit Folie ausgelegten Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe die Flügel 20 Minuten, bis sie leicht gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Hacke währenddessen die Zehen schwarzen Knoblauchs fein zu einer Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Verquirle Sojasauce, Mirin, Honig, Sesamöl, Reisessig, Wasser und Maisstärke mit der Knoblauchpaste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Flügel aus dem Ofen und bestreiche sie mit der Hälfte der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Backe sie weitere 12 Minuten, bis sie karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vermenge die Flügel mit der restlichen Sauce und garniere sie vor dem Servieren mit Sesam.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
