      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 425°F vor und verteile die Flügel auf einem mit Folie ausgelegten Backblech.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Backe die Flügel 25 Minuten, bis sie leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle währenddessen Gochujang, Honig, Sojasauce, gehackten Knoblauch, Reisessig und Sesamöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schmilz die Butter in einem kleinen Topf und rühre die Gochujang-Mischung bei niedriger Hitze ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Flügel aus dem Ofen und vermenge sie mit der Gochujang-Butter-Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schiebe sie für weitere 10 Minuten zurück in den Ofen, damit die Sauce karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Garniere die Flügel vor dem Servieren mit Sesam und geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
