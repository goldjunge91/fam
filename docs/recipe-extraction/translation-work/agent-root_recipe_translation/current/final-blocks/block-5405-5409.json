      "steps": [
        {
          "position": 0,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke und würze sie mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Pflanzenöl in einer großen Pfanne oder einem Wok bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Brate die Hähnchenstücke 5–7 Minuten, bis sie innen nicht mehr rosa sind, und stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Ingwer und Knoblauch in dieselbe Pfanne und brate beides unter Rühren 30 Sekunden an, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verquirle Sojasauce, Sesamöl, Reisessig, Honig und Maisstärke in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die Sauce in die Pfanne und lass sie 2–3 Minuten köcheln, bis sie leicht eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib das Hähnchen zurück in die Pfanne und vermenge es gleichmäßig mit der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere das Gericht vor dem Servieren auf Reis mit Sesam und geschnittenen Frühlingszwiebeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
