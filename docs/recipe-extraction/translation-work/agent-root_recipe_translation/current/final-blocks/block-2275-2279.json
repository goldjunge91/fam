      "steps": [
        {
          "position": 0,
          "text": "Boden einer Springform von 20–2cm (8–9 inches) mit Backpapier auslegen. Ich lasse meist etwas Papier überstehen, da der Teig sehr flüssig ist und überlaufen kann. Backofen auf 220 Grad Celsius vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Käse reiben und Schinken bereitlegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Alle übrigen Zutaten in einer großen Schüssel etwa ein bis zwei Minuten vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Hälfte des Teigs in die vorbereitete Form gießen; er wird sehr flüssig sein. Schinken und Käse darauflegen und den restlichen Teig darüber gießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Etwa 20–25 Minuten backen oder bis die Oberfläche goldbraun ist. Vor dem Lösen aus der Form einige Minuten warten. Mit frischen Kräutern heiß oder kalt genießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
