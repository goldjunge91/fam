      "steps": [
        {
          "position": 0,
          "text": "0. Aubergine grillen, bis die Schale fast schwarz ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "1. Aubergine kurz abkühlen lassen, dann Schale abziehen. Beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "2. Eier aufschlagen und in eine Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "3. Salz dazugeben und verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "4. Aubergine auf eine flache Fläche legen und mit einer Gabel flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "5. Flachgedrückte Aubergine in die verquirlte Eiermischung tauchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "6. Pfanne erhitzen und Speiseöl hineingießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "7. Aubergine braten, nachdem sie in die verquirlte Mischung getaucht wurde. Beide Seiten garen. Bei mittlerer Hitze dauert das etwa 3 bis 4 Minuten pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
