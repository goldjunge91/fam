      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem Wok oder einer großen Pfanne bei hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate Knoblauch unter Rühren 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Pilze hinzu und gare sie 2 Minuten, bis sie leicht weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Jicama und Karotten hinzu und brate alles 3 Minuten unter Rühren, bis das Gemüse bissfest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Sojasauce, nimm die Pfanne vom Herd und lasse die Füllung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege ein Salatblatt auf jedes Popiah-Blatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gib 2-3 Esslöffel Füllung mittig auf jedes Blatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Beträufle die Füllung mit Erdnusssauce und streue Frühlingszwiebeln darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Rolle das Blatt fest auf, klappe die Seiten ein und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
