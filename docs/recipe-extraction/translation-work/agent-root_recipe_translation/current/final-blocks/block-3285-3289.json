      "steps": [
        {
          "position": 0,
          "text": "Hacke Garnelen fein und vermische sie mit Salz, weißem Pfeffer, Sesamöl, Bambussprossen und Wasserkastanien.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Tapiokastärke, Weizenstärke und Pflanzenöl in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße kochendes Wasser zur Stärkemischung und rühre rasch, bis ein Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Knete den Teig 2 Minuten glatt und decke ihn mit einem feuchten Tuch ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teile den Teig in 10 Stücke und rolle jedes zu einem dünnen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege 1 Esslöffel Füllung auf jeden Kreis, klappe ihn zusammen und falte die Ränder zum Verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege den Dampfeinsatz mit Backpapier aus und ordne die Teigtaschen darauf an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Dämpfe sie 6-8 Minuten über kochendem Wasser, bis sie durchsichtig und gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Serviere sie heiß mit Sojasauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
