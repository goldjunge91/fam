      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf und bräune Rindfleischstücke insgesamt etwa 8 Minuten von allen Seiten. Nimm sie heraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Knoblauch und Ingwer in den Topf und brate sie 1 Minute unter Rühren, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib das Rindfleisch mit Sojasauce, dunkler Sojasauce und Rinderbrühe zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Sternanis und Kandiszucker hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze, decke den Topf ab und lasse alles 1.5 Stunden köcheln, bis das Rindfleisch sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche die Nudeln separat nach Packungsanleitung und gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile die Nudeln auf Schalen und schöpfe geschmortes Rindfleisch mit Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere mit Frühlingszwiebeln und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
