      "steps": [
        {
          "position": 0,
          "text": "Einen großen Topf Salzwasser zum Kochen bringen. Die Kohlblätter vorsichtig einzeln lösen und jeweils 2–3 Minuten blanchieren, bis sie weich sind. Auf Küchenpapier beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reis nach Packungsanleitung kochen und beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rinderhack in einer großen Pfanne bei mittlerer bis hoher Hitze etwa 5 Minuten krümelig anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zwiebel würfeln, Knoblauch hacken, zum Fleisch geben und 3 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gekochten Reis, Salz, Pfeffer und Paprika einrühren und die Pfanne vom Herd nehmen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Etwa 3 Esslöffel Füllung auf jedes Kohlblatt geben, Seiten einklappen und fest aufrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Rouladen mit der Naht nach unten in eine Auflaufform legen. Tomatensauce und Rinderbrühe darüber gießen und mit Folie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bei 350°F 30–35 Minuten backen, bis der Kohl sehr weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
