      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 400°F vorheizen und den Blätterteig auf ein mit Backpapier ausgelegtes Blech legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Champignons und Zwiebel würfeln, Knoblauch fein hacken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Butter in einer großen Pfanne bei mittlerer bis hoher Hitze erhitzen und die Zwiebel etwa 4 Minuten glasig dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Champignons und Knoblauch dazugeben und etwa 10 Minuten braten, bis die Pilze Flüssigkeit abgeben und bräunen. Mit Salz, Pfeffer und Thymian würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und Crème fraîche sowie Dijon-Senf einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Pilzmischung gleichmäßig auf dem Blätterteig verteilen und rundherum einen 0.5-Zoll-Rand frei lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "18–22 Minuten backen, bis der Teig aufgegangen und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "2 Minuten abkühlen lassen, in 4 Stücke schneiden und warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
