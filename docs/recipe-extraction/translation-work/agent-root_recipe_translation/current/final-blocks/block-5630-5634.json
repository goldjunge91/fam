      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 375°F vorheizen und den tiefgekühlten Teigboden in eine Tarteform legen oder auf ein Backblech setzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mandelmasse, Butter, Zucker, Ei und Vanilleextrakt glatt cremig rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Mandelmasse gleichmäßig auf dem Teigboden verstreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Birnen schälen, halbieren, entkernen und jede Hälfte in dünne Scheiben schneiden, ohne sie auseinanderzuschieben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Birnenscheiben fächerförmig auf der Mandelmasse anordnen und leicht andrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "25–30 Minuten backen, bis der Teig goldbraun und die Birnen weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Aprikosenkonfitüre mit Wasser in einem kleinen Topf erwärmen und die warme Tarte damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Raumtemperatur abkühlen lassen, dann anschneiden und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
