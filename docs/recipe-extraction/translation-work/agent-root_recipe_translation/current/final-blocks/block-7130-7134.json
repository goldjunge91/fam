      "steps": [
        {
          "position": 0,
          "text": "Entfernen Sie Stiele und Kerne von den getrockneten roten Chilis und rösten Sie sie dann 30 Sekunden lang in einer trockenen Pfanne leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die Chilis mit kochendem Wasser übergießen und 10 Minuten einweichen lassen. Dann mit Knoblauch, Kreuzkümmel, Salz und Hühnerbrühe verrühren, bis eine glatte Masse entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Chilisauce durch ein feines Sieb passieren, um alle restlichen Hautstücke zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Öl in einer flachen Schüssel erhitzen und jede Tortilla kurz eintauchen, damit sie weich wird, dann in Chilisauce tauchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Füllen Sie jede Tortilla mit zerkleinertem Hähnchenfleisch und gewürfelten Zwiebeln, rollen Sie sie dann fest auf und legen Sie sie mit der Nahtseite nach unten in eine gefettete Auflaufform.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die restliche Chilisauce über alle Enchiladas gießen und Cheddar-Käse darüber streuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 350 °F 20–25 Minuten backen, bis die Sauce sprudelt und der Käse geschmolzen ist, dann mit saurer Sahne garnieren und servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
