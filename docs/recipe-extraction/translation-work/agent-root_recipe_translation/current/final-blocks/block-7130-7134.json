      "steps": [
        {
          "position": 0,
          "text": "Reinigen Sie den Oktopus, indem Sie Kopf, Schnabel und Augen entfernen, und blanchieren Sie ihn dann in kochendem Salzwasser 45–50 Minuten lang, bis er weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kühlen Sie den Oktopus unter fließendem kaltem Wasser ab, ziehen Sie dann die Außenhaut ab und schneiden Sie die Arme in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Oktopusstücke in eine Schüssel geben und vollständig mit frischem Limettensaft bedecken, dann mindestens 30 Minuten in den Kühlschrank stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rote Zwiebeln, Jalapeño, Koriander und Tomaten in einer separaten Schüssel vermischen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Überschüssigen Limettensaft vom Oktopus abgießen, 2 Esslöffel auffangen und die Gemüsemischung vorsichtig unterheben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Olivenöl und den beiseite gestellten Limettensaft über die Ceviche träufeln und vorsichtig umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In gekühlten Schüsseln mit Avocadoscheiben und zusätzlichem Koriander servieren.",
          "timerMinutes": null,
