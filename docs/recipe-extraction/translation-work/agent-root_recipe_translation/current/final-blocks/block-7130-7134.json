      "steps": [
        {
          "position": 0,
          "text": "Schneiden Sie den Tofu in 3/4-Zoll-Würfel und legen Sie ihn zum Blanchieren vorsichtig 5 Minuten lang in kochendes Wasser und lassen Sie ihn dann abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitzen Sie 1 EL Öl in einem Wok oder einer großen Pfanne bei mittlerer bis hoher Hitze und braten Sie das Hackfleisch unter Rühren an, bis es braun ist, und brechen Sie es in kleine Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fügen Sie gehackten Knoblauch und Ingwer hinzu, rühren Sie dann Doubanjiang ein und kochen Sie es 1 Minute lang, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Hühnerbrühe und Sojasauce aufgießen, dann vorsichtig Tofuwürfel dazugeben und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Maisstärke und Wasser verquirlen, dann langsam unter ständigem Rühren 2-3 Minuten lang in die Soße einrühren, damit sie eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Sesamöl darüber träufeln und mit gerösteten Sichuan-Pfefferkörnern und Frühlingszwiebeln bestreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Sofort über gedünstetem weißem Reis servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
