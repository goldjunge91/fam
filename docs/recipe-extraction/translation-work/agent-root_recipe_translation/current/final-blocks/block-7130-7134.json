      "steps": [
        {
          "position": 0,
          "text": "Entfernen Sie die Membran von der Rückseite der Rippchen und tupfen Sie sie mit Papiertüchern trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Salz, Pfeffer, Knoblauchpulver und Paprika vermischen und großzügig auf allen Seiten der Rippchen einreiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Legen Sie die Rippchen mit der Knochenseite nach unten auf einen Räucherofen oder Grill, der auf 225 °F eingestellt ist, und räuchern Sie sie 4 Stunden lang ohne Deckel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Rippchen mit Apfelsaft und Butter fest in Folie einwickeln und dann 2 Stunden lang erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Folie entfernen und großzügig mit BBQ-Sauce und Worcestershire-Sauce bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die ausgepackten Rippchen erneut 30–45 Minuten lang erhitzen, bis die Soße karamellisiert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren 10 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
