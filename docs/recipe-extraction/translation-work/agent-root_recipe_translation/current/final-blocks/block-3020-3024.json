      "steps": [
        {
          "position": 0,
          "text": "Wende Rindfleischwürfel in Mehl, Salz und Pfeffer. Bräune sie portionsweise in heißem Öl in einem großen Topf bei mittelhoher Hitze jeweils 3 Minuten an und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Zwiebel und Karotte in den Topf und gare sie 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Tomatenmark ein und gare es 1 Minute. Lösche dann mit Ale ab und löse die gebräunten Reste vom Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Rindfleisch zurück in den Topf, füge Brühe, Kartoffeln und Thymian hinzu und bringe alles zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Reduziere die Hitze auf niedrig, decke den Topf ab und lasse alles 45 Minuten köcheln, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle die Mischung in eine 9-inch große Pastetenform und lasse sie 10 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Decke sie mit Blätterteig ab, drücke die Ränder mit einer Gabel fest, bestreiche den Teig mit verquirltem Ei und schneide in die Mitte einen kleinen Schlitz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Backe die Pastete bei 400°F 25-30 Minuten goldbraun und lasse sie vor dem Servieren 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
