      "steps": [
        {
          "position": 0,
          "text": "Koche Kartoffeln 15 Minuten in Salzwasser, bis sie sich leicht mit einer Gabel einstechen lassen. Gieße sie ab und stampfe sie mit 2 EL Butter und warmer Milch cremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze währenddessen Öl in einer großen Pfanne bei mittelhoher Hitze und bräune Würstchen 10 Minuten rundherum an. Stelle sie dann beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die übrige Butter in dieselbe Pfanne und gare geschnittene Zwiebeln bei mittlerer Hitze 8 Minuten, bis sie karamellisiert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatenmark unter die Zwiebeln und gare es 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Rinderbrühe in die Pfanne und löse die gebräunten Reste vom Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Würstchen zurück in die Pfanne und lasse sie 5 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteile Kartoffelpüree auf Tellern und belege jede Portion mit 2 Würstchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Löffle Zwiebelsauce über Würstchen und Kartoffeln und serviere sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
