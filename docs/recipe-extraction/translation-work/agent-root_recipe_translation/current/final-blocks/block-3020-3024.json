      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz und arbeite kalte Butter ein, bis die Mischung groben Semmelbröseln ähnelt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib esslöffelweise Eiswasser dazu und rühre, bis der Teig gerade zusammenkommt. Forme eine flache Scheibe und stelle sie 30 Minuten kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische gewürfeltes Rindfleisch, Kartoffel, Steckrübe, Zwiebel, Paprika und Salz in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 4 gleich große Stücke und rolle jedes auf bemehltem Backpapier zu einem 7-inch großen Kreis aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib ein Viertel der Füllung auf eine Hälfte jedes Teigkreises und lasse einen 1-inch breiten Rand frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe den Teig zu einem Halbmond über die Füllung, drücke die Ränder zusammen, drücke sie mit einer Gabel fest und bestreiche sie mit verquirltem Ei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege die Pasteten auf ein Backblech und backe sie bei 400°F 35-40 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie vor dem Servieren 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
