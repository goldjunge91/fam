      "steps": [
        {
          "position": 0,
          "text": "Lege Schellfischfilets mit Milch, Lorbeerblatt und Thymian in eine Pfanne, bringe alles zum Köcheln und pochier den Fisch 6 Minuten, bis er sich leicht zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Fisch aus der Milch, entferne Haut und Gräten, zerpflücke das Fleisch und stelle die Pochiermilch beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Schmilz Butter in einem großen Topf bei mittlerer Hitze und gare gewürfelte Zwiebel 4 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Kartoffeln dazu und gare sie unter häufigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die beiseitegestellte Pochiermilch zu Kartoffeln und Zwiebel in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bringe alles zum Kochen, reduziere die Hitze auf niedrig und lasse die Suppe 15 Minuten köcheln, bis die Kartoffeln sehr weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre zerpflückten Schellfisch und Schlagsahne ein, würze mit Salz und Pfeffer und lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe heiß in Schalen mit knusprigem Brot.",
          "timerMinutes": null,
