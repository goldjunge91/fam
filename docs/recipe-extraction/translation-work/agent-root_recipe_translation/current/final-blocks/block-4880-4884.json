      "steps": [
        {
          "position": 0,
          "text": "Rinderhackfleisch mit gewürfelter Zwiebel und Knoblauch in einer großen Pfanne bei mittelhoher Hitze 5 Minuten anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Chilipulver einrühren und 1 Minute garen. Mais und Oliven hinzufügen, dann mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Maismehl langsam unter die Hühnerbrühe rühren, damit keine Klümpchen entstehen. In die Pfanne gießen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung 5 Minuten köcheln lassen, bis sie eindickt. Dann in eine gebutterte Auflaufform von 9 × 13 Zoll geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Geriebenen Cheddar gleichmäßig darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei 375 °F 20–25 Minuten backen, bis der Käse blubbert und goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Vor dem Servieren 5 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
