      "steps": [
        {
          "position": 0,
          "text": "Poblano-Chilischoten direkt über einer Gasflamme oder unter dem Backofengrill rundherum etwa 5–7 Minuten rösten, bis die Haut schwarz ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die gerösteten Chilis 5 Minuten in einen Plastikbeutel legen und dämpfen lassen. Dann die schwarze Haut unter kaltem fließendem Wasser abziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stiele und Kerne entfernen und die Chilis in Streifen (Rajas) schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "1 EL Butter in einer Pfanne erhitzen und die geschnittene Zwiebel etwa 2 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Poblano-Streifen hinzufügen und 2 Minuten garen. Salzen und die Crema einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Eine Tortilla 15 Sekunden in einer trockenen Pfanne erwärmen, wenden und Käse auf eine Hälfte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "2–3 EL der Rajas-Mischung über dem Käse verteilen und die Tortilla zusammenklappen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "1–2 Minuten je Seite braten, bis sie goldbraun und knusprig ist. Mit den übrigen Tortillas wiederholen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
