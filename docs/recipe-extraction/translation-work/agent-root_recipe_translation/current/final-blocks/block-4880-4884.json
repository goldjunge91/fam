      "steps": [
        {
          "position": 0,
          "text": "Poblano-Chilis direkt über einer Gasflamme oder unter dem Backofengrill rösten, bis die Haut schwarz ist. Anschließend 10 Minuten in einen Plastikbeutel legen und dämpfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Die schwarze Haut abziehen, einen Schlitz einschneiden und vorsichtig die Kerne entfernen, ohne die Chilis aufzuschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Jede Chili mit Käse füllen und beiseitelegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Eier und Mehl glatt verquirlen. Öl in einer Pfanne erhitzen und jede gefüllte Chili von beiden Seiten goldbraun braten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gewürfelte Zwiebel und Knoblauch in einer separaten Pfanne anbraten. Tomatensauce und Kreuzkümmel hinzufügen und 5 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Hälfte der Tomatensauce in eine Auflaufform geben, die gebratenen Chilis darauf anrichten und mit der restlichen Sauce bedecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bei 350 °F 15–20 Minuten backen, bis alles heiß ist und die Sauce blubbert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
