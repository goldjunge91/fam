      "steps": [
        {
          "position": 0,
          "text": "Entferne die Innereien aus dem Bauchraum der Ente und tupfe sie innen und außen mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe 4 cups Wasser mit Ingwer, Sternanis und Zimt zum Kochen. Lass alles 10 Minuten köcheln und dann leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Blanchiere die Ente 3 Minuten im kochenden Wasser. Nimm sie heraus und hänge sie mindestens 30 Minuten zum Trocknen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Honig, Sojasauce und Reisessig und bestreiche die Entenhaut großzügig damit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Röste die Ente mit der Brustseite nach oben im auf 375°F vorgeheizten Ofen 1.5 bis 2 Stunden, bis die Haut dunkel mahagonifarben und das Fleisch durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass die Ente 10 Minuten ruhen und schneide dann Haut und Fleisch in dünne Scheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme Crêpes und serviere sie mit Entenscheiben, Hoisinsauce, Frühlingszwiebelstreifen und Gurkenscheiben zum Einrollen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
