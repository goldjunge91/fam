      "steps": [
        {
          "position": 0,
          "text": "Vermische Schweinehackfleisch, Chinakohl, Frühlingszwiebeln, Ingwer, 1 Esslöffel Sojasauce, Sesamöl, Ei und 2 Esslöffel Maisstärke in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Forme aus der Mischung 6-8 große Fleischbällchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem Schmortopf oder einer tiefen Pfanne und bräune die Fleischbällchen rundherum an, insgesamt etwa 5-6 Minuten. Nimm sie heraus und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Hühnerbrühe und restliche Sojasauce in den Topf, gib die Fleischbällchen zurück und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Decke den Topf ab und schmore alles 20 Minuten, bis die Fleischbällchen gar und der Kohl zart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermische 1 Esslöffel Maisstärke mit 2 Esslöffeln Wasser und rühre die Mischung in die Brühe, damit sie leicht eindickt. Gib dann Zucker dazu und serviere.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
