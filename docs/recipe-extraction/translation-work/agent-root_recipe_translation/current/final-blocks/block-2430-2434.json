      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Lotusblätter 10 Minuten in warmem Wasser ein, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Schweinehackfleisch in einer Pfanne. Gib Pilze, Ingwer, Sojasauce und Sesamöl dazu und gare alles 3 Minuten. Lass die Mischung leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Tupfe das Hähnchen trocken und fülle den Bauchraum mit der gegarten Schweinefleischmischung. Reibe die Außenseite mit Salz und Sojasauce ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wickle das Hähnchen fest in die weichen Lotusblätter und dann das ganze Bündel in Backpapier oder Folie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Backe das eingewickelte Hähnchen im auf 375°F vorgeheizten Ofen 75-90 Minuten, bis es durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Wickle das Hähnchen vorsichtig aus (Dampf entweicht) und serviere es in zerrissenen Lotusblattstücken. Reiche den Bratensaft als Sauce dazu.",
