      "steps": [
        {
          "position": 0,
          "text": "Entferne Stiele und Kerne der getrockneten Chilischoten und röste sie 1 Minute in einer trockenen Pfanne, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche die gerösteten Chilischoten in 1 cup heißem Wasser 10 Minuten ein, bis sie weich sind. Püriere sie dann mit Knoblauch, Zwiebel und Kreuzkümmel glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einem großen Topf, seihe die Chilimischung ins heiße Öl und rühre sie 2 Minuten ständig, damit der rohe Geschmack verschwindet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Hühnerbrühe dazu und bringe alles zum Kochen. Gib Hähnchenbrust hinein und lasse sie 20 Minuten köcheln, bis sie gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm das Hähnchen heraus, zerpflücke es mit zwei Gabeln und gib es mit Salz und Pfeffer nach Geschmack zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Tortillas auf einer Grillplatte und serviere sie neben der rauchigen Brühe in Schalen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Die Gäste stellen ihre Portion zusammen, indem sie Tortillas in die Brühe tunken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
