      "steps": [
        {
          "position": 0,
          "text": "Püriere Schalotten, Knoblauch, rote Chilischoten, Kurkuma und Garnelenpaste mit 1/2 cup Kokosmilch zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem großen Topf und brate die Gewürzpaste 4 Minuten unter ständigem Rühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Fischfond und die restliche Kokosmilch dazu und bringe alles zum Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelten Fisch dazu und gare ihn 10 Minuten, bis er gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Reisnudeln nach Packungsanweisung, gieße sie ab und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Koche Eier hart und schäle sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze die Brühe nach Geschmack mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Verteile die Nudeln auf Servierschalen, schöpfe heiße Brühe mit Fisch darüber und garniere mit Eihälften und Röstschalotten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
