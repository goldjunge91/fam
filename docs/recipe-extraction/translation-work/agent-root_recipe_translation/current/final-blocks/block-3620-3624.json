      "steps": [
        {
          "position": 0,
          "text": "Reinige den Fischkopf gründlich und schneide ihn in 3-4 große Stücke. Entferne die Kiemen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Püriere Schalotten, Knoblauch, Ingwer, rote Chilischoten, Kurkuma und Galgant mit 1/2 cup Kokosmilch zu einer Paste.",
