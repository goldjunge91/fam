      "steps": [
        {
          "position": 0,
          "text": "Spüle Maguey-Würmer aus der Dose oder aufgetaute gründlich ab und tupfe sie mit Küchenpapier trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne bei mittelhoher bis hoher Hitze und dünste Zwiebel glasig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Knoblauch dazu und gare ihn 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Maguey-Würmer in die Pfanne und brate sie 5 Minuten unter Rühren, bis sie leicht knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz und Oregano und vermische alles gut.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme Tortillas in einer anderen Pfanne oder direkt über einer Flamme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Würmer in warmen Tortillas mit Limettenspalten zum Auspressen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
