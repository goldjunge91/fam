      "steps": [
        {
          "position": 0,
          "text": "Heize den Ofen auf 375F vor. Gare Spinat in einer großen Pfanne bei mittelhoher Hitze unter Rühren, bis er zusammengefallen ist. Rühre Apfelessig, Zucker und Pfeffer ein und stelle die Mischung zum leichten Abkühlen beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Klopfe die Hähnchenschenkel mit einem Fleischklopfer dünn und würze beide Seiten mit Geflügelgewürz. Verteile Spinatmischung und zerbröselten Feta auf jedem Schenkel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rolle jeden Schenkel von einer langen Seite aus fest auf und binde ihn mit Küchengarn zusammen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Olivenöl in einer ofenfesten Pfanne bei mittelhoher Hitze. Brate die Hähnchenröllchen rundherum an, bis sie gebräunt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Pfanne in den Ofen und gare das Hähnchen 13 bis 15 Minuten, bis seine Innentemperatur 170F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege das Hähnchen auf einen Teller und halte es warm. Stelle die Pfanne zurück auf den Herd, gib Brühe und Butter hinein und bringe alles zum Kochen. Kratze dabei die gebräunten Reste vom Pfannenboden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lass die Sauce 3 bis 5 Minuten köcheln, bis sie leicht eindickt. Löffle sie zum Servieren über das Hähnchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
