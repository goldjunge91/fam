      "steps": [
        {
          "position": 0,
          "text": "Erwärme Olivenöl in einer großen Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Brate die Schweinekoteletts auf beiden Seiten an, bis sie gebräunt sind. Lege sie auf einen Teller und halte sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die gehackte Zwiebel in dieselbe Pfanne und gare sie unter Rühren, bis sie weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Tomatensauce, Wasser, Chilipulver, Oregano, Worcestershiresauce, Zucker und Chiliflocken ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Schweinekoteletts zurück in die Pfanne und bringe die Sauce zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Reduziere die Hitze, decke die Pfanne ab und lass alles 15 bis 20 Minuten köcheln, bis das Schweinefleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm die Pfanne vom Herd und lass das Fleisch 5 Minuten ruhen. Serviere die Koteletts mit Sauce darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
