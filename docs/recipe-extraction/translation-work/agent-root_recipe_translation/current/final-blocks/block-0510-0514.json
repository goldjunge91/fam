      "steps": [
        {
          "position": 0,
          "text": "Gare das tiefgekühlte Mischgemüse nach Packungsanleitung und stelle es beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 1 Esslöffel Olivenöl in einer großen Pfanne bei mittelhoher Hitze. Gieße die verquirlten Eier hinein und rühre, bis sie gerade gestockt sind und keine flüssige Masse übrig ist. Nimm sie dann aus der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erwärme in derselben Pfanne 2 Esslöffel Sesamöl zusammen mit dem übrigen Esslöffel Olivenöl bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den Reis dazu und brate ihn unter Rühren 10 bis 12 Minuten, bis er anfängt, goldbraun und geröstet zu werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre zerzupftes Hähnchen, Salz und Pfeffer unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe gegartes Gemüse und Rührei unter. Zerteile das Ei beim Umrühren in kleinere Stücke und erhitze alles vollständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Träufle zum Schluss die übrigen 2 Esslöffel Sesamöl darüber und serviere das Gericht heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
