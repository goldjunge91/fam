      "steps": [
        {
          "position": 0,
          "text": "Bereite den Teig zu: Vermische Mehl, Kurkuma und Salz und arbeite kalte Butter ein, bis die Mischung krümelig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib nach und nach kaltes Wasser hinzu, bis ein Teig entsteht. Wickle ihn ein und kühle ihn 20 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Bräune Rinderhackfleisch in einer Pfanne mit Zwiebel, Knoblauch und Scotch Bonnet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Rinderbrühe hinzu und lasse alles köcheln, bis die Flüssigkeit reduziert ist. Lasse die Füllung abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rolle den Teig dünn aus und schneide 4 Zoll große Kreise aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fülle jeden Kreis mit der Rindfleischmischung, klappe ihn zusammen und drücke die Ränder mit einer Gabel fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Pattys bei 375°F 25-30 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
