      "steps": [
        {
          "position": 0,
          "text": "Weiche den Salzfisch über Nacht in Wasser ein, koche ihn dann und zerpflücke das Fleisch. Entferne die Gräten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer Pfanne und dünste Zwiebel, Knoblauch und Thymian, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Paprika und Tomate hinzu und gare sie, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib den zerpflückten Salzfisch in die Pfanne und gare ihn 5 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hebe Ackee vorsichtig unter, ohne die zarten Stücke zu zerdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib Frühlingszwiebeln und schwarzen Pfeffer hinzu und gare alles weitere 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Gericht heiß mit gekochten Klößen oder gebratenen Kochbananen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
