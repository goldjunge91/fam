      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer großen Rührschüssel und drücke in der Mitte eine Mulde hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Eier, Milch und Wasser in die Mulde und verrühre alles vorsichtig mit dem Schneebesen, bis der Teig glatt und klümpchenfrei ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre geschmolzene Butter, Zucker und Vanilleextrakt unter, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lass den Teig für optimale Ergebnisse 30 Minuten bei Raumtemperatur ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze eine beschichtete 8-Zoll-Pfanne oder Crêpe-Pfanne bei mittlerer bis hoher Hitze und fette sie leicht mit Butter ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße 1/4 Tasse Teig in die Mitte und kippe und drehe die Pfanne sofort, damit er sich dünn und gleichmäßig verteilt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Backe die Crêpe etwa 1-2 Minuten, bis die Unterseite hellgoldbraun ist, wende sie dann und backe die andere Seite etwa 30 Sekunden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lege die fertige Crêpe auf einen Teller und wiederhole den Vorgang mit dem restlichen Teig. Serviere sie warm mit Füllungen deiner Wahl, zum Beispiel Obst, Nutella oder Marmelade.",
