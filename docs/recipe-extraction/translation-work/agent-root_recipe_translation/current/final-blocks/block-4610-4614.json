      "steps": [
        {
          "position": 0,
          "text": "Weiche die Bambusspieße 20 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Schweineschulter in 1-Zoll-Würfel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Sojasoße, Sesamöl, Knoblauch, Ingwer, Chiliflocken, Zucker und weißen Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stecke die Schweinefleischwürfel auf die Spieße und bestreiche sie mit der Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze einen Grill oder eine Grillpfanne auf mittlere bis hohe Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Grille die Spieße 10-12 Minuten und wende sie alle 2-3 Minuten, bis das Fleisch vollständig durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Bestreiche sie nach der Hälfte der Garzeit mit der restlichen Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Garniere die Spieße mit gehackten Frühlingszwiebeln und serviere sie heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
