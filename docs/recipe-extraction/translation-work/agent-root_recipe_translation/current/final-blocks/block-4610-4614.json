      "steps": [
        {
          "position": 0,
          "text": "Masa Harina, Salz und warmes Wasser in einer Schüssel vermischen, bis ein weicher, formbarer Teig mit der Konsistenz von Knete entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhackfleisch mit gewürfelter Zwiebel 5 Minuten in einer Pfanne anbraten, dabei zerteilen, dann beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Eine kleine Masa-Kugel in der Hand formen, leicht flach drücken und einen Löffel gegartes Rindfleisch, Bohnen und Käse in die Mitte geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Ränder nach oben falten und die Füllung verschließen, dann vorsichtig zu einer dicken Scheibe von etwa 3 Zoll Breite und 3/4 Zoll Dicke flach drücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Öl in einer großen Pfanne bei mittlerer Hitze erhitzen, bis es schimmert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vorsichtig 2-3 Pupusas in das heiße Öl legen und 3-4 Minuten pro Seite braten, bis sie goldbraun und leicht knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einem Pfannenwender mit Schlitzen herausnehmen und auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Tomatensalsa und eingelegtem Krautsalat servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
