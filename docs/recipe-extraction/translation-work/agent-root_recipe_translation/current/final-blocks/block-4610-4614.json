      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und 1 Esslöffel Öl mit warmem Wasser zu einem weichen Teig und knete ihn 5 Minuten lang.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Lass den Teig abgedeckt 15 Minuten ruhen und teile ihn anschließend in 4 Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Drücke jede Kugel auf einer geölten Fläche sehr dünn aus, bis sie fast durchsichtig ist, und ziehe den Teig vorsichtig mit den Händen auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate Rinderhackfleisch mit gehacktem Knoblauch und gehackter Zwiebel 5 Minuten in einer Pfanne an und würze es mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Rühre die Eier in derselben Pfanne, bis sie vollständig gestockt sind, und vermische sie anschließend mit der Hackfleischmischung und dem Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile 2-3 Esslöffel Füllung auf einer Hälfte jedes ausgerollten Teigkreises.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Klappe den Teig über die Füllung zusammen und drücke die Ränder zum Verschließen fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze das restliche Öl in einer Pfanne bei mittlerer Hitze und brate die Murtabak 3-4 Minuten pro Seite goldbraun und knusprig. Serviere sie heiß mit süßer Chilisauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
