      "steps": [
        {
          "position": 0,
          "text": "Spüle Lampredotto unter kaltem fließendem Wasser ab und blanchiere es 3 Stunden in kochendem Salzwasser, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße es ab und schneide es in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste gehackte Zwiebel, Karotte und Sellerie goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute. Lösche dann mit Weißwein ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gegarte Lampredotto-Stücke, Tomaten aus der Dose, Lorbeerblatt und Rinderbrühe dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse alles 90 Minuten köcheln und rühre häufig um, bis die Sauce eindickt und die Aromen konzentriert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne das Lorbeerblatt, würze mit Salz und Pfeffer und serviere das Gericht heiß mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
