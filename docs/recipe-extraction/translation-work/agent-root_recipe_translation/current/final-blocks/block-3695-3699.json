      "steps": [
        {
          "position": 0,
          "text": "Schneide Schlitze in die Schweinelende und stecke ganze Knoblauchzehen, Rosmarinzweige und Salbeiblätter hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Reibe den Braten großzügig von allen Seiten mit Olivenöl, Salz und Pfeffer ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze eine große ofenfeste Pfanne bei mittelhoher bis hoher Hitze und brate das Schweinefleisch insgesamt etwa 10 Minuten von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Weißwein und Hühnerbrühe rund um den Braten in die Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle die Pfanne in den auf 350°F vorgeheizten Ofen und brate den Schweinebraten 90 Minuten, bis die Kerntemperatur 145°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm den Braten heraus und lasse ihn vor dem Aufschneiden 10 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Seihe den Bratensaft in einen Topf, lasse ihn 3 Minuten köcheln und serviere ihn als Sauce über den Schweinescheiben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
