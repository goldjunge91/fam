      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf und dünste gewürfelte Zwiebel etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib gehackten Knoblauch dazu und gare ihn 1 Minute. Lösche dann mit Weißwein ab und lasse alles 3 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Tomaten aus der Dose und Fischbrühe dazu, bringe alles zum Köcheln und gare es 10 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Fischfilets und Garnelen dazu und lasse sie 5 Minuten köcheln, bis sie teilweise gegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib gereinigte Miesmuscheln dazu, decke den Topf ab und lasse alles 5 Minuten köcheln, bis sich die Muscheln öffnen. Wirf geschlossene Muscheln weg.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würze mit Salz und Pfeffer und rühre 2 tablespoons frische Petersilie ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schöpfe die Suppe in Schalen und serviere sie mit knusprigem, mit Knoblauch eingeriebenem Brot. Garniere sie mit der restlichen Petersilie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
