      "steps": [
        {
          "position": 0,
          "text": "Schäle und würfle Taro, koche ihn 15 Minuten in Salzwasser weich und gieße ihn gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Zerdrücke den gekochten Taro in einer Schüssel glatt und lasse ihn leicht abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verquirle Eier, Milch, Öl und Vanille in einer anderen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Vermische Mehl, Tapiokastärke, Zucker und Backpulver trocken in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vermenge feuchte und trockene Zutaten mit dem Taro zu einem glatten, klümpchenfreien Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße den Teig in eine gefettete runde Kuchenform von 9 Zoll und backe ihn bei 350°F 50-60 Minuten, bis ein Zahnstocher sauber herauskommt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse den Kuchen 15 Minuten in der Form abkühlen und stürze ihn dann zum vollständigen Abkühlen auf ein Kuchengitter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
