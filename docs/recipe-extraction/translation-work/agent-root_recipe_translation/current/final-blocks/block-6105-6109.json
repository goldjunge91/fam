      "steps": [
        {
          "position": 0,
          "text": "Nimm das Hähnchen 30 Minuten vor dem Garen aus dem Kühlschrank und tupfe es innen und außen trocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würze die Bauchhöhle und die Außenseite großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Bauchhöhle mit Knoblauchzehen, Thymianzweigen und Zitronenhälften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reibe die Haut mit weicher Butter ein und lege das Hähnchen mit der Brust nach oben in einen Bräter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Brühe um das Hähnchen herum in den Bräter und gare es bei 425°F 60-75 Minuten, bis der austretende Saft klar und die Haut goldbraun ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lasse das Hähnchen vor dem Tranchieren 10 Minuten ruhen und serviere es mit Bratensaft als Jus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
