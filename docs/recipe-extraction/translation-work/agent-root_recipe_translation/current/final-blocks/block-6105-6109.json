      "steps": [
        {
          "position": 0,
          "text": "Säubere und entgräte den Fisch, tupfe ihn trocken und mache auf jeder Seite 3 schräge Einschnitte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Zitronengras, Knoblauch und rote Chilis fein und vermische sie mit Fischsauce, Limettensaft und Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Fülle die Bauchhöhle mit der Zitronengrasmischung und reibe den Rest außen auf den Fisch.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Heize den Grill auf mittelhohe Hitze vor und öle den Rost gut ein, damit nichts anklebt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Grille den Fisch auf jeder Seite 8-10 Minuten, bis das Fleisch undurchsichtig und die Haut angekohlt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege ihn auf eine Servierplatte und serviere ihn sofort mit gedämpftem Jasminreis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
