      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Natron in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gieße nach und nach warmes Wasser dazu und knete etwa 10 Minuten zu einem weichen, elastischen Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Decke den Teig ab und lasse ihn 1 Stunde bei Zimmertemperatur gehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rolle den Teig 1/4 Zoll dick aus und schneide ihn in 4 Zoll lange Streifen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Öl auf 350°F und frittiere die Teigstreifen portionsweise auf jeder Seite 2-3 Minuten goldbraun und luftig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm sie mit einer Schaumkelle heraus und wende sie sofort warm in Sesam und Zucker.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
