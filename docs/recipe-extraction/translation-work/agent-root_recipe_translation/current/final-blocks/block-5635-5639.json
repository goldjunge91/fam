      "steps": [
        {
          "position": 0,
          "text": "Vier Stücke robuste Alufolie von jeweils 12 × 12 Zoll abreißen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Rinderhack in 4 Portionen teilen und jeweils in die Mitte eines Folienstücks legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Kartoffeln, Zwiebel und Paprika gleichmäßig auf die Päckchen verteilen und auf das Fleisch legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Jedes Päckchen mit Salz, Pfeffer und Knoblauchpulver würzen und mit 1/2 Esslöffel Butter belegen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Folie um die Zutaten falten und die Ränder fest verschließen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Päckchen auf einen Rost 4–6 Zoll über die Kohlen oder auf einen Gasgrill bei mittlerer bis hoher Hitze legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "20–25 Minuten garen und die Päckchen nach der Hälfte der Zeit vorsichtig schütteln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Päckchen vorsichtig öffnen (heißer Dampf entweicht) und direkt aus der Folie servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
