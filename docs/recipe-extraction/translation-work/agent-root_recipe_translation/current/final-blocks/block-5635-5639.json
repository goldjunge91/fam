      "steps": [
        {
          "position": 0,
          "text": "Den Ofen auf 375°F vorheizen und einen Teigboden in eine 9-Zoll-Pastetenform legen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Champignons und Zwiebel fein hacken und in Butter bei mittlerer bis hoher Hitze etwa 12 Minuten braten, bis die ganze Flüssigkeit verdampft ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Die Pilzmischung vom Herd nehmen und frischen Dill, Salz und Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Saure Sahne und 1 ganzes Ei in einer kleinen Schüssel glatt verquirlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Die Sahnemischung unter die Pilze heben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Die Füllung in den Teigboden geben. Den zweiten Teigboden darauflegen, die Ränder zum Verschließen andrücken und oben Dampfschlitze einschneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das übrige Ei verquirlen und den Teigdeckel damit bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "25–30 Minuten backen, bis der Teig goldbraun und die Füllung fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
