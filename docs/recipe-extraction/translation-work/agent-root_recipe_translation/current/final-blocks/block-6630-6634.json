      "steps": [
        {
          "position": 0,
          "text": "Das Rindfleisch in einem großen Topf bei mittlerer bis hoher Hitze anbraten, bis es von allen Seiten scharf angebraten ist, dann herausnehmen und beiseite stellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebeln und gehackten Knoblauch im selben Topf anbraten, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geben Sie das Rindfleisch wieder in den Topf, fügen Sie Rinderbrühe, Zimtstange, Thymian und ganzen Scotch Bonnet Pepper hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Zum Kochen bringen, dann die Hitze reduzieren und zugedeckt 90 Minuten köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Maniok und Kartoffeln schälen und würfeln, dann zur Suppe hinzufügen und 20 Minuten kochen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Callaloo hacken, Kokosmilch einrühren und weitere 10 Minuten köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Scotch Bonnet Pepper im Ganzen herausnehmen, mit Salz und Pfeffer abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
