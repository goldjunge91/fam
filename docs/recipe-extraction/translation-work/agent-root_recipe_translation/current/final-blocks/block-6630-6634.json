      "steps": [
        {
          "position": 0,
          "text": "Sahne und Milch in einem Topf erhitzen, bis sie dampfen, aber nicht kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eigelb mit Zucker ca. 3 Minuten schlagen, bis die Masse hell und dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gießen Sie die heiße Sahne langsam unter ständigem Rühren in die Eimischung, um die Eier zu temperieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Die Mischung wieder in den Topf geben und bei mittlerer Hitze unter ständigem Rühren kochen, bis die Rückseite eines Löffels bedeckt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Durch ein feines Sieb passieren, dann Vanille und Salz unterrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vollständig abkühlen lassen und dann gemäß den Anweisungen des Herstellers in einer Eismaschine umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einen Behälter umfüllen und vor dem Servieren mindestens 4 Stunden einfrieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
