      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche die Wurstdärme gemäß Packungsanweisung 30 Minuten in warmem Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einer großen Pfanne und dünste Zwiebeln und Knoblauch etwa 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Schweinehackfleisch in die Pfanne und brate es etwa 8 Minuten krümelig braun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Thymian, Frühlingszwiebeln, Habanero, Semmelbrösel, Salz und Pfeffer ein und gare alles weitere 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lasse die Masse leicht abkühlen und fülle sie vorsichtig mit einem Spritzbeutel oder Wurstfüller in die vorbereiteten Därme.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Forme die Boudin zu einer Schnecke und sichere sie bei Bedarf mit Zahnstochern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Brate die Boudin in einer Pfanne bei mittelhoher Hitze 8-10 Minuten unter gelegentlichem Wenden rundherum braun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
