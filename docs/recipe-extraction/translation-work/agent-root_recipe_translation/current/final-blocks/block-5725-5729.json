      "steps": [
        {
          "position": 0,
          "text": "Weiche die Holzspieße 30 Minuten in Wasser ein, damit sie nicht verbrennen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Hähnchenbrust in 1-inch große Würfel und stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere Erdnussbutter, Kokosmilch, Sojasoße, Limettensaft, gehackten Knoblauch, Ingwer, Chilipulver und braunen Zucker zu einer glatten Marinade.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Stelle die Hälfte der Marinade als Soße zum Servieren beiseite und stecke die Hähnchenstücke auf Spieße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche das aufgespießte Hähnchen gründlich mit der übrigen Marinade und lasse es 15 Minuten ziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze einen Grill oder eine Grillpfanne bei mittlerer bis hoher Hitze und grille die Spieße 10-12 Minuten. Wende sie alle paar Minuten, bis das Hähnchen durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erwärme die beiseitegestellte Soße in einem kleinen Topf bei niedriger Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Spieße heiß mit der warmen Erdnusssoße zum Dippen.",
