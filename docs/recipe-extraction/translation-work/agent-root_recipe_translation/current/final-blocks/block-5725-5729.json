      "steps": [
        {
          "position": 0,
          "text": "Tupfe die Rinderrippen mit Küchenpapier trocken und würze beide Seiten großzügig mit grobem Salz und schwarzem Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bereite Chimichurri zu, indem du Petersilie und Oregano fein hackst, Knoblauch zerdrückst und alles mit Olivenöl, Essig, Salz und Pfeffer vermischst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Stelle die Hälfte des Chimichurri zum Servieren beiseite und bestreiche die Rippen mit der anderen Hälfte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze einen Grill oder eine gusseiserne Grillpfanne bei hoher Hitze, bis sie sehr heiß ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege die Rippen auf den Grill und brate sie für rosa 4-5 Minuten pro Seite oder für mittleren Gargrad 6-7 Minuten pro Seite an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lege die Rippen auf ein Schneidebrett und lasse sie 5 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere sie heiß mit dem übrigen Chimichurri darüber und daneben zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
