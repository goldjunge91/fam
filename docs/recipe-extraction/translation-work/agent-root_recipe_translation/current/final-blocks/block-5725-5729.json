      "steps": [
        {
          "position": 0,
          "text": "Bereite Chimichurri zu, indem du Petersilie und Knoblauch fein hackst und mit Olivenöl, Essig, Salz und Pfeffer verrührst.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze eine Pfanne bei mittlerer bis hoher Hitze und brate die Chorizo-Würste 10-12 Minuten. Wende sie gelegentlich, bis sie gebräunt und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Würfle rote Zwiebel und Tomate fein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Brötchen längs auf und röste sie nach Wunsch leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm die Chorizo aus der Pfanne und lege je eine Wurst in jedes Brötchen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib einen Löffel Chimichurri, gewürfelte Zwiebel und Tomate darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere das Choripán sofort mit zusätzlichem Chimichurri.",
          "timerMinutes": null,
