      "steps": [
        {
          "position": 0,
          "text": "Weiche die Holzspieße 30 Minuten in Wasser ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Hacke Petersilie, Minze und Zwiebel fein. Zerdrücke den Knoblauch zu einer feinen Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Lammhack mit der Kräutermischung, Zimt, Kreuzkümmel, Piment, Salz und Pfeffer in einer Schüssel, bis alles gerade vermengt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile die Fleischmischung in 8 Portionen und forme jede länglich um einen Spieß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze einen Grill oder eine Grillpfanne bei hoher Hitze und grille die Kafta-Spieße 8-10 Minuten. Wende sie alle 2 Minuten, bis sie durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erwärme das Pitabrot auf dem Grill 1 Minute pro Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere die Kafta im warmen Pitabrot mit Tomate, Salat und Tahinsoße.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
