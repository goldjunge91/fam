      "steps": [
        {
          "position": 0,
          "text": "Schneide Cheddar und Gouda in Stücke von etwa 4 inches mal 2 inches mal 1 inch Dicke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Wickle jedes Käsestück locker in Backpapier und lasse die Oberseite frei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Heize den Räucherofen mit Apfelholzspänen auf 80-90°F vor und stelle ein Blech mit Eis auf den unteren Rost.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Lege die eingewickelten Käsestücke auf den oberen Rost und räuchere sie 30 bis 40 Minuten, bis die Oberfläche goldbraun und leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den Käse aus dem Räucherofen und stelle ihn vor dem Servieren mindestens 2 Stunden kalt, damit sich das Raucharoma entfalten kann.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Serviere den Käse mit Crackern und Prosciutto auf einer Käseplatte.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
