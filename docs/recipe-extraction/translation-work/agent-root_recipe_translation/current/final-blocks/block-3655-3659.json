      "steps": [
        {
          "position": 0,
          "text": "Bringe Wasser und Palmzucker in einem kleinen Topf zum Kochen, nimm ihn vom Herd und lasse die Mischung abkühlen. Das ist dein Palmzuckersirup.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Vermische Klebreismehl, Zucker und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Kokosmilch, bis sie warm ist, und gieße sie unter Rühren nach und nach zur Mehlmischung, bis ein glatter, weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Falls du Pandanblätter verwendest, zerstoße sie und presse den Saft für Farbe und Aroma in den Teig. Extrakt gibst du direkt dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Knete den Teig 2 Minuten glatt und gib bei Bedarf kleine Mengen Wasser dazu, falls er zu trocken ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig zu kleinen Kugeln von etwa 1 inch Durchmesser und drücke sie leicht flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Koche Salzwasser in einem Topf und gib die Teigkugeln portionsweise hinein. Sie steigen an die Oberfläche, wenn sie gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gieße die gekochten Kuih in einem Sieb ab, vermische sie vorsichtig mit geraspelter Kokosnuss und etwas Öl und serviere sie warm mit Palmzuckersirup zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
