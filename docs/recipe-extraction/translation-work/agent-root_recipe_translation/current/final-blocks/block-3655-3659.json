      ],
      "steps": [
        {
          "position": 0,
          "text": "Vermische Tapiokamehl, Reismehl und Salz in einer großen Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Kokosmilch mit Zucker, bis sich der Zucker vollständig aufgelöst hat. Gib dann Öl dazu und nimm den Topf vom Herd.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile die Kokosmischung auf drei Schüsseln auf. Färbe eine grün, eine blau/rosa und lasse eine weiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre jede gefärbte Mischung separat in ein Drittel der Mehlmischung, bis alles glatt ist. Gib bei Bedarf Wasser dazu, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße zuerst die weiße Schicht in eine gefettete 8x8 inch große Backform und dämpfe sie 5 Minuten, bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße die grüne Schicht auf die weiße und dämpfe sie 5 Minuten, bis sie fest ist. Wiederhole dies mit der gefärbten Schicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schichte die Farben weiter und dämpfe sie, bis der gesamte Teig aufgebraucht ist und klar getrennte Farbschichten entstanden sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse alles vollständig abkühlen, schneide es in Rauten oder Quadrate und serviere es bei Raumtemperatur.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
