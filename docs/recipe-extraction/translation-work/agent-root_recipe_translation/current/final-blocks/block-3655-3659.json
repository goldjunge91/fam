      ],
      "steps": [
        {
          "position": 0,
          "text": "Weiche getrocknete Chilischoten 10 Minuten in heißem Wasser ein, gieße sie ab und püriere sie mit Schalotten, Knoblauch, Kurkuma und Garnelenpaste zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze 2 tbsp Kokosöl in einem Topf bei mittlerer Hitze und brate die Chilipaste 3 Minuten, bis sie duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib Fischfond dazu und bringe alles zum Kochen. Reduziere dann die Hitze und lasse es 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Kokosmilch ein und gib Garnelen dazu. Lasse alles 5 Minuten köcheln, bis die Garnelen gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Koche Reisnudeln nach Packungsanweisung in kochendem Salzwasser und gieße sie gut ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verteile die Nudeln auf vier Schalen und schöpfe heiße Laksa-Brühe und Garnelen darüber.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Belege jede Schale mit Sojasprossen und Koriander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe sofort dampfend heiß.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
