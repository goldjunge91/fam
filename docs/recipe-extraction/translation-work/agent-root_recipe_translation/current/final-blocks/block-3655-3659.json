      "steps": [
        {
          "position": 0,
          "text": "Erhitze 1 tbsp Öl in einem Wok oder einer großen Pfanne bei starker Hitze und brate Knoblauch 30 Sekunden, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Hackfleisch dazu und gare es 3 Minuten krümelig, bis es vollständig durch und nicht mehr rosa ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib geraspelten Kohl und Karotten dazu und brate sie 3 Minuten unter Rühren, bis das Gemüse leicht weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße Sojasauce und Sesamöl dazu, vermische alles und würze mit Salz und Pfeffer. Lasse die Füllung 5 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege 2 tbsp Füllung nahe einer Ecke auf jedes Frühlingsrollenteigblatt und rolle es fest auf. Klappe dabei die Seiten ein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze 2 tbsp Öl in einer Pfanne bei mittelhoher bis hoher Hitze und brate die Rollen portionsweise flach 2 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die gebratenen Popia auf Küchenpapier abtropfen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere sie warm mit süßer Chilisauce zum Dippen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
