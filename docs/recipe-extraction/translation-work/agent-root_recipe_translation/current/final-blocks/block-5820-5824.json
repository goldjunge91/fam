          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Drain und rinse the Schweinefleisch under cold Wasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze a wok or large Topf over mittlerer Erhitze und dry-fry the Schweinefleisch cubes bis lightly browned on all sides.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib soy Sauce, rock Zucker, Reis wine, Wasser, ginger slices, Knoblauch cloves, und star anise.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bring to a boil, then reduce Erhitze und köcheln covered für 1.5 hours, stirring occasionally.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib green onions und köcheln uncovered für another 15 Minuten bis Sauce is thickened.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere in a Schüssel mit the braising Sauce over steamed Reis.",
