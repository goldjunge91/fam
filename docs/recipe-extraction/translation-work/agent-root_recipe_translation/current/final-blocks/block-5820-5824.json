          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Set up three shallow bowls: one mit Mehl, one mit beaten eggs, und one mit Brot crumbs mixed mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dredge each cutlet in Mehl, shaking off excess, then dip in egg, then coat thoroughly in Brot crumbs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze butter und Öl in a large skillet over mittlerer-hoher Erhitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Once foaming, carefully Lege cutlets in the Pfanne und Koche für 2-3 Minuten per Seite bis golden brown.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib to a paper towel-lined plate to drain.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere immediately mit lemon wedges und a simple arugula salad.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
