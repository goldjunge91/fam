      "steps": [
        {
          "position": 0,
          "text": "Fischfilets trocken tupfen und beide Seiten mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "2 tbsp Olivenöl in einer Pfanne bei mittelhoher Hitze erhitzen und den Fisch etwa 4 Minuten pro Seite goldbraun braten; beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Im selben Pfanne restliches Öl erhitzen und geschnittene Zwiebeln, Knoblauch und gewürfelte Ají-Schoten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Mit Weißweinessig ablöschen und die gebräunten Reste vom Pfannenboden lösen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fischbrühe, Lorbeerblätter und Kreuzkümmel hinzufügen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Fischfilets zurück in die Pfanne geben und 5 Minuten sanft köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Grüne Oliven hinzufügen und weitere 2 Minuten köcheln lassen, damit sich die Aromen verbinden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In eine Servierschale geben und vor dem Servieren auf Raumtemperatur abkühlen lassen oder warm servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
