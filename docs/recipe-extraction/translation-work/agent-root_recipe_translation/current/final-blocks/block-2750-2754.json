      "steps": [
        {
          "position": 0,
          "text": "Hähnchen in 4 Stücke schneiden, überschüssige Haut entfernen und mit 8 cups Wasser in einen großen Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Aufkochen und den Schaum abschöpfen, der an die Oberfläche steigt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Geviertelte Zwiebel, zerdrückte Knoblauchzehen und halbierte Ají-Schote in den Topf geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "40 Minuten köcheln lassen, dann gewürfelte Karotten, Kartoffeln und Selleriestücke hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weitere 20 Minuten köcheln lassen, bis das Gemüse weich und das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hähnchenstücke herausnehmen, das Fleisch zerpflücken und Knochen sowie Haut entsorgen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Zerpflücktes Hähnchen zurück in die Brühe geben und mit Kreuzkümmel, Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß in Schalen servieren, mit frischem Koriander garnieren und Limettenspalten dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
