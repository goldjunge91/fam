      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf erhitzen und geschnittene Zwiebeln, gehackten Knoblauch sowie gewürfelte Ají-Schoten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Tomaten hinzufügen und 5 Minuten garen, bis sie anfangen zu zerfallen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Weißwein und Fischbrühe angießen und leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Kreuzkümmel hinzufügen und mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fischfilets vorsichtig in die köchelnde Brühe legen und darauf achten, dass sie größtenteils bedeckt sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Abdecken und 12-15 Minuten köcheln lassen, bis der Fisch undurchsichtig ist und sich leicht mit einer Gabel zerteilen lässt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Abschmecken und nach Bedarf nachwürzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "In flachen Schalen servieren, Brühe über den Fisch schöpfen und mit frischem Koriander garnieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
