      "steps": [
        {
          "position": 0,
          "text": "Hähnchen entlang beider Seiten des Rückgrats aufschneiden, flach drücken und dann in 4 Stücke teilen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Knoblauchzehen, Ají-Schoten, Limettensaft, Olivenöl, Kreuzkümmel, Essig, Salz, Pfeffer und Paprikapulver glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Alle Hähnchenstücke gründlich mit der Marinade bestreichen und mindestens 4 Stunden oder über Nacht im Kühlschrank marinieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Backofen auf 425°F vorheizen oder einen Grill im Freien vorbereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bei Verwendung des Backofens Hähnchen in eine Bratform legen und 50-60 Minuten goldbraun und gar braten; alle 15 Minuten mit Bratensaft übergießen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Bei Verwendung des Grills 30-40 Minuten bei mittelhoher Hitze grillen, häufig wenden und mit der restlichen Marinade bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Das Hähnchen ist fertig, wenn die Kerntemperatur an der dicksten Stelle 165°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vor dem Servieren 5 Minuten ruhen lassen und Aji Verde dazu reichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
