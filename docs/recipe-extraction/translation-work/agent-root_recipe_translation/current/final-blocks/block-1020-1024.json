      "steps": [
        {
          "position": 0,
          "text": "Schneide Kartoffeln und Zwiebel in dünne Scheiben. Gare sie 15 Minuten bei mittlerer Hitze in Olivenöl, bis sie weich, aber nicht gebräunt sind. Gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Verquirle die Eier mit Salz. Rühre Kartoffeln und Zwiebeln unter.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße die Mischung in eine geölte 8-inch-Pfanne. Gare sie bei mittlerer Hitze 5 Minuten, bis die Unterseite gestockt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wende das Omelett mithilfe eines Tellers. Lege es zurück in die Pfanne und gare es 2 Minuten. Mit Salat servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
