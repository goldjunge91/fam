      "steps": [
        {
          "position": 0,
          "text": "In einem großen Topf Wasser zum Kochen bringen und gefrorene Sauerkirschen, Zucker, Zimtstange und Salz hinzufügen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "10 Minuten köcheln lassen, bis die Kirschen weich sind und ihren Saft abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischen Sie Maisstärke mit 3 Esslöffeln kaltem Wasser, bis eine glatte Stärkemischung entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühren Sie die angerührte Maisstärke langsam in die Suppe ein und lassen Sie sie leicht köcheln, etwa 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Vom Herd nehmen und Zitronensaft einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "In einer kleinen Schüssel saure Sahne glatt rühren und dann langsam durch Zugabe von 1 Tasse warmer Suppe unter Rühren mildern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den temperierten Sauerrahm vorsichtig wieder in den Topf rühren und warm oder gekühlt servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
