      "steps": [
        {
          "position": 0,
          "text": "Semmelbrösel 5 Minuten in Milch einweichen, dann überschüssige Flüssigkeit ausdrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweineleber, Rückenspeck und gehackte Schalotten zu einer sehr glatten Masse zermahlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Leberhackfleisch mit eingeweichten Semmelbröseln, Eiern, Salz, Pfeffer und Muskatnuss gut vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Hühnerbrühe in einem großen Topf oder einer tiefen Pfanne leicht köcheln lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Mit zwei nassen Löffeln ovale Quenelle formen, indem man die Mischung mit einem Löffel ausschöpft und mit dem anderen glatt streicht, dann vorsichtig in die köchelnde Brühe geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Quenelles 12-15 Minuten pochieren, bis sie schwimmen und sich fest anfühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Quenelles mit einem Schaumlöffel herausnehmen und auf einer Servierplatte warm halten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Quenelles in einer leichten Soße oder mit sautiertem Gemüse servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
