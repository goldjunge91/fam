      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter und Rückenspeck in 1 Zoll große Würfel schneiden und 30 Minuten einfrieren, bis es sehr kalt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schweinefleisch und Fett durch einen Fleischwolf mit einer 1/4-Zoll-Platte zerkleinern und in eine gekühlte Schüssel geben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Salz, Pökelsalz, Koriander, Muskatnuss, Pfeffer und gehackten Knoblauch untermischen, bis alles gut vermischt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füllen Sie die Mischung mit einem Wurstfüller in Schweinedärme und bilden Sie dabei etwa 5 Zoll lange Würste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Därme mit einer Nadel einstechen, um ein Platzen zu verhindern, und 1 Stunde in kaltem Wasser einweichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Apfelholzchips 30 Minuten in Wasser einweichen, dann Smoker auf 225°F vorbereiten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Legen Sie die Würste auf Räuchergestelle und räuchern Sie sie 90 Minuten lang, bis die Innentemperatur 160°F erreicht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Kühlen Sie die Würste vollständig ab, bevor Sie sie heiß mit Sauerkraut oder kalt mit Senf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
