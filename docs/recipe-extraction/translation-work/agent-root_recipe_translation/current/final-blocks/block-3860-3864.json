      "steps": [
        {
          "position": 0,
          "text": "Olivenöl in einem großen Topf bei mittlerer bis hoher Hitze erhitzen und die Rindfleischwürfel von allen Seiten anbraten, insgesamt etwa 8 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Das Rindfleisch herausnehmen und beiseite stellen, dann die gewürfelten Zwiebeln und den Knoblauch im selben Topf etwa 5 Minuten anbraten, bis sie weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Paprikapulver und Tomatenmark einrühren und 1 Minute kochen, bis es duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Rindfleisch wieder in den Topf geben, Rinderbrühe und Lorbeerblätter hinzufügen und zum Kochen bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hitze reduzieren und zugedeckt 45 Minuten köcheln lassen, bis das Rindfleisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Kartoffeln und Karotten hinzufügen und weitere 25-30 Minuten köcheln lassen, bis das Gemüse weich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit Salz und Pfeffer abschmecken und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
