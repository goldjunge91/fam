      "steps": [
        {
          "position": 0,
          "text": "Lege eine quadratische Backform von 8-inch mit Wachspapier oder Folie aus und besprühe sie mit Antihaftspray.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib ½ cup der Mini-Marshmallows auf den Boden der ausgelegten Form.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Schokotropfen und Erdnussbutter in einer mikrowellengeeigneten Schüssel. Erhitze die Schokoladenmischung in Intervallen von 20 seconds und rühre dazwischen um, bis die Schokolade geschmolzen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib Vanilleextrakt hinzu und rühre alles glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Stelle 2 tablespoons der gehackten Mandeln oder Erdnüsse beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Hebe 1 ½ cups Mini-Marshmallows und die übrigen gehackten Nüsse unter die Schokoladenmischung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Fülle die Schokoladenmischung in die vorbereitete Form und verstreiche sie gleichmäßig. Bestreue sie sofort mit den beiseitegestellten gehackten Nüssen und den Mallow-Stückchen oder, falls verwendet, weiteren Mini-Marshmallows.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Stelle die Masse 4 hours in den Kühlschrank oder bis sie fest ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm den Fudge samt Wachspapier aus der Form. Ziehe das Wachspapier vorsichtig vollständig ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Schneide den Fudge in mundgerechte Stücke und serviere ihn.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
