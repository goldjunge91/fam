      "steps": [
        {
          "position": 0,
          "text": "Schneide die Schweineschulter in große Stücke und würze sie großzügig mit Salz und Pfeffer.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Würfle den gepökelten Speck und lasse ihn in einem großen Schmortopf bei mittlerer Hitze knusprig aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Nimm den ausgelassenen Speck heraus und bräune die Schweineschulterstücke im Fett von allen Seiten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib gewürfelte Zwiebeln, gehackten Knoblauch, Lorbeerblätter und Thymian dazu und gare alles 3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lösche mit Weißwein ab und löse die Bratrückstände. Gib dann Brühe und den ausgelassenen Speck dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Decke den Topf ab und schmorte das Fleisch im auf 325°F vorgeheizten Ofen 60 Minuten, bis es sehr zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Entferne die Lorbeerblätter, schmecke ab und serviere das Fleisch heiß mit der darübergelöffelten Schmorflüssigkeit.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
