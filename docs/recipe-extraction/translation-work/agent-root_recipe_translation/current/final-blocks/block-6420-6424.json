      "steps": [
        {
          "position": 0,
          "text": "Erhitze Olivenöl in einem großen Topf bei mittlerer Hitze und dünste gewürfelte Zwiebel 3 Minuten glasig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib den Schinkenknochen oder gewürfelten Schinken und die in Scheiben geschnittene Chorizo dazu. Gare alles 5 Minuten, bis die Chorizo ihr Fett abgibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße Hühnerbrühe dazu und bringe sie zum Kochen. Gib dann gewürfelte Kartoffeln hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Reduziere die Hitze auf mittlere Stufe und lass alles 20 Minuten köcheln, bis die Kartoffeln fast weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße die weißen Bohnen ab, spüle sie ab und gib sie zusammen mit gehacktem Grünkohl in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Lass alles weitere 10-12 Minuten köcheln, bis der Grünkohl zart und die Kartoffeln vollständig gar sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Schmecke mit Salz und Pfeffer ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere die Suppe heiß in tiefen Schüsseln und beträufle jede Portion nach Wunsch mit etwas Olivenöl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
