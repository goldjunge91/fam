      "steps": [
        {
          "position": 0,
          "text": "Säubere den Oktopus unter fließendem Wasser und entferne Tintenbeutel und Schnabel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe Wasser mit Lorbeerblättern und der Hälfte der Zwiebel in einem großen Topf sprudelnd zum Kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib den Oktopus hinein und lass ihn 45-50 Minuten köcheln, bis er zart ist. Prüfe mit einer Gabel, ob er gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Koche gewürfelte Kartoffeln in einem separaten Topf 15-20 Minuten in Salzwasser, bis sie weich sind. Gieße sie ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Nimm den gekochten Oktopus heraus, lass ihn leicht abkühlen und schneide die Tentakel in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vermenge Oktopusstücke und Kartoffeln in einer Servierschüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle alles großzügig mit Olivenöl und bestreue es mit Paprikapulver und Meersalzflocken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere das Gericht warm oder bei Zimmertemperatur mit knusprigem Brot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
