      "steps": [
        {
          "position": 0,
          "text": "Säubere den Tintenfisch gründlich, entferne Haut und Innereien und schneide ihn dann in Ringe und Tentakel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Olivenöl in einer großen Pfanne und dünste gehackten Knoblauch und gewürfelte Zwiebel 2 Minuten an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Tintenfischringe dazu und gare sie unter gelegentlichem Rühren 5 Minuten, bis sie Flüssigkeit abgeben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Streue Paprikapulver darüber und rühre gut um. Gieße Weißwein dazu und lass alles zugedeckt 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Würze mit Salz und Pfeffer und gare alles ohne Deckel weitere 3 Minuten, bis der Tintenfisch zart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Presse etwas frischen Zitronensaft darüber und serviere das Gericht heiß in einer flachen Schüssel mit der Sauce.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
