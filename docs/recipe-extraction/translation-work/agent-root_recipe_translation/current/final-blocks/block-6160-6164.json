      "steps": [
        {
          "position": 0,
          "text": "Vermische Reismehl und Salz in einer Schüssel. Gib langsam warmes Wasser dazu und verquirle alles klümpchenfrei zu einem glatten Teig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Ghee in einer beschichteten Pfanne bei mittlerer Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße 1/4 Tasse Teig in die Mitte und verstreiche ihn vorsichtig mit der Rückseite eines Löffels zu einem dünnen Kreis von 6 Zoll.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gare den Fladen 2-3 Minuten, bis die Unterseite goldbraun ist. Wende ihn vorsichtig und gare die andere Seite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib etwas geraspelte Kokosnuss und einen Teelöffel Palmzucker auf eine Hälfte des gebackenen Pitha.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Klappe das Pitha über der Füllung zusammen und drücke es leicht an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Serviere es warm und wiederhole den Vorgang mit dem restlichen Teig und der Füllung.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
