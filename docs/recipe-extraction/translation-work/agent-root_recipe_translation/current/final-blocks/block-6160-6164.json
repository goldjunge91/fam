      "steps": [
        {
          "position": 0,
          "text": "Röste Koriandersamen 1 Minute in einer trockenen Pfanne an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Weiche getrocknete rote Chilischoten 5 Minuten in warmem Wasser ein und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Püriere geröstete Koriandersamen, eingeweichte Chilischoten, Knoblauch und Ingwer zu einer glatten Paste.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Schneide die Hähnchenbrust in mundgerechte Stücke.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Erhitze Kokosöl in einer Pfanne und dünste gehackte Zwiebeln goldbraun an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die Gewürzpaste dazu und gare sie unter ständigem Rühren 2-3 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Kurkumapulver und Chilipulver ein und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Gib Hähnchenstücke und Curryblätter dazu und brate alles bei hoher Hitze 5 Minuten unter Rühren an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Gieße Wasser dazu, reduziere die Hitze auf mittlere Stufe, decke die Pfanne ab und lass alles 12-15 Minuten köcheln, bis das Hähnchen gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Würze mit Salz und serviere das Gericht heiß mit Reis oder Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
