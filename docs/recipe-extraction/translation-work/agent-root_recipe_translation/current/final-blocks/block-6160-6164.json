      "steps": [
        {
          "position": 0,
          "text": "Erhitze 2 Esslöffel Ghee in einer Pfanne und röste den Sesam 2-3 Minuten an, bis er duftet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Palmzucker zum gerösteten Sesam und vermenge alles gut. Lass die Füllung anschließend abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Reismehl mit Salz und 1 Esslöffel Ghee. Gib nach und nach Wasser dazu, bis ein weicher Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 8-10 Kugeln und drücke jede mit der Handfläche flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib einen Löffel Sesam-Palmzucker-Füllung in die Mitte, schlage die Ränder ein und verschließe den Fladen zu einer Kugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Kokosöl in einem tiefen Topf auf 350°F und frittiere die Pithas rundherum goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Nimm sie mit einer Schaumkelle heraus, lass sie auf Küchenpapier abtropfen und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
