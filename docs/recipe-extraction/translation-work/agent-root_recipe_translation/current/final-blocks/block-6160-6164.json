      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl und Salz in einer Schüssel. Gib nach und nach Wasser dazu, bis ein weicher Teig entsteht, und knete ihn 5 Minuten glatt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Decke den Teig mit einem feuchten Tuch ab und lass ihn 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teile den Teig in 8 gleich große Portionen und forme Kugeln daraus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Ziehe eine Teigkugel auf einer geölten Fläche zu einem sehr dünnen Rechteck von etwa 12x8 Zoll auseinander.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bestreiche den Teig großzügig mit Ghee und bestreue ihn mit fein gehackter Zwiebel, grüner Chili, Curryblättern und schwarzen Kreuzkümmelsamen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rolle den Teig von einer langen Seite aus fest zu einer langen Rolle auf. Wickle diese zu einer Spirale und drücke sie leicht flach.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Wiederhole den Vorgang mit den übrigen Teigportionen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Erhitze eine gusseiserne Platte oder Pfanne bei mittlerer bis hoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Lege eine Parotta auf die Platte und gare sie 2-3 Minuten, bis goldene Stellen entstehen. Bestreiche sie mit Ghee und wende sie.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Gare die andere Seite 2-3 Minuten, bis sie goldbraun und knusprig ist. Drücke sie dabei leicht mit einem Pfannenwender an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Serviere sie heiß mit Curry, Sambar oder Chutney.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
