      "steps": [
        {
          "position": 0,
          "text": "Hacke den Knoblauch und das Zitronengras fein und vermische beides mit Fischsauce, Honig, Sojasauce, Limettensaft und schwarzem Pfeffer in einer Schüssel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneide die Hähnchenschenkel in 2 Zoll große Stücke, wende sie gründlich in der Marinade und stelle sie mindestens 30 Minuten in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Erhitze Öl in einer großen Pfanne bei mittlerer bis hoher Hitze und lege das marinierte Hähnchen in einer Lage hinein.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Brate es 6-7 Minuten pro Seite, bis es karamellisiert und gar ist. Wende es gelegentlich, damit alle Seiten bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Lege das Fleisch auf eine Servierplatte und beträufle es mit der restlichen Sauce aus der Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
