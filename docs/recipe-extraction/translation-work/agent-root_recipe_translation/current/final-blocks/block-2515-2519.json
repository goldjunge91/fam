      "steps": [
        {
          "position": 0,
          "text": "Blanchiere die Rinderrippen 5 Minuten in kochendem Wasser. Gieße sie ab und spüle sie unter kaltem Wasser ab, um Verunreinigungen zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bringe in einem großen Topf 8 Tassen frisches Wasser zum Kochen. Gib die gesäuberten Rippen, geviertelte Zwiebel, Knoblauchzehen und Ingwerscheiben hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Lasse alles 45 Minuten köcheln, bis das Fleisch zart ist, und schöpfe regelmäßig den Schaum von der Oberfläche ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Seihe die Brühe ab und gib sie zurück in den Topf. Füge gewürfelten Daikon-Rettich hinzu und gare ihn 15 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Weiche die Süßkartoffelnudeln 10 Minuten in warmem Wasser ein, bis sie weich sind, und gieße sie dann ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib die eingeweichten Nudeln in die Brühe und gare sie 5 Minuten. Gib dann die gegarten Rinderrippen zurück in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Sojasauce, Sesamöl und Salz. Gib Sesamblätter hinzu und lasse alles 2 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue das Gericht mit gehackten Frühlingszwiebeln und serviere es heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
