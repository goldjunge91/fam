      "steps": [
        {
          "position": 0,
          "text": "Erhitze Sesamöl in einem großen Schmortopf bei mittlerer Hitze und bräune die Spam-Scheiben auf beiden Seiten, bis die Ränder knusprig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Nimm den Spam heraus und gib die Rinderwürstchen hinein. Brate sie 2 Minuten, bis sie leicht gebräunt sind, und schiebe dann alles an den Rand.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Verrühre Gochujang, Gochugaru, Knoblauch und Zucker in der Mitte des Topfs.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gieße die Gemüsebrühe hinzu und bringe alles zum Köcheln. Gib dann Kimchi hinzu und rühre gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Spam und Würstchen zurück in den Topf und füge gebackene Bohnen sowie Tofuwürfel hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Zerbrich die Instant-Ramen-Nudeln und gib sie in den Topf (entsorge das Gewürzpäckchen oder bewahre es für später auf). Koche alles 3-4 Minuten, bis die Nudeln weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Würze mit Sojasauce und schmecke alles ab.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Bestreue das Gericht mit gehackten Frühlingszwiebeln und serviere es heiß direkt aus dem Topf mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
