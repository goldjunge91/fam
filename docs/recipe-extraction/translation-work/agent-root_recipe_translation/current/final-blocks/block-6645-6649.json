      "steps": [
        {
          "position": 0,
          "text": "Maismehl, Kokosraspeln, braunen Zucker, Rosinen, Zimt und Muskatnuss in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Geschmolzene Butter und Vanilleextrakt unterrühren, bis die Mischung gleichmäßig befeuchtet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Überbrühen Sie Bananenblätter oder bereiten Sie Folienquadrate vor, indem Sie sie kurz bei Hitze einweichen, wenn Sie Bananenblätter verwenden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teilen Sie die Maismehlmischung in 8 gleiche Portionen und legen Sie jede auf ein Bananenblatt oder ein Folienquadrat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Falten Sie die Bananenblätter oder die Folie zu versiegelten Päckchen und falten Sie die Ränder fest.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Legen Sie die Päckchen mit der Naht nach unten in einen großen Topf mit etwa 1 cm Wasser am Boden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den Topf abdecken und 45–50 Minuten dämpfen, bis das Duckanoo fest und durchgegart ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Vorsichtig auspacken und warm servieren, als süßes Frühstück oder Dessert.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
