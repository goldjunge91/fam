      "steps": [
        {
          "position": 0,
          "text": "Mehl, Backpulver und Salz in einer großen Schüssel vermischen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Kalte Butter in kleine Würfel schneiden und mit den Fingerspitzen in die Mehlmischung einarbeiten, bis sie wie Semmelbrösel aussieht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gehackten Knoblauch, gewürfelte Zwiebeln und Koriander zu der Mischung hinzufügen und gut umrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Unter Rühren nach und nach Wasser hinzufügen, bis ein weicher, nicht klebriger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Den Teig auf einer bemehlten Arbeitsfläche 2 Minuten lang sanft kneten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rollen Sie den Teig auf eine Dicke von 1/8 mm aus und schneiden Sie ihn mit einem Messer in 2 x 2 cm große Quadrate.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Pflanzenöl in einer tiefen Pfanne oder einem Topf auf 350 °F erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Die Ausstecher portionsweise 2-3 Minuten pro Seite braten, bis sie goldbraun und luftig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Küchenpapier abtropfen lassen und warm mit Curry oder Eintopf servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
