      "steps": [
        {
          "position": 0,
          "text": "Schäle Kochbananen, grüne Bananen und Kartoffeln unter fließendem Wasser, damit sie sich nicht verfärben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schneiden Sie das gesamte Gemüse in 2 cm große Stücke und geben Sie es in einen großen Topf mit Salzwasser.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zum Kochen bringen und 25–30 Minuten kochen lassen, bis das gesamte Gemüse gabelweich ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Das Gemüse in einem Sieb gut abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Butter in einer Pfanne erhitzen und den gehackten Knoblauch und die gewürfelten Zwiebeln etwa 3 Minuten lang goldbraun anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Geben Sie das abgetropfte Gemüse zur Buttermischung und zerstampfen Sie es, bis eine cremige Masse entsteht, in der noch einige Klümpchen übrig sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit schwarzem Pfeffer und zusätzlichem Salz abschmecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Heiß mit Kabeljau oder anderem Protein als Beilage servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
