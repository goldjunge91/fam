            }
          ]
        }
      ],
      "steps": [
        {
          "position": 0,
          "text": "Schälen Sie die Maniokwurzel mit einem scharfen Messer und entfernen Sie die braune Außenschicht vollständig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Den geschälten Maniok unter kaltem Wasser abspülen und in Stücke schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reiben Sie die Maniokstücke mit einer Küchenreibe oder einer Küchenmaschine fein, bis sie vollständig zerkleinert sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Legen Sie den zerkleinerten Maniok in ein sauberes Küchentuch und drücken Sie ihn in mehreren Portionen fest aus, um überschüssige Feuchtigkeit zu entfernen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Verteilen Sie das getrocknete Maniokmark auf einer sauberen Oberfläche und brechen Sie alle großen Klumpen auf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitzen Sie eine große Grillplatte oder eine gusseiserne Pfanne bei mittlerer bis hoher Hitze und bedecken Sie sie leicht mit Öl.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Verteilen Sie die Maniokmischung gleichmäßig auf der heißen Grillplatte und drücken Sie sie vorsichtig mit einem Spatel an, um einen etwa 1/4 cm dicken flachen Kuchen zu formen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf jeder Seite 8-10 Minuten goldbraun und knusprig braten, bei Bedarf in Stücke brechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Auf Papiertüchern abkühlen lassen und in einem luftdichten Behälter aufbewahren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
      "images": [
