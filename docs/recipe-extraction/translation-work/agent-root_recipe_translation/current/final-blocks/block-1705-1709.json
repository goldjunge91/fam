      "steps": [
        {
          "position": 0,
          "text": "Die Hälfte des Mehls sieben und mit Salz und Hefe in einer großen Schüssel vermischen. Langsam warmes Wasser zugießen, bis ein fester Teig entsteht. Weiter gesiebtes Mehl hinzufügen, bis der Teig fest genug zum Kneten ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Arbeitsfläche leicht bemehlen und den Teig 10 Minuten glatt und elastisch kneten. In eine gefettete Schüssel legen und an einen warmen Ort stellen. 40–50 Minuten gehen lassen, bis sich das Volumen verdoppelt hat. Der Teig ist bereit, wenn eine eingedrückte Fingerspur bleibt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backofen auf 425 Grad F oder 220 Grad C vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig in 12 gleiche Portionen teilen, jeweils zu einer faustgroßen Kugel rollen und auf ein gefettetes Backblech legen. Noch einmal an einem warmen Ort 40 Minuten gehen lassen oder bis sich das Volumen erneut verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Auf der mittleren Schiene 25–30 Minuten backen, bis die Brötchen goldbraun sind und beim Klopfen hohl klingen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
