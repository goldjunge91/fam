      "steps": [
        {
          "position": 0,
          "text": "Für den Teig Mehl abmessen und Butter mit den Fingerspitzen hineinreiben, bis die Mischung feinen Brotkrümeln ähnelt. Wasser dazugeben und zu einem weichen Teig vermengen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Teig auf einer leicht bemehlten Fläche ausrollen und eine 20cm/8in Tarteform damit auslegen. 30 Minuten im Kühlschrank kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Backofen auf 200C/400F/Gasstufe 6 (180C Umluft) vorheizen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teigboden mit Folie auslegen und mit Backbohnen füllen. Etwa 15 Minuten blindbacken. Bohnen und Folie entfernen und weitere fünf Minuten backen, damit der Boden trocknet.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Füllung den Boden großzügig mit Himbeermarmelade bestreichen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Butter in einem Topf schmelzen und vom Herd nehmen. Zucker einrühren. Gemahlene Mandeln, Ei und Mandelextrakt dazugeben. In die Form gießen und gehobelte Mandeln darüberstreuen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Etwa 35 Minuten backen. Wenn die Mandeln zu schnell bräunen, die Tarte locker mit Folie abdecken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
