      "steps": [
        {
          "position": 0,
          "text": "Milch und Butter auf 110 °F erwärmen, Hefe in der warmen Mischung auflösen und 5 Minuten stehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Mehl, Zucker, Salz und Vanille in einer großen Schüssel vermischen. Hefemischung und Eier hinzufügen und 8 Minuten kneten, bis der Teig glatt und elastisch ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Teig in eine geölte Schüssel legen, mit Frischhaltefolie abdecken und 90 Minuten gehen lassen, bis sich das Volumen verdoppelt hat.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teig zusammendrücken, zu einer langen Rolle formen und auf einem gefetteten Backblech zu einem Ring legen. Enden verbinden und weitere 30 Minuten gehen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Bei 350 °F 25–30 Minuten goldbraun backen, bis der Kuchen beim Klopfen hohl klingt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vollständig abkühlen lassen. Puderzucker mit 2 Esslöffeln Wasser verrühren und in drei Portionen mit Lebensmittelfarbe einfärben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Den abgekühlten Kuchen mit den farbigen Glasuren in abwechselnden Streifen in den Mardi-Gras-Farben überziehen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
