      "steps": [
        {
          "position": 0,
          "text": "Schweineschulter und Rückenspeck portionsweise in einer Küchenmaschine fein zerkleinern.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gehackten Knoblauch, Cayennepfeffer, schwarzen Pfeffer, Salz, Thymian und Pökelsalz zum Schweinefleisch geben und gründlich vermengen, bis die Masse klebrig ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung und Wursthüllen 30 Minuten im Gefrierfach kühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Wursthüllen 10 Minuten in warmem Wasser einweichen, bis sie weich sind, dann vorsichtig mit einem Wurstfüller oder Spritzbeutel füllen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Hüllen in Abständen von 4 Zoll abbinden und Luftblasen mit einer Nadel einstechen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Würste an einem kühlen Ort (55–65 °F) 24–48 Stunden aufhängen, damit sie leicht trocknen und Aroma entwickeln, falls möglich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "In einer Pfanne bei mittlerer Hitze unter gelegentlichem Wenden etwa 20 Minuten braten, bis sie gebräunt und durchgegart sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
