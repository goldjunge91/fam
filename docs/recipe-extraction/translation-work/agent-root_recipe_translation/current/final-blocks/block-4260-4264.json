      "steps": [
        {
          "position": 0,
          "text": "Für eine Mehlschwitze Öl in einem großen Topf bei mittlerer Hitze erwärmen und Mehl einrühren. Unter ständigem Rühren 8–10 Minuten goldbraun kochen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gewürfelte Zwiebel, Sellerie, Paprika und gehackten Knoblauch zur Mehlschwitze geben und 5 Minuten weich dünsten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gemüsebrühe nach und nach unter Rühren zugießen, damit keine Klümpchen entstehen, und zum Köcheln bringen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gehacktes gemischtes Blattgemüse und Okra hinzufügen und gut verrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "20 Minuten köcheln lassen und gelegentlich rühren, bis das Gemüse sehr weich ist und sich die Aromen verbunden haben.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Vom Herd nehmen, Filé-Pulver einrühren und großzügig mit Salz und Pfeffer würzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Gumbo über heißem Reis servieren. Bei Bedarf die Brühe mit zusätzlichem Wasser verdünnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
