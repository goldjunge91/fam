      "steps": [
        {
          "position": 0,
          "text": "Schmilz 1 EL Butter in einer großen Pfanne bei mittelhoher Hitze und gare gewürfelte Zwiebel 2 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib fein geschnittenen Kohl dazu und gare ihn unter gelegentlichem Rühren 6-8 Minuten, bis er weich ist und anfängt zu bräunen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Vermische Kartoffelpüree und Kohlmischung in einer Schüssel, würze mit Salz und Pfeffer und rühre alles gut um.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Öl und die übrige Butter in der Pfanne bei mittelhoher Hitze.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme aus der Kartoffel-Kohl-Mischung 4 Bratlinge und lege sie in die heiße Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Brate sie 4-5 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lege sie auf einen mit Küchenpapier ausgelegten Teller und serviere sie heiß mit Spiegeleiern oder pochierten Eiern und Bohnen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
