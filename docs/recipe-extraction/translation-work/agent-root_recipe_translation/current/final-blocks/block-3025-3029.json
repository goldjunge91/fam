      "steps": [
        {
          "position": 0,
          "text": "Bringe 6 cups Wasser in einem großen Topf zum Kochen und gib Salz dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Streue Gari langsam unter ständigem Rühren in das kochende Wasser, damit sich keine Klümpchen bilden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Reduziere die Hitze auf niedrig und rühre häufig 20-25 Minuten, bis die Mischung glatt und dick ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erhitze Butter in einem anderen Topf und bräune Rinderhackfleisch mit Zwiebeln und Knoblauch an.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib Tomatenmark dazu und gare es 2 Minuten. Füge dann gewürfelte Karotten und zerbröselte Maggi-Würfel hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gieße 2 cups Wasser dazu und lasse alles 15 Minuten köcheln, bis die Karotten weich sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Rühre Spinat ein und gare ihn 3-5 Minuten, bis er zusammengefallen ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Serviere den Gari-Hügel auf einem Teller und schöpfe die Suppe darüber und darum herum.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
