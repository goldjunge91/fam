      "steps": [
        {
          "position": 0,
          "text": "Tupfe den Fisch trocken und würze beide Seiten leicht mit Salz.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Erhitze Öl in einem breiten Topf und brate den Fisch vorsichtig auf jeder Seite 3 Minuten goldbraun. Nimm ihn heraus und stelle ihn beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Dünste Zwiebel im selben Topf weich. Gib Knoblauch und Ingwer dazu und gare alles 1 Minute.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre gewürfelte Tomaten und scharfe Chili ein und gare sie 5 Minuten weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Kokosmilch hinein, lege den Fisch vorsichtig zurück in die Sauce und lasse alles ohne Deckel 10 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Rühre Koriander und Limettensaft ein, lege den Fisch vorsichtig auf eine Servierplatte und serviere heiß mit Reis.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
