      "steps": [
        {
          "position": 0,
          "text": "Erhitze Öl in einem großen Topf bei mittelhoher Hitze und bräune die Rindfleischwürfel rundherum an. Stelle sie beiseite.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Dünste gewürfelte Zwiebeln, gehackten Knoblauch und Ingwer im selben Topf an, bis sie duften.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib gewürfelte Tomaten dazu und gare sie unter gelegentlichem Rühren 3-4 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Gib das Rindfleisch zurück in den Topf und füge Kurkuma, Salz und Pfeffer hinzu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gieße Rinderbrühe hinein und bringe alles zum Kochen. Reduziere die Hitze und lasse es 20 Minuten köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Schäle und würfle grüne Kochbananen und gib sie in den Topf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse alles weitere 15 Minuten köcheln, bis die Kochbananen weich und das Fleisch gar ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Schmecke ab und serviere heiß mit Reis oder Ugali.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
