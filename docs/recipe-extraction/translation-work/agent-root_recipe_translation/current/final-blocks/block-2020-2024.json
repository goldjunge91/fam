      "steps": [
        {
          "position": 0,
          "text": "Verrühre Butter und Zucker cremig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Gib Öl, Mehl und Grieß dazu und vermische alles.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib warme Milch dazu und knete den Teig nicht zu lange.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Decke den Teig ab und lass ihn eine Stunde oder kürzer ruhen, bis die Füllung vorbereitet ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Für die Dattelfüllung röste etwas Sesam in einer Pfanne und gib dann Butter dazu. Füge Dattelpaste hinzu und vermische sie gut mit Sesam und Butter. Gib nach und nach etwas Wasser dazu, bis die Masse weich ist. Sie darf nicht zu weich werden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Nimm die Masse aus der Pfanne und lege sie zum Abkühlen auf einen Teller. Forme dann Kugeln zu je 15 gm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Stelle sie 1/2 Stunde in den Kühlschrank.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Forme anschließend aus dem Teig Kugeln zu je 30 gm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 8,
          "text": "Nimm die Dattelfüllung aus dem Kühlschrank und fülle jede Teigkugel mit einer Dattelkugel.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 9,
          "text": "Drücke die Mamoul mit einer passenden Form in ihre typische Gestalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 10,
          "text": "Backe sie im auf 180 Grad vorgeheizten Ofen 20 Minuten, bis die Unterseite und die Oberseite leicht goldbraun sind.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
