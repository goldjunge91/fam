      "steps": [
        {
          "position": 0,
          "text": "Mehl und Salz in einer Schüssel vermengen, nach und nach Wasser hinzufügen und zu einem festen Teig verarbeiten; 5 Minuten kneten, abdecken und 20 Minuten ruhen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "3 Esslöffel Öl in einer Pfanne bei mittlerer Hitze erhitzen und Rinderhack krümelig anbraten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Zwiebel und Knoblauch hinzufügen und weich dünsten, dann Kartoffeln, Tomatenmark, Habanero und schwarzen Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Füllung 15 Minuten köcheln lassen, bis die Kartoffeln weich sind, dann zum leichten Abkühlen beiseitestellen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Teig auf einer bemehlten Fläche 1/8-inch dick ausrollen und in 4-inch große Quadrate schneiden.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Jeweils einen Löffel Füllung in die Mitte geben, zu einem Dreieck falten und die Ränder mit einer Gabel zusammendrücken.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "2 cups Öl auf 350°F (175°C) erhitzen und Pastels portionsweise etwa 3-4 Minuten pro Seite goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Auf Küchenpapier abtropfen lassen und heiß servieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
