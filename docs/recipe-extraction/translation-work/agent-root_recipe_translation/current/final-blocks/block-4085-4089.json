      "steps": [
        {
          "position": 0,
          "text": "Spalterbsen 20 Minuten in heißem Wasser einweichen, dann abgießen und gut abspülen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Eingeweichte Erbsen mit Zwiebel, Knoblauch und Scotch-Bonnet-Chili glatt pürieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Mischung in eine Schüssel geben und Mehl, Salz sowie schwarzen Pfeffer einrühren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Nach und nach Wasser hinzufügen, bis ein dickflüssiger Teig entsteht.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Pflanzenöl in einem tiefen Topf auf 350°F (175°C) erhitzen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Löffelweise Teig ins heiße Öl geben und insgesamt etwa 4-5 Minuten von allen Seiten goldbraun frittieren.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Mit einer Schaumkelle herausnehmen und vor dem Servieren auf Küchenpapier abtropfen lassen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
