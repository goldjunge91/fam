      "steps": [
        {
          "position": 0,
          "text": "Bereite die Donair-Sauce zu: Verrühre 0.75 Tasse gezuckerte Kondensmilch mit 2 EL Weißweinessig, 1 EL Knoblauchpulver und 0.5 TL Salz und stelle sie kalt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Rinderhackfleisch 5-7 Minuten in einer großen Pfanne bei mittlerer bis hoher Hitze und zerteile es dabei.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gieße überschüssiges Fett ab, gib Donair-Gewürzmischung und Wasser hinzu, rühre gut um und lasse alles 3 Minuten köcheln, bis es eindickt.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Erwärme das Fladenbrot im Ofen oder kurz in einer trockenen Pfanne.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Fülle die gewürzte Fleischmischung mittig in jedes warme Fladenbrot.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Gib großzügig gewürfelte Tomaten, Zwiebel und gehackten Salat darauf.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Beträufle alles großzügig mit Donair-Sauce, falte das Fladenbrot zu einer Rolle und serviere es sofort.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
