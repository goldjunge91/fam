      "steps": [
        {
          "position": 0,
          "text": "Erhitze Hühnerbrühe in einem Topf und halte sie während des Kochens am Köcheln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Schmilz Butter in einer großen Pfanne und röste den Reis unter ständigem Rühren 2 Minuten.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Gib die Brühe schöpflöffelweise hinzu und rühre häufig um. Warte jeweils, bis die Flüssigkeit größtenteils aufgenommen ist, bevor du mehr hinzugibst (insgesamt etwa 18 Minuten).",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Rühre Milch und Parmesan ein, bis das Risotto cremig ist, und verteile es dann auf einem Backblech. Lasse es 20 Minuten abkühlen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Forme das abgekühlte Risotto zu golfballgroßen Portionen, stecke jeweils einen kleinen Mozzarellawürfel hinein und forme sie wieder zu Kugeln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Verquirle Eier in einer Schüssel und gib Semmelbrösel in eine andere. Wende jede Kugel erst in Ei und dann in Semmelbröseln.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Erhitze Öl auf 350°F und frittiere die Arancini portionsweise 3 Minuten goldbraun.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 7,
          "text": "Lasse sie auf Küchenpapier abtropfen und serviere sie warm.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
      ],
