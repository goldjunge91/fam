      "steps": [
        {
          "position": 0,
          "text": "Vermische Mehl, Salz und Wasser zu einem weichen Teig, knete ihn 5 Minuten und lasse ihn zugedeckt 20 Minuten ruhen.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 1,
          "text": "Bräune Hackfleisch in einer separaten Pfanne bei mittlerer Hitze, gib dann gewürfelte Zwiebel hinzu und gare sie weich.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 2,
          "text": "Rühre Paprikapulver, Kreuzkümmel, Koriander, Petersilie und Ei ein und gare alles 2 Minuten, bis die Füllung vermischt und durchgewärmt ist.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 3,
          "text": "Teile den Teig in 6 gleich große Kugeln und rolle jede zu einem dünnen Oval von etwa 6 Zoll Länge aus.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 4,
          "text": "Gib 2 Esslöffel Füllung auf eine Hälfte jedes Teigovals, klappe es zusammen und verschließe die Ränder vorsichtig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 5,
          "text": "Erhitze Öl in einer Pfanne bei mittlerer bis hoher Hitze und frittiere jedes Chebab 2-3 Minuten pro Seite goldbraun und knusprig.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        },
        {
          "position": 6,
          "text": "Lasse die Chebab auf Küchenpapier abtropfen und serviere sie heiß, mit Honig beträufelt und Minztee dazu.",
          "timerMinutes": null,
          "ingredientKeys": [],
          "images": []
        }
