{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Die SQLite-Integrationstests benötigen explizite Node-Typen.
    "types": [
      "node",
      "jest",
      "react"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  // Deno-Functions und Vite-Tools werden mit ihren eigenen Toolchains geprüft.
  "exclude": [
    "supabase/functions",
    "tools"
  ]
}
