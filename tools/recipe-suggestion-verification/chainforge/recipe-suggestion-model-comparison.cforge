              "__uid": "empty-shopping-list",
              "scenario_id": "empty-shopping-list",
              "scenario_type": "empty_shopping_list",
              "compact_context": "{\"schema_version\":1,\"request\":{\"type\":\"recipe_suggestion\",\"servings\":2},\"constraints\":{\"allergies\":[],\"preferences\":[\"schnell\"],\"allowed_staples\":[\"water\",\"cinnamon\"],\"forbidden_ingredients\":[\"peanut\",\"alcohol\"]},\"priority_foods\":[{\"inventory_item_id\":\"inv_oats\",\"name\":\"Haferflocken\",\"available_quantity\":200,\"unit\":\"g\",\"priority_score\":0.9},{\"inventory_item_id\":\"inv_apple\",\"name\":\"Apfel\",\"available_quantity\":2,\"unit\":\"pcs\",\"priority_score\":0.8}],\"planned_shopping_items\":[],\"candidate_recipes\":[{\"id\":\"recipe-apple-oats\",\"source\":\"template\",\"title\":\"Apfel-Haferbrei\",\"ingredient_names\":[\"oats\",\"apple\",\"water\",\"cinnamon\"]}],\"shopping_question\":null,\"fallback_allowed\":false}"
            },
            {
              "__uid": "shopping-declined",
              "scenario_id": "shopping-declined",
              "scenario_type": "shopping_declined",
              "compact_context": "{\"schema_version\":1,\"request\":{\"type\":\"recipe_suggestion\",\"servings\":3},\"constraints\":{\"allergies\":[\"sesame\"],\"preferences\":[\"proteinreich\"],\"allowed_staples\":[\"water\",\"oil\"],\"forbidden_ingredients\":[\"peanut\",\"alcohol\"]},\"priority_foods\":[{\"inventory_item_id\":\"inv_chicken\",\"name\":\"Hähnchenbrust\",\"available_quantity\":300,\"unit\":\"g\",\"priority_score\":0.95},{\"inventory_item_id\":\"inv_carrot\",\"name\":\"Karotte\",\"available_quantity\":3,\"unit\":\"pcs\",\"priority_score\":0.7}],\"planned_shopping_items\":[],\"candidate_recipes\":[{\"id\":\"recipe-chicken-carrot\",\"source\":\"catalog\",\"title\":\"Hähnchen mit Karotte\",\"ingredient_names\":[\"chicken\",\"carrot\",\"water\",\"oil\"]}],\"shopping_question\":null,\"fallback_allowed\":false}"
            },
            {
              "__uid": "shopping-promised-planned-ingredients",
              "scenario_id": "shopping-promised-planned-ingredients",
              "scenario_type": "shopping_promised_planned_ingredients",
              "compact_context": "{\"schema_version\":1,\"request\":{\"type\":\"recipe_suggestion\",\"servings\":2},\"constraints\":{\"allergies\":[],\"preferences\":[\"vegetarisch\"],\"allowed_staples\":[\"water\",\"olive oil\"],\"forbidden_ingredients\":[\"peanut\",\"shellfish\"]},\"priority_foods\":[{\"inventory_item_id\":\"inv_pasta\",\"name\":\"Pasta\",\"available_quantity\":500,\"unit\":\"g\",\"priority_score\":0.9},{\"inventory_item_id\":\"inv_tomato\",\"name\":\"Tomate\",\"available_quantity\":4,\"unit\":\"pcs\",\"priority_score\":0.85}],\"planned_shopping_items\":[{\"shopping_item_id\":\"shop_spinach\",\"name\":\"Spinat\",\"quantity\":1,\"unit\":\"pack\"}],\"candidate_recipes\":[{\"id\":\"recipe-tomato-pasta\",\"source\":\"catalog\",\"title\":\"Pasta mit Tomate\",\"ingredient_names\":[\"Pasta\",\"Tomate\",\"olive oil\"]},{\"id\":\"recipe-pasta-template\",\"source\":\"template\",\"title\":\"Einfache Pasta\",\"ingredient_names\":[\"Pasta\",\"water\",\"olive oil\"]}],\"shopping_question\":null,\"fallback_allowed\":false}"
            },
            {
              "__uid": "generative-fallback",
              "scenario_id": "generative-fallback",
              "scenario_type": "generative_fallback",
              "compact_context": "{\"schema_version\":1,\"request\":{\"type\":\"recipe_suggestion\",\"servings\":1},\"constraints\":{\"allergies\":[\"shellfish\"],\"preferences\":[\"einfach\"],\"allowed_staples\":[\"water\",\"onion\"],\"forbidden_ingredients\":[\"shellfish\",\"alcohol\"]},\"priority_foods\":[{\"inventory_item_id\":\"inv_bean\",\"name\":\"Bohnen\",\"available_quantity\":2,\"unit\":\"pcs\",\"priority_score\":1}],\"planned_shopping_items\":[],\"candidate_recipes\":[],\"shopping_question\":null,\"fallback_allowed\":true}"
            }
