{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fam.local/schemas/weekly-waste-checkin.schema.json",
  "title": "Weekly waste check-in",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "household_id",
    "week_start",
    "reported_waste_quantity",
    "reported_waste_unit",
    "submitted_at"
  ],
  "properties": {
    "household_id": {
      "type": "string",
      "minLength": 1
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "reported_waste_quantity": {
      "type": "number",
      "minimum": 0
    },
    "reported_waste_unit": {
      "type": "string",
      "enum": [
        "g",
        "kg",
        "ml",
        "l",
        "piece",
        "package",
        "portion"
      ]
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
