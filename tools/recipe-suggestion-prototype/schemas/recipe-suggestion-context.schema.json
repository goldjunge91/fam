{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fam.local/schemas/recipe-suggestion-context.schema.json",
  "title": "Recipe suggestion context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "constraints",
    "priority_foods",
    "planned_shopping_items",
    "candidate_recipes",
    "shopping_question",
    "fallback_allowed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "servings"],
      "properties": {
        "type": { "const": "recipe_suggestion" },
        "servings": { "type": "integer", "minimum": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allergies", "preferences", "allowed_staples", "forbidden_ingredients"],
      "properties": {
        "allergies": { "type": "array", "items": { "type": "string" } },
        "preferences": { "type": "array", "items": { "type": "string" } },
        "allowed_staples": { "type": "array", "items": { "type": "string" } },
        "forbidden_ingredients": { "type": "array", "items": { "type": "string" } }
      }
    },
    "priority_foods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inventory_item_id", "name", "available_quantity", "unit", "priority_score"],
        "properties": {
          "inventory_item_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "available_quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string", "minLength": 1 },
          "priority_score": { "type": "number" }
        }
      }
    },
    "planned_shopping_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shopping_item_id", "name", "quantity", "unit"],
        "properties": {
          "shopping_item_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidate_recipes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "title", "ingredient_names"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source": { "enum": ["catalog", "template"] },
          "title": { "type": "string", "minLength": 1 },
          "ingredient_names": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "shopping_question": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    },
    "fallback_allowed": { "type": "boolean" }
  }
}
