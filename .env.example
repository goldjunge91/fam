# Environment Variables Example
# Vorlage fuer .env.local / .env.development / .env.preview / .env.production.

# Supabase URL & Key (Standard-Variablen)
# Lokale DB: http://127.0.0.1:54321
# Remote DB: https://dein-projekt.supabase.co
#
# 127.0.0.1 funktioniert nur im iOS-Simulator (localhost = der Mac selbst).
# Fuer ein physisches Geraet im selben WLAN die LAN-IP des Mac verwenden,
# z.B. http://192.168.1.23:54321 (ifconfig | grep "inet " zum Finden).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Erzwungenes Profil-Onboarding bei jedem App-Start (true/false)
EXPO_PUBLIC_FORCE_ONBOARDING=false

# Entwickler-Bereich in den Einstellungen einblenden (true/false).
# Zeigt Ziel-Projekt, Session-Restlaufzeit, Zustand der lokalen DB und
# Wartungsaktionen. Bewusst getrennt von __DEV__, damit er sich auch in
# einem echten Build einschalten laesst.
EXPO_PUBLIC_DEV_TOOLS=false

# Ad-hoc-Debug-console.logs (siehe @/lib/debug-log), standardmaessig an.
# Auf false stellen, um sie stummzuschalten, ohne die Aufrufe im Code zu
# entfernen (true/false).
EXPO_PUBLIC_DEBUG_LOGS=true

# Unterbindet jeden Open-Food-Facts-Netzwerkzugriff (Suche + Barcode-Lookup),
# damit sich der Offline-Pfad testen laesst, ohne das Netz zu kappen oder auf
# das Rate-Limit zu warten (true/false).
EXPO_PUBLIC_OFF_OFFLINE=false

# 1 = persoenliches kostenloses Team, 0 = bezahltes Apple Developer Team.
EXPO_NO_PUSH_ENTITLEMENT=1

# RevenueCat-Projekt-API-Keys (Dashboard: Project Settings > API Keys),
# getrennt pro Store. Ohne gesetzten Key startet die App trotzdem, Kaeufe
# bleiben dann deaktiviert (siehe lib/purchases.ts).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_sOmtZGpMGOBcPfZEwruvJTHcgCQ
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_sOmtZGpMGOBcPfZEwruvJTHcgCQ

# RevenueCat Test Store (Praefix `test_`, Dashboard: Apps and providers >
# Test configuration > Test Store > API Keys). Synthetische Store-Implementierung
# ohne App-Store-/Play-Store-Anbindung — in Entwicklungs-Builds (__DEV__) dem
# plattformeigenen Key vorgezogen (siehe lib/purchases.ts).
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_sOmtZGpMGOBcPfZEwruvJTHcgCQ

# Schaltet Premium-Funktionen hart frei, unabhaengig von RevenueCat (true/false).
# Zum Entwickeln einzelner Premium-Funktionen ohne Sandbox-Kauf pro Testlauf.
EXPO_PUBLIC_FORCE_PREMIUM=false

# Sentry-DSN (Sentry-Dashboard: Project Settings > Client Keys). Ein DSN ist
# kein Geheimnis, aber ohne ihn bleibt initSentry() (@/lib/sentry) ein No-op —
# lokale Entwicklung ohne Sentry-Account funktioniert dann trotzdem, nur ohne
# Fehler-Tracking.
EXPO_PUBLIC_SENTRY_DSN=
# Aktiviert ausfuehrliche Sentry-SDK-Debug-Logs im Terminal (Standard: false)
EXPO_PUBLIC_SENTRY_DEBUG=false

# Aptabase App Key (Dashboard: App Settings > Instructions).
# Privacy-first Analytics ohne Personenbezug.
EXPO_PUBLIC_APTABASE_APP_KEY=A-EU-5721393654

# Google AdMob (Production IDs fuer iOS)
# In __DEV__ wird automatisch auf Test-Anzeigenblöcke ausgewichen
# Werbung global deaktivieren: EXPO_PUBLIC_ADS_ENABLED=false
EXPO_PUBLIC_ADS_ENABLED=true
EXPO_PUBLIC_ADMOB_BANNER_ID_IOS=ca-app-pub-3823642106417448/3463186524
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID_IOS=ca-app-pub-3823642106417448/3925336471

# Nur fuer die serverseitige Prospekt-Dump-Pipeline und den lokalen
# tools/brochure-viewer. Niemals mit EXPO_PUBLIC_ praefigieren oder in die App
# bundeln. In GitHub Actions als Repository Secrets hinterlegen.
BRING_AUTH_TOKEN=
BRING_API_KEY=

# Optional: OpenRouter Vision-Analyse der lokalen Prospekt-Versionen
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Fam Prospektanalyse
BRING_USER_UUID=
SUPABASE_URL=https://dein-projekt.supabase.co
SUPABASE_SECRET_KEY=
# Fuer lokale Pipeline-Tests. Der produktive Workflow laedt automatisch alle
# deutschen PLZ von GeoNames und setzt stattdessen BROCHURE_LOCATIONS_FILE.
BROCHURE_LOCATIONS_JSON=

# Build-only Secrets fuer lesbare Fehlerstacks. Nicht mit EXPO_PUBLIC_ praefigieren
# und nie committen. Lokal in einer gitignorierten Env-Datei, bei EAS/GitHub als Secrets.
SENTRY_AUTH_TOKEN=
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=https://eu.posthog.com
