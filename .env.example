# Environment Variables Example
# Kopiere diese Datei zu .env und passe die Werte nach Bedarf an.

# Datenbank-Schalter (true = lokale DB unter http://127.0.0.1:54321, false = Remote / Production)
EXPO_PUBLIC_USE_LOCAL_DB=true

# Lokale Supabase Konfiguration (Werte erhältst du über: supabase status)
EXPO_PUBLIC_SUPABASE_URL_LOCAL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY_LOCAL=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Gehostete Remote / Production Supabase Konfiguration (Supabase Dashboard -> API)
EXPO_PUBLIC_SUPABASE_URL_REMOTE=https://movibeufhxaybfmvikhj.supabase.co
EXPO_PUBLIC_SUPABASE_KEY_REMOTE=sb_publishable_...

# Erzwungenes Profil-Onboarding bei jedem App-Start (true/false)
EXPO_PUBLIC_FORCE_ONBOARDING=false
