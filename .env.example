# Environment Variables Example
# Kopiere diese Datei zu .env und trage die korrekten Werte ein.
# Die lokalen Werte erhältst du über den Befehl: supabase status
# Für die gehostete Variante findest du die Werte im Supabase Dashboard unter Project Settings > API.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
