# Auf Geräten statt 127.0.0.1 die LAN-IP des Macs verwenden.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

EXPO_PUBLIC_FORCE_ONBOARDING=false

# Schaltet Entwicklerwerkzeuge unabhängig von __DEV__ frei.
EXPO_PUBLIC_DEV_TOOLS=false

# Erzwingt den OFF-Offlinepfad.
EXPO_PUBLIC_OFF_OFFLINE=false

# Für persönliche Apple-Teams ohne Push-Capability.
EXPO_NO_PUSH_ENTITLEMENT=1

# RevenueCat-Projektschlüssel pro Store.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_sOmtZGpMGOBcPfZEwruvJTHcgCQ
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_sOmtZGpMGOBcPfZEwruvJTHcgCQ

# RevenueCat Test Store ohne echte Store-Anbindung.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_sOmtZGpMGOBcPfZEwruvJTHcgCQ

# Erzwingt Premium ohne Sandbox-Kauf.
EXPO_PUBLIC_FORCE_PREMIUM=false

# Ohne DSN bleibt Sentry deaktiviert.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEBUG=false

# SENTRY_AUTH_TOKEN gehört lokal in .env oder als EAS-Secret, nie hierher.
