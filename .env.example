# Environment Variables Example
# Kopiere diese Datei zu .env und passe die Werte nach Bedarf an.

# Datenbank-Schalter (true = lokale DB unter http://127.0.0.1:54321, false = Remote / Production)
# Empfohlen: true für lokale Entwicklung & automatische Test-Accounts
EXPO_PUBLIC_USE_LOCAL_DB=true

# Gehostete Remote / Production Supabase Konfiguration (wird genutzt wenn EXPO_PUBLIC_USE_LOCAL_DB=false)
# Die Werte findest du im Supabase Dashboard unter Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Erzwungenes Profil-Onboarding bei jedem App-Start (true/false)
EXPO_PUBLIC_FORCE_ONBOARDING=false
