  "scripts": {
    "eas-build-on-success": "scripts/posthog-eas-build-on-success.sh",
    "eas:ios:local": "bash scripts/eas-ios-build.sh local",
    "eas:ios:cloud": "bash scripts/eas-ios-build.sh cloud",
    "posthog:upload-ios-dsyms": "scripts/posthog-upload-ios-dsyms.sh",
    "preinstall": "bun run check:bun-version",
    "prepare": "git config core.hooksPath .githooks",
    "start": "EXPO_NO_METRO_LAZY=1 bash scripts/local-expo.sh start",
    "ios": "FAM_HARNESS_UI=1 FAM_IOS_MLKIT_OCR=0 FAM_UPDATE_CHANNEL=development bash scripts/local-expo.sh ios",
    "simulator:testbilder": "bash scripts/install-test-images.sh",
    "check:bun-version": "bun -e 'const pkg = require(\"./package.json\"); const expected = pkg.packageManager?.startsWith(\"bun@\") ? pkg.packageManager.slice(4) : null; if (!expected) { console.error(\"packageManager must be pinned as bun@<version>\"); process.exit(1); } if (Bun.version !== expected) { console.error(\"Required Bun \" + expected + \"; found \" + Bun.version); process.exit(1); }'",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-test.ts",
    "test:unit": "bun run test",
    "test:coverage": "bun run test -- --coverage",
    "test:coverage:unit": "bun run test:unit -- --coverage && bun scripts/check-per-file-coverage.ts",
    "test:functions": "deno test supabase/functions --allow-env",
    "db:diff": "supabase db diff --use-pg-delta",
    "db:dec": "supabase db schema declarative sync",
    "db:local:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:reset": "supabase db reset",
    "db:advisors": "supabase db advisors --local --type security && supabase db advisors --local --type performance",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:check": "bash scripts/check-privileges.sh",
    "db:push": "supabase db push && bash scripts/check-privileges.sh --linked",
    "test:db": "bash scripts/check-clean-db.sh && supabase test db --local supabase/tests/*.test.sql",
    "test:integration": "bun --env-file=.env.development.local run jest --config jest.integration.config.js",
    "harness:run": "FAM_HARNESS_UI=1 react-native-harness --config jest.harness.config.mjs",
    "build:picker": "bun scripts/build-picker.ts"
  },
  "resolutions": {
    "lightningcss": "1.30.1",
    "react-native-worklets": "0.10.1",
    "expo-application": "57.0.3",
