  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "expo start",
    "native:status": "bun scripts/native-build/native-build.ts status",
    "native:prebuild": "expo prebuild --no-clean",
    "native:baseline": "bun scripts/native-build/native-build.ts baseline",
    "native:run": "bun scripts/native-build/native-build.ts run",
    "native:dev": "bun scripts/native-build/native-build.ts dev",
    "native:restore": "bun scripts/native-build/native-build.ts restore",
    "native:rebuild": "bun scripts/native-build/native-build.ts rebuild",
    "android": "FAM_HARNESS_UI=1 bun scripts/run-android.ts --env .env.development.local",
    "android:release": "FAM_HARNESS_UI=0 bun scripts/run-android.ts --env .env.preview --variant release",
    "android:apk": "bun scripts/build-android-apk.ts",
    "ios": "FAM_HARNESS_UI=1 expo run:ios",
    "ios:dev": "FAM_HARNESS_UI=1 bun --env-file=.env.development.local run native:dev -- --target ios-development-simulator",
    "ios:preview": "FAM_HARNESS_UI=0 bun --env-file=.env.preview run expo run:ios --device --configuration Release",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-test.ts",
    "test:unit": "bun run test -- --testPathPattern='^(?!.*test/native-build-(baseline|artifact)[.]test[.]ts$).*'",
    "test:coverage:unit": "bun run test:unit -- --coverage --coverageReporters=text-summary",
    "test:dump-pipeline": "bun test scripts/dump_data/dump-sqlite-io.bun.test.ts scripts/dump_data/dump-pipeline-cli.bun.test.ts",
    "test:functions": "deno test supabase/functions --allow-env",
    "db:diff": "supabase db diff --use-pg-delta",
    "db:local:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:reset": "supabase db reset",
    "db:advisors": "supabase db advisors --local --type security && supabase db advisors --local --type performance",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "db:check": "bash scripts/check-privileges.sh",
    "db:push": "supabase db push && bash scripts/check-privileges.sh --linked",
    "test:db": "bash scripts/check-clean-db.sh && supabase test db --local supabase/tests/*.test.sql",
    "test:integration": "bun --env-file=.env.development.local run jest --config jest.integration.config.js",
    "harness": "FAM_HARNESS_UI=1 react-native-harness --config jest.harness.config.mjs",
    "harness:dev": "FAM_HARNESS_UI=1 bun --env-file=.env.development.local run react-native-harness --config jest.harness.config.mjs"
  },
  "resolutions": {
    "lightningcss": "1.30.1",
    "react-native-worklets": "0.10.1"
  },
  "private": true,
  "trustedDependencies": [
    "@posthog/cli",
