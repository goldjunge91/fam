  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@react-native-community/cli": "^20.2.0",
    "@swmansion/argent": "^0.18.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.7",
    "dotenv-cli": "^11.0.0",
    "expo-mcp": "~0.2.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "EXPO_NO_DOTENV=1 dotenv -o -e .env -- expo start",
    "clean": "expo prebuild --clean -p ios",
    "android": "EXPO_NO_DOTENV=1 dotenv -o -e .env -- expo run:android",
    "android:release": "EXPO_NO_DOTENV=1 dotenv -o -e .env -- expo run:android --variant release",
    "android:apk": "bun scripts/build-android-apk.ts",
    "ios": "EXPO_NO_DOTENV=1 dotenv -o -e .env -- expo run:ios",
    "ios:preview": "EXPO_NO_PUSH_ENTITLEMENT=1 EXPO_NO_DOTENV=1 dotenv -o -e .env -- expo run:ios --device --configuration Release",
    "ios:testflight": "bash scripts/build-testflight.sh",
    "web": "expo start --web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run check:css",
    "check:fix": "biome check --write .",
    "check:css": "tailwindcss -i ./src/global.css -o /dev/null",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "test:functions": "deno test supabase/functions --allow-env",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "db:diff": "supabase db diff --use-pg-delta",
    "db:reset": "supabase db reset",
    "db:advisors": "supabase db advisors --local --type security && supabase db advisors --local --type performance",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "storage:upload-recipe-template-covers": "bun --env-file=.env scripts/upload-recipe-template-covers.ts",
    "db:check": "bash scripts/check-privileges.sh",
    "db:push": "supabase db push && bash scripts/check-privileges.sh --linked",
    "db:init": "bash scripts/init-database.sh",
    "test:db": "bash scripts/check-clean-db.sh && supabase test db --local supabase/tests/*.test.sql",
    "test:integration": "jest --config jest.integration.config.js --forceExit",
    "e2e": "maestro test .maestro/flows --exclude-tags fixture",
    "e2e:household-create": "bun scripts/e2e-household-create.ts",
    "e2e:household-join": "bun scripts/e2e-household-join.ts",
    "e2e:all": "bun run e2e && bun run e2e:household-create && bun run e2e:household-join",
    "user:create": "bun scripts/test-users.ts create",
    "user:list": "bun scripts/test-users.ts list",
    "user:clean": "bun scripts/test-users.ts clean",
    "user:delete": "bun scripts/test-users.ts delete",
    "test:env": "EXPO_NO_DOTENV=1 dotenv -o -e .env -- bun -e \"console.log(process.env.EXPO_PUBLIC_SUPABASE_URL)\""
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "private": true,
  "trustedDependencies": [
    "@sentry/cli"
  ]
}