    "@swmansion/argent": "^0.18.0",
    "@tanstack/eslint-plugin-query": "^5.102.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-preset-expo": "^57.0.7",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eas-build-cache-provider": "^22.0.0",
    "expo-build-disk-cache": "^0.8.0",
    "expo-mcp": "~0.2.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- expo start",
    "start:local": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- expo start",
    "start:development": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- expo start",
    "clean": "expo prebuild --clean -p ios",
    "android": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- expo run:android",
    "android:local": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- expo run:android",
    "android:development": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- expo run:android",
    "android:release": "EXPO_NO_DOTENV=1 dotenv -o -e .env.preview -- expo run:android --variant release",
    "android:apk": "bun scripts/build-android-apk.ts",
    "ios": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- expo run:ios",
    "ios:dev": "bash scripts/ios-dev.sh --profile development",
    "ios:local": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- expo run:ios",
    "ios:development": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- expo run:ios",
    "ios:preview": "EXPO_NO_DOTENV=1 dotenv -o -e .env.preview -- expo run:ios --device --configuration Release",
    "ios:testflight": "bash scripts/ios-dev.sh --profile preview-testflight",
    "ios:production": "bash scripts/ios-dev.sh --profile production",
    "tools:brochures": "bun run tools/brochure-viewer/server.ts",
    "brochures:update": "bun run scripts/seed-brochures.ts",
    "web": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- expo start --web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && bun run check:css",
    "check:fix": "biome check --write .",
    "check:css": "tailwindcss -i ./src/global.css -o /dev/null",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- jest",
    "test:local": "EXPO_NO_DOTENV=1 dotenv -o -e .env.local -- jest",
    "test:development": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- jest",
    "test:dump-pipeline": "bun test scripts/dump_data/dump-sqlite-io.bun.test.ts scripts/dump_data/dump-pipeline-cli.bun.test.ts",
    "test:functions": "deno test supabase/functions --allow-env",
    "test:watch": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- jest --watchAll",
    "test:coverage": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- jest --coverage",
    "evaluate-categories": "bun scripts/dump_data/evaluate-categories.ts",
    "debugger:category": "cd tools/category-debugger && bun run dev",
    "db:diff": "supabase db diff --use-pg-delta",
    "db:local:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:reset": "supabase db reset",
    "db:advisors": "supabase db advisors --local --type security && supabase db advisors --local --type performance",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "storage:upload-recipe-template-covers": "bun --env-file=.env scripts/upload-recipe-template-covers.ts",
    "db:check": "bash scripts/check-privileges.sh",
    "db:push": "supabase db push && bash scripts/check-privileges.sh --linked",
    "db:init": "bash scripts/init-database.sh",
    "test:db": "bash scripts/check-clean-db.sh && supabase test db --local supabase/tests/*.test.sql",
    "test:integration": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- jest --config jest.integration.config.js --forceExit",
    "e2e": "bun scripts/maestro/maestro.ts test .maestro/flows --exclude-tags fixture,local-session",
    "e2e:signed-in": "bun scripts/maestro/maestro.ts test .maestro/flows/signed-in-dashboard.yaml",
    "e2e:household-create": "bun scripts/maestro/e2e-household-create.ts",
    "e2e:household-join": "bun scripts/maestro/e2e-household-join.ts",
    "e2e:alpha": "bun scripts/maestro/maestro.ts test .maestro/flows/shopping-category-alpha-manual.yaml",
    "e2e:all": "bun run e2e && bun run e2e:household-create && bun run e2e:household-join && bun run e2e:alpha",
    "user:create": "bun scripts/test-users.ts create",
    "user:list": "bun scripts/test-users.ts list",
    "user:clean": "bun scripts/test-users.ts clean",
    "user:delete": "bun scripts/test-users.ts delete",
    "test:env": "EXPO_NO_DOTENV=1 dotenv -o -e .env.development.local -- bun -e \"console.log(process.env.EXPO_PUBLIC_SUPABASE_URL)\"",
    "classify": "bun scripts/classify.ts"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "private": true,
  "trustedDependencies": [
    "@sentry/cli"
  ]
}
