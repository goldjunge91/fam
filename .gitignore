# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
/credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Nicht nur *.local: eine schlichte .env enthaelt hier die Supabase-Keys und
# darf ebenfalls nie im Repo landen. Ohne diese Zeile haengt der Schutz an der
# globalen ~/.gitignore_global des jeweiligen Entwicklers.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# Generated native projects are versioned. Keep only build products and local
# machine state out of the repository.
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local
# Xcode erzeugt dieses implizite Workspace beim Öffnen des .xcodeproj lokal neu;
# unversioniert lassen, sonst driftet der Native-Fingerprint pro Maschine.
ios/fam.xcodeproj/project.xcworkspace/
ios/fam.xcodeproj/xcuserdata/
android/.gradle/
android/build/
android/app/build/
android/.cxx/
native-artifacts/
# Lokaler Snapshot des vollen Fingerprints (alle Sources+Hashes) je Plattform,
# geschrieben von 'native:baseline'/'native:rebuild'. Nur für 'native:status
# -- --diff' — nicht committen, maschinenlokal und ändert sich mit jedem Lauf.
.native-fingerprint-cache/
# JSONL-Messreihe von scripts/build-timer.ts (Plan Phase 0) — Rohdaten je
# Maschine, kein Quelltext.
.build-metrics/
temp/
/*.log
.venv
coverage/**/*
.env.local

# Claude Code Kommandologs
logs/
reports/

# Python (scripts/dump_data)
__pycache__/
*.pyc
scripts/dump_data/category-calibration-report.html
scripts/dump_data/category-calibration-report.json
tools/crawler/data/.brochure-version-hashes.json
tools/crawler/data/brochure-version-analysis.json
tools/crawler/data/aldi-capitals-v2/
tools/crawler/data/aldi-sample-v2/
*.har
build-*.tar.gz
dist/
/fam.*
/fam 2.*
# Veraltetes Ausgabeformat der frueheren Prospekt-SQL-Seed-Pipeline.
seed_brochures.sql
tokens_backup.env
docs.md
*.ipa
*.apk
*.aab
scripts/set-crawler-secrets.sh
.env_folder

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

*storybook.log
storybook-static