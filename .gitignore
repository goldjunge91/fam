# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
credentials.json
/credentials/

# Metro
.metro-health-check*
.harness/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# Nicht nur *.local: eine schlichte .env enthaelt hier die Supabase-Keys und
# darf ebenfalls nie im Repo landen. Ohne diese Zeile haengt der Schutz an der
# globalen ~/.gitignore_global des jeweiligen Entwicklers.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# CNG: generated by Expo Prebuild from app.json and config plugins.
# EAS uses this file too; native projects must not enter the build archive.
/ios/
/android/
native-artifacts/
# Legacy-Daten aus dem entfernten projektinternen Fingerprint-Lock-Workflow.
# Der aktuelle Expo Build Cache nutzt diesen lokalen Snapshot nicht.
.native-fingerprint-cache/
# Legacy-Build-Messwerte aus dem entfernten Native-Build-Workflow.
.build-metrics/
temp/
/*.log
.venv
coverage/**/*
.env.local

# Claude Code Kommandologs
logs/
reports/

# Codex SDD citation cache; origin validators are local runtime state.
.codex/sdd-cache/

# Python (scripts/dump_data)
__pycache__/
*.pyc
scripts/dump_data/category-calibration-report.html
scripts/dump_data/category-calibration-report.json
tools/crawler/data/.brochure-version-hashes.json
tools/crawler/data/brochure-version-analysis.json
tools/crawler/data/aldi-capitals-v2/
tools/crawler/data/aldi-sample-v2/
*.har
build-*.tar.gz
build/cache/ios/
build/local/ios/
dist/
/fam.*
/fam 2.*
# Veraltetes Ausgabeformat der frueheren Prospekt-SQL-Seed-Pipeline.
seed_brochures.sql
tokens_backup.env
docs.md
*.ipa
*.apk
*.aab
scripts/set-crawler-secrets.sh
.env_folder

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

*storybook.log
storybook-static
test_logs
docs/recipe-extraction/
scripts/archive/
