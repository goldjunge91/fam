{
  "description": "Project-local Codex lifecycle hooks for Beads and source-driven-development.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^WebFetch$",
        "hooks": [
          {
            "command": "root=\"$PWD\"; while [ \"$root\" != \"/\" ]; do script=\"$root/.codex/hooks/sdd-cache-post.sh\"; if [ -f \"$script\" ]; then SDD_CACHE_ROOT=\"$root\" exec bash \"$script\"; fi; root=\"$(dirname \"$root\")\"; done; exit 0",
            "async": true,
            "statusMessage": "Updating SDD citation cache",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PostCompact",
            "statusMessage": "Scheduling Beads context refresh",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd codex-hook PreCompact",
            "statusMessage": "Checking Beads context",
            "type": "command"
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^WebFetch$",
        "hooks": [
          {
            "command": "root=\"$PWD\"; while [ \"$root\" != \"/\" ]; do script=\"$root/.codex/hooks/sdd-cache-pre.sh\"; if [ -f \"$script\" ]; then SDD_CACHE_ROOT=\"$root\" exec bash \"$script\"; fi; root=\"$(dirname \"$root\")\"; done; exit 0",
            "statusMessage": "Checking SDD citation cache",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd codex-hook SessionStart",
            "statusMessage": "Loading Beads context",
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "bd codex-hook UserPromptSubmit",
            "statusMessage": "Refreshing Beads context",
            "type": "command"
          }
        ]
      }
    ]
  }
}
