+function stripPreviouslyInjectedBlockSafely(podfile) {
+  const lines = podfile.split(/\r?\n/);
+  const markerIndex = lines.findIndex((line) => line.includes(MARKER));
+  if (markerIndex === -1) return podfile;
+
+  let started = false;
+  let depth = 0;
+  let blockEnd = -1;
+  for (let index = markerIndex; index < lines.length; index += 1) {
+    const line = lines[index].trim();
+    if (!started) {
+      if (line.startsWith("if ENV['EXPO_MLKIT_OCR_DISABLE_MLKIT']")) {
+        started = true;
+        depth = 1;
+      }
+      continue;
+    }
+
+    if (/^(if|unless|case|begin)\b/.test(line) || /\bdo(?:\s*\|.*\|)?$/.test(line)) {
+      depth += 1;
+    } else if (line === "end") {
+      depth -= 1;
+      if (depth === 0) {
+        blockEnd = index;
+        break;
+      }
+    }
+  }
+
+  if (blockEnd === -1) return podfile;
+  lines.splice(markerIndex, blockEnd - markerIndex + 1);
+  return lines.join("\n");
+}
+
+function stripOrphanedTail(podfile) {
+  const orphanTailRegex =
+    /\n\s*end\n\s*installer\.aggregate_targets\.each do \|aggregate_target\|[\s\S]*?aggregate_target\.user_project\.save\n\s*end\n\s*end\n(?=\s*#\s*expo-mlkit-ocr: iOS Simulator MLKit handling)/g;
+  return podfile.replace(orphanTailRegex, "\n");
+}
