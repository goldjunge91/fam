+import { AppState } from 'react-native'
+import type { AppStateStatus, NativeEventSubscription } from 'react-native'
+import type { MMKV } from '../specs/MMKV.nitro'
+
+const registeredInstances = new WeakSet<MMKV>()
+const registeredListeners = new WeakMap<MMKV, NativeEventSubscription>()
+
+export function addContentChangedListener(mmkv: MMKV): void {
+  if (registeredInstances.has(mmkv)) {
+    return
+  }
+  registeredInstances.add(mmkv)
+
+  if (global.WeakRef != null && global.FinalizationRegistry != null) {
+    const weakMmkv = new WeakRef(mmkv)
+    const listener = AppState.addEventListener(
+      'change',
+      (state: AppStateStatus) => {
+        if (state === 'active') {
+          checkContentChangedSafely(weakMmkv.deref())
+        }
+      }
+    )
+    const finalization = new FinalizationRegistry(
+      (subscription: NativeEventSubscription) => {
+        subscription.remove()
+      }
+    )
+    registeredListeners.set(mmkv, listener)
+    finalization.register(mmkv, listener)
+  } else {
+    const listener = AppState.addEventListener('change', (state: AppStateStatus) => {
+      if (state === 'active') {
+        checkContentChangedSafely(mmkv)
+      }
+    })
+    registeredListeners.set(mmkv, listener)
+  }
+}
+
+export function removeContentChangedListener(mmkv: MMKV): void {
+  const listener = registeredListeners.get(mmkv)
+  registeredListeners.delete(mmkv)
+  listener?.remove()
+}
+
+// `mmkv.dispose()` can be called manually (e.g. when deleting an account's
+// storage) while this AppState listener is still registered. Without a
+// WeakRef/FinalizationRegistry runtime (or before GC runs), the listener
+// keeps a reference to the now-disposed native instance and would crash the
+// app on the next foreground event. Swallow that specific failure instead.
+function checkContentChangedSafely(mmkv: MMKV | undefined): void {
+  if (mmkv == null) return
+  try {
+    mmkv.checkContentChanged()
+  } catch {
+    // Instance was disposed; nothing to check anymore.
+  }
+}
