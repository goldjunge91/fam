+
+// `mmkv.dispose()` can be called manually (e.g. when deleting an account's
+// storage) while this AppState listener is still registered. Without a
+// WeakRef/FinalizationRegistry runtime (or before GC runs), the listener
+// keeps a reference to the now-disposed native instance and would crash the
+// app on the next foreground event. Swallow that specific failure instead.
+function checkContentChangedSafely(mmkv: MMKV | undefined): void {
+  if (mmkv == null) return
+  try {
+    mmkv.checkContentChanged()
+  } catch {
+    // Instance was disposed; nothing to check anymore.
+  }
+}
