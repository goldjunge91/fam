#!/bin/bash
# Der Commit-Hook prueft den gestagten Scope. Die vollstaendige Test- und
# Coverage-Pipeline bleibt ein CI-Gate und laeuft ueber tests.sh.
#
# Einrichtung (einmalig pro Checkout): bun run prepare
set -euo pipefail

current_check="Hook-Vorbereitung"

on_error() {
  local exit_code="$1"
  printf '\nPre-Commit abgebrochen: %s fehlgeschlagen (Exit-Code %s).\n' "$current_check" "$exit_code" >&2
  printf 'Die Fehlerdetails stehen oben. Bitte behebe den Fehler und starte den Commit erneut.\n' >&2
  exit "$exit_code"
}

trap 'on_error "$?"' ERR

cd "$(git rev-parse --show-toplevel)"

staged_paths=()
while IFS= read -r -d '' file; do
  staged_paths+=("$file")
done < <(git diff --cached --name-only -z)
if [ "${#staged_paths[@]}" -eq 0 ]; then
  echo "Keine gestagten Dateien -- Pre-Commit-Pruefungen uebersprungen."
  exit 0
fi

staged_files=()
while IFS= read -r -d '' file; do
  staged_files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

schema_changed=0
for file in "${staged_paths[@]}"; do
  case "$file" in
    supabase/schemas/*)
      schema_changed=1
      break
      ;;
  esac
done

test_files=()
test_result="Jest uebersprungen (keine gestagten JS-/TS-Dateien)"

if [ "${#staged_files[@]}" -gt 0 ]; then
  for file in "${staged_files[@]}"; do
    case "$file" in
      src/lib/database.types.ts)
        # Generated declarations have no related Jest tests.
        continue
        ;;
      src/*.ts|src/*.tsx|src/*.js|src/*.jsx|test/*.ts|test/*.tsx|test/*.js|test/*.jsx)
        test_files+=("$file")
        ;;
    esac
  done
fi

biome_files=()
# Biome treats explicitly ignored paths as an error, so only paths covered by
# biome.json are forwarded while retaining the staged-only scope.
if [ "${#staged_files[@]}" -gt 0 ]; then
  for file in "${staged_files[@]}"; do
    case "$file" in
      package.json)
        biome_files+=("$file")
        ;;
      src/*|scripts/*|test/conventions/*)
        case "$file" in
          src/lib/database.types.ts|scripts/dump_data/category-calibration-report.*)
            continue
            ;;
          *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs|*.mts|*.cts|*.json|*.jsonc|*.css|*.graphql)
            biome_files+=("$file")
            ;;
        esac
        ;;
    esac
  done
fi

echo "Pre-Commit-Pruefungen fuer gestagte Aenderungen laufen..."

if [ "${#biome_files[@]}" -gt 0 ]; then
  current_check="Biome"
  echo "--> Biome (${#biome_files[@]} relevante gestagte Dateien)"
  bun run biome check --files-ignore-unknown=true -- "${biome_files[@]}"
else
  echo "--> Biome uebersprungen (keine relevanten gestagten Dateien)."
fi

current_check="Typecheck"
echo "--> Typecheck: Start"
bun run typecheck
echo "<-- Typecheck: Ende"
echo ""

current_check="Whitespace und Konfliktmarker"
echo "--> Whitespace und Konfliktmarker..."
whitespace_failed=0

check_markdown_whitespace() {
  local markdown_diagnostics

  # Keep conflict-marker validation for Markdown while allowing only the
  # intentional two-space hard-break syntax.
  markdown_diagnostics="$(git diff --cached --check -- '*.md' 2>&1 || true)"
  if ! printf '%s\n' "$markdown_diagnostics" | awk '
    /^[^:]+:[0-9]+: / {
      if ($0 !~ /: trailing whitespace\.$/) {
        print
        failed = 1
      }
    }
    END { exit failed }
  '; then
    return 1
  fi

  if ! git diff --unified=0 --cached -- '*.md' | awk '
    /^\+\+\+/ { next }
    /^\+/ {
      line = substr($0, 2)
      if (line ~ /[[:space:]]+$/ && line !~ /[^ \t]  $/) {
        print
        failed = 1
      }
    }
    END { exit failed }
  '; then
    return 1
  fi
}

if ! git diff --cached --check -- . ':(exclude,glob)**/*.md'; then
  whitespace_failed=1
fi
if ! check_markdown_whitespace; then
  whitespace_failed=1
fi

if [ "$whitespace_failed" -ne 0 ]; then
  echo ""
  echo "Whitespace-Fehler in gestagten Aenderungen (siehe oben)."
  echo "Trailing whitespace oder Konfliktmarker gefunden. Bitte vor dem Commit beheben."
  exit 1
fi
echo "Keine Whitespace- oder Konfliktfehler."

echo ""
database_types_result="Generierte DB-Typen uebersprungen (keine Schema-Aenderungen)"
if [ "$schema_changed" -ne 0 ]; then
  current_check="Generierte DB-Typen"
  echo "--> Supabase-Schema in gestagten Aenderungen -- generierte Typen werden verifiziert..."
  if ! command -v supabase >/dev/null 2>&1; then
    echo "Hinweis: supabase CLI nicht im PATH, db:types wird nicht geprueft."
    echo "         Die CI-Stufe 'Generierte DB-Typen duerfen nicht abweichen' deckt das ab."
    database_types_result="Generierte DB-Typen uebersprungen (Supabase-CLI nicht im PATH)"
  else
    bun run db:types
    if ! git diff --quiet -- src/lib/database.types.ts; then
      echo ""
      echo "src/lib/database.types.ts ist veraltet."
      echo "Aenderung stagen und mit dem Commit nachziehen:"
      echo "  git add src/lib/database.types.ts"
      exit 1
    fi
    echo "Generierte DB-Typen stimmen."
    database_types_result="Generierte DB-Typen bestanden"
  fi
fi

echo ""

if [ "${#test_files[@]}" -gt 0 ]; then
  current_check="Jest --findRelatedTests"
  echo "--> Betroffene Jest-Tests (${#test_files[@]} Dateien)"
  bun run test -- --runInBand --findRelatedTests "${test_files[@]}"
  test_result="Jest --findRelatedTests bestanden"
else
  echo "--> Keine gestagten Jest-Quellen -- Tests uebersprungen."
fi

printf '\nPre-Commit erfolgreich: Biome, Typecheck und Whitespace-Pruefung bestanden; %s; %s.\n' "$database_types_result" "$test_result"
