#!/bin/bash
# Der Commit-Hook prueft den gestagten Scope. Die vollstaendige Test- und
# Coverage-Pipeline bleibt ein CI-Gate und laeuft ueber tests.sh.
#
# Einrichtung (einmalig pro Checkout): bun run prepare
set -euo pipefail

current_check="Hook-Vorbereitung"

on_error() {
  local exit_code="$1"
  printf '\nPre-Commit abgebrochen: %s fehlgeschlagen (Exit-Code %s).\n' "$current_check" "$exit_code" >&2
  printf 'Die Fehlerdetails stehen oben. Bitte behebe den Fehler und starte den Commit erneut.\n' >&2
  exit "$exit_code"
}

trap 'on_error "$?"' ERR

cd "$(git rev-parse --show-toplevel)"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged_files" ]; then
  echo "Keine gestagten Dateien -- Pre-Commit-Pruefungen uebersprungen."
  exit 0
fi

test_files=()
test_result="Jest uebersprungen (keine gestagten JS-/TS-Dateien)"

while IFS= read -r file; do
  [ -z "$file" ] && continue

  case "$file" in
    src/lib/database.types.ts)
      # Generated declarations have no related Jest tests.
      continue
      ;;
    src/*.ts|src/*.tsx|src/*.js|src/*.jsx|test/*.ts|test/*.tsx|test/*.js|test/*.jsx)
      test_files+=("$file")
      ;;
  esac
done <<< "$staged_files"

echo "Pre-Commit-Pruefungen fuer gestagte Aenderungen laufen..."

current_check="Biome"
echo "--> Biome"
bun run check

# current_check="Typecheck"
# echo "--> Typecheck"
# bun run typecheck

if [ "${#test_files[@]}" -gt 0 ]; then
  current_check="Jest --findRelatedTests"
  echo "--> Betroffene Jest-Tests (${#test_files[@]} Dateien)"
  bun run test -- --runInBand --findRelatedTests "${test_files[@]}"
  test_result="Jest --findRelatedTests bestanden"
else
  echo "--> Keine gestagten Jest-Quellen -- Tests uebersprungen."
fi

printf '\nPre-Commit erfolgreich: Biome und Typecheck bestanden; %s.\n' "$test_result"
