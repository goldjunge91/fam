#!/bin/bash
# Prueft die Commit-Nachricht auf Conventional-Commit-Format.
#
# Aufruf: bun run prepare (einmalig) setzt core.hooksPath auf .githooks
# und macht diesen Hook aktiv.
#
# Aufruf: bun run prepare (einmalig) setzt core.hooksPath auf .githooks
# und macht diesen Hook aktiv. Mit --no-verify ueberspringbar.
set -euo pipefail

commit_message_file="$1"

if [ ! -f "$commit_message_file" ]; then
  echo "commit-msg: Nachrichtendatei nicht gefunden: $commit_message_file" >&2
  exit 1
fi

# Nur die erste Zeile pruefen. Der Body darf frei sein.
first_line="$(head -n 1 "$commit_message_file")"

# Leerer Betreff: git selbst lehnt das ab, aber eine klare Meldung hilft.
if [ -z "${first_line//[[:space:]]/}" ]; then
  echo "" >&2
  echo "commit-msg: Der Betreff (erste Zeile) ist leer." >&2
  echo "" >&2
  exit 1
fi

# Merge-, Fixup- und Amend-Nachrichten sind keine neuen fachlichen Aenderungen.
case "$first_line" in
  Merge\ * | Revert\ \"* | fixup!* | squash!* | amend\!* )
    exit 0
    ;;
  WIP* | wip* )
    exit 0
    ;;
esac

# Conventional Commits: <type>(optional scope)!: <description>
# Absichtlich weit gefasst -- wir blockieren nur das offensichtlich Falsche
# (kein Prefix), nicht ungewoehnliche, aber gueltige Beschreibungen.
if [[ "$first_line" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)([(][a-z0-9._/-]+[)])?[!]?:\ .+ ]]; then
  exit 0
fi

echo "" >&2
echo "commit-msg: Der Betreff entspricht nicht dem Conventional-Commit-Format." >&2
echo "" >&2
echo "  gefunden:  $first_line" >&2
echo "  erwartet:  <type>(<scope>): <Beschreibung>" >&2
echo "" >&2
echo "  Erlaubte Typen: feat fix docs style refactor perf test build ci chore revert" >&2
echo "" >&2
echo "  Beispiele:" >&2
echo "    feat(auth): add password reset flow" >&2
echo "    fix(inventory): prevent duplicate ledger entries" >&2
echo "    docs: clarify the sync contract" >&2
echo "    style: reformat the codebase with Prettier" >&2
echo "    refactor: improve the data processing pipeline" >&2
echo "    perf: optimize the database queries" >&2
echo "    test: cover the sheet close handler" >&2
echo "    build: update the build configuration" >&2
echo "    ci: update the continuous integration configuration" >&2
echo "    chore(format): enforce LF line endings in Biome" >&2
echo "    revert: undo a previous commit" >&2
echo "" >&2
echo "  Mit --no-verify ueberspringbar, falls noetig." >&2
echo "" >&2
exit 1
