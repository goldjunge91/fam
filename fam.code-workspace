{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"js/ts.server.goMemLimit": "4GiB",
		"js/ts.referencesCodeLens.enabled": true,
		"js/ts.referencesCodeLens.showOnAllFunctions": true,
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true
		},
		"jest.virtualFolders": [
    {
      "name": "unit-tests",
      "jestCommandLine": "node_modules/.bin/jest",
      "runMode": "on-demand"
    },
    {
      "name": "integration-tests",
      "jestCommandLine": "node_modules/.bin/jest --config jest.integration.config.js --forceExit",
      "runMode": "on-demand"
    }
  ],
	}
}