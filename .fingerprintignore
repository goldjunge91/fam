native-artifacts/**

# Local files generated by Xcode/Android tooling must not invalidate the
# versioned native baseline.
**/.DS_Store
**/.xcode.env.local
**/debug.keystore

# Xcode erzeugt dieses implizite Workspace beim Öffnen des .xcodeproj lokal neu
# und Xcode-Benutzerdaten sind maschinenspezifisch — beide dürfen den Native-
# Fingerprint nicht beeinflussen (siehe docs für Details/Herleitung).
ios/fam.xcodeproj/project.xcworkspace/**
ios/fam.xcodeproj/xcuserdata/**

# eas.json/.easignore steuern, WIE eas/expo baut (Profile, Env-Injection,
# Distribution-Typ, Channel) — nicht, was tatsächlich in den nativen Code
# kompiliert wird. Env-Vars landen im JS-Bundle (bei jedem Lauf frisch von
# Metro gebaut, nicht Teil des nativen Fingerprints). Abwägung bewusst
# getroffen: seltene eas.json-Änderungen sollen nicht bei jedem Edit die
# gesamte Baseline invalidieren. Risiko: ein Profil-Feld, das doch den
# xcodebuild-Aufruf ändert (z. B. Distribution-Typ), würde nicht erkannt —
# im Zweifel nach eas.json-Änderungen manuell 'native:baseline' erneuern.
eas.json
.easignore
