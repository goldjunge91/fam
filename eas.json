{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "prebuildCommand": "prebuild --no-clean",
      "bun": "1.3.14",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    },
    "development": {
      "extends": "base",
      "env": {
        "FAM_HARNESS_UI": "1",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "FAM_HARNESS_UI": "0"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-testflight": {
      "extends": "base",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "FAM_HARNESS_UI": "0",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "environment": "preview",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "env": {
        "FAM_HARNESS_UI": "0",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      },
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "environment": "production",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "preview-testflight": {
      "ios": {
        "appleTeamId": "SW8RP7PA3W",
        "ascAppId": "6803078545"
      }
    },
    "production": {
      "ios": {
        "appleTeamId": "SW8RP7PA3W"
      }
    }
  }
}
