{
  "biome.enabled": true,
  "biome.requireConfiguration": true,
  "biome.lsp.bin": {
    "darwin-arm64": "./node_modules/@biomejs/cli-darwin-arm64/biome",
    "darwin-x64": "./node_modules/@biomejs/cli-darwin-x64/biome",
    "linux-arm64": "./node_modules/@biomejs/cli-linux-arm64/biome",
    "linux-x64": "./node_modules/@biomejs/cli-linux-x64/biome",
    "linux-arm64-musl": "./node_modules/@biomejs/cli-linux-arm64-musl/biome",
    "linux-x64-musl": "./node_modules/@biomejs/cli-linux-x64-musl/biome",
    "win32-arm64": "./node_modules/@biomejs/cli-win32-arm64/biome.exe",
    "win32-x64": "./node_modules/@biomejs/cli-win32-x64/biome.exe"
  },
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "headerClassName"
  ],
  "telemetry.feedback.enabled": false,
  "chat.mcp.serverSampling": {
    "fam/.vscode/mcp.json: expo": {
      "allowedModels": [
        "copilot/auto",
        "copilotcli/auto",
        "agent-host-copilotcli:auto"
      ]
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "markup.inline.raw.string.markdown",
        "settings": {
          "foreground": "#4FC1FF",
          "fontStyle": ""
        }
      }
    ]
  },
  "files.exclude": {
    "**/.git": false,
    "**/.svn": false,
    "**/.hg": false
  },
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "js/ts.referencesCodeLens.enabled": true,
  // "jest.jestCommandLine": "node_modules/.bin/jest",
  "jest.runMode": "on-demand",
  "jest.virtualFolders": [
    {
      "name": "unit-tests",
      // "jestCommandLine": "./node_modules/.bin/jest",
      "runMode": "on-demand"
    },
    {
      "name": "integration-tests",
      "jestCommandLine": "node_modules/.bin/jest --config jest.integration.config.js --forceExit",
      "runMode": "on-demand"
    }
  ],
  "testExplorer.addToEditorContextMenu": true,
  "explorer.confirmDelete": false,
  "explorer.excludeGitIgnore": false,
  "explorer.fileNesting.enabled": true,
  "explorer.openEditors.sortOrder": "alphabetical",
  "explorer.sortOrder": "foldersNestsFiles",
  "claudeCode.respectGitIgnore": false,
  "explorer.compactFolders": false,
  "files.eol": "\n",
  "git.enabled": true,
  "git.enableCommitSigning": false
}
