{
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports": "never",
      "source.sortMembers": "never"
    }
  },
  "tailwindCSS.classAttributes": [
    "class",
    "className",
    "headerClassName"
  ],
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports": "never",
      "source.sortMembers": "never"
    }
  },
  "telemetry.feedback.enabled": false,
  "chat.mcp.serverSampling": {
    "fam/.vscode/mcp.json: expo": {
      "allowedModels": [
        "copilot/auto",
        "copilotcli/auto",
        "agent-host-copilotcli:auto"
      ]
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "markup.inline.raw.string.markdown",
        "settings": {
          "foreground": "#4FC1FF",
          "fontStyle": ""
        }
      }
    ]
  },
  "files.exclude": {
    "**/.git": false,
    "**/.svn": false,
    "**/.hg": false
  },
  "js/ts.referencesCodeLens.showOnAllFunctions": true,
  "js/ts.referencesCodeLens.enabled": true,
  "jest.jestCommandLine": "node_modules/.bin/jest",
  "jest.runMode": "on-demand",
  "jest.virtualFolders": [
    {
      "name": "unit-tests",
      "jestCommandLine": "node_modules/.bin/jest",
      "runMode": "on-demand"
    },
    {
      "name": "integration-tests",
      "jestCommandLine": "node_modules/.bin/jest --config jest.integration.config.js --forceExit",
      "runMode": "on-demand"
    }
  ],
  "testExplorer.addToEditorContextMenu": true,
  "explorer.confirmDelete": false,
  "explorer.excludeGitIgnore": false,
  "explorer.fileNesting.enabled": true,
  "explorer.openEditors.sortOrder": "alphabetical",
  "explorer.sortOrder": "foldersNestsFiles",
  "claudeCode.respectGitIgnore": false,
  "explorer.compactFolders": false
}